{
  "name": "BindLens Web",
  "short_name": "BindLens",
  "description": "Your folders as books: read, mark, find and report on all your documents, saved in your own Google Drive or OneDrive.",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#F6F4FB",
  "theme_color": "#0A0A0D",
  "icons": [
    { "src": "/app/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/app/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/app/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
