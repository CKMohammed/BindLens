                return
            f = books[i]
            rtitle.configure(text=f"DOCUMENTS OF {self.lib.label(f).upper()}")
            for rel in self.lib.folders.get(f, []):
                docs.append((f, rel))
                lb_docs.insert("end", "  " + (rel.replace("/", "  ›  ")))

        def search(*_a):
            q = qv.get().strip()
            if not q:
                i = lb_books.curselection()
                show_book(i[0] if i else 0)
                return
            docs.clear()
            lb_docs.delete(0, "end")
            rtitle.configure(text="FOUND")
            for _sc, f, rel in self._find_docs(q, limit=60):
                docs.append((f, rel))
                lb_docs.insert("end", f"  {os.path.basename(rel)}   ·  {self.lib.label(f)}")
            if docs:
                lb_docs.selection_set(0)

