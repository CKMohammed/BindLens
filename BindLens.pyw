    def _go_doc(self, folder, rel, page=0, query=None):
        """Open a document (in its book) at a page."""
        if folder not in self.lib.folders:
            return

        def there():
            if not self.book:
                return
            fi = next((i for i, f in enumerate(self.book.files) if f["rel"] == rel), None)
            if fi is None:
                return
            self.goto_page(self.book.files[fi]["first"] + (page or 0))
            if query:
                self.start_search(query)
        if folder != self.folder or self.book is None:
            self.open_folder(folder, then=there)
        elif self.prefix and not rel.startswith(self.prefix):
            self.open_folder(folder, "", then=there)           # it is in another part of this book
        else:
            there()

    def _find_docs(self, q, limit=8, folder=None):
        """Documents whose name is like q (not exact: 'week 38', 'wk38', 'invoce march') - best first."""
        qt = fuzzy_tokens(q)
        if not qt:
            return []
        cache = self.__dict__.setdefault("_fz_cache", {})
        if len(cache) > 50000:
            cache.clear()
        out = []
        for f, rel in self.lib.all_files():
            if folder is not None and f != folder:
                continue
            toks = cache.get((f, rel))
            if toks is None:
                base = os.path.basename(rel)
                toks = (fuzzy_tokens(base), fuzzy_tokens(rel[:-len(base)] + " " + self.lib.label(f)),
                        " ".join(fuzzy_tokens(base)))
                cache[(f, rel)] = toks
            sc = fuzzy_score(qt, toks[0], toks[2])
            if toks[1]:
                sc = max(sc, 0.8 * fuzzy_score(qt, toks[0] + toks[1], toks[2]))
            if sc > 0:
                out.append((sc, f, rel))
        out.sort(key=lambda x: (-x[0], len(x[2]), x[2].lower()))
        return out[:limit]

