    def _cal_feed_remove(self, fd, then=None):
        if not messagebox.askyesno(APP_NAME, f'Remove the calendar "{fd.get("name", "")}" from BindLens?'):
            return
        data = self._cal_data()
        if fd in data["feeds"]:
            data["feeds"].remove(fd)
        try:
            os.remove(os.path.join(self.lib.meta_dir, "calendars", f"{fd['id']}.json"))
        except Exception:
            pass
        self.__dict__.setdefault("_cal_feed_mem", {}).pop(fd["id"], None)
        self._cal_changed(save=True)
        if then:
            then()

    def _cal_store_feed(self, fd, text):
        """Read a calendar's text and keep its events (dates as text) in BindLens's folder."""
        evs = parse_ics(text)
        raw = []
        for e in evs:
            raw.append({"title": e.get("title", ""), "start": e["start"].isoformat(), "last": e["last"].isoformat(),
                        "time": e.get("time"), "rrule": e.get("rrule"), "where": e.get("where", ""),
                        "exdates": [x.isoformat() for x in e.get("exdates") or []]})
        folder = os.path.join(self.lib.meta_dir, "calendars")
        os.makedirs(folder, exist_ok=True)
        save_json(os.path.join(folder, f"{fd['id']}.json"), {"events": raw})
        return len(raw)

    def _cal_import_file(self, then=None):
        path = filedialog.askopenfilename(title="A calendar file", filetypes=[("Calendar", "*.ics *.ical *.ifb"),
                                                                              ("All files", "*.*")])
        if not path:
            return
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as fh:
                text = fh.read()
            if "BEGIN:VCALENDAR" not in text.upper():
                raise ValueError("this is not a calendar file (.ics)")
            data = self._cal_data()
            fd = {"id": f"c{int(time.time() * 1000)}", "name": os.path.splitext(os.path.basename(path))[0],
                  "file": path, "color": CAL_COLORS[len(data["feeds"]) % len(CAL_COLORS)], "on": True,
                  "last": time.strftime("%d %b %H:%M")}
            n = self._cal_store_feed(fd, text)
            try:
                fd["mtime"] = os.path.getmtime(path)
            except Exception:
                pass
            data["feeds"].append(fd)
            self.__dict__.setdefault("_cal_feed_mem", {}).pop(fd["id"], None)
            self._cal_changed(save=True)
            self._toast(f'Calendar "{fd["name"]}" added - {n} events.')
        except Exception as ex:
            messagebox.showerror(APP_NAME, f"Could not read that calendar:\n{ex}")
        if then:
            then()

    def _cal_import_link(self, then=None, parent=None):
        T = self.T
        d = self._dialog("A calendar from a link")
        tk.Label(d, text="Paste the calendar's link", font=self.F(12, "bold"), bg=T["panel"], fg=T["text"]).pack(
            anchor="w", padx=20, pady=(16, 2))
        tk.Label(d, text="Outlook: Settings › Calendar › Shared calendars › Publish a calendar › ICS link.\n"
                         "Google: the calendar's Settings › 'Secret address in iCal format'.\n"
                         "BindLens reads it now and again every hour while it is open (it needs the internet).",
                 font=self.F(9), bg=T["panel"], fg=T["muted"], justify="left").pack(anchor="w", padx=20)
        uv, nv = tk.StringVar(), tk.StringVar(value="My calendar")
        f = tk.Frame(d, bg=T["panel"])
        f.pack(fill="x", padx=20, pady=(10, 0))
        tk.Label(f, text="Link", font=self.F(9), width=6, anchor="w", bg=T["panel"], fg=T["text"]).grid(row=0,
                                                                                                       column=0)
        e1 = ttk.Entry(f, textvariable=uv, width=52)
        e1.grid(row=0, column=1, pady=2)
        tk.Label(f, text="Name", font=self.F(9), width=6, anchor="w", bg=T["panel"], fg=T["text"]).grid(row=1,
                                                                                                       column=0)
        ttk.Entry(f, textvariable=nv, width=30).grid(row=1, column=1, sticky="w", pady=2)

        def ok():
            url = uv.get().strip()
            if url.lower().startswith("webcal://"):
                url = "https://" + url[9:]
            if not re.match(r"https?://", url, re.I):
                messagebox.showinfo(APP_NAME, "The link starts with https:// (or webcal://).", parent=d)
                return
            data = self._cal_data()
            fd = {"id": f"c{int(time.time() * 1000)}", "name": nv.get().strip() or "My calendar", "url": url,
                  "color": CAL_COLORS[len(data["feeds"]) % len(CAL_COLORS)], "on": True}
            data["feeds"].append(fd)
            self.lib.save_meta()
            d.destroy()
