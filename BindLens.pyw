                    + "".join(drels) + '</Relationships>')
                overrides.append('<Override PartName="/xl/drawings/drawing1.xml" '
                                 'ContentType="application/vnd.openxmlformats-officedocument.drawing+xml"/>')
                rels_extra[idx] = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
                                   '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
                                   '<Relationship Id="rIdD1" Type="http://schemas.openxmlformats.org/officeDocument/'
                                   '2006/relationships/drawing" Target="../drawings/drawing1.xml"/></Relationships>')
                extra += '<drawing r:id="rIdD1"/>'
            files[f"xl/worksheets/sheet{idx}.xml"] = sheet_xml(rows or [[""]], [26, 12, 12, 12, 12], header=False,
                                                               extra=extra, bold_rows=tuple(bold))
        else:
            rows = [t["headers"]] + [list(r) for r in t["rows"]]
            widths = []
            for j in range(len(t["headers"])):
                mx = max([len(_cell_str(r[j])) if j < len(r) else 0 for r in rows] + [6])
                widths.append(min(70, max(8, mx + 2)))
            wrap = tuple(j for j, w in enumerate(widths) if w >= 70)
            files[f"xl/worksheets/sheet{idx}.xml"] = sheet_xml(rows, widths, header=True,
                                                               colors=t.get("colors"), wrap_cols=wrap)
    for idx, x in rels_extra.items():
        files[f"xl/worksheets/_rels/sheet{idx}.xml.rels"] = x
    wb = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
          '<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" '
          'xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets>'
          + "".join(f'<sheet name="{xesc(n)}" sheetId="{i}" r:id="rId{i}"/>' for i, n in enumerate(names, 1))
          + "</sheets></workbook>")
    wbrels = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
