MOVED_SKIP = {"appdata", "node_modules", "windows", "program files", "program files (x86)", "programdata",
              "__pycache__", "system volume information", "recovery", "perflogs", "$recycle.bin", "msocache",
              "site-packages", "dist-packages", ".git", "bindlens-data"}


def names_overlap(a, b):
    """How much of the names list a is in b (0..1)."""
    if not a:
        return 0.0
    bb = {os.path.normcase(x) for x in (b or ())}
    return sum(1 for x in a if os.path.normcase(x) in bb) / len(a)


def moved_roots(missing, other_sources):
    """Where to look for moved folders, nearest first: (folder, how deep)."""
    roots, have = [], set()

    def add(d, depth):
        try:
            if not d or not os.path.isdir(d):
                return
        except OSError:
            return
        k = os.path.normcase(os.path.abspath(d))
        if k not in have:
            have.add(k)
            roots.append((d, depth))
    for m in missing:                                   # near where it was: its parent, grandparent...
        a, k = os.path.dirname(os.path.normpath(m)), 0
        while a and k < 4:
            if os.path.isdir(a):
                add(a, 4 if k < 2 else 3)
                k += 1
            nxt = os.path.dirname(a)
            if nxt == a:
                break
            a = nxt
    home = os.path.expanduser("~")
    places = []
    for env in ("OneDrive", "OneDriveConsumer", "OneDriveCommercial"):
        if os.environ.get(env):
            places.append(os.environ[env])
    for base in [home] + places:
        for sub in ("Desktop", "Documents", "Downloads"):
            add(os.path.join(base, sub), 5)
    for pl in places:
        add(pl, 4)
    for src in other_sources:                           # where your other books are
        add(os.path.dirname(os.path.normpath(src)), 3)
    add(home, 4)
    return roots


def find_moved(targets, roots, budget=14.0, max_dirs=90000, stop=None):
    """targets: {key: (folder name, id, disk, names)} -> {key: ("ok", path) | ("many", [paths])}.
    The same id on the same disk = the very same folder (moved or renamed). Otherwise a folder with the same name
    and the same files in it. Runs in a thread; gives up after 'budget' seconds."""
    from collections import deque
    t0 = time.time()
    by_name, by_id = {}, {}
    for k, (base, ino, dev, names) in targets.items():
        by_name.setdefault(os.path.normcase(base), []).append(k)
        if ino:
            by_id.setdefault(ino, []).append(k)
    found = {k: None for k in targets}
    cands = {k: [] for k in targets}
    seen, count = set(), 0
    olds = set(targets)
    def settle_names():
        """2.0 - after each place: a folder with the same name AND the same files is it - stop looking for it
        (before, a folder found by its name only was searched for until the time ran out)."""
        for k, (base, ino, dev, names) in targets.items():
            if found[k] or not cands[k]:
                continue
            cs = list(dict.fromkeys(cands[k]))
            if not names:
                if len(cs) == 1:
                    found[k] = cs[0]
                continue
            best, sc_best, n_good = None, 0.0, 0
            for c_ in cs:
                try:
                    sc = names_overlap(names, os.listdir(c_))
                except OSError:
                    continue
                if sc >= 0.6:
                    n_good += 1
                if sc > sc_best:
                    best, sc_best = c_, sc
            if best and sc_best >= 0.6 and n_good == 1:
                found[k] = best
    for root, depth in roots:
        if count > max_dirs or time.time() - t0 > budget or (stop and stop()):
            break
        settle_names()
        if all(found.values()):
            break
        q = deque([(root, 0)])
        while q:
            d, lv = q.popleft()
            nd = os.path.normcase(os.path.abspath(d))
            if nd in seen:
                continue
            seen.add(nd)
            count += 1
            if count > max_dirs or (count % 100 == 0 and (time.time() - t0 > budget or (stop and stop()))):
                break
            try:
                it = os.scandir(d)
            except OSError:
                continue
            with it:
                for e in it:
                    n = e.name
                    if n.startswith((".", "$", "~")) or n.lower() in MOVED_SKIP:
                        continue
                    try:
                        if not e.is_dir(follow_symlinks=False) or e.is_symlink() or \
                                (hasattr(e, "is_junction") and e.is_junction()):
                            continue
                    except OSError:
                        continue
                    pth = e.path
                    npth = os.path.normcase(os.path.abspath(pth))
                    if npth in olds:
                        continue
                    if by_id:
                        try:
                            ino = e.inode()
                        except OSError:
                            ino = 0
                        for k in by_id.get(ino, ()):
                            if found[k] is None:
                                try:
                                    st = os.stat(pth)
                                except OSError:
                                    continue
                                if not targets[k][2] or st.st_dev == targets[k][2]:
                                    found[k] = pth
                    for k in by_name.get(os.path.normcase(n), ()):
                        cands[k].append(pth)
                    if lv + 1 < depth:
                        q.append((pth, lv + 1))
    out = {}
    for k, (base, ino, dev, names) in targets.items():
        if found[k]:
            out[k] = ("ok", found[k])
            continue
        cs = list(dict.fromkeys(cands[k]))
        if not cs:
            continue
        if names:                                       # the same files in it
            scored = []
            for c_ in cs:
                try:
                    have = os.listdir(c_)
                except OSError:
                    continue
                scored.append((names_overlap(names, have), c_))
            scored.sort(key=lambda t: -t[0])
            good = [c_ for sc, c_ in scored if sc >= 0.5]
            if len(good) == 1 or (good and scored[0][0] - scored[1][0] >= 0.3):
                out[k] = ("ok", good[0])
            elif good:
                out[k] = ("many", good[:6])
            elif scored:
                out[k] = ("many", [c_ for _, c_ in scored[:6]])
        elif len(cs) == 1:                              # nothing remembered: the only folder with its name
            out[k] = ("ok", cs[0])
        else:
            out[k] = ("many", cs[:6])
    return out


def cloud_only(st):
    """2.0 - a OneDrive file that is 'online only' (Windows downloads it when it is read)."""
    return os.name == "nt" and bool(getattr(st, "st_file_attributes", 0) & (0x400000 | 0x40000 | 0x1000))


class Library:
    """Your books are LINKS to folders and files where they already are (Desktop, OneDrive…).
    Nothing is copied: marks are saved straight into the original PDFs.

    library.json (inside the app folder) keeps:
      collections: [{"name", "sources": [folders or files], "exclude": [files], "color"}]
      positions, settings
    """

    def __init__(self, app_dir, scan=True):
        self.path = app_dir
        self.meta_dir = data_dir()
        self.folders, self.paths, self.where, self.missing, self.subdirs = OrderedDict(), {}, {}, {}, {}
        self.meta_path = os.path.join(self.meta_dir, "library.json")
        self.meta = load_json(self.meta_path, {})
        if not self.meta:
            if os.path.exists(self.meta_path + ".bak"):          # a broken save: use the last good copy
                self.meta = load_json(self.meta_path + ".bak", {})
        if not self.meta and os.path.exists(self.meta_path) and os.path.getsize(self.meta_path) > 2:
            # 3.0: the list of books could not be read - never start empty over it: keep the broken file aside and
            # take the newest daily copy
            try:
                shutil.copyfile(self.meta_path, self.meta_path[:-5] + time.strftime(".broken-%Y%m%d-%H%M%S.json"))
            except Exception:
                pass
            bdir = os.path.join(self.meta_dir, "library copies")
            for nm in sorted(os.listdir(bdir) if os.path.isdir(bdir) else [], reverse=True):
                self.meta = load_json(os.path.join(bdir, nm), {})
                if self.meta.get("collections"):
                    break
        for old in (os.path.join(app_dir, META_DIR_NAME, "library.json"),            # BindLens 1.2 / 1.3
                    os.path.join(app_dir, "Library", META_DIR_NAME, "library.json")):  # 1.0 / 1.1
            if not self.meta and os.path.exists(old):
                self.meta = load_json(old, {})
        for k in ("colors", "positions", "settings"):
            self.meta.setdefault(k, {})
        if "collections" not in self.meta:
            self.meta["collections"] = self._migrate()
            self.save_meta()
        try:
            self.migrate_flat()
        except Exception:
            pass
        if scan:
            self.scan()

    def migrate_flat(self):
        """1.9.5: when a folder was added as 'one book per subfolder', its own loose files became a book with a
        FIXED list of files - a new document saved in that folder never appeared. Such a book now reads the folder
        itself (only the files right in it; its sub-folders are books of their own)."""
        changed = False
        for c in self.collections:
            srcs = c.get("sources", [])
            if c.get("flat") or not srcs or c.get("links") or any(os.path.isdir(x) for x in srcs):
                continue
            dirs = {os.path.dirname(os.path.abspath(x)) for x in srcs}
            if len(dirs) != 1:
                continue
            d = dirs.pop()
            if not os.path.isdir(d):
                continue
            base = clean_name(os.path.basename(d)) or "Book"
            if not (c["name"] == base or re.fullmatch(re.escape(base) + r" \(\d+\)", c["name"])):
                continue
            try:
                subs = {self.norm(os.path.join(d, x)) for x in os.listdir(d) if os.path.isdir(os.path.join(d, x))}
            except OSError:
                continue
            if not any(self.norm(s_) in subs for o in self.collections if o is not c for s_ in o.get("sources", [])):
                continue
            c["sources"], c["flat"] = [d], True
            changed = True
        if changed:
            self.save_meta()
        return changed

    def _migrate(self):
        """Older versions kept copies in BindLens/Library: link those folders so nothing is lost."""
        cols = []
        lib = os.path.join(self.path, "Library")
        if os.path.isdir(lib):
            for e in sorted(os.listdir(lib), key=natural_key):
                p = os.path.join(lib, e)
                if e.startswith(".") or not os.path.isdir(p):
                    continue
                cols.append({"name": e, "sources": [p], "exclude": [],
                             "color": self.meta["colors"].get(e)})
            loose = [os.path.join(lib, e) for e in sorted(os.listdir(lib), key=natural_key)
                     if not e.startswith(".") and os.path.isfile(os.path.join(lib, e))
                     and os.path.splitext(e)[1].lower() in SUPPORTED]
            if loose:
                cols.append({"name": "Unsorted", "sources": loose, "exclude": [], "color": "#9AA0A6"})
        welcome = os.path.join(self.path, "Welcome")
        if not cols and os.path.isdir(welcome):
            cols.append({"name": "Welcome", "sources": [welcome], "exclude": [], "color": "#6C63FF"})
        return cols

    def save_meta(self):
        try:
            if os.path.exists(self.meta_path):
                try:
                    shutil.copyfile(self.meta_path, self.meta_path + ".bak")
                except Exception:
                    pass
                # 3.0: one copy a day of the list of books (the last 10 days)
                try:
                    bdir = os.path.join(self.meta_dir, "library copies")
                    day = os.path.join(bdir, time.strftime("library-%Y-%m-%d.json"))
                    if not os.path.exists(day) and self.meta.get("collections"):
                        os.makedirs(bdir, exist_ok=True)
                        shutil.copyfile(self.meta_path, day)
                        for old in sorted(x for x in os.listdir(bdir) if x.startswith("library-"))[:-10]:
                            os.remove(os.path.join(bdir, old))
                except Exception:
                    pass
            save_json(self.meta_path, self.meta)
        except Exception as ex:
            try:
                with open(os.path.join(APP_DIR, "BindLens-error.log"), "a", encoding="utf-8") as fh:
                    fh.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} could not save {self.meta_path}: {ex}\n")
            except Exception:
                pass

    @property
    def settings(self):
        return self.meta["settings"]

    @property
    def collections(self):
        return self.meta["collections"]

    def col(self, name):
        return next((c for c in self.collections if c["name"] == name), None)

    @staticmethod
    def norm(p):
        return os.path.normcase(os.path.abspath(p))

    # ---- reading the folders: each folder's list is remembered with the folder's own date - Windows changes
    # that date when a file is added, removed or renamed in it - so reading big trees again is quick
    DIRCACHE_VERSION = 3

    def _dircache_load(self):
        self._dc = {}
        self._dc_dirty = False
        self._dc_path = os.path.join(self.meta_dir, "folders.json.gz")
        try:
            with gzip.open(self._dc_path, "rt", encoding="utf-8") as fh:
                d = json.load(fh)
            if d.get("v") == self.DIRCACHE_VERSION and d.get("sup") == sorted(SUPPORTED):
                self._dc = {k: tuple(v) for k, v in d["dirs"].items()}
        except Exception:
            pass

    def dircache_save(self):
        if not getattr(self, "_dc_dirty", False):
            return
        self._dc_dirty = False
        snap = {"v": self.DIRCACHE_VERSION, "sup": sorted(SUPPORTED), "dirs": dict(self._dc)}

        def work():
            try:
                save_json_gz(self._dc_path, snap)
            except Exception:
                pass
        threading.Thread(target=work, daemon=True).start()

    def _listdir(self, d, fresh, seen):
        """(sub-folders, supported files) of one folder - from memory when the folder did not change."""
        try:
            m = os.stat(d).st_mtime_ns
        except OSError:
            return [], []
        seen.add(d)
        self.scan_count = getattr(self, "scan_count", 0) + 1
        c = self._dc.get(d)
        if c and not fresh and c[0] == m:
            return c[1], c[2]
        dirs, files = [], []
        try:
            with os.scandir(d) as it:
                for e in it:
                    n = e.name
                    if n.startswith(".") or n.lower() in ("desktop.ini", "thumbs.db"):
                        continue
                    try:
                        # 3.0: Windows' hidden / system files (desktop.ini in OneDrive folders became a page)
                        if os.name == "nt" and getattr(e.stat(), "st_file_attributes", 0) & 0x6:
                            continue
                        if e.is_dir():
                            if not e.is_symlink() and not (hasattr(e, "is_junction") and e.is_junction()):
                                dirs.append(n)
                        elif is_supported(n):
                            files.append(n)
                    except OSError:
                        continue
        except OSError:
            return [], []
        dirs.sort(key=natural_key)
        if c is None or c[0] != m or c[1] != dirs or c[2] != files:
            self._dc[d] = (m, dirs, files)
            self._dc_dirty = True
        return dirs, files

    def _walk(self, top, fresh, seen, fresh_top=False, flat=False):
        """Like os.walk (top-down, folders in natural order), with the memory above.
        fresh_top: the top folder itself is always listed again (1.9.5); flat: only the top folder."""
        stack = [top]
        while stack:
            d = stack.pop()
            dirs, files = self._listdir(d, fresh or (fresh_top and d == top), seen)
            yield d, (dirs if not flat else []), files
            if flat:
                continue
            for sd in reversed(dirs):
                stack.append(os.path.join(d, sd))

    def move_collection(self, name, index):
        """Put a book at another place in the list (the order of the books)."""
        cols = self.collections
        c = self.col(name)
        if c is None:
            return
        cols.remove(c)
        cols.insert(max(0, min(len(cols), index)), c)
        order = [x["name"] for x in cols]
        self.folders = OrderedDict([(n, self.folders[n]) for n in order if n in self.folders] +
                                   [(n, v) for n, v in self.folders.items() if n not in order])
        self.save_meta()

    def scan(self, fresh=False):
        """Read every linked folder again (new files saved there appear automatically)."""
        self.apply_scan(self.compute_scan(fresh))

    def apply_scan(self, r):
        self.folders, self.paths, self.where = r["folders"], r["paths"], r["where"]
        self.missing, self.subdirs = r["missing"], r["subdirs"]
        self.dircache_save()
        try:
            self._keep_fps(r.get("fps") or {})
        except Exception:
            pass
        cb = getattr(self, "on_missing", None)
        if cb and self.missing:
            cb()

    def _keep_fps(self, fps):
        """1.9.9 - remember each book folder's fingerprint (to find it again if it is moved)."""
        store = self.meta.setdefault("fps", {})
        changed = False
        for k, v in fps.items():
            o = store.get(k)
            if v and (o is None or o[0] != v[0] or o[1] != v[1] or
                      ((o[2] or v[2]) and names_overlap(o[2], v[2]) < 0.7)):
                store[k] = v
                changed = True
        used = set()
        for c in self.collections:
            for x in c.get("sources", []):
                used.add(self.norm(x))
                used.add(self.norm(os.path.dirname(os.path.normpath(x))))
            for ln in c.get("links", []):
                used.add(self.norm(ln.get("path", "")))
        for k in [k for k in store if k not in used]:
            store.pop(k, None)
            changed = True
        if changed:
            self.save_meta()

    def fingerprint(self, d):
        """A folder's id on the disk and some of the names in it."""
        try:
            st = os.stat(d)
        except OSError:
            return None
        c = getattr(self, "_dc", {}).get(d)
        if c:
            names = list(c[1]) + list(c[2])
        else:
            try:
                names = [n for n in os.listdir(d) if not n.startswith(".")]
            except OSError:
                names = []
        return [int(st.st_ino or 0), int(st.st_dev or 0), sorted(names, key=natural_key)[:40]]

    def relink(self, old, new):
        """1.9.9 - a folder was moved: every path of every book under 'old' now points under 'new' (the books keep
        their names, colours, icons, places, tags and reminders - the marks are inside the files anyway)."""
        if not new or not os.path.exists(new):
            return []
        oa, na = os.path.abspath(old), os.path.abspath(new)
        o = self.norm(oa)
        if o == self.norm(na):
            return []

        def mv(x):
            if not x:
                return x
            xa = os.path.abspath(x)
            nx = self.norm(xa)
            if nx == o:
                return na
            if nx.startswith(o.rstrip("\\/") + os.sep):
                return os.path.join(na, xa[len(oa):].lstrip("\\/"))
            return x
        hit = []
        for c in self.collections:
            before = json.dumps([c.get("sources"), c.get("links"), c.get("exclude")], default=str)
            c["sources"] = [mv(x) for x in c.get("sources", [])]
            if c.get("exclude"):
                c["exclude"] = [mv(x) for x in c["exclude"]]
            for ln in c.get("links", []):
                ln["path"] = mv(ln.get("path", ""))
            if json.dumps([c.get("sources"), c.get("links"), c.get("exclude")], default=str) != before:
                hit.append(c["name"])
        tags = self.meta.get("tags")
        if tags:
            self.meta["tags"] = {(self.norm(mv(k)) if self.norm(mv(k)) != k else k): v for k, v in tags.items()}
        for r_ in self.meta.get("reminders", []):
            if r_.get("path"):
                r_["path"] = mv(r_["path"])
        fps = self.meta.get("fps", {})
        for k in list(fps):
            nk = self.norm(mv(k))
            if nk != k:
                fps[nk] = fps.pop(k)
        self.save_meta()
        return hit

    _scan_lock = threading.RLock()

    def compute_scan(self, fresh=False, fresh_names=None, fresh_roots=False):
        """The books' files as they are on the disk now. Changes nothing here (it may run in a thread).
        fresh_names: books whose folders are listed again even if Windows says they did not change.
        fresh_roots: every book's own folder is listed again (its sub-folders only if they changed).
        1.9.5: one scan at a time (two at once could spoil each other's memory of the folders)."""
        with self._scan_lock:
            return self._compute_scan(fresh, fresh_names, fresh_roots)

    def _compute_scan(self, fresh=False, fresh_names=None, fresh_roots=False):
        if not hasattr(self, "_dc"):
            self._dircache_load()
        self.scan_count = 0
        seen_dirs = set()
        R = {"folders": OrderedDict(), "paths": {}, "where": {}, "missing": {}, "subdirs": {}, "fps": {}}
        folders, paths, where, missing, subdirs = R["folders"], R["paths"], R["where"], R["missing"], R["subdirs"]
        fps, fp_dirs = R["fps"], {}
        for c in list(self.collections):
            name = c["name"]
            fr = fresh or bool(fresh_names and name in fresh_names)
            excl = {self.norm(x) for x in c.get("exclude", [])}
            files, seen = [], set()
            many = sum(1 for x in c.get("sources", []) if os.path.isdir(x)) > 1
            for src in c.get("sources", []):
                if os.path.isdir(src):
                    found = []
                    fps[self.norm(src)] = None
                    subs = subdirs.setdefault(name, [])
                    base_rel = (os.path.basename(os.path.normpath(src)) + "/") if many else ""
                    if many:
                        subs.append(base_rel)
                    for dirpath, dirnames, filenames in self._walk(src, fr, seen_dirs, fresh_top=fresh_roots,
                                                                   flat=bool(c.get("flat"))):
                        if dirpath != src:
                            subs.append(base_rel + os.path.relpath(dirpath, src).replace(os.sep, "/") + "/")
                        for fn in filenames:
                            full = os.path.join(dirpath, fn)
                            rel = os.path.relpath(full, src).replace(os.sep, "/")
                            if many:
                                rel = os.path.basename(os.path.normpath(src)) + "/" + rel
                            found.append((rel, full))
                    found.sort(key=lambda t: natural_key(t[0]))
                elif os.path.isfile(src) and is_supported(src):
                    found = [(os.path.basename(src), src)]
                    fp_dirs[self.norm(os.path.dirname(src))] = os.path.dirname(src)
                else:
                    missing.setdefault(name, []).append(src)
                    found = []
                for rel, full in found:
                    n = self.norm(full)
                    if n in excl or n in seen:
                        continue
                    seen.add(n)
                    base, k = rel, 2
                    while (name, rel) in paths:
                        rel = f"{base} ({k})"
                        k += 1
                    files.append(rel)
                    paths[(name, rel)] = full
                    where[n] = (name, rel)
            # sub-books LINKED from anywhere on the computer (they stay where they are)
            links = sorted(c.get("links", []), key=lambda l: l.get("at", ""))
            for ln in links:
                at, src = ln.get("at", ""), ln.get("path", "")
                if not at:
                    continue
                subs = subdirs.setdefault(name, [])
                if at not in subs:
                    subs.append(at)
                if not os.path.isdir(src):
                    missing.setdefault(name, []).append(src)
                    continue
                found = []
                fp_dirs[self.norm(src)] = src
                for dirpath, dirnames, filenames in self._walk(src, fr, seen_dirs, fresh_top=fresh_roots):
                    if dirpath != src:
                        sub = at + os.path.relpath(dirpath, src).replace(os.sep, "/") + "/"
                        if sub not in subs:
                            subs.append(sub)
                    for fn in filenames:
                        full = os.path.join(dirpath, fn)
                        found.append((at + os.path.relpath(full, src).replace(os.sep, "/"), full))
                found.sort(key=lambda t: natural_key(t[0]))
                for rel, full in found:
                    n = self.norm(full)
                    if n in excl or n in seen:
                        continue
                    seen.add(n)
                    base, k = rel, 2
                    while (name, rel) in paths:
                        rel = f"{base} ({k})"
                        k += 1
                    files.append(rel)
                    paths[(name, rel)] = full
                    where[n] = (name, rel)
            if links:
                files.sort(key=natural_key)
                subdirs[name] = sorted(set(subdirs.get(name, [])), key=natural_key)
            folders[name] = files
            for src in c.get("sources", []):
                if self.norm(src) in fps:
                    fp_dirs[self.norm(src)] = src
        for k, d in fp_dirs.items():                                # the folders' fingerprints (1.9.9)
            fps[k] = self.fingerprint(d)
        if fresh or not getattr(self, "_dc_pruned", False):         # forget folders no book uses
            for d in [d for d in self._dc if d not in seen_dirs]:
                self._dc.pop(d, None)
                self._dc_dirty = True
            self._dc_pruned = True
        return R

    def link_for(self, folder, prefix):
        """The linked sub-book a prefix is in (or None)."""
        c = self.col(folder) or {}
        best = None
        for ln in c.get("links", []):
            at = ln.get("at", "")
            if at and prefix.startswith(at) and (best is None or len(at) > len(best["at"])):
                best = ln
        return best

    def add_link(self, folder, path, at):
        c = self.col(folder)
        if c is None:
            return None
        at = at.strip("/") + "/"
        used = {x.get("at") for x in c.get("links", [])} | set(self.subdirs.get(folder, []))
        base, k = at[:-1], 2
        while at in used:
            at = f"{base} ({k})/"
            k += 1
        c.setdefault("links", []).append({"path": os.path.abspath(path), "at": at})
        self.save_meta()
        return at

    def dir_for(self, folder, prefix=""):
        """The real folder on your computer for a book (or one of its sub-books)."""
        c = self.col(folder)
        ln = self.link_for(folder, prefix) if prefix else None
        if ln:
            rest = prefix[len(ln["at"]):].strip("/")
            return os.path.join(ln["path"], *rest.split("/")) if rest else ln["path"]
        dirs = [x for x in (c or {}).get("sources", []) if os.path.isdir(x)]
        if not dirs:
            return None
        if not prefix:
            return dirs[0]
        parts = prefix.strip("/").split("/")
        if len(dirs) > 1:
            for d in dirs:
                if os.path.basename(os.path.normpath(d)) == parts[0]:
                    return os.path.join(d, *parts[1:]) if parts[1:] else d
            return dirs[0]
        return os.path.join(dirs[0], *parts)

    def folder_path(self, folder):
        """The first linked folder of a book (for 'show in Explorer')."""
        c = self.col(folder)
        for src in (c or {}).get("sources", []):
            if os.path.isdir(src):
                return src
            if os.path.isfile(src):
                return os.path.dirname(src)
        return None

    def file_path(self, folder, rel):
        return self.paths.get((folder, rel), "")

    def label(self, folder):
        return folder

    def icon(self, folder):
        return (self.col(folder) or {}).get("icon") or "letters"

    def tstyle(self, folder):
        return (self.col(folder) or {}).get("tstyle") or self.settings.get("tile_style", "3d")

    def badge(self, folder):
        return (self.col(folder) or {}).get("badge")

    @property
    def title(self):
        return self.settings.get("library_title") or "Library"

    def color(self, folder):
        c = self.col(folder)
        return (c or {}).get("color") or FOLDER_COLORS[sum(map(ord, folder or "u")) % len(FOLDER_COLORS)]

    def unique_name(self, name):
        name = clean_name(name) or "Book"
        base, k = name, 2
        while self.col(name):
            name = f"{base} ({k})"
            k += 1
        return name

    def add_collection(self, name, sources):
        name = self.unique_name(name)
        self.collections.append({"name": name, "sources": [os.path.abspath(p) for p in sources], "exclude": [],
                                 "color": FOLDER_COLORS[len(self.collections) % len(FOLDER_COLORS)]})
        self.save_meta()
        return name

    def all_files(self):
        for folder, files in self.folders.items():
            for rel in files:
                yield folder, rel


