def ensure_pymupdf():
    try:
        import pymupdf
        return pymupdf
    except ImportError:
        if FROZEN:                                 # 4.5: inside BindLens.exe it is always there
            raise
    try:
        import fitz as pymupdf
        return pymupdf
    except ImportError:
        pass
    root = tk.Tk()
    root.withdraw()
    if not messagebox.askyesno(APP_NAME, "BindLens needs a component called PyMuPDF to read documents.\n\n"
                                         "Install it now? (needs internet, takes about a minute)"):
        sys.exit(0)
    flags = 0x08000000 if os.name == "nt" else 0
    try:
        subprocess.check_call([sys.executable, "-m", "pip", "install", "--user", "pymupdf", "tkinterdnd2"],
                              creationflags=flags)
    except Exception as e:
        messagebox.showerror(APP_NAME, "Automatic install failed. Run 'Install.bat', or type in a command "
                                       f"prompt:\n\n    pip install pymupdf tkinterdnd2\n\nDetails: {e}")
        sys.exit(1)
    root.destroy()
    import importlib
    import site
    try:
        sys.path.append(site.getusersitepackages())
    except Exception:
        pass
    importlib.invalidate_caches()
    import pymupdf
    return pymupdf


def agpl_producer(fitz):
    """4.3.1: PDFs that BindLens MAKES (reports, new pages, saved pages, scans…) say in their properties that they
    were made with BindLens and PyMuPDF under the GNU AGPL (as Artifex asks). Your own PDFs are never touched."""
    doc_cls = getattr(fitz, "Document", None)
    if doc_cls is None or getattr(doc_cls, "_bl_producer", False):
        return fitz
    orig = doc_cls.save

    def save(self, filename, *a, **k):
        try:
            if not getattr(self, "name", "") and getattr(self, "is_pdf", True):
                md = dict(self.metadata or {})
                if not md.get("producer"):
                    md["producer"] = (f"{APP_NAME} {APP_VERSION} - PyMuPDF {getattr(fitz, 'VersionBind', '')} "
                                      f"(GNU AGPL v3)")
                    md["creator"] = md.get("creator") or APP_NAME
                    self.set_metadata(md)
        except Exception:
            pass
        return orig(self, filename, *a, **k)
    doc_cls.save = save
    doc_cls._bl_producer = True
    return fitz


