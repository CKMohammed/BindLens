def words_of(text, keep_stop=False):
    toks = re.findall(r"[A-Za-zÀ-ÿ][A-Za-zÀ-ÿ'’-]*[A-Za-zÀ-ÿ]|[A-Za-zÀ-ÿ]", (text or "").lower())
    return [t for t in toks if keep_stop or (len(t) > 2 and t not in STOPWORDS)]


def sentences_of(text):
    t = re.sub(r"[ \t]+", " ", text or "")
    parts = re.split(r"(?<=[.!?])\s+(?=[A-ZÁÉÍÓÚÑ0-9\"“(])|\n{2,}|\n(?=[•\-–*]\s)", t)
    out = []
    for p in parts:
        p = " ".join(p.split())
        if 25 <= len(p) <= 600 and len(p.split()) >= 4:
            out.append(p)
    return out


def keyphrases(text, top=25):
    """RAKE: phrases between stop words, scored by how connected their words are."""
    toks = re.findall(r"[A-Za-zÀ-ÿ][A-Za-zÀ-ÿ'’-]*|[.,;:!?()\n|]", (text or "").lower())
    phrases, cur = [], []
    for t in toks:
        if t in STOPWORDS or not t[0].isalpha() or len(t) < 3:
            if cur:
                phrases.append(tuple(cur))
            cur = []
        else:
            cur.append(t)
    if cur:
        phrases.append(tuple(cur))
    freq, deg = {}, {}
    for ph in phrases:
        if len(ph) > 4:
            continue
        for w in ph:
            freq[w] = freq.get(w, 0) + 1
            deg[w] = deg.get(w, 0) + len(ph) - 1
    scores = {}
    counts = {}
    for ph in phrases:
        if len(ph) > 4 or len(ph) < 1:
            continue
        counts[ph] = counts.get(ph, 0) + 1
        scores[ph] = sum((deg[w] + freq[w]) / freq[w] for w in ph)
    ranked = sorted(scores, key=lambda p: -(scores[p] * min(counts[p], 6) ** 0.5))
    out = []
    for ph in ranked:
        if counts[ph] < 2 and len(ph) == 1:
            continue
        out.append((" ".join(ph), counts[ph], round(scores[ph], 1)))
        if len(out) >= top:
            break
    return out


def tfidf_terms(docs, top=8):
    """docs: {name: text} -> {name: [(word, score)]} - words typical of each document."""
    import math
    tfs, df = {}, {}
    for name, text in docs.items():
        c = {}
        for w in words_of(text):
            c[w] = c.get(w, 0) + 1
        tfs[name] = c
        for w in c:
            df[w] = df.get(w, 0) + 1
    n = max(1, len(docs))
    out = {}
    for name, c in tfs.items():
        tot = sum(c.values()) or 1
        sc = {w: (k / tot) * math.log((1 + n) / (1 + df[w]) + 1) for w, k in c.items() if k >= 2 or n == 1}
        out[name] = sorted(sc.items(), key=lambda kv: -kv[1])[:top]
    return out


def ngrams(text, n=2, top=30):
    toks = words_of(text, keep_stop=True)
    out = {}
    for i in range(len(toks) - n + 1):
        g = toks[i:i + n]
        if g[0] in STOPWORDS or g[-1] in STOPWORDS or any(len(w) < 3 and w not in ("de",) for w in g):
            continue
        k = " ".join(g)
        out[k] = out.get(k, 0) + 1
    return sorted([(k, v) for k, v in out.items() if v >= 2], key=lambda kv: -kv[1])[:top]


def near_words(text, term, window=5, top=20):
    toks = words_of(text, keep_stop=True)
    tl = term.lower().split()
    out = {}
    L = len(tl)
    for i in range(len(toks) - L + 1):
        if toks[i:i + L] == tl:
            for w in toks[max(0, i - window):i] + toks[i + L:i + L + window]:
                if w not in STOPWORDS and len(w) > 2 and w not in tl:
                    out[w] = out.get(w, 0) + 1
    return sorted(out.items(), key=lambda kv: -kv[1])[:top]


def in_context(text, term, width=70, whole=True):
    """Every place a word appears, with the words before and after it."""
    pat = re.compile((r"(?<!\w)" + re.escape(term) + r"(?!\w)") if whole else re.escape(term), re.I)
    flat = " ".join((text or "").split())
    out = []
    for m in pat.finditer(flat):
        left = flat[max(0, m.start() - width):m.start()]
        right = flat[m.end():m.end() + width]
        if m.start() - width > 0:
            left = "…" + left.split(" ", 1)[-1] if " " in left else "…" + left
        if m.end() + width < len(flat):
            right = (right.rsplit(" ", 1)[0] if " " in right else right) + "…"
        out.append((left, m.group(0), right))
    return out


def tone_of(text):
    """(positive words, negative words, score -1..1) - simple word lists, 'not good' counts as negative."""
    toks = words_of(text, keep_stop=True)
    pos = neg = 0
    for i, w in enumerate(toks):
        s = 1 if w in POS_WORDS else (-1 if w in NEG_WORDS else 0)
        if not s:
            continue
        if any(t in NEGATORS for t in toks[max(0, i - 3):i]):
            s = -s
        if s > 0:
            pos += 1
        else:
            neg += 1
    tot = pos + neg
    return pos, neg, ((pos - neg) / tot if tot else 0.0)


def syllables(word):
    w = word.lower()
    if len(w) <= 3:
        return 1
    w = re.sub(r"(?:[^laeiouy]es|ed|[^laeiouy]e)$", "", w)
    w = re.sub(r"^y", "", w)
    return max(1, len(re.findall(r"[aeiouyáéíóú]{1,2}", w)))


def readability(text):
    """Flesch reading ease (0 hard - 100 easy), words per sentence, long sentences."""
    sents = sentences_of(text) or ([text] if text and text.strip() else [])
    words = re.findall(r"[A-Za-zÀ-ÿ]+", text or "")
    if not words or not sents:
        return None
    syl = sum(syllables(w) for w in words)
    wps = len(words) / len(sents)
    spw = syl / len(words)
    fre = 206.835 - 1.015 * wps - 84.6 * spw
    long_s = [s for s in sents if len(s.split()) > 30]
    return {"flesch": max(0, min(100, round(fre))), "wps": round(wps, 1), "words": len(words),
            "sentences": len(sents), "long": long_s, "minutes": max(1, round(len(words) / 230))}


def flesch_label(v):
    return ("Very easy" if v >= 80 else "Easy" if v >= 70 else "Fairly easy" if v >= 60 else "Standard" if v >= 50
            else "Fairly difficult" if v >= 40 else "Difficult" if v >= 30 else "Very difficult")


def key_sentences(text, top=5):
    """TextRank: the sentences that share the most words with the others (in their order in the text)."""
    sents = sentences_of(text)[:220]
    if not sents:
        return []
    bags = [set(words_of(s)) for s in sents]
    n = len(sents)
    import math
    W = [[0.0] * n for _ in range(n)]
    for i in range(n):
        for j in range(i + 1, n):
            inter = len(bags[i] & bags[j])
            if inter:
                v = inter / (math.log(len(bags[i]) + 2) + math.log(len(bags[j]) + 2))
                W[i][j] = W[j][i] = v
    sc = [1.0] * n
    outs = [sum(r) or 1 for r in W]
    for _ in range(25):
        sc = [0.15 + 0.85 * sum(W[j][i] / outs[j] * sc[j] for j in range(n) if W[j][i]) for i in range(n)]
    best = sorted(range(n), key=lambda i: -sc[i])[:top]
    return [sents[i] for i in sorted(best)]


def similarity(a, b):
    """0..1 how much two texts share (word shingles)."""
    def sh(t):
        w = words_of(t, keep_stop=True)
        return {" ".join(w[i:i + 3]) for i in range(max(0, len(w) - 2))}
    A, B = sh(a), sh(b)
    if not A or not B:
        return 0.0
    return len(A & B) / len(A | B)


def luhn_ok(num):
    d = [int(c) for c in re.sub(r"\D", "", num)]
    if not 13 <= len(d) <= 19:
        return False
    s = 0
    for i, x in enumerate(reversed(d)):
        if i % 2:
            x *= 2
            if x > 9:
                x -= 9
        s += x
    return s % 10 == 0


def doc_type(text):
    t = (text or "")[:6000].lower()
    best, bs = "Other", 0
    for name, pat in DOC_TYPES:
        n = len(re.findall(pat, t))
        if n > bs:
            best, bs = name, n
    return best if bs >= 2 else "Other"


NAME_PARTICLES = {"ó", "o", "ní", "nic", "mac", "mc", "de", "del", "della", "van", "von", "da", "di", "le", "la",
                  "du", "ua", "bin", "al", "ui"}
TITLES = {"mr", "mrs", "ms", "miss", "dr", "prof", "sr", "sra", "srta", "fr", "rev"}


def person_like(text):
    """'MARY RYAN', 'Ryan, Mary', 'Seán Ó Briain', 'Dr. J. Murphy' -> a tidy name, or ''."""
    t = (text or "").strip(" \t,;:-|•*·")
    if not t or len(t) > 48 or re.search(r"\d|@|/|\\|_|=|\+|#|%|€|\$|£", t):
        return ""
    t = re.sub(r"\s+", " ", t)
    m = re.fullmatch(r"([A-Za-zÀ-ÿ'’\-]+),\s*([A-Za-zÀ-ÿ'’\-. ]+)", t)
    if m:
        t = m.group(2).strip() + " " + m.group(1)
    if t.isupper():
        t = " ".join(w if w.lower() in NAME_PARTICLES else w.capitalize() for w in t.split())
        t = re.sub(r"\bMc([a-z])", lambda x: "Mc" + x.group(1).upper(), t)
        t = re.sub(r"\bO'([a-z])", lambda x: "O'" + x.group(1).upper(), t)
    words = t.split()
    core = [w for w in words if w.lower().rstrip(".") not in TITLES]
    if not 2 <= len(core) <= 4:
        return ""
    real = 0
    for w in core:
        wl = w.lower()
        if wl in NAME_PARTICLES:
            continue
        if not re.fullmatch(r"[A-ZÀ-Þ](?:[a-zß-ÿ'’\-]+(?:[A-ZÀ-Þ][a-zß-ÿ'’\-]+)?|\.)?", w):
            return ""
        if len(w) > 2:
            real += 1
    if real < 1 or NOT_NAME.search(t):
        return ""
    return t


def name_from_email(email):
    """4.0: the person an address is for, from the part before the @: mary.ryan@ / ryan.mary@ -> Mary Ryan,
    m.ryan@ -> M. Ryan, maryryan@ -> Mary Ryan (a known first name at the start). Office mailboxes (info@,
    accounts@, principal@…) are not a person -> ''."""
    local = (email or "").split("@")[0].split("+")[0].lower()
    local = re.sub(r"\d+", "", local).strip("._-")
    if not local or GENERIC_MAILBOX.match(re.sub(r"[._-]", "", local)):
        return ""
    parts = [p for p in re.split(r"[._-]+", local) if p]
    if not all(p.isalpha() for p in parts):
        return ""
    cap = lambda w: ("Mc" + w[2:].capitalize()) if w.startswith("mc") and len(w) > 3 else w.capitalize()
    if len(parts) == 3 and len(parts[1]) == 1:
        parts = [parts[0], parts[2]]
    if len(parts) == 2:
        a, b = parts
        if len(a) == 1 and len(b) >= 3:
            return f"{a.upper()}. {cap(b)}"
        if len(b) == 1 and len(a) >= 3:
            return f"{b.upper()}. {cap(a)}"
        if len(a) < 2 or len(b) < 2:
            return ""
        fa, fb = fold(a) in FIRST_NAMES, fold(b) in FIRST_NAMES
        if fb and not fa:
            a, b = b, a
        return f"{cap(a)} {cap(b)}"
    if len(parts) == 1 and len(local) >= 7:
        w = parts[0]
        for k in range(min(len(w) - 3, 10), 2, -1):           # the longest first name at the start
            if w[:k] in FIRST_NAMES:
                return f"{cap(w[:k])} {cap(w[k:])}"
    return ""


LINK_ROLE = (r"(?:child|parent|guardian|mother|father|contact|emergency contact|emergency|next of kin|first|full|"
             r"student|pupil|staff|employee|manager|teacher|owner|applicant|client|customer|tenant|patient|member|"
             r"carer|person|name|nombre|contacto|tutor|madre|padre)")
LINK_LABEL = re.compile(r"\b" + LINK_ROLE + r"(?:'?s)?(?:\s*(?:/|or|&|and)\s*" + LINK_ROLE + r"(?:'?s)?)*"
                        r"(?:\s+(?:name|contact|person))?\s*\d?\s*[:\-–]\s*(.{3,48})", re.I)


def _label_person(text):
    m = LINK_LABEL.search(text or "")
    if not m:
        return ""
    return person_like(re.split(r"\s{2,}|\||,(?=\s*\d)|\b(?:phone|tel|mob\w*|email|e-mail|address)\b", m.group(1),
                                flags=re.I)[0])


def _chunk_person(text, pos=None):
    """A name inside a line like 'Murphy, Kate - 01 234 5678' (the one just before the value)."""
    best = ""
    for mm in re.finditer(r"[^|•·:\-–—\n]+", text or ""):
        if pos is not None and mm.start() > pos:
            break
        chunk = re.split(r"\s{2,}|(?<=\D)(?=\+?\d[\d ()-]{6,})", mm.group(0))[0]
        p = person_like(chunk)
        if p:
            best = p
    return best


def link_person(rows, i, last=None, value=None):
    """Who a phone / email on rows[i] belongs to -> (name, how). 4.0, in this order: the email's own header
    ("Mary Ryan" <mary@…>), the same table row (by what each column holds, and its role), a 'Name:' label, a name
    on the same line, the heading above a table ('Contacts for Seán Ó Briain'), the nearest name in the same part
    of the page (not across another record: 'Email:' seen again = another person) - checked against the email
    address - then the address itself, then the last person named earlier in the file."""
    row = rows[i]
    text = row.get("text", "")
    is_mail = bool(value and "@" in value)
    if is_mail:
        p = email_header_name(text, value)
        if p:
            return p, "email header"
        if GENERIC_MAILBOX.match(re.sub(r"[._-]|\d", "", value.split("@")[0])) and not row.get("table"):
            return "", ""                                   # info@, accounts@… an office's mailbox, not a person
    if row.get("ct"):
        who, how = row_person(row, _cell_of(row, value))
        if who:
            return who, how
    who = person_name(row)
    if who:
        return who, "same row"
    for c in row.get("cells", []):
        p = person_like(c)
        if p:
            return p, "same row"
    p = _label_person(text)
    if p:
        return p, "label"
    pos = text.find(value) if value else None
    p = _chunk_person(text, pos if pos and pos > 0 else None)
    if p:
        en = name_from_email(value) if is_mail else ""
        if en and not email_match(p, value) and not any(w.lower() in value.lower() for w in p.split() if len(w) > 2):
            return en, "from email"
        return p, "same row"
    if row.get("table") and row.get("title"):
        p = heading_person(row["title"])
        if p:
            return p, "heading"
    box = row.get("box")
    lab_i = _row_label(text)
    lh = max(8.0, (box[3] - box[1]) if box else 12.0)
    # the usual distance from one line to the next here: a gap clearly bigger = an empty line = another block
    tops = [r.get("box")[1] for r in rows[max(0, i - 12):i + 12] if r.get("box")]
    steps = sorted(b - a for a, b in zip(tops, tops[1:]) if b - a > 1)
    pitch = steps[len(steps) // 2] if steps else lh
    cands = []
    for k in range(max(0, i - 10), min(len(rows), i + 5)):
        if k == i:
            continue
        r = rows[k]
        cand = _label_person(r.get("text", ""))
        how = "label" if cand else "nearby"
        if not cand and len(r.get("cells", [])) <= 3:
            for c in r.get("cells", []):
                cand = person_like(c)
                if cand:
                    break
        if not cand:
            continue
        dist = abs(k - i) * (1.0 if k < i else 1.6)
        if how == "label":
            dist -= 1.5
        lo, hi = sorted((k, i))
        if box and r.get("box"):
            b2 = r["box"]
            if min(box[2], b2[2]) - max(box[0], b2[0]) < -40:
                dist += 6                                    # another column of the page
            for q in range(lo, hi):                          # an empty line between = another block
                a1, a2 = rows[q].get("box"), rows[q + 1].get("box")
                if a1 and a2 and (a2[1] - a1[3] > lh * 1.3 or a2[1] - a1[1] > pitch * 1.6):
                    dist += 4
        if lab_i:                                            # the same label again between = another record
            if any(_row_label(rows[q].get("text", "")) == lab_i for q in range(lo + 1, hi) if q != i) or \
                    (k != i and _row_label(r.get("text", "")) == lab_i and k > i):
                dist += 6
        cands.append((dist, cand, "label" if how == "label" else "nearby"))
    cands.sort(key=lambda x: x[0])
    best = cands[0] if cands else None
    email_name = ""
    if is_mail:
        email_name = name_from_email(value)
        if best:
            m0 = email_match(best[1], value)
            if m0 >= 0.55:
                return best[1], best[2] + " · matches the email"
            fit = [c for c in cands if c[0] < 12 and email_match(c[1], value) >= 0.7]
            if fit:
                return fit[0][1], "nearby · matches the email"
    else:
        for e in find_values("Emails", text):
            email_name = name_from_email(e)
            if email_name:
                break
    if best and (best[0] < 3 or (best[0] < 9 and not email_name)):
        return best[1], best[2]
    if email_name:
        return email_name, "from email"
    p = heading_person(row.get("title")) if row.get("title") else ""
    if p:
        return p, "heading"
    if last:
        return last, "earlier in the file"
    return "", ""


def link_value(rows, i, j, last=None, value=None):
    """Like link_person, for the value in cell j of a table row (cards side by side, a column per person)."""
    row = rows[i]
    jv = _cell_of(row, value)
    if jv is not None:
        j = jv
    if value and "@" in value:
        p = email_header_name(row.get("text", ""), value)
        if p:
            return p, "email header"
    if row.get("ct") and any(t in ("name", "first") for t in row["ct"]):
        who, how = row_person(row, j)
        if who:
            return who, how
    if row.get("table") and len(row.get("cells", [])) > 1:
        if row.get("header") and any(NAME_HDR.search(h or "") for h in row["header"]):
            who = person_name(row)
            if who:
                return who, "same row"
        others = [c for k, c in enumerate(row["cells"]) if k != j]
        if not any(find_values("Phone numbers", c) or find_values("Emails", c) for c in others):
            return link_person(rows, i, last, value)
        hdr = row.get("header") or []
        if j < len(hdr):
            p = person_like(hdr[j])
            if p:
                return p, "column"
        for k in range(i - 1, max(-1, i - 8), -1):
            r = rows[k]
            if r.get("tbox") != row.get("tbox") or j >= len(r.get("cells", [])):
                break
            p = person_like(r["cells"][j])
            if p:
                return p, "column"
    return link_person(rows, i, last, value)


