        def crop_dialog(p_):
            path = os.path.join(self.images_dir, f"{p_.d.get('img', '')}.png")
            try:
                pix = self.fitz.Pixmap(path)
            except Exception:
                return
            d = self._dialog("Crop the picture")
            k = min(600 / pix.width, 420 / pix.height, 1.5)
            dw, dh = max(20, int(pix.width * k)), max(20, int(pix.height * k))
            img = tk.PhotoImage(data=self.fitz.Pixmap(pix, dw, dh).tobytes("ppm") if pix.alpha == 0 else
                                self.fitz.Pixmap(self.fitz.Pixmap(pix, 0), dw, dh).tobytes("ppm"))
            P_ = 18
            cv = tk.Canvas(d, width=dw + 2 * P_, height=dh + 2 * P_, bg=T["panel"], highlightthickness=0)
            cv.pack(padx=16, pady=(14, 4))
            cv.create_image(P_, P_, image=img, anchor="nw")
            cv.img = img
            cr = list(p_.d.get("crop") or [0.0, 0.0, 0.0, 0.0])

            def box():
                return (P_ + cr[0] * dw, P_ + cr[1] * dh, P_ + dw - cr[2] * dw, P_ + dh - cr[3] * dh)

            def draw():
                cv.delete("ov")
                x0, y0, x1, y1 = box()
                for r_ in ((P_, P_, P_ + dw, y0), (P_, y1, P_ + dw, P_ + dh), (P_, y0, x0, y1), (x1, y0, P_ + dw, y1)):
                    cv.create_rectangle(*r_, fill="#000000", stipple="gray50", outline="", tags="ov")
                cv.create_rectangle(x0, y0, x1, y1, outline=ACC, width=2, tags="ov")
                for hx, hy in ((x0, y0), (x1, y0), (x0, y1), (x1, y1), ((x0 + x1) / 2, y0), ((x0 + x1) / 2, y1),
                               (x0, (y0 + y1) / 2), (x1, (y0 + y1) / 2)):
                    cv.create_rectangle(hx - 5, hy - 5, hx + 5, hy + 5, fill="#FFFFFF", outline=ACC, tags="ov")
            drag = {"h": None}

            def press(e):
                x0, y0, x1, y1 = box()
                hs = {"l": abs(e.x - x0) < 9, "r": abs(e.x - x1) < 9, "t": abs(e.y - y0) < 9,
                      "b": abs(e.y - y1) < 9}
                hit = {k_ for k_, v in hs.items() if v}
                if not hit and x0 < e.x < x1 and y0 < e.y < y1:
                    hit = {"move"}
                drag["h"] = (hit, e.x, e.y, list(cr))

            def move(e):
                if not drag["h"]:
                    return
                hit, x, y, c0 = drag["h"]
                dx, dy = (e.x - x) / dw, (e.y - y) / dh
                c = list(c0)
                if "move" in hit:
                    dx = max(-c0[0], min(c0[2], dx))
                    dy = max(-c0[1], min(c0[3], dy))
                    c = [c0[0] + dx, c0[1] + dy, c0[2] - dx, c0[3] - dy]
                else:
                    if "l" in hit:
                        c[0] = min(max(0.0, c0[0] + dx), 1 - c0[2] - 0.1)
                    if "r" in hit:
                        c[2] = min(max(0.0, c0[2] - dx), 1 - c0[0] - 0.1)
                    if "t" in hit:
                        c[1] = min(max(0.0, c0[1] + dy), 1 - c0[3] - 0.1)
                    if "b" in hit:
                        c[3] = min(max(0.0, c0[3] - dy), 1 - c0[1] - 0.1)
                cr[:] = c
                draw()
            cv.bind("<ButtonPress-1>", press)
            cv.bind("<B1-Motion>", move)
            cv.bind("<ButtonRelease-1>", lambda e: drag.update(h=None))
            draw()
            tk.Label(d, text="Drag the edges or corners - or drag the middle to move the frame.", font=self.F(9),
                     bg=T["panel"], fg=T["muted"]).pack()
            bf = tk.Frame(d, bg=T["panel"], padx=16, pady=10)
            bf.pack(fill="x")

            def ok():
                p_.set("crop", [round(x, 4) for x in cr] if any(x > 0.002 for x in cr) else None)
                d.destroy()
                sync_pic()

            def reset():
                cr[:] = [0.0, 0.0, 0.0, 0.0]
                draw()
            PillButton(bf, self, "Done", ok, kind="accent").pack(side="right")
            PillButton(bf, self, "Cancel", d.destroy, kind="ghost").pack(side="right", padx=6)
            PillButton(bf, self, "No crop", reset, kind="soft").pack(side="left")
            d.bind("<Return>", lambda e: ok())
            d.bind("<Escape>", lambda e: d.destroy())
            self._center(d)
            d.grab_set()

        def on_action(p_, action):
            if action == "crop":
                crop_dialog(p_)
            elif action == "turn":
                try:
                    p_.d["img"] = rotate_image(self.fitz, self.images_dir, p_.d["img"], quarter=3)
                    p_.d.pop("crop", None)
                    p_.render()
                    rt._changed()
                except Exception as ex:
                    messagebox.showerror(APP_NAME, f"Could not turn the picture:\n{ex}", parent=w)
            elif action == "caption":
                c = self._ask_string("Caption", "Text under the picture (empty = none):", p_.d.get("cap", ""))
                if c is not None:
                    p_.set("cap", c.strip() or None)
            elif action == "replace":
                path = filedialog.askopenfilename(parent=w, title="Choose a picture",
                                                  filetypes=[("Pictures", "*.png *.jpg *.jpeg *.bmp *.gif *.tif "
                                                                          "*.tiff"), ("All files", "*.*")])
                if path:
                    try:
                        p_.d["img"] = import_image(self.fitz, path, self.images_dir, max_side=1600)[0]
                        p_.d.pop("crop", None)
                        p_.render()
                        rt._changed()
                    except Exception as ex:
                        messagebox.showerror(APP_NAME, f"Could not read that picture:\n{ex}", parent=w)
            sync_pic()
        rt.on_action = on_action

        def on_embed(wdg):
            state["embed"] = wdg
            if isinstance(wdg, RichTable):
                show_tab("table")
                sync_table()
            elif isinstance(wdg, PicEmbed):
                show_tab("pic")
                sync_pic()
            elif state["tab"] in ("table", "pic"):
                show_tab("home")
            else:
                paint_tabs()
