        ttk.Entry(pf, textvariable=pw, width=16, show="•").pack(side="left")
        tk.Label(body, text="Tell the password by phone or message - not in the same email. Lost, it can't be "
                            "found again.", wraplength=420, justify="left", font=self.F(8), bg=T["panel"],
                 fg=T["muted"]).pack(anchor="w", pady=(3, 0))
        res = [False]

        def ok():
            res[0] = True
            d.destroy()
        bf = ttk.Frame(d, style="Panel.TFrame", padding=(20, 14))
        bf.pack(fill="x")
        PillButton(bf, self, "Make the copy", ok, kind="accent").pack(side="right")
        PillButton(bf, self, "Cancel", d.destroy, kind="ghost").pack(side="right", padx=6)
        self._center(d)
        d.grab_set()
        self.root.wait_window(d)
        if not res[0]:
            return
        if what.get() == "file":
            base = os.path.splitext(os.path.basename(self.book.files[fi]["rel"]))[0]
        else:
            base = clean_name(self.lib.label(self.folder))
        dst = filedialog.asksaveasfilename(title="Save the read-only copy as", defaultextension=".pdf",
                                           initialfile=f"{base} (read-only).pdf", filetypes=[("PDF", "*.pdf")])
        if not dst:
            return
        out = self._book_pdf([fi] if what.get() == "file" else None)
        if wm.get().strip():
            for pg in out:
                sp = {"kind": "watermark", "text": wm.get().strip(), "color": "#7A7A85", "opacity": 0.16,
                      "size": 60, "angle": -35, "layout": "centre", "w": pg.rect.width, "h": pg.rect.height}
                png, W, H = render_card(self.fitz, sp)
                pg.insert_image(pg.rect, stream=png, overlay=True)
        try:
            out.bake()
        except Exception:
            pass
        perm = self.fitz.PDF_PERM_ACCESSIBILITY
        if allow_print.get():
            perm |= self.fitz.PDF_PERM_PRINT | self.fitz.PDF_PERM_PRINT_HQ
        if allow_copy.get():
            perm |= self.fitz.PDF_PERM_COPY
        import secrets
        out.save(dst, garbage=3, deflate=True, encryption=self.fitz.PDF_ENCRYPT_AES_256,
                 owner_pw=secrets.token_hex(16), user_pw=pw.get().strip(), permissions=perm)
        out.close()
        self.set_status(f"Read-only copy saved{' with a password' if pw.get().strip() else ''}: {dst}")
        if messagebox.askyesno(APP_NAME, "Read-only copy ready.\n\nShow it in its folder?"):
            self._reveal(dst)

    def _reveal(self, path):
        try:
            if os.name == "nt":
                subprocess.Popen(["explorer", "/select,", os.path.normpath(path)])
            else:
                open_in_os(os.path.dirname(path))
        except Exception:
            open_in_os(os.path.dirname(path))

    # ---- printing (1.9.8): BindLens's own print window ----------------------------------------------------------
    PRINT_DEFAULTS = {"what": "doc", "subset": "all", "copies": 1, "collate": True, "scale": "fit", "pct": 100,
                      "orient": "auto", "gray": False, "duplex": 1, "marks": True, "printer": ""}

    def print_dialog(self, source=None, what=None):
        """Print with BindLens itself: the printer, which pages, copies, the size on the paper (fit, 100% or any %),
        orientation, colour or black & white, both sides, with or without your marks - and a picture of the sheet.
        On Windows it goes straight to the printer (no PDF program, no browser)."""
        T, A = self.T, self.accent
        src = source or {"kind": "book"}
        if src["kind"] == "book" and (not self.book or not self.book.total):
            messagebox.showinfo(APP_NAME, "Open a book first - then print a page, some pages, a document or the "
                                          "whole book.")
            return
        conf = dict(self.PRINT_DEFAULTS, **(self.lib.settings.get("print") or {}))
        if what:
            conf["what"] = what
        if src["kind"] == "book" and not self._marks_on_disk():
            return
        # ---- the pages that can be printed: (path, page, width pt, height pt)
        docs = {}
        if src["kind"] == "book":
            b = self.book
            fi, pi, g = self._here()
            f = b.files[fi]
            row = lambda p_: (b.files[p_[0]]["path"], p_[1], p_[2], p_[3])
            cur_doc = [row(p_) for p_ in b.pages[f["first"]:f["first"] + f["count"]]]
            whole = [row(p_) for p_ in b.pages if not b.files[p_[0]]["error"]]
            title = os.path.splitext(os.path.basename(f["rel"]))[0]
            whats = [("page", f"This page  ({pi + 1} of {f['count']})"), ("pages", "Pages of this document"),
                     ("doc", f"This document  ·  {self._short(f['rel'], 34)}  ·  {f['count']} "
                             f"page{'s' if f['count'] != 1 else ''}")]
            if len(b.files) > 1:
                whats.append(("book", f"The whole book  ·  {len(whole)} pages"))
            for k_, ff in enumerate(b.files):
                docs[ff["path"]] = k_
            cur_page = pi
        else:
            d0 = open_light(self.fitz, src["path"])
            cur_doc = [(src["path"], k_, d0.load_page(k_).rect.width, d0.load_page(k_).rect.height)
                       for k_ in range(d0.page_count)]
            d0.close()
            whole, cur_page, title = cur_doc, 0, src.get("title") or "Report"
            whats = [("doc", f"All of it  ·  {len(cur_doc)} page{'s' if len(cur_doc) != 1 else ''}"),
                     ("pages", "Pages")]
        if conf["what"] not in {w_[0] for w_ in whats}:
            conf["what"] = "doc"
        # ---- the printers
        win = os.name == "nt"
        try:
            printers, default = win_printers() if win else lp_printers()
        except Exception as ex:
            printers, default = [], ""
            _log(f"printers: {ex}")
        if win and not printers:
            messagebox.showinfo(APP_NAME, "Windows has no printer set up. Add one in Settings > Bluetooth & devices "
                                          "> Printers & scanners - or use 'Microsoft Print to PDF'.")
            return
        names = [p_[0] for p_ in printers]
        if conf["printer"] not in names:
            conf["printer"] = default if default in names else (names[0] if names else "")
        pstate = {}

        def pinfo(name):
            """Settings, what it can do and its paper - asked once per printer."""
            if name in pstate:
                return pstate[name]
            st_ = {"dm": None, "caps": {"duplex": False, "color": True, "copies": 1, "collate": False}, "paper": None}
            if win and name:
                port = dict(printers).get(name, "")
                try:
                    st_["dm"] = win_devmode(name)
                    st_["caps"] = win_caps(name, port)
                    st_["paper"] = win_paper(name, st_["dm"])
                except Exception as ex:
                    _log(f"printer {name}: {ex}")
            elif not win:
                st_["caps"] = {"duplex": True, "color": True, "copies": 999, "collate": True}
            pstate[name] = st_
            return st_
        # ---- the window
        d = self._dialog("Print")
        BG = T["panel"]
        V = {k_: tk.StringVar(value=str(conf[k_])) for k_ in ("what", "subset", "scale", "orient", "printer")}
        V["pages"] = tk.StringVar(value=conf.get("pages_txt") or (f"{cur_page + 1}" if src["kind"] == "book" else
                                                                 f"1-{len(cur_doc)}"))
        V["copies"] = tk.StringVar(value=str(conf["copies"]))
        V["pct"] = tk.StringVar(value=str(conf["pct"]))
        B = {"collate": tk.BooleanVar(value=conf["collate"]), "marks": tk.BooleanVar(value=conf["marks"]),
             "gray": tk.BooleanVar(value=conf["gray"])}
        dup = {"v": int(conf["duplex"] or 1)}
        outer = tk.Frame(d, bg=BG)
        outer.pack(padx=22, pady=(16, 6))
        left = tk.Frame(outer, bg=BG)
        left.grid(row=0, column=0, sticky="n")
        right = tk.Frame(outer, bg=BG)
        right.grid(row=0, column=1, sticky="n", padx=(26, 0))
        top_ = tk.Frame(left, bg=BG)
        top_.pack(fill="x")
        draw_icon_lbl = tk.Canvas(top_, width=28, height=28, bg=BG, highlightthickness=0)
        draw_icon_lbl.pack(side="left")
        draw_icon(draw_icon_lbl, "printer", 14, 14, A, s=1.0)
        tk.Label(top_, text="Print", font=self.F(16, "bold"), bg=BG, fg=T["text"]).pack(side="left", padx=(6, 0))
        tk.Label(top_, text=self._short(title, 40), font=self.F(9), bg=BG, fg=T["muted"]).pack(side="left",
                                                                                              padx=(10, 0), pady=(5, 0))

        def section(text, parent=left):
            tk.Label(parent, text=text.upper(), font=self.F(8, "bold"), bg=BG, fg=T["muted"]).pack(anchor="w",
                                                                                                 pady=(12, 4))
        chip_sets = {}

        def chips(parent, key, options, on_change=None):
            fr_ = tk.Frame(parent, bg=BG)
            fr_.pack(anchor="w")
            labs = {}

            def paint():
                dis = chip_sets[key]["off"]
                for val, lb in labs.items():
                    on = V[key].get() == val
                    lb.configure(bg=A if on else (T["chip"] if val not in dis else BG),
                                 fg="#FFFFFF" if on else (T["text"] if val not in dis else T["muted"]),
                                 cursor="hand2" if val not in dis else "")

            def pick(val):
                if val in chip_sets[key]["off"]:
                    return
                V[key].set(val)
                paint()
                if on_change:
                    on_change()
                refresh()
            for val, text in options:
                lb = tk.Label(fr_, text=text, font=self.F(9), padx=10, pady=4, bd=0)
                lb.pack(side="left", padx=(0, 5))
                lb.bind("<Button-1>", lambda e, v_=val: pick(v_))
                labs[val] = lb
            chip_sets[key] = {"paint": paint, "off": set(), "frame": fr_}
            paint()
            return fr_
        # printer
        section("Printer")
        prow = tk.Frame(left, bg=BG)
        prow.pack(fill="x")
        cb = ttk.Combobox(prow, values=names or ["(the computer's default printer)"], textvariable=V["printer"],
                          state="readonly", width=36, font=self.F(10))
        cb.pack(side="left")
        if not names:
            V["printer"].set("(the computer's default printer)")
        if win:
            pl = tk.Label(prow, text="Printer settings…", font=self.F(9, "bold"), bg=BG, fg=A, cursor="hand2")
            pl.pack(side="left", padx=(10, 0))
        # pages
        section("Pages")
        pg_box = tk.Frame(left, bg=BG)
        pg_box.pack(fill="x")
        pe = None
        for val, text in whats:
            r_ = tk.Frame(pg_box, bg=BG)
            r_.pack(fill="x", pady=1)
            ttk.Radiobutton(r_, text=text, value=val, variable=V["what"], command=lambda: refresh()).pack(side="left")
            if val == "pages":
                pe = tk.Entry(r_, textvariable=V["pages"], width=16, font=self.F(10), relief="flat", bg=T["pill"],
                              fg=T["text"], insertbackground=T["text"], highlightthickness=1,
                              highlightbackground=T["border"], highlightcolor=A)
                pe.pack(side="left", padx=(8, 0), ipady=2)
                tk.Label(r_, text="e.g. 1-3, 7", font=self.F(8), bg=BG, fg=T["muted"]).pack(side="left", padx=(6, 0))
                pe.bind("<FocusIn>", lambda e: (V["what"].set("pages"), refresh()))
                pe.bind("<KeyRelease>", lambda e: refresh())
        chips(left, "subset", [("all", "All of them"), ("odd", "Odd pages"), ("even", "Even pages")])
        # copies
        section("Copies")
        crow = tk.Frame(left, bg=BG)
        crow.pack(fill="x")
        sp = tk.Spinbox(crow, from_=1, to=999, width=4, textvariable=V["copies"], font=self.F(11), relief="flat",
                        bg=T["pill"], fg=T["text"], buttonbackground=T["chip"], command=lambda: refresh(),
                        highlightthickness=1, highlightbackground=T["border"])
        sp.pack(side="left", ipady=2)
        sp.bind("<KeyRelease>", lambda e: refresh())
        ttk.Checkbutton(crow, text="In order (1 2 3, 1 2 3…)", variable=B["collate"],
                        command=lambda: refresh()).pack(side="left", padx=(14, 0))
        # size on the paper
        section("Size on the paper")
        srow = tk.Frame(left, bg=BG)
        srow.pack(fill="x")
        chips(srow, "scale", [("fit", "Fit to the paper"), ("actual", "Actual size (100%)"), ("pct", "Custom")])
        sp2 = tk.Spinbox(srow, from_=10, to=400, increment=5, width=4, textvariable=V["pct"], font=self.F(10),
                         relief="flat", bg=T["pill"], fg=T["text"], buttonbackground=T["chip"],
                         command=lambda: (V["scale"].set("pct"), chip_sets["scale"]["paint"](), refresh()),
                         highlightthickness=1, highlightbackground=T["border"])
        sp2.pack(side="left", padx=(2, 0), in_=chip_sets["scale"]["frame"], ipady=1)
        tk.Label(chip_sets["scale"]["frame"], text="%", font=self.F(9), bg=BG, fg=T["muted"]).pack(side="left",
                                                                                               padx=(3, 0))
        sp2.bind("<KeyRelease>", lambda e: (V["scale"].set("pct"), chip_sets["scale"]["paint"](), refresh()))
        # orientation, colour, sides
        section("Orientation")
        chips(left, "orient", [("auto", "Automatic"), ("portrait", "Portrait"), ("landscape", "Landscape")])
        section("Colour")
        V["colour"] = tk.StringVar(value="gray" if conf["gray"] else "colour")
        chips(left, "colour", [("colour", "Colour"), ("gray", "Black & white")])
        section("Sides")
        V["sides"] = tk.StringVar(value=str(dup["v"]))
        chips(left, "sides", [("1", "One side"), ("2", "Both sides (long edge)"), ("3", "Both sides (short edge)")])
        mrow = tk.Frame(left, bg=BG)
        mrow.pack(fill="x", pady=(12, 0))
        ttk.Checkbutton(mrow, text="Print my marks (highlights, notes, stamps…)", variable=B["marks"],
                        command=lambda: (thumbs.clear(), refresh())).pack(side="left")
        # ---- the preview of the sheet
        PW, PH = 270, 350
        pc = tk.Canvas(right, width=PW, height=PH, bg=BG, highlightthickness=0)
        pc.pack(pady=(30, 4))
        nav = tk.Frame(right, bg=BG)
        nav.pack()
        prev_i = {"i": 0}
        nl = tk.Label(nav, text="‹", font=self.F(14, "bold"), bg=BG, fg=A, cursor="hand2")
        nl.pack(side="left", padx=8)
        nt = tk.Label(nav, text="", font=self.F(9), bg=BG, fg=T["muted"], width=14)
        nt.pack(side="left")
        nr = tk.Label(nav, text="›", font=self.F(14, "bold"), bg=BG, fg=A, cursor="hand2")
        nr.pack(side="left", padx=8)
        summary = tk.Label(right, text="", font=self.F(10, "bold"), bg=BG, fg=T["text"], wraplength=270,
                           justify="center")
        summary.pack(pady=(10, 0))
        note = tk.Label(right, text="", font=self.F(8), bg=BG, fg=T["muted"], wraplength=270, justify="center")
        note.pack(pady=(2, 0))
        thumbs = {}
        imgs = {}

        def selection():
            w_ = V["what"].get()
            if w_ == "page":
                sel = [cur_doc[cur_page]] if src["kind"] == "book" else cur_doc[:1]
            elif w_ == "pages":
                sel = [cur_doc[k_] for k_ in parse_pages(V["pages"].get(), len(cur_doc))]
            elif w_ == "book":
                sel = list(whole)
            else:
                sel = list(cur_doc)
            sub = V["subset"].get()
            if sub == "odd":
                sel = sel[0::2]
            elif sub == "even":
                sel = sel[1::2]
            return sel

        def ints(var, lo, hi, dflt):
            try:
                return max(lo, min(hi, int(float(var.get()))))
            except Exception:
                return dflt

        def job_landscape(sel):
            o = V["orient"].get()
            if o == "auto":
                land = sum(1 for it in sel if it[2] > it[3] * 1.02)
                return land > len(sel) / 2
            return o == "landscape"

        def paper_for(name, land):
            p_ = (pinfo(name)["paper"] if name in names else None) or default_paper()
            p_ = dict(p_)
            if (p_["pw"] > p_["ph"]) != land:                 # the printer's paper the other way round
                p_ = {"pw": p_["ph"], "ph": p_["pw"], "aw": p_["ah"], "ah": p_["aw"], "ox": p_["oy"], "oy": p_["ox"],
                      "dpx": p_["dpy"], "dpy": p_["dpx"]}
            return p_

        def thumb(it, tw, th, rot):
            key = (it[0], it[1], int(tw), int(th), rot, V["colour"].get(), B["marks"].get())
            if key in thumbs:
                return thumbs[key]
            try:
                if src["kind"] == "book" and it[0] in docs:
                    page = self.book.doc(docs[it[0]]).load_page(it[1])
                else:
                    dd = imgs.get("_doc")
                    if dd is None:
                        dd = imgs["_doc"] = open_light(self.fitz, it[0])
                    page = dd.load_page(it[1])
                r = page.rect
                pw_, ph_ = (r.height, r.width) if rot else (r.width, r.height)
                z = min(tw / max(1.0, pw_), th / max(1.0, ph_))
                m = self.fitz.Matrix(z, z)
                if rot:
                    m = m.prerotate(-90)
                pix = page.get_pixmap(matrix=m, alpha=False, annots=B["marks"].get(),
                                      colorspace=self.fitz.csGRAY if V["colour"].get() == "gray" else self.fitz.csRGB)
                im = tk.PhotoImage(data=pix.tobytes("ppm"))
            except Exception:
                im = None
            if len(thumbs) > 40:
                thumbs.clear()
            thumbs[key] = im
            return im

        def refresh(*_a):
            name = V["printer"].get()
            info = pinfo(name) if name in names else pinfo("")
            caps = info["caps"]
            chip_sets["sides"]["off"] = set() if caps.get("duplex") else {"2", "3"}
            if not caps.get("duplex") and V["sides"].get() != "1":
                V["sides"].set("1")
            chip_sets["colour"]["off"] = set() if caps.get("color", True) else {"colour"}
            if not caps.get("color", True):
                V["colour"].set("gray")
            for k_ in chip_sets:
                chip_sets[k_]["paint"]()
            sel = selection()
            n = len(sel)
            copies = ints(V["copies"], 1, 999, 1)
            sides = int(V["sides"].get() or 1)
            sheets = (-(-n // (2 if sides > 1 else 1))) * copies
            summary.configure(text=(f"{n} page{'s' if n != 1 else ''}" + (f"  ×  {copies} copies" if copies > 1 else "")
                                    + f"   →   {sheets} sheet{'s' if sheets != 1 else ''} of paper") if n else
                              "No pages - check the page numbers", fg=T["text"] if n else "#C5221F")
            note.configure(text=("Straight to the printer - no other program needed." if win else
                                 "Sent to the printer with the computer's printing system.")
                           if name in names or not names else "")
            # the picture of the sheet
            pc.delete("all")
            if not n:
                nt.configure(text="")
                return
            i = prev_i["i"] = max(0, min(prev_i["i"], n - 1))
            nt.configure(text=f"page {i + 1} of {n}")
            land = job_landscape(sel)
            paper = paper_for(name, land)
            it = sel[i]
            rot = V["orient"].get() == "auto" and ((it[2] > it[3] * 1.02) != land)
            scale = V["scale"].get()
            pct = ints(V["pct"], 10, 400, 100)
            x, y, w, h = print_place(it[2], it[3], paper, scale, pct, rot)
            k = min((PW - 24) / paper["pw"], (PH - 24) / paper["ph"])
            sw, sh = paper["pw"] * k, paper["ph"] * k
            X0, Y0 = (PW - sw) / 2, (PH - sh) / 2
            round_rect(pc, X0 + 3, Y0 + 4, X0 + sw + 3, Y0 + sh + 4, 3, fill=mix(BG, "#000000", 0.12), outline="")
            pc.create_rectangle(X0, Y0, X0 + sw, Y0 + sh, fill="#FFFFFF", outline=mix(BG, T["border"], 0.8))
            px0, py0 = X0 + (paper["ox"] + x) * k, Y0 + (paper["oy"] + y) * k
            im = thumb(it, max(1, w * k), max(1, h * k), rot)
            if im is not None:
                imgs["cur"] = im
                pc.create_image(px0, py0, image=im, anchor="nw")
            else:
                pc.create_rectangle(px0, py0, px0 + w * k, py0 + h * k, outline=T["border"])
            # whatever falls outside the sheet is not printed: cover it
            for rr in ((0, 0, PW, Y0), (0, Y0 + sh, PW, PH), (0, 0, X0, PH), (X0 + sw, 0, PW, PH)):
                pc.create_rectangle(*rr, fill=BG, outline="")
            pc.create_rectangle(X0, Y0, X0 + sw, Y0 + sh, outline=mix(BG, T["border"], 0.8))
            pc.create_rectangle(X0 + paper["ox"] * k, Y0 + paper["oy"] * k, X0 + (paper["ox"] + paper["aw"]) * k,
                                Y0 + (paper["oy"] + paper["ah"]) * k, outline=mix("#FFFFFF", T["border"], 0.35))

        def step(dv):
            prev_i["i"] += dv
            refresh()
        nl.bind("<Button-1>", lambda e: step(-1))
        nr.bind("<Button-1>", lambda e: step(1))
        cb.bind("<<ComboboxSelected>>", lambda e: (thumbs.clear(), refresh()))
        if win:
            def printer_settings(_e=None):
                name = V["printer"].get()
                if name not in names:
                    return
                info = pinfo(name)
                try:
                    hwnd = int(d.wm_frame(), 16)
                except Exception:
                    hwnd = 0
                new = win_devmode(name, base=info["dm"], prompt_hwnd=hwnd)
                if new is not None:
                    info["dm"] = new
                    try:
                        info["paper"] = win_paper(name, new)
                        o_ = dm_get(new, "orient")
                        if o_ in (1, 2):
                            V["orient"].set("portrait" if o_ == 1 else "landscape")
                    except Exception:
                        pass
                    refresh()
            pl.bind("<Button-1>", printer_settings)
        res = {"go": False}
        bf = tk.Frame(d, bg=BG)
        bf.pack(fill="x", padx=22, pady=(10, 16))
        PillButton(bf, self, "Print", lambda: (res.__setitem__("go", True), d.destroy()), kind="accent",
                   width=120).pack(side="right")
        PillButton(bf, self, "Cancel", d.destroy, kind="ghost").pack(side="right", padx=8)
        d.bind("<Escape>", lambda e: d.destroy())
        d.bind("<Return>", lambda e: (res.__setitem__("go", True), d.destroy()) if self.root.focus_get() is not pe
               else None)
        refresh()
        self._center(d)
        d.grab_set()
        self._print_win = d
        self.root.wait_window(d)
        try:
            if imgs.get("_doc") is not None:
                imgs["_doc"].close()
        except Exception:
            pass
        if not res["go"]:
            return
        sel = selection()
        if not sel:
            return
        conf.update(what=V["what"].get(), subset=V["subset"].get(), copies=ints(V["copies"], 1, 999, 1),
                    collate=B["collate"].get(), scale=V["scale"].get(), pct=ints(V["pct"], 10, 400, 100),
                    orient=V["orient"].get(), gray=V["colour"].get() == "gray", duplex=int(V["sides"].get() or 1),
                    marks=B["marks"].get(), printer=V["printer"].get() if V["printer"].get() in names else "")
        if conf["what"] == "pages":
            conf["pages_txt"] = V["pages"].get()
        # 3.0: only the lasting choices are kept (printer, size, colour, sides…) - not the copies, the pages or
        # odd/even of this job (20 sign-in sheets made the next invoice print 20 times)
        self.lib.settings["print"] = {k_: v for k_, v in conf.items()
                                      if k_ not in ("copies", "subset", "pages_txt") and
                                      (k_ != "what" or (src["kind"] == "book" and v != "pages"))}
        self.lib.save_meta()
        name = conf["printer"]
        if src["kind"] == "book":
            self._flush_dirty()
        if win:
            info = pinfo(name)
            self._print_run_win(sel, conf, name, info["dm"], info["caps"], title, job_landscape(sel))
        else:
            self._print_run_lp(sel, conf, name, title, src)

    def _print_run_win(self, sel, conf, name, dm, caps, title, land):
        """Print in the background, page by page (a helper draws each page; Windows sends it to the printer)."""
        copies, collate = conf["copies"], conf["collate"]
        by_printer = copies > 1 and caps.get("copies", 1) >= copies and (not collate or caps.get("collate"))
        dm2 = bytearray(dm) if dm else None
        dm_set(dm2, orient=2 if land else 1, copies=copies if by_printer else 1,
               color=1 if conf["gray"] else (2 if caps.get("color", True) else None),
               duplex=conf["duplex"] if caps.get("duplex") else None, collate=collate if by_printer else None)
        sheets = print_sheets(sel, copies, collate, conf["duplex"] > 1, by_printer)
        prog = {"done": 0, "total": len(sheets), "state": "run", "cancel": False, "err": None}
        self._print_prog = prog
        auto, gray, marks = conf["orient"] == "auto", conf["gray"], conf["marks"]
        local = {}

        def render(it, tw, th, rot):
            res = None
            if not self.pool.disabled:
                res = self.pool.call("printpage", prio=2, timeout=300, path=it[0], pi=it[1], tw=tw, th=th, rot=rot,
                                     gray=gray, marks=marks)
            if not res or res.get("fallback") or res.get("err") or "bgr" not in res:
                doc = local.get(it[0])
                if doc is None:
                    doc = local[it[0]] = open_light(self.fitz, it[0])
                res = print_bitmap(self.fitz, doc.load_page(it[1]), tw, th, rot, gray, marks)
            return res

        def work():
            job = None
            try:
                self.writer.wait(20)                       # your latest marks are on the disk first
                job = WinPrintJob(name, dm2, title)
                paper = job.paper
                for k, it in enumerate(sheets):
                    if prog["cancel"]:
                        job.end(abort=True)
                        job = None
                        prog["state"] = "cancelled"
                        return
                    if it is None:
                        job.sheet(None)
                    else:
                        rot = auto and ((it[2] > it[3] * 1.02) != land)
                        x, y, w, h = print_place(it[2], it[3], paper, conf["scale"], conf["pct"], rot)
                        f = min(1.0, PRINT_DPI / max(1, paper["dpx"]))
                        tw, th = max(1, int(w * f)), max(1, int(h * f))
                        if tw * th > 40e6:
                            s_ = (40e6 / (tw * th)) ** 0.5
                            tw, th = max(1, int(tw * s_)), max(1, int(th * s_))
                        job.sheet(render(it, tw, th, rot), x, y, w, h)
                    prog["done"] = k + 1
                job.end()
                job = None
                prog["state"] = "done"
            except InterruptedError:
                prog["state"] = "cancelled"
            except Exception as ex:
                prog["state"], prog["err"] = "error", str(ex) or ex.__class__.__name__
                _log(f"print: {ex}")
            finally:
                if job is not None:
                    try:
                        job.end(abort=True)
                    except Exception:
                        pass
                for dd in local.values():
                    try:
                        dd.close()
                    except Exception:
                        pass
        threading.Thread(target=work, daemon=True).start()
        self._print_poll()

    def _print_run_lp(self, sel, conf, name, title, src):
        """Mac / Linux: the chosen pages as one PDF, given to the computer's printing system (lp) with the options."""
        import tempfile
        out = self.fitz.open()
        opened = {}
        try:
            for path, pi, _w, _h in sel:
                if src["kind"] == "book" and path in {f["path"] for f in self.book.files}:
                    fi = next(k for k, f in enumerate(self.book.files) if f["path"] == path)
                    d_ = self.book.doc(fi)
                else:
                    d_ = opened.get(path) or opened.setdefault(path, open_light(self.fitz, path))
                if d_.is_pdf:
                    out.insert_pdf(d_, from_page=pi, to_page=pi, annots=conf["marks"])
                else:
                    tmp_ = self.fitz.open("pdf", d_.convert_to_pdf(pi, pi))
                    out.insert_pdf(tmp_)
                    tmp_.close()
            tmp = os.path.join(tempfile.gettempdir(), f"BindLens print {int(time.time())}.pdf")
            out.save(tmp)
        finally:
            out.close()
            for d_ in opened.values():
                d_.close()
        cmd = ["lp", "-t", title or "BindLens", "-n", str(conf["copies"])]
        if name:
            cmd += ["-d", name]
        cmd += ["-o", "fit-to-page"] if conf["scale"] == "fit" else ["-o", f"scaling={conf['pct'] if conf['scale'] == 'pct' else 100}"]
        if conf["orient"] == "landscape":
            cmd += ["-o", "orientation-requested=4"]
        if conf["duplex"] > 1:
            cmd += ["-o", "sides=two-sided-long-edge" if conf["duplex"] == 2 else "sides=two-sided-short-edge"]
        if conf["gray"]:
            cmd += ["-o", "print-color-mode=monochrome"]
        if conf["copies"] > 1:
            cmd += ["-o", f"collate={'true' if conf['collate'] else 'false'}"]
        try:
            subprocess.Popen(cmd + [tmp])
            self._toast("✓  Sent to the printer")
        except Exception as ex:
            messagebox.showinfo(APP_NAME, f"Could not print ({ex}).\n\nThe file opens now - print it from there.")
            open_in_os(tmp)

    def _print_poll(self):
        """The small bar at the bottom while printing: how far it is - click it to stop."""
        prog = getattr(self, "_print_prog", None)
        if prog is None:
            return
        w = getattr(self, "_print_bar", None)
        if prog["state"] == "run":
            if w is None or not w.winfo_exists():
                w = tk.Label(self.root, text="", bg=self.accent, fg="#FFFFFF", font=self.F(10, "bold"), padx=14,
                             pady=7, cursor="hand2")
                w.bind("<Button-1>", lambda e: prog.__setitem__("cancel", True))
                self._print_bar = w
            w.configure(text=f"Printing  {prog['done']} of {prog['total']}   ·   click to stop")
            w.place(relx=0.5, rely=1.0, y=-60, anchor="s")
            w.lift()
            self.root.after(250, self._print_poll)
            return
        if w is not None:
            try:
                w.destroy()
            except Exception:
                pass
            self._print_bar = None
        self._print_prog = None
        if prog["state"] == "done":
            self._toast(f"✓  Sent to the printer  ·  {prog['total']} sheet{'s' if prog['total'] != 1 else ''}")
            self.set_status("Printed.")
        elif prog["state"] == "cancelled":
            self.set_status("Printing stopped.")
        else:
            messagebox.showerror(APP_NAME, f"Could not print:\n{prog['err']}\n\nCheck that the printer is on and "
                                           f"connected - or choose another printer.")

    def _print_file(self, path):
        try:
            if os.name == "nt":
                os.startfile(path, "print")
            elif sys.platform == "darwin":
                subprocess.Popen(["lp", path])
            else:
                subprocess.Popen(["lp", path])
            self.set_status("Sent to the printer (your PDF app may open to print it).")
        except Exception as ex:
            messagebox.showinfo(APP_NAME, f"Could not print directly ({ex}).\n\nThe file opens now - print it from "
                                          f"there.")
            open_in_os(path)

    def _marks_on_disk(self):
        """3.0: printing / sending a file uses the file on the disk - first make sure your latest marks are in it
        (if a file is open in another program they can't be: say so, and let you choose)."""
        self.writer.retry()
        self.writer.wait(10)
        left = [os.path.basename(p) for p in list(self.writer.latest)]
        if not left:
            return True
        return messagebox.askyesno(APP_NAME, "Your latest marks are not saved yet in:\n\n" + "\n".join(left[:5]) +
                                   "\n\n(Is it open in another program? Close it there.)\n\nContinue anyway "
                                   "(without the latest marks)?")

    def _safe_to_send(self, path):
        """3.2: a PDF with white boxes is sent as a copy where the text under them is erased for good (your
        file keeps its boxes, removable as before). Any other file is sent as it is."""
        if not str(path).lower().endswith(".pdf"):
            return path
        try:
            src = self.fitz.open(path)
            try:
                if not any(_is_cover(a) for pg in src for a in pg.annots()):
                    return path
                out = self.fitz.open()
                out.insert_pdf(src)
                n = erase_under_covers(self.fitz, out)
                folder = os.path.join(self.lib.meta_dir, "to send")
                os.makedirs(folder, exist_ok=True)
                dst = os.path.join(folder, os.path.basename(path))
                out.save(dst, garbage=3, deflate=True)
                out.close()
            finally:
                src.close()
            self._toast(f"The copy in the email has the text under {n} white box(es) erased for good.", ms=6000)
            return dst
        except Exception as ex:
            _log(f"safe to send: {ex}")
            return path

    def email_file(self, path=None):
        """Open a new email with the file attached (Outlook), or the mail app + the file's folder."""
        if path is None:
            if not self.book or not self.book.total:
                return
            fi, pi, g = self._here()
            path = self.book.files[fi]["path"]
        if not self._marks_on_disk():
            return
        path = self._safe_to_send(path)
        name = os.path.basename(path)
        if os.name == "nt":
            q = path.replace("'", "''")
            ps = ("$o=New-Object -ComObject Outlook.Application; $m=$o.CreateItem(0); "
                  f"$m.Subject='{name.replace(chr(39), chr(39) * 2)}'; $m.Attachments.Add('{q}') | Out-Null; $m.Display()")
            try:
                subprocess.check_call(["powershell", "-NoProfile", "-Command", ps], creationflags=0x08000000,
                                      timeout=25)
                self.set_status("Email ready in Outlook.")
                return
            except Exception:
                pass
        import urllib.parse
        open_in_os("mailto:?subject=" + urllib.parse.quote(name))
        self._reveal(path)
        self.set_status("Your mail app is open - drag the file from the folder window into the email.")

    def _card_dialog(self, spec, title="Sticky note", save_option=False):
        """Sticky notes and stamps: text, colours, looks (combine them), picture, font, size, tilt - live preview."""
        T = self.T
        spec = dict(spec)
        kind = spec.get("kind", "note")
        if kind == "note" and spec.get("style"):          # a 1.5 note: one look -> holder + paper
            old = spec.pop("style")
            spec.setdefault("attach", {"pinned": "pin", "taped": "tape"}.get(old, "none"))
            spec.setdefault("paper", ["fold"] if old == "folded" else [])
        spec.setdefault("paper", [])
        d = self._dialog(title)
        body = tk.Frame(d, bg=T["panel"])
        body.pack(fill="both", expand=True, padx=18, pady=(14, 0))
        left = tk.Frame(body, bg=T["panel"])
        left.pack(side="left", fill="both", expand=True)
        right = tk.Frame(body, bg=T["panel"])
        right.pack(side="left", fill="y", padx=(16, 0))
        pv = tk.Canvas(right, width=270, height=260, bg=mix(T["panel"], "#FFFFFF", 0.5), highlightthickness=0)
        pv.pack()
        tk.Label(right, text="Preview", font=self.F(8), bg=T["panel"], fg=T["muted"]).pack(pady=(4, 0))

        def label(parent, t):
            tk.Label(parent, text=t.upper(), font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(
                anchor="w", pady=(9, 3))

        def chip_row(parent, items, key, per_row=5, multi=False):
            fr = tk.Frame(parent, bg=T["panel"])
            fr.pack(anchor="w")
            cvs = {}

            def is_on(val):
                return val in (spec.get(key) or []) if multi else spec.get(key) == val

            def paint():
                for val, (cv, lab) in cvs.items():
                    on = is_on(val)
                    f = tkfont.Font(font=self.F(9))
                    w = f.measure(lab) + 22
                    cv.configure(width=w, bg=T["panel"])
                    cv.delete("all")
                    round_rect(cv, 1, 1, w - 1, 27, 13, fill=mix(T["panel"], self.accent, 0.18) if on else T["chip"],
                               outline=self.accent if on else T["chip"])
                    cv.create_text(w / 2, 14, text=lab, font=self.F(9), fill=T["text"])

            def pick(val):
                if multi:
                    cur = list(spec.get(key) or [])
                    if val in cur:
                        cur.remove(val)
                    else:
                        cur.append(val)
                    spec[key] = cur
                else:
                    spec[key] = val
                if key == "style" and kind == "stamp":
                    if val == "circle":
                        spec["w"] = spec["h"] = 112
                    elif spec.get("w", 0) == spec.get("h", 0):
                        spec["w"], spec["h"] = 170, 66
                paint()
                later()
            for i, (val, lab) in enumerate(items):
                cv = tk.Canvas(fr, height=28, highlightthickness=0, bd=0, cursor="hand2")
                cv.grid(row=i // per_row, column=i % per_row, padx=(0, 5), pady=2, sticky="w")
                cv.bind("<Button-1>", lambda e, v=val: pick(v))
                cvs[val] = (cv, lab)
            paint()
            return fr

        def swatches(parent, colors, key, more=True):
            fr = tk.Frame(parent, bg=T["panel"])
            fr.pack(anchor="w")
            for c in colors:
                cv = tk.Canvas(fr, width=24, height=24, bg=T["panel"], highlightthickness=0, cursor="hand2")
                cv.pack(side="left", padx=1)
                round_rect(cv, 3, 3, 21, 21, 5, fill=c, outline=mix(c, "#000000", 0.2))
                cv.bind("<Button-1>", lambda e, c=c: (spec.__setitem__(key, c), later()))
            if more:
                lb = tk.Label(fr, text="More…", font=self.F(9), bg=T["panel"], fg=self.accent, cursor="hand2")
                lb.pack(side="left", padx=8)

                def custom(_e=None):
                    res = colorchooser.askcolor(color=spec.get(key) or "#222226", parent=d)
                    if res and res[1]:
                        spec[key] = res[1].upper()
                        later()
                lb.bind("<Button-1>", custom)
            return fr
        label(left, "Text")
        if kind == "note":
            tx = tk.Text(left, width=40, height=4, wrap="word", font=self.F(10), relief="flat", bg=T["chip"],
                         fg=T["text"], insertbackground=T["text"], padx=8, pady=6, highlightthickness=1,
                         highlightcolor=self.accent, highlightbackground=T["chip"])
            tx.pack(anchor="w", fill="x")
            tx.insert("1.0", spec.get("text", "") or (rich_plain(spec.get("doc")) if spec.get("doc") else ""))
            spec.pop("doc", None)
            get_text = lambda: tx.get("1.0", "end").strip()
            tx.bind("<KeyRelease>", lambda e: later())
            tx.focus_set()
            fmt = tk.Frame(left, bg=T["panel"])
            fmt.pack(anchor="w", pady=(4, 0))
            for key, lab in (("bold", "Bold"), ("italic", "Italic")):
                v = tk.BooleanVar(value=bool(spec.get(key)))
                ttk.Checkbutton(fmt, text=lab, variable=v,
                                command=lambda k=key, v=v: (spec.__setitem__(k, v.get()), later())).pack(side="left",
                                                                                                    padx=(0, 10))
            av_ = tk.IntVar(value=int(spec.get("align", 0)))
            for val, lab in ((0, "Left"), (1, "Centre"), (2, "Right")):
                ttk.Radiobutton(fmt, text=lab, value=val, variable=av_,
                                command=lambda: (spec.__setitem__("align", av_.get()), later())).pack(side="left")
        else:
            tv = tk.StringVar(value=spec.get("text", ""))
            en = ttk.Entry(left, textvariable=tv, width=30, font=self.F(11))
            en.pack(anchor="w")
            en.bind("<KeyRelease>", lambda e: later())
            get_text = lambda: tv.get().strip()
            en.focus_set()
            dv = tk.BooleanVar(value=bool(spec.get("date")))
            ttk.Checkbutton(left, text="Add today's date", variable=dv,
                            command=lambda: (spec.__setitem__("date", dv.get()), later())).pack(anchor="w", pady=(6, 0))
        if kind == "note":
            label(left, "Held by")
            chip_row(left, list(NOTE_ATTACH.items()), "attach")
            label(left, "Paper  (combine as many as you like)")
            chip_row(left, list(NOTE_PAPER.items()), "paper", multi=True)
            cr = tk.Frame(left, bg=T["panel"])
            cr.pack(anchor="w", fill="x")
            c_a = tk.Frame(cr, bg=T["panel"])
            c_a.pack(side="left", anchor="n")
            label(c_a, "Note colour")
            swatches(c_a, NOTE_COLORS, "color")
            c_b = tk.Frame(cr, bg=T["panel"])
            c_b.pack(side="left", anchor="n", padx=(14, 0))
            label(c_b, "Text colour")
            swatches(c_b, ["#222226", "#B3261E", "#1F4E9C", "#1E7A3E", "#6B3FA0", "#FFFFFF"], "tc")
            if spec.get("attach") in ("pin", "magnet"):
                pass
            label(left, "Picture in the note")
            pf = tk.Frame(left, bg=T["panel"])
            pf.pack(anchor="w")
            plab = tk.Label(pf, text="", font=self.F(9), bg=T["panel"], fg=T["muted"])

            def set_pic_label():
