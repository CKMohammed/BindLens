    # ============================================================== marks
    def collect_marks(self):
        """Read the annotations stored in the PDFs of this book - a few files at a time, in the
        background, so a big book opens at once."""
        self.marks, self.marks_by_g = [], {}
        self.added_by_g = {}
        self._marks_fi = set()
        if self._marks_job is not None:
            self.root.after_cancel(self._marks_job)
            self._marks_job = None
        if not self.book:
            return
        todo = [fi for fi, f in enumerate(self.book.files) if f["pdf"] and not f["error"]]
        cur = self.book.pages[self.current_page][0] if self.book.total and self.current_page < self.book.total else 0
        todo.sort(key=lambda fi: abs(fi - cur))
        book = self.book
        self._marks_pending = 0
        if not self.pool.disabled:
            # the helpers read the marks; only files changed here (not yet on disk) are read in this process
            local = [fi for fi in todo if fi in book.keep or self.writer.get(book.files[fi]["path"]) is not None
                     or book.files[fi]["doc"] is not None]
            for fi in local:
                self._collect_file_marks(fi)
            known = []                          # read before (this session) and not changed since
            for fi in todo:
                f = book.files[fi]
                c, sz = self._mcache.get(f["key"]), self.page_sizes.get(f["key"]) or {}
                if fi not in local and c and (c[0], c[1]) == (sz.get("m"), sz.get("s")):
                    known.append(fi)
                    self._apply_marks(book, fi, c[2], c[3])
            for k, fi in enumerate(fi for fi in todo if fi not in local and fi not in known):
                self._marks_pending += 1
                self.pool.submit("marks", prio=2 if k < 8 else 3, timeout=240, path=book.files[fi]["path"],
                                 cancel=lambda: self.book is not book,
                                 cb=lambda res, fi=fi: self._got_marks(book, fi, res))
            if not self._marks_pending:
                self._marks_done()
            return

        def step():
            self._marks_job = None
            if self.book is not book:
                return
            t0 = time.time()
            while todo and time.time() - t0 < 0.03:
                self._collect_file_marks(todo.pop(0))
            self.marks.sort(key=lambda m: (m["g"], m["bbox"][1]))
            if todo:
                self._marks_job = self.root.after(5, step)
            else:
                self._fill_marks_tree()
                self.draw_map()
                self.redraw()
        step()

    def _got_marks(self, book, fi, res):
        """A helper read the marks of one file of the open book."""
        if self.book is not book:
            return
        self._marks_pending -= 1
        f = book.files[fi]
        if fi in self._marks_fi:                          # already read here (you edited it meanwhile)
            self.marks = [m for m in self.marks if m["fi"] != fi]
            for g in range(f["first"], f["first"] + f["count"]):
                self.marks_by_g.pop(g, None)
            self._marks_fi.discard(fi)
        if res.get("cancelled"):
            pass
        elif res.get("fallback") or "marks" not in res:
            if not res.get("err"):
                self._collect_file_marks(fi)
        else:
            c = self.page_sizes.get(f["key"]) or {}
            if (res["m"], res["s"]) != (c.get("m"), c.get("s")) or f["doc"] is not None:
                self._collect_file_marks(fi)              # the file changed meanwhile: read it here
            else:
                self._mcache[f["key"]] = (res["m"], res["s"], res["marks"], bool(res.get("form")))
                self._apply_marks(book, fi, res["marks"], res.get("form"))
        if self._marks_pending <= 0:
            self._marks_done()
        elif not getattr(self, "_marks_refresh", None):
            self._marks_refresh = self.root.after(400, self._marks_partial)

    def _apply_marks(self, book, fi, marks, form):
        """Marks a helper read (kept as it sent them: they are copied here)."""
        f = book.files[fi]
        f["form"] = bool(form)
        for m0 in marks:
            pi = m0["pi"]
            if pi >= f["count"]:
                continue
            if m0.get("kind") == "_added":
                self.added_by_g[f["first"] + pi] = m0.get("info") or {}
                continue
            m = dict(m0)
            del m["pi"]
            m["g"], m["fi"] = f["first"] + pi, fi
            m["rects"] = [tuple(r) for r in m["rects"]]
            m["bbox"] = tuple(m["bbox"])
            self.marks.append(m)
            self.marks_by_g.setdefault(m["g"], []).append(m)
            self._marks_fi.add(fi)

    def _marks_partial(self):
        self._marks_refresh = None
        if self.book:
            self.marks.sort(key=lambda m: (m["g"], m["bbox"][1]))
            self.draw_map()

    def _marks_done(self):
        self._marks_pending = 0
        self.marks.sort(key=lambda m: (m["g"], m["bbox"][1]))
        self._fill_marks_tree()
        self.draw_map()
        self.redraw()

    def _mark_dict(self, g, fi, page, a, rm):
        m = mark_dict(self.fitz, page, a, rm)
        m["g"], m["fi"] = g, fi
        return m

    def _collect_page_marks(self, fi, pi):
        doc = self.book.doc(fi)
        g = self.book.files[fi]["first"] + pi
        try:
            if not doc.page_annot_xrefs(pi):
                return
        except Exception:
            pass
        page = doc.load_page(pi)
        rm = page.rotation_matrix
        for a in page.annots() or []:
            if a.type[1] in SKIP_ANNOTS:
                continue
            try:
                m = self._mark_dict(g, fi, page, a, rm)
            except Exception:
                continue
            self.marks.append(m)
            self.marks_by_g.setdefault(g, []).append(m)
            self._marks_fi.add(fi)

    def _collect_file_marks(self, fi):
        f = self.book.files[fi]
        try:
            doc = self.book.doc(fi)
            for a in added_pages(doc):
                if a["pi"] < f["count"]:
                    self.added_by_g[f["first"] + a["pi"]] = a["info"]
            if hasattr(doc, "has_annots") and not doc.has_annots():
                return
        except Exception:
            return
        for pi in range(f["count"]):
            self._collect_page_marks(fi, pi)

    def _refresh_page_marks(self, g):
        fi, pi = self.book.pages[g][0], self.book.pages[g][1]
        self.marks = [m for m in self.marks if m["g"] != g]
        self.marks_by_g.pop(g, None)
        self._collect_page_marks(fi, pi)
        self.marks.sort(key=lambda m: (m["g"], m["bbox"][1]))
        self._fill_marks_tree()
        self.draw_map()

    def _refresh_file_marks(self, fi):
        self.marks = [m for m in self.marks if m["fi"] != fi]
        for g in list(self.marks_by_g):
            self.marks_by_g[g] = [m for m in self.marks_by_g[g] if m["fi"] != fi]
        self._collect_file_marks(fi)
        self.marks.sort(key=lambda m: (m["g"], m["bbox"][1]))
        self._fill_marks_tree()
        self.draw_map()

    def _mark(self, g, xref):
        for m in self.marks_by_g.get(g, []):
            if m["xref"] == xref:
                return m
        return None

    def _fill_marks_tree(self):
        t = self.marks_tree
        t.delete(*t.get_children())
        for i, m in enumerate(self.marks):
            body = m["text"] if m["kind"] in MARKUP else (m["note"] or "")
            label = KIND_LABEL.get(m["kind"], m["kind"])
            txt = f"  {body}" if body else f"  {label}"
            if m["kind"] in MARKUP and m["note"]:
                txt += f"  — {m['note']}"
            txt = txt.replace("\n", " ")
            if len(txt) > 90:
                txt = txt[:88] + "…"
            t.insert("", "end", iid=str(i), text=txt, image=self._dot(m["color"] or self.accent, 10),
                     values=(m["g"] + 1,))
        n = len(self.marks)
        self.seg.set_text("Marks", f"Marks {n}" if n else "Marks")

    def _on_mark_click(self, _e=None):
        sel = self.marks_tree.selection()
        if not sel:
            return
        m = self.marks[int(sel[0])]
        self.sel_annot = (m["g"], m["xref"])
        self.flash = (m["g"], m["bbox"])
        self._show_spot(m["g"], m["bbox"])
        self.root.after(1200, self._end_flash)

    def _end_flash(self):
        self.flash = None
        self.redraw()

    def _delete_mark_from_list(self):
        sel = self.marks_tree.selection()
        if sel:
            m = self.marks[int(sel[0])]
            self.sel_annot = (m["g"], m["xref"])
            self.delete_selected_annot()

    # ---- editing a PDF safely (undo + save straight into the file)
    def _require_pdf(self, g):
        fi = self.book.pages[g][0]
        f = self.book.files[fi]
        if f["pdf"]:
            return fi
        if is_outside(f["path"]):
            prog = OUTSIDE_KIND.get(os.path.splitext(f["path"])[1].lower(), ("", "its program"))[1]
            if messagebox.askyesno(APP_NAME, f'BindLens can\'t show the inside of "{f["rel"]}", so it can\'t be '
                                             f'marked here.\n\nOpen it in {prog}?'):
                open_in_os(f["path"])
            return None
        if messagebox.askyesno(APP_NAME, f'"{f["rel"]}" is not a PDF, so marks can\'t be saved inside it.\n\n'
                                         f'Convert it to PDF now?'):
            self.convert_to_pdf(fi)
        return None

    def _file_bytes(self, fi):
        f = self.book.files[fi]
        data = self.writer.get(f["path"])
        if data is not None:
            return data
        with open(f["path"], "rb") as fh:
            return fh.read()

    def _begin_edit(self, fi):
        f = self.book.files[fi]
        try:
            snap = self._file_bytes(fi)
        except Exception:
            snap = None
        if snap is not None:
            self.undo_stack.append((fi, f["path"], snap))
            del self.undo_stack[:-UNDO_MAX]
            self.redo_stack.clear()
        if self.lib.settings.get("backups", False) and snap is not None:
            self._keep_version(f["path"], snap)

    def _has_versions(self, path):
        try:
            d = self._versions_dir(path)
            return os.path.isdir(d) and any(x.endswith(".pdf") for x in os.listdir(d))
        except Exception:
            return False

    # ---- 3.0: earlier versions of each PDF - a copy before the first change of each day (the last 6) ------
    VERSIONS_KEEP = 6

    def _versions_dir(self, path):
        import hashlib
        key = hashlib.sha1(self.lib.norm(path).encode("utf-8", "replace")).hexdigest()[:12]
        return os.path.join(self.lib.meta_dir, "versions", clean_name(os.path.basename(path))[:60] + " " + key)

    def _keep_version(self, path, snap, force=False):
        day = time.strftime("%Y-%m-%d")
        done = self.__dict__.setdefault("_ver_done", set())
        if (path, day) in done and not force:
            return
        done.add((path, day))
        if len(snap) > 150 * 1024 * 1024:
            return
        d = self._versions_dir(path)

        def work():
            try:
                os.makedirs(d, exist_ok=True)
                have = sorted(x for x in os.listdir(d) if x.endswith(".pdf"))
                if not force and any(x.startswith(day) for x in have):
                    return
                name = time.strftime("%Y-%m-%d %H.%M.%S") + ".pdf"
                with open(os.path.join(d, name), "wb") as fh:
                    fh.write(snap)
                with open(os.path.join(d, "file.txt"), "w", encoding="utf-8") as fh:
                    fh.write(path)
                have = sorted(x for x in os.listdir(d) if x.endswith(".pdf"))
                for old in have[:-self.VERSIONS_KEEP]:
                    os.remove(os.path.join(d, old))
            except Exception as ex:
                _log(f"keep version: {ex}")
        threading.Thread(target=work, daemon=True).start()

    def versions_dialog(self, fi):
        """Earlier versions of a PDF (before the day's first change): look at one, or put it back."""
        T, A = self.T, self.accent
        f = self.book.files[fi]
        path = f["path"]
        d0 = self._versions_dir(path)
        vers = sorted((x for x in (os.listdir(d0) if os.path.isdir(d0) else []) if x.endswith(".pdf")),
                      reverse=True)
        d = self._dialog("Earlier versions")
        tk.Label(d, text="Earlier versions", font=self.F(15, "bold"), bg=T["panel"], fg=T["text"]).pack(
            anchor="w", padx=22, pady=(18, 2))
        tk.Label(d, text=f"“{os.path.basename(path)}” as it was before the first change of each day "
                         f"(BindLens keeps the last {self.VERSIONS_KEEP}).", font=self.F(9), bg=T["panel"],
                 fg=T["muted"], wraplength=460, justify="left").pack(anchor="w", padx=22)
        body = tk.Frame(d, bg=T["panel"])
        body.pack(fill="x", padx=22, pady=12)
        if not vers:
            tk.Label(body, text="No earlier versions yet - one is kept the first time you change this file each "
                                "day.", font=self.F(10), bg=T["panel"], fg=T["muted"], wraplength=460,
                     justify="left").pack(anchor="w", pady=8)
        for v in vers:
            full = os.path.join(d0, v)
            row = tk.Frame(body, bg=T["chip"], padx=12, pady=7)
            row.pack(fill="x", pady=3)
            try:
                when = time.strftime("%A %d %B %Y, %H:%M", time.strptime(v[:-4], "%Y-%m-%d %H.%M.%S"))
            except ValueError:
                when = v[:-4]
            try:
                kb = os.path.getsize(full) / 1024
            except OSError:
                kb = 0
            tk.Label(row, text=when.replace(" 0", " "), font=self.F(10, "bold"), bg=T["chip"],
                     fg=T["text"]).pack(side="left")
            tk.Label(row, text=f"  {kb / 1024:.1f} MB" if kb > 1024 else f"  {kb:.0f} KB", font=self.F(9),
                     bg=T["chip"], fg=T["muted"]).pack(side="left")

            def back(full=full, when=when):
                if not messagebox.askyesno(APP_NAME, f"Put back the version of {when}?\n\nThe file as it is now "
                                                     f"is kept as an earlier version too, so you can come back.",
                                           parent=d):
                    return
                try:
                    with open(full, "rb") as fh:
                        data = fh.read()
                    self._flush_dirty()
                    cur = self._file_bytes(fi)
                    self._keep_version(path, cur, force=True)
                    self.writer.put(path, data)
                    self.writer.wait(10)
                except Exception as ex:
                    messagebox.showerror(APP_NAME, f"Could not put it back:\n{ex}", parent=d)
                    return
                d.destroy()
                self._reopen_keep_history()
                self._toast(f"✓  {os.path.basename(path)} is back as it was on {when}", ms=5000)
            PillButton(row, self, "Put it back", back, kind="soft", bg_key="chip", height=28).pack(side="right")
            PillButton(row, self, "Look", lambda full=full: open_in_os(full), kind="ghost", bg_key="chip",
                       height=28).pack(side="right", padx=6)
        bf = tk.Frame(d, bg=T["panel"])
        bf.pack(fill="x", padx=22, pady=(0, 16))
        PillButton(bf, self, "Close", d.destroy, kind="accent").pack(side="right")
        d.bind("<Escape>", lambda e: d.destroy())
        self._center(d)

    def _commit_edit(self, fi, g=None):
        """Save the in-memory changes into the PDF file itself (written in the background)."""
        self._save_file(fi)
        if getattr(self, "_migrated", False):
            self._migrated = False
            g = None
        if g is None:
            self._invalidate_file(fi)
            self._refresh_file_marks(fi)
        else:
            self._invalidate(g)
            self.words_cache.pop(g, None)
            self._refresh_page_marks(g)
        self.redraw()

    def _save_file(self, fi):
        """Hand the PDF to the background writer: the original file is updated (no copies)."""
        f = self.book.files[fi]
        locked = self.__dict__.setdefault("_locked_paths", set())
        if f["path"] not in locked:                 # marks of older versions: lock them as well (once)
            locked.add(f["path"])
            try:
                if self._lock_old_marks(self.book.doc(fi)):
                    self._migrated = True
            except Exception as ex:
                _log(f"lock old marks: {ex}")
        try:
            big = (f.get("count", 0) > 400 or os.path.getsize(f["path"]) > 20 * 1024 * 1024)
        except OSError:
            big = False
        doc = self.book.doc(fi)
        # 3.0: a digitally signed PDF (a vetting disclosure…) - marks would show its signature as changed
        try:
            signed = doc.get_sigflags() >= 1
        except Exception:
            signed = False
        if signed:
            how = self.__dict__.setdefault("_signed_how", {}).get(f["path"])
            if how is None:
                ans = messagebox.askyesnocancel(
                    APP_NAME, f"“{os.path.basename(f['path'])}” is digitally signed.\n\nMarks change the file, and "
                              f"its signature would then show as changed.\n\nYes - keep the signed original as it "
                              f"is and save your marks in a copy next to it\nNo - save the marks in the original "
                              f"anyway\nCancel - do not save these marks")
                how = {True: "copy", False: "orig", None: "cancel"}[ans]
                if how != "cancel":
                    self._signed_how[f["path"]] = how
            if how in ("copy", "cancel"):
                data = None
                if how == "copy":
                    try:
                        data = doc.tobytes(garbage=1, deflate=True)
                    except Exception:
                        data = doc.tobytes()
                if self.undo_stack and self.undo_stack[-1][1] == f["path"]:
                    self.undo_stack.pop()                  # the original is not changed
                self.book.reopen(fi)
                self.sel_annot = None
                self._invalidate_file(fi)
                self._refresh_file_marks(fi)
                self.redraw()
                if data is not None:
                    stem = os.path.splitext(os.path.basename(f["path"]))[0]
                    dst = unique_path(os.path.dirname(f["path"]), f"{stem} (with my marks).pdf")
                    try:
                        with open(dst, "wb") as fh:
                            fh.write(data)
                        note_change("Copy with your marks (the original is signed)", dst, f["path"])
                        self._toast(f"Your marks are in a copy: {os.path.basename(dst)} - the signed original is "
                                    f"unchanged", ms=7000)
                        self._verify_scan(fresh_names={self.folder}, toast=False)
                    except Exception as ex:
                        messagebox.showerror(APP_NAME, f"Could not save the copy:\n{ex}")
                return False
        full = f["path"] in self.__dict__.setdefault("_full_next", set())
        if full:                 # 3.2: text erased for good - the whole file is written again, without it
            self._full_next.discard(f["path"])
            f["base_fp"] = None
        try:
            big_ = big or os.path.getsize(f["path"]) > 8 * 1024 * 1024
        except OSError:
            big_ = big
        if big_ and not full and f.get("base_fp") and not (doc.metadata or {}).get("encryption"):
            # 3.2: a big PDF is saved as its original + a short update (only that is written to the disk)
            try:
                data = pdf_incremental_bytes(self.fitz, doc)
                base = f["base_fp"]
                if len(data) > base[0] and _fp(data, base[0]) == base:
                    self.writer.put(f["path"], data, expect=self.book.disk.get(f["path"]), base=base)
                    self.book.keep.add(fi)
                    self._watch_writer()
                    return True
            except Exception as ex:
                _log(f"quick save: {ex}")
        try:                     # (a big file is not packed again at every mark: saving stays instant)
            if (doc.metadata or {}).get("encryption"):
                # 3.0: a protected PDF stays protected (it lost its password / permissions at the first mark)
                import io as _io
                bio = _io.BytesIO()
                doc.save(bio, garbage=1, deflate=not big, encryption=self.fitz.PDF_ENCRYPT_KEEP)
                data = bio.getvalue()
            else:
                data = doc.tobytes(garbage=1) if big else doc.tobytes(garbage=1, deflate=True)
        except Exception:
            data = doc.tobytes()
        self.writer.put(f["path"], data, expect=self.book.disk.get(f["path"]))
        self.book.keep.add(fi)
        self._watch_writer()
        return True

    def _watch_writer(self):
        if self._dirty_job is None:
            self._dirty_job = self.root.after(700, self._poll_writer)

    def _poll_writer(self):
        self._dirty_job = None
        w = self.writer
        if self.book:
            for fi in list(self.book.keep):
                if fi < len(self.book.files) and w.get(self.book.files[fi]["path"]) is None:
                    self.book.keep.discard(fi)
                    self.book.update_size(fi)
        if w.conflicts:
            with w.lock:
                confl, w.conflicts = list(w.conflicts), []
            for path, dst in confl:
                self._conflict_note(path, dst)
        if w.failed:
            with w.lock:
                fl = dict(w.failed)
            gone = [p for p, why in fl.items() if why == "gone"]
            ro = [p for p, why in fl.items() if why == "read-only"]
            busy = [p for p in fl if p not in gone and p not in ro]
            if gone or ro:
                for p in gone + ro:
                    key = (p, fl[p])
                    told = self.__dict__.setdefault("_told_fail", set())
                    if key not in told:
                        told.add(key)
                        self._toast(f"Can't save “{os.path.basename(p)}”: " +
                                    ("it is not there any more (moved or deleted?) - your marks are kept and "
                                     "offered again next time" if p in gone else
                                     "the file is read-only (right-click it in Explorer > Properties)"), ms=8000)
            if busy:
                names = ", ".join(os.path.basename(p) for p in busy[:3])
                self.set_status(f"Can't save {names} right now (open in another program?). Your changes are kept "
                                f"and will be saved as soon as it is closed.")
            if getattr(self, "_retry_job", None) is None:              # 3.0: one retry at a time (they piled up)
                def again():
                    self._retry_job = None
                    w.retry()
                self._retry_job = self.root.after(6000, again)
        if w.q.unfinished_tasks or w.failed or (self.book and self.book.keep):
            self._dirty_job = self.root.after(900, self._poll_writer)

    def _conflict_note(self, path, dst):
        """3.0: the file was changed in another program after BindLens opened it - BindLens did not write over
        it: your marks are in a copy next to it."""
        name = os.path.basename(path)
        self.set_status(f"“{name}” was changed in another program - your marks were saved in "
                        f"“{os.path.basename(dst)}” next to it (the other changes are kept).")
        if messagebox.askyesno(APP_NAME, f"“{name}” was changed in another program after BindLens opened it.\n\n"
                                         f"So that nothing is lost, BindLens did not write over it: your marks are "
                                         f"saved in a copy next to it:\n\n{os.path.basename(dst)}\n\n"
                                         f"Read the book again now (to see both files)?"):
            if self.folder is not None:
                self.refresh_book(self.folder)

    def _flush_dirty(self, final=False):
        self.writer.retry()
        if final:
            ok = self.writer.wait(6 if getattr(self, "_closing", False) else 20)
            if getattr(self, "_closing", False):
                if self.writer.failed:
                    _log("close: could not save " + ", ".join(self.writer.failed))
                return
            if not ok or self.writer.failed:
                names = [os.path.basename(p) for p in self.writer.latest]
                if names:
                    messagebox.showwarning(APP_NAME, "Some changes could not be saved because the file is open in "
                                                     "another program:\n\n" + "\n".join(names))

    def _typing(self):
        try:
            return isinstance(self.root.focus_get(), (tk.Text, tk.Entry, ttk.Entry, ttk.Combobox, ttk.Spinbox))
        except Exception:
            return False

    def undo(self):
        if self._typing():
            return
        self._swap_history(self.undo_stack, self.redo_stack, "Undone.")

    def redo(self):
        if self._typing():
            return
        self._swap_history(self.redo_stack, self.undo_stack, "Redone.")

    def _update_undo_buttons(self):
        pass

    def _swap_history(self, src, dst, msg):
        if not src or not self.book:
            self.set_status("Nothing to " + ("undo." if msg == "Undone." else "redo."))
            return
        fi, path, snap = src.pop()
        if fi >= len(self.book.files) or self.book.files[fi]["path"] != path:
            src.clear()
            return
        try:
            dst.append((fi, path, self._file_bytes(fi)))
            self.writer.put(path, snap)
            self.book.keep.add(fi)
            self.book.reopen(fi, data=snap)
            self._watch_writer()
            if self.book.doc(fi).page_count != self.book.files[fi]["count"]:
                self.sel_annot = None
                self._structure_changed(fi)
                self.set_status(msg)
                return
        except Exception as ex:
            messagebox.showerror(APP_NAME, f"Could not {msg[:-2].lower()}:\n{ex}")
            self.book.reopen(fi)
            return
        self.sel_annot = None
        self._invalidate_file(fi)
        self._refresh_file_marks(fi)
        self.redraw()
        self._update_undo_buttons()
        self.set_status(msg)

    # ---- creating marks
    def _page_rects(self, page, rects):
        dm = page.derotation_matrix
        return [self.fitz.Rect(r) * dm for r in rects]

    def _finish_annot(self, annot, note=None):
        if note is None:
            note = annot_meta(annot).get("note", "")
        lock_annot(self.fitz, annot, {"note": note} if note else {})

    def add_markup(self, kind, color=None, sel=None, ask_note=False):
        sel = sel or self.sel
        self._close_float()
        if not sel or not self.book:
            return
        g = sel["g"]
        fi = self._require_pdf(g)
        if fi is None:
            return
        color = color or self.lib.settings["color"]
        note = None
        if ask_note:
            note = self._ask_text("Note", "")
            if note is None:
                return
        self._begin_edit(fi)
        page = self.book.page(g)
        rects = self._page_rects(page, sel["rects"])
        rgb = hex_to_rgb01(color)
        if sel.get("area") and kind != "highlight":
            # 3.0: on an area (a scanned page) underline / strike draw a LINE - a solid box hid the page
            r0 = rects[0]
            y = r0.y1 - 1 if kind == "underline" else (r0.y0 + r0.y1) / 2
            a = page.add_line_annot(self.fitz.Point(r0.x0, y), self.fitz.Point(r0.x1, y))
            a.set_colors(stroke=rgb)
            a.set_border(width=1.6)
        elif sel.get("area"):
            a = page.add_rect_annot(rects[0])
            a.set_colors(stroke=rgb, fill=rgb)
            a.set_opacity(0.35)
        elif kind == "highlight":
            a = page.add_highlight_annot(rects)
            a.set_colors(stroke=rgb)
        elif kind == "underline":
            a = page.add_underline_annot(rects)
            a.set_colors(stroke=rgb)
        else:
            a = page.add_strikeout_annot(rects)
            a.set_colors(stroke=rgb)
        self._finish_annot(a, note or "")
        self.set_color(color)
        self.sel = None
        self._commit_edit(fi, g)
        self.set_status({"highlight": "Highlighted", "underline": "Underlined", "strike": "Struck through"}[kind]
                        + " - saved in the PDF.  Ctrl+Z to undo.")

    def add_ink(self, g, pts):
        fi = self._require_pdf(g)
        if fi is None or len(pts) < 2:
            return
        self._begin_edit(fi)
        page = self.book.page(g)
        dm = page.derotation_matrix
        line = [tuple(self.fitz.Point(p) * dm) for p in pts]
        a = page.add_ink_annot([line])
        a.set_colors(stroke=hex_to_rgb01(self.lib.settings["color"]))
        a.set_border(width=2)
        self._finish_annot(a, "")
        self._commit_edit(fi, g)

    def add_line(self, g, py):
        fi = self._require_pdf(g)
        if fi is None:
            return
        _, _, pw, _ = self.book.pages[g]
        x0, x1 = self._text_margins(g, pw)
        self._begin_edit(fi)
        page = self.book.page(g)
        dm = page.derotation_matrix
        a = page.add_line_annot(self.fitz.Point(x0, py) * dm, self.fitz.Point(x1, py) * dm)
        a.set_colors(stroke=hex_to_rgb01(self.lib.settings["color"]))
        a.set_border(width=1.5)
        self._finish_annot(a, "")
        self._commit_edit(fi, g)

    def _text_margins(self, g, pw):
        words = self._words(g)
        if len(words) >= 5:
            xs0 = sorted(w[0] for w in words)
            xs1 = sorted(w[2] for w in words)
            x0, x1 = xs0[len(xs0) // 20], xs1[-1 - len(xs1) // 20]
            if x1 - x0 > pw * 0.3:
                return x0, x1
        return pw * 0.07, pw * 0.93

    # ---- text boxes, sticky notes, stamps, signatures, pictures: locked picture marks + their settings ----
    LEGACY_LOOK = {"plain": "plain", "outline": "outline", "label": "label", "solid": "solid", "dashed": "dashed",
                   "highlight": "marker", "sticky": "label", "stamp": "double"}

    def _legacy_box_spec(self, a):
        """A text box made by BindLens 1.x (FreeText) -> settings of a 1.6 text box."""
        subj = (a.info.get("subject") or "")
        old = {}
        if subj.startswith("BindLens box|"):
            try:
                old = json.loads(subj.split("|", 1)[1])
            except Exception:
                old = {}
        elif subj.startswith("BindLens text|"):
            parts = subj.split("|")
            if len(parts) == 4:
                old = {"font": "Sans" if parts[1] == "Label" else parts[1], "style": "label" if parts[1] == "Label"
                       else "plain", "color": parts[3], "size": float(parts[2] or 12)}
        text = (a.info.get("content") or "").strip()
        if old.get("style") == "stamp" and text.isupper():
            text = text.title()
        r = self.fitz.Rect(a.rect)
        spec = {"kind": "box", "look": self.LEGACY_LOOK.get(old.get("style", "plain"), "plain"),
                "color": old.get("color") or annot_color(a) or "#1F1F1F", "font": old.get("font", "Sans"),
                "size": float(old.get("size", 12)), "al": {0: "l", 1: "c", 2: "r"}.get(int(old.get("align", 0)), "l"),
                "doc": rich_from_plain(text), "w": max(40.0, r.width), "angle": 0}
        if old.get("style") == "sticky":
            spec["color"] = "#F2C94C"
        return spec

    def _convert_legacy(self, g, xref, edit=True):
        """Turn an old FreeText box into a 1.6 text box at the same place. Returns the new xref."""
        page, a = self._load_annot(g, xref)
        if a is None or a.type[1] != "FreeText":
            return xref
        spec = self._legacy_box_spec(a)
        r = self.fitz.Rect(a.rect) * page.rotation_matrix
        r.normalize()
        fi = self.book.pages[g][0]
        if edit:
            self._begin_edit(fi)
        page, a = self._load_annot(g, xref)
        page.delete_annot(a)
        pad = card_pad(spec)
        a2 = self._make_card(page, spec, topleft=(r.x0 - pad, r.y0 - pad))
        nx = a2.xref
        if edit:
            self._commit_edit(fi, g)
        self.sel_annot = (g, nx)
        return nx

    def _lock_old_marks(self, doc):
        """Marks made by older BindLens versions: lock them too (no comment bubble, not editable elsewhere)."""
        changed = 0
        for pg in doc:
            try:
                if not pg.annots():
                    continue
            except Exception:
                continue
            rm = pg.rotation_matrix
            for a in list(pg.annots() or []):
                try:
                    info = a.info
                    if (info.get("title") or "") != APP_NAME:
                        continue
                    t, _v = doc.xref_get_key(a.xref, BL_KEY)
                    if t == "string":
                        if doc.xref_get_key(a.xref, "Contents")[0] != "null":
                            doc.xref_set_key(a.xref, "Contents", "null")
                            changed += 1
                        continue
                    meta = annot_meta(a)
                    if a.type[1] == "FreeText":
                        spec = self._legacy_box_spec(a)
                        r = self.fitz.Rect(a.rect) * rm
                        r.normalize()
                        pg.delete_annot(a)
                        pad = card_pad(spec)
                        self._make_card(pg, spec, topleft=(r.x0 - pad, r.y0 - pad))
                    else:
                        meta.pop("legacy", None)
                        lock_annot(self.fitz, a, meta)
                    changed += 1
                except Exception:
                    continue
        return changed

    @property
    def images_dir(self):
        return os.path.join(self.lib.meta_dir, "images")

    def _card_spec(self, a):
        return annot_meta(a).get("card")

    def _card_text(self, spec):
        return card_plain_text(spec)

    def _make_card(self, page, spec, center=None, topleft=None):
        png, W, H = render_card(self.fitz, spec, scale=4.0 if spec.get("kind") in ("box", "note") else 3.0,
                                images_dir=self.images_dir)
        if spec.get("kind") == "watermark":
            r = page.rect
        else:
            if topleft is not None:
                x0, y0 = topleft
            else:
                x0, y0 = center[0] - W / 2, center[1] - H / 2
            r = self.fitz.Rect(x0, y0, x0 + W, y0 + H) * page.derotation_matrix
        a = page.add_stamp_annot(r, stamp=png)
        lock_annot(self.fitz, a, {"card": spec})
        return a

    def add_card(self, g, px, py, spec, topleft=False):
        fi = self._require_pdf(g)
        if fi is None:
            return None
        spec = dict(spec)
        if spec.get("date") and spec.get("kind") in ("stamp", "sign"):
            spec["date_text"] = time.strftime("%d %b %Y")
        self._begin_edit(fi)
        page = self.book.page(g)
        try:
            if topleft:
                a = self._make_card(page, spec, topleft=(px, py))
            else:
                a = self._make_card(page, spec, center=(px, py))
            xref = a.xref
        except Exception as ex:
            self.undo_stack.pop()
            messagebox.showerror(APP_NAME, f"Could not add it:\n{ex}")
            return None
        self._commit_edit(fi, g)
        if self.tool in ("note", "stamp", "text"):
            self.tool = "select"
            self._refresh_tool_buttons()
            self.canvas.config(cursor="")
        self.sel_annot = (g, xref)
        self.redraw()
        self.set_status("Added. Drag it to move · corner to resize · round handle to turn · double-click to edit.")
        return xref

    def _replace_card(self, g, xref, spec=None, rect=None, topleft=None):
        page, a = self._load_annot(g, xref)
        if a is None:
            return None
        old = self._card_spec(a) or {}
        spec = dict(spec or old)
        r = self.fitz.Rect(a.rect) * page.rotation_matrix
        r.normalize()
        fi = self.book.pages[g][0]
        self._begin_edit(fi)
        page, a = self._load_annot(g, xref)
        page.delete_annot(a)
        if topleft is not None:
            a2 = self._make_card(page, spec, topleft=topleft)
        elif rect is not None:
            a2 = self._make_card(page, spec, topleft=(rect.x0, rect.y0))
        elif spec.get("kind") == "box" and not float(spec.get("angle", 0)) and not float(old.get("angle", 0)):
            a2 = self._make_card(page, spec, topleft=(r.x0, r.y0))       # text boxes grow downwards
        else:
            a2 = self._make_card(page, spec, center=((r.x0 + r.x1) / 2, (r.y0 + r.y1) / 2))
        nx = a2.xref
        self._commit_edit(fi, g)
        self.sel_annot = (g, nx)
        self.redraw()
        return nx

    def rotate_card(self, g, xref, by, absolute=False):
        m = self._mark(g, xref)
        if not m or not m.get("card"):
            return
        spec = dict(m["card"])
        if absolute:
            ang = by
        else:
            ang = 0 if by == 0 else float(spec.get("angle", 0)) + by
        ang = ((ang + 180) % 360) - 180
        spec["angle"] = round(ang, 1)
        self._replace_card(g, xref, spec)

    def _resize_card(self, g, xref, m, r):
        spec = dict(m["card"])
        bx = m["bbox"]
        kx = r.width / max(1, bx[2] - bx[0])
        ky = r.height / max(1, bx[3] - bx[1])
        kind = spec.get("kind")
        if kind == "box":
            spec["w"] = max(40, float(spec.get("w", 200)) * kx)
            if is_shape(spec):
                spec["minh"] = max(20, float(spec.get("h", 40)) * ky)
            else:
                spec["minh"] = max(0, float(spec.get("h", 40)) * ky) if ky > 1.05 else 0
            self._replace_card(g, xref, spec, rect=r)
            return
        if kind in ("sign", "image", "stamp") and spec.get("style") != "label":
            kx = ky = max(kx, ky) if kind != "stamp" else (kx + ky) / 2
        spec["w"] = max(40, spec.get("w", 150) * kx)
        spec["h"] = max(30, spec.get("h", 100) * ky)
        if kind == "stamp" and spec.get("style") == "circle":
            spec["w"] = spec["h"] = max(spec["w"], spec["h"])
        self._replace_card(g, xref, spec, rect=r)

    def add_note(self, g, px, py, text=None, spec=None):
        """Sticky note: a real-looking note on the page. Move, resize, turn, edit."""
        fi = self._require_pdf(g)
        if fi is None:
            return
        spec = dict(spec or self._note_default())
        if text is None:
            spec = self._card_dialog(spec, "Sticky note")
            if not spec:
                return
            self.lib.settings["note_card"] = {k: v for k, v in spec.items() if k not in ("text", "doc", "img")}
        else:
            spec["text"] = text
        if not (spec.get("text", "").strip() or spec.get("img")):
            return
        self.add_card(g, px + spec["w"] / 2 - 10, py + spec["h"] / 2 - 10, spec)

    def _note_default(self):
        d = {"kind": "note", "text": "", "color": "#FFE066", "attach": "pin", "paper": [], "font": "Sans",
             "size": 12, "angle": -2, "w": 180, "h": 130, "tc": "#222226"}
        d.update(self.lib.settings.get("note_card", {}))
        d.pop("style", None)
        d["kind"] = "note"
        return d

    def _shape_default(self, look="s_rect"):
        d = {"kind": "box", "look": look, "color": "#FFFFFF", "bc": "#1F1F1F", "bw": 1.5, "font": "Sans",
             "size": 13, "w": 170, "al": "c", "angle": 0, "op": 1.0}
        d.update(self.lib.settings.get("shape_card", {}))
        d["look"] = look
        d["kind"] = "box"
        return d

    def _box_default(self):
        st = self.lib.settings
        d = {"kind": "box", "look": "plain", "color": "#1F1F1F", "font": "Sans", "size": 14,
             "w": 240, "al": "l", "angle": 0, "op": 1.0, "radius": 8, "tail": "bl"}
        d.update(st.get("box_card", {}))
        d["kind"] = "box"
        return d

    def _symbol_spec(self, sym):
        """3.2: a tick, cross… ready to place (size and colours from the Stamp menu)."""
        st = self.lib.settings
        sym = sym if sym in SYMBOLS else "tick"
        name, _glyph, col = SYMBOLS[sym]
        if st.get("sym_color") == "mine":
            col = st.get("color", col) or col
        size = float(st.get("sym_size", 24))
        return {"kind": "stamp", "style": "symbol", "sym": sym, "text": name, "color": col, "angle": 0,
                "date": False, "w": size, "h": size}

    def _stamp_spec(self, key=None):
        st = self.lib.settings
        key = key or st.get("stamp", "Approved")
        if str(key).startswith("sym:"):
            return self._symbol_spec(str(key)[4:])
        if str(key).startswith("my:"):
            mine = st.get("my_stamps", [])
            try:
                return dict(mine[int(key[3:])])
            except Exception:
                key = "Approved"
        col = dict(STAMPS).get(key, "#1E8E3E")
        date = st.get("stamp_date", True)
        w = max(120, len(key) * 13 + 50)
        return {"kind": "stamp", "text": key, "color": col, "style": st.get("stamp_style", "rubber"), "angle": -6,
                "font": "Sans", "size": 16, "date": date, "w": w, "h": 66 if date else 52}

    def add_stamp(self, g, px, py):
        spec = getattr(self, "_pending_card", None) or self._stamp_spec()
        self._pending_card = None
        if spec.get("style") == "circle" and spec.get("kind") == "stamp":
            spec["w"] = spec["h"] = max(spec.get("w", 110), 110)
        self.add_card(g, px, py, spec)

    # ---- shapes, eraser, white-out
    # ---- typing straight on the page (text boxes) + a floating bar while you type ---------------------
    def _box_base(self, spec):
        return {"f": spec.get("font", "Sans"), "z": float(spec.get("size", 14)), "c": box_text_color(spec),
                "al": spec.get("al", "l")}

    def start_box_editor(self, g, px, py, width=None, xref=None, spec=None, center=None):
        """Type on the page. (px, py) = top-left corner of the box, in page points."""
        if not self.book or not self.book.total:
            return
        fi = self._require_pdf(g)
        if fi is None:
            return
        self._close_box_editor(save=True)
        self._close_float()
        try:                                       # bring the place you type into view
            _a, b, _c, _d = self._to_canvas(g, (px, py, px, py))
            top = self.canvas.canvasy(0)
            if not (top + 30 < b < top + self.canvas.winfo_height() - 90):
                self._show_spot(g, (px, py, px, py))
        except Exception:
            pass
        spec = dict(spec or self._box_default())
        if width:
            spec["w"] = max(60.0, float(width))
        if not xref and not is_shape(spec):
            spec.pop("minh", None)
        c = self.canvas
        frame = tk.Frame(c, bg=self.accent, bd=0, highlightthickness=0)
        ed = {"g": g, "x": px, "y": py, "spec": spec, "xref": xref, "center": center, "frame": frame}
        rt = RichText(frame, base=self._box_base(spec), zoom=self.zoom, images_dir=self.images_dir,
                      on_change=self._grow_box_editor, height=1, width=8, padx=2, pady=1)
        rt.t.configure(bg=box_fill_color(spec), insertbackground=box_text_color(spec),
                       selectbackground=mix(box_fill_color(spec), self.accent, 0.35))
        rt.t.pack(fill="both", expand=True, padx=1, pady=1)
        ed["rt"] = rt
        self._ed = ed
        if spec.get("doc"):
            rt.set_doc(spec["doc"])
        elif spec.get("text"):
            rt.set_doc(rich_from_plain(spec["text"]))
        ed["bar"] = self._box_toolbar(ed)
        rt.t.bind("<Escape>", lambda e: (self._close_box_editor(save=False), "break")[1])
        rt.t.bind("<Control-Return>", lambda e: (self._close_box_editor(save=True), "break")[1])
        self._place_box_editor()
        rt.t.focus_set()
        if xref:
            rt.t.tag_add("sel", "1.0", "end-1c")
        self.set_status("Type on the page · the bar changes the look · Ctrl+Enter or click outside to finish · "
                        "Esc cancels")

    def edit_box_inline(self, g, xref):
        m = self._mark(g, xref)
        if not m or not m.get("card"):
            return
        spec = dict(m["card"])
        pad = card_pad(spec)
        x0, y0, x1, y1 = m["bbox"]
        center = None
        if abs(float(spec.get("angle", 0))) > 0.01:
            center = ((x0 + x1) / 2, (y0 + y1) / 2)
            px, py = center[0] - float(spec.get("w", 200)) / 2, center[1] - float(spec.get("h", 40)) / 2
        else:
            px, py = x0 + pad, y0 + pad
        self.sel_annot = None
        self.start_box_editor(g, px, py, xref=xref, spec=spec, center=center)

    def _box_editor_rect(self):
        """Where the words go (page points), for the box being typed."""
        ed = self._ed
        spec = ed["spec"]
        h = 4000
        if is_shape(spec):
            try:
                h = box_size(self.fitz, spec, self.images_dir)[1]
            except Exception:
                h = float(spec.get("minh", 90))
        r = self.fitz.Rect(ed["x"], ed["y"], ed["x"] + float(spec.get("w", 240)), ed["y"] + h)
        return box_text_rect(self.fitz, spec, r)

    def _place_box_editor(self):
        ed = getattr(self, "_ed", None)
        if not ed:
            return
        c = self.canvas
        g = ed["g"]
        if not self.book or g >= self._total():
            self._close_box_editor(save=False)
            return
        tr = self._box_editor_rect()
        a, b, cc, _d = self._to_canvas(g, (tr.x0, tr.y0, tr.x1, tr.y0 + 10))
        x, y = a - c.canvasx(0) - 3, b - c.canvasy(0) - 2
        w = max(40, cc - a + 6)
        h = ed.get("h") or self._editor_height()
        ed["frame"].place(x=x, y=y, width=w, height=h)
        bar = ed["bar"]
        bar.update_idletasks()
        bw = bar.winfo_reqwidth()
        by = y - bar.winfo_reqheight() - 8
        if by < 4:
            by = y + h + 8
        bx = min(max(4, x), max(4, c.winfo_width() - bw - 4))
        bar.place(x=bx, y=by)
        bar.lift()
        ed["frame"].lift()

    def _editor_height(self):
        ed = self._ed
        t = ed["rt"].t
        try:
            t.update_idletasks()
            px = t.count("1.0", "end", "ypixels")
            px = px[0] if isinstance(px, tuple) else px
        except Exception:
            px = None
        if not px:
            lines = int(t.index("end-1c").split(".")[0])
            px = lines * ed["rt"].px(ed["spec"].get("size", 14)) * 1.35
        return int(px) + 10

    def _grow_box_editor(self):
        ed = getattr(self, "_ed", None)
        if not ed:
            return
        h = self._editor_height()
        if h != ed.get("h"):
            ed["h"] = h
            self._place_box_editor()

    def _close_box_editor(self, save=True):
        ed = getattr(self, "_ed", None)
        if not ed:
            return
        self._ed = None
        self.tooltip.cancel()
        rt = ed["rt"]
        try:
            doc = rt.get_doc()
        except Exception:
            _log("box editor: could not read the text")
            doc = rich_from_plain(rt.t.get("1.0", "end-1c"))
        spec = dict(ed["spec"])
        for k in ("bar", "frame"):              # each on its own: one failing never leaves the other behind
            try:
                ed[k].place_forget()
                ed[k].destroy()
            except Exception:
                pass
        self._close_palette()
        self.canvas.focus_set()
        if not save:
            self.set_status("Cancelled.")
            self.redraw()
            return
        text = rich_plain(doc)
        if not text.strip() and not any(b.get("t") in ("table", "img") for b in doc["blocks"]) and \
                not is_shape(spec):
            if ed["xref"]:
                self.sel_annot = (ed["g"], ed["xref"])
                self.delete_selected_annot()
            self.redraw()
            return
        doc["base"] = {}
        spec["doc"] = doc
        spec["text"] = text
        spec.pop("h", None)
        if is_shape(spec):
            self.lib.settings["shape_card"] = {k: v for k, v in spec.items()
                                               if k in ("color", "bc", "bw", "tc", "font", "size", "al", "shadow",
                                                        "op", "grad", "color2", "gloss", "glow", "raised", "dash",
                                                        "radius")}
        else:
            self.lib.settings["box_card"] = {k: v for k, v in spec.items()
                                             if k in ("look", "color", "font", "size", "al", "tc", "op", "radius",
                                                      "tail", "shadow", "color2", "color_set")}
        pad = card_pad(spec)
        g = ed["g"]
        if ed["xref"]:
            if ed["center"]:
                self._replace_card(g, ed["xref"], spec)
            else:
                self._replace_card(g, ed["xref"], spec, topleft=(ed["x"] - pad, ed["y"] - pad))
        else:
            self.add_card(g, ed["x"] - pad, ed["y"] - pad, spec, topleft=True)

    def _ed_apply(self, fn):
        """Run a change on the selection - or on the whole box when nothing is selected."""
        ed = self._ed
        if not ed:
            return
        rt = ed["rt"]
        had = rt.sel_range()
        if not had:
            rt.t.tag_add("sel", "1.0", "end-1c")
        try:
            fn(rt)
        finally:
            if not had:
                rt.t.tag_remove("sel", "1.0", "end")
        rt.t.focus_set()
        self._grow_box_editor()

    def _ed_refresh_look(self):
        ed = self._ed
        if not ed:
            return
        spec, rt = ed["spec"], ed["rt"]
        rt.base.update(self._box_base(spec))
        rt.t.configure(bg=box_fill_color(spec), fg=box_text_color(spec), insertbackground=box_text_color(spec))
        for w in ed["bar"].winfo_children():
            pass
        self._rebuild_box_toolbar()
        self._place_box_editor()
        rt.t.focus_set()

    def _rebuild_box_toolbar(self):
        ed = self._ed
        if not ed:
            return
        try:
            ed["bar"].destroy()
        except Exception:
            pass
        ed["bar"] = self._box_toolbar(ed)

    def _box_toolbar(self, ed):
        """The floating bar above the text you type: look, font, size, B I U S, colours, align, lists."""
        T = self.T
        spec, rt = ed["spec"], ed["rt"]
        bar = tk.Frame(self.canvas, bg=T["border"], bd=0)
        inner = tk.Frame(bar, bg=T["panel"], padx=6, pady=4)
        inner.pack(padx=1, pady=1)

        def btn(text, cmd, tip="", w=None, font=None, fg=None, bg=None):
            lb = tk.Label(inner, text=text, font=font or self.F(9), bg=bg or T["panel"], fg=fg or T["text"],
                          padx=6, pady=3, cursor="hand2", width=w or 0)
            lb.pack(side="left", padx=1)
            base_bg = bg or T["panel"]
            lb.bind("<Enter>", lambda e: (lb.configure(bg=T["hover"]), self.tooltip.schedule(lb, tip) if tip else None))
            lb.bind("<Leave>", lambda e: (lb.configure(bg=base_bg), self.tooltip.cancel()))
            lb.bind("<Button-1>", lambda e: (self.tooltip.cancel(), cmd(e)))
            return lb

        def sep():
            tk.Frame(inner, width=1, height=20, bg=T["border"]).pack(side="left", padx=4)

        def look_menu(e):
            mm = self._menu()
            mm.add_command(label="TEXT BOXES", state="disabled")
            for k, lab in BOX_LOOKS.items():
                mm.add_command(label=("●  " if spec.get("look") == k else "     ") + lab,
                               command=lambda k=k: (self._set_box_look(spec, k), self._ed_refresh_look()))
            mm.add_separator()
            mm.add_command(label="SHAPES (fill with colour)", state="disabled")
            for k, lab in SHAPE_LOOKS.items():
                mm.add_command(label=("●  " if spec.get("look") == k else "     ") + lab,
                               command=lambda k=k: (self._set_box_look(spec, k), self._ed_refresh_look()))
            self._popup(mm, e)

        def style_menu(e):
            mm = self._menu()
            self._shape_style_items(mm, spec, self._ed_refresh_look, e.x_root - 120, e.y_root + 18)
            self._popup(mm, e)

        def font_menu(e):
            mm = self._menu()
            for f in available_fonts():
                face = font_face(f)
                try:
                    mm.add_command(label=f, font=(face["tk"], 11),
                                   command=lambda f=f: set_font(f))
                except Exception:
                    mm.add_command(label=f, command=lambda f=f: set_font(f))
            self._popup(mm, e)

        def set_font(f):
            if not rt.sel_range():
                spec["font"] = f
                rt.base["f"] = f
            self._ed_apply(lambda r: r.set_fmt(f=f))
            self._rebuild_box_toolbar()
            self._place_box_editor()

        def size(d):
            if not rt.sel_range():
                spec["size"] = max(6, min(96, float(spec.get("size", 14)) + d))
                rt.base["z"] = spec["size"]
            self._ed_apply(lambda r: r.bump_size(d))
            self._rebuild_box_toolbar()
            self._place_box_editor()

        def colour(kind, e):
            def done(c):
                if kind == "text":
                    if not rt.sel_range():
                        spec["tc"] = c
                    self._ed_apply(lambda r: r.set_fmt(c=c))
                    self._ed_refresh_look()
                elif kind == "mark":
                    self._ed_apply(lambda r: r.set_fmt(bg=mix(c, "#FFFFFF", 0.45)))
                elif kind == "line":
                    spec["bc"] = c
                    self._ed_refresh_look()
                else:
                    spec["color"] = c
                    spec["color_set"] = 1
                    self._ed_refresh_look()
                if self._ed:
                    self._ed["rt"].t.focus_set()
            self.palette_popup(None, done, e.x_root - 120, e.y_root + 18)

        def align(a):
            if not rt.sel_range():
                spec["al"] = a
                rt.base["al"] = a
            self._ed_apply(lambda r: r.set_para(al=a))

        def lst(kind):
            rt.set_para(t=kind if rt.para_type() != kind else "p")
            rt.t.focus_set()
            self._grow_box_editor()
        def cbtn(draw, cmd, tip, on=False):
            bgc = mix(T["panel"], self.accent, 0.18) if on else T["panel"]
            cv = tk.Canvas(inner, width=26, height=24, bg=bgc, highlightthickness=0, cursor="hand2")
            cv.pack(side="left", padx=1)
            draw(cv)
            cv.bind("<Enter>", lambda e: (cv.configure(bg=T["hover"]), self.tooltip.schedule(cv, tip)))
            cv.bind("<Leave>", lambda e: (cv.configure(bg=bgc), self.tooltip.cancel()))
            cv.bind("<Button-1>", lambda e: (self.tooltip.cancel(), cmd(e)))
            return cv

        def lines_icon(a):
            def draw(cv):
                for k, ln in enumerate((14, 9, 14, 7)):
                    y = 6 + k * 4
                    x0 = {"l": 6, "c": 13 - ln / 2, "r": 20 - ln}[a]
                    cv.create_line(x0, y, x0 + ln, y, fill=T["text"], width=1.6, capstyle="round")
            return draw
        btn(("Shape: " if is_shape(spec) else "Look: ") + ALL_LOOKS.get(spec.get("look", "plain"), "Text"),
            look_menu, "How the box looks - text boxes and shapes")
        if is_shape(spec):
            btn("Style", style_menu, "Colours of the shape, its line and shadow")
        sep()
        btn(spec.get("font", "Sans"), font_menu, "Font")
        btn("−", lambda e: size(-1), "Smaller", w=1)
        tk.Label(inner, text=f"{float(spec.get('size', 14)):g}", font=self.F(9), bg=T["panel"], fg=T["muted"],
                 width=3).pack(side="left")
        btn("+", lambda e: size(1), "Bigger", w=1)
        sep()
        btn("B", lambda e: self._ed_apply(lambda r: r.toggle("b")), "Bold  Ctrl+B", w=1, font=self.F(10, "bold"))
        btn("I", lambda e: self._ed_apply(lambda r: r.toggle("i")), "Italic  Ctrl+I", w=1,
            font=(self.F(10)[0], 10, "italic"))
        btn("U", lambda e: self._ed_apply(lambda r: r.toggle("u")), "Underline  Ctrl+U", w=1,
            font=(self.F(10)[0], 10, "underline"))
        btn("S", lambda e: self._ed_apply(lambda r: r.toggle("s")), "Strike through", w=1,
            font=(self.F(10)[0], 10, "overstrike"))
        sep()
        tcol = box_text_color(spec)
        cbtn(lambda cv: (cv.create_text(13, 10, text="A", font=self.F(11, "bold"), fill=T["text"]),
                         cv.create_rectangle(6, 18, 20, 21, fill=tcol, outline="")),
             lambda e: colour("text", e), "Text colour")
        cbtn(lambda cv: (cv.create_polygon(8, 17, 15, 6, 19, 9, 12, 20, fill="#F2C94C", outline="#B58B00"),
                         cv.create_rectangle(5, 20, 21, 22, fill="#F2C94C", outline="")),
             lambda e: colour("mark", e), "Highlight the words")
        bc = spec.get("color", self.accent)
        if is_shape(spec):
            fc_ = "" if bc == "none" else bc
            cbtn(lambda cv: cv.create_rectangle(5, 5, 21, 19, fill=fc_, outline=spec.get("bc", "#1F1F1F"), width=2),
                 lambda e: colour("box", e), "Fill colour")
            lc_ = spec.get("bc", "#1F1F1F")
            cbtn(lambda cv: cv.create_rectangle(5, 5, 21, 19, fill="", outline=lc_, width=3),
                 lambda e: colour("line", e), "Line colour")
        else:
            cbtn(lambda cv: cv.create_oval(6, 5, 20, 19, fill=bc, outline=mix(bc, "#000000", 0.25)),
                 lambda e: colour("box", e), "Box colour")
        sep()
        for a, tip in (("l", "Align left"), ("c", "Centre"), ("r", "Align right")):
            cbtn(lines_icon(a), lambda e, a=a: align(a), tip, on=spec.get("al", "l") == a)
        sep()
        cbtn(lambda cv: [cv.create_oval(5, y - 1.5, 8, y + 1.5, fill=T["text"], outline="") or
                         cv.create_line(11, y, 21, y, fill=T["text"], width=1.6) for y in (7, 12, 17)],
             lambda e: lst("ul"), "Bullet list")
        cbtn(lambda cv: [cv.create_text(7, y, text=str(k + 1), font=(self.F(7)[0], 7), fill=T["text"]) or
                         cv.create_line(11, y, 21, y, fill=T["text"], width=1.6) for k, y in enumerate((7, 12, 17))],
             lambda e: lst("ol"), "Numbered list")
        sep()
        btn("More…", lambda e: self._box_more(), "Tail of the bubble, corners, shadow, see-through…")
        btn("Done", lambda e: self._close_box_editor(True), "Finish  (Ctrl+Enter or click outside)",
            fg=self.accent, font=self.F(9, "bold"))
        btn("Cancel", lambda e: self._close_box_editor(False), "Cancel  (Esc)")
        return bar

    @staticmethod
    def _set_box_look(spec, look):
        """A new look; a black 'colour' (plain text) becomes blue for the looks that show the colour."""
        was_shape = is_shape(spec)
        spec["look"] = look
        col = spec.get("color", "#1F1F1F")
        if look in SHAPE_LOOKS:
            if not was_shape:                             # a text box becomes a shape: white, black line
                spec.update(color="#FFFFFF", bc=spec.get("bc", "#1F1F1F"), bw=spec.get("bw", 1.5), al="c")
                spec.pop("tc", None)
                spec.setdefault("minh", 80)
            return
        if was_shape:
            spec.pop("minh", None)
            if col in ("#FFFFFF", "none"):
                spec["color"] = "#2F80ED"
        if look not in ("plain", "outline", "dashed", "double") and not is_light(col) and \
                max(hex_to_rgb01(col)) < 0.25:
            spec["color"] = "#2F80ED"
            spec.pop("color_set", None)

    def _box_more(self):
        """More options for the box being typed (dialog)."""
        ed = self._ed
        if not ed:
            return
        spec = ed["spec"]
        T = self.T
        d = self._dialog("Text box")
        f = tk.Frame(d, bg=T["panel"], padx=18, pady=12)
        f.pack(fill="both", expand=True)

        def lab(t):
            tk.Label(f, text=t.upper(), font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(anchor="w",
                                                                                               pady=(8, 3))
        lab("Look")
        lv = tk.StringVar(value=spec.get("look", "plain"))
        cb = ttk.Combobox(f, values=list(ALL_LOOKS.values()), state="readonly", width=26)
        cb.current(list(ALL_LOOKS).index(spec.get("look", "plain")) if spec.get("look", "plain") in ALL_LOOKS else 0)
        cb.pack(anchor="w")
        lab("Tail of the bubble / arrow")
        tv = tk.StringVar(value=spec.get("tail", "bl"))
        tf = tk.Frame(f, bg=T["panel"])
        tf.pack(anchor="w")
        for k, n in BOX_TAILS.items():
            ttk.Radiobutton(tf, text=n, value=k, variable=tv).pack(side="left", padx=(0, 6))
        lab("Round corners")
        rv = tk.DoubleVar(value=float(spec.get("radius", 8)))
        ttk.Scale(f, from_=0, to=24, variable=rv, length=220).pack(anchor="w")
        lab("Colour strength (see-through)")
        ov = tk.DoubleVar(value=float(spec.get("op", 1.0)))
        ttk.Scale(f, from_=0.15, to=1.0, variable=ov, length=220).pack(anchor="w")
        shv = tk.BooleanVar(value=bool(spec.get("shadow")))
        ttk.Checkbutton(f, text="Soft shadow", variable=shv).pack(anchor="w", pady=(8, 0))
        lab("Second colour (gradient look)")
        c2 = {"c": spec.get("color2") or mix(spec.get("color", "#2F80ED"), "#FF8FB1", 0.55)}
        self._inline_palette(f, c2["c"], lambda c: c2.__setitem__("c", c)).pack(anchor="w")
        autov = tk.BooleanVar(value=not spec.get("tc"))
        ttk.Checkbutton(f, text="Automatic text colour (fits the look)", variable=autov).pack(anchor="w", pady=(8, 0))

        def ok():
            self._set_box_look(spec, list(ALL_LOOKS)[cb.current()])
            spec["tail"] = tv.get()
            spec["radius"] = round(rv.get(), 1)
            spec["op"] = round(ov.get(), 2)
            spec["shadow"] = bool(shv.get())
            spec["color2"] = c2["c"]
            if autov.get():
                spec.pop("tc", None)
            d.destroy()
            self._ed_refresh_look()
        bf = tk.Frame(d, bg=T["panel"], padx=18, pady=10)
        bf.pack(fill="x")
        PillButton(bf, self, "OK", ok, kind="accent").pack(side="right")
        PillButton(bf, self, "Cancel", d.destroy, kind="ghost").pack(side="right", padx=6)
        self._center(d)
        d.grab_set()

    def add_shape(self, g, kind, p0, p1):
        fi = self._require_pdf(g)
        if fi is None:
            return
        x0, y0 = p0
        x1, y1 = p1
        if abs(x1 - x0) + abs(y1 - y0) < 6:
            return
        col = hex_to_rgb01(self.lib.settings["color"])
        self._begin_edit(fi)
        page = self.book.page(g)
        dm = page.derotation_matrix
        if kind in ("rect", "ellipse"):
            r = self.fitz.Rect(min(x0, x1), min(y0, y1), max(x0, x1), max(y0, y1)) * dm
            a = page.add_rect_annot(r) if kind == "rect" else page.add_circle_annot(r)
            if self.lib.settings.get("shape_fill"):
                a.set_colors(stroke=col, fill=hex_to_rgb01(mix(self.lib.settings["color"], "#FFFFFF", 0.8)))
            else:
                a.set_colors(stroke=col)
        else:
            a = page.add_line_annot(self.fitz.Point(x0, y0) * dm, self.fitz.Point(x1, y1) * dm)
            a.set_colors(stroke=col)
            if kind == "arrow":
                a.set_line_ends(0, self.fitz.PDF_ANNOT_LE_OPEN_ARROW)
        a.set_border(width=2)
        self._finish_annot(a, "")
        self._commit_edit(fi, g)

    def erase_marks(self, g, rect, only=None):
        """Remove every mark that touches the area (Ctrl+Z brings them back). 3.0: a click removes only the mark
        clicked (not its neighbours), and a watermark is never removed by the eraser."""
        x0, y0, x1, y1 = rect
        hits = [m for m in self.marks_by_g.get(g, [])
                if not (m["bbox"][2] < x0 or m["bbox"][0] > x1 or m["bbox"][3] < y0 or m["bbox"][1] > y1)
                and ((m.get("card") or {}).get("kind") != "watermark" or only == m.get("xref"))
                and (only is None or m.get("xref") == only)]
        if not hits:
            return 0
        fi = self.book.pages[g][0]
        self._begin_edit(fi)
        page = self.book.page(g)
        xrefs = {m["xref"] for m in hits}
        for a in list(page.annots() or []):
            if a.xref in xrefs:
                page.delete_annot(a)
        self.sel_annot = None
        self._commit_edit(fi, g)
        self.set_status(f"Removed {len(hits)} mark(s).  Ctrl+Z to undo.")
        self._toast(f"{len(hits)} mark{'s' if len(hits) != 1 else ''} removed", action=("Undo", self.undo))
        return len(hits)

    def whiteout(self, g, p0, p1):
        """Remove the PDF's own text (and drawings) in an area - for real, not just covered."""
        fi = self._require_pdf(g)
        if fi is None:
            return
        r = self.fitz.Rect(min(p0[0], p1[0]), min(p0[1], p1[1]), max(p0[0], p1[0]), max(p0[1], p1[1]))
        if r.width < 3 or r.height < 3:
            return
        if not self.lib.settings.get("whiteout_ok"):
            if not messagebox.askyesno(APP_NAME, "Erase for good removes the PDF's own text (and scanned writing) "
                                                 "in that area from the file itself - for private data.\n\nCtrl+Z "
                                                 "undoes it while BindLens is open; after that it can't come back."
                                                 "\n\nTo only HIDE text (and be able to remove it later), use the "
                                                 "White box or the White brush.\n\nContinue?"):
                return
            self.lib.settings["whiteout_ok"] = True
        self._begin_edit(fi)
        self.__dict__.setdefault("_full_next", set()).add(self.book.files[fi]["path"])
        page = self.book.page(g)
        page.add_redact_annot(r * page.derotation_matrix, fill=(1, 1, 1))
        try:
            page.apply_redactions(images=2, graphics=0)       # 3.1: scanned writing too (the picture's pixels)
        except TypeError:
            page.apply_redactions(images=0)
        self.words_cache.pop(g, None)
        self._commit_edit(fi, g)
        self.set_status("Text erased from the PDF for good.  Ctrl+Z undoes it while BindLens is open.")

    # ---- 3.1: hide the PDF's own text with white - a mark you can move or remove whenever you want ----------
    def add_cover(self, g, p0, p1):
        fi = self._require_pdf(g)
        if fi is None:
            return
        r = self.fitz.Rect(min(p0[0], p1[0]), min(p0[1], p1[1]), max(p0[0], p1[0]), max(p0[1], p1[1]))
        if r.width < 3 or r.height < 3:
            return
        self._begin_edit(fi)
        page = self.book.page(g)
        a = page.add_rect_annot(r * page.derotation_matrix)
        a.set_colors(stroke=(1, 1, 1), fill=(1, 1, 1))
        a.set_border(width=0)
        lock_annot(self.fitz, a, {"cover": "box"})
        self._commit_edit(fi, g)
        self.set_status("Text hidden with a white box - click the box to move it, Delete removes it.")

    def add_brush(self, g, pts):
        fi = self._require_pdf(g)
        if fi is None or not pts:
            return
        if len(pts) == 1:
            pts = [pts[0], (pts[0][0] + 0.5, pts[0][1])]
        self._begin_edit(fi)
        page = self.book.page(g)
        dm = page.derotation_matrix
        a = page.add_ink_annot([[tuple(self.fitz.Point(p) * dm) for p in pts]])
        a.set_colors(stroke=(1, 1, 1))
        a.set_border(width=float(self.lib.settings.get("brush_w", 16)))
        lock_annot(self.fitz, a, {"cover": "brush"})
        self._commit_edit(fi, g)
        self.set_status("Text hidden with the white brush - click the paint later to delete it (Delete).")

    def cover_for_good(self, g, xref):
        """A white box / brush made permanent: the PDF's text under it is erased for good, the mark goes."""
        m = self._mark(g, xref)
        if not m:
            return
        if not messagebox.askyesno(APP_NAME, "Erase the PDF's own text under it for good? (private data)\n\n"
                                             "Ctrl+Z undoes it while BindLens is open; after that it can't come "
                                             "back."):
            return
        fi = self.book.pages[g][0]
        self._begin_edit(fi)
        self.__dict__.setdefault("_full_next", set()).add(self.book.files[fi]["path"])
        page = self.book.page(g)
        try:
            a = page.load_annot(xref)
            rects = annot_rects(a) if a.type[1] == "Ink" else [a.rect]
            if a.type[1] == "Ink":
                w_ = float((a.border or {}).get("width") or 16) / 2
                rects = []
                for stroke in a.vertices or []:
                    for q in stroke:
                        rects.append(self.fitz.Rect(q[0] - w_, q[1] - w_, q[0] + w_, q[1] + w_))
            page.delete_annot(a)
            for r in rects:
                page.add_redact_annot(self.fitz.Rect(r), fill=(1, 1, 1))
            try:
                page.apply_redactions(images=2, graphics=0)
            except TypeError:
                page.apply_redactions(images=0)
        except Exception as ex:
            if self.undo_stack:
                self.undo_stack.pop()
            self.book.reopen(fi)
            messagebox.showerror(APP_NAME, f"Could not erase it:\n{ex}")
            return
        self.words_cache.pop(g, None)
        self._commit_edit(fi, g)
        self.set_status("The text under it is erased for good.  Ctrl+Z undoes it while BindLens is open.")

    def resize_annot(self, g, xref, rect):
        m = self._mark(g, xref)
        if not m:
            return
        r = self.fitz.Rect(rect)
        r.normalize()
        if r.width < 12 or r.height < 10:
            return
        if m.get("cover") == "edit":
            self._et_redo_mark(g, xref, rect=r)
            return
        if m["kind"] == "FreeText":
            xref = self._convert_legacy(g, xref)
            m = self._mark(g, xref)
            if not m:
                return
        if m.get("card"):
            self._resize_card(g, xref, m, r)
            return
        fi = self.book.pages[g][0]
        self._begin_edit(fi)
        page, a = self._load_annot(g, xref)
        if a is None:
            return
        a.set_rect(r * page.derotation_matrix)
        a.update()
        self._commit_edit(fi, g)

    # ---- changing / deleting marks
    def _load_annot(self, g, xref):
        page = self.book.page(g)
        for a in page.annots() or []:
            if a.xref == xref:
                return page, a
        return page, None

    def delete_selected_annot(self):
        if not self.sel_annot or not self.book:
            return
        g, xref = self.sel_annot
        fi = self.book.pages[g][0]
        self._begin_edit(fi)
        page, a = self._load_annot(g, xref)
        if a is None:
            return
        page.delete_annot(a)
        self.sel_annot = None
        self._commit_edit(fi, g)
        self.set_status("Mark deleted.  Ctrl+Z to undo.")
        self._toast("Mark deleted", action=("Undo", self.undo))          # 3.0

    def recolor_annot(self, g, xref, color):
        fi = self.book.pages[g][0]
        page, a = self._load_annot(g, xref)
        if a is None:
            return
        if a.type[1] == "FreeText":
            xref = self._convert_legacy(g, xref)
            page, a = self._load_annot(g, xref)
            if a is None:
                return
        card = self._card_spec(a) if a.type[1] == "Stamp" else None
        if card:
            if card.get("kind") in ("note", "stamp", "watermark", "box"):
                self._replace_card(g, xref, dict(card, color=color, color_set=1))
                if card.get("kind") == "box":
                    self.set_color(color)
            return
        else:
            self._begin_edit(fi)
            rgb = hex_to_rgb01(color)
            if a.type[1] in ("Square", "Circle") and a.colors.get("fill"):
                a.set_colors(stroke=rgb, fill=rgb)
            else:
                a.set_colors(stroke=rgb)
            a.update()
        self.set_color(color)
        self._commit_edit(fi, g)

    def edit_annot_note(self, g, xref):
        fi = self.book.pages[g][0]
        page, a = self._load_annot(g, xref)
        if a is None:
            return
        if a.type[1] == "FreeText":
            self.edit_text_box(g, xref)
            return
        cur = annot_meta(a).get("note", "")
        if a.type[1] == "Text":
            res = self._note_dialog(cur, annot_color(a))
            if not res:
                return
            new, color = res
        else:
            new, color = self._ask_text("Note", cur), None
            if new is None:
                return
        self._begin_edit(fi)
        page, a = self._load_annot(g, xref)
        if color:
            a.set_colors(stroke=hex_to_rgb01(color))
        lock_annot(self.fitz, a, {"note": new} if new else {})
        self._commit_edit(fi, g)

    def edit_text_box(self, g, xref):
        """Old (BindLens 1.x) text box: make it a 1.6 text box, then type in it on the page."""
        page, a = self._load_annot(g, xref)
        if a is None:
            return
        if a.type[1] == "FreeText":
            xref = self._convert_legacy(g, xref)
        self.edit_box_inline(g, xref)

    def move_annot(self, g, xref, dx, dy):
        fi = self.book.pages[g][0]
        page, a = self._load_annot(g, xref)
        if a is None:
            return
        self._begin_edit(fi)
        page, a = self._load_annot(g, xref)
        rd = self.fitz.Rect(a.rect) * page.rotation_matrix
        rd = self.fitz.Rect(rd.x0 + dx, rd.y0 + dy, rd.x1 + dx, rd.y1 + dy)
        if a.type[1] == "FreeText" and annot_meta(a).get("cover") == "edit":
            meta = annot_meta(a)
            page.delete_annot(a)
            a2 = self._et_freetext(page, rd, meta)
            self.sel_annot = (g, a2.xref)
        elif a.type[1] == "FreeText":
            spec = self._legacy_box_spec(a)
            page.delete_annot(a)
            pad = card_pad(spec)
            a2 = self._make_card(page, spec, topleft=(rd.x0 - pad, rd.y0 - pad))
            self.sel_annot = (g, a2.xref)
        else:
            meta = annot_meta(a)
            a.set_rect(rd * page.derotation_matrix)
            meta.pop("legacy", None)
            lock_annot(self.fitz, a, meta)
        self._commit_edit(fi, g)

    # ========================================================= text / words
    def _words(self, g):
        if g in self.words_cache:
            self.words_cache.move_to_end(g)
            return self.words_cache[g]
        out = []
        try:
            page = self.book.page(g)
            m = page.rotation_matrix
            for x0, y0, x1, y1, word, b, l, _n in page.get_text("words"):
                r = self.fitz.Rect(x0, y0, x1, y1) * m
                out.append((r.x0, r.y0, r.x1, r.y1, word, b, l))
            if not out:                                      # 3.2: a scanned page - the words BindLens read
                f_ = self.book.files[self.book.pages[g][0]]
                ws = ocr_cached_words(f_["path"], page) if f_.get("pdf") or not is_outside(f_["path"]) else None
                if ws:
                    ln, last_y = 0, None
                    for x0, y0, x1, y1, word in sorted(ws, key=lambda w_: ((w_[1] + w_[3]) / 2, w_[0])):
                        yc = (y0 + y1) / 2
                        if last_y is not None and abs(yc - last_y) > (y1 - y0) * 0.6:
                            ln += 1
                        last_y = yc
                        r = self.fitz.Rect(x0, y0, x1, y1) * m
                        out.append((r.x0, r.y0, r.x1, r.y1, word, 0, ln))
                elif ws is None and not getattr(self, "_scan_asked", False) and is_scanned_page(page) and \
                        not self._tessdata() and self.lib.settings.get("read_scans", True):
                    self._scan_asked = True
                    self.root.after(600, lambda: self._toast(
                        "This page is scanned. BindLens can read scanned pages (search, select, reports).",
                        ms=12000, action=("Read them", self._scan_enable)))
        except Exception:
            pass
        self.words_cache[g] = out
        while len(self.words_cache) > 200:
            self.words_cache.popitem(last=False)
        return out

    def _nearest_word(self, words, px, py):
        best, bd = None, 1e18
        for i, w in enumerate(words):
            d = max(w[0] - px, 0, px - w[2]) + max(w[1] - py, 0, py - w[3]) * 3
            if d < bd:
                best, bd = i, d
        return best, bd

    def _make_selection(self, g, p0, p1):
        words = self._words(g)
        i0, d0 = self._nearest_word(words, *p0) if words else (None, 1e9)
        if i0 is None or d0 > 25:
            x0, x1 = sorted((p0[0], p1[0]))
            y0, y1 = sorted((p0[1], p1[1]))
            if x1 - x0 < 4 or y1 - y0 < 4:
                return None
            return {"g": g, "rects": [(x0, y0, x1, y1)], "text": "", "area": True}
        i1, _ = self._nearest_word(words, *p1)
        a, b = sorted((i0, i1))
        lines = OrderedDict()
        for w in words[a:b + 1]:
            k = (w[5], w[6])
            if k in lines:
                r, t = lines[k]
                lines[k] = ((min(r[0], w[0]), min(r[1], w[1]), max(r[2], w[2]), max(r[3], w[3])), t + [w[4]])
            else:
                lines[k] = ((w[0], w[1], w[2], w[3]), [w[4]])
        return {"g": g, "rects": [v[0] for v in lines.values()],
                "text": "\n".join(" ".join(v[1]) for v in lines.values()), "area": False}

    # ======================================================= mouse on pages
    def _annot_at(self, e):
        hit = self._event_to_page(e)
        if not hit:
            return None
        g, px, py = hit
        tol = max(2.5, 4 / self.zoom)
        for m in reversed(self.marks_by_g.get(g, [])):
            if (m.get("card") or {}).get("kind") == "watermark":
                continue
            rects = m["rects"]
            if m["kind"] in ("Ink", "Line"):
                rects = [m["bbox"]]
            for r in rects:
                if r[0] - tol <= px <= r[2] + tol and r[1] - tol <= py <= r[3] + tol:
                    return m
        return None

    RESIZABLE = ("FreeText", "Square", "Circle", "Stamp")
    MOVABLE = ("FreeText", "Text", "Square", "Circle", "Stamp")

    def _handle_hit(self, e):
        """Is the mouse on the resize corner of the selected mark?"""
        if not self.sel_annot:
            return None
        m = self._mark(*self.sel_annot)
        if not m or m["kind"] not in self.RESIZABLE:
            return None
        a, b, c2, d = self._to_canvas(m["g"], m["bbox"])
        x, y = self.canvas.canvasx(e.x), self.canvas.canvasy(e.y)
        return m if abs(x - (c2 + 4)) <= 9 and abs(y - (d + 4)) <= 9 else None

    def _rotate_hit(self, e):
        """Is the mouse on the round 'turn' handle above the selected note / stamp / text box?"""
        if not self.sel_annot:
            return None
        m = self._mark(*self.sel_annot)
        if not m or not m.get("card") or m["card"].get("kind") == "watermark":
            return None
        a, b, c2, d = self._to_canvas(m["g"], m["bbox"])
        x, y = self.canvas.canvasx(e.x), self.canvas.canvasy(e.y)
        return m if abs(x - (a + c2) / 2) <= 10 and abs(y - (b - 26)) <= 10 else None

    def _on_press(self, e):
        if self._over_ui(e):
            self.drag = None
            return
        if getattr(self, "_ed", None):
            self._close_box_editor(save=True)
            self.drag = None
            return
        self.canvas.focus_set()
        self._hide_tip()
        self._close_float()
        hit = self._event_to_page(e)
        t = self.tool
        st = self.lib.settings
        if getattr(self, "page_lefts", None) is not None and t == "select":
            # 4.2: in the grid of pages (zoomed right out / a gallery of pictures) a click opens that page
            self.drag = {"mode": "gridpick", "g": hit[0] if hit else None, "x": e.x, "y": e.y}
            return
        if t == "edittext":                             # 4.0: change the document's own text
            if hit:
                self.edit_text_at(*hit)
            self.drag = None
            return
        if t == "pen" or (t == "eraser" and st.get("erase") == "brush"):
            if hit:
                self.drag = {"mode": "pen", "g": hit[0], "pts": [(hit[1], hit[2])], "last": (e.x, e.y),
                             "brush": t == "eraser"}
            return
        if t in ("note", "stamp") or (t == "shapes" and st.get("shape") == "separator"):
            if hit:
                g, px, py = hit
                if t == "note":
                    self.add_note(g, px, py)
                elif t == "stamp":
                    self.add_stamp(g, px, py)
                else:
                    self.add_line(g, py)
            return
        if t in ("text", "shapes") or (t == "eraser" and st.get("erase") in ("whiteout", "cover")):
            if hit:
                self.drag = {"mode": "box", "g": hit[0], "p0": (hit[1], hit[2]), "x": e.x, "y": e.y, "moved": False}
            return
        if t == "eraser":
            m = self._annot_at(e)
            if m:
                self.erase_marks(m["g"], m["bbox"], only=m.get("xref"))
                return
            if hit:
                self.drag = {"mode": "box", "g": hit[0], "p0": (hit[1], hit[2]), "x": e.x, "y": e.y, "moved": False}
            return
        if t == "select":
            wh = self._widget_at(e)
            if wh:
                self.fill_field(e, wh)
                self.drag = None
                return
        rm_ = self._rotate_hit(e)
        if rm_:
            a, b, c2, d = self._to_canvas(rm_["g"], rm_["bbox"])
            cx, cy = (a + c2) / 2, (b + d) / 2
            import math
            x, y = self.canvas.canvasx(e.x), self.canvas.canvasy(e.y)
            self.drag = {"mode": "rotate", "g": rm_["g"], "xref": rm_["xref"], "bbox": rm_["bbox"], "x": e.x, "y": e.y,
                         "moved": False, "c": (cx, cy), "a0": math.degrees(math.atan2(x - cx, cy - y)),
                         "ang": float(rm_["card"].get("angle", 0)), "card": rm_["card"]}
            return
        hm = self._handle_hit(e)
        if hm:
            self.drag = {"mode": "resize", "g": hm["g"], "xref": hm["xref"], "bbox": hm["bbox"], "x": e.x,
                         "y": e.y, "moved": False}
            return
        m = self._annot_at(e)
        if m:
            self.sel_annot = (m["g"], m["xref"])
            self.sel = None
            self.drag = {"mode": "move", "g": m["g"], "xref": m["xref"], "x": e.x, "y": e.y, "moved": False,
                         "kind": m["kind"], "bbox": m["bbox"]}
            self.redraw()
            return
        if self.sel or self.sel_annot:
            self.sel = None
            self.sel_annot = None
            self.redraw()
        if hit:
            self.drag = {"mode": "select", "g": hit[0], "p0": (hit[1], hit[2]), "x": e.x, "y": e.y, "moved": False}
        else:
            self.drag = None

    def _on_drag(self, e):
        d = self.drag
        if not d:
            return
        c = self.canvas
        if d["mode"] == "pen":
            hit = self._event_to_page(e, clamp_g=d["g"])
            d["pts"].append((hit[1], hit[2]))
            lx, ly = d["last"]
            if d.get("brush"):                   # 3.1: the white brush
                c.create_line(c.canvasx(lx), c.canvasy(ly), c.canvasx(e.x), c.canvasy(e.y), fill="#FFFFFF",
                              width=max(3, float(self.lib.settings.get("brush_w", 16)) * self.zoom),
                              capstyle="round", joinstyle="round", tags="pen")
            else:
                c.create_line(c.canvasx(lx), c.canvasy(ly), c.canvasx(e.x), c.canvasy(e.y),
                              fill=self.lib.settings["color"], width=max(2, 2 * self.zoom), capstyle="round",
                              tags="pen")
            d["last"] = (e.x, e.y)
            return
        if not d["moved"] and abs(e.x - d["x"]) + abs(e.y - d["y"]) < 5:
            return
        d["moved"] = True
        c.delete("ghost")
        A, col = self.accent, self.lib.settings["color"]
        if d["mode"] == "move":
            if d["kind"] not in self.MOVABLE:
                return
            a, b, c2, dd = self._to_canvas(d["g"], d["bbox"])
            dx, dy = e.x - d["x"], e.y - d["y"]
            c.create_rectangle(a + dx, b + dy, c2 + dx, dd + dy, outline=A, dash=(4, 3), width=2, tags="ghost")
            return
        if d["mode"] == "resize":
            a, b, c2, dd = self._to_canvas(d["g"], d["bbox"])
            c.create_rectangle(a, b, c2 + e.x - d["x"], dd + e.y - d["y"], outline=A, dash=(4, 3), width=2,
                               tags="ghost")
            return
        if d["mode"] == "rotate":
            import math
            cx, cy = d["c"]
            x, y = c.canvasx(e.x), c.canvasy(e.y)
            ang = d["ang"] + math.degrees(math.atan2(x - cx, cy - y)) - d["a0"]
            ang = ((ang + 180) % 360) - 180
            if abs(ang) < 3:
                ang = 0
            elif not (e.state & 0x0001):                 # Shift = free, otherwise steps of 5°
                ang = round(ang / 5) * 5
            d["new"] = ang
            card = d["card"]
            w = float(card.get("w", 150)) * self.zoom
            h = float(card.get("h", 100)) * self.zoom
            r = math.radians(ang)
            pts = []
            for px_, py_ in ((-w / 2, -h / 2), (w / 2, -h / 2), (w / 2, h / 2), (-w / 2, h / 2)):
                pts += [cx + px_ * math.cos(r) - py_ * math.sin(r), cy + px_ * math.sin(r) + py_ * math.cos(r)]
            c.create_polygon(pts, outline=A, fill="", dash=(4, 3), width=2, tags="ghost")
            c.create_line(cx, cy, x, y, fill=A, width=1, dash=(2, 2), tags="ghost")
            c.create_text(x + 16, y - 14, text=f"{ang:g}°", fill=A, font=UI_FONT_B, tags="ghost")
            return
        if d["mode"] == "box":
            _, px, py = self._event_to_page(e, clamp_g=d["g"])
            d["p1"] = (px, py)
            x0, y0 = c.canvasx(d["x"]), c.canvasy(d["y"])
            x1, y1 = c.canvasx(e.x), c.canvasy(e.y)
            t, st = self.tool, self.lib.settings
            if t == "shapes":
                shp = st.get("shape", "rect")
                if str(shp).startswith("w:"):
                    rr = self.fitz.Rect(min(x0, x1), min(y0, y1), max(x0, x1), max(y0, y1))
                    pts = shape_points(shp[2:], rr)
                    sc = self.lib.settings.get("shape_card", {})
                    fill = sc.get("color", "#FFFFFF")
                    kw = dict(outline=sc.get("bc", "#1F1F1F"), width=2, tags="ghost",
                              fill="" if fill == "none" else fill)
                    if pts:
                        c.create_polygon(*[v for pt in pts for v in pt], **kw)
                    elif shp == "w:s_ellipse":
                        c.create_oval(rr.x0, rr.y0, rr.x1, rr.y1, **kw)
                    else:
                        c.create_rectangle(rr.x0, rr.y0, rr.x1, rr.y1, **kw)
                elif shp == "rect":
                    c.create_rectangle(x0, y0, x1, y1, outline=col, width=2, tags="ghost")
                elif shp == "ellipse":
                    c.create_oval(x0, y0, x1, y1, outline=col, width=2, tags="ghost")
                else:
                    c.create_line(x0, y0, x1, y1, fill=col, width=2, tags="ghost",
                                  arrow="last" if shp == "arrow" else None)
            elif t == "eraser":
                if st.get("erase") == "cover":
                    c.create_rectangle(x0, y0, x1, y1, fill="white", outline="#9AA0A6", dash=(3, 3), tags="ghost")
                elif st.get("erase") == "whiteout":
                    c.create_rectangle(x0, y0, x1, y1, fill="white", outline="#B3261E", dash=(4, 3), tags="ghost")
                else:
                    c.create_rectangle(x0, y0, x1, y1, outline="#B3261E", dash=(4, 3), width=2, tags="ghost")
            else:
                c.create_rectangle(x0, y0, x1, y1, outline=A, dash=(4, 3), width=2, tags="ghost")
            return
        h = c.winfo_height()
        if e.y > h - 15:
            c.yview_scroll(18, "units")
        elif e.y < 15:
            c.yview_scroll(-18, "units")
        _, px, py = self._event_to_page(e, clamp_g=d["g"])
        self.sel = self._make_selection(d["g"], d["p0"], (px, py))
        self.redraw()

    def _on_release(self, e):
        d = self.drag
        self.drag = None
        if not d:
            return
        if d["mode"] == "gridpick":
            if d["g"] is not None and abs(e.x - d["x"]) + abs(e.y - d["y"]) < 8:
                self._grid_open(d["g"])
            return
        self.canvas.delete("ghost")
        if d["mode"] == "pen":
            self.canvas.delete("pen")
            if d.get("brush"):
                self.add_brush(d["g"], d["pts"])
            else:
                self.add_ink(d["g"], d["pts"])
            return
        if d["mode"] == "move":
            if d["moved"] and d["kind"] in self.MOVABLE:
                self.move_annot(d["g"], d["xref"], (e.x - d["x"]) / self.zoom, (e.y - d["y"]) / self.zoom)
            return
        if d["mode"] == "rotate":
            if d["moved"] and "new" in d:
                self.rotate_card(d["g"], d["xref"], d["new"], absolute=True)
            return
        if d["mode"] == "resize":
            if d["moved"]:
                x0, y0, x1, y1 = d["bbox"]
                self.resize_annot(d["g"], d["xref"], (x0, y0, x1 + (e.x - d["x"]) / self.zoom,
                                                      y1 + (e.y - d["y"]) / self.zoom))
            return
        if d["mode"] == "box":
            g, p0 = d["g"], d["p0"]
            p1 = d.get("p1", p0)
            t, st = self.tool, self.lib.settings
            if t == "shapes" and str(st.get("shape", "")).startswith("w:"):
                look = st["shape"][2:]
                x0, x1 = sorted((p0[0], p1[0]))
                y0, y1 = sorted((p0[1], p1[1]))
                if not d["moved"] or x1 - x0 < 24 or y1 - y0 < 16:
                    wd, ht = (130, 130) if look in ("s_ellipse", "s_star", "s_diamond") else (170, 90)
                    x0, y0, x1, y1 = p0[0], p0[1], p0[0] + wd, p0[1] + ht
                spec = self._shape_default(look)
                spec["minh"] = y1 - y0
                pad = card_pad(spec)
                self.start_box_editor(g, x0 + pad, y0 + pad, width=x1 - x0, spec=spec)
            elif t == "shapes":
                self.add_shape(g, st.get("shape", "rect"), p0, p1)
            elif t == "eraser":
                if st.get("erase") == "cover":
                    self.add_cover(g, p0, p1)
                elif st.get("erase") == "whiteout":
                    self.whiteout(g, p0, p1)
                elif d["moved"]:
                    r = (min(p0[0], p1[0]), min(p0[1], p1[1]), max(p0[0], p1[0]), max(p0[1], p1[1]))
                    if not self.erase_marks(g, r):
                        self.set_status("Nothing to erase there.")
            elif t == "text":
                if d["moved"] and abs(p1[0] - p0[0]) > 20:
                    x0, x1 = sorted((p0[0], p1[0]))
                    self.start_box_editor(g, x0, min(p0[1], p1[1]), width=x1 - x0)
                else:
                    self.start_box_editor(g, p0[0], p0[1])
            return
        if d["moved"] and self.sel:
            self.show_float(e.x_root, e.y_root)

    def _on_double(self, e):
        m = self._annot_at(e)
        if not m:
            hit = self._event_to_page(e)
            if hit and self.book and 0 <= hit[0] < self.book.total:
                f = self.book.files[self.book.pages[hit[0]][0]]
                if is_video(f["path"]):                      # 4.4: a video plays inside BindLens
                    self.play_video(f["path"])
                    return
                if is_outside(f["path"]):                    # a card for a .doc/.xls…: open it in its program
                    open_in_os(f["path"])
                    self.set_status(f"Opening {os.path.basename(f['path'])}…")
                    return
            if hit and self.tool == "select" and self.written_page(hit[0]):
                self.edit_written_page(hit[0])
            return
        if m.get("card"):
            self.edit_card(m["g"], m["xref"])
        elif m.get("cover") == "edit":
            self._et_reedit(m["g"], m["xref"])
        elif m["kind"] == "FreeText":
            self.edit_text_box(m["g"], m["xref"])
        elif m.get("cover"):
            return
        elif m["kind"] in ("Square", "Circle", "Line", "Ink"):
            self.palette_popup(None, lambda c: self.recolor_annot(m["g"], m["xref"], c), e.x_root, e.y_root)
        else:
            self.edit_annot_note(m["g"], m["xref"])

    def _on_right(self, e):
        if self._over_ui(e):
            return
        self._close_float()
        m = self._annot_at(e)
        menu = self._menu()
        hit_ = None if m else self._event_to_page(e)
        if hit_ and self.book and 0 <= hit_[0] < self.book.total:      # 4.4: a video - play it
            fv_ = self.book.files[self.book.pages[hit_[0]][0]]
            if is_video(fv_["path"]):
                menu.add_command(label="Play the video", command=lambda p_=fv_["path"]: self.play_video(p_))
                menu.add_command(label="Open it in my video player", command=lambda p_=fv_["path"]: open_in_os(p_))
                self._popup(menu, e)
                return
        if m:
            self.sel_annot = (m["g"], m["xref"])
            self.redraw()
            g, xref = m["g"], m["xref"]
            if m.get("cover") == "edit":            # 4.1: a changed text (a mark)
                menu.add_command(label="Change the words…", command=lambda: self._et_reedit(g, xref))
                menu.add_command(label="Make it final (in the document's own text)",
                                 command=lambda: self._et_make_final(g, xref))
                menu.add_separator()
                menu.add_command(label="Delete (the old words come back)", command=self.delete_selected_annot)
                self._popup(menu, e)
                return
            if m.get("cover"):                      # 3.1: a white box / brush hiding the PDF's text
                menu.add_command(label="Erase the text under it for good…", command=lambda: self.cover_for_good(
                    g, xref))
                menu.add_separator()
                menu.add_command(label="Delete (show the text again)", command=self.delete_selected_annot)
                self._popup(menu, e)
                return
            menu.add_command(label="Colour…", command=lambda: self.palette_popup(
                None, lambda c: self.recolor_annot(g, xref, c), e.x_root, e.y_root))
            if m.get("card"):
                if m["card"].get("kind") in ("note", "stamp", "sign", "box"):
                    menu.add_command(label="Edit…", command=lambda: self.edit_card(g, xref))
                menu.add_command(label="Rotate left   [", command=lambda: self.rotate_card(g, xref, -10))
                menu.add_command(label="Rotate right   ]", command=lambda: self.rotate_card(g, xref, 10))
                menu.add_command(label="Straighten", command=lambda: self.rotate_card(g, xref, 0))
                if m["card"].get("kind") == "stamp" and m["card"].get("style") == "symbol":
                    cm = self._menu(menu)
                    for key, (name, glyph, col) in SYMBOLS.items():
                        cm.add_command(label=f"{glyph}   {name}", foreground=col, command=lambda key=key: (
                            self._replace_card(g, xref, dict(m["card"], sym=key, text=SYMBOLS[key][0],
                                                             color=SYMBOLS[key][2]))))
                    menu.add_cascade(label="Change to", menu=cm)
                elif m["card"].get("kind") == "stamp":
                    menu.add_command(label="Save in My stamps",
                                     command=lambda: self._my_stamp_save(m["card"]) and None)
            elif m["kind"] == "FreeText":
                menu.add_command(label="Edit…", command=lambda: self.edit_text_box(g, xref))
            elif m["kind"] not in ("Square", "Circle", "Line", "Ink"):
                menu.add_command(label="Edit note…" if m["note"] else "Add note…",
                                 command=lambda: self.edit_annot_note(g, xref))
            if m["text"] and m["kind"] in MARKUP:
                menu.add_command(label="Copy text", command=lambda: self._copy(m["text"]))
            elif m["kind"] == "FreeText" and m["note"]:
                menu.add_command(label="Copy text", command=lambda: self._copy(m["note"]))
            menu.add_separator()
            menu.add_command(label="Delete", command=self.delete_selected_annot)
        else:
            hit = self._event_to_page(e)
            if self.sel:
                sl = self.sel
                menu.add_command(label="Highlight", command=lambda: self.add_markup("highlight", sel=sl))
                menu.add_command(label="Underline", command=lambda: self.add_markup("underline", sel=sl))
                menu.add_command(label="Strike through", command=lambda: self.add_markup("strike", sel=sl))
                if sl.get("text"):
                    menu.add_command(label="Copy", command=self.copy_selection)
                menu.add_separator()
            if hit:
                g, px, py = hit
                try:                                   # 3.3: a Word / PowerPoint / Excel file not shown as it looks yet
                    pth_ = self.book.files[self.book.pages[g][0]]["path"]
                    if os.path.splitext(pth_)[1].lower() in OFFICE_EXACT and not office_pdf_ready(pth_):
                        menu.add_command(label="Show it here as it looks (ask Office now)",
                                         command=lambda p_=pth_: self._office_now(p_))
                        menu.add_separator()
                except Exception:
                    pass
                menu.add_command(label="Sticky note here…", command=lambda: self.add_note(g, px, py))
                menu.add_command(label="Text here…", command=lambda: self._text_here(g, px, py))
                ws_ = self._words(g)
                if ws_:                                 # 4.1: read aloud from the word you clicked
                    wi, wd = self._nearest_word(ws_, px, py)
                    if wi is not None and wd < 40:
                        menu.add_command(label="Read aloud from here", command=lambda: self.read_aloud(g, start=wi))
                    menu.add_command(label="Edit this line of text  (Ctrl+E)", command=lambda: self.edit_text_at(g, px, py))
                sm = self._menu(menu)
                for name, col in STAMPS:
                    sm.add_command(label=name, foreground=col,
                                   command=lambda n=name: (self.lib.settings.__setitem__("stamp", n),
                                                           self.add_stamp(g, px, py)))
                menu.add_cascade(label="Stamp here", menu=sm)
                qm = self._menu(menu)                  # 3.2: ticks and crosses
                for key, (name, glyph, col) in SYMBOLS.items():
                    qm.add_command(label=f"{glyph}   {name}", foreground=col,
                                   command=lambda key=key: self.add_card(g, px, py, self._symbol_spec(key)))
                menu.add_command(label="✓  Tick here", foreground="#1E8E3E",
                                 command=lambda: self.add_card(g, px, py, self._symbol_spec("tick")))
                menu.add_command(label="✗  Cross here", foreground="#D93025",
                                 command=lambda: self.add_card(g, px, py, self._symbol_spec("cross")))
                menu.add_cascade(label="Other quick marks here", menu=qm)
                menu.add_command(label="Separator line here", command=lambda: self.add_line(g, py))
                menu.add_command(label="Watermark…", command=self.watermark_dialog)
                menu.add_separator()
                pm = self._menu(menu)
                if self.written_page(g):
                    menu.add_command(label="Edit this page…", command=lambda g=g: self.edit_written_page(g))
                pm.add_command(label="Write a new page after this one…",
                               command=lambda g=g: (self.goto_page(g), self.write_page()))
                nb = self._menu(pm)
                for key, lab in self.PAPERS:
                    nb.add_command(label=lab, command=lambda k=key, g=g: (self.goto_page(g), self.insert_paper(k)))
                pm.add_cascade(label="Add an empty page after this one", menu=nb)
                pm.add_command(label="Turn left", command=lambda g=g: (self.goto_page(g), self.rotate_page(-90)))
                pm.add_command(label="Turn right", command=lambda g=g: (self.goto_page(g), self.rotate_page(90)))
                pm.add_command(label="Delete this page…", command=lambda g=g: (self.goto_page(g), self.delete_page()))
                pm.add_command(label="Save pages as a new PDF…",
                               command=lambda g=g: (self.goto_page(g), self.extract_pages()))
                menu.add_cascade(label="Page", menu=pm)
                menu.add_command(label="Remind me about this page…", command=lambda g=g: self.add_reminder(g))
            if not hit and not self.sel:
                return
        self._popup(menu, e)

    def _text_here(self, g, px, py):
        self.start_box_editor(g, px, py)

    def _on_motion(self, e):
        if self.drag:
            return
        if getattr(self, "_reading", False) and e.y < 64 and \
                time.time() > getattr(self, "_read_peek_until", 0) - 1.5:
            self._read_peek(2.5)
        if self.tool == "edittext":                      # 4.0: the line that would open for typing
            now = time.time()
            if now - getattr(self, "_et_hov_t", 0) > 0.06:
                self._et_hov_t = now
                self._et_hover(e)
            return
        if self.tool == "select" and self._widget_at(e):
            self.canvas.config(cursor="xterm")
            return
        if self.tool == "select" and self._handle_hit(e):
            self.canvas.config(cursor="size_nw_se" if os.name == "nt" else "bottom_right_corner")
            return
        if self.tool == "select" and self._rotate_hit(e):
            self.canvas.config(cursor="exchange")
            return
        m = self._annot_at(e)
        if m:
            if self.tool == "select":
                self.canvas.config(cursor="fleur" if m["kind"] in self.MOVABLE else "hand2")
            tip = m["note"] if m["kind"] != "FreeText" else ""
            if tip:
                self._show_tip(e, tip)
            else:
                self._hide_tip()
        else:
            if self.tool == "select":
                self.canvas.config(cursor="")
            self._hide_tip()

    def _show_tip(self, e, text):
        T = self.T
        if self._tip is None:
            self._tip = tk.Toplevel(self.root)
            self._tip.wm_overrideredirect(True)
            self._tip_lbl = tk.Label(self._tip, justify="left", wraplength=320, padx=10, pady=7, font=UI_FONT_S)
            self._tip_lbl.pack()
        self._tip_lbl.config(text=text, bg=T["panel"], fg=T["text"], highlightthickness=1,
                             highlightbackground=T["border"])
        self._tip.wm_geometry(f"+{e.x_root + 16}+{e.y_root + 14}")
        self._tip.deiconify()

    def _hide_tip(self):
        if self._tip is not None:
            self._tip.withdraw()

    # ---- floating toolbar after selecting text
    def show_float(self, x, y):
        """Small rounded bar next to the selected text: colours, U, S, note, copy."""
        self._close_float()
        T, st = self.T, self.lib.settings
        sel = self.sel

        def build(f):
            for c in st.get("recent", [])[:5]:
                cv = tk.Canvas(f, width=26, height=28, bg=T["panel"], highlightthickness=0, cursor="hand2")
                cv.pack(side="left")
                cv.create_oval(4, 5, 22, 23, fill=c, outline=mix(c, "#000000", 0.2), tags="dot")
                cv.bind("<Enter>", lambda e, cv=cv: cv.coords("dot", 2, 3, 24, 25))
                cv.bind("<Leave>", lambda e, cv=cv: cv.coords("dot", 4, 5, 22, 23))
                cv.bind("<Button-1>", lambda e, c=c: self.add_markup("highlight", c, sel))
            more = tk.Canvas(f, width=26, height=28, bg=T["panel"], highlightthickness=0, cursor="hand2")
            more.pack(side="left")
            more.create_oval(4, 5, 22, 23, outline=T["border"], width=1.5)
            draw_icon(more, "plus", 13, 14, T["muted"], s=0.5)
            more.bind("<Button-1>", lambda e: self.palette_popup(more, lambda c: self.add_markup("highlight", c, sel)))
            tk.Frame(f, width=1, height=20, bg=T["border"]).pack(side="left", padx=8)

            def word(text, cmd, font):
                lb = tk.Label(f, text=text, bg=T["panel"], fg=T["text"], cursor="hand2", font=font, padx=7, pady=3)
                lb.pack(side="left")
                lb.bind("<Enter>", lambda e: lb.configure(bg=T["hover"]))
                lb.bind("<Leave>", lambda e: lb.configure(bg=T["panel"]))
                lb.bind("<Button-1>", lambda e: cmd())
            word("U", lambda: self.add_markup("underline", None, sel), self.F(11, "underline"))
            word("S", lambda: self.add_markup("strike", None, sel), self.F(11, "overstrike"))
            word("Note", lambda: self.add_markup("highlight", None, sel, ask_note=True), self.F(10))
            if sel and sel.get("text"):
                word("Copy", lambda: (self.copy_selection(), self._close_float()), self.F(10))
        tmp = rounded_popup(self, -2000, -2000, build, radius=18)
        tmp.update_idletasks()
        ww = tmp.winfo_reqwidth()
        tmp.geometry(f"+{max(0, x - ww // 2)}+{y + 16}")
        self._float = tmp

    def _close_palette(self):
        p = getattr(self, "_pal", None)
        if p is not None:
            try:
                p.destroy()
            except Exception:
                pass
            self._pal = None

    def _close_float(self):
        self._close_palette()
        if self._float is not None:
            try:
                self._float.destroy()
            except Exception:
                pass
            self._float = None

    def copy_selection(self):
        if self.sel and self.sel.get("text"):
            self._copy(self.sel["text"])

    def _copy(self, text):
        self.root.clipboard_clear()
        self.root.clipboard_append(text)
        self.set_status("Copied.")

    # ================================================================ dialogs
    def _dialog(self, title):
        T = self.T
        d = tk.Toplevel(self.root)
        d.title(title)
        d.transient(self.root)
        d.configure(bg=T["panel"])
        d.resizable(True, True)                 # 4.1: every window can be moved and made bigger or smaller
        d.after(10, lambda: self._titlebar(d))
        return d

    def _scroll_body(self, d, bg=None):
        """4.1: the content of a window, inside a part that scrolls when the window is made smaller (mouse wheel or
        the slim bar). Returns the frame to build into; what is packed in the window after it (the buttons)
        stays visible at the bottom."""
        bg = bg or self.T["panel"]
        box = tk.Frame(d, bg=bg)
        box.pack(side="top", fill="both", expand=True)
        cv = tk.Canvas(box, bg=bg, highlightthickness=0, bd=0)
        bar = SlimBar(box, self, cv, width=12)
        bar.pack(side="right", fill="y")
        cv.pack(side="left", fill="both", expand=True)
        cv.configure(yscrollcommand=bar.set)
        inner = tk.Frame(cv, bg=bg)
        win = cv.create_window(0, 0, window=inner, anchor="nw")
        st = {"wh": None}

        def on_inner(_e=None):
            w, h = inner.winfo_reqwidth(), inner.winfo_reqheight()
            if (w, h) != st["wh"]:
                first = st["wh"] is None
                st["wh"] = (w, h)
                maxh = max(320, d.winfo_screenheight() - 170)
                if first or not getattr(d, "_user_sized", False):
                    cv.configure(width=w, height=min(h, maxh))
                cv.configure(scrollregion=(0, 0, max(w, cv.winfo_width()), h))

        def on_cv(e):
            cv.itemconfigure(win, width=max(e.width, inner.winfo_reqwidth()))
            cv.configure(scrollregion=(0, 0, max(e.width, inner.winfo_reqwidth()), inner.winfo_reqheight()))
        inner.bind("<Configure>", on_inner)
        cv.bind("<Configure>", on_cv)

        def wheel(e):
            if inner.winfo_reqheight() <= cv.winfo_height() + 2:
                return
            up = getattr(e, "delta", 0) > 0 or getattr(e, "num", 0) == 4
            cv.yview_scroll(-3 if up else 3, "units")
        self.wheel_route(d, wheel)
        d._sbox = box
        return inner

    def _scroll_fix(self, d):
        """What was packed after the scrolling part (the buttons) goes to the bottom, so it is never cut off."""
        box = getattr(d, "_sbox", None)
        if box is None or getattr(d, "_sfixed", False):
            return
        d._sfixed = True
        try:
            sl = d.pack_slaves()
            after = sl[sl.index(box) + 1:]
            for w_ in reversed(after):
                info = w_.pack_info()
                info.pop("in", None)
                info["side"] = "bottom"
                w_.pack_forget()
                w_.pack(before=box, **info)
            d.bind("<Configure>", lambda e: e.widget is d and setattr(d, "_user_sized", True), add="+")
        except Exception:
            pass

    def _titlebar(self, win=None):
        """3.0: Windows 10/11 - the window's title bar follows the theme (it stayed white over a dark BindLens)."""
        if os.name != "nt":
            return
        win = win or self.root
        try:
            import ctypes
            win.update_idletasks()
            hwnd = ctypes.windll.user32.GetParent(win.winfo_id()) or win.winfo_id()
            val = ctypes.c_int(0 if is_light(self.T["bg"]) else 1)
            for attr in (20, 19):                 # DWMWA_USE_IMMERSIVE_DARK_MODE (newer, older Windows 10)
                if ctypes.windll.dwmapi.DwmSetWindowAttribute(hwnd, attr, ctypes.byref(val), 4) == 0:
                    break
        except Exception:
            pass

    def _center(self, d):
        self._scroll_fix(d)
        d.update_idletasks()
        x = self.root.winfo_rootx() + (self.root.winfo_width() - d.winfo_width()) // 2
        y = self.root.winfo_rooty() + (self.root.winfo_height() - d.winfo_height()) // 3
        d.geometry(f"+{max(0, x)}+{max(0, y)}")

    def _ask_string(self, title, label, initial=""):
        d = self._dialog(title)
        ttk.Label(d, text=label, style="Panel.TLabel").pack(anchor="w", padx=16, pady=(14, 6))
        var = tk.StringVar(value=initial)
        en = ttk.Entry(d, textvariable=var, width=40)
        en.pack(padx=16, fill="x")
        res = [None]

        def ok(_e=None):
            res[0] = var.get().strip()
            d.destroy()
        bf = ttk.Frame(d, style="Panel.TFrame", padding=(16, 12))
        bf.pack(fill="x")
        PillButton(bf, self, "OK", ok, kind="accent").pack(side="right")
        PillButton(bf, self, "Cancel", d.destroy, kind="ghost").pack(side="right", padx=6)
        en.bind("<Return>", ok)
        d.bind("<Escape>", lambda e: d.destroy())
        self._center(d)
        en.focus_set()
        en.select_range(0, "end")
        d.grab_set()
        self.root.wait_window(d)
        return res[0]

    def _ask_text(self, title, initial=""):
        T = self.T
        d = self._dialog(title)
        txt = tk.Text(d, width=50, height=7, wrap="word", font=UI_FONT, relief="flat", bg=T["bg"], fg=T["text"],
                      insertbackground=T["text"], highlightthickness=1, highlightcolor=self.accent,
                      highlightbackground=T["border"], padx=8, pady=6)
        txt.pack(fill="both", expand=True, padx=16, pady=(16, 0))
        txt.insert("1.0", initial)
        res = [None]

        def ok(_e=None):
            res[0] = txt.get("1.0", "end").strip()
            d.destroy()
            return "break"
        bf = ttk.Frame(d, style="Panel.TFrame", padding=(16, 12))
        bf.pack(fill="x")
        ttk.Label(bf, text="Ctrl+Enter to save", style="Muted.TLabel").pack(side="left")
        PillButton(bf, self, "Save", ok, kind="accent").pack(side="right")
        PillButton(bf, self, "Cancel", d.destroy, kind="ghost").pack(side="right", padx=6)
        d.bind("<Control-Return>", ok)
        d.bind("<Escape>", lambda e: d.destroy())
        self._center(d)
        txt.focus_set()
        d.grab_set()
        self.root.wait_window(d)
        return res[0]

    def _inline_palette(self, parent, color, on_change):
        """16 colour dots + 'More…' inside a dialog (popups can't be clicked while a dialog is open)."""
        T = self.T
        fr = tk.Frame(parent, bg=T["panel"])
        state = {"c": color}
        cvs = []

        def paint():
            for c, cv in cvs:
                cv.delete("ring")
                if c.upper() == state["c"].upper():
                    cv.create_oval(1, 1, 23, 23, outline=self.accent, width=2, tags="ring")

        def pick(c):
            state["c"] = c
            paint()
            on_change(c)
        for i, (n, c) in enumerate(PALETTE.items()):
            cv = tk.Canvas(fr, width=24, height=24, bg=T["panel"], highlightthickness=0, cursor="hand2")
            cv.grid(row=i // 8, column=i % 8, padx=1, pady=1)
            cv.create_oval(5, 5, 19, 19, fill=c, outline=mix(c, "#000000", 0.2))
            cv.bind("<Button-1>", lambda e, c=c: pick(c))
            cvs.append((c, cv))
        more = tk.Label(fr, text="More…", bg=T["panel"], fg=self.accent, font=self.F(9), cursor="hand2")
        more.grid(row=0, column=8, rowspan=2, padx=(8, 0))

        def custom(_e=None):
            res = colorchooser.askcolor(color=state["c"], title="Pick a colour", parent=parent)
            if res and res[1]:
                pick(res[1].upper())
        more.bind("<Button-1>", custom)
        paint()
        return fr

    def _note_dialog(self, text="", color=None):
        """Sticky note: text + its colour. Returns (text, colour) or None."""
        T = self.T
        color = color or self.lib.settings["color"]
        d = self._dialog("Note")
        st = {"c": color}
        top = tk.Frame(d, bg=T["panel"])
        top.pack(fill="x", padx=16, pady=(14, 8))
        tk.Label(top, text="Colour", bg=T["panel"], fg=T["muted"], font=self.F(9)).pack(side="left", padx=(0, 10))
        self._inline_palette(top, color, lambda c: st.__setitem__("c", c)).pack(side="left")
        txt = tk.Text(d, width=50, height=7, wrap="word", font=self.F(10), relief="flat", bg=T["bg"], fg=T["text"],
                      insertbackground=T["text"], highlightthickness=1, highlightcolor=self.accent,
                      highlightbackground=T["border"], padx=8, pady=6)
        txt.pack(fill="both", expand=True, padx=16)
        txt.insert("1.0", text)
        res = [None]

        def ok(_e=None):
            t = txt.get("1.0", "end").strip()
            if t:
                res[0] = (t, st["c"])
            d.destroy()
            return "break"
        bf = ttk.Frame(d, style="Panel.TFrame", padding=(16, 12))
        bf.pack(fill="x")
        ttk.Label(bf, text="Ctrl+Enter to save", style="Muted.TLabel").pack(side="left")
        PillButton(bf, self, "Save", ok, kind="accent").pack(side="right")
        PillButton(bf, self, "Cancel", d.destroy, kind="ghost").pack(side="right", padx=6)
        d.bind("<Control-Return>", ok)
        d.bind("<Escape>", lambda e: d.destroy())
        self._center(d)
        txt.focus_set()
        d.grab_set()
        self.root.wait_window(d)
        return res[0]

    def _widget_at(self, e):
        hit = self._event_to_page(e)
        if not hit or not self.book:
            return None
        g, px, py = hit
        fi = self.book.pages[g][0]
        f = self.book.files[fi]
        if not f["pdf"] or (f["doc"] is None and not f.get("form")):     # never open a big file just for a hover
            return None
        try:
            if not self.book.doc(fi).is_form_pdf:
                return None
            page = self.book.page(g)
            pt = self.fitz.Point(px, py) * page.derotation_matrix
            for w in page.widgets() or []:
                if w.rect.contains(pt) and w.field_type not in (self.fitz.PDF_WIDGET_TYPE_BUTTON,
                                                                 self.fitz.PDF_WIDGET_TYPE_SIGNATURE):
                    return g, w.xref, w.field_type, w
        except Exception:
            return None
        return None

    def _form_widget(self, g, xref):
        page = self.book.page(g)
        for w in page.widgets() or []:
            if w.xref == xref:
                return page, w
        return page, None

    def _set_field(self, g, xref, value):
        fi = self.book.pages[g][0]
        self._begin_edit(fi)
        page, w = self._form_widget(g, xref)
        if w is None:
            return
        try:
            w.field_value = value
            w.update()
        except Exception as ex:
            self.undo_stack.pop()
            messagebox.showerror(APP_NAME, f"Could not fill that field:\n{ex}")
            return
        self._commit_edit(fi, g)
        self.set_status("Form saved in the PDF.")

    def fill_field(self, e, hit):
        g, xref, ft, w = hit
        F = self.fitz
        if ft == F.PDF_WIDGET_TYPE_CHECKBOX:
            on = w.on_state() or "Yes"
            self._set_field(g, xref, False if w.field_value not in (False, "Off", "", None) else on)
            return
        if ft == F.PDF_WIDGET_TYPE_RADIOBUTTON:
            self._set_field(g, xref, w.on_state() or True)
            return
        if ft in (F.PDF_WIDGET_TYPE_COMBOBOX, F.PDF_WIDGET_TYPE_LISTBOX):
            m = self._menu()
            for v in w.choice_values or []:
                val = v[1] if isinstance(v, (list, tuple)) else v
                m.add_command(label=str(val), command=lambda val=val: self._set_field(g, xref, val))
            self._popup(m, e)
            return
        # text field: type straight on the page
        page = self.book.page(g)
        r = self.fitz.Rect(w.rect) * page.rotation_matrix
        a, b, c2, d = self._to_canvas(g, r)
        T = self.T
        var = tk.StringVar(value=w.field_value or "")
        multi = bool(w.field_flags & 4096)
        if multi:
            ed = tk.Text(self.canvas, wrap="word", relief="flat", bd=0, highlightthickness=2,
                         highlightcolor=self.accent, font=(self.family, max(8, int(9 * self.zoom))))
            ed.insert("1.0", var.get())
        else:
            ed = tk.Entry(self.canvas, textvariable=var, relief="flat", bd=0, highlightthickness=2,
                          highlightcolor=self.accent, font=(self.family, max(8, int(9 * self.zoom))))
        # 3.0: placed over the page (as a canvas item it vanished - with what you typed - when a page picture
        # arrived); scrolling away saves it
        cvx, cvy = self.canvas.canvasx(0), self.canvas.canvasy(0)
        ed.place(x=a - cvx, y=b - cvy, width=max(60, c2 - a), height=max(22, d - b))
        done = [False]

        def save(_e=None):
            if done[0]:
                return
            done[0] = True
            self._field_save = None
            val = ed.get("1.0", "end").rstrip("\n") if multi else var.get()
            ed.destroy()
            if val != (w.field_value or ""):
                self._set_field(g, xref, val)

        def cancel(_e=None):
            done[0] = True
            self._field_save = None
            ed.destroy()
        self._field_save = (save, (cvx, cvy))
        ed.bind("<Return>", save if not multi else lambda e: None)
        ed.bind("<Control-Return>", save)
        ed.bind("<Escape>", cancel)
        ed.bind("<FocusOut>", save)
        ed.focus_set()

    # ===================================================================== OCR
    def _tessdata(self):
        cands = [os.environ.get("TESSDATA_PREFIX", ""), os.path.join(self.lib.meta_dir, "tessdata"),
                 r"C:\Program Files\Tesseract-OCR\tessdata", r"C:\Program Files (x86)\Tesseract-OCR\tessdata",
                 "/usr/share/tesseract-ocr/5/tessdata", "/usr/share/tesseract-ocr/4.00/tessdata",
                 "/usr/local/share/tessdata", "/opt/homebrew/share/tessdata"]
        for c in cands:
            if c and os.path.exists(os.path.join(c, "eng.traineddata")):
                return c
        return None

    def _get_tessdata(self):
        td = self._tessdata()
        if td:
            return td
        if not messagebox.askyesno(APP_NAME, "To read scanned pages BindLens needs its English reading data "
                                             "(about 4 MB, downloaded once).\n\nDownload it now?"):
            return None
        dst = os.path.join(self.lib.meta_dir, "tessdata")
        os.makedirs(dst, exist_ok=True)
        url = "https://github.com/tesseract-ocr/tessdata_fast/raw/main/eng.traineddata"
        try:
            import urllib.request
            self.root.config(cursor="watch")
            self.set_status("Downloading the OCR data…")
            self.root.update()
            with urllib.request.urlopen(url, timeout=60) as r, open(os.path.join(dst, "eng.traineddata.part"),
                                                                   "wb") as fh:
                shutil.copyfileobj(r, fh)
            os.replace(os.path.join(dst, "eng.traineddata.part"), os.path.join(dst, "eng.traineddata"))
        except Exception as ex:
            messagebox.showerror(APP_NAME, f"Could not download it (are you online?)\n\n{ex}")
            return None
        finally:
            self.root.config(cursor="")
        return dst

    # ---- 3.2: scanned documents are read by themselves - quietly, in a helper process, one or two pages at a time
    def _scan_enable(self):
        self.lib.settings["read_scans"] = True
        if self._get_tessdata():
            self._toast("BindLens reads the scanned pages now, little by little - search, select and reports will "
                        "find their words.", ms=7000)
            self.root.after(500, self._scan_auto_tick)

    def _scan_auto_tick(self):
        """One step of reading scanned pages: the document you are in first, then the rest of the book."""
        job = getattr(self, "_scan_job", None)
        if job and job.get("running"):
            return
        delay = 25000
        try:
            ok = self.lib.settings.get("read_scans", True) and not self._fast() and not self._bg_paused() and \
                self._quiet(45)                         # 4.0: only when nobody uses the computer
            td = self._tessdata() if ok else None
            nxt = self._scan_next() if (td and self.book and self.book.total) else None
            if nxt:
                fi, f = nxt
                self._scan_job = {"running": True, "path": f["path"], "key": f["key"]}
                self.pool.submit("ocr", prio=9, timeout=900, path=f["path"], td=td, n=1,
                                 cb=lambda res, f=f: self._scan_got(f, res))
                delay = None
        except Exception as ex:
            _log(f"scan reading: {ex}")
        if delay:
            self.root.after(delay, self._scan_auto_tick)

    def _scan_next(self):
        done = self.__dict__.setdefault("_scan_done", set())
        b = self.book
        try:
            cur = b.pages[max(0, min(self.current_page, b.total - 1))][0]
        except Exception:
            cur = 0
        order = [cur] + [i for i in range(len(b.files)) if i != cur]
        for fi in order:
            f = b.files[fi]
            if f.get("error") or not f.get("count") or is_outside(f["path"]):
                continue
            ext = os.path.splitext(f["path"])[1].lower()
            if ext not in (".pdf", ".png", ".jpg", ".jpeg", ".tif", ".tiff", ".bmp", ".gif", ".webp"):
                continue
            try:
                mt = os.path.getmtime(f["path"])
            except OSError:
                continue
            if (f["path"], mt) in done:
                continue
            return fi, f
        return None

    def _scan_got(self, f, res):
        job = getattr(self, "_scan_job", None) or {}
        job["running"] = False
        res = res or {}
        try:
            mt = os.path.getmtime(f["path"])
        except OSError:
            mt = 0
        if res.get("err") or res.get("cancelled"):
            self.__dict__.setdefault("_scan_done", set()).add((f["path"], mt))
        elif res.get("done"):
            self.words_cache.clear()                   # the pages' words are there now
            n_ = job.get("n", 0) + res["done"]
            job["n"] = n_
            left = res.get("left", 0)
            self.set_status(f"Reading scanned pages of {os.path.basename(f['path'])}: {n_} read" +
                            (f", {left} to go" if left else " - done. Search, select and reports find their words."))
            if not left:
                self.__dict__.setdefault("_scan_done", set()).add((f["path"], mt))
                try:
                    self.indexer.refresh(f["key"], f["path"])
                except Exception:
                    pass
        else:
            self.__dict__.setdefault("_scan_done", set()).add((f["path"], mt))
        self.root.after(3000 if res.get("left") else 6000, self._scan_auto_tick)

    # ---- 3.2: Word, Excel and PowerPoint exactly as they look (Office / LibreOffice, in the background) ---------
    def _office_tick(self):
        """4.0: the Word / Excel / PowerPoint file you are looking at is made ready at once; the others of the book
        you have open only when nobody uses the computer (never in Fast mode) - a few at a time, at low priority."""
        if getattr(self, "_office_none", False) or not self.lib.settings.get("office_exact", True):
            return
        if getattr(self, "_office_busy", False):
            return
        delay = 4000
        try:
            todo, quiet = self._office_todo()
            if todo:
                self._office_busy = True
                delay = None
                threading.Thread(target=self._office_work, args=(todo, quiet), daemon=True).start()
        except Exception as ex:
            _log(f"office: {ex}")
            self._office_busy = False
        if delay:
            self.root.after(delay, self._office_tick)

    def _offnote_click(self, e):
        c = self.canvas
        for it in c.find_withtag("current"):
            for t in c.gettags(it):
                if t.startswith("offfi") and self.book:
                    fi = int(t[5:])
                    if 0 <= fi < len(self.book.files):
                        self._office_now(self.book.files[fi]["path"])
                    return "break"

    def doing_dialog(self):
        """4.0: what BindLens is doing in the background - Office copies, scanned pages, the search index, saves -
        with Pause, Fast mode and a test of Office (so a problem can be seen, and sent)."""
        T, A = self.T, self.accent
        d = self._dialog("What BindLens is doing")
        tk.Label(d, text="What BindLens is doing", font=self.F(14, "bold"), bg=T["panel"], fg=T["text"]).pack(
            anchor="w", padx=20, pady=(16, 2))
        body = tk.Frame(self._scroll_body(d), bg=T["panel"])
        body.pack(fill="both", padx=20, pady=(4, 0))

        def fill():
            for w_ in body.winfo_children():
                w_.destroy()

            def head(t):
                tk.Label(body, text=t.upper(), font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(
                    anchor="w", pady=(10, 3))

            def line(t, col=None):
                tk.Label(body, text=t, font=self.F(9), bg=T["panel"], fg=col or T["text"], wraplength=520,
                         justify="left").pack(anchor="w")
            head("Background work")
            if self._fast():
                line("Fast mode is on: BindLens does nothing in the background (only what you ask).", A)
            elif self._bg_paused():
                left = int((self._bg_pause_until - time.time()) / 60) + 1
                line(f"Paused - {left} more minute(s).", A)
            else:
                line("On - only when nobody uses the computer (after about 20 seconds), at low priority.")
            head("Word, Excel and PowerPoint as they look")
            progs = office_programs()
            names = {"word": "Word", "excel": "Excel", "ppt": "PowerPoint"}
            if os.name == "nt":
                have = [names[k] for k, v in progs.items() if v]
                line("Microsoft Office on this computer: " + (", ".join(have) if have else "not found"),
                     None if have else "#B3261E")
            so = find_soffice()
            line("LibreOffice: " + ("found" if so else "not found"))
            if self.book:
                offs = [f for f in self.book.files if os.path.splitext(f["path"])[1].lower() in OFFICE_EXACT]
                ready = [f for f in offs if office_pdf_ready(f["path"])]
                bad = [(f, office_failed_note(f["path"])) for f in offs if not office_pdf_ready(f["path"])]
                bad = [(f, w_) for f, w_ in bad if w_]
                line(f"In this book: {len(offs)} Office file(s) - {len(ready)} shown as they look, "
                     f"{len(offs) - len(ready) - len(bad)} waiting, {len(bad)} could not be done.")
                for f, why in bad[:6]:
                    line(f"   ✗ {os.path.basename(f['path'])}: {why[:140]}", "#B3261E")
            if getattr(self, "_office_busy", False):
                line("Working on it now…", A)
            head("Scanned pages")
            td = self._tessdata()
            line("Reading data: " + ("ready" if td else "not downloaded yet (BindLens asks the first time)"))
            n_ocr = 0
            try:
                n_ocr = len([x for x in os.listdir(ocr_dir()) if x.endswith(".json.gz")])
            except OSError:
                pass
            line(f"Scanned pages read so far: {n_ocr}")
            head("Search and saving")
            try:
                n_idx = len(self.indexer.items())
            except Exception:
                n_idx = 0
            line(f"Documents in the search: {n_idx}")
            try:
                with self.writer.lock:
                    waiting, failed = len(self.writer.latest), dict(self.writer.failed)
            except Exception:
                waiting, failed = 0, {}
            line(f"Saves waiting: {waiting}" + (f"  ·  not saved: {len(failed)}" if failed else ""),
                 "#B3261E" if failed else None)
            for pth, why in list(failed.items())[:4]:
                line(f"   ✗ {os.path.basename(pth)}: {why}", "#B3261E")
        fill()
        res = tk.Label(d, text="", font=self.F(9), bg=T["panel"], fg=T["muted"], wraplength=520, justify="left")
        res.pack(anchor="w", padx=20, pady=(8, 0))

        def test_office():
            """Make a tiny Word file and ask Word for its PDF - the whole answer is shown."""
            res.configure(text="Asking Word… (a few seconds)", fg=A)
            tmpd = os.path.join(self.lib.meta_dir, "office test")
            shutil.rmtree(tmpd, ignore_errors=True)
            os.makedirs(tmpd, exist_ok=True)

            def work():
                t0 = time.time()
                msg = ""
                try:
                    src = os.path.join(tmpd, "test.docx")
                    write_report_docx({"title": "BindLens test", "blocks": [["h", "Word test"], ["p", "Hello from BindLens."]]},
                                      src, fitz=self.fitz)
                    out = []
                    if os.name == "nt":
                        office_batch([(src, os.path.join(tmpd, "test.pdf"), "word")], tmpd,
                                     lambda i, err: out.append(err), wait_each=90)
                        ok = os.path.exists(os.path.join(tmpd, "test.pdf"))
                        msg = (f"Word works: it made the PDF in {time.time() - t0:.0f} s." if ok else
                               f"Word did not make it: {out[0] if out else 'no answer'}")
                    else:
                        err, _f = office_convert(src, os.path.join(tmpd, "test.pdf"),
                                                 lo_profile=os.path.join(self.lib.meta_dir, "lo profile"))
                        msg = "LibreOffice works." if not err else f"It did not work: {err}"
                    try:
                        with open(os.path.join(tmpd, "errors.txt"), "r", encoding="utf-8", errors="replace") as fh:
                            extra = fh.read().strip()
                        if extra and "works" not in msg:
                            msg += "\n" + extra[-600:]
                    except OSError:
                        pass
                except Exception as ex:
                    msg = f"The test could not run: {ex}"
                _log(f"office test: {msg}")
                self.root.after(0, lambda: res.configure(text=msg, fg=T["text"] if "works" in msg else "#B3261E"))
            threading.Thread(target=work, daemon=True).start()

        def retry_all():
            if self.book:
                for f in self.book.files:
                    if os.path.splitext(f["path"])[1].lower() in OFFICE_EXACT:
                        try:
                            os.remove(office_pdf_path(f["path"])[:-4] + ".failed")
                        except OSError:
                            pass
                self._office_failed = {}
                self._office_none = False
                self._office_tick()
            fill()

        def pause(mins):
            self._bg_pause_until = time.time() + mins * 60 if mins else 0
            fill()
        bf = tk.Frame(d, bg=T["panel"])
        bf.pack(fill="x", padx=20, pady=14)
        PillButton(bf, self, "Close", d.destroy, kind="accent").pack(side="right")
        PillButton(bf, self, "Test Office", test_office, kind="soft").pack(side="left")
        PillButton(bf, self, "Try again", retry_all, kind="soft").pack(side="left", padx=6)
        if self._bg_paused():
            PillButton(bf, self, "Resume", lambda: pause(0), kind="ghost").pack(side="left")
        else:
            PillButton(bf, self, "Pause 1 hour", lambda: pause(60), kind="ghost").pack(side="left")
        d.bind("<Escape>", lambda e: d.destroy())
        self._center(d)

    def _office_now(self, path):
        """Try this file again, now (it comes first)."""
        self.__dict__.setdefault("_office_failed", {}).pop(path, None)
        try:
            os.remove(office_pdf_path(path)[:-4] + ".failed")
        except OSError:
            pass
        self._office_none = False
        self._office_err_told = False
        if getattr(self, "_office_busy", False):
            self._toast("Getting it ready - in a moment.")
        else:
            self._toast("Getting it ready to show here…")
            self._office_tick()

    def _office_wanted(self, path, failed):
        if os.path.splitext(path)[1].lower() not in OFFICE_EXACT or os.path.basename(path).startswith("~$"):
            return False
        try:
            st = os.stat(path)
        except OSError:
            return False
        if st.st_size > 80 * 1024 * 1024 or cloud_only(st) or failed.get(path) == st.st_mtime:
            return False
        return not office_pdf_ready(path) and not office_failed_note(path)

    def _office_todo(self):
        """([(path, key)], quiet): the file you are on (now), else up to 3 of the open book (when quiet)."""
        failed = self.__dict__.setdefault("_office_failed", {})
        b = self.book
        if not b or not b.total:
            return [], False
        try:
            cur = b.pages[max(0, min(self.current_page, b.total - 1))][0]
        except Exception:
            cur = 0
        f = b.files[cur]
        if self._office_wanted(f["path"], failed):
            return [(f["path"], f["key"])], False
        if self._fast() or self._bg_paused() or not self._quiet(20):
            return [], True
        out = []
        for fi in sorted(range(len(b.files)), key=lambda i: abs(i - cur)):     # the nearest first
            f = b.files[fi]
            if self._office_wanted(f["path"], failed):
                out.append((f["path"], f["key"]))
                if len(out) >= 3:
                    break
        return out, True

    def _office_work(self, todo, quiet=False):
        """In a thread: copies of the files (Office opens a copy - never your file, and no 'protected view'),
        Microsoft Office makes their PDFs; what it can't do, LibreOffice tries."""
        tmpd = os.path.join(self.lib.meta_dir, "office tmp")
        shutil.rmtree(tmpd, ignore_errors=True)
        os.makedirs(tmpd, exist_ok=True)
        missing = self.__dict__.setdefault("_office_missing", set())
        jobs, items = [], []
        for k, (path, key) in enumerate(todo):
            try:
                dst = office_pdf_path(path)
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                cp = os.path.join(tmpd, f"file{k}{os.path.splitext(path)[1].lower()}")
                shutil.copyfile(path, cp)
                items.append({"path": path, "key": key, "dst": dst, "copy": cp, "kind": office_kind(path),
                              "err": None, "ok": False})
            except Exception as ex:
                self.root.after(0, lambda path=path, key=key, ex=ex: self._office_one(path, key, None, str(ex)))
        prof = os.path.join(self.lib.meta_dir, "lo profile")

        def finish(it, err):
            if not err:
                try:
                    d_ = self.fitz.open(it["dst"] + ".part.pdf")
                    ok = d_.page_count > 0
                    d_.close()
                    if not ok:
                        raise ValueError("the PDF has no pages")
                    os.replace(it["dst"] + ".part.pdf", it["dst"])
                    it["ok"] = True
                except Exception as ex:
                    err = str(ex)
            it["err"] = err
            if it["ok"]:
                self.root.after(0, lambda it=it: self._office_one(it["path"], it["key"], it["dst"], None))
        ms = [it for it in items if os.name == "nt" and it["kind"] not in missing]
        stop_file = os.path.join(tmpd, "stop")
        if quiet:                                          # you came back: stop after the file being made
            def watch_back():
                while getattr(self, "_office_busy", False) and not os.path.exists(stop_file):
                    if not self._quiet_t(3):
                        try:
                            open(stop_file, "w").close()
                        except OSError:
                            pass
                        return
                    time.sleep(0.5)
            threading.Thread(target=watch_back, daemon=True).start()
        if ms:
            jobs = [(it["copy"], it["dst"] + ".part.pdf", it["kind"]) for it in ms]
            try:
                office_batch(jobs, tmpd, lambda i, err: finish(ms[i], err), stop_file=stop_file)
            except Exception as ex:
                for it in ms:
                    if not it["ok"]:
                        it["err"] = str(ex)
            for it in ms:
                if it["err"] and re.search(r"80040154|REGDB_E_CLASSNOTREG|class not registered|COM class factory",
                                           it["err"], re.I):
                    missing.add(it["kind"])
            if ms and not any(it["ok"] for it in ms) and all(it["err"] in ("Office did not answer", None) or
                                                            "ParserError" in str(it["err"]) for it in ms):
                for it in ms:                             # the batch did not run: one file at a time
                    if quiet and not self._quiet_t(3):
                        it["err"] = "later"
                        continue
                    err, flag = office_convert(it["copy"], it["dst"] + ".part.pdf", use_office=True,
                                               lo_profile=None) if os.name == "nt" else ("", "")
                    if os.name == "nt":
                        finish(it, err)
                        if flag == "no-office":
                            missing.add(it["kind"])
        for it in items:                                   # LibreOffice for what Office could not do
            if it["ok"] or it["err"] == "later":
                continue
            if quiet and not self._quiet_t(3):             # you came back: the rest next time
                it["err"] = "later"
                continue
            if find_soffice():
                err, _flag = office_convert(it["copy"], it["dst"] + ".part.pdf", lo_profile=prof, use_office=False)
                finish(it, err)
            if not it["ok"]:
                why = it["err"] or "no Microsoft Office or LibreOffice on this computer"
                self.root.after(0, lambda it=it, why=why: self._office_one(it["path"], it["key"], None, why))
        nothing = bool(items) and not any(it["ok"] for it in items) and not find_soffice() and (
            os.name != "nt" or all(it["kind"] in missing for it in items))
        shutil.rmtree(tmpd, ignore_errors=True)
        self.root.after(0, lambda: self._office_batch_end(nothing))

    def _office_one(self, path, key, dst, err):
        """One file is ready (or could not be done)."""
        _OFFICE_MEMO.pop(path, None)
        if err:
            try:
                self._office_failed[path] = os.path.getmtime(path)
            except (OSError, AttributeError):
                pass
            _log(f"office copy of {os.path.basename(path)}: {err}")
            errs = self.__dict__.setdefault("_office_errs", [])
            errs.append((os.path.basename(path), err))
            if "too long" not in err and "did not answer" not in err:      # remembered: not tried again and again
                try:
                    os.makedirs(office_pdf_dir(), exist_ok=True)
                    with open(office_pdf_path(path)[:-4] + ".failed", "w", encoding="utf-8") as fh:
                        fh.write(err[:300])
                except OSError:
                    pass
            try:                                           # its page says why
                fi = next(i for i, f in enumerate(self.book.files) if f["path"] == path) if self.book else None
                if fi is not None:
                    self._invalidate_file(fi)
                    self.redraw()
            except Exception:
                pass
            return
        try:                                               # older copies of the same file go
            head = os.path.basename(dst).split("-")[0]
            for x in os.listdir(office_pdf_dir()):
                if x.startswith(head + "-") and x != os.path.basename(dst):
                    os.remove(os.path.join(office_pdf_dir(), x))
        except Exception:
            pass
        self._office_n = getattr(self, "_office_n", 0) + 1
        self.set_status(f"Word, Excel and PowerPoint shown as they look: {self._office_n} ready  ·  "
                        f"{os.path.basename(path)}")
        self.__dict__.setdefault("_office_pending", set()).add(key)
        job = getattr(self, "_office_apply_job", None)
        if job:
            self.root.after_cancel(job)
        self._office_apply_job = self.root.after(1200, self._office_apply)

    def _office_batch_end(self, nothing):
        self._office_busy = False
        if nothing:
            self._office_none = True
            if not self.lib.settings.get("office_none_told"):
                self.lib.settings["office_none_told"] = True
                self._toast("To show Word, Excel and PowerPoint files here as they look, BindLens needs Microsoft "
                            "Office or the free LibreOffice on this computer.", ms=12000)
            return
        errs = self.__dict__.get("_office_errs") or []
        if errs and not getattr(self, "_office_err_told", False):
            self._office_err_told = True
            name, why = errs[0]
            self._toast(f'Could not show "{name}" here: {why[:90]}', ms=10000)
        self.__dict__["_office_errs"] = []
        self.root.after(1500, self._office_tick)

    def _office_apply(self):
        """The exact copies are ready: the book is laid out again with them (your place is kept)."""
        pend = self.__dict__.get("_office_pending") or set()
        if not pend or not self.book:
            return
        try:
            cur_key = self.book.files[self.book.pages[max(0, min(self.current_page, self.book.total - 1))][0]]["key"]
        except Exception:
            cur_key = None
        if self._ed or self.drag or (getattr(self, "_office_busy", False) and cur_key not in pend):
            self.root.after(2500, self._office_apply)          # not while you type or drag - a moment later
            return
        fi = next((i for i, f in enumerate(self.book.files) if f["key"] in pend), None)
        for k in list(pend):
            self.page_sizes.pop(k, None)
        pend.clear()
        if fi is None:
            return
        self._structure_changed(fi)
        if not getattr(self, "_office_told", False):
            self._office_told = True
            self._toast("Word, Excel and PowerPoint files now show exactly as they look.", ms=6000)

    def ocr_file(self, fi):
        """Scanned pages get an invisible text layer: search, copy and reports work on them."""
        f = self.book.files[fi]
        if not f["pdf"]:
            return
        td = self._get_tessdata()
        if not td:
            return
        self._begin_edit(fi)
        data = self._file_bytes(fi)
        job = {"done": False, "n": 0, "pages": 0, "out": None, "err": None, "cancel": False}
        fitz = self.fitz
        book, path = self.book, f["path"]

        def drop_undo():
            if self.undo_stack and self.undo_stack[-1][1] == path:
                self.undo_stack.pop()

        def work():
            try:
                doc = fitz.open(stream=data, filetype="pdf")
                todo = [i for i in range(doc.page_count) if len(doc.load_page(i).get_text("text").strip()) < 25]
                job["pages"] = len(todo)
                for k, i in enumerate(todo):
                    if job["cancel"]:
                        break
                    job["n"] = k + 1
                    pg = doc.load_page(i)
                    tp = pg.get_textpage_ocr(language="eng", dpi=300, full=True, tessdata=td)
                    for x0, y0, x1, y1, word, *_ in pg.get_text("words", textpage=tp):
                        h = y1 - y0
                        if h <= 0:
                            continue
                        size = h * 0.95
                        tl = fitz.get_text_length(word, fontname="helv", fontsize=size)
                        if tl > 0:
                            size *= min(1.6, (x1 - x0) / tl)
                        pt = fitz.Point(x0, y1 - h * 0.2) * pg.derotation_matrix
                        pg.insert_text(pt, word, fontsize=size, fontname=full_font(pg, "helv", word),
                                       render_mode=3, rotate=pg.rotation)
                job["out"] = doc.tobytes(garbage=1, deflate=True)
            except Exception as ex:
                job["err"] = str(ex)
            job["done"] = True
        threading.Thread(target=work, daemon=True).start()

        def poll():
            if not job["done"]:
                self.set_status(f"Reading scanned pages… {job['n']} of {job['pages'] or '?'}")
                self.root.after(300, poll)
                return
            if job["err"]:
                drop_undo()
                messagebox.showerror(APP_NAME, f"Could not read the pages:\n{job['err']}")
                return
            if not job["pages"]:
                drop_undo()
                self.set_status("This file already has text on every page - nothing to do.")
                return
            # 3.0: if the file changed while its pages were read (a mark added, another book opened), the
            # searchable file is saved NEXT to it - nothing you did meanwhile is written over
            try:
                now_bytes = self.writer.get(path)
                if now_bytes is None:
                    with open(path, "rb") as fh:
                        now_bytes = fh.read()
            except Exception:
                now_bytes = None
            here = self.book is book and fi < len(book.files) and book.files[fi]["path"] == path
            if now_bytes != data:
                base, ext = os.path.splitext(path)
                dst = base + " (searchable)" + ext
                try:
                    with open(dst, "wb") as fh:
                        fh.write(job["out"])
                    self.set_status(f"The file changed while its pages were read - the searchable copy is "
                                    f"“{os.path.basename(dst)}”, next to it.")
                except Exception as ex:
                    messagebox.showerror(APP_NAME, f"Could not save the searchable copy:\n{ex}")
                return
            if not here:
                self.writer.put(path, job["out"])
                self.set_status(f"{job['pages']} scanned page(s) of {os.path.basename(path)} can now be searched.")
                return
            self.writer.put(f["path"], job["out"])
            self.book.reopen(fi, data=job["out"])
            self.book.keep.add(fi)
            self._watch_writer()
            self._invalidate_file(fi)
            self.redraw()
            self._schedule_index()
            self.set_status(f"{job['pages']} scanned page(s) can now be searched and used in reports.")
        poll()

    # ===================================================================== reminders
