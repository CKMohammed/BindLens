        ("contacts_sure", "Who", "Emails & phones with their person",
         "How many were linked to a person for sure - and how many to check", "stack", ""),
        ("email_domains", "Who", "Email domains", "Where the emails come from (gmail, a school, a company…)", "bar",
         ""),
        ("kinds", "Documents", "Kinds of documents", "Invoices, forms, letters… - how many of each", "bar", ""),
        ("pages", "Documents", "Size of the documents", "How many have 1 page, 2-5, 6-20, more", "hist", ""),
        ("books", "Documents", "Books compared", "Documents and pages in each book", "bar", "library"),
        ("status", "Documents", "Status of the documents", "Pending, Checked, Done… - in each book", "stack", "status"),
        ("marks", "Documents", "My marks", "Your highlights, notes, stamps… - how many of each kind", "bar", "marks"),
        ("words", "Words", "Key words", "The words your documents use most - with how many times", "bar", ""),
        ("words_where", "Words", "Key words in each document",
         "The key words - and the documents that use them most", "heat", ""),
    ]
    CHART_GROUP_COL = {"Money": "#1BAF7A", "When": "#2A78D6", "Coming up": "#EB6834", "Who": "#E87BA4",
                       "Documents": "#4A3AA7", "Words": "#EDA100"}
    CHART_AUTO = ["deadlines", "money_month", "money_who", "money_year", "contacts_sure", "people_top", "busy_days",
                  "kinds", "doc_age", "people_where", "words"]

    def _job_charts(self, P, job):
        """The charts you chose (or the best ones for these documents): each with its title, one line that says
        what it shows, and its numbers in a table at the end. Honest charts: bars start at zero, round ticks, one
        scale, the theme's colour for one series, grey for context."""
        import datetime
        import calendar as _cal
        today = datetime.date.today()
        want = [c for c in (P.get("charts") or []) if c in {g[0] for g in self.CHART_GALLERY}]
        auto = not want
        if auto:
            want = list(self.CHART_AUTO)
        need_money = any(w.startswith("money") for w in want)
        need_words = any(w.startswith("words") for w in want)
        docs, people, people_docs, orgs, days, weekdays = [], {}, {}, {}, {}, [0] * 7
        words, words_docs, units = {}, {}, {}
        all_amounts = []
        date_re = re.compile(r"\b(?:date|dated|issued|invoice date|fecha|datum|data)\b", re.I)
        for name, folder, rel, path, texts in self._texts(P, job):
            joined = "\n".join(texts)
            try:
                mt = os.stat(path).st_mtime
            except Exception:
                mt = None
            d = {"name": name, "folder": folder, "rel": rel, "path": path, "pages": len(texts),
                 "kind": doc_type(joined), "mtime": mt, "total": None, "date": None, "org": None}
            docs.append(d)
            f_orgs = {}
            for t in texts:
                for p_ in self._people_on_page(t):
                    people[p_] = people.get(p_, 0) + 1
                    people_docs.setdefault(p_, {})
                    people_docs[p_][name] = people_docs[p_].get(name, 0) + 1
                for m_ in self.ORG_RE.finditer(t):
                    o = " ".join(m_.group(1).split())
                    orgs[o] = orgs.get(o, 0) + 1
                    f_orgs[o] = f_orgs.get(o, 0) + 1
                for dt_ in parse_dates(t):
                    if -400 <= (dt_ - today).days <= 400:
                        days[dt_.isoformat()] = days.get(dt_.isoformat(), 0) + 1
                    if abs((dt_ - today).days) <= 2 * 366:
                        weekdays[dt_.weekday()] += 1
            if f_orgs:
                d["org"] = max(f_orgs.items(), key=lambda kv: kv[1])[0]
            if need_words:
                cnt = {}
                for w in words_of(joined[:80000]):
                    cnt[w] = cnt.get(w, 0) + 1
                for w, c in cnt.items():
                    words[w] = words.get(w, 0) + c
                words_docs[name] = cnt
            if need_money:
                lines = joined.split("\n")
                amts = []
                for i, ln in enumerate(lines):
                    for v in find_values("Amounts", ln):
                        n_ = parse_number(v)
                        if n_ is not None and 0 < n_ < 1e9:
                            amts.append((n_, i))
                            sym = next((c for c in "€$£" if c in v), "€" if re.search(r"eur", v, re.I) else "")
                            if sym:
                                units[sym] = units.get(sym, 0) + 1
                            all_amounts.append((n_, " ".join(ln.split())[:90], name))
                if amts:
                    total = None
                    for i, ln in enumerate(lines):
                        if TOTAL_ROW.search(ln):
                            cand = [n_ for n_, k in amts if k == i] or [n_ for n_, k in amts if i < k <= i + 2]
                            if cand:
                                total = cand[-1]
                    d["total"] = total if total is not None else max(n_ for n_, _k in amts)
                    for i, ln in enumerate(lines[:120]):
                        if date_re.search(ln):
                            ds = parse_dates(ln) or (parse_dates(lines[i + 1]) if i + 1 < len(lines) else [])
                            ds = [x for x in ds if abs((x - today).days) <= 6 * 366]
                            if ds:
                                d["date"] = ds[0]
                                break
                    if d["date"] is None:
                        ds = [x for x in parse_dates("\n".join(lines[:200])) if abs((x - today).days) <= 6 * 366]
                        d["date"] = ds[0] if ds else None
        if job["cancel"]:
            return None
        if not docs:
            return "No files here."
        unit = max(units.items(), key=lambda kv: kv[1])[0] if units else ""
        fm = lambda v: _fmt_num(v, unit)
        lab_m = lambda y, m: f"{_cal.month_abbr[m]} {str(y)[2:]}"
        last12 = []
        for k in range(11, -1, -1):
            y, m = divmod(today.month - 1 - k, 12)
            last12.append((today.year + y, m + 1))
        charts, tables = OrderedDict(), {}

        def add(cid, ch, table=None):
            charts[cid] = ch
            if table:
                tables[cid] = table

        money_docs = [d for d in docs if d["total"]]
        total_money = sum(d["total"] for d in money_docs)
        for cid in want:
            if cid == "money_month" and money_docs:
                per = {k: 0.0 for k in last12}
                n_in = 0
                for d in money_docs:
                    if d["date"] and (d["date"].year, d["date"].month) in per:
                        per[(d["date"].year, d["date"].month)] += d["total"]
                        n_in += 1
                if n_in:
                    vals = [round(per[k], 2) for k in last12]
                    hi = max(range(12), key=lambda i: vals[i])
                    tot = sum(vals) or 1
                    add(cid, {"type": "col", "title": "Amounts per month", "unit": unit, "partial_last": True,
                              "labels": [lab_m(*k) for k in last12], "series": [{"name": "Amount", "values": vals}],
                              "finding": f"Highest: {lab_m(*last12[hi])} with {fm(vals[hi])} "
                                         f"({100 * vals[hi] / tot:.0f}% of the last 12 months). Average "
                                         f"{fm(tot / 12)} a month."},
                        {"name": "Amounts per month", "headers": ["Month", "Amount"],
                         "rows": [[lab_m(*k), fm(v)] for k, v in zip(last12, vals)], "widths": [20, 20]})
            elif cid == "money_year" and money_docs:
                ys = {today.year: [0.0] * 12, today.year - 1: [0.0] * 12}
                for d in money_docs:
                    if d["date"] and d["date"].year in ys:
                        ys[d["date"].year][d["date"].month - 1] += d["total"]
                if any(ys[today.year]) or any(ys[today.year - 1]):
                    cum = lambda xs: [round(sum(xs[:i + 1]), 2) for i in range(12)]
                    this, last = cum(ys[today.year]), cum(ys[today.year - 1])
                    this = [v if i < today.month else None for i, v in enumerate(this)]
                    now_t, now_l = this[today.month - 1] or 0, last[today.month - 1]
                    diff = (f"{abs(now_t - now_l) / now_l * 100:.0f}% {'more' if now_t >= now_l else 'less'} than"
                            if now_l else "")
                    add(cid, {"type": "line", "title": "Running total - this year against last year", "unit": unit,
                              "labels": [_cal.month_abbr[m] for m in range(1, 13)],
                              "series": [{"name": str(today.year), "values": this}] +
                                        ([{"name": str(today.year - 1), "values": last}] if any(last) else []),
                              "colors": [rt_accent(), "#B9B8B2"],
                              "finding": (f"By the end of {_cal.month_name[today.month]}: {fm(now_t)} this year - "
                                          f"{diff} by then last year ({fm(now_l)}).") if now_l else
                                         (f"By the end of {_cal.month_name[today.month]}: {fm(now_t)} this year. "
                                          f"Nothing was found for last year by then.")},
                        {"name": "Running total", "headers": ["Month", str(today.year), str(today.year - 1)],
                         "rows": [[_cal.month_abbr[m + 1], fm(this[m]) if this[m] is not None else "",
                                   fm(last[m])] for m in range(12)], "widths": [12, 16, 16]})
            elif cid == "money_who" and money_docs:
                per = {}
                for d in money_docs:
                    per[d["org"] or "Not named"] = per.get(d["org"] or "Not named", 0) + d["total"]
                items = sorted(per.items(), key=lambda kv: -kv[1])
                if len(items) > 10:
                    items = items[:9] + [("Other", sum(v for _k, v in items[9:]))]
                tot = sum(v for _k, v in items) or 1
                cum_, few, cols, texts = 0, [], [], []
                for k_, v in items:
                    inside = cum_ < 0.8 * tot and k_ != "Other"
                    cum_ += v
                    if inside:
                        few.append(k_)
                    cols.append(rt_accent() if inside else "#B9B8B2")
                    texts.append(f"{fm(v)} · {100 * v / tot:.0f}%")
                add(cid, {"type": "bar", "title": "Who the money is with", "unit": unit,
                          "labels": [k_ for k_, _v in items], "series": [{"name": "Total", "values": [v for _k, v in items]}],
                          "bar_colors": cols, "value_text": texts,
                          "finding": (f"{items[0][0]} alone is {100 * items[0][1] / tot:.0f}% of the total."
                                      if items[0][1] >= 0.8 * tot else
                                      f"{len(few)} of {len(per)} make 80% of the total: " + ", ".join(few[:4]) +
                                      ("…" if len(few) > 4 else "") + ".")},
                    {"name": "Per organisation", "headers": ["Organisation", "Total", "Share"],
                     "rows": [[k_, fm(v), f"{100 * v / tot:.0f}%"] for k_, v in items], "widths": [36, 16, 10]})
            elif cid == "money_sizes" and len(all_amounts) >= 3:
                edges = [0, 10, 50, 100, 250, 500, 1000, 2500, 5000, 10000, 50000, float("inf")]
                vals_ = [a for a, _l, _n in all_amounts]
                cnt = [0] * (len(edges) - 1)
                for v in vals_:
                    for i in range(len(edges) - 1):
                        if edges[i] <= v < edges[i + 1]:
                            cnt[i] += 1
                            break
                lo = next(i for i, c in enumerate(cnt) if c)
                hi = max(i for i, c in enumerate(cnt) if c)
                names = [(f"{_fmt_num(edges[i], unit)}-{_fmt_num(edges[i + 1], unit)}" if edges[i + 1] != float("inf")
                          else f"{_fmt_num(edges[i], unit)}+") for i in range(lo, hi + 1)]
                cnt = cnt[lo:hi + 1]
                top_i = max(range(len(cnt)), key=lambda i: cnt[i])
                add(cid, {"type": "col", "title": "Sizes of the amounts", "labels": names,
                          "series": [{"name": "Amounts", "values": cnt}],
                          "finding": f"Most amounts are {names[top_i]} ({100 * cnt[top_i] / len(vals_):.0f}% of "
                                     f"{len(vals_)})."},
                    {"name": "Sizes of the amounts", "headers": ["Size", "How many"],
                     "rows": [[a, b] for a, b in zip(names, cnt)], "widths": [24, 12]})
            elif cid == "money_top" and all_amounts:
                ta = sorted(all_amounts, key=lambda x: -x[0])[:10]
                add(cid, {"type": "bar", "title": "Largest amounts", "unit": unit,
                          "labels": [x[1][:40] for x in ta], "series": [{"name": "Amount", "values": [x[0] for x in ta]}],
                          "finding": f"The largest: {fm(ta[0][0])} in {self._short(ta[0][2], 40)}."},
                    {"name": "Largest amounts", "headers": ["Amount", "Line", "Document"],
                     "rows": [[fm(x[0]), x[1], x[2]] for x in ta], "widths": [12, 50, 30]})
            elif cid == "busy_days" and sum(days.values()) >= 3:
                start = today - datetime.timedelta(days=today.weekday() + 7 * 52)
                win = {k: v for k, v in days.items() if start.isoformat() <= k <= today.isoformat()}
                if win:
                    best = max(win.items(), key=lambda kv: kv[1])
                    bd = datetime.date.fromisoformat(best[0])
                    wd = [0] * 7
                    for k, v in win.items():
                        wd[datetime.date.fromisoformat(k).weekday()] += v
                    add(cid, {"type": "calendar", "title": "Busy days - the last 12 months", "days": win,
                              "end": today.isoformat(), "weeks": 53, "what": "Dates",
                              "foot": "Dates written in your documents",
                              "finding": f"Busiest day: {bd.strftime('%a')} {bd.day} {bd.strftime('%b %Y')} "
                                         f"({best[1]} dates). {_cal.day_name[max(range(7), key=lambda i: wd[i])]}s "
                                         f"have the most."},
                        {"name": "Busiest days", "headers": ["Day", "Dates"],
                         "rows": [[datetime.date.fromisoformat(k).strftime("%a %d %b %Y"), v] for k, v in
                                  sorted(win.items(), key=lambda kv: -kv[1])[:15]], "widths": [20, 10]})
            elif cid == "weekdays" and sum(weekdays) >= 3:
                tot = sum(weekdays)
                hi = max(range(7), key=lambda i: weekdays[i])
                add(cid, {"type": "col", "title": "Days of the week", "labels": [_cal.day_abbr[i] for i in range(7)],
                          "series": [{"name": "Dates", "values": weekdays}],
                          "finding": f"{_cal.day_name[hi]}s: {100 * weekdays[hi] / tot:.0f}% of the dates."},
                    {"name": "Days of the week", "headers": ["Day", "Dates"],
                     "rows": [[_cal.day_name[i], weekdays[i]] for i in range(7)], "widths": [16, 10]})
            elif cid == "saved_month":
                per = {k: 0 for k in last12}
                for d in docs:
                    if d["mtime"]:
                        dd = datetime.date.fromtimestamp(d["mtime"])
                        if (dd.year, dd.month) in per:
                            per[(dd.year, dd.month)] += 1
                vals = [per[k] for k in last12]
                if any(vals):
                    hi = max(range(12), key=lambda i: vals[i])
                    add(cid, {"type": "col", "title": "Documents saved per month", "partial_last": True,
                              "labels": [lab_m(*k) for k in last12], "series": [{"name": "Documents", "values": vals}],
                              "finding": f"This month: {vals[-1]}. The busiest: {lab_m(*last12[hi])} ({vals[hi]})."},
                        {"name": "Saved per month", "headers": ["Month", "Documents"],
                         "rows": [[lab_m(*k), v] for k, v in zip(last12, vals)], "widths": [14, 12]})
            elif cid == "doc_age":
                bands = [("Under a month", 31), ("1-3 months", 92), ("3-12 months", 366), ("1-2 years", 731),
                         ("Over 2 years", 10 ** 9)]
                cnt = [0] * len(bands)
                for d in docs:
                    if d["mtime"]:
                        age = (today - datetime.date.fromtimestamp(d["mtime"])).days
                        cnt[next(i for i, (_n, lim) in enumerate(bands) if age < lim)] += 1
                tot = sum(cnt)
                if tot:
                    old = cnt[3] + cnt[4]
                    seq = rt_seq()
                    add(cid, {"type": "bar", "title": "How old the documents are", "labels": [b[0] for b in bands],
                              "series": [{"name": "Documents", "values": cnt}],
                              "bar_colors": [seq[4], seq[6], seq[8], seq[10], seq[12]],
                              "value_text": [f"{c} · {100 * c / tot:.0f}%" for c in cnt],
                              "finding": f"{100 * old / tot:.0f}% have not changed for over a year." if old else
                                         "All of them changed in the last year."},
                        {"name": "Age", "headers": ["Last changed", "Documents"],
                         "rows": [[b[0], c] for b, c in zip(bands, cnt)], "widths": [20, 12]})
            elif cid in ("deadlines", "deadlines_month"):
                if "_exp" not in P:
                    try:
                        P["_exp"] = self._expiry_items(dict(P, terms=[], adv={}), job)
                    except Exception:
                        P["_exp"] = []
                items = P["_exp"]
                if cid == "deadlines" and items:
                    # 4.0: a timeline - 30 days back to 90 ahead, Today line, late in red-orange
                    win = [x for x in items if -30 <= x["left"] <= 90]
                    near = sorted(win, key=lambda x: x["left"])[:22]
                    if not near:
                        near = sorted([x for x in items if -365 <= x["left"] <= 365],
                                      key=lambda x: abs(x["left"]))[:8]
                        near.sort(key=lambda x: x["left"])
                    if near:
                        n_exp = sum(1 for x in items if -365 <= x["left"] < 0)
                        n30 = sum(1 for x in items if 0 <= x["left"] <= 30)
                        nxt = next((x for x in sorted(items, key=lambda x: x["left"]) if x["left"] >= 0), None)
                        out_n = sum(1 for x in items if -365 <= x["left"] <= 365) - len(near)
                        add(cid, {"type": "timeline", "title": "Expired & expiring",
                                  "items": [{"label": (x["who"] + " - " if x["who"] else "") + x["what"],
                                             "left": x["left"], "date": x["date"].isoformat()} for x in near],
                                  "today": today.isoformat(), "back": 30, "ahead": 90,
                                  "foot": f"+ {out_n} more within a year, outside this window" if out_n > 0 else "",
                                  "finding": (f"{n_exp} expired in the last year; {n30} expire in the next 30 days."
                                              if n_exp or n30 else "Nothing expired or expires in the next 30 days.") +
                                             (f" Next: {(nxt['who'] + ' - ') if nxt['who'] else ''}{nxt['what']} on "
                                              f"{nxt['date'].strftime('%d %b %Y')}." if nxt else "")},
                            {"name": "Deadlines", "headers": ["Date", "Days left", "Who", "What", "Document"],
                             "rows": [[x["date"].strftime("%d/%m/%Y"), x["left"], x["who"], x["what"], x["file"]]
                                      for x in near], "widths": [11, 9, 20, 16, 30]})
                elif cid == "deadlines_month" and items:
                    nxt12 = []
                    for k in range(12):
                        y, m = divmod(today.month - 1 + k, 12)
                        nxt12.append((today.year + y, m + 1))
                    per = {k: 0 for k in nxt12}
                    for x in items:
                        if (x["date"].year, x["date"].month) in per and x["left"] >= 0:
                            per[(x["date"].year, x["date"].month)] += 1
                    vals = [per[k] for k in nxt12]
                    if any(vals):
                        hi = max(range(12), key=lambda i: vals[i])
                        add(cid, {"type": "col", "title": "Deadlines in the next 12 months",
                                  "labels": [lab_m(*k) for k in nxt12], "series": [{"name": "Deadlines",
                                                                                    "values": vals}],
                                  "finding": f"The busiest month: {lab_m(*nxt12[hi])} ({vals[hi]})."},
                            {"name": "Deadlines per month", "headers": ["Month", "Deadlines"],
                             "rows": [[lab_m(*k), v] for k, v in zip(nxt12, vals)], "widths": [14, 12]})
            elif cid == "people_top" and people:
                tp = sorted(people.items(), key=lambda kv: -kv[1])[:12]
                p0 = tp[0][0]
                add(cid, {"type": "bar", "title": "People named most", "labels": [p_ for p_, _c in tp],
                          "series": [{"name": "Pages", "values": [c for _p, c in tp]}],
                          "finding": f"{p0} is named most: on {tp[0][1]} page{'s' if tp[0][1] != 1 else ''} in "
                                     f"{len(people_docs.get(p0, {}))} "
                                     f"document{'s' if len(people_docs.get(p0, {})) != 1 else ''}."},
                    {"name": "People", "headers": ["Person", "Pages", "Documents"],
                     "rows": [[p_, c, len(people_docs.get(p_, {}))] for p_, c in tp], "widths": [30, 10, 10]})
            elif cid == "people_where" and len(people) >= 2:
                tp = [p_ for p_, _c in sorted(people.items(), key=lambda kv: -kv[1])[:10]]
                by_book = P["lib"] and len({d["folder"] for d in docs}) > 1
                key_of = (lambda nm: next((P["labels"].get(d["folder"], d["folder"]) for d in docs if d["name"] == nm),
                                          nm)) if by_book else (lambda nm: nm)
                col_tot = {}
                for p_ in tp:
                    for nm, c in people_docs.get(p_, {}).items():
                        col_tot[key_of(nm)] = col_tot.get(key_of(nm), 0) + c
                cols_ = [k_ for k_, _c in sorted(col_tot.items(), key=lambda kv: -kv[1])[:6]]
                mat = []
                for p_ in tp:
                    row = {}
                    for nm, c in people_docs.get(p_, {}).items():
                        row[key_of(nm)] = row.get(key_of(nm), 0) + c
                    mat.append([row.get(k_, 0) for k_ in cols_])
                if cols_:
                    spread = max(range(len(tp)), key=lambda i: sum(1 for v in mat[i] if v))
                    add(cid, {"type": "heat", "title": "Who is in which " + ("book" if by_book else "document"),
                              "rows": tp, "cols": [self._short(c_, 16) for c_ in cols_], "matrix": mat,
                              "finding": f"{tp[spread]} is in the most "
                                         f"{'books' if by_book else 'documents'} "
                                         f"({sum(1 for v in mat[spread] if v)} of {len(cols_)} shown)."},
                        {"name": "Who is where", "headers": ["Person"] + [self._short(c_, 24) for c_ in cols_],
                         "rows": [[p_] + r for p_, r in zip(tp, mat)], "widths": [22] + [10] * len(cols_)})
            elif cid == "orgs_top" and orgs:
                to = sorted(orgs.items(), key=lambda kv: -kv[1])[:10]
                add(cid, {"type": "bar", "title": "Organisations named most", "labels": [o for o, _c in to],
                          "series": [{"name": "Times", "values": [c for _o, c in to]}],
                          "finding": f"{to[0][0]} is named most ({to[0][1]} times)."},
                    {"name": "Organisations", "headers": ["Organisation", "Times"],
                     "rows": [[o, c] for o, c in to], "widths": [36, 10]})
            elif cid == "kinds":
                kc = {}
                for d in docs:
                    kc[d["kind"]] = kc.get(d["kind"], 0) + 1
                items = sorted(kc.items(), key=lambda kv: -kv[1])
                if len(items) > 8:
                    items = items[:7] + [("Other", sum(v for _k, v in items[7:]))]
                tot = len(docs)
                add(cid, {"type": "bar", "title": "Kinds of documents", "labels": [k_ for k_, _v in items],
                          "series": [{"name": "Documents", "values": [v for _k, v in items]}],
                          "value_text": [f"{v} · {100 * v / tot:.0f}%" for _k, v in items],
                          "finding": f"The most common kind: {items[0][0]} - {items[0][1]} of {tot} "
                                     f"({100 * items[0][1] / tot:.0f}%)."},
                    {"name": "Kinds", "headers": ["Kind", "Documents", "Share"],
                     "rows": [[k_, v, f"{100 * v / tot:.0f}%"] for k_, v in items], "widths": [24, 12, 10]})
            elif cid == "pages":
                bands = [("1 page", 1, 1), ("2-5", 2, 5), ("6-20", 6, 20), ("21-100", 21, 100), ("Over 100", 101, 10 ** 9)]
                cnt = [sum(1 for d in docs if a <= d["pages"] <= b) for _n, a, b in bands]
                hi = max(range(5), key=lambda i: cnt[i])
                big = max(docs, key=lambda d: d["pages"])
                add(cid, {"type": "col", "title": "Size of the documents (pages)", "labels": [b[0] for b in bands],
                          "series": [{"name": "Documents", "values": cnt}],
                          "finding": f"The most common size: {bands[hi][0]}{' pages' if 0 < hi < 4 else ''} "
                                     f"({cnt[hi]} of {len(docs)}). The longest: {self._short(big['name'], 40)} "
                                     f"({big['pages']} pages)."},
                    {"name": "Pages", "headers": ["Pages", "Documents"],
                     "rows": [[b[0], c] for b, c in zip(bands, cnt)], "widths": [14, 12]})
            elif cid == "books":
                per = OrderedDict()
                for d in docs:
                    b_ = P["labels"].get(d["folder"], d["folder"])
                    a_ = per.setdefault(b_, [0, 0])
                    a_[0] += 1
                    a_[1] += d["pages"]
                if len(per) > 1:
                    items = sorted(per.items(), key=lambda kv: -kv[1][1])[:12]
                    add(cid, {"type": "bar", "title": "Books compared - pages", "labels": [k_ for k_, _v in items],
                              "series": [{"name": "Pages", "values": [v[1] for _k, v in items]}],
                              "value_text": [f"{v[1]} pages · {v[0]} docs" for _k, v in items],
                              "finding": f"The biggest book: {items[0][0]} ({items[0][1][1]} pages, "
                                         f"{items[0][1][0]} documents)."},
                        {"name": "Books", "headers": ["Book", "Documents", "Pages"],
                         "rows": [[k_, v[0], v[1]] for k_, v in items], "widths": [30, 12, 12]})
            elif cid == "status" and P.get("status"):
                stat = P["status"]
                names_ = [s_ for s_, _c in STATUSES] + ["No status"]
                per = OrderedDict()
                for d in docs:
                    b_ = P["labels"].get(d["folder"], d["folder"]) if P["lib"] else "These documents"
                    row = per.setdefault(b_, {k_: 0 for k_ in names_})
                    tag = stat.get(d["path"]) or "No status"
                    row[tag if tag in row else "No status"] += 1
                used = [k_ for k_ in names_ if any(r[k_] for r in per.values())]
                if used and used != ["No status"]:
                    totals = {k_: sum(r[k_] for r in per.values()) for k_ in used}
                    tot = sum(totals.values()) or 1
                    add(cid, {"type": "stack", "title": "Status of the documents", "labels": list(per),
                              "series": [{"name": k_, "values": [per[b_][k_] for b_ in per]} for k_ in used],
                              "colors": [dict(STATUSES).get(k_, "#D9D8D3") for k_ in used],
                              "finding": " · ".join(f"{k_}: {100 * v / tot:.0f}%" for k_, v in
                                                    sorted(totals.items(), key=lambda kv: -kv[1])[:4]) + "."},
                        {"name": "Status", "headers": ["Book"] + used,
                         "rows": [[b_] + [per[b_][k_] for k_ in used] for b_ in per], "widths": [26] + [10] * len(used)})
            elif cid == "marks" and P.get("marks"):
                kc = {}
                for mk in P["marks"]:
                    k_ = KIND_LABEL.get(mk.get("kind"), mk.get("kind") or "Mark")
                    kc[k_] = kc.get(k_, 0) + 1
                items = sorted(kc.items(), key=lambda kv: -kv[1])
                add(cid, {"type": "bar", "title": "My marks", "labels": [k_ for k_, _v in items],
                          "series": [{"name": "Marks", "values": [v for _k, v in items]}],
                          "finding": f"{len(P['marks'])} marks - most are {items[0][0].lower()}s "
                                     f"({items[0][1]})."},
                    {"name": "Marks", "headers": ["Kind", "Marks"], "rows": [list(x) for x in items],
                     "widths": [20, 10]})
            elif cid == "words" and words:
                # 4.0: a sorted bar with the counts (a word cloud shows no order and no numbers)
                top_w = sorted(words.items(), key=lambda kv: -kv[1])[:15]
                n_in = {w: sum(1 for c_ in words_docs.values() if c_.get(w)) for w, _c in top_w}
                add(cid, {"type": "bar", "title": "Key words", "labels": [w for w, _c in top_w],
                          "series": [{"name": "Times", "values": [c for _w, c in top_w]}],
                          "value_text": [f"{c} · in {n_in[w]} doc{'s' if n_in[w] != 1 else ''}" for w, c in top_w],
                          "finding": f"“{top_w[0][0]}” is used most: {top_w[0][1]} times in {n_in[top_w[0][0]]} "
                                     f"document{'s' if n_in[top_w[0][0]] != 1 else ''}."},
                    {"name": "Key words", "headers": ["Word", "Times", "Documents"],
                     "rows": [[w, c, n_in[w]] for w, c in top_w], "widths": [20, 10, 10]})
            elif cid in ("contacts_sure", "email_domains"):
                if "_contacts" not in P:
                    try:
                        r_ = self._job_contacts(dict(P, terms=[], adv={"merge": True}, inc=["Name", "Phone", "Email"]),
                                                job)
                        P["_contacts"] = r_ if isinstance(r_, dict) else {}
                    except Exception:
                        P["_contacts"] = {}
                cb = P["_contacts"].get("blocks") or []
                want_t = "How sure each link is" if cid == "contacts_sure" else "Email domains"
                ch_ = next((dict(b[1]) for b in cb if b[0] == "chart" and b[1].get("title") == want_t), None)
                if ch_:
                    if cid == "contacts_sure":
                        ch_["title"] = "Emails & phones with their person"
                        vals_ = [(sr.get("name"), (sr.get("values") or [0])[0]) for sr in ch_.get("series") or []]
                        tb_ = {"name": "Linked", "headers": ["How", "Emails & phones"],
                               "rows": [[a_, b_] for a_, b_ in vals_], "widths": [20, 14]}
                    else:
                        tb_ = {"name": "Email domains", "headers": ["Domain", "People"],
                               "rows": [[a_, b_] for a_, b_ in zip(ch_.get("labels") or [],
                                                                   (ch_.get("series") or [{}])[0].get("values") or [])],
                               "widths": [30, 10]}
                    add(cid, ch_, tb_)
            elif cid == "words_where" and words and len(words_docs) > 1:
                tw = [w for w, _c in sorted(words.items(), key=lambda kv: -kv[1])[:8]]
                dsc = sorted(words_docs, key=lambda nm: -sum(words_docs[nm].get(w, 0) for w in tw))[:6]
                mat = [[words_docs[nm].get(w, 0) for nm in dsc] for w in tw]
                add(cid, {"type": "heat", "title": "Key words in each document", "rows": tw,
                          "cols": [self._short(nm, 16) for nm in dsc], "matrix": mat,
                          "finding": f"“{tw[0]}” is used most in {self._short(dsc[max(range(len(dsc)), key=lambda j: mat[0][j])], 40)}."},
                    {"name": "Key words per document", "headers": ["Word"] + [self._short(nm, 24) for nm in dsc],
                     "rows": [[w] + r for w, r in zip(tw, mat)], "widths": [16] + [10] * len(dsc)})
        if auto:                                  # 'Pick for me': the charts these documents have data for
            keep = [c for c in self.CHART_AUTO if c in charts][:9]
            charts = OrderedDict((c, charts[c]) for c in keep)
        if not charts:
            return ("There is not enough in these documents for those charts yet (no amounts, dates or names were "
                    "found). Try other charts - or 'Pick for me'.")
        groups = {g[0]: g[1] for g in self.CHART_GALLERY}
        n_dates = sum(days.values())
        kp = [self._kp("Documents", len(docs)), self._kp("Pages", sum(d["pages"] for d in docs))]
        if money_docs:
            kp.append(self._kp("Total amount", fm(total_money)))
        kp.append(self._kp("People named", len(people)))
        if not money_docs:
            kp.append(self._kp("Dates", n_dates))
        # 4.0: the 3-30-300 order - what was read (scope), the key numbers, what needs you, then the charts
        n_dated = sum(1 for d in docs if d.get("date"))
        scope = [f"{len(docs)} document{'s' if len(docs) != 1 else ''}",
                 f"{sum(d['pages'] for d in docs):,} pages", f"read {today.strftime('%d %b %Y')}"]
        if money_docs:
            scope.append(f"amounts found in {len(money_docs)} of {len(docs)}")
        if n_dated:
            scope.append(f"dated {n_dated} of {len(docs)}")
        blocks = [("p", "  ·  ".join(scope)), ("kpis", kp)]
        att = []
        for x in sorted(P.get("_exp") or [], key=lambda x: x["left"]):
            if -365 <= x["left"] < 0:
                att.append((0, f"{(x['who'] + ' - ') if x['who'] else ''}{x['what']}: expired "
                               f"{-x['left']} day{'s' if x['left'] != -1 else ''} ago ({x['date'].strftime('%d %b %Y')})"
                               f" - {self._short(x['file'], 40)}."))
            elif 0 <= x["left"] <= 30:
                att.append((1, f"{(x['who'] + ' - ') if x['who'] else ''}{x['what']}: "
                               f"{'today' if x['left'] == 0 else 'in ' + str(x['left']) + ' days'} "
                               f"({x['date'].strftime('%d %b %Y')}) - {self._short(x['file'], 40)}."))
        cb_ = (P.get("_contacts") or {}).get("blocks") or []
        nl_ = next((len(b[1].get("rows") or []) for b in cb_ if b[0] == "table" and b[1].get("name") == "Not linked"),
                   0)
        if nl_:
            att.append((2, f"{nl_} email(s) / phone(s) have no person - see the Contacts report."))
        if att or "_exp" in P:
            blocks.append(("h", "Needs attention"))
            if att:
                att.sort(key=lambda a: a[0])
                for _k, line in att[:10]:
                    blocks.append(("li", line))
                if len(att) > 10:
                    blocks.append(("p", f"… and {len(att) - 10} more."))
            else:
                blocks.append(("p", "Nothing expired or due in the next 30 days."))
        last_g = None
        for cid, ch in charts.items():
            g_ = groups.get(cid)
            if g_ != last_g:
                blocks.append(("h", g_))
                last_g = g_
            blocks.append(("chart", ch))
        blocks.append(("h", "The numbers behind the charts"))
        for cid in charts:
            if cid in tables:
                t_ = dict(tables[cid])
                if len(t_["rows"]) > 12:
                    t_["rows"] = t_["rows"][:12]
                blocks.append(("h3", charts[cid].get("title") or t_["name"]))
                blocks.append(("table", t_))
        return {"title": f"Charts - {P['title']}", "subtitle": self._subtitle(P["scope"], f"{len(charts)} charts"),
                "blocks": blocks, "_name": "Charts - " + P["title"], "_view": "overview"}

    # ---- Data quality -------------------------------------------------------------------------------------------
    def _job_quality(self, P, job):
        r = self._job_pack(dict(P, pack="quality"), job)
        if isinstance(r, dict):
            r["title"] = "Data quality check"
            r["_name"] = "Data quality - " + P["title"]
        return r

    def _job_analysis(self, P, job):
        """Your documents at a glance: key numbers and a few clear charts (kinds of documents, key words, people
        named most, dates per month), then short tables. From the texts BindLens already read - quick."""
        import datetime
        per_file, types, people, words, months = [], {}, {}, {}, {}
        n_pages = n_words = n_blank = n_mail = n_phone = n_dates = 0
        people_files = {}
        today = datetime.date.today()
        for name, folder, rel, path, texts in self._texts(P, job):
            joined = "\n".join(texts)
            wc = len(re.findall(r"[A-Za-zÀ-ÿ]{2,}", joined))
            dt = doc_type(joined)
            types[dt] = types.get(dt, 0) + 1
            n_blank += sum(1 for t in texts if len(t.strip()) < 20)
            n_pages += len(texts)
            n_words += wc
            f_people, f_dates = set(), 0
            for t in texts:
                for p_ in self._people_on_page(t):
                    people[p_] = people.get(p_, 0) + 1
                    f_people.add(p_)
                    people_files.setdefault(p_, set()).add(name)
                n_mail += len(find_values("Emails", t))
                n_phone += len(find_values("Phone numbers", t))
                for d_ in parse_dates(t):
                    if abs((d_ - today).days) <= 5 * 366:          # (not birthdays or old history)
                        months[(d_.year, d_.month)] = months.get((d_.year, d_.month), 0) + 1
                        f_dates += 1
            n_dates += f_dates
            for w in words_of(joined[:80000]):
                words[w] = words.get(w, 0) + 1
            per_file.append([name, len(texts), wc, dt, len(f_people), f_dates])
        if job["cancel"]:
            return None
        if not per_file:
            return "No files here."
        blocks = [("kpis", [self._kp("Files", len(per_file)), self._kp("Pages", n_pages), self._kp("Words", n_words),
                            self._kp("People named", len(people)), self._kp("Emails & phones", n_mail + n_phone),
                            self._kp("Dates", n_dates)])]
        if n_blank:
            blocks.append(("alert", {"tone": "warning", "text": f"{n_blank} page(s) have no text (scanned?) - right-click "
                                                                f"their file > Make scanned pages searchable, so "
                                                                f"reports can read them too."}))
        blocks.append(("chart", {"type": "donut", "title": "Kinds of documents", "labels": list(types),
                                 "series": [{"values": list(types.values())}], "center": "files",
                                 "link": {"table": "Files", "col": "Kind"}}))
        top_w = sorted(words.items(), key=lambda kv: -kv[1])[:45]
        if top_w:
            blocks.append(("chart", {"type": "cloud", "title": "Key words", "words": top_w}))
        top_p = sorted(people.items(), key=lambda kv: -kv[1])[:12]
        if top_p:
            blocks.append(("chart", {"type": "bar", "title": "People named most", "labels": [p_ for p_, _c in top_p],
                                     "series": [{"name": "Pages", "values": [c for _p, c in top_p]}],
                                     "link": {"table": "People", "col": "Name"}}))
        if months:
            keys = sorted(months)[-18:]
            blocks.append(("chart", {"type": "bar", "title": "Dates per month",
                                     "labels": [datetime.date(y, m, 1).strftime("%b %Y") for y, m in keys],
                                     "series": [{"name": "Dates", "values": [months[k] for k in keys]}]}))
        big = sorted(per_file, key=lambda r: -r[1])[:12]
        if len(per_file) > 1:
            blocks.append(("chart", {"type": "bar", "title": "Pages per file",
                                     "labels": [self._short(r[0]) for r in big],
                                     "series": [{"name": "Pages", "values": [r[1] for r in big]}],
                                     "link": {"table": "Files", "col": "File"}}))
        blocks.append(("h", "Files"))
        blocks.append(("table", {"name": "Files", "headers": ["File", "Pages", "Words", "Kind", "People", "Dates"],
                                 "rows": per_file, "widths": [44, 7, 9, 16, 8, 8]}))
        if people:
            blocks.append(("h", "People"))
            blocks.append(("table", {"name": "People", "headers": ["Name", "Pages", "Files"],
                                     "rows": [[p_, c, len(people_files.get(p_, ()))]
                                              for p_, c in sorted(people.items(), key=lambda kv: -kv[1])[:300]],
                                     "widths": [30, 8, 8]}))
        return {"title": f"Analysis - {P['title']}", "subtitle": self._subtitle(P["scope"]), "blocks": blocks,
                "_name": "Analysis - " + P["title"]}

    # ---- People ------------------------------------------------------------------------------------------
    def _job_contacts(self, P, job):
        only = [t.lower() for t in P["terms"]]
        phones_re = EXTRACT_PATTERNS["Phone numbers"]
        adv = P["adv"]
        pf = lambda tx: ("@" in tx or phones_re.search(tx)) and (not only or any(o in tx.lower() for o in only))
        people = OrderedDict()
        unlinked = []
        last_file, last_person = None, ""
        for name, folder, rel, page, rows, doc, pi in self._walk_pages(P, job, pf):
            if name != last_file:
                last_file, last_person = name, ""
            for i, row in enumerate(rows):
                lp = _label_person(row["text"])
                if lp:
                    last_person = lp
                for j, cell in enumerate(row["cells"] if row.get("table") else [row["text"]]):
                    vals = [("Email", v) for v in find_values("Emails", cell)] + \
                           [("Phone", v) for v in find_values("Phone numbers", cell)]
                    if not vals:
                        continue
                    for kind, v in vals:
                        who, how = link_value(rows, i, j if row.get("table") else 0, last_person, v)
                        text = row["text"]
                        if only and not any(o in text.lower() or o in who.lower() for o in only):
                            continue
                        if not who:
                            unlinked.append([v, kind, text, name, page])
                            continue
                        org = organisation(row)
                        addr = ", ".join(find_values("Addresses", " | ".join(r["text"] for r in rows[max(0, i - 2):i + 2])))
                        # 4.0: the same person written two ways (Seán Ó Briain / SEAN O'BRIAIN) is one person
                        nk = name_key(who)
                        key = nk if adv.get("merge", True) and nk[0] else (who.lower(), v)
                        rec = people.get(key)
                        if rec is None:
                            rec = people[key] = {"Name": who, "Linked by": how, "Organisation": org, "Phone": [],
                                                 "Email": [], "Address": addr, "File": [name], "Page": page,
                                                 "Whole row": text, "Sure": link_sure(how)}
                        if v not in rec[kind]:
                            rec[kind].append(v)
                        if len(who) > len(rec["Name"]) and "." not in who:
                            rec["Name"] = who                    # the fuller spelling (Seán, not Sean)
                        rec["Organisation"] = rec["Organisation"] or org
                        rec["Address"] = rec["Address"] or addr
                        if link_sure(how) > rec["Sure"]:
                            rec["Linked by"], rec["Sure"] = how, link_sure(how)
                        if name not in rec["File"]:
                            rec["File"].append(name)
        if job["cancel"]:
            return None
        if adv.get("merge", True):
            # 4.0: 'M. Ryan' and 'Mary Ryan' with the same email or phone are one person (different first names
            # sharing one = a family / office contact: kept apart)
            plist = list(people.values())
            for a_ in range(len(plist)):
                ra = plist[a_]
                if ra.get("_gone"):
                    continue
                for b_ in range(a_ + 1, len(plist)):
                    rb = plist[b_]
                    if rb.get("_gone"):
                        continue
                    shared = (set(x.lower() for x in ra["Email"]) & set(x.lower() for x in rb["Email"])) or \
                        (set(re.sub(r"\D", "", x)[-9:] for x in ra["Phone"]) &
                         set(re.sub(r"\D", "", x)[-9:] for x in rb["Phone"]))
                    if shared and same_person(ra["Name"], rb["Name"]):
                        keep, gone = (ra, rb) if len(ra["Name"]) >= len(rb["Name"]) else (rb, ra)
                        for k_ in ("Phone", "Email", "File"):
                            for x in gone[k_]:
                                if x not in keep[k_]:
                                    keep[k_].append(x)
                        if gone["Sure"] > keep["Sure"]:
                            keep["Linked by"], keep["Sure"] = gone["Linked by"], gone["Sure"]
                        gone["_gone"] = True
                        if keep is rb:
                            break
            people = OrderedDict((k_, r_) for k_, r_ in people.items() if not r_.get("_gone"))
        recs = [r for r in people.values() if not (adv.get("only_phone") and not r["Phone"]) and
                not (adv.get("only_email") and not r["Email"])]
        if not recs and not unlinked:
            return "No phone numbers or emails found here."
        cols = [c for c in ("Name", "Sure", "Linked by", "Organisation", "Phone", "Email", "Address", "File", "Page",
                            "Whole row") if c in P["inc"] or c in ("Linked by", "Sure")] or ["Name", "Phone", "Email"]
        if "Name" not in cols:
            cols.insert(0, "Name")
        rows, colors = [], []
        for rec in sorted(recs, key=lambda r: r["Name"].lower()):
            row = []
            for c in cols:
                v = rec[c]
                if c == "File":
                    v = v[0] + (f"  (+{len(v) - 1} more)" if len(v) > 1 else "")
                elif c == "Sure":
                    v = f"{v}%"
                elif isinstance(v, list):
                    v = ", ".join(v)
                row.append(v)
            rows.append(row)
            colors.append(None if rec["Sure"] >= 85 else (STATUS_COL["warning"] if rec["Sure"] >= 60 else
                                                          STATUS_COL["serious"]))
        widths = {"Name": 20, "Sure": 7, "Linked by": 22, "Organisation": 20, "Phone": 16, "Email": 28, "Address": 30,
                  "File": 24, "Page": 6, "Whole row": 50}
        sure = sum(1 for r in recs if r["Sure"] >= 85)
        check = sum(1 for r in recs if 60 <= r["Sure"] < 85)
        unsure = len(recs) - sure - check
        blocks = [("kpis", [self._kp("People", len(recs)), self._kp("With a phone", sum(1 for r in recs if r["Phone"])),
                            self._kp("With an email", sum(1 for r in recs if r["Email"])),
                            self._kp("To check", check + unsure, "warning" if check + unsure else None),
                            self._kp("Without a person", len(unlinked), "serious" if unlinked else None)])]
        # 4.0: what needs you first - the links to check, in plain words
        if check + unsure or unlinked:
            bits = []
            if unsure:
                bits.append(f"{unsure} linked only by the email address or by a name earlier in the file (orange)")
            if check:
                bits.append(f"{check} linked by a name nearby (yellow)")
            if unlinked:
                bits.append(f"{len(unlinked)} email(s) / phone(s) have no person - listed at the end")
            blocks.append(("alert", {"tone": "serious", "text": "; ".join(bits) + "."}))
        else:
            blocks.append(("alert", {"tone": "good", "text": "Every contact was found on the same row, under a "
                                                             "label or in an email header - nothing to check."}))
        if recs or unlinked:
            blocks.append(("chart", {"type": "stack", "title": "How sure each link is",
                                     "labels": ["Emails & phones"],
                                     "series": [{"name": "Sure", "values": [sure]},
                                                {"name": "Check", "values": [check]},
                                                {"name": "Unsure", "values": [unsure]},
                                                {"name": "No person", "values": [len(unlinked)]}],
                                     "colors": [rt_accent(), "#E69F00", "#D55E00", "#BDBDBD"],
                                     "finding": f"{sure} of {len(recs) + len(unlinked)} were found on the same row, "
                                                f"under a label or in an email header."}))
        dom = {}
        for r in recs:
            for e in r["Email"]:
                d_ = e.split("@")[-1].lower()
                dom[d_] = dom.get(d_, 0) + 1
        if len(dom) >= 3:
            items = sorted(dom.items(), key=lambda kv: -kv[1])
            blocks.append(("chart", {"type": "bar", "title": "Email domains", "labels": [k for k, _v in items],
                                     "series": [{"name": "Emails", "values": [v for _k, v in items]}]}))
        blocks.append(("table", {"name": "Contacts", "headers": cols, "rows": rows, "colors": colors,
                                 "widths": [widths[c] for c in cols]}))
        if unlinked and adv.get("unlinked", True):
            blocks.append(("h", f"Not linked to a person  ·  {len(unlinked)}"))
            blocks.append(("table", {"name": "Not linked", "headers": ["Value", "Kind", "Row", "File", "Page"],
                                     "rows": unlinked, "widths": [24, 8, 44, 22, 6]}))
        return {"title": "Contact list", "subtitle": self._subtitle(P["scope"], f"{len(rows)} people"),
                "blocks": blocks, "_name": "Contacts - " + P["title"]}

    def _people_on_page(self, text):
        found = set()
        for line in text.split("\n"):
            lp = _label_person(line)
            if lp:
                found.add(lp)
            for m_ in NAME_IN_TEXT.finditer(line):
                p = person_like(m_.group(0))
                if p and len(p.split()) >= 2:
                    found.add(p)
        return found

    ORG_RE = re.compile(r"\b((?:[A-Z][\w&'’.-]+ ){0,4}(?:Ltd|Limited|Ltd\.|plc|PLC|Inc|LLC|School|Council|Department|"
                        r"Centre|Center|Creche|Crèche|Montessori|Hospital|Clinic|University|College|Bank|Services|"
                        r"Association|Club|Group|Trust|Foundation|Agency|Authority|Board|Office|Company|Society|"
                        r"Institute|Academy|Nursery|Pharmacy|Partners|Solicitors|Tusla|Pobal|HSE|Revenue)\b)")

    def _job_network(self, P, job):
        only = [t.lower() for t in P["terms"]]
        pairs, cnt = {}, {}
        for name, folder, rel, path, texts in self._texts(P, job):
            for pi, t in enumerate(texts):
                ppl = self._people_on_page(t)
                if P["adv"].get("orgs"):
                    ppl |= {m_.group(1).strip() for m_ in self.ORG_RE.finditer(t)}
                ppl = sorted(ppl)[:40]
                for p in ppl:
                    cnt[p] = cnt.get(p, 0) + 1
                for a_ in range(len(ppl)):
                    for b_ in range(a_ + 1, len(ppl)):
                        k = (ppl[a_], ppl[b_])
                        pairs[k] = pairs.get(k, 0) + 1
        if job["cancel"]:
            return None
        if only:
            pairs = {k: v for k, v in pairs.items() if any(o in k[0].lower() or o in k[1].lower() for o in only)}
        if not pairs:
            return "No people were found together on the same pages."
        top_pairs = sorted(pairs.items(), key=lambda kv: -kv[1])
        nodes_set = []
        for (a_, b_), v in top_pairs:
            for x in (a_, b_):
                if x not in nodes_set:
                    nodes_set.append(x)
            if len(nodes_set) >= 14:
                break
        nodes = [(n_, cnt.get(n_, 1)) for n_ in nodes_set[:14]]
        edges = [(a_, b_, v) for (a_, b_), v in top_pairs if a_ in nodes_set[:14] and b_ in nodes_set[:14]][:40]
        blocks = [("kpis", [self._kp("People", len(cnt)), self._kp("Pairs", len(pairs)),
                            self._kp("Most connected", max(nodes, key=lambda n_: sum(e[2] for e in edges if n_[0] in e[:2]))[0])]),
                  ("chart", {"type": "network", "title": "Who appears with whom", "nodes": nodes, "edges": edges}),
                  ("table", {"name": "Together", "headers": ["Person", "With", "Pages together"],
                             "rows": [[a_, b_, v] for (a_, b_), v in top_pairs[:500]], "widths": [26, 26, 12]})]
        return {"title": "Who appears with whom", "subtitle": self._subtitle(P["scope"], f"{len(cnt)} people"),
                "blocks": blocks, "_name": "Network - " + P["title"]}

    def _job_entities(self, P, job):
        kinds = OrderedDict([("People", {}), ("Organisations", {}), ("Places / Eircodes", {}), ("Emails", {}),
                             ("Phones", {}), ("Amounts", {}), ("Dates", {})])
        where = {}
        for name, folder, rel, path, texts in self._texts(P, job):
            for pi, t in enumerate(texts):
                found = []
                for p in self._people_on_page(t):
                    found.append(("People", p))
                for m_ in self.ORG_RE.finditer(t):
                    found.append(("Organisations", " ".join(m_.group(1).split())))
                for k, pat in (("Places / Eircodes", "Eircodes / postcodes"), ("Emails", "Emails"),
                               ("Phones", "Phone numbers"), ("Amounts", "Amounts"), ("Dates", "Dates")):
                    for v in find_values(pat, t):
                        found.append((k, v))
                for k, v in found:
                    kinds[k][v] = kinds[k].get(v, 0) + 1
                    where.setdefault((k, v), set()).add(name)
        if job["cancel"]:
            return None
        if not any(kinds.values()):
            return "Nothing named was found here."
        blocks = [("kpis", [self._kp(k, len(v)) for k, v in kinds.items() if v][:6])]
        ppl = sorted(kinds["People"].items(), key=lambda kv: -kv[1])[:15]
        if ppl:
            blocks.append(("chart", {"type": "bar", "title": "Most mentioned people", "labels": [p for p, _ in ppl],
                                     "series": [{"name": "Mentions", "values": [c for _, c in ppl]}],
                                     "link": {"table": "People", "col": "Name"}}))
        orgs = sorted(kinds["Organisations"].items(), key=lambda kv: -kv[1])[:12]
        if orgs:
            blocks.append(("chart", {"type": "bar", "title": "Organisations", "labels": [p for p, _ in orgs],
                                     "series": [{"name": "Mentions", "values": [c for _, c in orgs]}]}))
        for k, d_ in kinds.items():
            if not d_:
                continue
            rows = [[v, c, len(where[(k, v)]), ", ".join(sorted(self._short(x, 30) for x in where[(k, v)])[:3])]
                    for v, c in sorted(d_.items(), key=lambda kv: -kv[1])[:400]]
            blocks.append(("h", f"{k}  ·  {len(d_)}"))
            blocks.append(("table", {"name": k.split()[0], "headers": ["Name" if k == "People" else "Value", "Times",
                                                                       "Files", "In"],
                                     "rows": rows, "widths": [30, 8, 8, 40]}))
        return {"title": "People, organisations & places", "subtitle": self._subtitle(P["scope"]), "blocks": blocks,
                "_name": "Named - " + P["title"]}

    # ---- Checks ------------------------------------------------------------------------------------------
    def _job_expiry(self, P, job):
        import datetime
        today = datetime.date.today()
        days = int(P.get("days") or 90)
        items = self._expiry_items(P, job)
        if job["cancel"]:
            return None
        return self._expiry_report(P, items, today, days)

    def _expiry_items(self, P, job):
        import datetime
        today = datetime.date.today()
        only = [t.lower() for t in P["terms"]]
        all_dates = P["adv"].get("all_dates")
        days = int(P.get("days") or 90)
        items = []
        pf = lambda tx: bool(EXTRACT_PATTERNS["Dates"].search(tx)) and (all_dates or bool(EXPIRY_RE.search(tx)))
        for name, folder, rel, page, rows, doc, pi in self._walk_pages(P, job, pf):
            last_person = ""
            for i, row in enumerate(rows):
                lp = _label_person(row["text"])
                if lp:
                    last_person = lp
                text = row["text"]
                ctx = " ".join(r["text"] for r in rows[max(0, i - 1):i + 1])
                # 4.1 - the word on the line above counts only when that line has no date of its own (a label above
                # its date); 'Manual handling expiry: 15/12' no longer turns the next line's meeting date into one
                prev_dated = i > 0 and bool(EXTRACT_PATTERNS["Dates"].search(rows[i - 1]["text"]))
                m_ = EXPIRY_RE.search(text) or (EXPIRY_RE.search(ctx) if not all_dates and not prev_dated else None)
                if not all_dates and not m_:
                    continue
                for d_ in (parse_dates(text) if all_dates else expiry_dates(row)):
                    left = (d_ - today).days
                    if left > days:
                        status, tone = "Later", "good"
                    elif left < 0:
                        status, tone = "Expired", "critical"
                    elif left <= 30:
                        status, tone = "Within 30 days", "serious"
                    else:
                        status, tone = f"Within {days} days", "warning"
                    if left < -365 and not P["adv"].get("past", True):
                        continue
                    who, how = link_person(rows, i, last_person)
                    if only and not any(o in text.lower() or o in who.lower() for o in only):
                        continue
                    what = (m_.group(0) if m_ else "date").strip()
                    items.append({"date": d_, "left": left, "status": status, "tone": tone, "who": who,
                                  "what": what, "text": text, "file": name, "page": page, "folder": folder,
                                  "rel": rel})
        self._mark_renewed(items)
        return items

    EXPIRY_KINDS = [("garda vetting", r"garda|vetting|nvb"), ("first aid", r"first aid|\bfar\b|phecc"),
                    ("children first", r"children first"), ("manual handling", r"manual handling"),
                    ("fire safety", r"fire (?:safety|training|marshal|warden)"),
                    ("food safety", r"food (?:safety|hygiene)|haccp"), ("insurance", r"insurance"),
                    ("passport / ID", r"passport|\bid card|driving licen[cs]e"),
                    ("work permit", r"work permit|stamp \d|visa\b|irp\b|gnib"),
                    ("training", r"training|course|certificate|cert\b")]

    def _expiry_kind(self, x):
        t = (x.get("text", "") + " " + x.get("file", "")).lower()
        for name, rx in self.EXPIRY_KINDS:
            if re.search(rx, t):
                return name
        return (x.get("what") or "").lower()

    def _mark_renewed(self, items):
        """3.0 - the same person and the same kind of paper (vetting, first aid…) found with an older and a newer
        date: the older one was RENEWED - it is no longer 'expired' (an old vetting letter stayed red for ever)."""
        groups = {}
        for x in items:
            who = (x.get("who") or "").strip().lower()
            if not who:
                continue
            groups.setdefault((who, self._expiry_kind(x)), []).append(x)
        for xs in groups.values():
            if len(xs) < 2:
                continue
            newest = max(xs, key=lambda x: x["date"])
            for x in xs:
                if x is not newest and x["date"] < newest["date"]:
                    x["status"], x["tone"] = "Renewed", "good"
                    x["renewed"] = newest["date"].strftime("%d %b %Y")

    def _expiry_report(self, P, items, today, days):
        if not items:
            return ("No expiry dates or deadlines were found. Tip: switch on 'All dates' in Advanced to see every "
                    "date.")
        items.sort(key=lambda x: x["date"])
        n_exp = sum(1 for x in items if x["status"] == "Expired")
        n30 = sum(1 for x in items if x["status"] == "Within 30 days")
        nwin = sum(1 for x in items if x["status"].startswith("Within") and x["status"] != "Within 30 days")
        blocks = [("kpis", [self._kp("Expired", n_exp, "critical" if n_exp else "good"),
                            self._kp("Within 30 days", n30, "serious" if n30 else "good"),
                            self._kp(f"Within {days} days", nwin, "warning" if nwin else None),
                            self._kp("Later", sum(1 for x in items if x["status"] == "Later"))] +
                   ([self._kp("Renewed", sum(1 for x in items if x["status"] == "Renewed"), "good")]
                    if any(x["status"] == "Renewed" for x in items) else []))]
        for x in [x for x in items if x["status"] == "Expired"][-6:][::-1]:
            blocks.append(("alert", {"tone": "critical", "text": f"{x['who'] or x['what'].capitalize()} - expired "
                                                                f"{x['date'].strftime('%d %b %Y')} "
                                                                f"({-x['left']} days ago) · {self._short(x['file'], 40)} "
                                                                f"p.{x['page']}"}))
        for x in [x for x in items if x["status"] == "Within 30 days"][:6]:
            blocks.append(("alert", {"tone": "serious", "text": f"{x['who'] or x['what'].capitalize()} - "
                                                               f"{x['date'].strftime('%d %b %Y')} (in {x['left']} days)"
                                                               f" · {self._short(x['file'], 40)} p.{x['page']}"}))
        # timeline by month (12 months back .. 12 ahead)
        months = OrderedDict()
        for k in range(-6, 13):
            y, mo = divmod(today.month - 1 + k, 12)
            months[(today.year + y, mo + 1)] = {"Expired": 0, "Within 30 days": 0, "Soon": 0, "Later": 0}
        for x in items:
            key = (x["date"].year, x["date"].month)
            if key in months and x["status"] != "Renewed":
                st_ = x["status"] if x["status"] in ("Expired", "Within 30 days", "Later") else "Soon"
                months[key][st_] += 1
        import calendar
        labels = [f"{calendar.month_abbr[mo]} {str(y)[2:]}" for (y, mo) in months]
        blocks.append(("chart", {"type": "col", "stacked": True, "title": "When things expire", "labels": labels,
                                 "series": [{"name": s, "values": [v[s] for v in months.values()]}
                                            for s in ("Expired", "Within 30 days", "Soon", "Later")],
                                 "colors": [STATUS_COL["critical"], STATUS_COL["serious"], STATUS_COL["warning"],
                                            STATUS_COL["good"]]}))
        rows = [[x["date"].strftime("%d/%m/%Y"), x["left"],
                 x["status"] + (f" ({x['renewed']})" if x.get("renewed") else ""), x["who"], x["what"], x["text"],
                 x["file"], x["page"]] for x in items]
        colors = [STATUS_COL.get(x["tone"]) if x["tone"] != "good" else None for x in items]
        blocks.append(("table", {"name": "Dates", "headers": ["Date", "Days left", "Status", "Person", "What", "Line",
                                                              "File", "Page"],
                                 "rows": rows, "colors": colors, "widths": [10, 8, 13, 18, 12, 40, 22, 6]}))
        return {"title": "Expiry dates & deadlines", "subtitle": self._subtitle(P["scope"], f"{len(items)} dates"),
                "blocks": blocks, "_name": "Expiry - " + P["title"], "remind": {"date": 0, "text": 5}}

    def _job_missing(self, P, job):
        req = [r for r in P.get("required") or [] if r.strip()]
        if not req:
            return "Write what each person must have (one per line)."
        people = list(P["terms"])
        files = []
        for name, folder, rel, path, texts in self._texts(P, job):
            files.append((name, rel, "\n".join(texts)))
        if job["cancel"]:
            return None
        if not people:                       # who: names in file names, or 'Name:' labels in the documents
            seen = OrderedDict()
            only_name = re.compile(r"\b(?:child|pupil|student|staff|employee|full|first)?'?s?\s*name\s*[:\-–]\s*"
                                   r"(.{3,48})", re.I)
            for name, rel, text in files:
                stem = re.sub(r"[_\-.]+", " ", os.path.splitext(os.path.basename(rel))[0]).split()
                used = set()
                for L in (4, 3, 2):
                    for k in range(len(stem) - L + 1):
                        if used & set(range(k, k + L)):
                            continue
                        p = person_like(" ".join(stem[k:k + L]))
                        if p:
                            seen[p] = seen.get(p, 0) + 1
                            used |= set(range(k, k + L))
                for line in text.split("\n")[:400]:
                    mm = only_name.search(line)
                    if mm:
                        lp = person_like(re.split(r"\s{2,}|\||\b(?:phone|tel|mob\w*|email|date)\b", mm.group(1),
                                                  flags=re.I)[0])
                        if lp:
                            seen[lp] = seen.get(lp, 0) + 1
            people = [p for p, c in seen.items()][:300]
        if not people:
            return ("No people found - type their names in the box (or load a list from Excel), one per line.")

        def has(text, item):
            words = [w for w in re.findall(r"[A-Za-zÀ-ÿ]+", item.lower()) if len(w) > 2 and w not in STOPWORDS]
            t = text.lower()
            return item.lower() in t or (words and all(w in t for w in words[:2]))
        rows, colors, miss_count = [], [], {r: 0 for r in req}
        complete = 0
        # 3.0: the compliance matrix - each paper that has an expiry date shows it (expired / expires soon)
        import datetime
        today = datetime.date.today()
        try:
            exp_items = self._expiry_items(dict(P, terms=[], adv={"all_dates": False, "past": True}, days=90), job)
        except Exception:
            exp_items = []
        if job["cancel"]:
            return None

        def kind_of(text):
            t = text.lower()
            return next((nm for nm, rx in self.EXPIRY_KINDS if re.search(rx, t)), None)
        req_kind = {r: kind_of(r) for r in req}
        n_expired = n_soon = 0
        for p in people:
            pl = p.lower()
            parts = [w for w in pl.split() if len(w) > 2]
            mine = [(n, rel, t) for n, rel, t in files
                    if pl in rel.lower() or pl in t.lower() or (len(parts) >= 2 and all(w in rel.lower() for w in parts))]
            row = [p, len(mine)]
            missing, warn = [], False
            mine_exp = [x for x in exp_items if x.get("status") != "Renewed" and (
                (x.get("who") and (pl in x["who"].lower() or x["who"].lower() in pl or
                                   (parts and all(w in x["who"].lower() for w in parts)))) or
                pl in (x.get("rel") or "").lower())]
            for r in req:
                ok = any((P["adv"].get("filenames", True) and has(rel, r)) or has(t[:20000], r) for n, rel, t in mine)
                cell = "Yes" if ok else "MISSING"
                if ok and req_kind.get(r):
                    ds = [x["date"] for x in mine_exp if self._expiry_kind(x) == req_kind[r]]
                    if ds:
                        d_ = max(ds)
                        left = (d_ - today).days
                        if left < 0:
                            cell = f"EXPIRED {d_.strftime('%d/%m/%y')}"
                            missing.append(r + " (expired)")
                            n_expired += 1
                        elif left <= 60:
                            cell = f"Expires {d_.strftime('%d/%m/%y')}"
                            warn = True
                            n_soon += 1
                        else:
                            cell = f"Yes · to {d_.strftime('%d/%m/%y')}"
                row.append(cell)
                if not ok:
                    missing.append(r)
                    miss_count[r] += 1
            row.append(", ".join(missing))
            rows.append(row)
            colors.append(STATUS_COL["critical"] if missing else (STATUS_COL["serious"] if warn else None))
            if not missing:
                complete += 1
        n_m = sum(miss_count.values())
        blocks = [("kpis", [self._kp("People", len(people)), self._kp("Complete", complete, "good"),
                            self._kp("With something missing", len(people) - complete,
                                     "critical" if len(people) > complete else "good"),
                            self._kp("Missing items", n_m, "critical" if n_m else "good")] +
                   ([self._kp("Expired", n_expired, "critical")] if n_expired else []) +
                   ([self._kp("Expire within 60 days", n_soon, "serious")] if n_soon else []))]
        worst = sorted(miss_count.items(), key=lambda kv: -kv[1])
        for r, c in worst[:4]:
            if c:
                blocks.append(("alert", {"tone": "critical", "text": f"{r}: missing for {c} of {len(people)} "
                                                                     f"people."}))
        blocks.append(("chart", {"type": "stack", "title": "Each requirement", "labels": req,
                                 "series": [{"name": "Has it", "values": [len(people) - miss_count[r] for r in req]},
                                            {"name": "Missing", "values": [miss_count[r] for r in req]}],
                                 "colors": [STATUS_COL["good"], STATUS_COL["critical"]]}))
        blocks.append(("table", {"name": "Checklist", "headers": ["Person", "Files"] + req + ["Missing"],
                                 "rows": sorted(rows, key=lambda r: (-len(r[-1]), r[0])),
                                 "colors": [c for _r, c in sorted(zip(rows, colors), key=lambda rc: (-len(rc[0][-1]),
                                                                                                    rc[0][0]))],
                                 "widths": [20, 6] + [12] * len(req) + [30]}))
        return {"title": "Missing documents per person", "subtitle": self._subtitle(P["scope"], f"{len(people)} people"),
                "blocks": blocks, "_name": "Missing - " + P["title"]}

    def _job_incomplete(self, P, job):
        lab_re = re.compile(r"^\s*([A-Za-zÁÉÍÓÚáéíóúñÑ][\w /'’()&.,-]{1,40}?)\s*[:：]\s*(.*)$")
        sign_re = re.compile(r"\b(signature|signed|sign here|firma)\b", re.I)
        out = []
        n_forms = 0
        for k, (folder, rel, path) in enumerate(P["files"]):
            if job["cancel"]:
                return None
            job["progress"] = f"Reading {k + 1} of {len(P['files'])}  ·  Esc to stop"
            if not is_pdf(path):
                continue
            try:
                doc = self._doc_bytes_open(path)
            except Exception:
                continue
            name = f"{P['labels'].get(folder, folder)} / {rel}" if P["lib"] else rel
            try:
                empty, labels_total, unsigned = [], 0, []
                for pg in doc:
                    for w in pg.widgets() or []:
                        if w.field_type in (self.fitz.PDF_WIDGET_TYPE_BUTTON,):
                            continue
                        labels_total += 1
                        if not str(w.field_value or "").strip() or w.field_value in ("Off",):
                            if w.field_type != self.fitz.PDF_WIDGET_TYPE_CHECKBOX:
                                empty.append((w.field_label or w.field_name or "field").strip()[:40])
                    rows = page_rows(self.fitz, pg, {})
                    has_ink = any(a.type[1] in ("Ink", "Stamp") for a in pg.annots() or [])
                    for i, row in enumerate(rows):
                        t = row["cells"][0] if row["table"] else row["text"]
                        m_ = lab_re.match(t)
                        if m_ and len(m_.group(1).split()) <= 6:
                            labels_total += 1
                            val = m_.group(2).strip(" _.")
                            if not val and row["table"] and len(row["cells"]) > 1:
                                val = " ".join(c for c in row["cells"][1:] if c).strip(" _.")
                            if not val:
                                if sign_re.search(m_.group(1)):
                                    if P["adv"].get("unsigned", True) and not has_ink:
                                        unsigned.append(f"p.{pg.number + 1}")
                                else:
                                    empty.append(m_.group(1).strip())
                if labels_total >= 3:
                    n_forms += 1
                if empty or unsigned:
                    out.append([name, len(empty), ", ".join(dict.fromkeys(empty))[:300],
                                "Not signed (" + ", ".join(unsigned) + ")" if unsigned else "Signed / no signature line"])
            finally:
                doc.close()
        if not out:
            return "Every form here looks filled in." if n_forms else "No forms were found here."
        n_uns = sum(1 for r in out if r[3].startswith("Not signed"))
        blocks = [("kpis", [self._kp("Forms checked", n_forms), self._kp("With empty answers",
                                                                         sum(1 for r in out if r[1]), "warning"),
                            self._kp("Not signed", n_uns, "critical" if n_uns else "good")])]
        if n_uns:
            blocks.append(("alert", {"tone": "critical", "text": f"{n_uns} form(s) have an empty signature line."}))
        top = sorted(out, key=lambda r: -r[1])[:15]
        blocks.append(("chart", {"type": "bar", "title": "Empty answers per form",
                                 "labels": [self._short(r[0]) for r in top], "series": [{"name": "Empty",
                                                                                         "values": [r[1] for r in top]}],
                                 "colors": [STATUS_COL["serious"]]}))
        blocks.append(("table", {"name": "Forms", "headers": ["File", "Empty answers", "Which", "Signature"],
                                 "rows": out, "colors": [STATUS_COL["critical"] if r[3].startswith("Not") else None
                                                         for r in out], "widths": [26, 8, 46, 20]}))
        return {"title": "Forms not filled in or not signed", "subtitle": self._subtitle(P["scope"]),
                "blocks": blocks, "_name": "Forms check - " + P["title"]}

    def _job_duplicates(self, P, job):
        import hashlib
        docs, page_hash = [], {}
        rep_rows = []
        for name, folder, rel, path, texts in self._texts(P, job):
            joined = "\n".join(texts)
            norm = " ".join(joined.lower().split())
            docs.append((name, norm, hashlib.sha1(norm.encode("utf-8")).hexdigest() if norm else None))
            if P["adv"].get("pages", True):
                for pi, t in enumerate(texts):
                    n_ = " ".join(t.lower().split())
                    if len(n_) >= 120:
                        page_hash.setdefault(hashlib.sha1(n_.encode("utf-8")).hexdigest(), []).append((name, pi + 1))
            if P["adv"].get("rows", True):
                seen = {}
                for line in joined.split("\n"):
                    ln = " ".join(line.split())
                    if len(ln) >= 12 and (re.search(r"\d", ln) or person_like(ln.split("|")[0])):
                        seen[ln] = seen.get(ln, 0) + 1
                for ln, c in seen.items():
                    if c >= 2:
                        rep_rows.append([ln, c, name])
        if job["cancel"]:
            return None
        exact = {}
        for name, norm, h in docs:
            if h:
                exact.setdefault(h, []).append(name)
        exact = [v for v in exact.values() if len(v) > 1]
        near = []
        job["progress"] = "Comparing documents…"
        cand = [(n_, t[:30000]) for n_, t, h in docs if t]
        shingles = []
        for n_, t in cand:
            w = t.split()
            shingles.append((n_, {" ".join(w[i:i + 4]) for i in range(0, max(0, len(w) - 3))}))
        for i in range(len(shingles)):
            if job["cancel"]:
                return None
            for j in range(i + 1, len(shingles)):
                A, B = shingles[i][1], shingles[j][1]
                if not A or not B or min(len(A), len(B)) / max(len(A), len(B)) < 0.3:
                    continue
                s = len(A & B) / len(A | B)
                if 0.35 <= s < 0.999:
                    near.append([shingles[i][0], shingles[j][0], f"{round(s * 100)}%"])
        dup_pages = [v for v in page_hash.values() if len({x[0] for x in v}) > 1 or len(v) > 1]
        if not (exact or near or dup_pages or rep_rows):
            return "No duplicates found - every file and page is different."
        blocks = [("kpis", [self._kp("Same file twice", len(exact), "serious" if exact else "good"),
                            self._kp("Almost the same", len(near), "warning" if near else None),
                            self._kp("Repeated pages", len(dup_pages), "warning" if dup_pages else None),
                            self._kp("Repeated rows", len(rep_rows), "warning" if rep_rows else None)])]
        for grp in exact[:5]:
            blocks.append(("alert", {"tone": "serious", "text": "Same content: " + "  =  ".join(self._short(g, 40)
                                                                                          for g in grp)}))
        if exact:
            blocks.append(("h", "The same file more than once"))
            blocks.append(("table", {"name": "Same files", "headers": ["File", "Same as"],
                                     "rows": [[g[0], ", ".join(g[1:])] for g in exact], "widths": [40, 60]}))
        if near:
            blocks.append(("h", "Almost the same (versions?)"))
            blocks.append(("table", {"name": "Similar", "headers": ["File", "And", "Similar"],
                                     "rows": sorted(near, key=lambda r: -int(r[2][:-1])), "widths": [40, 40, 10]}))
        if dup_pages:
            blocks.append(("h", "The same page in several places"))
            blocks.append(("table", {"name": "Pages", "headers": ["Where", "Times"],
                                     "rows": [["; ".join(f"{self._short(n_, 30)} p.{p}" for n_, p in v), len(v)]
                                              for v in dup_pages], "widths": [80, 8]}))
        if rep_rows:
            blocks.append(("h", "Rows that appear twice or more in the same file"))
            blocks.append(("table", {"name": "Rows", "headers": ["Row", "Times", "File"],
                                     "rows": sorted(rep_rows, key=lambda r: -r[1])[:800], "widths": [60, 8, 30]}))
        return {"title": "Duplicates & similar documents", "subtitle": self._subtitle(P["scope"]), "blocks": blocks,
                "_name": "Duplicates - " + P["title"]}

    def _job_conflicts(self, P, job):
        only = [t.lower() for t in P["terms"]]
        info = {}
        pf = lambda tx: "@" in tx or EXTRACT_PATTERNS["Phone numbers"].search(tx) or re.search(r"birth|d\.?o\.?b", tx, re.I)
        for name, folder, rel, page, rows, doc, pi in self._walk_pages(P, job, pf):
            for i, row in enumerate(rows):
                t = row["text"]
                vals = [("Phone", re.sub(r"\D", "", v)[-9:], v) for v in find_values("Phone numbers", t)] + \
                       [("Email", v.lower(), v) for v in find_values("Emails", t)]
                m_ = PII_PATTERNS["Date of birth"].search(t)
                if m_:
                    vals.append(("Date of birth", m_.group(1), m_.group(1)))
                if not vals:
                    continue
                who, how = link_person(rows, i, None)
                if not who or (only and not any(o in who.lower() for o in only)):
                    continue
                rec = info.setdefault(who, {})
                for kind, key, shown in vals:
                    rec.setdefault(kind, OrderedDict()).setdefault(key, [shown, set()])[1].add(name)
        if job["cancel"]:
            return None
        out = []
        for who, rec in info.items():
            for kind, d_ in rec.items():
                if kind != "Email" and len(d_) > 1 or kind == "Email" and len(d_) > 2:
                    out.append([who, kind, "  ·  ".join(v[0] for v in d_.values()),
                                "; ".join(sorted({self._short(f, 30) for v in d_.values() for f in v[1]}))[:300]])
        if not out:
            return "No differences found: each person has the same details everywhere."
        blocks = [("kpis", [self._kp("People with different details", len({r[0] for r in out}), "warning"),
                            self._kp("Different phones", sum(1 for r in out if r[1] == "Phone")),
                            self._kp("Different dates of birth", sum(1 for r in out if r[1] == "Date of birth"),
                                     "critical" if any(r[1] == "Date of birth" for r in out) else None)]),
                  ("alert", {"tone": "warning", "text": "Check which detail is right and correct the other files."}),
                  ("table", {"name": "Differences", "headers": ["Person", "Detail", "Values found", "Files"],
                             "rows": out, "widths": [22, 14, 40, 40]})]
        return {"title": "Different details for the same person", "subtitle": self._subtitle(P["scope"]),
                "blocks": blocks, "_name": "Differences - " + P["title"]}

    def _job_moneycheck(self, P, job):
        findings = []
        amounts = []
        pf = lambda tx: bool(re.search(r"[€$£]|\btotal\b|\bvat\b|\bamount\b|\bfee", tx, re.I))
        for name, folder, rel, page, rows, doc, pi in self._walk_pages(P, job, pf):
            # 1) a 'Total' row in a table vs the rows above it
            run = {}
            for i, row in enumerate(rows):
                if not row.get("table") or not row.get("header"):
                    run = {}
                    continue
                first = (row["cells"][0] or "").strip().lower()
                if re.match(r"(grand )?total|sum|subtotal", first):
                    for j, c in enumerate(row["cells"][1:], 1):
                        n_ = parse_number(c)
                        if n_ is None or j not in run or run[j][1] < 2:
                            continue
                        s_ = run[j][0]
                        if abs(s_ - n_) > max(0.011, abs(n_) * 0.001):
                            findings.append(["Total doesn't match its rows", f"{row['header'][j] if j < len(row['header']) else 'Column'}: "
                                             f"rows add up to {s_:,.2f}, total says {n_:,.2f}", name, page, "critical"])
                    run = {}
                    continue
                for j, c in enumerate(row["cells"][1:], 1):
                    n_ = parse_number(c) if re.search(r"\d", c or "") and not re.search(r"[/:]", c or "") else None
                    if n_ is not None:
                        s_, k_ = run.get(j, (0.0, 0))
                        run[j] = (s_ + n_, k_ + 1)
            # 2) subtotal + VAT = total
            page_text = "\n".join(r["text"] for r in rows)
            got = {}
            for key, pat in (("sub", r"sub[- ]?total[^\d€$£]{0,20}([€$£]?\s?[\d.,]+)"),
                             ("vat", r"\bvat\b[^\d€$£]{0,25}([€$£]?\s?[\d.,]+)"),
                             ("tot", r"(?<!sub)(?<!sub-)(?<!sub )\btotal(?: due| amount| to pay)?[^\d€$£]{0,20}([€$£]?\s?[\d.,]+)")):
                mm = re.search(pat, page_text, re.I)
                if mm:
                    got[key] = parse_number(mm.group(1))
            if all(got.get(k) is not None for k in ("sub", "vat", "tot")):
                if abs(got["sub"] + got["vat"] - got["tot"]) > 0.02:
                    findings.append(["Subtotal + VAT ≠ total", f"{got['sub']:,.2f} + {got['vat']:,.2f} = "
                                     f"{got['sub'] + got['vat']:,.2f}, but the total says {got['tot']:,.2f}", name, page,
                                     "critical"])
            for i, row in enumerate(rows):
                for v in find_values("Amounts", row["text"]):
                    n_ = parse_number(v)
                    if n_ is not None and n_ > 0:
                        amounts.append((n_, v, person_for(rows, i), name, page, row["text"]))
        if job["cancel"]:
            return None
        # 3) unusual amounts per person, round numbers
        per = {}
        for a_ in amounts:
            per.setdefault(a_[2] or "", []).append(a_[0])
        for n_, v, who, name, page, text in amounts:
            vals = sorted(per.get(who or "", []))
            if len(vals) >= 4:
                med = vals[len(vals) // 2]
                if med > 0 and n_ > med * 3.5:
                    findings.append(["Unusual amount", f"{v} for {who or 'someone'} - usually about {med:,.2f}", name,
                                     page, "warning"])
            if n_ >= 1000 and abs(n_ % 500) < 0.001:
                findings.append(["Round amount", f"{v} ({who or 'no name'}) - round numbers are worth a second look",
                                 name, page, "info"])
        if not findings:
            return (f"Everything adds up ({len(amounts)} amounts checked)." if amounts else
                    "No amounts or totals found here.")
        order = {"critical": 0, "warning": 1, "info": 2}
        findings.sort(key=lambda f: order.get(f[4], 3))
        nc = sum(1 for f in findings if f[4] == "critical")
        blocks = [("kpis", [self._kp("Amounts checked", len(amounts)),
                            self._kp("Don't add up", nc, "critical" if nc else "good"),
                            self._kp("Unusual", sum(1 for f in findings if f[0] == "Unusual amount"), "warning"),
                            self._kp("Round", sum(1 for f in findings if f[0] == "Round amount"))])]
        for f in findings[:5]:
            if f[4] == "critical":
                blocks.append(("alert", {"tone": "critical", "text": f"{f[0]}: {f[1]} · {self._short(f[2], 40)} p.{f[3]}"}))
        blocks.append(("table", {"name": "Findings", "headers": ["Check", "What", "File", "Page"],
                                 "rows": [f[:4] for f in findings], "colors": [TONE_COL.get(f[4]) for f in findings],
                                 "widths": [20, 50, 24, 6]}))
        return {"title": "Sums that don't add up", "subtitle": self._subtitle(P["scope"]), "blocks": blocks,
                "_name": "Money checks - " + P["title"]}

    def _job_privacy(self, P, job):
        mask = P["adv"].get("mask", True)
        found = []
        by_kind = OrderedDict((k, 0) for k in PII_PATTERNS)
        files_with = {}
        for name, folder, rel, path, texts in self._texts(P, job):
            for pi, t in enumerate(texts):
                for kind, pat in PII_PATTERNS.items():
                    for m_ in pat.finditer(t):
                        v = m_.group(1) if kind == "Date of birth" else m_.group(0)
                        if kind == "Card number" and not luhn_ok(v):
                            continue
                        if kind == "IBAN / bank account" and not (15 <= len(v.replace(" ", "")) <= 34):
                            continue
                        if kind == "PPS number" and not re.search(r"pps|personal public|social", t[max(0, m_.start() - 80):m_.end() + 20], re.I) \
                                and not re.fullmatch(r"\d{7}[A-W][AHW]?", v):
                            continue
                        shown = v
                        if mask and kind in ("PPS number", "IBAN / bank account", "Card number"):
                            s_ = v.replace(" ", "")
                            shown = s_[:2] + "•" * max(0, len(s_) - 6) + s_[-4:]
                        found.append([kind, shown, name, pi + 1])
                        by_kind[kind] += 1
                        files_with.setdefault(kind, set()).add(name)
        if job["cancel"]:
            return None
        if not found:
            return "No personal data of these kinds was found."
        sens = sum(by_kind[k] for k in ("PPS number", "IBAN / bank account", "Card number", "Health information",
                                        "Date of birth"))
        blocks = [("kpis", [self._kp("Places with personal data", len(found)),
                            self._kp("Sensitive (IDs, bank, health, birth dates)", sens, "serious" if sens else "good"),
                            self._kp("Files", len({f[2] for f in found}))])]
        for k in ("Health information", "PPS number", "IBAN / bank account", "Card number"):
            if files_with.get(k):
                blocks.append(("alert", {"tone": "serious", "text": f"{k} in {len(files_with[k])} file(s) - keep them "
                                                                    f"safe; white-out or a read-only copy with a "
                                                                    f"watermark before sharing."}))
        kinds = [k for k, v in by_kind.items() if v]
        blocks.append(("chart", {"type": "bar", "title": "What was found", "labels": kinds,
                                 "series": [{"name": "Found", "values": [by_kind[k] for k in kinds]}],
                                 "link": {"table": "Personal data", "col": "Kind"}}))
        blocks.append(("table", {"name": "Personal data", "headers": ["Kind", "Value", "File", "Page"], "rows": found,
                                 "widths": [18, 30, 40, 6]}))
        return {"title": "Personal data finder", "subtitle": self._subtitle(P["scope"]), "blocks": blocks,
                "_name": "Personal data - " + P["title"]}

    def _job_health(self, P, job):
        rows = []
        n_scan = n_blank = n_big = n_bad = 0
        types = {}
        for k, (folder, rel, path) in enumerate(P["files"]):
            if job["cancel"]:
                return None
            job["progress"] = f"Checking {k + 1} of {len(P['files'])}  ·  Esc to stop"
            name = f"{P['labels'].get(folder, folder)} / {rel}" if P["lib"] else rel
            try:
                size = os.path.getsize(path)
            except Exception:
                size = 0
            issues = []
            pages = scanned = blank = rotated = 0
            locked = False
            try:
                doc = self._doc_bytes_open(path)
                try:
                    locked = bool(getattr(doc, "is_encrypted", False) or getattr(doc, "needs_pass", False))
                    pages = doc.page_count
                    texts = self._page_texts(path)
                    for pi in range(min(pages, 400)):
                        t = texts[pi] if pi < len(texts) else ""
                        if len(t.strip()) < 15:
                            pg = doc.load_page(pi)
                            if pg.get_images() or pg.get_drawings():
                                scanned += 1
                            else:
                                blank += 1
                        if pi < 400:
                            try:
                                if doc.load_page(pi).rotation:
                                    rotated += 1
                            except Exception:
                                pass
                    types[doc_type("\n".join(texts[:20]))] = types.get(doc_type("\n".join(texts[:20])), 0) + 1
                finally:
                    doc.close()
            except Exception:
                issues.append("Can't be opened (broken?)")
                n_bad += 1
            if scanned:
                issues.append(f"{scanned} scanned page(s) without text - make them searchable (OCR)")
                n_scan += 1
            if blank:
                issues.append(f"{blank} blank page(s)")
                n_blank += 1
            if size > 20 * 1024 * 1024:
                issues.append(f"Very big ({size / 1024 / 1024:.0f} MB)")
                n_big += 1
            if locked:
                issues.append("Locked with a password")
            if rotated:
                issues.append(f"{rotated} turned page(s)")
            rows.append([name, pages, f"{size / 1024 / 1024:.1f} MB", "; ".join(issues) or "OK"])
        if not rows:
            return "No files here."
        bad = [r for r in rows if r[3] != "OK"]
        blocks = [("kpis", [self._kp("Files", len(rows)), self._kp("All good", len(rows) - len(bad), "good"),
                            self._kp("Scanned pages to OCR", n_scan, "warning" if n_scan else None),
                            self._kp("Blank pages", n_blank, "warning" if n_blank else None),
                            self._kp("Broken", n_bad, "critical" if n_bad else None)])]
        if n_scan:
            blocks.append(("alert", {"tone": "warning", "text": f"{n_scan} file(s) have scanned pages: right-click "
                                                                f"the file > Make scanned pages searchable (OCR), so "
                                                                f"search and reports can read them."}))
        if types:
            blocks.append(("chart", {"type": "donut", "title": "Kinds of documents", "labels": list(types),
                                     "series": [{"values": list(types.values())}], "center": "files"}))
        blocks.append(("table", {"name": "Files", "headers": ["File", "Pages", "Size", "What to do"],
                                 "rows": sorted(rows, key=lambda r: r[3] == "OK"),
                                 "colors": [STATUS_COL["warning"] if r[3] != "OK" else None
                                            for r in sorted(rows, key=lambda r: r[3] == "OK")],
                                 "widths": [40, 7, 9, 50]}))
        return {"title": "Document health", "subtitle": self._subtitle(P["scope"]), "blocks": blocks,
                "_name": "Health - " + P["title"]}

    # ---- Text analysis ---------------------------------------------------------------------------------
    def _job_keywords(self, P, job):
        docs = OrderedDict()
        for name, folder, rel, path, texts in self._texts(P, job):
            docs[name] = "\n".join(texts)
        if job["cancel"]:
            return None
        allt = "\n".join(t[:80000] for t in docs.values())
        if len(allt.strip()) < 40:
            return "There is (almost) no text here - scanned pages need OCR first."
        cnt = {}
        for w in words_of(allt):
            cnt[w] = cnt.get(w, 0) + 1
        top = sorted(cnt.items(), key=lambda kv: -kv[1])
        phr = keyphrases(allt, 30)
        multi = [p for p in phr if " " in p[0]][:15]
        blocks = [("kpis", [self._kp("Files", len(docs)), self._kp("Words", sum(len(words_of(t, True)) for t in docs.values())),
                            self._kp("Different words", len(cnt)), self._kp("Top word", top[0][0] if top else "-")]),
                  ("chart", {"type": "cloud", "title": "Key words", "words": top[:60]})]
        if multi:
            blocks.append(("chart", {"type": "bar", "title": "Key phrases", "labels": [p[0] for p in multi],
                                     "series": [{"name": "Times", "values": [p[1] for p in multi]}],
                                     "link": {"table": "Phrases", "col": "Phrase"}}))
        blocks.append(("h", "Key phrases"))
        blocks.append(("table", {"name": "Phrases", "headers": ["Phrase", "Times", "Score"], "rows": [list(p) for p in phr],
                                 "widths": [40, 8, 8]}))
        if P["adv"].get("per_file", True) and len(docs) > 1:
            tf = tfidf_terms(docs, 8)
            blocks.append(("h", "Words typical of each file"))
            blocks.append(("table", {"name": "Per file", "headers": ["File", "Typical words"],
                                     "rows": [[n_, ", ".join(w for w, _s in v)] for n_, v in tf.items()],
                                     "widths": [36, 64]}))
        blocks.append(("table", {"name": "Words", "headers": ["Word", "Times"], "rows": [list(x) for x in top[:300]],
                                 "widths": [24, 8]}))
        return {"title": "Key words & phrases", "subtitle": self._subtitle(P["scope"], f"{len(docs)} files"),
                "blocks": blocks, "_name": "Key words - " + P["title"]}

    def _count_term(self, text, term, whole=True):
        pat = (r"(?<!\w)" + re.escape(term) + r"(?!\w)") if whole else re.escape(term)
        return len(re.findall(pat, text, re.I))

    def _job_frequency(self, P, job):
        docs = OrderedDict()
        for name, folder, rel, path, texts in self._texts(P, job):
            docs[name] = "\n".join(texts)
        if job["cancel"]:
            return None
        if not docs:
            return "No files here."
        terms = P["terms"]
        whole = P["adv"].get("wholeword", True)
        if not terms:
            cnt = {}
            for t in docs.values():
                for w in words_of(t):
                    cnt[w] = cnt.get(w, 0) + 1
            terms = [w for w, _c in sorted(cnt.items(), key=lambda kv: -kv[1])[:10]]
            auto = True
        else:
            auto = False
        mat = [[self._count_term(t, term, whole) for term in terms] for t in docs.values()]
        totals = [sum(r[j] for r in mat) for j in range(len(terms))]
        words_total = sum(len(words_of(t, True)) for t in docs.values()) or 1
        blocks = [("kpis", [self._kp("Files", len(docs))] +
                   [self._kp(f"“{t}”", totals[j]) for j, t in enumerate(terms[:3])])]
        blocks.append(("chart", {"type": "bar", "title": "Most used words" if auto else "How often",
                                 "labels": terms, "series": [{"name": "Times", "values": totals}]}))
        names = list(docs)
        if 1 < len(names) <= 40:
            if len(terms) <= 4:
                blocks.append(("chart", {"type": "line", "title": "Across the files",
                                         "labels": [self._short(n_, 18) for n_ in names],
                                         "series": [{"name": t, "values": [mat[i][j] for i in range(len(names))]}
                                                    for j, t in enumerate(terms)]}))
            blocks.append(("chart", {"type": "heat", "title": "Words × files", "rows": [self._short(n_) for n_ in names],
                                     "cols": terms[:10], "matrix": [r[:10] for r in mat],
                                     "link": {"table": "Per file", "col": "File"}}))
        blocks.append(("table", {"name": "Words", "headers": ["Word", "Times", "Files", "Per 1,000 words"],
                                 "rows": [[t, totals[j], sum(1 for r in mat if r[j]),
                                           round(1000 * totals[j] / words_total, 2)] for j, t in enumerate(terms)],
                                 "widths": [24, 8, 8, 12]}))
        blocks.append(("table", {"name": "Per file", "headers": ["File"] + terms, "rows": [[n_] + mat[i] for i, n_ in
                                                                                             enumerate(names)],
                                 "widths": [36] + [10] * len(terms)}))
        return {"title": "Word frequency", "subtitle": self._subtitle(P["scope"]), "blocks": blocks,
                "_name": "Frequency - " + P["title"]}

    def _job_kwic(self, P, job):
        whole = P["adv"].get("wholeword", True)
        rows, per_file = [], {}
        near = {t: {} for t in P["terms"]}
        for name, folder, rel, path, texts in self._texts(P, job):
            for pi, t in enumerate(texts):
                for term in P["terms"]:
                    hits = in_context(t, term, 70, whole)
                    for l_, w_, r_ in hits:
                        rows.append([term, l_, w_, r_, name, pi + 1])
                    if hits:
                        per_file[name] = per_file.get(name, 0) + len(hits)
                        for w, c in near_words(t, term, 5, 40):
                            near[term][w] = near[term].get(w, 0) + c
        if job["cancel"]:
            return None
        if not rows:
            return "Not found here."
        top = sorted(per_file.items(), key=lambda kv: -kv[1])[:15]
        blocks = [("kpis", [self._kp("Times found", len(rows)), self._kp("Files", len(per_file))] +
                   [self._kp(f"“{t}”", sum(1 for r in rows if r[0] == t)) for t in P["terms"][:2]]),
                  ("chart", {"type": "bar", "title": "Where", "labels": [self._short(n_) for n_, _c in top],
                             "series": [{"name": "Times", "values": [c for _n, c in top]}],
                             "link": {"table": "In context", "col": "File"}})]
        for term, d_ in near.items():
            nn = sorted(d_.items(), key=lambda kv: -kv[1])[:12]
            if nn:
                blocks.append(("chart", {"type": "bar", "title": f"Words often near “{term}”",
                                         "labels": [w for w, _c in nn],
                                         "series": [{"name": "Times", "values": [c for _w, c in nn]}]}))
        blocks.append(("table", {"name": "In context", "headers": ["Word", "Before", "Found", "After", "File", "Page"],
                                 "rows": rows, "widths": [10, 34, 10, 34, 20, 6]}))
        return {"title": "Word in context", "subtitle": self._subtitle(P["scope"], f"{len(rows)} times"),
                "blocks": blocks, "_name": "In context - " + P["title"]}

    def _job_collocates(self, P, job):
        allt = []
        for name, folder, rel, path, texts in self._texts(P, job):
            allt.append("\n".join(texts)[:80000])
        if job["cancel"]:
            return None
        text = "\n".join(allt)
        bi = ngrams(text, 2, 40)
        tri = ngrams(text, 3, 25)
        if not bi and not P["terms"]:
            return "Not enough text to find words that go together."
        blocks = [("kpis", [self._kp("Pairs found", len(bi)), self._kp("Groups of three", len(tri)),
                            self._kp("Top pair", bi[0][0] if bi else "-")])]
        if bi:
            blocks.append(("chart", {"type": "bar", "title": "Words that go together", "labels": [b for b, _c in bi[:15]],
                                     "series": [{"name": "Times", "values": [c for _b, c in bi[:15]]}]}))
        for term in P["terms"][:4]:
            nn = near_words(text, term, 5, 15)
            if nn:
                blocks.append(("chart", {"type": "bar", "title": f"Near “{term}”", "labels": [w for w, _c in nn],
                                         "series": [{"name": "Times", "values": [c for _w, c in nn]}]}))
        blocks.append(("table", {"name": "Pairs", "headers": ["Words", "Times"], "rows": [list(x) for x in bi],
                                 "widths": [36, 8]}))
        if tri:
            blocks.append(("table", {"name": "Threes", "headers": ["Words", "Times"], "rows": [list(x) for x in tri],
                                     "widths": [40, 8]}))
        return {"title": "Words that go together", "subtitle": self._subtitle(P["scope"]), "blocks": blocks,
                "_name": "Together - " + P["title"]}

    def _job_themes(self, P, job):
        themes = P.get("themes") or {}
        if not themes:
            return "Write at least one theme, e.g.  Safety: accident, injury, incident"
        pats = {th: re.compile(r"(?<!\w)(" + "|".join(re.escape(w) for w in ws) + r")(?!\w)", re.I)
                for th, ws in themes.items()}
        names, mat, quotes = [], [], {th: [] for th in themes}
        for name, folder, rel, path, texts in self._texts(P, job):
            row = [0] * len(themes)
            for pi, t in enumerate(texts):
                for j, (th, pat) in enumerate(pats.items()):
                    hits = list(pat.finditer(t))
                    row[j] += len(hits)
                    if hits and len(quotes[th]) < 40:
                        for s_ in sentences_of(t):
                            if pat.search(s_):
                                quotes[th].append([th, s_[:300], name, pi + 1])
                                if len(quotes[th]) >= 40:
                                    break
            names.append(name)
            mat.append(row)
        if job["cancel"]:
            return None
        tot = [sum(r[j] for r in mat) for j in range(len(themes))]
        if not sum(tot):
            return "None of these words were found."
        th_names = list(themes)
        best = th_names[max(range(len(tot)), key=lambda j: tot[j])]
        blocks = [("kpis", [self._kp("Themes found", sum(1 for x in tot if x)), self._kp("Mentions", sum(tot)),
                            self._kp("Strongest theme", best),
                            self._kp("Files with themes", sum(1 for r in mat if any(r)))]),
                  ("chart", {"type": "bar", "title": "Each theme", "labels": th_names,
                             "series": [{"name": "Mentions", "values": tot}], "link": {"table": "Examples", "col": "Theme"}})]
        if 1 < len(names) <= 40:
            blocks.append(("chart", {"type": "heat", "title": "Themes × files", "rows": [self._short(n_) for n_ in names],
                                     "cols": th_names, "matrix": mat}))
        blocks.append(("table", {"name": "Per file", "headers": ["File"] + th_names,
                                 "rows": [[n_] + mat[i] for i, n_ in enumerate(names)],
                                 "widths": [36] + [12] * len(th_names)}))
        if P["adv"].get("quotes", True):
            ex = [q for th in th_names for q in quotes[th][:12]]
            if ex:
                blocks.append(("h", "Examples"))
                blocks.append(("table", {"name": "Examples", "headers": ["Theme", "Sentence", "File", "Page"],
                                         "rows": ex, "widths": [14, 60, 20, 6]}))
        return {"title": "Themes", "subtitle": self._subtitle(P["scope"]), "blocks": blocks,
                "_name": "Themes - " + P["title"]}

    def _job_tone(self, P, job):
        per, sents = [], []
        for name, folder, rel, path, texts in self._texts(P, job):
            neg = neu = pos = 0
            for pi, t in enumerate(texts):
                for s_ in sentences_of(t):
                    p, n_, sc = tone_of(s_)
                    if sc > 0.2:
                        pos += 1
                    elif sc < -0.2:
                        neg += 1
                    else:
                        neu += 1
                    if p or n_:
                        sents.append((sc, p + n_, s_[:300], name, pi + 1))
            if neg + neu + pos:
                per.append([name, neg, neu, pos])
        if job["cancel"]:
            return None
        if not per:
            return "Not enough text to read the tone."
        T_ = [sum(r[k] for r in per) for k in (1, 2, 3)]
        score = (T_[2] - T_[0]) / max(1, T_[0] + T_[2])
        label = "Mostly positive" if score > 0.25 else "Mostly negative" if score < -0.25 else "Mixed / neutral"
        negf = [r for r in per if r[1] > r[3] and r[1] >= 2]
        blocks = [("kpis", [self._kp("Overall tone", label, "good" if score > 0.25 else "serious" if score < -0.25
                                     else None),
                            self._kp("Negative sentences", T_[0], "warning" if T_[0] else None),
                            self._kp("Positive sentences", T_[2], "good" if T_[2] else None),
                            self._kp("Mostly negative files", len(negf), "serious" if negf else None)])]
        for r in negf[:5]:
            blocks.append(("alert", {"tone": "serious", "text": f"{self._short(r[0], 50)} sounds negative "
                                                                f"({r[1]} negative sentence(s))."}))
        show = sorted(per, key=lambda r: (r[3] - r[1]) / max(1, sum(r[1:])))[:20]
        blocks.append(("chart", {"type": "diverging", "title": "Tone per file", "labels": [self._short(r[0]) for r in show],
                                 "series": [{"name": "Negative", "values": [r[1] for r in show]},
                                            {"name": "Neutral", "values": [r[2] for r in show]},
                                            {"name": "Positive", "values": [r[3] for r in show]}], "neg": 1, "neutral": 1}))
        blocks.append(("table", {"name": "Per file", "headers": ["File", "Negative", "Neutral", "Positive"], "rows": per,
                                 "widths": [40, 10, 10, 10]}))
        if P["adv"].get("sentences", True):
            sents.sort(key=lambda s_: s_[0] * min(3, s_[1]))
            negs = [s_ for s_ in sents if s_[0] < 0][:15]
            poss = [s_ for s_ in sents[::-1] if s_[0] > 0][:15]
            if negs:
                blocks.append(("h", "Most negative sentences"))
                blocks.append(("table", {"name": "Negative", "headers": ["Sentence", "File", "Page"],
                                         "rows": [[s_[2], s_[3], s_[4]] for s_ in negs], "widths": [70, 22, 6]}))
            if poss:
                blocks.append(("h", "Most positive sentences"))
                blocks.append(("table", {"name": "Positive", "headers": ["Sentence", "File", "Page"],
                                         "rows": [[s_[2], s_[3], s_[4]] for s_ in poss], "widths": [70, 22, 6]}))
        blocks.append(("p", "Tone is read from lists of positive and negative words (‘not good’ counts as negative) "
                            "- a guide, not a judge."))
        return {"title": "Tone", "subtitle": self._subtitle(P["scope"]), "blocks": blocks, "_name": "Tone - " + P["title"]}

    def _job_readability(self, P, job):
        rows, longs = [], []
        for name, folder, rel, path, texts in self._texts(P, job):
            r = readability("\n".join(texts))
            if not r:
                continue
            rows.append([name, r["flesch"], flesch_label(r["flesch"]), r["wps"], len(r["long"]), r["words"],
                         f"{r['minutes']} min"])
            longs += [[s_[:400], len(s_.split()), name] for s_ in r["long"][:10]]
        if job["cancel"]:
            return None
        if not rows:
            return "Not enough text to measure."
        avg = sum(r[1] for r in rows) / len(rows)
        hard = [r for r in rows if r[1] < 40]
        blocks = [("kpis", [self._kp("Average score", f"{avg:.0f} / 100", "good" if avg >= 60 else "warning"
                                     if avg >= 40 else "serious"),
                            self._kp("Level", flesch_label(avg)),
                            self._kp("Hard to read", len(hard), "warning" if hard else None),
                            self._kp("Long sentences", len(longs), "warning" if longs else None),
                            self._kp("Reading time", f"{sum(int(r[6].split()[0]) for r in rows)} min")])]
        if hard:
            blocks.append(("alert", {"tone": "warning", "text": f"{len(hard)} file(s) are hard to read - shorter "
                                                                f"sentences and simpler words help."}))
        show = sorted(rows, key=lambda r: r[1])[:20]
        blocks.append(("chart", {"type": "bar", "title": "Reading ease (higher = easier)",
                                 "labels": [self._short(r[0]) for r in show],
                                 "series": [{"name": "Score", "values": [r[1] for r in show]}],
                                 "bar_colors": [STATUS_COL["good"] if r[1] >= 60 else STATUS_COL["warning"] if r[1] >= 40
                                                else STATUS_COL["serious"] for r in show]}))
        blocks.append(("table", {"name": "Files", "headers": ["File", "Score", "Level", "Words per sentence",
                                                              "Long sentences", "Words", "Reading time"],
                                 "rows": rows, "widths": [34, 7, 14, 10, 10, 8, 10]}))
        if longs:
            blocks.append(("h", "Long sentences (over 30 words)"))
            blocks.append(("table", {"name": "Long", "headers": ["Sentence", "Words", "File"], "rows": longs[:200],
                                     "widths": [70, 7, 22]}))
        return {"title": "Readability", "subtitle": self._subtitle(P["scope"]), "blocks": blocks,
                "_name": "Readability - " + P["title"]}

    def _job_keysent(self, P, job):
        rows = []
        n_files = 0
        try:
            n = max(1, min(20, int(P["adv"].get("n", 5))))
        except Exception:
            n = 5
        words = 0
        for name, folder, rel, path, texts in self._texts(P, job):
            joined = "\n".join(texts)
            words += len(joined.split())
            ks = key_sentences(joined[:60000], n)
            if ks:
                n_files += 1
                for s_ in ks:
                    rows.append([name, s_[:500]])
        if job["cancel"]:
            return None
        if not rows:
            return "Not enough text here."
        blocks = [("kpis", [self._kp("Documents", n_files), self._kp("Words", words),
                            self._kp("Key sentences", len(rows))])]
        if P["adv"].get("overall", True) and n_files > 1:
            # a short summary of everything: the key sentences of the key sentences
            best = key_sentences("\n\n".join(r[1] for r in rows[:2000]), min(8, max(3, n)))
            if best:
                blocks.append(("h", "In short"))
                blocks.append(("table", {"name": "In short", "headers": ["Sentence", "From"],
                                         "rows": [[s_, next((r[0] for r in rows if r[1] == s_), "")] for s_ in best],
                                         "widths": [74, 26]}))
        blocks += [("h", "Each document"),
                   ("table", {"name": "Key sentences", "headers": ["File", "Sentence"], "rows": rows, "widths": [26, 74]}),
                   ("p", "Picked by how much each sentence shares with the rest of the document (TextRank) - no AI.")]
        return {"title": "Key sentences", "subtitle": self._subtitle(P["scope"]), "blocks": blocks,
                "_name": "Key sentences - " + P["title"]}

    def _job_actions(self, P, job):
        import datetime
        today = datetime.date.today()
        only = [t.lower() for t in P["terms"]]
        acts, qs = [], []
        for name, folder, rel, path, texts in self._texts(P, job):
            for pi, t in enumerate(texts):
                for line in re.split(r"\n|(?<=[.!?])\s+(?=[A-Z])", t):
                    ln = " ".join(line.split())
                    if len(ln) < 12 or len(ln) > 400:
                        continue
                    if ACTION_RE.search(ln):
                        who = ""
                        for m_ in NAME_IN_TEXT.finditer(ln):
                            who = person_like(m_.group(0))
                            if who:
                                break
                        if not who:
                            m_ = re.match(r"^\s*([A-Z][a-z]+(?: [A-Z][a-z]+)?)\s*(?:[:\-–]|to |will )", ln)
                            who = m_.group(1) if m_ and m_.group(1).lower() not in STOPWORDS else ""
                        ds = parse_dates(ln)
                        when = ds[0] if ds else None
                        kind = "Decision" if DECISION_RE.search(ln) else "Action"
                        if only and not any(o in ln.lower() or o in who.lower() for o in only):
                            continue
                        late = bool(when and when < today and kind == "Action")
                        acts.append([kind, ln, who, when.strftime("%d/%m/%Y") if when else "",
                                     "Overdue" if late else "", name, pi + 1])
                    elif P["adv"].get("questions", True) and (ln.endswith("?") or REQUEST_RE.search(ln)):
                        qs.append(["Question" if ln.endswith("?") else "Request", ln, name, pi + 1])
        if job["cancel"]:
            return None
        if not acts and not qs:
            return "No actions, decisions, questions or requests found."
        n_late = sum(1 for a_ in acts if a_[4])
        n_dec = sum(1 for a_ in acts if a_[0] == "Decision")
        no_owner = sum(1 for a_ in acts if a_[0] == "Action" and not a_[2])
        blocks = [("kpis", [self._kp("Actions", len(acts) - n_dec), self._kp("Decisions", n_dec),
                            self._kp("Overdue", n_late, "critical" if n_late else "good"),
                            self._kp("Without a person", no_owner, "warning" if no_owner else None),
                            self._kp("Questions & requests", len(qs))])]
        if n_late:
            blocks.append(("alert", {"tone": "critical", "text": f"{n_late} action(s) have a date that has passed."}))
        per = {}
        for a_ in acts:
            if a_[0] == "Action":
                per[a_[2] or "(nobody named)"] = per.get(a_[2] or "(nobody named)", 0) + 1
        top = sorted(per.items(), key=lambda kv: -kv[1])[:15]
        if top:
            blocks.append(("chart", {"type": "bar", "title": "Actions per person", "labels": [p for p, _c in top],
                                     "series": [{"name": "Actions", "values": [c for _p, c in top]}],
                                     "link": {"table": "Actions", "col": "Who"}}))
        blocks.append(("table", {"name": "Actions", "headers": ["Kind", "What", "Who", "When", "Status", "File", "Page"],
                                 "rows": acts, "colors": [STATUS_COL["critical"] if a_[4] else
                                                          (STATUS_COL["good"] if a_[0] == "Decision" else None)
                                                          for a_ in acts],
                                 "widths": [9, 50, 16, 10, 8, 20, 6]}))
        if qs:
            blocks.append(("h", f"Questions & requests  ·  {len(qs)}"))
            blocks.append(("table", {"name": "Questions", "headers": ["Kind", "Line", "File", "Page"], "rows": qs,
                                     "widths": [10, 64, 20, 6]}))
        return {"title": "Actions, decisions & requests", "subtitle": self._subtitle(P["scope"]), "blocks": blocks,
                "_name": "Actions - " + P["title"], "remind": {"date": 3, "text": 1}}

    # ---- Tables & numbers: make your own table (pivot) -------------------------------------------------------
    def _job_pivot(self, P, job):
        rdim, cdim, meas = P.get("pv", ("person", "none", "count"))
        rcol, ccol, vcol = P.get("pv_cols", ("", "", ""))

        def col_of(row, name):
            if not name or not row.get("header"):
                return None
            nl = name.lower()
            for h, c in zip(row["header"], row["cells"]):
                if (h or "").lower().startswith(nl) or nl in (h or "").lower():
                    return c
            return None

        def dim(kind, colname, row, name, folder):
            if kind == "person":
                return person_name(row) or (row["cells"][0] if row["cells"] else "") or None
            if kind == "file":
                return self._short(name, 40)
            if kind == "book":
                return P["labels"].get(folder, folder)
            if kind == "month":
                ds = parse_dates(row["text"])
                return ds[0].strftime("%Y-%m") if ds else None
            if kind == "col":
                v = col_of(row, colname)
                return v.strip() if v and v.strip() else None
            if kind == "org":
                v = organisation(row)
                if not v:
                    m_ = self.ORG_RE.search(row["text"])
                    v = " ".join(m_.group(1).split()) if m_ else ""
                return v or None
            return "All"
        data = {}
        counted = 0
        for name, folder, rel, page, row in self._walk_rows(P, job, None):
            if row.get("cells") and TOTAL_ROW.match((row["cells"][0] or "").strip()):
                continue
            if meas != "count" and not vcol:
                vals = [parse_number(v) for v in find_values("Amounts", row["text"])]
                vals = [v for v in vals if v is not None]
                if not vals:
                    continue
                val = vals[-1]
            elif meas != "count":
                c_ = col_of(row, vcol)
                val = parse_number(c_) if c_ else None
                if val is None:
                    continue
            else:
                if not row.get("table"):
                    continue
                val = 1
            rk = dim(rdim, rcol, row, name, folder)
            ck = dim(cdim, ccol, row, name, folder) if cdim != "none" else "Value"
            if rk is None or ck is None:
                continue
            counted += 1
            data.setdefault(rk, {}).setdefault(ck, []).append(val)
        if job["cancel"]:
            return None
        if not data:
            return ("Nothing to put in the table - check the column names (they must match the headings of your "
                    "tables).")
        agg = {"count": lambda v: len(v), "sum": sum, "avg": lambda v: sum(v) / len(v), "max": max, "min": min}[meas]
        rows_k = sorted(data, key=lambda k: (-sum(len(v) for v in data[k].values()), str(k)))[:80]
        if rdim == "month":
            rows_k = sorted(rows_k)
        cols_k = {}
        for r in rows_k:
            for c, v in data[r].items():
                cols_k[c] = cols_k.get(c, 0) + len(v)
        cols_k = sorted(cols_k, key=lambda c: (-cols_k[c], str(c)))[:14]
        if cdim == "month":
            cols_k = sorted(cols_k)
        mat = []
        for r in rows_k:
            mat.append([round(agg(data[r][c]), 2) if c in data[r] else 0 for c in cols_k])
        tot_r = [round(agg([x for c in data[r] for x in data[r][c]]), 2) for r in rows_k]
        what = {"count": "Rows", "sum": f"Sum of {vcol or 'amounts'}", "avg": f"Average {vcol or 'amount'}",
                "max": f"Largest {vcol or 'amount'}", "min": f"Smallest {vcol or 'amount'}"}[meas]
        rname = {"person": "Person", "file": "File", "book": "Book", "month": "Month", "org": "Organisation",
                 "col": rcol or "Value"}[rdim]
        cname = {"person": "Person", "file": "File", "book": "Book", "month": "Month", "org": "Organisation",
                 "col": ccol or "Value", "none": ""}[cdim]
        headers = [rname] + ([str(c) for c in cols_k] if cdim != "none" else []) + [what]
        rows = [[r] + (mat[i] if cdim != "none" else []) + [tot_r[i]] for i, r in enumerate(rows_k)]
        blocks = [("kpis", [self._kp("Rows counted", counted), self._kp(rname + "s", len(data)),
                            self._kp(what, round(agg([x for r in data for c in data[r] for x in data[r][c]]), 2)
                                     if meas != "avg" else round(sum(tot_r) / max(1, len(tot_r)), 2))])]
        if cdim != "none" and len(cols_k) > 1:
            blocks.append(("chart", {"type": "heat", "title": f"{what}: {rname} × {cname}",
                                     "rows": [str(r)[:30] for r in rows_k[:30]], "cols": [str(c) for c in cols_k],
                                     "matrix": mat[:30], "link": {"table": "Your table", "col": rname}}))
        top = list(zip(rows_k, tot_r))
        if rdim != "month":
            top = sorted(top, key=lambda x: -x[1])
        top = top[:20]
        blocks.append(("chart", {"type": "col" if rdim == "month" else "bar", "title": f"{what} per {rname.lower()}",
                                 "labels": [str(r)[:30] for r, _v in top], "series": [{"name": what,
                                                                                        "values": [v for _r, v in top]}],
                                 "link": {"table": "Your table", "col": rname}}))
        tot = ["Total"] + ([round(sum(mat[i][j] for i in range(len(rows_k))), 2) for j in range(len(cols_k))]
                           if cdim != "none" else []) + [round(sum(tot_r), 2)]
        blocks.append(("table", {"name": "Your table", "headers": headers,
                                 "rows": rows + ([tot] if meas in ("count", "sum") else []),
                                 "total_row": meas in ("count", "sum"), "widths": [26] + [10] * (len(headers) - 1)}))
        return {"title": f"{what} per {rname.lower()}" + (f" and {cname.lower()}" if cname else ""),
                "subtitle": self._subtitle(P["scope"]), "blocks": blocks, "_name": "Table - " + P["title"]}

    # ---- Forms & surveys -------------------------------------------------------------------------------
    LIKERT = [["strongly disagree", "disagree", "neutral", "agree", "strongly agree"],
              ["very poor", "poor", "average", "good", "excellent"],
              ["very unhappy", "unhappy", "ok", "happy", "very happy"]]

    def _job_survey(self, P, job):
        r = self._job_forms(dict(P, adv={"file": True, "empty": False}), job)
        if not isinstance(r, dict):
            return r
        tb = next(b[1] for b in r["blocks"] if b[0] == "table")
        headers, rows = tb["headers"][1:], [x[1:] for x in tb["rows"]]
        n = len(rows)
        blocks = [("kpis", [self._kp("Forms", n), self._kp("Questions", len(headers))])]
        charts_y, summary = [], []
        for j, q in enumerate(headers):
            answers = [str(rw[j]).strip() for rw in rows if j < len(rw)]
            given = [a_ for a_ in answers if a_]
            if not given:
                continue
            low = [a_.lower() for a_ in given]
            cnt = OrderedDict()
            for a_ in given:
                k = a_.strip().capitalize()
                cnt[k] = cnt.get(k, 0) + 1
            blank = len(answers) - len(given)
            scale = next((sc for sc in self.LIKERT if sum(1 for a_ in low if a_ in sc) >= len(low) * 0.6), None)
            if scale:
                vals = [sum(1 for a_ in low if a_ == s_) for s_ in scale]
                mean = sum((i + 1) * v for i, v in enumerate(vals)) / max(1, sum(vals))
                charts_y.append(("div", q, scale, vals))
                summary.append([q, "Scale", f"average {mean:.1f} of 5", len(given), blank])
            elif len(cnt) <= 8 and n >= 2:
                charts_y.append(("stack", q, list(cnt), list(cnt.values()) + ([blank] if blank else [])))
                top = max(cnt.items(), key=lambda kv: kv[1])
                summary.append([q, "Choice", f"{top[0]} ({100 * top[1] / max(1, len(given)):.0f}%)", len(given), blank])
            else:
                nums = [parse_number(a_) for a_ in given]
                nums = [x for x in nums if x is not None]
                if nums and len(nums) >= len(given) * 0.8:
                    summary.append([q, "Number", f"average {sum(nums) / len(nums):,.2f} · min {min(nums):g} · "
                                                 f"max {max(nums):g}", len(given), blank])
                else:
                    kw = keyphrases(" . ".join(given), 5)
                    summary.append([q, "Free text", ", ".join(k[0] for k in kw) or "-", len(given), blank])
        ch_stack = [c for c in charts_y if c[0] == "stack"][:12]
        if ch_stack:
            allk = []
            for c in ch_stack:
                for k in c[2]:
                    if k not in allk:
                        allk.append(k)
            allk = allk[:7]
            series = [{"name": k, "values": [c[3][c[2].index(k)] if k in c[2] else 0 for c in ch_stack]} for k in allk]
            cols = [STATUS_COL["good"] if k.lower() in ("yes", "y", "true", "on", "sí", "si") else
                    STATUS_COL["critical"] if k.lower() in ("no", "n", "false", "off") else None for k in allk]
            cat = iter(CHART_CAT)
            cols = [c or next(cat) for c in cols]
            blocks.append(("chart", {"type": "stack", "title": "Answers", "labels": [c[1][:40] for c in ch_stack],
                                     "series": series, "colors": cols}))
        for c in [c for c in charts_y if c[0] == "div"][:6]:
            blocks.append(("chart", {"type": "diverging", "title": c[1][:60], "labels": [c[1][:30]],
                                     "series": [{"name": s_.capitalize(), "values": [v]} for s_, v in zip(c[2], c[3])],
                                     "neg": 2, "neutral": 1}))
        blocks.append(("table", {"name": "Questions", "headers": ["Question", "Kind", "Result", "Answers", "Blank"],
                                 "rows": summary, "widths": [36, 10, 40, 8, 8]}))
        blocks.append(("table", tb))
        return {"title": "Survey results", "subtitle": self._subtitle(P["scope"], f"{n} forms"), "blocks": blocks,
                "_name": "Survey - " + P["title"]}

    # ---- adding key numbers and charts to the older reports --------------------------------------------
    def _enrich(self, t, rep):
        if not isinstance(rep, dict) or any(b[0] in ("kpis",) for b in rep["blocks"]):
            return rep
        blocks = rep["blocks"]
        tables = [b[1] for b in blocks if b[0] == "table"]
        main = rep.get("preview_table") or (tables[0] if tables else None)
        add = []
        try:
            if t in ("snapshot", "rows"):
                pass            # rows exactly as they look: just the rows, like before (no numbers / charts on top)
            elif t == "find" and main and main.get("rows"):
                per = OrderedDict()
                fcol = 0
                for r in main["rows"]:
                    per[str(r[fcol])] = per.get(str(r[fcol]), 0) + 1
                files = {str(r[1]) for r in main["rows"] if len(r) > 1} if t != "rows" else set()
                add.append(("kpis", [self._kp("Rows found", len(main["rows"])), self._kp("Names / values", len(per))] +
                            ([self._kp("Files", len(files))] if files else [])))
                if len(per) > 1:
                    top = sorted(per.items(), key=lambda kv: -kv[1])[:15]
                    add.append(("chart", {"type": "bar", "title": "Rows per name / value", "labels": [k for k, _v in top],
                                          "series": [{"name": "Rows", "values": [v for _k, v in top]}]}))
            elif t == "totals" and main:
                hdr = main["headers"]
                body = main["rows"][:-1] if main.get("total_row") else main["rows"]
                j = next((k for k, h in enumerate(hdr) if k > 0 and h not in ("Rows", "Files")), None)
                add.append(("kpis", [self._kp("People", len(body))] +
                            [self._kp(f"Total {h.lower()}", str(main["rows"][-1][k])) for k, h in enumerate(hdr)
                             if k > 0 and h not in ("Rows", "Files")][:3]))
                if j is not None:
                    vals = [(r[0], parse_number(r[j]) or 0) for r in body]
                    vals = sorted(vals, key=lambda x: -x[1])[:20]
                    add.append(("chart", {"type": "bar", "title": f"{hdr[j]} per person", "labels": [v[0] for v in vals],
                                          "series": [{"name": hdr[j], "values": [v[1] for v in vals]}],
                                          "unit": "€" if any("€" in str(r[j]) for r in body) else ""}))
            elif t in ("phones", "extract"):
                found = next((tb for tb in tables if tb.get("name") == "Found"), None)
                if found:
                    add.append(("kpis", [self._kp(r[0], r[1]) for r in found["rows"]][:6]))
                    if len(found["rows"]) > 1:
                        add.append(("chart", {"type": "donut", "title": "What was found",
                                              "labels": [r[0] for r in found["rows"]],
                                              "series": [{"values": [r[1] for r in found["rows"]]}]}))
            elif t == "dates" and main:
                import datetime
                import calendar
                today = datetime.date.today()
                ds = [parse_date_text(r[0]) for r in main["rows"]]
                ds = [d_ for d_ in ds if d_]
                soon = sum(1 for d_ in ds if 0 <= (d_ - today).days <= 30)
                add.append(("kpis", [self._kp("Dates", len(ds)), self._kp("Next 30 days", soon, "warning" if soon else None),
                                     self._kp("Past", sum(1 for d_ in ds if d_ < today))]))
                months = OrderedDict()
                for d_ in sorted(ds):
                    months[(d_.year, d_.month)] = months.get((d_.year, d_.month), 0) + 1
                if months:
                    keys = list(months)[-18:]
                    add.append(("chart", {"type": "col", "title": "Dates per month",
                                          "labels": [f"{calendar.month_abbr[m_]} {str(y)[2:]}" for y, m_ in keys],
                                          "series": [{"name": "Dates", "values": [months[k] for k in keys]}]}))
            elif t == "money":
                per = next((tb for tb in tables if tb.get("name") == "Per person"), None)
                allm = next((tb for tb in tables if tb.get("name") not in ("Found", "Per person")), None)
                if per:
                    vals = [(r[0], parse_number(r[2]) or 0) for r in per["rows"]]
                    total = sum(v for _k, v in vals)
                    sym = next((c for c in "€$£" if any(c in str(r[2]) for r in per["rows"])), "")
                    add.append(("kpis", [self._kp("Total", f"{sym}{total:,.2f}"), self._kp("People", len(vals)),
                                         self._kp("Amounts", sum(r[1] for r in per["rows"]))]))
                    top = sorted(vals, key=lambda x: -x[1])[:20]
                    add.append(("chart", {"type": "bar", "title": "Total per person", "labels": [k for k, _v in top],
                                          "series": [{"name": "Total", "values": [v for _k, v in top]}], "unit": sym}))
                _ = allm
            elif t in ("forms", "tables", "columns") and main:
                add.append(("kpis", [self._kp("Rows" if t != "forms" else "Forms", len(main["rows"])),
                                     self._kp("Columns" if t != "forms" else "Questions", len(main["headers"]))]))
            elif t == "compare":
                summ = next((tb for tb in tables if tb.get("name") == "Summary"), None)
                if summ:
                    add.append(("kpis", [self._kp(r[0], r[1]) for r in summ["rows"]]))
            elif t == "status" and main:
                cnt = OrderedDict()
                for r in main["rows"]:
                    cnt[r[0]] = cnt.get(r[0], 0) + 1
                add.append(("kpis", [self._kp("Files", len(main["rows"]))] +
                            [self._kp(k if k != "-" else "No status", v) for k, v in cnt.items()][:4]))
                add.append(("chart", {"type": "donut", "title": "Status of files",
                                      "labels": [k if k != "-" else "No status" for k in cnt],
                                      "series": [{"values": list(cnt.values())}],
                                      "colors": [dict(STATUSES).get(k, "#B9B8B2") for k in cnt], "center": "files",
                                      "link": {"table": "Status", "col": "Status"}}))
            elif t == "marks":
                allrows = [r for tb in tables for r in tb["rows"]]
                cnt = OrderedDict()
                for r in allrows:
                    cnt[r[0]] = cnt.get(r[0], 0) + 1
                add.append(("kpis", [self._kp("Marks", len(allrows)), self._kp("Colours", len(cnt))]))
                if cnt:
                    add.append(("chart", {"type": "bar", "title": "Marks per colour", "labels": list(cnt),
                                          "series": [{"name": "Marks", "values": list(cnt.values())}]}))
            elif t == "person":
                pass
        except Exception as ex:
            _log(f"enrich {t}: {ex}")
        rep["blocks"] = add + blocks
        return rep

    # ---- background workers (no window access in here) -------------------------------------------
    def _doc_bytes_open(self, path):
        data = self.writer.get(path)
        if data is None:
            with open(path, "rb") as fh:
                data = _doc_read(fh, path)
        doc = open_stream(self.fitz, data, path)
        if doc.is_reflowable:
            try:
                doc.layout(width=500, height=700, fontsize=12)
            except Exception:
                pass
        return doc

    def _walk_pages(self, P, job, page_filter=None):
        """Yield (name, folder, rel, page_no, rows, doc, page_index) for the pages worth reading."""
        files = P["files"]
        for k, (folder, rel, path) in enumerate(files):
            if job["cancel"]:
                return
            job["progress"] = f"Reading {k + 1} of {len(files)}  ·  Esc to stop"
            texts = self._page_texts(path)
            pages = [i for i, tx in enumerate(texts) if page_filter is None or page_filter(tx)]
            if not pages:
                continue
            try:
                doc = self._doc_bytes_open(path)
            except Exception:
                continue
            name = f"{P['labels'].get(folder, folder)} / {rel}" if P["lib"] else rel
            ctx = {}
            try:
                last = -2
                for pi in pages:
                    if job["cancel"]:
                        return
                    if pi != last + 1:
                        ctx = {}
                        # a table that began on an earlier page: find its column titles (up to 8 pages back),
                        # then read on from there, so the rows here know them
                        start = None
                        for q in range(pi - 1, max(-1, pi - 9), -1):
                            c2 = {}
                            page_rows(self.fitz, doc.load_page(q), c2)
                            if c2.get("vheader"):
                                start = q
                                break
                        for q in range(start if start is not None else pi, pi):
                            pgq = doc.load_page(q)
                            rq = page_rows(self.fitz, pgq, ctx)
                            if P.get("titles"):
                                add_row_titles(pgq, rq, ctx)
                    last = pi
                    pg = doc.load_page(pi)
                    rows = page_rows(self.fitz, pg, ctx)
                    if P.get("titles"):
                        add_row_titles(pg, rows, ctx)
                    yield name, folder, rel, pi + 1, rows, doc, pi
            finally:
                doc.close()

    def _walk_rows(self, P, job, page_filter=None):
        for name, folder, rel, page, rows, doc, pi in self._walk_pages(P, job, page_filter):
            for row in rows:
                yield name, folder, rel, page, row

    @staticmethod
    def _date_ok(text, d_from, d_to):
        if not (d_from or d_to):
            return True
        return any((not d_from or d >= d_from) and (not d_to or d <= d_to) for d in parse_dates(text))

    def _matcher(self, P, terms=None, whole=None):
        terms = P["terms"] if terms is None else terms
        whole = P["adv"].get("wholeword", False) if whole is None else whole
        # 3.0: accents and apostrophes don't matter (Sean = Seán, O'Brien = O’Brien)
        pats = {t: re.compile(((r"(?<!\w)" + re.escape(fold(t)) + r"(?!\w)") if whole else re.escape(fold(t))), re.I)
                for t in terms}

        def match(row):
            hits = []
            for t, p in pats.items():
                if P["match"] == "start":
                    first = next((c for c in row["cells"] if c.strip()), "")
                    if p.match(fold(first.strip())) or (not row["table"] and p.match(fold(row["text"].strip()))):
                        hits.append(t)
                elif p.search(fold(row["text"])):
                    hits.append(t)
            return hits
        lows = [fold(t) for t in terms]
        return match, (lambda tx: any(t in fold(tx) for t in lows))

    def _snapshot(self, doc, pi, row, header=True, scale=2.0, title=False, more=()):
        """A picture of the row exactly as it looks in the PDF - with the table's title and its column titles
        (Name, Date…) on top, even when they are far above or on an earlier page (a dotted line shows the jump)."""
        fitz = self.fitz
        box = row.get("box")
        if not box:
            return None
        pages = {}

        def pinfo(pno):
            """(page rect, horizontal rule positions, text line boxes) of a page - read once."""
            if pno not in pages:
                pg = doc.load_page(pno)
                rules, words = [], []
                try:
                    for dr in pg.get_drawings():
                        for it in dr.get("items", []):
                            if it[0] == "l":
                                p1, p2 = it[1], it[2]
                                if abs(p1.y - p2.y) < 1 and abs(p1.x - p2.x) > 40:
                                    rules.append(p1.y)
                            elif it[0] == "re":
                                r = it[1]
                                if r.height < 2 and r.width > 40:
                                    rules.append(r.y0)
                                elif r.width > 40:
                                    rules += [r.y0, r.y1]
                except Exception:
                    pass
                try:
                    words = [(w[1], w[3]) for w in pg.get_text("words")]
                except Exception:
                    pass
                pages[pno] = (pg.rect, rules, words)
            return pages[pno]
        pr = pinfo(pi)[0]
        tb = row.get("tbox") or (box[0], box[2])
        x0 = max(0, min(tb[0], box[0]) - 6)
        x1 = min(pr.width, max(tb[1], box[2]) + 6)
        if not row.get("table"):
            x0, x1 = max(0, box[0] - 8), min(pr.width, max(box[2] + 8, x0 + 200))
        elif header and row.get("hbox"):                 # all of the column titles
            x0 = max(0, min(x0, row["hbox"][0] - 6))
            x1 = min(pr.width, max(x1, row["hbox"][2] + 6))

        def band(b, pno):
            rect, rules, words = pinfo(pno)
            y0, y1 = b[1] - 3, b[3] + 3
            # never a slice of the line above or below
            above = [wy1 for wy0, wy1 in words if wy1 <= b[1] + 0.5 and wy1 > b[1] - 8]
            below = [wy0 for wy0, wy1 in words if wy0 >= b[3] - 0.5 and wy0 < b[3] + 8]
            if above:
                y0 = max(y0, max(above) + 0.4)
            if below:
                y1 = min(y1, min(below) - 0.4)
            ra = [y for y in rules if b[1] - 16 <= y <= b[1] + 1]
            rb = [y for y in rules if b[3] - 1 <= y <= b[3] + 16]
            if ra:
                y0 = min(y0, max(ra) - 1.5)
            if rb:
                y1 = max(y1, min(rb) + 1.5)
            return fitz.Rect(x0, max(0, y0), x1, min(rect.height, y1))
        parts = []                                     # (page, area)
        tb_ = row.get("title_box") if title else None
        if tb_ and row.get("table"):
            tp = row.get("title_page")
            tp = pi if tp is None else tp
            x0 = max(0, min(x0, tb_[0] - 4))
            x1 = min(pr.width, max(x1, tb_[2] + 4))
            parts.append((tp, fitz.Rect(x0, max(0, tb_[1] - 3), x1, min(pinfo(tp)[0].height, tb_[3] + 3))))
        n_title = len(parts)
        if header and row.get("hbox"):
            hp = row.get("hpage")
            hp = pi if hp is None else hp
            if hp <= pi:
                parts.append((hp, band(row["hbox"], hp)))
        parts.append((pi, band(box, pi)))
        for r2 in more:                       # more rows of the same table: one picture
            if r2.get("box"):
                b2 = band(r2["box"], pi)
                lp, lr = parts[-1]
                if lp == pi and lr.y1 - 1 <= b2.y0 < lr.y1 + 3 and b2.y0 >= lr.y0:     # the next row: one strip
                    parts[-1] = (pi, fitz.Rect(x0, lr.y0, x1, max(lr.y1, b2.y1)))
                else:
                    parts.append((pi, b2))
        kinds = ["title"] * n_title + ["row"] * (len(parts) - n_title)
        merged = []                                     # parts that touch on the page: one strip, as it looks
        for (p_, r), kd in zip(parts, kinds):
            r = fitz.Rect(x0, r.y0, x1, r.y1)
            if merged and merged[-1][0] == p_ and merged[-1][1].y0 <= r.y0 <= merged[-1][1].y1 + 2:
                pm, rm, km = merged[-1]
                merged[-1] = (pm, fitz.Rect(x0, rm.y0, x1, max(rm.y1, r.y1)), km)
            else:
                merged.append((p_, r, kd))
        parts = [(p_, r) for p_, r, _k in merged]
        # between two parts: title then column titles (3 pt), or a jump (rows left out): 7 pt with a dotted line
        gaps = []
        for (pa, ra, ka), (pb, rb, kb) in zip(merged, merged[1:]):
            gaps.append(3 if ka == "title" and kb != "title" and not (pa != pb or rb.y0 - ra.y1 > 60) else
                        7 if (pa != pb or rb.y0 - ra.y1 > 4) else 2)
        W = x1 - x0
        H = sum(r.height for _p, r in parts) + sum(gaps)
        out = fitz.open()
        op = out.new_page(width=W, height=H)
        bg = op.new_shape()
        bg.draw_rect(op.rect)
        bg.finish(color=None, fill=(1, 1, 1))
        bg.commit()
        sh = op.new_shape()
        y = 0
        for k, (p_, r) in enumerate(parts):
            op.show_pdf_page(fitz.Rect(0, y, W, y + r.height), doc, p_, clip=r)
            y += r.height
            if k < len(gaps):
                if gaps[k] > 3:
                    sh.draw_line((4, y + gaps[k] / 2), (W - 4, y + gaps[k] / 2))
                y += gaps[k]
        if any(g_ > 3 for g_ in gaps):
            sh.finish(color=(0.72, 0.74, 0.78), width=0.6, dashes="[1.5 2.5] 0")
            sh.commit()
        png = op.get_pixmap(matrix=fitz.Matrix(scale, scale), alpha=False).tobytes("png")
        out.close()
        return png, W, H

    # People ------------------------------------------------------------------------------------------
    def _job_snapshot(self, P, job):
        match, pf = self._matcher(P)
        adv = P["adv"]
        P["titles"] = True
        found = OrderedDict((t, []) for t in P["terms"])
        join = adv.get("join", True)
        for name, folder, rel, page, rows, doc, pi in self._walk_pages(P, job, pf):
            on_page = OrderedDict()
            for row in rows:
                hits = match(row)
                if not hits or not self._date_ok(row["text"], P["from"], P["to"]):
                    continue
                for t in hits:
                    k = (t, (row.get("hbox"), row.get("tbox"), row.get("title")) if join and row.get("table")
                         else id(row))
                    on_page.setdefault(k, []).append(row)
            for (t, _k), rs in on_page.items():
                snap = self._snapshot(doc, pi, rs[0], header=adv.get("header", True),
                                      title=adv.get("title", True), more=rs[1:])
                found[t].append((name, folder, rel, page, rs, snap))
        if job["cancel"]:
            return None
        total = sum(len(rs) for v in found.values() for *_x, rs, _s in v)
        if not total:
            return "Nothing found. Check the spelling, or look in all your books."
        blocks, images = [], {}
        table_rows = []
        for t, items in found.items():
            if not items:
                continue
            n_t = sum(len(x[4]) for x in items)
            if adv.get("per_person", True):
                blocks.append(("h", f"{t}  ·  {n_t} row{'s' if n_t != 1 else ''}"))
            for name, folder, rel, page, rs, snap in items:
                row = rs[0]
                ttl = row.get("title") or ""
                if snap:
                    cap = ""
                    if adv.get("file_title", True):
                        cap = f"{name}  ·  page {page}"
                        if not adv.get("per_person", True):
                            cap = f"{t}  ·  " + cap
                    if ttl and not (adv.get("title", True) and row.get("title_box") and row.get("table")):
                        cap = (cap + "  ·  " if cap else "") + ttl      # title not in the picture: say it
                    blocks.append(("img", {"png": snap[0], "w": snap[1] * 1.0, "h": snap[2], "caption": cap,
                                           "loc": (folder, rel, page)}))
                for r in rs:
                    images[len(table_rows)] = snap[0] if snap else None
                    table_rows.append([t, name, page, ttl, r["text"]])
        tb = {"name": "Rows", "headers": ["Found", "File", "Page", "Table / section", "Row"], "rows": table_rows,
              "widths": [13, 22, 5, 18, 42]}
        if adv.get("text_too"):
            blocks.append(("h", "The same rows as text"))
            blocks.append(("table", tb))
        what = ", ".join(P["terms"][:4]) + ("…" if len(P["terms"]) > 4 else "")
        return {"title": f"Rows of {what}", "subtitle": self._subtitle(P["scope"], f"{total} rows"),
                "blocks": blocks, "preview_table": tb, "images": images, "_name": f"Rows of {what[:40]}",
                "_view": "pictures"}

    def _job_person(self, P, job):
        match, pf = self._matcher(P, whole=P["adv"].get("wholeword", True))
        kinds = ["Phone numbers", "Emails", "Addresses", "Dates", "Amounts"]
        data = OrderedDict((t, {k: [] for k in kinds} | {"mentions": [], "files": []}) for t in P["terms"])
        for name, folder, rel, page, rows, doc, pi in self._walk_pages(P, job, pf):
            for i, row in enumerate(rows):
                hits = match(row)
                for t in hits:
                    near = " | ".join(r["text"] for r in (rows[i:i + 1] if row["table"] else rows[max(0, i - 2):i + 7]))
                    d = data[t]
                    for k in kinds:
                        for v in find_values(k, near if k != "Dates" else row["text"]):
                            if v not in d[k]:
                                d[k].append(v)
                    d["mentions"].append([name, page, row["text"]])
                    if name not in d["files"]:
                        d["files"].append(name)
        if job["cancel"]:
            return None
        if not any(d["mentions"] for d in data.values()):
            return "Those names were not found."
        rows = [[t] + [", ".join(d[k][:6]) for k in kinds] + [len(d["mentions"]), ", ".join(d["files"][:4])]
                for t, d in data.items()]
        blocks = [("table", {"name": "People", "headers": ["Person", "Phones", "Emails", "Addresses", "Dates",
                                                            "Amounts", "Times found", "Files"], "rows": rows,
                             "widths": [16, 16, 22, 22, 16, 12, 8, 24]})]
        if P["adv"].get("mentions", True):
            for t, d in data.items():
                if d["mentions"]:
                    blocks.append(("h", f"{t}  ·  where they appear"))
                    blocks.append(("table", {"name": t, "headers": ["File", "Page", "Row / line"],
                                             "rows": d["mentions"], "widths": [24, 6, 70]}))
        return {"title": "Everything about " + ", ".join(P["terms"][:3]), "blocks": blocks,
                "subtitle": self._subtitle(P["scope"]), "_name": "People - " + P["title"]}

    def _job_find(self, P, job):
        match, pf = self._matcher(P)
        P["titles"] = True
        out = []
        for name, folder, rel, page, row in self._walk_rows(P, job, pf):
            hits = match(row)
            if hits and self._date_ok(row["text"], P["from"], P["to"]):
                out.append([", ".join(hits), name, page, row.get("title") or ("Table" if row["table"] else ""),
                            row["text"]])
        if job["cancel"]:
            return None
        if not out:
            return "Nothing found."
        per_doc = OrderedDict()
        for r in out:
            d_ = per_doc.setdefault(r[1], [0, set(), set()])
            d_[0] += 1
            d_[1].add(r[2])
            d_[2].add(r[0])
        docs = [[f, n, ", ".join(str(p_) for p_ in sorted(pg)[:12]), ", ".join(sorted(w))]
                for f, (n, pg, w) in per_doc.items()]
        return {"title": "Found: " + ", ".join(P["terms"][:4]), "subtitle": self._subtitle(P["scope"], f"{len(out)} places"),
                "blocks": [("table", {"name": "Found", "headers": ["Found", "File", "Page", "Table / section",
                                                                   "Row / line"],
                                      "rows": out, "widths": [12, 20, 5, 17, 46]}),
                           ("h", f"Documents  ·  {len(docs)}"),
                           ("table", {"name": "Documents", "headers": ["File", "Rows", "Pages", "Found"], "rows": docs,
                                      "widths": [36, 8, 20, 30]})],
                "_name": "Find - " + P["title"]}

    # Tables -----------------------------------------------------------------------------------------
    def _job_rows(self, P, job):
        adv = P["adv"]
        P["titles"] = True
        match, pf = self._matcher(P)
        incol = [k.strip().lower() for k in re.split(r"[,;]+", P["incol"]) if k.strip()]
        excl = [k.strip().lower() for k in re.split(r"[,;\n]+", P["excl"]) if k.strip()]
        found = OrderedDict((t, []) for t in P["terms"])
        pics = []

        def rows_with_doc():
            for name, folder, rel, page, rows, doc, pi in self._walk_pages(P, job, pf):
                for row in rows:
                    yield name, folder, rel, page, row, doc, pi
        for name, folder, rel, page, row, doc, pi in rows_with_doc():
            orig = row
            if incol:
                if not row["header"]:
                    continue
                cells = [c for h, c in zip(row["header"], row["cells"]) if any(k in (h or "").lower() for k in incol)]
                if not cells:
                    continue
                row = dict(row, text=" | ".join(cells), cells_all=row["cells"])
            if excl and any(x in row["text"].lower() for x in excl):
                continue
            if not self._date_ok(row["text"], P["from"], P["to"]):
                continue
            hits = match(row if not incol else dict(row, cells=[row["text"]]))
            for t in hits:
                found[t].append((name, page, row))
            if hits and adv.get("pictures") and len(pics) < 400:
                snap = self._snapshot(doc, pi, orig, header=True, title=adv.get("titles", True))
                if snap:
                    pics.append((hits[0], name, page, snap, (folder, rel, page)))
        total = sum(len(v) for v in found.values())
        if job["cancel"]:
            return None
        if not total:
            return "Nothing found. Try 'Anywhere in the row', or look in all your books."
        fp = adv.get("file_page", True)
        blocks = [("table", {"name": "Found", "headers": ["Looked for", "Rows found", "Files"], "widths": [28, 10, 52],
                             "rows": [[t, len(v), ", ".join(sorted({n for n, _, _ in v}))] for t, v in found.items()]})]

        show_t = adv.get("titles", True)

        def tables_for(items, with_found):
            groups = OrderedDict()
            for t, (name, page, row) in items:
                cells = row.get("cells_all", row["cells"])
                hdr = row["header"] or ["Line"]
                cells = cells if row["header"] else [row["text"]]
                ttl = (row.get("title") or "").replace(" (continued)", "") if show_t else ""
                key = (ttl.lower(), tuple(h.lower() for h in hdr))
                g = groups.setdefault(key, {"headers": (["Found"] if with_found else []) +
                                            (["File", "Page"] if fp else []) + list(hdr), "rows": [],
                                            "title": ttl})
                g["rows"].append(([t] if with_found else []) + ([name, page] if fp else []) +
                                 list(cells) + [""] * (len(hdr) - len(cells)))
            out = []
            for g in groups.values():
                skip = (1 if with_found else 0) + (2 if fp else 0)
                tot = totals_row(g["headers"], g["rows"], skip) if adv.get("totals", True) and len(g["rows"]) > 1 \
                    else None
                out.append({"name": "", "headers": g["headers"], "rows": g["rows"] + ([tot] if tot else []),
                            "widths": [14] * skip + [18] * (len(g["headers"]) - skip), "total_row": bool(tot),
                            "_title": g["title"]})
            return out
        if adv.get("per_value", True):
            for t, items in found.items():
                if not items:
                    continue
                blocks.append(("h", f"{t}  ·  {len(items)} row{'s' if len(items) != 1 else ''}"))
                for k, tb in enumerate(tables_for([(t, x) for x in items], False)):
                    ttl = tb.pop("_title", "")
                    if ttl:
                        blocks.append(("h3", ttl))
                    tb["name"] = f"{t} · {ttl}" if ttl else (t if k == 0 else f"{t} ({k + 1})")
                    blocks.append(("table", tb))
        else:
            for k, tb in enumerate(tables_for([(t, x) for t, v in found.items() for x in v], True)):
                ttl = tb.pop("_title", "")
                if ttl:
                    blocks.append(("h3", ttl))
                tb["name"] = ttl or ("Rows" if k == 0 else f"Rows ({k + 1})")
                blocks.append(("table", tb))
        if pics:
            blocks.append(("h", "The rows as they look"))
            for t, name, page, snap, loc in pics:
                blocks.append(("img", {"png": snap[0], "w": snap[1], "h": snap[2],
                                       "caption": f"{t}  ·  {name}  ·  page {page}", "loc": loc}))
        what = ", ".join(P["terms"][:4]) + ("…" if len(P["terms"]) > 4 else "")
        return {"title": f"Rows: {what}", "subtitle": self._subtitle(P["scope"], f"{total} rows"), "blocks": blocks,
                "_name": f"Rows - {what[:40]}", "_view": "table"}

    def _job_columns(self, P, job):
        adv = P["adv"]
        want = [k.strip().lower() for k in re.split(r"[,;\n]+", P["cols_txt"]) if k.strip()]
        only = [t.lower() for t in P["terms"]]
        P["titles"] = True
        groups = OrderedDict()
        for name, folder, rel, page, row in self._walk_rows(P, job, None):
            if not row["header"]:
                continue
            idx = [j for j, h in enumerate(row["header"]) if any((h or "").lower().startswith(w) or w in (h or "").lower()
                                                                 for w in want)]
            if not idx:
                continue
            if only and not any(o in row["text"].lower() for o in only):
                continue
            first = [0] if adv.get("first_col", True) and 0 not in idx else []
            heads = [row["header"][j] for j in first + idx]
            key = tuple(h.lower() for h in heads)
            g = groups.setdefault(key, {"headers": (["File", "Page"] if adv.get("file_page", True) else []) +
                                        ["Table"] + heads, "rows": []})
            g["rows"].append(([name, page] if adv.get("file_page", True) else []) +
                             [(row.get("title") or "").replace(" (continued)", "")] +
                             [row["cells"][j] if j < len(row["cells"]) else "" for j in first + idx])
        if job["cancel"]:
            return None
        if not groups:
            return "No column with that name was found. Check the exact heading in your tables."
        blocks = []
        for i, g in enumerate(groups.values()):
            rows = g["rows"]
            if adv.get("unique"):
                seen, uniq = set(), []
                for r in rows:
                    k = tuple(str(x).lower() for x in r[(2 if adv.get("file_page", True) else 0):])
                    if k not in seen:
                        seen.add(k)
                        uniq.append(r)
                rows = uniq
            skip = (2 if adv.get("file_page", True) else 0) + 1
            if not any(str(r[skip - 1]).strip() for r in rows):          # no titles found: no empty column
                g["headers"] = g["headers"][:skip - 1] + g["headers"][skip:]
                rows = [r[:skip - 1] + r[skip:] for r in rows]
                skip -= 1
            tot = totals_row(g["headers"], rows, skip + (1 if adv.get("first_col", True) else 0)) \
                if adv.get("totals", True) and len(rows) > 1 else None
            blocks.append(("h", ", ".join(g["headers"][skip:]) + f"  ·  {len(rows)}"))
            blocks.append(("table", {"name": f"Columns {i + 1}", "headers": g["headers"],
                                     "rows": rows + ([tot] if tot else []), "total_row": bool(tot),
                                     "widths": [20] * len(g["headers"])}))
        return {"title": "Columns: " + P["cols_txt"], "subtitle": self._subtitle(P["scope"]), "blocks": blocks,
                "_name": "Columns - " + P["title"], "_view": "table"}

    def _job_totals(self, P, job):
        only = [t.lower() for t in P["terms"]]
        people = OrderedDict()
        sums_cols = []
        for name, folder, rel, page, row in self._walk_rows(P, job, None):
            if not row["header"] or not row["cells"]:
                continue
            if TOTAL_ROW.match((row["cells"][0] or "").strip()):
                continue
            who = person_name(row) or row["cells"][0]
            if not who or not looks_like_name(who) and not NAME_HDR.search(row["header"][0] or ""):
                continue
            if only and not any(o in who.lower() for o in only):
                continue
            if not self._date_ok(row["text"], P["from"], P["to"]):
                continue
            rec = people.setdefault(who, {"rows": 0, "sums": OrderedDict(), "money": {}, "files": []})
            rec["rows"] += 1
            if name not in rec["files"]:
                rec["files"].append(name)
            for h, c in zip(row["header"], row["cells"]):
                if not c or not SUM_HDR.search(h or "") and not re.search(r"[€$£]", c):
                    continue
                if re.search(r"date|phone|tel|start|finish|from|to\b|time", h or "", re.I):
                    continue
                n = parse_number(c)
                if n is None:
                    continue
                key = (h or "Amount").strip()
                rec["sums"][key] = rec["sums"].get(key, 0) + n
                if re.search(r"[€$£]", c):
                    rec["money"][key] = next(ch for ch in "€$£" if ch in c)
                if key not in sums_cols:
                    sums_cols.append(key)
        if job["cancel"]:
            return None
        if not people:
            return "No tables with names and numbers (hours, fees…) were found."
        headers = ["Person"] + (["Rows"] if P["adv"].get("count", True) else []) + sums_cols + \
            (["Files"] if P["adv"].get("files", True) else [])
        rows = []
        grand = {c: 0 for c in sums_cols}
        for who, rec in sorted(people.items(), key=lambda kv: kv[0].lower()):
            r = [who] + ([rec["rows"]] if P["adv"].get("count", True) else [])
            for c in sums_cols:
                v = rec["sums"].get(c)
                grand[c] += v or 0
                sym = rec["money"].get(c, "")
                r.append("" if v is None else (f"{sym}{v:,.2f}" if sym else f"{v:g}"))
            if P["adv"].get("files", True):
                r.append(", ".join(rec["files"][:3]) + (f" (+{len(rec['files']) - 3})" if len(rec["files"]) > 3 else ""))
            rows.append(r)
        tot = ["Total"] + ([sum(p["rows"] for p in people.values())] if P["adv"].get("count", True) else []) + \
            [f"{grand[c]:,.2f}" if any(c in p["money"] for p in people.values()) else f"{grand[c]:g}" for c in sums_cols] + \
            ([""] if P["adv"].get("files", True) else [])
        return {"title": "Totals per person", "subtitle": self._subtitle(P["scope"], f"{len(rows)} people"),
                "blocks": [("table", {"name": "Totals", "headers": headers, "rows": rows + [tot], "total_row": True,
                                      "widths": [22] + [10] * (len(headers) - 1)})], "_name": "Totals - " + P["title"]}

    SHIFT_RE = re.compile(r"(?<![\d/.])(\d{1,2})(?:[:.](\d{2}))?\s*(am|pm|a\.m\.|p\.m\.)?\s*(?:-|–|—|to|till|until)\s*"
                          r"(\d{1,2})(?:[:.](\d{2}))?\s*(am|pm|a\.m\.|p\.m\.)?(?![\d/])", re.I)
    DAY_HDR = re.compile(r"\b(mon|tue|wed|thu|fri|sat|sun)\w*|\b\d{1,2}[/.-]\d{1,2}|shift|time|hours|rota|day\b",
                         re.I)

    @staticmethod
    def _shift_hours(h1, m1, ap1, h2, m2, ap2):
        """Hours of one shift ('8-4' is 8:00 to 16:00; '22-6' goes over midnight)."""
        def to24(h, ap):
            ap = (ap or "").lower().replace(".", "")
            if ap == "pm" and h < 12:
                return h + 12
            if ap == "am" and h == 12:
                return 0
            return h
        a = to24(h1, ap1) + m1 / 60
        b = to24(h2, ap2) + m2 / 60
        if not ap2 and b <= a and h2 < 12:
            b += 12                                   # 8-4 = 8:00 to 16:00
        if b <= a:
            b += 24                                   # a night shift
        d = b - a
        return d if 0 < d <= 16 else None

    def _job_hours(self, P, job):
        """3.0 - hours from rotas: each person's shifts (8-4, 08:00-16:30, 9am-1pm, Start/Finish/Break) added up,
        per day (the rota's columns) and in total."""
        only = [t.lower() for t in P["terms"]]
        people = OrderedDict()
        days = []
        for name, folder, rel, page, row in self._walk_rows(P, job, None):
            cells, hdr = row.get("cells") or [], row.get("header") or []
            if not cells or len(cells) < 2:
                continue
            if TOTAL_ROW.match((cells[0] or "").strip()):
                continue
            who = person_name(row) or cells[0]
            if who and not looks_like_name(who):        # ('Aoife Kelly Total': a total row read into the last one)
                who = re.sub(r"\s+(?:grand\s+)?(?:sub-?\s?)?totals?\b.*$", "", who, flags=re.I).strip()
            if not who or not looks_like_name(who):
                continue
            if only and not any(o in who.lower() for o in only):
                continue
            found = []
            hl = [str(h or "") for h in hdr] + [""] * (len(cells) - len(hdr))
            # Start / Finish (/ Break) columns
            si = next((i for i, h in enumerate(hl) if re.search(r"\b(start|from|time in|in)\b", h, re.I)), None)
            fi_ = next((i for i, h in enumerate(hl) if re.search(r"\b(finish|end|until|to|time out|out)\b", h, re.I)),
                       None)
            bi = next((i for i, h in enumerate(hl) if re.search(r"\bbreak|lunch\b", h, re.I)), None)
            if si is not None and fi_ is not None and si < len(cells) and fi_ < len(cells):
                m = self.SHIFT_RE.search(f"{cells[si]} - {cells[fi_]}")
                if m and (":" in (cells[si] + cells[fi_]) or re.search(r"[ap]\.?m", cells[si] + cells[fi_], re.I)):
                    hrs = self._shift_hours(int(m.group(1)), int(m.group(2) or 0), m.group(3), int(m.group(4)),
                                            int(m.group(5) or 0), m.group(6))
                    if hrs:
                        if bi is not None and bi < len(cells):
                            b_ = parse_number(cells[bi])
                            if b_:
                                hrs -= b_ / 60 if b_ > 4 else b_       # 30 = minutes, 0.5 = hours
                        day = next((h for h in hl if re.search(r"\b(mon|tue|wed|thu|fri|sat|sun)", h, re.I)), "")
                        found.append((day or "", max(0, hrs)))
            if not found:
                for i, c in enumerate(cells[1:], start=1):
                    c = str(c or "")
                    h = hl[i] if i < len(hl) else ""
                    for m in self.SHIFT_RE.finditer(c):
                        if not (self.DAY_HDR.search(h) or ":" in m.group(0) or m.group(3) or m.group(6)):
                            continue
                        hrs = self._shift_hours(int(m.group(1)), int(m.group(2) or 0), m.group(3),
                                                int(m.group(4)), int(m.group(5) or 0), m.group(6))
                        if hrs:
                            found.append((" ".join(h.split())[:14], hrs))
            if not found:
                continue
            rec = people.setdefault(who, {"shifts": 0, "hours": 0.0, "days": OrderedDict(), "files": []})
            for day, hrs in found:
                rec["shifts"] += 1
                rec["hours"] += hrs
                if day:
                    rec["days"][day] = rec["days"].get(day, 0) + hrs
                    if day not in days:
                        days.append(day)
            if name not in rec["files"]:
                rec["files"].append(name)
        if job["cancel"]:
            return None
        if not people:
            return ("No shifts were found. The rota needs a name in the first column and shifts like 8-4, "
                    "08:00-16:30 or 9am-1pm (or Start and Finish columns).")
        days = days[:14]
        fmt = lambda v: "" if not v else (f"{v:.2f}".rstrip("0").rstrip("."))
        headers = ["Person", "Shifts", "Hours"] + days + (["Files"] if P["adv"].get("files", True) else [])
        rows = []
        for who, rec in sorted(people.items(), key=lambda kv: -kv[1]["hours"]):
            r = [who, rec["shifts"], fmt(rec["hours"])] + [fmt(rec["days"].get(d_, 0)) for d_ in days]
            if P["adv"].get("files", True):
                r.append(", ".join(rec["files"][:3]) + (f" (+{len(rec['files']) - 3})" if len(rec["files"]) > 3
                                                        else ""))
            rows.append(r)
        tot_h = sum(p_["hours"] for p_ in people.values())
        tot = ["Total", sum(p_["shifts"] for p_ in people.values()), fmt(tot_h)] + \
            [fmt(sum(p_["days"].get(d_, 0) for p_ in people.values())) for d_ in days] + \
            ([""] if P["adv"].get("files", True) else [])
        top = sorted(people.items(), key=lambda kv: -kv[1]["hours"])[:15]
        blocks = [("kpis", [self._kp("People", len(people)), self._kp("Shifts", tot[1]),
                            self._kp("Hours", fmt(tot_h)),
                            self._kp("Hours per person", fmt(tot_h / max(1, len(people))))]),
                  ("chart", {"type": "bar", "title": "Hours per person", "labels": [w_ for w_, _r in top],
                             "series": [{"name": "Hours", "values": [round(r_["hours"], 2) for _w, r_ in top]}]}),
                  ("table", {"name": "Hours", "headers": headers, "rows": rows + [tot], "total_row": True,
                             "widths": [22, 8, 8] + [9] * len(days) + ([28] if P["adv"].get("files", True) else [])})]
        return {"title": "Hours from rotas", "subtitle": self._subtitle(P["scope"], f"{len(people)} people"),
                "blocks": blocks, "_name": "Hours - " + P["title"]}

    def _job_tables(self, P, job):
        adv = P["adv"]
        P["titles"] = True
        groups = OrderedDict()
        n_tables = 0
        last_key = None
        for name, folder, rel, page, row in self._walk_rows(P, job, None):
            if not row["table"] or not row["header"]:
                last_key = None
                continue
            key = tuple(h.lower() for h in row["header"])
            if not adv.get("combine", True):
                if key != last_key:
                    n_tables += 1
                key = key + (n_tables,)
            last_key = key[:len(row["header"])]
            g = groups.setdefault(key, {"headers": (["File", "Page"] if adv.get("file_page") else []) + list(row["header"]),
                                        "rows": [], "files": set(), "titles": []})
            g["rows"].append(([name, page] if adv.get("file_page") else []) + list(row["cells"]))
            g["files"].add(name)
            tt = (row.get("title") or "").replace(" (continued)", "")
            if tt and tt not in g["titles"]:
                g["titles"].append(tt)
        groups = OrderedDict((k, g) for k, g in groups.items() if len(g["rows"]) >= 2)
        if job["cancel"]:
            return None
        if not groups:
            return "No tables were found here."
        blocks = []
        for i, (k, g) in enumerate(groups.items()):
            title = ", ".join(g["titles"][:2]) + ("…" if len(g["titles"]) > 2 else "") if g["titles"] else \
                ", ".join(g["headers"][2 if adv.get("file_page") else 0:][:4])
            blocks.append(("h", f"{title}  ·  {len(g['rows'])} rows from {len(g['files'])} file(s)"))
            blocks.append(("table", {"name": (g["titles"][0] if g["titles"] else f"Table {i + 1}")[:40],
                                     "headers": g["headers"], "rows": g["rows"],
                                     "widths": [16] * len(g["headers"])}))
        return {"title": "Tables", "subtitle": self._subtitle(P["scope"], f"{len(groups)} tables"), "blocks": blocks,
                "_name": "Tables - " + P["title"], "_view": "table"}

    # Data -------------------------------------------------------------------------------------------
    def _extract_core(self, P, job, kinds, inc, unique, only_people=None):
        only = [x.strip().lower() for x in re.split(r"[,;]+", P.get("only", "")) if x.strip()]
        people = [t.lower() for t in (only_people or [])]
        pats = [EXTRACT_PATTERNS[k] for k in kinds]
        pf = lambda tx: any(p.search(tx) for p in pats) and (not only or any(o in tx.lower() for o in only)) and \
            (not people or any(o in tx.lower() for o in people))
        res = OrderedDict((k, []) for k in kinds)
        for name, folder, rel, page, rows, doc, pi in self._walk_pages(P, job, pf):
            for i, row in enumerate(rows):
                text = row["text"]
                if only and not any(o in text.lower() for o in only):
                    continue
                if not self._date_ok(text, P["from"], P["to"]):
                    continue
                org = None
                for k in kinds:
                    for v in find_values(k, text):
                        j = next((jj for jj, c in enumerate(row["cells"]) if v in c), 0) if row.get("table") else 0
                        who = link_value(rows, i, j, None, v)[0]
                        if org is None:
                            org = organisation(row)
                        if people and not any(o in (who or "").lower() or o in text.lower() for o in people):
                            continue
                        res[k].append({"Value": v, "Name": who, "Organisation": org, "Whole row": text,
                                       "File": name, "Page": page})
        if job["cancel"]:
            return None
        total = sum(len(v) for v in res.values())
        if not total:
            return "Nothing of that kind was found here."
        label = dict(self.EXTRACT_KINDS)
        blocks = [("table", {"name": "Found", "headers": ["Kind", "Found"],
                             "rows": [[label.get(k, k), len(v)] for k, v in res.items()]})]
        for k, items in res.items():
            if not items:
                continue
            if unique:
                merged = OrderedDict()
                for it in items:
                    key = re.sub(r"\D", "", it["Value"]) if k == "Phone numbers" else re.sub(r"\s+", " ", it["Value"].lower())
                    m = merged.setdefault(key, dict(it, Times=0, Files=[]))
                    m["Times"] += 1
                    if it["File"] not in m["Files"]:
                        m["Files"].append(it["File"])
                    m["Name"] = m["Name"] or it["Name"]
                    m["Organisation"] = m["Organisation"] or it["Organisation"]
                headers = [label.get(k, k)] + [c for c in inc if c in ("Name", "Organisation")] + ["Times"] + \
                    (["Files"] if "File" in inc else [])
                rows = []
                for m in merged.values():
                    r = [m["Value"]] + [m[c] or "" for c in inc if c in ("Name", "Organisation")] + [m["Times"]]
                    if "File" in inc:
                        r.append(", ".join(m["Files"][:3]) + (f" (+{len(m['Files']) - 3})" if len(m["Files"]) > 3 else ""))
                    rows.append(r)
            else:
                headers = [label.get(k, k)] + [c for c in ("Name", "Organisation", "Whole row", "File", "Page") if c in inc]
                rows = [[it["Value"]] + [it[c] or "" for c in ("Name", "Organisation", "Whole row", "File", "Page")
                                         if c in inc] for it in items]
            tot = None
            if k == "Amounts":
                nums = [n for n in (parse_number(it["Value"]) for it in items) if n is not None]
                if nums:
                    sym = next((c for c in "€$£" if any(c in it["Value"] for it in items)), "")
                    tot = ["Total " + f"{sym}{sum(nums):,.2f}"] + [""] * (len(headers) - 1)
            blocks.append(("h", f"{label.get(k, k)}  ·  {len(rows)}"))
            blocks.append(("table", {"name": label.get(k, k), "headers": headers,
                                     "rows": rows + ([tot] if tot else []), "total_row": bool(tot),
                                     "widths": [24] + [18] * (len(headers) - 1)}))
        return {"blocks": blocks, "total": total, "res": res}

    def _job_extract(self, P, job):
        r = self._extract_core(P, job, P["kinds"], [c for c in ("Name", "Organisation", "Whole row", "File", "Page")
                                                    if c in P["inc"]], P["adv"].get("unique", False))
        if not isinstance(r, dict):
            return r
        return {"title": "Extracted data", "subtitle": self._subtitle(P["scope"], f"{r['total']} values"),
                "blocks": r["blocks"], "_name": "Data - " + P["title"]}

    def _job_phones(self, P, job):
        a = P["adv"]
        inc = [c for c, k in (("Name", "name"), ("Organisation", "org"), ("Whole row", "row"), ("File", "file_page"),
                              ("Page", "file_page")) if a.get(k, c in ("Name", "File", "Page"))]
        r = self._extract_core(P, job, ["Phone numbers", "Emails"], inc, a.get("unique", True), P["terms"])
        if not isinstance(r, dict):
            return r
        return {"title": "Phones & emails", "subtitle": self._subtitle(P["scope"], f"{r['total']} found"),
                "blocks": r["blocks"], "_name": "Phones - " + P["title"]}

    def _job_money(self, P, job):
        a = P["adv"]
        inc = ["Name"] + (["File", "Page"] if a.get("file_page", True) else []) + ["Whole row"]
        r = self._extract_core(P, job, ["Amounts"], inc, False, P["terms"])
        if not isinstance(r, dict):
            return r
        blocks = r["blocks"]
        if a.get("per_person", True):
            per = OrderedDict()
            for it in r["res"]["Amounts"]:
                n = parse_number(it["Value"])
                if n is None:
                    continue
                k = it["Name"] or "(no name)"
                per.setdefault(k, [0, 0, ""])
                per[k][0] += n
                per[k][1] += 1
                per[k][2] = per[k][2] or next((c for c in "€$£" if c in it["Value"]), "")
            rows = [[k, v[1], f"{v[2]}{v[0]:,.2f}"] for k, v in sorted(per.items(), key=lambda kv: -kv[1][0])]
            blocks.insert(1, ("h", "Total per person"))
            blocks.insert(2, ("table", {"name": "Per person", "headers": ["Person", "Amounts", "Total"], "rows": rows,
                                        "widths": [30, 10, 16]}))
        return {"title": "Fees & amounts", "subtitle": self._subtitle(P["scope"], f"{r['total']} amounts"),
                "blocks": blocks, "_name": "Money - " + P["title"]}

    def _job_dates(self, P, job):
        only = [x.strip().lower() for x in P["terms"]]
        today = __import__("datetime").date.today()
        out = []
        for name, folder, rel, page, row in self._walk_rows(P, job, lambda tx: bool(EXTRACT_PATTERNS["Dates"].search(tx))):
            if only and not any(o in row["text"].lower() for o in only):
                continue
            for d in parse_dates(row["text"]):
                if P["from"] and d < P["from"] or P["to"] and d > P["to"]:
                    continue
                if P["adv"].get("future") and d < today:
                    continue
                out.append((d, name, page, row["text"]))
        if job["cancel"]:
            return None
        if not out:
            return "No dates found here."
        out.sort(key=lambda x: x[0])
        fp = P["adv"].get("file_page", True)
        rows = [[d.strftime("%d/%m/%Y"), d.strftime("%a")] + ([n, p] if fp else []) + [t] for d, n, p, t in out]
        per_m = OrderedDict()
        for d, _n, _p, _t in out:
            if abs((d - today).days) <= 5 * 366:
                k_ = d.strftime("%b %y")
                per_m[k_] = per_m.get(k_, 0) + 1
        coming = sum(1 for d, *_r in out if 0 <= (d - today).days <= 30)
        blocks = [("kpis", [self._kp("Dates", len(rows)), self._kp("In the next 30 days", coming),
                            self._kp("Documents", len({n for _d, n, _p, _t in out}))])]
        if len(per_m) > 1:
            ks = list(per_m)[-18:]
            blocks.append(("chart", {"type": "col", "title": "Dates per month", "labels": ks,
                                     "series": [{"name": "Dates", "values": [per_m[k_] for k_ in ks]}]}))
        blocks.append(("table", {"name": "Dates", "headers": ["Date", "Day"] + (["File", "Page"] if fp else []) + ["Line"],
                                 "rows": rows, "widths": [10, 5] + ([22, 6] if fp else []) + [57]}))
        return {"title": "Dates & deadlines", "subtitle": self._subtitle(P["scope"], f"{len(rows)} dates"),
                "blocks": blocks, "_name": "Dates - " + P["title"]}

    # Forms ------------------------------------------------------------------------------------------
    def _job_forms(self, P, job):
        only = [t.lower() for t in P["terms"]]
        lab_re = re.compile(r"^\s*([A-Za-zÁÉÍÓÚáéíóúñÑ][\w /'’()&.,-]{1,45}?)\s*[:：]\s*(.*)$")
        records, order = [], OrderedDict()
        for k, (folder, rel, path) in enumerate(P["files"]):
            if job["cancel"]:
                return None
            job["progress"] = f"Reading {k + 1} of {len(P['files'])}  ·  Esc to stop"
            try:
                doc = self._doc_bytes_open(path)
            except Exception:
                continue
            ans = OrderedDict()
            try:
                for pg in doc:
                    for w in pg.widgets() or []:
                        nm = (w.field_label or w.field_name or "").strip()
                        if nm and w.field_type not in (self.fitz.PDF_WIDGET_TYPE_BUTTON,):
                            v = widget_answer(self.fitz, w)          # 4.1: tick boxes say Ticked / Not ticked
                            if v or nm not in ans:
                                ans[nm] = v
                    ctx = {}
                    rows = page_rows(self.fitz, pg, ctx)
                    for i, row in enumerate(rows):
                        if row["table"] and len([c for c in row["cells"] if c]) == 2 and not row["header"]:
                            pass
                        t_ = row["cells"][0] if row["table"] else row["text"]
                        mt = _TICK_LINE.match(row["text"])           # 4.1: '☑ I agree to photos'
                        if mt and len(mt.group(2).split()) <= 10:
                            ans.setdefault(mt.group(2).strip().rstrip(".:"), tick_answer(mt.group(1)))
                            continue
                        m = lab_re.match(t_)
                        if m:
                            labl, val = m.group(1).strip(), m.group(2).strip()
                            if not val and row["table"] and len(row["cells"]) > 1:
                                val = " ".join(c for c in row["cells"][1:] if c)
                            if not val and i + 1 < len(rows) and not lab_re.match(rows[i + 1]["text"]):
                                val = rows[i + 1]["text"] if len(rows[i + 1]["text"]) < 80 else ""
                            val = tick_answer(val) or val
                            if len(labl.split()) <= 7:
                                ans.setdefault(labl, val)
            finally:
                doc.close()
            if not ans:
                continue
            name = f"{P['labels'].get(folder, folder)} / {rel}" if P["lib"] else rel
            records.append((name, ans))
            for q in ans:
                order[q] = order.get(q, 0) + 1
        if not records:
            return "No forms or 'Question: answer' lines were found."
        qs = [q for q, n in sorted(order.items(), key=lambda kv: -kv[1]) if (n >= 2 or len(records) == 1)]
        if only:
            qs = [q for q in qs if any(o in q.lower() for o in only)]
        qs = qs[:40]
        headers = (["File"] if P["adv"].get("file", True) else []) + qs
        rows = []
        for name, ans in records:
            r = ([name] if P["adv"].get("file", True) else []) + [ans.get(q, "") for q in qs]
            if P["adv"].get("empty") or any(ans.get(q) for q in qs):
                rows.append(r)
        blocks = []
        # 4.1: tick boxes counted - how many forms ticked each one
        ticks = []
        for q in qs:
            vals = [ans.get(q, "") for _n, ans in records if ans.get(q)]
            if vals and all(v in ("Ticked", "Not ticked") for v in vals):
                ticks.append([q, sum(1 for v in vals if v == "Ticked"), sum(1 for v in vals if v == "Not ticked")])
        answers = {"name": "Answers", "headers": headers, "rows": rows, "widths": [22] + [16] * len(qs)}
        if ticks and len(records) > 1:
            top = max(ticks, key=lambda t: t[1])
            blocks.append(("kpis", [self._kp("Forms", len(records)), self._kp("Tick boxes", len(ticks))]))
            blocks.append(("chart", {"type": "bar", "title": "Ticked - in how many forms", "labels":
                                     [t[0] for t in ticks], "series": [{"name": "Ticked", "values":
                                                                       [t[1] for t in ticks]}],
                                     "finding": f"{top[0]}: ticked in {top[1]} of {top[1] + top[2]} forms."}))
        blocks.append(("table", answers))           # the answers first - the table you see and save first
        if ticks and len(records) > 1:
            blocks.append(("table", {"name": "Tick boxes", "headers": ["Box", "Ticked", "Not ticked"],
                                     "rows": ticks, "widths": [50, 12, 12]}))
        return {"title": "Form answers", "subtitle": self._subtitle(P["scope"], f"{len(rows)} forms"),
                "blocks": blocks, "preview_table": answers, "_name": "Forms - " + P["title"]}

    # Documents --------------------------------------------------------------------------------------
    def _job_compare(self, P, job):
        a, b = P.get("fileA"), P.get("fileB")
        if not a or not b:
            return "Choose the second document to compare with."
        import difflib

        def read(path):
            doc = self._doc_bytes_open(path)
            rows, lines, ctx = OrderedDict(), [], {}
            try:
                for pg in doc:
                    for r in page_rows(self.fitz, pg, ctx):
                        if r["table"] and r["header"]:
                            key = (r["cells"][0] or "").strip().lower()
                            if key:
                                rows[key] = (r["header"], r["cells"])
                        else:
                            lines.append(r["text"])
            finally:
                doc.close()
            return rows, lines
        job["progress"] = "Reading the first document…"
        ra, la = read(a[2])
        job["progress"] = "Reading the second document…"
        rb, lb = read(b[2])
        blocks = []
        added = [rb[k][1] for k in rb if k not in ra]
        removed = [ra[k][1] for k in ra if k not in rb]
        changed = []
        for k in ra:
            if k in rb and [c.strip() for c in ra[k][1]] != [c.strip() for c in rb[k][1]]:
                hdr = rb[k][0]
                diffs = [f"{h}: {x} → {y}" for h, x, y in zip(hdr, ra[k][1], rb[k][1]) if x.strip() != y.strip()]
                changed.append([rb[k][1][0], "; ".join(diffs)])
        A, B = os.path.basename(a[1]), os.path.basename(b[1])
        summary = [["Rows only in " + B, len(added)], ["Rows only in " + A, len(removed)], ["Rows changed", len(changed)]]
        if P["adv"].get("rows", True):
            hdr = next(iter(rb.values()))[0] if rb else (next(iter(ra.values()))[0] if ra else ["Row"])
            if added:
                blocks += [("h", f"New in {B}  ·  {len(added)}"), ("table", {"name": "New", "headers": hdr, "rows": added})]
            if removed:
                blocks += [("h", f"Not in {B} any more  ·  {len(removed)}"),
                           ("table", {"name": "Gone", "headers": hdr, "rows": removed})]
            if changed:
                blocks += [("h", f"Changed  ·  {len(changed)}"),
                           ("table", {"name": "Changed", "headers": ["Row", "What changed"], "rows": changed,
                                      "widths": [24, 76]})]
        if P["adv"].get("text", True):
            diff = [l for l in difflib.ndiff(la, lb) if l[:2] in ("+ ", "- ")]
            tl = [["Added" if l[0] == "+" else "Removed", l[2:]] for l in diff][:800]
            summary.append(["Text lines added / removed", len(tl)])
            if tl:
                blocks += [("h", "Text that changed"), ("table", {"name": "Text", "headers": ["", "Line"], "rows": tl,
                                                                 "widths": [10, 90]})]
        blocks.insert(0, ("table", {"name": "Summary", "headers": ["", "How many"], "rows": summary}))
        return {"title": f"Compare: {A}  ↔  {B}", "subtitle": self._subtitle("file"), "blocks": blocks,
                "_name": f"Compare - {A[:20]} - {B[:20]}"}

    def _rep_status(self, st, scope, title):
        rows = []
        for folder, rel, path in self._scope_files(scope):
            tag = self._status(path)
            rows.append([tag or "-", self.lib.label(folder), rel])
        rows.sort(key=lambda r: (r[0] == "-", r[0], r[1], natural_key(r[2])))
        if not rows:
            messagebox.showinfo(APP_NAME, "No files here.")
            return None
        return {"title": "Status of files", "subtitle": self._subtitle(scope, f"{len(rows)} files"),
                "blocks": [("table", {"name": "Status", "headers": ["Status", "Book", "File"], "rows": rows,
                                      "widths": [14, 24, 62]})]}

    def _ask_report_path(self, rep, fmt, parent):
        default_dir = os.path.join(os.path.expanduser("~"), "Documents")
        return filedialog.asksaveasfilename(parent=parent, title="Save report", defaultextension="." + fmt,
                                            initialdir=default_dir if os.path.isdir(default_dir) else None,
                                            initialfile=f"{clean_name(rep.get('_name', 'Report'))}.{fmt}",
                                            filetypes=[({"pdf": "PDF", "docx": "Word", "xlsx": "Excel"}[fmt],
                                                        "*." + fmt)])

    # ---- preview: look at the result, jump to a row's page, copy, then save --------------------
    def _rep_dated(self, rep):
        """4.2: a report carries the date it was made only when Settings says so (off by default) - in its
        subtitle, the Charts 'read …' line and the saved PDF. Dates FROM the documents are never touched."""
        if not isinstance(rep, dict):
            return rep
        on = bool(self.lib.settings.get("rep_date"))
        rep["_date"] = on
        if not on:
            rep["subtitle"] = re.sub(r"\s·\s\d{1,2} [A-Z][a-z]+ \d{4}(?=\s·|$)", "", rep.get("subtitle") or "")
            for i, b_ in enumerate(rep.get("blocks") or []):
                if b_[0] == "p" and isinstance(b_[1], str) and "read " in b_[1]:
                    rep["blocks"][i] = ("p", re.sub(r"\s+·\s+read \d{1,2} [A-Z][a-z]+ \d{4}", "", b_[1]))
        return rep

    def preview_report(self, rep, fmt="xlsx"):
        """Look at the result first: filter, sort, hide columns, double-click a row to open its page,
        copy - then save as Excel, Word or PDF."""
        rep = self._rep_dated(rep)
        T = self.T
        tables = [b[1] for b in rep["blocks"] if b[0] == "table" and b[1].get("rows")]
        if rep.get("preview_table") and not any(t is rep["preview_table"] for t in tables):
            tables.insert(0, rep["preview_table"])
        order = sorted(range(len(tables)), key=lambda i: tables[i].get("name") in ("Found", "Summary", "Totals",
                                                                                 "Overview"))
        tables = [tables[i] for i in order]
        hidden = set()                      # column names hidden by the user (also left out when saving)
        w = tk.Toplevel(self.root)
        w.title("Report preview")
        w.configure(bg=T["panel"])
        w.transient(self.root)
        sw, sh = self.root.winfo_screenwidth(), self.root.winfo_screenheight()
        w.geometry(f"{max(720, min(1150, sw - 120))}x{max(420, min(660, sh - 140))}")
        foot = tk.Frame(w, bg=T["panel"])
        foot.pack(side="bottom", fill="x", padx=20, pady=12)          # buttons always visible
        head = tk.Frame(w, bg=T["panel"])
        head.pack(fill="x", padx=20, pady=(16, 4))
        tk.Label(head, text=rep["title"], font=self.F(14, "bold"), bg=T["panel"], fg=T["text"]).pack(anchor="w")
        tk.Label(head, text=rep.get("subtitle", ""), font=self.F(9), bg=T["panel"], fg=T["muted"]).pack(anchor="w")
        bar = tk.Frame(w, bg=T["panel"])
        bar.pack(fill="x", padx=20, pady=(8, 6))
        cur = {"i": 0}
        extras = [b for b in rep["blocks"] if b[0] in ("kpis", "alert", "chart")]
        pics = [b for b in rep["blocks"] if b[0] in ("h", "h3", "img")] \
            if any(b[0] == "img" for b in rep["blocks"]) else []
        modes = ([("overview", "Overview")] if extras else []) + \
            ([("pictures", "Rows as they look")] if pics else []) + [("table", "Table")]
        first = rep.get("_view") if rep.get("_view") in dict(modes) else modes[0][0]
        view = {"mode": first, "drawn": None}
        vbtns = {}

        def set_view(mode):
            view["mode"] = mode
            for k, lb in vbtns.items():
                on = k == mode
                lb.configure(bg=mix(T["panel"], self.accent, 0.2) if on else T["chip"],
                             fg=self.accent if on else T["text"])
            if mode in ("overview", "pictures"):
                body.pack_forget()
                ov_wrap.pack(fill="both", expand=True, padx=20)
                if view["drawn"] != mode:
                    ov_cv.yview_moveto(0)
                    draw_overview()
            else:
                ov_wrap.pack_forget()
                body.pack(fill="both", expand=True, padx=20)
        if len(modes) > 1:
            for k, lab in modes:
                lb = tk.Label(bar, text=lab, font=self.F(9, "bold"), padx=12, pady=4, cursor="hand2")
                lb.pack(side="left", padx=(0, 4))
                lb.bind("<Button-1>", lambda e, k=k: set_view(k))
                vbtns[k] = lb
            tk.Frame(bar, width=14, bg=T["panel"]).pack(side="left")
        if len(tables) > 1:
            names = [f'{t.get("name") or "Table"}  ({len(t["rows"])})' for t in tables]
            tk.Label(bar, text="TABLE", font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(side="left",
                                                                                                 padx=(0, 8))
            cb = ttk.Combobox(bar, values=names, state="readonly", width=34, font=self.F(10))
            cb.current(0)
            cb.pack(side="left")
            cb.bind("<<ComboboxSelected>>", lambda e: (cur.update(i=cb.current()), fill()))
        colbtn = tk.Label(bar, text="Columns…", font=self.F(9), bg=T["panel"], fg=self.accent, cursor="hand2")
        colbtn.pack(side="left", padx=(14, 0))
        filt = tk.StringVar()
        fe = ttk.Entry(bar, textvariable=filt, width=24, font=self.F(10))
        fe.pack(side="right")
        tk.Label(bar, text="FILTER", font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(side="right",
                                                                                               padx=(0, 8))
        body = tk.Frame(w, bg=T["panel"])
        body.pack(fill="both", expand=True, padx=20)
        ov_wrap = tk.Frame(w, bg=T["panel"])
        ov_cv = tk.Canvas(ov_wrap, bg=mix(T["panel"], "#FFFFFF", 0.55), highlightthickness=0, yscrollincrement=30)
        ov_vs = ttk.Scrollbar(ov_wrap, orient="vertical", command=ov_cv.yview, style="Bold.Vertical.TScrollbar")
        ov_cv.configure(yscrollcommand=ov_vs.set)
        ov_vs.pack(side="right", fill="y")
        ov_cv.pack(side="left", fill="both", expand=True)
        ov_imgs = []

        def ov_wheel(e):
            if view["mode"] not in ("overview", "pictures"):
                return
            d_ = getattr(e, "delta", 0)
            step = (-3 if e.num == 4 else 3) if getattr(e, "num", 0) in (4, 5) else \
                (-int(d_ / 40) if abs(d_) >= 40 else (-1 if d_ > 0 else 1))
            ov_cv.yview_scroll(step, "units")
        self.wheel_route(w, ov_wheel)

        def drill(link, label):
            """Click a bar / slice / cell: show the rows behind it."""
            set_view("table")
            name = (link or {}).get("table")
            if name and len(tables) > 1:
                for k, tb_ in enumerate(tables):
                    if tb_.get("name") == name:
                        cur["i"] = k
                        try:
                            cb.current(k)
                        except Exception:
                            pass
                        break
            filt.set(label.rstrip("…"))

        def open_loc(loc):
            try:
                f, rel, page = loc

                def there():
                    for fi in (self.book.files if self.book else []):
                        if fi["rel"] == rel and fi["count"]:
                            self.goto_page(fi["first"] + max(0, min(int(page), fi["count"]) - 1))
                            self.root.lift()
                            return
                if f != self.folder or self.book is None:
                    self.open_folder(f, then=there)
                else:
                    there()
            except Exception:
                pass

        def draw_pictures(W):
            y, x0, n = 14, 14, 0
            fw = W - 2 * x0 - 10
            for kind, data in pics:
                if kind == "h":
                    y += 8
                    ov_cv.create_text(x0, y, text=data, anchor="nw", font=self.F(12, "bold"), fill=self.accent,
                                      width=fw)
                    y += 30
                elif kind == "h3":
                    ov_cv.create_text(x0, y, text=data, anchor="nw", font=self.F(10, "bold"), fill="#1F2328",
                                      width=fw)
                    y += 22
                elif kind == "img":
                    n += 1
                    if n > 250:
                        continue
                    if data.get("caption"):
                        ov_cv.create_text(x0, y, text=data["caption"], anchor="nw", font=self.F(8), fill="#6B6B73",
                                          width=fw)
                        y += 16
                    try:
                        pix = self.fitz.Pixmap(data["png"])
                        natural = data.get("w", pix.width / 2) * 1.35          # about the size on screen
                        tw = int(min(fw, natural))
                        th = max(1, int(pix.height * tw / max(1, pix.width)))
                        if tw != pix.width:
                            pix = self.fitz.Pixmap(pix, tw, th)
                        img = tk.PhotoImage(data=pix.tobytes("png"))
                        ov_imgs.append(img)
                        tag = f"pic{n}"
                        ov_cv.create_rectangle(x0 - 1, y - 1, x0 + tw + 1, y + th + 1, outline="#D9D9DE",
                                               fill="#FFFFFF", tags=(tag,))
                        ov_cv.create_image(x0, y, image=img, anchor="nw", tags=(tag, "hot"))
                        if data.get("loc"):
                            ov_cv.tag_bind(tag, "<Double-1>", lambda e, loc=data["loc"]: open_loc(loc))
                        y += th + 14
                    except Exception as ex:
                        ov_cv.create_text(x0, y, text=f"(picture: {ex})", anchor="nw", fill="#898781")
                        y += 20
            if n > 250:
                ov_cv.create_text(x0, y, text=f"…and {n - 250} more rows - all of them are in the saved report.",
                                  anchor="nw", font=self.F(9), fill="#6B6B73")
                y += 24
            ov_cv.create_text(x0, y + 4, text="Double-click a row to open its page.", anchor="nw", font=self.F(8),
                              fill="#898781")
            return y

        def draw_overview(_e=None):
            ov_cv.delete("all")
            ov_imgs.clear()
            W = max(500, ov_cv.winfo_width())
            view["drawn"] = view["mode"]
            if view["mode"] == "pictures":
                y = draw_pictures(W)
                ov_cv.configure(scrollregion=(0, 0, W, y + 30))
                return
            y = 14
            x0 = 14
            for kind, data in extras:
                if kind == "kpis":
                    per = min(len(data), max(2, int((W - 28) / 170)))
                    cw = (W - 28 - 10 * (per - 1)) / max(1, per)
                    for k, kp in enumerate(data):
                        if k and k % per == 0:
                            y += 78
                        cx = x0 + (k % per) * (cw + 10)
                        tone = kp.get("tone")
                        round_rect(ov_cv, cx, y, cx + cw, y + 68, 10, fill=TONE_BG.get(tone, "#FFFFFF") if tone else
                                   "#FFFFFF", outline="#E4E4E7")
                        if tone in TONE_COL:
                            ov_cv.create_rectangle(cx + 1, y + 12, cx + 4, y + 56, fill=TONE_COL[tone], outline="")
                        ov_cv.create_text(cx + 14, y + 26, text=str(kp.get("value", "")), anchor="w",
                                          font=self.F(17, "bold"), fill="#0B0B0B")
                        ov_cv.create_text(cx + 14, y + 52, text=kp.get("label", ""), anchor="w", font=self.F(9),
                                          fill="#52514E", width=cw - 20)
                    y += 82
                elif kind == "alert":
                    tone = data.get("tone")
                    txt = (TONE_WORD.get(tone, "") + ":  " if tone else "") + data.get("text", "")
                    tid = ov_cv.create_text(x0 + 16, y + 9, text=txt, anchor="nw", font=self.F(9), fill="#0B0B0B",
                                            width=W - 60)
