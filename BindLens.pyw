        PillButton(bf, self, "Announcement…", lambda: (d.destroy(), self._cal_pin_dialog()), kind="soft").pack(
            side="left")
        d.bind("<Escape>", lambda e: d.destroy())
        self._center(d)
        ent.focus_set()
        _ = datetime

