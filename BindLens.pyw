                e_.bind("<Return>", lambda e: create())
                e_.bind("<Down>", lambda e: (lb.focus_set(), lb.selection_clear(0, "end"), lb.selection_set(0)))
                box["entry"] = e_
                e_.focus_set()
                e_.icursor("end")
                look()
            elif kind == "kinds":
                section("What to take")
                fr_ = tk.Frame(opts, bg=BG)
                fr_.pack(fill="x")
                cols_ = ["#7B61FF", "#0A84FF", "#00B894", "#14B8A6", "#F5A000", "#FF6B35", "#E8467C", "#E5484D"]
                for k_, c_ in zip(self.XKINDS, cols_):
                    lb = tk.Label(fr_, text=k_, font=self.F(9, "bold"), padx=10, pady=4, cursor="hand2", bd=0)
                    lb.pack(side="left", padx=(0, 6))

                    def paint_k(lb=lb, k_=k_, c_=c_):
                        on = k_ in S["kinds"]
                        lb.configure(bg=c_ if on else mix(BG, c_, 0.1), fg="#FFFFFF" if on else c_)

                    def flip_k(_e, k_=k_, paint_k=paint_k):
                        S["kinds"].symmetric_difference_update({k_})
                        paint_k()
                    lb.bind("<Button-1>", flip_k)
                    paint_k()
            elif kind == "two":
                files = scope_files()
                names_ = [rel for _f, rel, _p in files]
                section("The two documents")
                fr_ = tk.Frame(opts, bg=BG)
                fr_.pack(fill="x")
                for k_, lab in (("a", "First"), ("b", "Second")):
                    tk.Label(fr_, text=lab, font=self.F(9, "bold"), bg=BG, fg=T["text"]).pack(side="left",
                                                                                            padx=(0, 6))
                    cb = ttk.Combobox(fr_, values=names_, state="readonly", width=34, font=self.F(9))
                    cb.pack(side="left", padx=(0, 16))
                    two[k_] = (cb, files)
                cur_ = self._scope_files("file") if self.book and self.book.total else []
                if cur_ and cur_[0][1] in names_:
                    two["a"][0].set(cur_[0][1])
                elif names_:
                    two["a"][0].set(names_[0])
                if len(names_) > 1:
                    two["b"][0].set(next(n_ for n_ in names_ if n_ != two["a"][0].get()))
            elif kind == "total":
                section("What to add up")
                fr_ = tk.Frame(opts, bg=BG)
                fr_.pack(fill="x")
                meas = ttk.Combobox(fr_, values=["Sum", "Count rows", "Average", "Highest", "Lowest"],
                                    state="readonly", width=11, font=self.F(10))
                meas.set(mem.get("pv_meas", "Sum"))
                meas.pack(side="left")
                tk.Label(fr_, text=" of ", font=self.F(10), bg=BG, fg=T["text"]).pack(side="left")
                val = tk.StringVar(value=mem.get("pv_val", ""))
                ttk.Entry(fr_, textvariable=val, width=18, font=self.F(10)).pack(side="left")
                tk.Label(fr_, text=" per ", font=self.F(10), bg=BG, fg=T["text"]).pack(side="left")
                per = ttk.Combobox(fr_, values=["Person", "Month", "Document", "Book", "Organisation / supplier",
                                                "A column…"], state="readonly", width=20, font=self.F(10))
                per.set(mem.get("pv_per", "Person"))
                per.pack(side="left")
                pcol = tk.StringVar(value=mem.get("pv_col", ""))
                pe = ttk.Entry(fr_, textvariable=pcol, width=14, font=self.F(10))

                def show_col(*_a):
                    if per.get() == "A column…":
                        pe.pack(side="left", padx=(6, 0))
                    else:
                        pe.pack_forget()
                per.bind("<<ComboboxSelected>>", show_col)
                show_col()
                tk.Label(opts, text="Leave the box empty to add up the amounts (€) - or write a column, e.g. Hours",
                         font=self.F(8), bg=BG, fg=T["muted"]).pack(anchor="w", pady=(3, 0))
                tot.update(meas=meas, val=val, per=per, pcol=pcol)
            elif kind == "charts":
                # 1.9.6: the charts gallery - cards with a little picture of each chart; click the ones you want
                sel = S.setdefault("charts", set(c_ for c_ in (mem.get("charts") or self.CHART_AUTO)
                                                 if c_ in {g_[0] for g_ in self.CHART_GALLERY}))
                hd = tk.Frame(opts, bg=BG)
                hd.pack(fill="x", pady=(10, 6))
                tk.Label(hd, text="CHOOSE YOUR CHARTS", font=self.F(8, "bold"), bg=BG, fg=T["muted"]).pack(
                    side="left")
                cnt_l = tk.Label(hd, text="", font=self.F(8, "bold"), bg=BG, fg=col)
                cnt_l.pack(side="left", padx=(10, 0))
                links = {}
                for key_, lab_ in (("none", "None"), ("all", "All"), ("auto", "Pick for me")):
                    lb_ = tk.Label(hd, text=lab_, font=self.F(9, "bold" if key_ == "auto" else "normal"), bg=BG,
                                   fg=col if key_ == "auto" else T["muted"], cursor="hand2")
                    lb_.pack(side="right", padx=(10, 0))
                    links[key_] = lb_
                wrap_ = tk.Frame(opts, bg=BG)
                wrap_.pack(fill="x")
                GW = LW - 30
                gc = tk.Canvas(wrap_, bg=BG, width=GW, height=318, highlightthickness=0, cursor="hand2",
                               yscrollincrement=12)
                gc.pack(side="left")
                ScrollRail(wrap_, self, gc, bg=BG).pack(side="left", fill="y", padx=(6, 0))
                ghint = tk.Label(opts, text="", font=self.F(9), bg=BG, fg=T["muted"], anchor="w")
                ghint.pack(fill="x", pady=(6, 0))
                NCOL, GAP = 4, 10
                CWc = (GW - GAP * (NCOL - 1)) / NCOL
                CHc = 86
                cards, gst = [], {"hov": None}
                groups_ = OrderedDict()
                for g_ in self.CHART_GALLERY:
                    groups_.setdefault(g_[1], []).append(g_)
                lib_n = len(self.lib.folders)

                def thumb(x0, y0, x1, y1, kind_, c_, on):
                    w_, h_ = x1 - x0, y1 - y0
                    soft = mix(T["panel"], c_, 0.28)
                    base = c_ if on else mix(T["panel"], c_, 0.62)
                    gray = mix(T["panel"], T["muted"], 0.45)
                    if kind_ in ("col", "hist"):
                        hs = [0.4, 0.62, 0.5, 0.85, 0.7, 0.95] if kind_ == "col" else [0.18, 0.42, 0.78, 1, 0.66,
                                                                                         0.36, 0.14]
                        n_ = len(hs)
                        bw = w_ / n_ * (0.62 if kind_ == "col" else 0.86)
                        for i, hv in enumerate(hs):
                            cx_ = x0 + w_ * (i + 0.5) / n_
                            gc.create_rectangle(cx_ - bw / 2, y1 - h_ * hv, cx_ + bw / 2, y1, fill=base, outline="",
                                                tags="card")
                        gc.create_line(x0, y1, x1, y1, fill=gray, tags="card")
                    elif kind_ in ("bar", "pareto", "ordinal"):
                        ls = {"bar": [1, 0.78, 0.56, 0.4], "pareto": [1, 0.72, 0.46, 0.3, 0.18],
                              "ordinal": [0.45, 0.7, 0.95, 0.6, 0.35]}[kind_]
                        rh = h_ / len(ls)
                        for i, lv in enumerate(ls):
                            fill_ = base if kind_ == "bar" or (kind_ == "pareto" and i < 2) else \
                                (gray if kind_ == "pareto" else mix(soft, base, i / (len(ls) - 1)))
                            gc.create_rectangle(x0, y0 + i * rh + rh * 0.18, x0 + w_ * lv, y0 + (i + 1) * rh - rh * 0.18,
                                                fill=fill_, outline="", tags="card")
                    elif kind_ == "line2":
                        pts1 = [0.75, 0.62, 0.55, 0.4, 0.3, 0.12]
                        pts2 = [0.82, 0.74, 0.6, 0.55, 0.45, 0.38, 0.3, 0.22]
                        for pts_, cc, wd in ((pts2, gray, 2), (pts1, base, 2.5)):
                            n_ = 8
                            xy = []
                            for i, pv in enumerate(pts_):
                                xy += [x0 + w_ * i / (n_ - 1), y0 + h_ * pv]
                            gc.create_line(*xy, fill=cc, width=wd, capstyle="round", joinstyle="round", tags="card")
                        ex, ey = x0 + w_ * 5 / 7, y0 + h_ * 0.12
                        gc.create_oval(ex - 3, ey - 3, ex + 3, ey + 3, fill=base, outline=T["panel"], tags="card")
                    elif kind_ in ("calendar", "heat"):
                        nc, nr = (14, 5) if kind_ == "calendar" else (6, 4)
                        cs = min(w_ / nc, h_ / nr)
                        for i in range(nc):
                            for j in range(nr):
                                lv = ((i * 7 + j * 13 + (i * j) % 5) % 9) / 8
                                fill_ = mix(T["panel"], base, 0.12 + 0.88 * lv) if lv > 0.15 else \
                                    mix(T["panel"], T["muted"], 0.14)
                                gc.create_rectangle(x0 + i * cs + 1, y0 + j * cs + 1, x0 + (i + 1) * cs - 1,
                                                    y0 + (j + 1) * cs - 1, fill=fill_, outline="", tags="card")
                    elif kind_ == "diverge":
                        mid = x0 + w_ * 0.45
                        vals_ = [-0.6, -0.3, 0.2, 0.45, 0.8]
                        rh = h_ / len(vals_)
                        for i, v in enumerate(vals_):
                            fill_ = mix(T["panel"], "#D03B3B", 0.75 if on else 0.5) if v < 0 else base
                            a_, b_ = (mid + v * w_ * 0.45, mid) if v < 0 else (mid, mid + v * w_ * 0.55)
                            gc.create_rectangle(a_, y0 + i * rh + rh * 0.18, b_, y0 + (i + 1) * rh - rh * 0.18,
                                                fill=fill_, outline="", tags="card")
                        gc.create_line(mid, y0, mid, y1, fill=gray, tags="card")
                    elif kind_ == "timeline":
                        tx_ = x0 + w_ * 0.3
                        gc.create_rectangle(x0, y0, tx_, y1, fill=mix(T["panel"], "#D55E00", 0.08), outline="",
                                            tags="card")
                        gc.create_line(tx_, y0, tx_, y1, fill=T["text"], width=1.2, tags="card")
                        for i, fx in enumerate((0.12, 0.42, 0.55, 0.78)):
                            cy_ = y0 + h_ * (i + 0.5) / 4
                            gc.create_line(x0, cy_, x1, cy_, fill=mix(T["panel"], T["muted"], 0.25), dash=(1, 2),
                                           tags="card")
                            cc_ = mix(T["panel"], "#D55E00", 0.9 if on else 0.55) if fx < 0.3 else \
                                (base if fx < 0.6 else gray)
                            gc.create_oval(x0 + w_ * fx - 3.5, cy_ - 3.5, x0 + w_ * fx + 3.5, cy_ + 3.5, fill=cc_,
                                           outline="", tags="card")
                    elif kind_ == "stack":
                        parts_ = [[0.45, 0.3, 0.25], [0.25, 0.45, 0.3], [0.6, 0.2, 0.2]]
                        rh = h_ / 3
                        for i, pr in enumerate(parts_):
                            x_ = x0
                            for k_, f_ in enumerate(pr):
                                fill_ = [base, mix(T["panel"], base, 0.45), gray][k_]
                                gc.create_rectangle(x_, y0 + i * rh + rh * 0.2, x_ + w_ * f_ - 1.5,
                                                    y0 + (i + 1) * rh - rh * 0.2, fill=fill_, outline="", tags="card")
                                x_ += w_ * f_
                    elif kind_ == "cloud":
                        boxes = [(0.05, 0.1, 0.5, 0.42, 1), (0.55, 0.05, 0.95, 0.3, 0.6), (0.6, 0.38, 0.92, 0.6, 0.45),
                                 (0.1, 0.52, 0.38, 0.72, 0.5), (0.42, 0.55, 0.62, 0.72, 0.35),
                                 (0.15, 0.8, 0.55, 0.95, 0.7), (0.66, 0.72, 0.9, 0.9, 0.3)]
                        for a_, b_, c2, d_, lv in boxes:
                            gc.create_rectangle(x0 + w_ * a_, y0 + h_ * b_, x0 + w_ * c2, y0 + h_ * d_,
                                                fill=mix(T["panel"], base, 0.25 + 0.75 * lv), outline="", tags="card")

                def draw_gallery():
                    gc.delete("all")
                    cards.clear()
                    y = 2
                    for gname, its in groups_.items():
                        gcol = self.CHART_GROUP_COL.get(gname, col)
                        gc.create_oval(2, y + 6, 10, y + 14, fill=gcol, outline="")
                        gc.create_text(16, y + 10, text=gname.upper(), anchor="w", font=self.F(8, "bold"), fill=gcol)
                        y += 22
                        for i, g_ in enumerate(its):
                            if i and i % NCOL == 0:
                                y += CHc + GAP
                            x0 = (i % NCOL) * (CWc + GAP)
                            cid = g_[0]
                            on = cid in sel
                            hov = gst["hov"] == cid
                            na = (g_[5] == "library" and lib_n < 2)
                            fill_ = mix(BG, gcol, 0.10) if hov else T["panel"]
                            round_rect(gc, x0 + 1, y + 1, x0 + CWc - 1, y + CHc - 1, 10, fill=fill_,
                                       outline=col if on else (mix(T["panel"], gcol, 0.5) if hov else T["border"]),
                                       width=2 if on else 1)
                            thumb(x0 + 14, y + 12, x0 + CWc - 30, y + 46, g_[4], gcol, on)
                            gc.create_text(x0 + 12, y + 64, text=self._fit_text(g_[2], self._sfont(9, "bold"),
                                                                                 CWc - 22),
                                           anchor="w", font=self.F(9, "bold"),
                                           fill=T["muted"] if na else T["text"])
                            gc.create_text(x0 + 12, y + 77, text=self._fit_text(
                                {"money": "needs amounts (€, $, £)", "expiry": "needs expiry dates",
                                 "status": "uses your file status", "marks": "uses your marks",
                                 "library": "needs 2 books or more"}.get(g_[5], g_[1]).replace(" (€, $, £)", ""),
                                self._sfont(7), CWc - 22),
                                           anchor="w", font=self.F(7), fill=T["muted"])
                            bx, by = x0 + CWc - 15, y + 14
                            if on:
                                gc.create_oval(bx - 8, by - 8, bx + 8, by + 8, fill=col, outline="")
                                gc.create_line(bx - 3.6, by + 0.2, bx - 1, by + 3, bx + 4, by - 3, fill="#FFFFFF",
                                               width=2, capstyle="round", joinstyle="round")
                            else:
                                gc.create_oval(bx - 7, by - 7, bx + 7, by + 7, fill="",
                                               outline=mix(T["panel"], T["muted"], 0.5), width=1.3)
                            cards.append((x0, y, x0 + CWc, y + CHc, cid))
                        y += CHc + 14
                    gc.configure(scrollregion=(0, 0, GW, y))
                    cnt_l.configure(text=f"{len(sel)} chosen" if sel else "none chosen - BindLens picks for you")
                    h_ = gst["hov"]
                    g_ = next((x for x in self.CHART_GALLERY if x[0] == h_), None)
                    ghint.configure(text=(g_[2] + " - " + g_[3]) if g_ else
                                    "Click the charts you want. Each one comes with one line that says what it shows, "
                                    "and its numbers.", fg=self.CHART_GROUP_COL.get(g_[1], T["muted"]) if g_ else
                                    T["muted"])

                def at_(e):
                    xx, yy = gc.canvasx(e.x), gc.canvasy(e.y)
                    return next((c5 for x0, y0, x1, y1, c5 in cards if x0 <= xx <= x1 and y0 <= yy <= y1), None)

                def g_motion(e):
                    h_ = at_(e)
                    if h_ != gst["hov"]:
                        gst["hov"] = h_
                        draw_gallery()

                def g_click(e):
                    c5 = at_(e)
                    if c5:
                        sel.symmetric_difference_update({c5})
                        S["chart_auto"] = False
                        mem["charts"] = sorted(sel)
                        draw_gallery()

                def set_all(what):
                    sel.clear()
                    if what == "all":
                        sel.update(g_[0] for g_ in self.CHART_GALLERY if not (g_[5] == "library" and lib_n < 2))
                    elif what == "auto":
                        sel.update(self.CHART_AUTO)
                    S["chart_auto"] = what == "auto"        # BindLens keeps the ones these documents have data for
                    mem["charts"] = sorted(sel)
                    draw_gallery()
                for key_, lb_ in links.items():
                    lb_.bind("<Button-1>", lambda e, k5=key_: set_all(k5))
                gc.bind("<Motion>", g_motion)
                gc.bind("<Leave>", lambda e: (gst.__setitem__("hov", None), draw_gallery()))
                gc.bind("<Button-1>", g_click)
                for seq_ in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
                    gc.bind(seq_, lambda e: gc.yview_scroll(-3 if (getattr(e, "delta", 0) > 0 or
                                                                   getattr(e, "num", 0) == 4) else 3, "units"))
                draw_gallery()
            # ---- the ticks: only what to include -------------------------------------------------------------
            checks = it[4]
            if checks == "pick":
                pk = k.split(":", 1)[1]
                head_ = self.PICK_KINDS.get(pk, (pk, ""))[0]
                section("Include")
                grid = tk.Frame(opts, bg=BG)
                grid.pack(fill="x")
                shown = [(s, l_) for s, l_ in self.PICK_SHOW if not (s in ("Person", "How sure") and pk == "Names")
                         and not (s == "Organisation" and pk == "Companies")]
                prev = tk.Canvas(opts, height=34, bg=BG, highlightthickness=0, width=LW)

                def draw_prev():
                    prev.delete("all")
                    cols_ = [head_] + [s for s, _l in shown if S["checks"].get(s)]
                    prev.create_text(0, 17, text="Your table:", anchor="w", font=self.F(9), fill=T["muted"])
                    x = 84
                    for i, c_ in enumerate(cols_):
                        w_ = tkfont.Font(font=self.F(9, "bold")).measure(c_) + 22
                        round_rect(prev, x, 5, x + w_, 29, 6, fill=col if i == 0 else mix(BG, col, 0.16),
                                   outline="")
                        prev.create_text(x + w_ / 2, 17, text=c_, font=self.F(9, "bold"),
                                         fill="#FFFFFF" if i == 0 else col)
                        x += w_ + 4
                    if S["checks"].get("once", True):
                        prev.create_text(x + 10, 17, text="· each one once", anchor="w", font=self.F(9),
                                         fill=T["muted"])
                for i, (s, l_) in enumerate(shown):
                    cb_ = checkbox(grid, l_, S["checks"].get(s, False),
                                   lambda v, s=s: (S["checks"].__setitem__(s, v), draw_prev()), col)
                    cb_.grid(row=i // 3, column=i % 3, sticky="w", padx=(0, 26), pady=3)
                once_ = checkbox(opts, "Each one only once (the same email in many documents = one line)",
                                 S["checks"].get("once", True),
                                 lambda v: (S["checks"].__setitem__("once", v), draw_prev()), col)
                once_.pack(anchor="w", pady=(6, 0))
                # 1.9.2: filters and scanned pages
                section("Filter  (optional)")
                ff = tk.Frame(opts, bg=BG)
                ff.pack(fill="x")
                tk.Label(ff, text="Only if it contains", font=self.F(10), bg=BG, fg=T["text"]).pack(side="left")
                fv = tk.StringVar(value=S["checks"].get("only_txt", ""))
                fe = tk.Entry(ff, textvariable=fv, font=self.F(10), relief="flat", bg=T["panel"], fg=T["text"],
                              insertbackground=T["text"], highlightthickness=1, highlightbackground=T["border"],
                              highlightcolor=col, width=26)
                fe.pack(side="left", padx=(8, 6), ipady=3)
                tk.Label(ff, text="e.g. a name, @gmail, Dublin - commas for more", font=self.F(8), bg=BG,
                         fg=T["muted"]).pack(side="left")
                fv.trace_add("write", lambda *a: S["checks"].__setitem__("only_txt", fv.get()))
                g2 = tk.Frame(opts, bg=BG)
                g2.pack(fill="x", pady=(6, 0))
                if pk != "Names":
                    checkbox(g2, "Only the ones with a person", S["checks"].get("need_person", False),
                             lambda v: S["checks"].__setitem__("need_person", v), col).pack(side="left",
                                                                                          padx=(0, 26))
                has_td = bool(self._tessdata())
                checkbox(g2, "Read scanned pages too (slower)" + ("" if has_td else " - downloads 4 MB once"),
                         S["checks"].get("ocr", has_td), lambda v: S["checks"].__setitem__("ocr", v),
                         col).pack(side="left")
                prev.pack(fill="x", pady=(10, 0))
                draw_prev()
            elif checks:
                section("Include" if kind != "docfind" else "Options")
                grid = tk.Frame(opts, bg=BG)
                grid.pack(fill="x")
                n_ = 0
                for c in checks:
                    if len(c) > 3:                                    # a choice: 3 · 5 · 10
                        rowf = tk.Frame(opts, bg=BG)
                        rowf.pack(anchor="w", pady=(8, 0))
                        tk.Label(rowf, text=c[1], font=self.F(10), bg=BG, fg=T["text"]).pack(side="left",
                                                                                           padx=(0, 10))
                        chs = {}

                        def paint_ch(c=c, chs=chs):
                            for v_, lb_ in chs.items():
                                on = S["checks"].get(c[0], c[2]) == v_
                                lb_.configure(bg=col if on else mix(BG, col, 0.12), fg="#FFFFFF" if on else col)
                        for v_ in c[3]:
                            lb_ = tk.Label(rowf, text=str(v_), font=self.F(10, "bold"), padx=12, pady=3,
                                           cursor="hand2")
                            lb_.pack(side="left", padx=(0, 4))
                            lb_.bind("<Button-1>", lambda e, c=c, v_=v_, p_=paint_ch: (
                                S["checks"].__setitem__(c[0], v_), p_()))
                            chs[v_] = lb_
                        paint_ch()
                        continue
                    cb_ = checkbox(grid, c[1], S["checks"].get(c[0], c[2]),
                                   lambda v, c=c: S["checks"].__setitem__(c[0], v), col)
                    cb_.grid(row=n_ // 2, column=n_ % 2, sticky="w", padx=(0, 30), pady=3)
                    n_ += 1
            paint_chips()
            create_btn.text = "Open" if kind == "docfind" else "Create report"
            create_btn.redraw()
            if box["entry"] is None:
                d.focus_set()                         # Ctrl+Enter makes the report

        def select(k, question=None):
            S["type"] = k
            it = items[k][0]
            S["checks"] = {}
            if it[4] == "pick":
                S["checks"] = {"once": True}
            elif it[4]:
                S["checks"] = {c[0]: c[2] for c in it[4]}
            S["checks"].update(mem_checks.get(k, {}))
            if question is not None:
                box["q"].set(question)
            draw_field(False)
            build_opts()
            prog.configure(text="")

        # ---- where to look, and Create -------------------------------------------------------------------------
        tk.Frame(d, height=1, bg=T["border"]).pack(fill="x", pady=(16, 0))
        bottom = tk.Frame(d, bg=BG)
        bottom.pack(fill="x", padx=pad, pady=14)
        tk.Label(bottom, text="Look in", font=self.F(10, "bold"), bg=BG, fg=T["text"]).pack(side="left", padx=(0, 10))
        chips = {}

        def paint_chips():
            for k_, lb in chips.items():
                on = k_ == S["scope"]
                lb.configure(bg=A if on else T["chip"], fg="#FFFFFF" if on else T["text"],
                             font=self.F(10, "bold") if on else self.F(10))

        def set_scope(key):
            S["scope"] = key
            paint_chips()
            if S["type"] and items[S["type"]][0][3] in ("two", "docfind"):
                build_opts()

        def chip(key, text):
            lb = tk.Label(bottom, text=text, font=self.F(10), padx=12, pady=5, cursor="hand2", bd=0)
            lb.pack(side="left", padx=(0, 6))
            lb.bind("<Button-1>", lambda e: set_scope(key))
            chips[key] = lb
        if self.book and self.book.total:
            chip("file", "This document")
        if self.folder is not None:
