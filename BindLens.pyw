def logo_custom(hexcol):
    """4.4: the logo on a background colour of your own ("Custom"). Only the background is yours - the pages, the
    ribbon and the gold lens stay the logo's (dark or light so they can be seen)."""
    if not re.fullmatch(r"#[0-9A-Fa-f]{6}", hexcol or ""):
        return False
    base = LOGO_COLORS["White"] if is_light(hexcol) else LOGO_COLORS["Black"]
    LOGO_COLORS["Custom"] = (hexcol.upper(),) + tuple(base[1:])
    return True


