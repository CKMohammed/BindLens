# 2.0 - the reading clock: a little window on the sky of the hour - day blue, dawn and sunset colours, night
# with stars and the moon; the sun (or the moon) crosses it during the day, over two hills.
SKY_KEYS = [(0.0, "#0B1026", "#1B2347"), (5.0, "#151B3D", "#2D3566"), (6.5, "#3C4A8C", "#F2A36B"),
            (8.0, "#5A9BE0", "#CFE7FA"), (12.0, "#3F8EE0", "#BFE2FF"), (17.0, "#5A8FD6", "#F5D0A0"),
            (18.8, "#3B3F86", "#F08A5D"), (20.5, "#1A1F4A", "#3A3A70"), (24.0, "#0B1026", "#1B2347")]


def sky_at(h):
    """(top colour, bottom colour, daylight 0..1, ('sun' | 'moon', 0..1 across the sky)) at hour h (0-24)."""
    import math
    h = h % 24
    for (h0, t0, b0), (h1, t1, b1) in zip(SKY_KEYS, SKY_KEYS[1:]):
        if h0 <= h <= h1:
            f = (h - h0) / max(0.001, h1 - h0)
            top, bot = mix(t0, t1, f), mix(b0, b1, f)
            break
    else:
        top, bot = SKY_KEYS[0][1], SKY_KEYS[0][2]
    if 6.5 <= h <= 19.5:
        f = (h - 6.5) / 13.0
        body = ("sun", f)
        day = max(0.0, min(1.0, math.sin(math.pi * f) * 1.8))
    else:
        f = ((h - 19.5) % 24) / 11.0
        body = ("moon", f)
        day = 0.0
    return top, bot, day, body


def sky_disc_png(fitz, D, h):
    """The sky of hour h in a round window D pixels wide (PNG with transparency)."""
    import math
    import random
    top, bot, day, (body, f) = sky_at(h)
    r = D / 2.0
    doc = fitz.open()
    pg = doc.new_page(width=D, height=D)
    sh = pg.new_shape()
    N = 44
    sh.draw_circle((r, r), r - 0.3)                      # (the round top and bottom)
    sh.finish(color=None, fill=hex_to_rgb01(mix(top, bot, 0.5)), closePath=True)
    sh.draw_circle((r, r * 0.55), r * 0.55)
    sh.finish(color=None, fill=hex_to_rgb01(top), closePath=True)

    def hw(y):
        return math.sqrt(max(0.0, r * r - (y - r) ** 2))
    for i in range(N):                                   # the sky, top to bottom
        y0, y1 = D * i / N, min(D, D * (i + 1) / N + 0.7)
        a, b = hw(y0), hw(y1)
        if a + b < 0.2:
            continue
        sh.draw_polyline([(r - a, y0), (r + a, y0), (r + b, y1), (r - b, y1), (r - a, y0)])
        sh.finish(color=None, fill=hex_to_rgb01(mix(top, bot, (i + 0.5) / N)), closePath=True)
    if day < 0.5:                                         # stars
        rnd = random.Random(7)
        for _ in range(26):
            x, y = rnd.uniform(0.12, 0.88) * D, rnd.uniform(0.08, 0.55) * D
            if (x - r) ** 2 + (y - r) ** 2 < (r * 0.9) ** 2:
                sh.draw_circle((x, y), rnd.uniform(0.5, 1.3))
                sh.finish(color=None, fill=(1, 1, 1), fill_opacity=(1 - day / 0.5) * rnd.uniform(0.45, 0.95))
    bx = r - r * 0.62 * math.cos(math.pi * f)
    by = r * 1.08 - r * 0.66 * math.sin(math.pi * f)
    if body == "sun":
        warm = 1 - day                                    # low sun: orange
        for rr, op in ((0.30, 0.10), (0.21, 0.16), (0.15, 0.25)):
            sh.draw_circle((bx, by), r * rr)
            sh.finish(color=None, fill=hex_to_rgb01(mix("#FFF2B8", "#FFC27A", warm)), fill_opacity=op)
        sh.draw_circle((bx, by), r * 0.10)
        sh.finish(color=None, fill=hex_to_rgb01(mix("#FFD84D", "#FF8A3D", warm)))
    else:
        sh.draw_circle((bx, by), r * 0.19)
        sh.finish(color=None, fill=(1, 1, 1), fill_opacity=0.08)
        sh.draw_circle((bx, by), r * 0.095)
        sh.finish(color=None, fill=hex_to_rgb01("#F4F1E4"))
        sh.draw_circle((bx + r * 0.045, by - r * 0.03), r * 0.085)      # the crescent
        sh.finish(color=None, fill=hex_to_rgb01(mix(top, bot, by / D)))
    # two hills (and the town lights at night)
    for k, (base, amp, ph, col) in enumerate(((0.70, 0.07, 0.6, mix(mix("#7FB069", "#22303A", 1 - day), bot, 0.18)),
                                              (0.80, 0.05, 2.4, mix(mix("#4E7F45", "#141D24", 1 - day), bot, 0.08)))):
        pts = []
        for xi in range(0, int(D) + 2, 2):
            x = min(D, xi)
            y = D * base + D * amp * math.sin(x / D * math.pi * (1.6 + k * 0.7) + ph)
            yb = r + hw_x(x, r)
            if y < yb:
                pts.append((x, y))
        if len(pts) > 2:
            back = [(x, r + hw_x(x, r)) for x, _y in reversed(pts)]
            sh.draw_polyline(pts + back + [pts[0]])
            sh.finish(color=None, fill=hex_to_rgb01(col), closePath=True)
    if day < 0.4:
        rnd = random.Random(3)
        for _ in range(9):
            x = rnd.uniform(0.25, 0.75) * D
            y = D * 0.86 + rnd.uniform(-0.03, 0.04) * D
            sh.draw_circle((x, y), 0.9)
            sh.finish(color=None, fill=hex_to_rgb01("#FFD27A"), fill_opacity=0.85)
    sh.draw_circle((r, r), r - 0.8)                          # a soft rim
    sh.finish(color=(1, 1, 1), width=1.4, stroke_opacity=0.28, closePath=True)
    sh.commit()
    png = pg.get_pixmap(alpha=True).tobytes("png")
    doc.close()
    return png


def hw_x(x, r):
    import math
    return math.sqrt(max(0.0, r * r - (x - r) ** 2))


