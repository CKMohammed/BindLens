        def preview(_e=None):
            s_ = collect()
            try:
                Wp, Hp = page_size(self.fitz, s_, ref)
                out = render_page_doc(self.fitz, s_, Wp, Hp, self.images_dir)
            except Exception as ex:
                messagebox.showerror(APP_NAME, f"Could not make the preview:\n{ex}", parent=w)
                return
            pvw = tk.Toplevel(w)
            pvw.title(f"Preview · {out.page_count} page{'s' if out.page_count != 1 else ''}")
            pvw.configure(bg=mix(T["canvas"], "#000000", 0.06))
            pvw.transient(w)
            ph_ = min(sh - 160, 900)
            pvw.geometry(f"700x{ph_}")
            cvp = tk.Canvas(pvw, bg=mix(T["canvas"], "#000000", 0.06), highlightthickness=0)
            sbp = ttk.Scrollbar(pvw, orient="vertical", command=cvp.yview, style="Bold.Vertical.TScrollbar")
            cvp.configure(yscrollcommand=sbp.set)
            sbp.pack(side="right", fill="y")
            cvp.pack(fill="both", expand=True)
            imgs, y = [], 16
            for i in range(out.page_count):
                pg = out[i]
                z = 640 / pg.rect.width
                pix = pg.get_pixmap(matrix=self.fitz.Matrix(z, z), alpha=False)
                im = tk.PhotoImage(data=pix.tobytes("ppm"))
                imgs.append(im)
                cvp.create_rectangle(22, y + 3, 22 + pix.width + 3, y + pix.height + 4, fill="#C9CCD3", outline="")
                cvp.create_image(20, y, image=im, anchor="nw")
                y += pix.height + 18
            cvp.imgs = imgs
            cvp.configure(scrollregion=(0, 0, 680, y))
            self.wheel_route(pvw, lambda e: cvp.yview_scroll(
                (-3 if e.num == 4 else 3) if getattr(e, "num", 0) in (4, 5) else (-1 if e.delta > 0 else 1), "units"))
            pvw.bind("<Escape>", lambda e: pvw.destroy())
            out.close()
        quick = tk.Frame(head, bg=T["panel"])
        quick.pack(side="right")
        lb = tk.Label(quick, text="Preview", font=self.F(9, "bold"), bg=T["panel"], fg=ACC, padx=10, pady=4,
                      cursor="hand2")
        lb.pack(side="right")
        lb.bind("<Button-1>", lambda e: preview())
        lb.bind("<Enter>", lambda e, lb=lb: tips.schedule(lb, "See the page exactly as it will be  (Ctrl+P)"))
        lb.bind("<Leave>", lambda e: tips.cancel())
        for ic_, fn, tip_ in (("redo", redo, "Redo  Ctrl+Y"), ("undo", undo, "Undo  Ctrl+Z")):
            cq = tk.Canvas(quick, width=30, height=26, bg=T["panel"], highlightthickness=0, cursor="hand2")
            cq.pack(side="right")
            draw_icon(cq, ic_, 15, 13, ACC, s=0.85)
            cq.bind("<Button-1>", lambda e, fn=fn: fn())
            cq.bind("<Enter>", lambda e, cq=cq, t_=tip_: tips.schedule(cq, t_))
