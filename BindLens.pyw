           "jun": 6, "june": 6, "jul": 7, "july": 7, "aug": 8, "august": 8, "sep": 9, "sept": 9, "september": 9,
           "oct": 10, "october": 10, "nov": 11, "november": 11, "dec": 12, "december": 12,
           "enero": 1, "febrero": 2, "marzo": 3, "abril": 4, "mayo": 5, "junio": 6, "julio": 7, "agosto": 8,
           "septiembre": 9, "setiembre": 9, "octubre": 10, "noviembre": 11, "diciembre": 12}
_MON_RE = "|".join(sorted(_MONTHS, key=len, reverse=True))
EXTRACT_PATTERNS = OrderedDict([
    ("Emails", re.compile(r"[\w.+-]+@[\w-]+(?:\.[\w-]+)+")),
    ("Links", re.compile(r"(?:https?://\s?|www\.)[^\s<>\"')\]]+", re.I)),
    ("Dates", re.compile(r"\b(?:\d{1,2}[/.-]\d{1,2}[/.-](?:\d{4}|\d{2})|\d{4}-\d{2}-\d{2}|"
                         r"\d{1,2}(?:st|nd|rd|th)?(?:\s+de)?\s+(?:" + _MON_RE + r")\.?(?:,?\s+(?:de\s+)?\d{4})?|"
                         r"(?:" + _MON_RE + r")\.?\s+\d{1,2}(?:st|nd|rd|th)?,?\s+\d{4})\b", re.I)),
    ("Amounts", re.compile(r"(?:[€$£][ \t]?\d[\d.,]*\d|\d[\d.,]*\d?[ \t]?(?:€|EUR|USD|GBP|euros?)(?!\w))", re.I)),
    ("Phone numbers", re.compile(r"(?<![\w/.,-])(?:\+\d{1,3}[ .-]?)?\(?\d{2,4}\)?(?:[ .-]?\d{2,4}){2,4}(?![\w/,-])")),
    ("Addresses", re.compile(
        r"\b\d{1,4}[A-Za-z]?,?\s+(?:[A-Z][\w'.-]*\s+){0,4}(?:Street|St\.?|Road|Rd\.?|Avenue|Ave\.?|Lane|Ln\.?|"
        r"Drive|Dr\.?|Park|Square|Sq\.?|Court|Ct\.?|Place|Pl\.?|Terrace|Close|Way|Crescent|Grove|Gardens|Row|Quay|"
        r"Hill|View|Green|Walk|Rise|Heights|Mews)\b[^\n|]{0,60}"
        r"|\b(?:C/|Calle|Avda\.?|Avenida|Plaza|Pza\.?|Paseo|Camino|Carretera|Ctra\.?)\s+[^\n|,]{2,40}(?:,\s*\d{1,4})?"
        r"[^\n|]{0,40}"
        r"|\b[AC-FHKNPRTV-Y]\d{2}\s?[0-9AC-FHKNPRTV-Y]{4}\b"
        r"|\b[A-Z]{1,2}\d[A-Z\d]?\s\d[A-Z]{2}\b")),
])


# ===================================================================== report engine
# Works on any PDF: tables with lines (find_tables) AND tables without lines (words lined up in
# columns). Runs in a background thread - nothing here touches the window.

EXTRACT_PATTERNS["Times"] = re.compile(
    r"\b(?:[01]?\d|2[0-3])[:.][0-5]\d(?:\s?(?:am|pm|h))?(?:\s?[-–]\s?(?:[01]?\d|2[0-3])[:.][0-5]\d"
    r"(?:\s?(?:am|pm|h))?)?\b|\b\d{1,2}\s?(?:am|pm)\b", re.I)
EXTRACT_PATTERNS["Eircodes / postcodes"] = re.compile(
    r"\b[AC-FHKNPRTV-Y]\d{2}\s?[0-9AC-FHKNPRTV-Y]{4}\b|\b[A-Z]{1,2}\d[A-Z\d]?\s\d[A-Z]{2}\b")

NAME_HDR = re.compile(r"\b(name|full name|parent|guardian|contact|staff|child|student|pupil|employee|person|"
                      r"member|client|customer|teacher|educator|worker|nombre|alumno)\b", re.I)
ORG_HDR = re.compile(r"\b(organi[sz]ation|company|school|institution|centre|center|service|employer|setting|"
                     r"agency|business|provider|creche|preschool|club|department|empresa|centro)\b", re.I)
SUM_HDR = re.compile(r"\b(hours?|hrs|fees?|amount|total|cost|price|paid|due|balance|qty|quantity|rate|"
                     r"salary|wages?|charge|euros?|importe|horas?|precio|overtime|pay)\b|€|\$|£", re.I)
# 3.0: names with any European letters (Seán, Łucja, Zoë) and the Irish particles as words of their own
# (Seán Ó Briain, Niamh Ní Bhriain, Pádraig Mac Giolla Phádraig)
_UP = "A-ZÀ-ÖØ-ÞĀ-Ž"
_LO = "a-zß-öø-ÿĀ-ž"
_NW = (r"(?:Mc[A-Z][a-z]+|Mac[A-Z][a-z]+|O['’][" + _UP + "][" + _LO + "]+|[" + _UP + "][" + _LO + r"'’-]+)")
_PART = r"(?:Ó|Ní|Nic|Uí|Ua|Mac|Mc)(?=[ \t]+[" + _UP + "])"
NAME_RE = re.compile(r"^(?:(?:Mr|Mrs|Ms|Miss|Dr)\.?[ \t]+)?" + _NW + r"(?:[ \t]+(?:" + _PART + "|" + _NW +
                     r"|[" + _UP + r"]\.?|de|del|la|van|von)){1,4}$")
NAME_IN_TEXT = re.compile(r"(?:(?:Mr|Mrs|Ms|Miss|Dr)\.?[ \t]+)?" + _NW + r"(?:[ \t]+(?:" + _PART + "|" + _NW +
                          r"|[" + _UP + r"]\.?(?=[ \t]))){1,3}")


def _clean_cell(c):
    return " ".join(unicodedata.normalize("NFKC", c or "").split())


def page_rows(fitz, page, ctx=None, use_lines=False, words_in=None):
    """Every row of a page: [{"cells", "header" (or None), "text", "table", "y"}].
    Columns are found from the empty strips between words, so tables with or without lines work
    (and fast). use_lines=True also asks PyMuPDF's table finder (slower).
    ctx carries the last table header to the next page (tables that go on over several pages)."""
    ctx = ctx if ctx is not None else {}
    rows, boxes = [], []
    tables = []
    if use_lines:
        try:
            try:
                # 4.0: ruled tables by their lines only (the 'text' way splits phone numbers in two), and never
                # the optional layout model (it finds nothing when it is unsure)
                tabs = page.find_tables(strategy="lines", use_layout=False)
            except TypeError:
                tabs = page.find_tables(strategy="lines")
            tables = tabs.tables if hasattr(tabs, "tables") else list(tabs)
        except Exception:
            tables = []
    for tb in tables:
        try:
            data = tb.extract()
        except Exception:
            continue
        data = [[_clean_cell(c) for c in r] for r in data if r and any(r)]
        if not data:
            continue
        try:
            hdr = [_clean_cell(c) for c in tb.header.names]
            external = bool(tb.header.external)
        except Exception:
            hdr, external = data[0], False
        body = data if external else data[1:]
        looks_header = hdr and not any(re.search(r"\d", h or "") for h in hdr) and any(hdr)
        if not looks_header:
            prev = ctx.get("header")
            if prev and len(prev) == len(data[0]):
                hdr, body = prev, data
            else:
                hdr, body = [f"Column {j + 1}" for j in range(len(data[0]))], data
        hdr = [h or f"Column {j + 1}" for j, h in enumerate(hdr)]
        ctx["header"] = hdr
        y0 = tb.bbox[1]
        for k, r in enumerate(body):
            rows.append({"cells": r, "header": hdr, "text": " | ".join(c for c in r if c), "table": True,
                         "y": y0 + k})
        boxes.append(fitz.Rect(tb.bbox))
    # words outside the line-tables -> visual lines (works for tables without lines too)
    words = []
    try:
        for x0, y0, x1, y1, w, *_ in (words_in if words_in is not None else page.get_text("words", sort=True)):
            if boxes:
                cx, cy = (x0 + x1) / 2, (y0 + y1) / 2
                if any(b.x0 <= cx <= b.x1 and b.y0 <= cy <= b.y1 for b in boxes):
                    continue
            words.append((x0, y0, x1, y1, unicodedata.normalize("NFKC", w)))
    except Exception:
        pass
    words.sort(key=lambda w: ((w[1] + w[3]) / 2, w[0]))
    lines = []
    for w in words:
        yc, h = (w[1] + w[3]) / 2, max(1.0, w[3] - w[1])
        if lines and abs(yc - lines[-1]["yc"]) < h * 0.55:
            lines[-1]["w"].append(w)
        else:
            lines.append({"yc": yc, "h": h, "w": [w]})
    for ln in lines:
        ln["w"].sort(key=lambda w: w[0])
        gaps = [b[0] - a[2] for a, b in zip(ln["w"], ln["w"][1:])]
        ln["split"] = sum(1 for g in gaps if g > max(3.6, ln["h"] * 0.4))   # cell breaks in this line

    def columns(group):
        """Column boundaries from the empty vertical strips shared by the lines of a group."""
        x0 = min(w[0] for ln in group for w in ln["w"])
        x1 = max(w[2] for ln in group for w in ln["w"])
        n = int(x1 - x0) + 2
        cov = [0] * n
        group = [ln for ln in group if ln["split"] >= 1] or group
        for ln in group:
            for w in ln["w"]:
                for k in range(int(w[0] - x0), min(n, int(w[2] - x0) + 1)):
                    cov[k] += 1
        limit = max(0, int(len(group) * 0.08))
        cuts, k = [], 0
        while k < n:
            if cov[k] <= limit:
                s0 = k
                while k < n and cov[k] <= limit:
                    k += 1
                if k - s0 >= 4 and s0 > 0 and k < n:
                    cuts.append(x0 + (s0 + k) / 2)
            k += 1
        return cuts

    def lbox(ln):
        return (min(w[0] for w in ln["w"]), min(w[1] for w in ln["w"]), max(w[2] for w in ln["w"]),
                max(w[3] for w in ln["w"]))

    def split(ln, cuts):
        slots = [""] * (len(cuts) + 1)
        for w in ln["w"]:
            cx = (w[0] + w[2]) / 2
            k = sum(1 for c in cuts if cx > c)
            slots[k] = (slots[k] + " " + w[4]).strip()
        return slots

    i = 0
    while i < len(lines):
        ln = lines[i]
        if ln["split"] >= 1:
            j = i + 1
            left = min(w[0] for w in ln["w"])
            while j < len(lines) and lines[j]["yc"] - lines[j - 1]["yc"] < lines[j]["h"] * 3.2 and \
                    (lines[j]["split"] >= 1 or lines[j]["w"][0][0] > left + 12 or
                     (lines[j]["yc"] - lines[j - 1]["yc"] < lines[j]["h"] * 1.35 and len(lines[j]["w"]) <= 3)):
                j += 1
            group = lines[i:j]
            cuts = columns(group) if sum(1 for x in group if x["split"] >= 1) >= 3 else []
            reuse = False
            if not cuts and ctx.get("vcuts") and ctx.get("vheader"):
                # a few rows on their own (end of a table on a new page): use the columns seen before
                pc = ctx["vcuts"]
                if all(ln2["split"] <= len(pc) for ln2 in group) and \
                        min(w[0] for ln2 in group for w in ln2["w"]) < pc[0]:
                    cuts, reuse = pc, True
            if len(cuts) >= 1:
                first = split(group[0], cuts)
                is_hdr = not any(re.search(r"\d|@", c) for c in first) and sum(1 for c in first if c) >= len(first) - 1
                prev = ctx.get("vheader")
                hbox, hpage = None, None
                if is_hdr and not reuse:
                    hdr, body = first, group[1:]
                    ctx["vheader"] = hdr
                    ctx["vcuts"] = cuts
                    hbox, hpage = lbox(group[0]), page.number
                    ctx["vhbox"], ctx["vhpage"] = hbox, hpage          # where the column titles are
                elif prev and len(prev) == len(cuts) + 1:
                    # the same table, further down or on a later page: its column titles are those seen before
                    hdr, body = prev, group
                    hbox, hpage = ctx.get("vhbox"), ctx.get("vhpage")
                else:
                    hdr, body = [f"Column {k + 1}" for k in range(len(cuts) + 1)], group
                hdr = [h or f"Column {k + 1}" for k, h in enumerate(hdr)]
                prev_row = None
                gx0 = min(w[0] for ln2 in group for w in ln2["w"])
                gx1 = max(w[2] for ln2 in group for w in ln2["w"])
                for ln2 in body:
                    slots = split(ln2, cuts)
                    filled = sum(1 for x in slots if x)
                    gap = ln2["yc"] - prev_row["box"][3] if prev_row is not None else 99
                    fset = {k for k, x in enumerate(slots) if x}
                    wrapped = prev_row is not None and (
                        (filled <= max(1, len(slots) // 3) and
                         (not slots[0] or (gap < ln2["h"] * 0.9 and not re.search(r"\d", slots[0])))) or
                        (gap < ln2["h"] * 0.9 and fset <= prev_row["_first"] and filled < len(prev_row["_first"])
                         and not any(re.search(r"\d", x) for x in slots)))
                    if wrapped:
                        # a cell that goes on to a second line: join it to the row above
                        for k, x in enumerate(slots):
                            if x:
                                prev_row["cells"][k] = (prev_row["cells"][k] + " " + x).strip()
                        prev_row["text"] = " | ".join(x for x in prev_row["cells"] if x)
                        b = lbox(ln2)
                        pb = prev_row["box"]
                        prev_row["box"] = (min(pb[0], b[0]), pb[1], max(pb[2], b[2]), max(pb[3], b[3]))
                        continue
                    prev_row = {"cells": slots, "header": hdr, "text": " | ".join(x for x in slots if x),
                                "table": True, "y": ln2["yc"], "box": lbox(ln2), "tbox": (gx0, gx1),
                                "hbox": hbox, "hpage": hpage, "_first": {k for k, x in enumerate(slots) if x}}
                    rows.append(prev_row)
            else:
                for ln2 in group:
                    t = " ".join(w[4] for w in ln2["w"])
                    rows.append({"cells": [t], "header": None, "text": t, "table": False, "y": ln2["yc"],
                                 "box": lbox(ln2)})
            i = j
        else:
            t = " ".join(w[4] for w in ln["w"])
            rows.append({"cells": [t], "header": None, "text": t, "table": False, "y": ln["yc"], "box": lbox(ln)})
            i += 1
    extra = page_annot_text(page)
    for t in extra.split("\n") if extra else []:
        if t.strip():
            rows.append({"cells": [t.strip()], "header": None, "text": t.strip(), "table": False, "y": 1e9,
                         "added": True})
    rows.sort(key=lambda r: r["y"])
    try:
        type_columns(rows)
    except Exception:
        pass
    return rows


def add_row_titles(page, rows, ctx=None):
    """Give each row the title it sits under in the document: for a table, the heading or caption just
    above it (e.g. "Attendance - September 2026"); for a line of text, the last heading above it.
    Sets row["title"] (text) and row["title_box"] (where it is, for pictures of the row)."""
    ctx = ctx if ctx is not None else {}
    try:
        d = page.get_text("dict", flags=0)
    except Exception:
        return rows
    lines = []
    for b in d.get("blocks", []):
        for ln in b.get("lines", []):
            spans = [sp for sp in ln.get("spans", []) if sp.get("text", "").strip()]
            if not spans:
                continue
            txt = " ".join(" ".join(sp["text"] for sp in spans).split())
            size = max(sp.get("size", 0) for sp in spans)
            bold = any((sp.get("flags", 0) & 16) or "bold" in sp.get("font", "").lower() or
                       "black" in sp.get("font", "").lower() for sp in spans)
            bb = ln.get("bbox") or spans[0].get("bbox")
            lines.append({"t": txt, "size": size, "bold": bold, "box": tuple(bb), "chars": len(txt)})
    if not lines:
        return rows
    # merge pieces of the same visual line (PyMuPDF can split one line in two)
    lines.sort(key=lambda l: ((l["box"][1] + l["box"][3]) / 2, l["box"][0]))
    merged = []
    for l in lines:
        if merged:
            m = merged[-1]
            yc, myc = (l["box"][1] + l["box"][3]) / 2, (m["box"][1] + m["box"][3]) / 2
            if abs(yc - myc) < max(2.0, (m["box"][3] - m["box"][1]) * 0.45) and l["box"][0] - m["box"][2] < 30:
                m["t"] = (m["t"] + " " + l["t"]).strip()
                m["box"] = (min(m["box"][0], l["box"][0]), min(m["box"][1], l["box"][1]),
                            max(m["box"][2], l["box"][2]), max(m["box"][3], l["box"][3]))
                m["size"] = max(m["size"], l["size"])
                m["bold"] = m["bold"] or l["bold"]
                m["chars"] = len(m["t"])
                continue
        merged.append(dict(l))
    lines = merged
    sizes = sorted(l["size"] for l in lines for _ in range(max(1, min(40, l["chars"]))))
    med = sizes[len(sizes) // 2] if sizes else 10
    table_y = [((r["box"][1] + r["box"][3]) / 2) for r in rows if r.get("table") and r.get("box")]
    table_y += [((r["hbox"][1] + r["hbox"][3]) / 2) for r in rows if r.get("table") and r.get("hbox")]

    def in_table(l):
        yc = (l["box"][1] + l["box"][3]) / 2
        return any(abs(yc - y) < 2.5 for y in table_y)

    def heading_like(l):
        t = l["t"]
        if not (2 <= len(t) <= 90) or in_table(l):
            return False
        if t.endswith((".", ",", ";")) and len(t) > 25:
            return False
        if re.fullmatch(r"[\d\s/.,:€$£%-]+", t):
            return False
        big = l["size"] >= med * 1.12
        caps = t.upper() == t and sum(ch.isalpha() for ch in t) >= 4
        return big or l["bold"] or caps
    heads = [l for l in lines if heading_like(l)]
    # tables: rows that share the same header box / column span belong to one table
    groups = OrderedDict()
    for r in rows:
        if r.get("table") and r.get("box"):
            key = (r.get("hbox"), r.get("tbox"))
            groups.setdefault(key, []).append(r)
    pno = getattr(page, "number", None)
    for (hbox_, tbox), rs in groups.items():
        hp = rs[0].get("hpage")
        hbox = hbox_ if (hbox_ and (hp is None or hp == pno)) else None      # column titles on this page?
        top = hbox[1] if hbox else min(r["box"][1] for r in rs)
        x0 = min(r["box"][0] for r in rs) if not tbox else tbox[0]
        x1 = max(r["box"][2] for r in rs) if not tbox else tbox[1]
        best = None
        # 1) a heading not far above the table
        for l in heads:
            gap = top - l["box"][3]
            if -1 <= gap <= 150 and l["box"][2] > x0 - 60 and l["box"][0] < x1 + 10:
                if best is None or gap < top - best["box"][3]:
                    best = l
        # 2) otherwise a short caption line right above it
        if best is None:
            for l in lines:
                gap = top - l["box"][3]
                if -1 <= gap <= 36 and not in_table(l) and len(l["t"]) <= 80 and \
                        l["box"][2] > x0 - 40 and l["box"][0] < x1 + 10:
                    if best is None or gap < top - best["box"][3]:
                        best = l
        tpage = pno
        if best is not None:
            title, tbx = best["t"], best["box"]
            ctx["vtitle"], ctx["vtitle_box"], ctx["vtitle_page"] = title, tbx, pno
        elif not hbox and ctx.get("vtitle"):
            # a table that began further up: its title (and where it is, for the pictures)
            title, tbx, tpage = ctx["vtitle"], ctx.get("vtitle_box"), ctx.get("vtitle_page")
        else:
            title, tbx = None, None
        for r in rs:
            r["title"] = title
            r["title_box"] = tbx
            r["title_page"] = tpage
    # lines of text: the last heading above them
    for r in rows:
        if r.get("table") or not r.get("box") or "title" in r:
            continue
        y = r["box"][1]
        above = [l for l in heads if l["box"][3] <= y + 1 and abs(l["box"][1] - r["box"][1]) > 1.5]
        if above:
            l = max(above, key=lambda l: l["box"][3])
            r["title"], r["title_box"] = l["t"], l["box"]
        else:
            r["title"], r["title_box"] = None, None
    return rows


TOTAL_ROW = re.compile(r"(?:grand\s+)?(?:sub-?\s?)?totals?\b|sum\b|total\s+due", re.I)


def parse_number(v):
    """'€1,250.50' -> 1250.5 · '3.500,00 EUR' -> 3500.0 · '7.5' -> 7.5 · '8:30' (hours) -> 8.5"""
    s = str(v).strip()
    m = re.fullmatch(r"(\d{1,2}):([0-5]\d)", s)
    if m:
        return int(m.group(1)) + int(m.group(2)) / 60
    # 3.0: the longer words first ('8 hours', '7.5 hrs', '100 euros' were not read as numbers)
    s = re.sub(r"(?i)(euros?|eur|usd|gbp|€|\$|£|hours?|hrs?|h)\.?", "", s).strip()
    if not re.fullmatch(r"[-+]?\d[\d.,\s]*", s):
        return None
    s = s.replace(" ", "")
    if "," in s and "." in s:
        s = s.replace(".", "").replace(",", ".") if s.rfind(",") > s.rfind(".") else s.replace(",", "")
    elif "," in s:
        s = s.replace(",", ".") if len(s.split(",")[-1]) in (1, 2) else s.replace(",", "")
    try:
        return float(s)
    except Exception:
        return None


def totals_row(headers, rows, skip=0):
    """A 'Total' row for the columns that hold hours, fees, amounts… (None if nothing to add up)."""
    out, any_sum = [""] * len(headers), False
    for j, h in enumerate(headers):
        if j < skip:
            continue
        vals = [r[j] for r in rows if j < len(r) and str(r[j]).strip()]
        if not vals:
            continue
        nums = [parse_number(v) for v in vals]
        ok = [n for n in nums if n is not None]
        money = any(re.search(r"[€$£]|EUR", str(v)) for v in vals)
        # 3.0: whole words only ('Amount paid', 'Overtime', 'Hotel cost', 'Total to pay' are added up)
        if ok and (SUM_HDR.search(h or "") or money) and len(ok) >= 0.8 * len(vals) and \
                not re.search(r"\b(?:date|phone|tel|year|no\.|number|id|code|time|start|finish|from|to)\b",
                              h or "", re.I) or (ok and re.search(r"\btotal\b|overtime|amount", h or "", re.I) and
                                                 len(ok) >= 0.8 * len(vals) and (SUM_HDR.search(h or "") or money)):
            tot = sum(ok)
            sym = next((c for c in "€$£" if any(c in str(v) for v in vals)), "")
            out[j] = (f"{sym}{tot:,.2f}" if sym else (f"{tot:g}" if abs(tot - round(tot)) > 1e-9 else str(int(round(tot)))))
            any_sum = True
    if not any_sum:
        return None
    out[skip if skip < len(out) else 0] = "Total"
    return out


NOT_NAME = re.compile(r"\b(signature|signed|sign|date|centre|center|support|address|street|road|email|e-mail|phone|"
                      r"telephone|mobile|tel|number|form|office|school|county|council|department|service|total|"
                      r"page|section|monday|tuesday|wednesday|thursday|friday|saturday|sunday|january|february|"
