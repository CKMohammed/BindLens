                self._caption_install()
            except Exception as ex:
                _log(f"own title bar: {ex}")
        root.after(20, self._pump_helper)
        root.after(60, self._start)
        root.after(400, self.apply_background)
        root.after(12000, self._attention_loop)
        root.after(3000, self._logo_tick)
        root.after(5000, self._idle_check)
        root.after(1500, self._v40_start)            # 4.0: the frame, what's new
        root.after(45000, self._watch_loop)
        self._last_motion = time.time()
        root.bind_all("<Motion>", lambda e: setattr(self, "_last_motion", time.time()), add="+")

    def _pump_helper(self):
        """Answers from the helper processes, handed out in the window's own thread."""
        n = self.pool.pump()
        busy = n or self.pool.pending() or not self.pool.ui_q.empty()
        self.root.after(12 if busy else 60, self._pump_helper)

    def _tk_error(self, exc, val, tb):
        """3.0 - something went wrong inside the window: it is written in BindLens-error.log and a small note says
        so (before, with no console, it just did nothing)."""
        import traceback
        try:
            _log("error: " + "".join(traceback.format_exception(exc, val, tb))[-3000:])
        except Exception:
            pass
        now = time.time()
        if now - getattr(self, "_tk_err_t", 0) < 15:
            return
        self._tk_err_t = now
        try:
            msg = str(val).strip().splitlines()[0][:120] if str(val).strip() else exc.__name__
            self.set_status(f"Something did not work: {msg}  (written in BindLens-error.log)")
            self._toast(f"Something did not work - {msg}", ms=6000)
        except Exception:
            pass

    # ================================================================ icon
    def _load_icons(self):
        name = self.lib.settings.get("icon") if self.lib.settings.get("icon") in LOGO_COLORS else "Black"
        v = {k: logo_icon_data(name, k) for k in (256, 96, 64, 28)}
        try:
            self._app_icons = [tk.PhotoImage(data=v[k]) for k in (256, 64, 28) if k in v]
            self._app_icon = self._app_icons[1] if len(self._app_icons) > 1 else self._app_icons[0]
            self.root.iconphoto(True, *self._app_icons)
        except Exception:
            pass
        self._icon_frames = {}
        if not getattr(self, "_icon_job", None):
            self._icon_job = self.root.after(1500, self._icon_tick)
        self._lf = {}
        try:                                     # drawn as shapes: the lens can move (and it's sharp)
            self._logo_img = self._logo_frame(0)
        except Exception:
            try:
                pix = self.fitz.Pixmap(base64.b64decode(v[96]))
                pix = self.fitz.Pixmap(pix, 36, 36, None)
                self._logo_img = tk.PhotoImage(data=pix.tobytes("png"))
            except Exception:
                self._logo_img = tk.PhotoImage(data=v[28])
        self._logo_big = tk.PhotoImage(data=v[96])
        if hasattr(self, "logo_lbl"):
            self.logo_lbl.configure(image=self._logo_img)

    ICON_FRAMES = 16

    def _icon_tick(self):
        """1.9.4: the BindLens icon in the taskbar and the window's title is alive: a golden light runs round the
        logo, slowly (one round in about 7 seconds). Personalise > 'The logo moves' off = it stands still."""
        self._icon_job = None
        try:
            alive = self.lib.settings.get("logo_moves", True)
            n = self.ICON_FRAMES
            k = (getattr(self, "_icon_k", -1) + 1) % n if alive else 4
            self._icon_k = k
            name = self.lib.settings.get("icon")
            fr = self._icon_frames.get((name, LOGO_STYLE, k))
            if fr is None:
                cols = self._logo_colors()
                fr = [tk.PhotoImage(data=logo_ring_png(sz, cols, head=k / n)) for sz in (48, 32)]
                fr.append(tk.PhotoImage(data=logo_ring_png(16, cols)))
                self._icon_frames[(name, LOGO_STYLE, k)] = fr
            if getattr(self, "_icon_shown", None) != (name, LOGO_STYLE, k):
                self._icon_shown = (name, LOGO_STYLE, k)
                self.root.iconphoto(False, *fr)
        except Exception as ex:
            _log(f"icon: {ex}")
            return
        self._icon_job = self.root.after(440 if alive else 5000, self._icon_tick)

    # ---- the logo comes alive: the lens looks around now and then, and circles while BindLens is busy -------
    def _logo_colors(self):
        return LOGO_COLORS.get(self.lib.settings.get("icon"), LOGO_COLORS["Black"])

    LOGO_PX = 66                 # 1.9.3: the logo's square is a little bigger than a book's icon (54)

    def _logo_frame(self, key, size=None, **kw):
        size = size or self.LOGO_PX
        k = (key, size, self.lib.settings.get("icon"), LOGO_STYLE)
        if k not in self._lf:
            self._lf[k] = tk.PhotoImage(data=logo_frame_png(size, self._logo_colors(), **kw))
        return self._lf[k]

    LOGO_SCAN = None

    def _logo_scan_frames(self):
        import math
        out = []
        n = 30
        for i in range(n + 1):
            t = i / n
            dx = -22 * math.sin(math.pi * t) * math.cos(math.pi * t * 0.5)
            dy = -8 * math.sin(2 * math.pi * t)
            gl = (t - 0.3) / 0.4 if 0.3 <= t <= 0.7 else None
            out.append((f"scan{i}", dict(lens=(dx, dy), glint=gl)))
        return out

    def _logo_play(self, frames, then=None, delay=40):
        if getattr(self, "_logo_job", None) or not hasattr(self, "logo_lbl"):
            return

        def step(i):
            self._logo_job = None
            if i >= len(frames):
                self.logo_lbl.configure(image=self._logo_img)
                if then:
                    then()
                return
            key, kw = frames[i]
            try:
                self.logo_lbl.configure(image=self._logo_frame(key, **kw))
            except Exception:
                self.logo_lbl.configure(image=self._logo_img)
                return
            self._logo_job = self.root.after(delay, lambda: step(i + 1))
        step(0)

    def _logo_tick(self):
        """Every second: busy -> the lens circles; every ~45 s (when you are not working) -> it looks around."""
        import math
        busy = bool(getattr(self, "_rep_job", None) or getattr(self, "_prescan_token", None) or
                    getattr(self, "search_job", None) or getattr(self, "_searching", False))
        if busy and not getattr(self, "_logo_job", None):
            frames = [(f"busy{i}", dict(lens=(9 * math.cos(i * math.pi / 8), 9 * math.sin(i * math.pi / 8))))
                      for i in range(16)]
            self._logo_play(frames, delay=55)
        elif self.lib.settings.get("logo_moves", True) and not getattr(self, "_logo_job", None):
            self._logo_next = getattr(self, "_logo_next", time.time() + 20)
            if time.time() > self._logo_next and self._anim_ok(quiet=4):
                self._logo_next = time.time() + 45
                self._logo_play(self._logo_scan_frames())
        self.root.after(1000, self._logo_tick)

    # ---- resting screen: after a while without touching anything, the logo comes alive in the middle -----
    def _idle_check(self):
        try:
            mins = float(self.lib.settings.get("idle_minutes", 2))
            last = max(getattr(self, "_last_input", 0.0), getattr(self, "_last_motion", 0.0))
            if mins > 0 and getattr(self, "_idle_win", None) is None and time.time() - last > mins * 60:
                others = [w for w in self.root.winfo_children()
                          if isinstance(w, tk.Toplevel) and w.winfo_viewable()]
                # 3.0: never over a page you are reading (reading mode or full screen)
                if not others and self.root.state() != "iconic" and self.root.grab_current() is None and \
                        self.root.focus_displayof() is not None and not getattr(self, "_ed", None) and \
                        not getattr(self, "_rep_job", None) and not getattr(self, "_reading", False) and \
                        not getattr(self, "fullscreen", False):
                    self._idle_start()
        except Exception:
            pass
        self.root.after(5000, self._idle_check)

    def _idle_start(self, force=False):
        """The resting screen: 'sky' (1.9.2 - a night sky where your books are constellations and the lens looks
        among them) or 'pieces' (the logo breaks into pieces and flies to another corner)."""
        if self.lib.settings.get("rest_style", "sky") == "pieces":
            r = self._idle_start_pieces(force)
        else:
            r = self._idle_start_sky(force)
        c = getattr(self, "_idle_win", None)
        if c is not None:
            # 3.0: the key that wakes BindLens only wakes it (it used to reach the page too: Delete removed
            # the chosen mark, Esc left reading mode, the arrows turned pages)
            try:
                self._idle_prev_focus = self.root.focus_get()
            except Exception:
                self._idle_prev_focus = None
            try:
                c.configure(takefocus=1)
                c.focus_set()
                c.bind("<KeyPress>", lambda e: (self._touch_input(), "break")[1])
            except Exception:
                pass
        return r

    @staticmethod
    def _moon_phase():
        """0 = new moon, 0.5 = full moon (good enough for a picture)."""
        import datetime
        ref = datetime.datetime(2000, 1, 6, 18, 14)
        days = (datetime.datetime.utcnow() - ref).total_seconds() / 86400.0
        return (days % 29.530588) / 29.530588

    def _idle_start_sky(self, force=False):
        import math
        import random
        if getattr(self, "_idle_win", None) is not None:
            return
        T = self.T
        c = tk.Canvas(self.root, highlightthickness=0, bd=0, bg="#0B1026")
        c.place(x=0, y=0, relwidth=1, relheight=1)
        c.tk.call("raise", c._w)
        self._idle_win = c
        self._idle_since = time.time()
        self.root.update_idletasks()
        W, H = max(400, c.winfo_width()), max(300, c.winfo_height())
        fz = self.fitz
        rnd = random.Random()
        imgs = {}
        # the sky: deep blue at the top, violet, a little dusk glow at the bottom
        stops = [(0.0, (11, 16, 38)), (0.55, (32, 26, 72)), (0.85, (62, 38, 92)), (1.0, (96, 56, 104))]
        buf = bytearray()
        for y in range(64):
            v = y / 63
            for k in range(len(stops) - 1):
                if stops[k][0] <= v <= stops[k + 1][0]:
                    t_ = (v - stops[k][0]) / (stops[k + 1][0] - stops[k][0])
                    col = [int(stops[k][1][j] + (stops[k + 1][1][j] - stops[k][1][j]) * t_) for j in range(3)]
                    break
            buf += bytes(col) * 4
        try:
            small = fz.Pixmap(fz.csRGB, 4, 64, bytes(buf), False)
            imgs["sky"] = tk.PhotoImage(data=fz.Pixmap(small, W, H, None).tobytes("ppm"))
            c.create_image(0, 0, image=imgs["sky"], anchor="nw")
        except Exception:
            pass
        def sky_at(y):
            v = max(0.0, min(1.0, y / H))
            for k in range(len(stops) - 1):
                if stops[k][0] <= v <= stops[k + 1][0]:
                    t_ = (v - stops[k][0]) / (stops[k + 1][0] - stops[k][0])
                    return "#%02X%02X%02X" % tuple(int(stops[k][1][j] + (stops[k + 1][1][j] - stops[k][1][j]) * t_)
                                                   for j in range(3))
            return "#0B1026"
        # 1.9.3: the logo is put together in the sky. Its pieces float among the stars like little files; the lens
        # looks for them one by one and each found piece flies to its place - when the logo is whole the lens takes
        # its own place, a golden light runs round it… then the pieces scatter and the search starts again.
        S = max(114, min(222, int(min(W, H) * 0.19)))
        S -= S % 3
        tpx = max(60, int(min(W, H) * 0.115))
        cx = W / 2
        ly0 = max(36, H * 0.47 - (S + 22 + tpx * 1.3) / 2)          # top of the logo; the clock below it
        lx0 = cx - S / 2
        cy = ly0 + S + 22 + tpx / 2
        clock = {"txt": None, "it": None, "colon": None}
        date_it = c.create_text(cx, cy + tpx * 0.66, text="", font=self.F(13), fill="#C9C2F2")
        c.create_text(cx, H - 26, text="Move the mouse or press a key to go back", font=self.F(9), fill="#8A84B8")
        half = max(tpx * 2.2, S * 0.85)
        keep = (cx - half, ly0 - 34, cx + half, cy + tpx * 1.0)            # no stars here
        free = lambda x, y, m=0: not (keep[0] - m < x < keep[2] + m and keep[1] - m < y < keep[3] + m)
        # stars
        stars = []
        for _ in range(int(W * H / 5200)):
            x, y = rnd.uniform(0, W), rnd.uniform(0, H * 0.92)
            if not free(x, y):
                continue
            r = rnd.choice((0.6, 0.8, 0.9, 1.1, 1.3, 1.7))
            tint = rnd.choice(("#FFFFFF", "#FFF4D6", "#DCE6FF", "#FFFFFF"))
            it = c.create_oval(x - r, y - r, x + r, y + r, fill=tint, outline="")
            stars.append({"it": it, "tint": tint, "ph": rnd.uniform(0, 6.3), "sp": rnd.uniform(0.6, 2.2),
                          "bg": sky_at(y)})
        # the moon, in its real phase
        ph = self._moon_phase()
        mr = max(16, int(min(W, H) * 0.035))
        mx, my = W - mr * 3.2, mr * 3.0
        c.create_oval(mx - mr * 2.2, my - mr * 2.2, mx + mr * 2.2, my + mr * 2.2, fill=mix(sky_at(my), "#FFF4D6", 0.06),
                      outline="")
        c.create_oval(mx - mr * 1.5, my - mr * 1.5, mx + mr * 1.5, my + mr * 1.5, fill=mix(sky_at(my), "#FFF4D6", 0.1),
                      outline="")
        c.create_oval(mx - mr, my - mr, mx + mr, my + mr, fill=mix(sky_at(my), "#FFF4D6", 0.16), outline="")
        side = 1 if ph < 0.5 else -1                   # waxing: lit on the right
        e = math.cos(2 * math.pi * ph)
        limb = []
        for k in range(31):
            th = math.radians(-90 + k * 6)
            limb += [mx + side * mr * math.cos(th), my + mr * math.sin(th)]
        for k in range(31):
            th = math.radians(90 - k * 6)
            limb += [mx + side * e * mr * math.cos(th), my + mr * math.sin(th)]
        if 0.02 < ph < 0.98:
            c.create_polygon(limb, fill="#FFF1C9", outline="", smooth=True)
        # your books: constellations
        books = list(self.lib.folders)[:14]
        cons = []
        for f in books:
            for _try in range(60):
                x, y = rnd.uniform(70, W - 70), rnd.uniform(60, H * 0.82)
                if free(x, y, 70) and all((x - k["x"]) ** 2 + (y - k["y"]) ** 2 > 170 ** 2 for k in cons) and \
                        (x - mx) ** 2 + (y - my) ** 2 > (mr * 4) ** 2:
                    break
            col = mix(self.lib.color(f), "#FFFFFF", 0.45)
            pts = [(x, y)]
            ang = rnd.uniform(0, 6.3)
            for k in range(rnd.randint(3, 5)):
                ang += rnd.uniform(0.6, 1.6)
                d = rnd.uniform(28, 62)
                px, py = pts[-1] if k % 2 == 0 else pts[0]
                pts.append((px + math.cos(ang) * d, py + math.sin(ang) * d))
            dim = mix(col, sky_at(y), 0.72)
            lines = []
            for k in range(1, len(pts)):
                a_, b_ = pts[k - 1] if k % 2 == 1 else pts[0], pts[k]
                lines.append(c.create_line(a_[0], a_[1], b_[0], b_[1], fill=dim, width=1))
            halo = c.create_oval(x - 12, y - 12, x + 12, y + 12, fill=mix(sky_at(y), col, 0.18), outline="",
                                 state="hidden")
            dots = [c.create_oval(px - 1.6, py - 1.6, px + 1.6, py + 1.6, fill=mix(col, "#FFFFFF", 0.3), outline="")
                    for px, py in pts[1:]]
            main = c.create_oval(x - 3.2, y - 3.2, x + 3.2, y + 3.2, fill=col, outline="")
            label = c.create_text(x + 10, y - 14, text=self.lib.label(f), anchor="w", font=self.F(10, "bold"),
                                  fill=sky_at(y))
            cons.append({"x": x, "y": y, "col": col, "dim": dim, "lines": lines, "dots": dots, "main": main,
                         "halo": halo, "label": label, "glow": 0.0, "bg": sky_at(y)})
        cols = self._logo_colors()
        k_ = S / 256.0
        GOLD, GLOW = "#E2BC4E", "#FFE9A8"
        # where the logo is put together: a soft light and a dotted outline
        sq0, sq1 = 18 * k_, 238 * k_
        rr = 0.24 * 220 * k_
        for i, a_ in enumerate((0.05, 0.08, 0.11)):
            m_ = 22 - i * 8
            round_rect(c, lx0 + sq0 - m_, ly0 + sq0 - m_, lx0 + sq1 + m_, ly0 + sq1 + m_, rr + m_,
                       fill=mix(sky_at(ly0 + S / 2), "#B9A8FF", a_), outline="")
        ghost = round_path(lx0 + sq0 - 3, ly0 + sq0 - 3, lx0 + sq1 + 3, ly0 + sq1 + 3, rr + 3, 3.0)
        c.create_line(*[v for p_ in ghost + ghost[:1] for v in p_], fill=mix(sky_at(ly0), GOLD, 0.32), dash=(2, 4))
        # the pieces of the logo (without the lens): 3 x 3 little "files"
        d_ = fz.open()
        pg = d_.new_page(width=S, height=S)
        draw_logo(pg, fz, 0, 0, S, cols, parts=("bg", "spine", "arc", "pages"))
        q = S // 3
        pieces = []

        def spot(avoid):
            for _try in range(80):
                x, y = rnd.uniform(70, W - 70), rnd.uniform(60, H - 90)
                if free(x, y, q) and (x - mx) ** 2 + (y - my) ** 2 > (mr * 3.5 + q) ** 2 and \
                        all((x - a[0]) ** 2 + (y - a[1]) ** 2 > (q * 2.4) ** 2 for a in avoid):
                    return x, y
            return rnd.uniform(70, W - 70), rnd.uniform(60, H * 0.3)
        taken = []
        for r_ in range(3):
            for c_ in range(3):
                pix = pg.get_pixmap(alpha=True, clip=fz.Rect(c_ * q, r_ * q, (c_ + 1) * q, (r_ + 1) * q))
                imgs[f"pc{r_}{c_}"] = tk.PhotoImage(data=pix.tobytes("png"))
                home = (lx0 + (c_ + 0.5) * q, ly0 + (r_ + 0.5) * q)
                x, y = spot(taken)
                taken.append((x, y))
                p_ = {"home": home, "x": x, "y": y, "ph": rnd.uniform(0, 6.3), "mode": "lost", "seen": 0.0,
                      "halo": c.create_oval(0, 0, 0, 0, outline="", fill=sky_at(y)),
                      "card": c.create_rectangle(0, 0, 0, 0, outline=GOLD, width=1),
                      "fold": c.create_polygon(0, 0, 0, 0, 0, 0, fill=GOLD, outline=""),
                      "img": c.create_image(x, y, image=imgs[f"pc{r_}{c_}"])}
                pieces.append(p_)
        d_.close()
        # the golden light that runs round the logo when it is whole
        ring_pts = round_path(lx0 + sq0 - 5, ly0 + sq0 - 5, lx0 + sq1 + 5, ly0 + sq1 + 5, rr + 5, 1.5)
        ring_full = c.create_line(*[v for p_ in ring_pts + ring_pts[:1] for v in p_], fill=GOLD, width=1.4,
                                  state="hidden")
        comet = [c.create_line(0, 0, 0, 0, capstyle="round", joinstyle="round", state="hidden") for _ in range(18)]
        # the lens: the same size as in the logo, so it fits in its place at the end
        for g_ in [None] + [i / 7 for i in range(8)]:
            d_ = fz.open()
            pg = d_.new_page(width=S, height=S)
            draw_logo(pg, fz, S / 2 - 153 * k_, S / 2 - 121 * k_, S, cols, parts=("lens",), glint=g_)
            imgs[f"lens{g_}"] = tk.PhotoImage(data=pg.get_pixmap(alpha=True).tobytes("png"))
            d_.close()
        dock = (lx0 + 153 * k_, ly0 + 121 * k_)
        L = {"x": W * 0.15, "y": H * 0.2, "mode": "seek", "target": None, "t0": time.time(), "from": None}
        lens = c.create_image(L["x"], L["y"], image=imgs["lensNone"])
        # a shooting star now and then
        shoot = [c.create_line(0, 0, 0, 0, fill=mix("#FFFFFF", "#0B1026", k * 0.3), width=2 - k * 0.5,
                               capstyle="round", state="hidden") for k in range(3)]
        st = {"t0": time.time(), "shoot": None, "next_shoot": time.time() + rnd.uniform(3, 7)}
        self._idle_imgs = imgs
        ease = lambda u: u * u * (3 - 2 * u)

        def curve(a, b, u, bend=0.25):
            """A point on a soft curve from a to b (u = 0…1)."""
            mxp, myp = (a[0] + b[0]) / 2, (a[1] + b[1]) / 2
            nx, ny = -(b[1] - a[1]) * bend, (b[0] - a[0]) * bend
            cxp, cyp = mxp + nx, myp + ny
            return ((1 - u) ** 2 * a[0] + 2 * (1 - u) * u * cxp + u * u * b[0],
                    (1 - u) ** 2 * a[1] + 2 * (1 - u) * u * cyp + u * u * b[1])

        def place(p_, x, y, t):
            h2 = q / 2
            if p_["mode"] == "home":
                for key in ("halo", "card", "fold"):
                    c.itemconfigure(p_[key], state="hidden")
                c.coords(p_["img"], x, y)
                return
            glow = p_["seen"]
            sky = sky_at(y)
            c.itemconfigure(p_["halo"], state="normal", fill=mix(sky, "#B9A8FF", 0.13 + 0.22 * glow))
            c.coords(p_["halo"], x - h2 - 16, y - h2 - 16, x + h2 + 16, y + h2 + 16)
            c.itemconfigure(p_["card"], state="normal", outline=mix(sky, GLOW if glow > 0.5 else GOLD,
                                                                    0.45 + 0.55 * glow), width=1 + glow * 1.5)
            c.coords(p_["card"], x - h2 - 4, y - h2 - 4, x + h2 + 4, y + h2 + 4)
            c.itemconfigure(p_["fold"], state="normal", fill=mix(sky, GOLD, 0.5 + 0.5 * glow))
            c.coords(p_["fold"], x + h2 - 6, y - h2 - 4, x + h2 + 4, y - h2 - 4, x + h2 + 4, y - h2 + 6)
            c.coords(p_["img"], x, y)

        def pos(p_, t):
            if p_["mode"] == "lost":
                return (p_["x"] + 4 * math.sin(t * 0.9 + p_["ph"]), p_["y"] + 5 * math.cos(t * 0.7 + p_["ph"]))
            if p_["mode"] in ("fly", "scatter"):
                u = min(1.0, (time.time() - p_["t0"]) / p_["dur"])
                return curve(p_["from"], p_["to"], ease(u), p_["bend"])
            return p_["home"]

        def draw_clock(now):
            txt = time.strftime("%H:%M", now)
            if txt != clock["txt"]:
                clock["txt"] = txt
                im = self._text_img(txt, tpx, "#F4F1FF", style="sans")
                imgs["clock"] = im
                if clock["it"] is None:
                    clock["it"] = c.create_image(cx, cy, image=im[0])
                else:
                    c.itemconfigure(clock["it"], image=im[0])
                c.itemconfigure(date_it, text=time.strftime("%A %d %B", now).replace(" 0", " "))

        def lens_step(now, t):
            mode = L["mode"]
            gl = None
            if mode == "seek":
                if L["target"] is None or L["target"]["mode"] != "lost":
                    left_ = [p_ for p_ in pieces if p_["mode"] == "lost"]
                    if not left_:
                        if all(p_["mode"] == "home" for p_ in pieces):
                            L.update(mode="dock", t0=now, **{"from": (L["x"], L["y"])})
                        return None
                    L["target"] = min(left_, key=lambda p_: (p_["x"] - L["x"]) ** 2 + (p_["y"] - L["y"]) ** 2)
                p_ = L["target"]
                tx, ty = pos(p_, t)
                dx, dy = tx - L["x"], ty - L["y"]
                dist = math.hypot(dx, dy)
                if dist > 70:                                   # looking around on the way
                    tx += 34 * math.sin(t * 1.6)
                    ty += 26 * math.cos(t * 1.25)
                    dx, dy = tx - L["x"], ty - L["y"]
                    dist = math.hypot(dx, dy)
                sp = min(dist, 2.0 + dist * 0.045, 9.0)
                if dist > 0.01:
                    L["x"] += dx / dist * sp
                    L["y"] += dy / dist * sp
                p_["seen"] = max(p_["seen"], max(0.0, 1 - dist / (S * 1.1)) * 0.6)
                if dist < 5:
                    L.update(mode="found", t0=now)
            elif mode == "found":
                p_ = L["target"]
                u = (now - L["t0"]) / 0.8
                p_["seen"] = 1.0
                L["x"], L["y"] = pos(p_, t)
                gl = min(1.0, u)
                if u >= 1:
                    p_.update(mode="fly", t0=now, dur=1.25, bend=rnd.choice((-0.3, 0.3)), to=p_["home"],
                              **{"from": pos(p_, t)})
                    L.update(mode="seek", target=None)
            elif mode == "dock":
                u = min(1.0, (now - L["t0"]) / 1.5)
                L["x"], L["y"] = curve(L["from"], dock, ease(u), 0.35)
                if u >= 1:
                    L.update(mode="done", t0=now)
                    c.itemconfigure(ring_full, state="normal")
                    for it in comet:
                        c.itemconfigure(it, state="normal")
            elif mode == "done":
                u = now - L["t0"]
                L["x"], L["y"] = dock
                gl = min(1.0, u / 0.9) if u < 0.9 else (min(1.0, (u - 4.5) / 0.9) if 4.5 < u < 5.4 else None)
                n = len(ring_pts)
                head = int(((u / 2.6) % 1.0) * n)
                step = max(2, int(n * 0.3 / len(comet)))
                for i, it in enumerate(comet):
                    a = head - i * step
                    seg = [ring_pts[(a - j) % n] for j in range(step + 1)]
                    c.coords(it, *[v for p_ in seg for v in p_])
                    c.itemconfigure(it, fill=mix(sky_at(ly0), GLOW if i < 5 else GOLD, max(0.2, 1 - i / len(comet))),
                                    width=max(1.4, 4 * (1 - i / len(comet))))
                fade = max(0.0, min(1.0, (8.5 - u) / 1.0))
                c.itemconfigure(ring_full, fill=mix(sky_at(ly0), GOLD, 0.25 + 0.6 * fade))
                if u > 9:                                       # the pieces scatter: it starts again
                    taken_ = []
                    for p_ in pieces:
                        to = spot(taken_)
                        taken_.append(to)
                        p_.update(mode="scatter", t0=now + rnd.uniform(0, 0.5), dur=1.6, bend=rnd.uniform(-0.4, 0.4),
                                  to=to, seen=0.0, x=to[0], y=to[1], **{"from": p_["home"]})
                    c.itemconfigure(ring_full, state="hidden")
                    for it in comet:
                        c.itemconfigure(it, state="hidden")
                    L.update(mode="leave", t0=now, to=spot(taken_), **{"from": dock})
            elif mode == "leave":
                u = min(1.0, (now - L["t0"]) / 1.8)
                L["x"], L["y"] = curve(L["from"], L["to"], ease(u), -0.3)
                if u >= 1:
                    L.update(mode="seek", target=None)
            return gl

        def frame():
            if self._idle_win is not c:
                return
            now = time.time()
            t = now - st["t0"]
            draw_clock(time.localtime(now))
            # stars twinkle
            for s_ in rnd.sample(stars, min(len(stars), 22)):
                b = 0.5 + 0.5 * math.sin(t * s_["sp"] + s_["ph"])
                c.itemconfigure(s_["it"], fill=mix(s_["bg"], s_["tint"], 0.35 + 0.65 * b))
            # the pieces
            for p_ in pieces:
                if p_["mode"] in ("fly", "scatter") and now >= p_["t0"] + p_["dur"]:
                    p_["mode"] = "home" if p_["mode"] == "fly" else "lost"
                if p_["mode"] == "lost" and L.get("target") is not p_:
                    p_["seen"] = max(0.0, p_["seen"] - 0.02)
                if p_["mode"] == "scatter" and now < p_["t0"]:
                    x, y = p_["from"]
                else:
                    x, y = pos(p_, t)
                place(p_, x, y, t)
            # the lens looks for them
            gl = lens_step(now, t)
            if gl is not None:
                gl = int(gl * 7) / 7
            c.coords(lens, L["x"], L["y"])
            c.itemconfigure(lens, image=imgs[f"lens{gl}"])
            # the books it passes shine, and say their name
            for k in cons:
                near = (k["x"] - L["x"]) ** 2 + (k["y"] - L["y"]) ** 2 < (S * 0.8) ** 2
                g0 = k["glow"]
                k["glow"] = min(1.0, g0 + 0.08) if near else max(0.0, g0 - 0.03)
                if abs(k["glow"] - g0) > 1e-3 or (k["glow"] and near):
                    gv = k["glow"]
                    c.itemconfigure(k["label"], fill=mix(k["bg"], "#FFFFFF", 0.92 * gv))
                    for ln in k["lines"]:
                        c.itemconfigure(ln, fill=mix(k["dim"], k["col"], gv), width=1 + gv)
                    c.itemconfigure(k["halo"], state="normal" if gv > 0.05 else "hidden",
                                    fill=mix(k["bg"], k["col"], 0.12 + 0.25 * gv))
            # a shooting star
            if st["shoot"] is None and now > st["next_shoot"]:
                x0, y0 = rnd.uniform(W * 0.1, W * 0.9), rnd.uniform(0, H * 0.3)
                ang = rnd.uniform(0.35, 0.75) * (1 if x0 < W / 2 else -1)
                st["shoot"] = (x0, y0, math.cos(ang) * (1 if x0 < W / 2 else -1), abs(math.sin(ang)), now)
            if st["shoot"] is not None:
                x0, y0, dx, dy, ts = st["shoot"]
                u = (now - ts) / 0.9
                if u > 1:
                    st["shoot"] = None
                    st["next_shoot"] = now + rnd.uniform(5, 11)
                    for it in shoot:
                        c.itemconfigure(it, state="hidden")
                else:
                    head = 60 + u * W * 0.35
                    for k2, it in enumerate(shoot):
                        a1, a2 = head - k2 * 40, head - (k2 + 1) * 40
                        c.coords(it, x0 + dx * a2, y0 + dy * a2, x0 + dx * a1, y0 + dy * a1)
                        c.itemconfigure(it, state="normal")
            for p_ in pieces:                                   # pieces in flight above the others
                if p_["mode"] in ("fly", "scatter"):
                    for key in ("halo", "card", "fold", "img"):
                        c.tag_raise(p_[key])
            for it in comet:
                c.tag_raise(it)
            c.tag_raise(lens)
            self._idle_job = self.root.after(40, frame)
        self._idle_state = (L, pieces)
        for seq in ("<Motion>", "<Button-1>", "<Button-3>", "<MouseWheel>"):
            c.bind(seq, lambda e: self._idle_stop() if time.time() - self._idle_since > 0.6 else None)
        frame()

    def _idle_start_pieces(self, force=False):
        """The resting screen (1.9): a calm clock in the middle, and the logo breaking into little pieces that fly
        to another corner and come together again - then the lens looks around and the light passes over it."""
        import math
        import random
        if getattr(self, "_idle_win", None) is not None:
            return
        T = self.T
        c = tk.Canvas(self.root, highlightthickness=0, bd=0, bg=mix(T["canvas"], self.accent, 0.06))
        c.place(x=0, y=0, relwidth=1, relheight=1)
        c.tk.call("raise", c._w)                      # (a canvas's own lift() moves its items)
        self._idle_win = c
        self._idle_since = time.time()
        self.root.update_idletasks()
        W, H = max(400, c.winfo_width()), max(300, c.winfo_height())
        S = max(96, int(self.root.winfo_fpixels("3c")))          # about 3 x 3 cm
        cols = self._logo_colors()
        k = S / 256.0
        fz = self.fitz
        rnd = random.Random()
        imgs = {}
        full = tk.PhotoImage(data=logo_frame_png(S, cols))
        imgs["full"] = full
        imgs["base"] = tk.PhotoImage(data=logo_frame_png(S, cols, parts=("bg", "spine", "arc", "pages")))
        for g_ in [None] + [i / 7 for i in range(8)]:            # the lens alone (with the light passing)
            d_ = fz.open()
            pg = d_.new_page(width=S, height=S)
            draw_logo(pg, fz, S / 2 - 153 * k, S / 2 - 121 * k, S, cols, parts=("lens",), glint=g_)
            imgs[f"lens{g_}"] = tk.PhotoImage(data=pg.get_pixmap(alpha=True).tobytes("png"))
            d_.close()
        # the little pieces of the logo
        N = 7
        pieces = []

        def clear(x, y):
            try:
                return bool(full.tk.call(full.name, "transparency", "get", x, y))
            except Exception:
                return False
        for r in range(N):
            for q in range(N):
                x0, y0 = int(q * S / N), int(r * S / N)
                x1, y1 = int((q + 1) * S / N), int((r + 1) * S / N)
                if clear((x0 + x1) // 2, (y0 + y1) // 2) and clear(x0 + 1, y0 + 1) and clear(x1 - 2, y1 - 2):
                    continue
                im = tk.PhotoImage(width=x1 - x0, height=y1 - y0)
                im.tk.call(im.name, "copy", full.name, "-from", x0, y0, x1, y1, "-to", 0, 0)
                pieces.append({"img": im, "ox": x0, "oy": y0, "w": x1 - x0, "h": y1 - y0,
                               "it": c.create_image(-500, -500, image=im, anchor="nw", state="hidden")})
        imgs["pieces"] = [p_["img"] for p_ in pieces]
        # the clock in the middle: big digits as pictures (sharp, the same on every computer)
        ffile = None
        for dd in _font_dirs():
            for nm in ("segoeuil.ttf", "segoeui.ttf", "arial.ttf", "DejaVuSans.ttf", "LiberationSans-Regular.ttf"):
                if os.path.isfile(os.path.join(dd, nm)):
                    ffile = os.path.join(dd, nm)
                    break
            if ffile:
                break
        fnt = fz.Font(fontfile=ffile) if ffile else fz.Font("helv")
        fpx = max(54, int(S * 0.78))
        dcol = mix(T["text"], T["canvas"], 0.12)

        def glyph(ch):
            key = ("D", ch, fpx, dcol)
            if key not in imgs:
                d_ = fz.open()
                w_ = fnt.text_length(ch, fontsize=fpx)
                pg_ = d_.new_page(width=w_ + 4, height=fpx * 1.2 + 4)
                tw_ = fz.TextWriter(pg_.rect)
                tw_.append((2, 2 + fpx * 0.95), ch, font=fnt, fontsize=fpx)
                tw_.write_text(pg_, color=_rgb(dcol))
                imgs[key] = (tk.PhotoImage(data=pg_.get_pixmap(alpha=True).tobytes("png")), w_ + 4)
                d_.close()
            return imgs[key]
        for ch in "0123456789:":
            glyph(ch)
        clock = {"items": [], "txt": None, "colon": None}
        cy_clock = H / 2 - fpx * 0.25
        date_it = c.create_text(W / 2, cy_clock + fpx * 0.72, text="", font=self.F(13), fill=T["muted"])
        c.create_text(W / 2, cy_clock + fpx * 0.72 + 30, text="BindLens", font=self.F(10, "bold"),
                      fill=mix(self.accent, T["canvas"], 0.25))
        c.create_text(W / 2, H - 30, text="Move the mouse or press a key to go back", font=self.F(9),
                      fill=T["muted"])

        def draw_clock(now):
            txt = time.strftime("%H:%M", now)
            if txt != clock["txt"]:
                clock["txt"] = txt
                for it in clock["items"]:
                    c.delete(it)
                clock["items"] = []
                total = sum(glyph(ch)[1] for ch in txt)
                x = W / 2 - total / 2
                for ch in txt:
                    im, w_ = glyph(ch)
                    it = c.create_image(x, cy_clock, image=im, anchor="w")
                    clock["items"].append(it)
                    if ch == ":":
                        clock["colon"] = it
                    x += w_
                c.itemconfigure(date_it, text=time.strftime("%A %d %B", now).replace(" 0", " "))
            if clock["colon"]:
                c.itemconfigure(clock["colon"], state="normal" if now.tm_sec % 2 == 0 else "hidden")
        # where the logo rests: the corners (and the middle of the top and bottom)
        m = max(28, int(min(W, H) * 0.06))
        spots = [(m, m), (W - m - S, m), (W - m - S, H - m - S - 34), (m, H - m - S - 34), (W / 2 - S / 2, m)]
        spots = [(x, y) for x, y in spots if not (abs(x + S / 2 - W / 2) < S and abs(y + S / 2 - cy_clock) < S)]
        st = {"a": rnd.randrange(len(spots)), "b": None, "t0": time.time(), "plan": None}
        base = c.create_image(*spots[st["a"]], image=imgs["base"], anchor="nw")
        lens = c.create_image(0, 0, image=imgs["lensNone"])
        ring = c.create_oval(-10, -10, -9, -9, outline=self.accent, width=2, state="hidden")
        sparks = [c.create_oval(-10, -10, -9, -9, fill=self.accent, outline="", state="hidden") for _ in range(40)]
        spark_st = [None] * len(sparks)
        spark_cols = [cols[2], cols[3], self.accent, mix(self.accent, "#FFFFFF", 0.4)]
        HOLD, FLY = 3.6, 2.7

        def bez(p0, p1, p2, p3, u):
            v = 1 - u
            return (v * v * v * p0[0] + 3 * v * v * u * p1[0] + 3 * v * u * u * p2[0] + u * u * u * p3[0],
                    v * v * v * p0[1] + 3 * v * v * u * p1[1] + 3 * v * u * u * p2[1] + u * u * u * p3[1])

        def plan(a, b):
            (ax, ay), (bx, by) = spots[a], spots[b]
            dx, dy = bx - ax, by - ay
            ln = max(1.0, math.hypot(dx, dy))
            px_, py_ = -dy / ln, dx / ln                         # across the way
            swirl = rnd.choice((-1, 1)) * rnd.uniform(60, 160)
            out = []
            for p_ in pieces:
                cx_, cy_ = p_["ox"] + p_["w"] / 2 - S / 2, p_["oy"] + p_["h"] / 2 - S / 2
                dl = max(1.0, math.hypot(cx_, cy_))
                burst = rnd.uniform(40, 120) * k * 2.2
                p0 = (ax + p_["ox"], ay + p_["oy"])
                p3 = (bx + p_["ox"], by + p_["oy"])
                p1 = (p0[0] + cx_ / dl * burst + rnd.uniform(-20, 20), p0[1] + cy_ / dl * burst + rnd.uniform(-20, 20))
                p2 = (p3[0] - dx * 0.18 + px_ * (swirl + rnd.uniform(-40, 40)),
                      p3[1] - dy * 0.18 + py_ * (swirl + rnd.uniform(-40, 40)))
                out.append((p0, p1, p2, p3, rnd.uniform(0.0, 0.55)))
            return out

        def frame():
            if self._idle_win is not c:
                return
            now = time.time()
            t = now - st["t0"]
            draw_clock(time.localtime(now))
            ax, ay = spots[st["a"]]
            if t < HOLD:
                # resting: the lens looks around, then the light passes over the glass
                c.itemconfigure(base, state="normal")
                c.coords(base, ax, ay)
                lx, ly = ax + 153 * k, ay + 121 * k
                gl = None
                if 0.5 <= t < 2.3:
                    u = (t - 0.5) / 1.8
                    lx += -20 * k * math.sin(math.pi * u) * math.cos(math.pi * u * 0.5)
                    ly += -8 * k * math.sin(2 * math.pi * u)
                elif 2.4 <= t < 3.1:
                    gl = min(7, int((t - 2.4) / 0.7 * 8)) / 7
                c.itemconfigure(lens, state="normal", image=imgs[f"lens{gl}"])
                c.coords(lens, lx, ly)
                if t < 0.45 and st.get("pop"):
                    r_ = S * (0.55 + t * 1.4)
                    ccx, ccy = ax + S / 2, ay + S / 2
                    c.coords(ring, ccx - r_, ccy - r_, ccx + r_, ccy + r_)
                    c.itemconfigure(ring, state="normal", width=max(1, 3 - t * 6))
                else:
                    c.itemconfigure(ring, state="hidden")
                for p_ in pieces:
                    c.itemconfigure(p_["it"], state="hidden")
            elif t < HOLD + FLY:
                # the logo breaks into pieces that fly to another corner and come together again
                if st["plan"] is None:
                    st["b"] = rnd.choice([i for i in range(len(spots)) if i != st["a"]])
                    st["plan"] = plan(st["a"], st["b"])
                    c.itemconfigure(base, state="hidden")
                    c.itemconfigure(lens, state="hidden")
                    c.itemconfigure(ring, state="hidden")
                u0 = t - HOLD
                flying = []
                for p_, (p0, p1, p2, p3, dl) in zip(pieces, st["plan"]):
                    u = max(0.0, min(1.0, (u0 - dl) / (FLY - 0.6)))
                    u = u * u * (3 - 2 * u)
                    x, y = bez(p0, p1, p2, p3, u)
                    c.coords(p_["it"], x, y)
                    c.itemconfigure(p_["it"], state="normal")
                    if 0.05 < u < 0.95:
                        flying.append((x + p_["w"] / 2, y + p_["h"] / 2))
                # little sparks behind the flying pieces
                for i, sp in enumerate(spark_st):
                    if sp is not None:
                        age = now - sp[2]
                        if age > 0.55:
                            spark_st[i] = None
                            c.itemconfigure(sparks[i], state="hidden")
                        else:
                            r_ = 3.2 * (1 - age / 0.55)
                            c.coords(sparks[i], sp[0] - r_, sp[1] - r_, sp[0] + r_, sp[1] + r_)
                for _n in range(3):
                    if flying:
                        free = [i for i, sp in enumerate(spark_st) if sp is None]
                        if not free:
                            break
                        x, y = rnd.choice(flying)
                        i = free[0]
                        spark_st[i] = (x + rnd.uniform(-4, 4), y + rnd.uniform(-4, 4), now)
                        c.itemconfigure(sparks[i], state="normal", fill=rnd.choice(spark_cols))
            else:
                st["a"], st["plan"], st["t0"], st["pop"] = st["b"], None, now, True
                for i in range(len(sparks)):
                    spark_st[i] = None
                    c.itemconfigure(sparks[i], state="hidden")
            c.tag_raise(lens)
            self._idle_job = self.root.after(40, frame)
        for seq in ("<Motion>", "<Button-1>", "<Button-3>", "<MouseWheel>"):
            c.bind(seq, lambda e: self._idle_stop() if time.time() - self._idle_since > 0.6 else None)
        self._idle_imgs = imgs
        frame()

    def _idle_stop(self):
        c = getattr(self, "_idle_win", None)
        if c is None:
            return
        self._idle_win = None
        if pin_load():                                   # 4.0: after the resting screen, the PIN again
            self.root.after(10, self._lock_show)
        self._last_motion = time.time()
        try:
            if getattr(self, "_idle_job", None):
                self.root.after_cancel(self._idle_job)
        except Exception:
            pass
        try:
            c.destroy()
        except Exception:
            pass
        self._idle_imgs = None
        pf = getattr(self, "_idle_prev_focus", None)
        self._idle_prev_focus = None
        try:
            if pf is not None and pf.winfo_exists():
                pf.focus_set()
        except Exception:
            pass

