        # ---- the list (open as soon as Reports opens) ---------------------------------------------------------
        lst = {"w": None}
        LH = 488

        def close_list():
            if lst["w"] is not None:
                lst["w"].destroy()
                lst["w"] = None
            draw_field(False)

        def open_list(_e=None, query=""):
            if lst["w"] is not None:
                if S["type"]:
                    close_list()
                    build_opts()
                return
            for w_ in opts.winfo_children():
                w_.destroy()
            opts.pack_forget()
            draw_field(True)
            f = tk.Frame(mid, bg=T["panel"], highlightthickness=1, highlightbackground=T["border"])
            lst["w"] = f
            f.pack(fill="x")
            top_ = tk.Frame(f, bg=T["panel"])
            top_.pack(fill="x", padx=10, pady=(10, 4))
            sv = tk.StringVar(value=query)
            se = tk.Entry(top_, textvariable=sv, font=self.F(11), relief="flat", bg=BG, fg=T["text"],
                          highlightthickness=1, highlightbackground=T["border"], highlightcolor=A,
                          insertbackground=T["text"])
            se.pack(fill="x", ipady=6)
            ph = tk.Label(se, text="Search - e.g.  emails,  rows,  summary,  week 38", font=self.F(10), bg=BG,
                          fg=T["muted"], cursor="xterm")

            def place_ph(*_a):
                if sv.get():
                    ph.place_forget()
                else:
                    ph.place(x=8, rely=0.5, anchor="w")
            ph.bind("<Button-1>", lambda e: se.focus_set())
            lc = tk.Canvas(f, bg=T["panel"], highlightthickness=0, width=LW - 2, height=LH, cursor="hand2")
            lc.pack(fill="x")
            hint = tk.Label(f, text="", font=self.F(9), bg=T["panel"], fg=T["muted"], anchor="w")
            hint.pack(fill="x", padx=14, pady=(0, 4))
            ask_l = tk.Label(f, text="Or ask your documents in your own words…", font=self.F(9, "bold"),
                             bg=T["panel"], fg="#9B5DE5", cursor="hand2", anchor="w")
            ask_l.pack(fill="x", padx=14, pady=(0, 10))
            ask_l.bind("<Button-1>", lambda e: (close_list(), select("ask")))
            hits, cur = [], {"i": -1}
            NC = 3
            RH, GH, colw = 26, 32, (LW - 14) / NC

            def fill(*_a):
                place_ph()
                lc.delete("all")
                hits.clear()
                qq = sv.get().strip().lower()
                words = [w for w in re.split(r"\s+", qq) if w]
                groups = []
                for g_, col, its in self.REPORT_MENU:
                    if g_ == "Ask your documents":
                        continue
                    shown = [it for it in its if not words or all(
                        w in (it[1] + " " + it[2] + " " + g_ + " " + it[5]).lower() for w in words)]
                    if shown:
                        groups.append((g_, col, shown))
                if not groups:
                    lc.create_text(LW / 2, 60, text="Nothing in the list with that.", font=self.F(10),
                                   fill=T["muted"])
                    if qq:
                        lc.create_text(LW / 2, 90, text=f"Press Enter to ask your documents:  “{sv.get().strip()}”",
                                       font=self.F(10, "bold"), fill="#9B5DE5")
                    cur["i"] = -1
                    return
                # 3.0: the groups are shared out so the tallest column is as short as can be (order kept);
                # if it is still taller than the list, the list scrolls
                hs_ = [GH + RH * len(s_) + 8 for _g, _c, s_ in groups]
                ng = len(hs_)
                best_, cuts = None, (ng, ng)
                for i_ in range(1, ng + 1):
                    for j_ in range(i_, ng + 1):
                        mx_ = max(sum(hs_[:i_]), sum(hs_[i_:j_]), sum(hs_[j_:]))
                        if best_ is None or mx_ < best_:
                            best_, cuts = mx_, (i_, j_)
                colx, y, colh = 0, 4, 0
                for gi_, (g_, col, shown) in enumerate(groups):
                    nc_ = 0 if gi_ < cuts[0] else (1 if gi_ < cuts[1] else 2)
                    if nc_ != colx:
                        colx, y = nc_, 4                   # the next column
                    x0 = 6 + colx * colw
                    gw_ = self._measure(g_.upper(), self._sfont(8, "bold")) + 22
                    round_rect(lc, x0 + 4, y + 6, x0 + 4 + gw_, y + 25, 9, fill=mix(T["panel"], col, 0.13),
                               outline="")
                    lc.create_oval(x0 + 10, y + 12.5, x0 + 16, y + 18.5, fill=col, outline="")
                    lc.create_text(x0 + 20, y + 16, text=g_.upper(), anchor="w", font=self.F(8, "bold"), fill=col)
                    y += GH
                    for it in shown:
                        hits.append((x0, y, x0 + colw - 16, y + RH, it[0], col, it[2]))
                        y += RH
                    y += 8
                    colh = max(colh, y)
                if cur["i"] >= len(hits) or (words and cur["i"] < 0):
                    cur["i"] = 0 if words else -1
                paint()
                lc.configure(height=max(140, min(LH, colh + 4)), scrollregion=(0, 0, LW - 2, colh + 4))

            def paint():
                lc.delete("row")
                for i, (x0, y0, x1, y1, k, col, desc) in enumerate(hits):
                    it = items[k][0]
                    on = i == cur["i"] or k == S["hover"]
                    last = k == mem.get("type")
                    if on:
                        round_rect(lc, x0, y0 + 1, x1, y1 - 1, 8, fill=mix(T["panel"], col, 0.12), outline="",
                                   tags="row")
                    self._rep_icon(lc, k, x0 + 6, y0 + (RH - 18) / 2, col, on or last, 18, tags="row")
                    lc.create_text(x0 + 32, y0 + RH / 2, text=it[1], anchor="w", tags="row",
                                   font=self.F(10, "bold" if on else "normal"), fill=T["text"])
                if 0 <= cur["i"] < len(hits):
                    hint.configure(text=hits[cur["i"]][6], fg=hits[cur["i"]][5])
                elif S["hover"] and S["hover"] in items:
                    hint.configure(text=items[S["hover"]][0][2], fg=items[S["hover"]][2])
                else:
                    hint.configure(text="Click what you want - you choose the details after.", fg=T["muted"])

            def at(e):
                yy_ = lc.canvasy(e.y)
                return next((i for i, h in enumerate(hits) if h[0] <= e.x <= h[2] and h[1] <= yy_ < h[3]), -1)

            def motion(e):
                i = at(e)
                if i != cur["i"]:
                    cur["i"] = i
                    paint()

            def choose(i):
                if 0 <= i < len(hits):
                    k = hits[i][4]
                    close_list()
                    select(k)
                elif sv.get().strip():
                    q_ = sv.get().strip()
                    close_list()
                    select("ask", question=q_)

            def key(e):
                if e.keysym in ("Down", "Up") and hits:
                    i = cur["i"]
                    if i < 0:
                        i = 0
                    else:
                        i = (i + (1 if e.keysym == "Down" else -1)) % len(hits)
                    cur["i"] = i
                    paint()
                    return "break"
                if e.keysym == "Return":
                    choose(cur["i"] if cur["i"] >= 0 else (0 if hits and sv.get().strip() else -1))
                    return "break"
            lc.bind("<Motion>", motion)
            lc.bind("<MouseWheel>", lambda e: lc.yview_scroll(-1 if e.delta > 0 else 1, "units"))
            lc.bind("<Button-4>", lambda e: lc.yview_scroll(-1, "units"))
            lc.bind("<Button-5>", lambda e: lc.yview_scroll(1, "units"))
            lc.configure(yscrollincrement=26)
            lc.bind("<Leave>", lambda e: (cur.__setitem__("i", -1), paint()))
            lc.bind("<Button-1>", lambda e: choose(at(e)))
            se.bind("<KeyPress>", key)
            se.bind("<Escape>", lambda e: (closing(), "break")[1])
            sv.trace_add("write", fill)
            fill()
            se.focus_set()
            se.icursor("end")
        field.bind("<Button-1>", open_list)

        # ---- what to include (only after choosing) -------------------------------------------------------------
        opts = tk.Frame(mid, bg=BG)
        box = {"entry": None, "var": tk.StringVar(), "q": tk.StringVar(value=mem.get("question", ""))}
        two = {"a": None, "b": None}
        tot = {}
        docs = {"res": [], "lb": None}

        def scope_files():
            if S["scope"] == "books":
                self._rep_books = set(S["books"])
                return self._scope_files("books")
            return self._scope_files(S["scope"] if S["scope"] in ("folder", "file") else "library")

        def checkbox(parent, text, on, cb, col):
            fr_ = tk.Frame(parent, bg=BG, cursor="hand2")
            cv = tk.Canvas(fr_, width=22, height=22, bg=BG, highlightthickness=0, cursor="hand2")
            cv.pack(side="left")
            lb = tk.Label(fr_, text=text, font=self.F(10), bg=BG, fg=T["text"], cursor="hand2")
            lb.pack(side="left", padx=(5, 0))
            st_ = {"on": bool(on)}

            def paint_():
                cv.delete("all")
                if st_["on"]:
                    round_rect(cv, 2, 2, 20, 20, 6, fill=col, outline="")
                    cv.create_line(6.5, 11.5, 9.5, 14.5, 15.5, 7.5, fill="#FFFFFF", width=2.2, capstyle="round",
                                   joinstyle="round")
                else:
                    round_rect(cv, 2, 2, 20, 20, 6, fill=T["panel"], outline=mix(T["muted"], BG, 0.35), width=1.5)

            def flip(_e=None):
                st_["on"] = not st_["on"]
                paint_()
                cb(st_["on"])
            for w_ in (fr_, cv, lb):
                w_.bind("<Button-1>", flip)
            paint_()
            return fr_

        def section(text):
            tk.Label(opts, text=text.upper(), font=self.F(8, "bold"), bg=BG, fg=T["muted"]).pack(anchor="w",
                                                                                                 pady=(14, 6))

