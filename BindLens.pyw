def _fz_mod():
    if _FITZ is not None:
        return _FITZ
    try:
        import pymupdf as m_
    except ImportError:
        import fitz as m_
    return m_


def needs_full_font(text):
    """4.2: True when a PDF standard font would lose some of these letters (€ “ ” – … ł ő Ś … came out as dots or
    blanks): the standard fonts only know the first 256 letters."""
    return any(ord(c) > 255 or 0x80 <= ord(c) <= 0x9F for c in (text or ""))


def full_font(page, fontname, text):
    """4.2: the font name to write `text` with. A standard font (helv, tiro, cour…) that would lose letters is
    swapped for the SAME font embedded whole (it has every Latin letter) - it looks the same, nothing goes
    missing. Embedded once per document."""
    fn = (fontname or "helv").lower()
    if fn not in _B14 or not needs_full_font(text):
        return fontname or "helv"
    _fz = _fz_mod()
    try:
        if fn not in _FONTBUF:
            _FONTBUF[fn] = _fz.Font(fn).buffer
        name = "BLu" + fn
        page.insert_font(fontname=name, fontbuffer=_FONTBUF[fn])
        return name
    except Exception:
        return fontname or "helv"


def _font_has_all(fz, text, fontfile=None, fontbuffer=None):
    """Does this font file have every letter of text? (A font taken out of a PDF often has only some.)"""
    try:
        key = fontfile or id(fontbuffer)
        f = _FONTOBJ.get(key)
        if f is None:
            f = fz.Font(fontfile=fontfile) if fontfile else fz.Font(fontbuffer=fontbuffer)
            if fontfile:
                _FONTOBJ[key] = f
        return all(c.isspace() or f.has_glyph(ord(c)) for c in text or "")
    except Exception:
        return False


EDIT_FONTS = ["Arial", "Calibri", "Times New Roman", "Georgia", "Verdana", "Segoe UI", "Courier New", "Tahoma",
              "Garamond", "Century Gothic", "Comic Sans MS"]


def system_font_file(family, bold=False, italic=False):
    """The font file of a family on this computer (Windows fonts folder, Mac and Linux font folders) or None."""
    key = re.sub(r"[^a-z]", "", (family or "").lower())
    k = (1 if bold else 0) + (2 if italic else 0)
    dirs = []
    if os.name == "nt":
        dirs.append(os.path.join(os.environ.get("WINDIR", r"C:\Windows"), "Fonts"))
        la = os.environ.get("LOCALAPPDATA")
        if la:
            dirs.append(os.path.join(la, "Microsoft", "Windows", "Fonts"))
    else:
        dirs += ["/Library/Fonts", "/System/Library/Fonts/Supplemental", os.path.expanduser("~/Library/Fonts"),
                 "/usr/share/fonts/truetype/msttcorefonts", os.path.expanduser("~/.fonts")]
    files = _SYS_FONTS.get(key)
    names = [files[k], files[0]] if files else []
    names += [family + suf for suf in ((" Bold Italic", " Bold", " Italic", "") if k == 3 else
                                        (" Bold", "") if k == 1 else (" Italic", "") if k == 2 else ("",))]
    for d in dirs:
        for n in names:
            for ext in (".ttf", ".otf", ".TTF"):
                p = os.path.join(d, n + ext)
                if os.path.isfile(p):
                    return p
    return None


def pdf_font_for(doc, page, span, text="", bold=None, italic=None, family=None):
    """(fontname, fontfile, fontbuffer) closest to a span's font: the font in the PDF itself when it is whole (not a
    subset) AND has every letter of `text`, the same font on this computer, else the nearest standard font -
    embedded whole when the text needs it (4.2: letters never turn into dots or blanks). bold / italic / family:
    what the person chose instead (None = as the original)."""
    _fz = _fz_mod()
    name = span.get("font", "") or ""
    base = name.split("+", 1)[-1]
    low = base.lower()
    flags = int(span.get("flags", 0))
    b0 = bool(flags & 16) or any(w in low for w in ("bold", "black", "heavy", "semibold"))
    i0 = bool(flags & 2) or "italic" in low or "oblique" in low
    bold = b0 if bold is None else bold
    italic = i0 if italic is None else italic
    if family is None and "+" not in name and bold == b0 and italic == i0:
        try:
            for f in page.get_fonts(full=True):
                if f[3] == name or f[3].split("+", 1)[-1] == base:
                    fb = doc.extract_font(f[0])
                    if fb and fb[3] and str(fb[1]).lower() in ("ttf", "otf", "cff", "pfa", "pfb") and \
                            _font_has_all(_fz, text, fontbuffer=fb[3]):
                        return "BLe" + str(f[0]), None, fb[3]
        except Exception:
            pass
    if family:
        fam = re.sub(r"[^a-z]", "", family.lower())
    else:
        fam = re.sub(r"[-,](?:bold|italic|oblique|regular|semibold|light|black|medium|mt|ps|psmt)\b.*$", "", low)
        fam = re.sub(r"(?:psmt|mt|ps)$", "", re.sub(r"[^a-z]", "", fam))
    fp = system_font_file(family or fam, bold, italic) if (family or _SYS_FONTS.get(fam)) else None
    if fp and _font_has_all(_fz, text, fontfile=fp):
        return "BLs" + re.sub(r"\W", "", os.path.splitext(os.path.basename(fp))[0])[:12], fp, None
    low2 = (family or low).lower()
    serif = ((bool(flags & 4) and not family) or any(w in low2 for w in (
        "times", "serif", "georgia", "garamond", "cambria", "roman", "book", "minion", "palatino"))) and \
        "sans" not in low2 and not any(w in low2 for w in ("arial", "helvet", "calibri", "verdana", "segoe"))
    mono = (bool(flags & 8) and not family) or any(w in low2 for w in ("courier", "mono", "consol"))
    k = (1 if bold else 0) + (2 if italic else 0)
    if mono:
        return full_font(page, ("cour", "cobo", "coit", "cobi")[k], text), None, None
    if serif:
        return full_font(page, ("tiro", "tibo", "tiit", "tibi")[k], text), None, None
    return full_font(page, ("helv", "hebo", "heit", "hebi")[k], text), None, None


