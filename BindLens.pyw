def _fx_poly(sh, pts, fill, stroke=None, width=1.0, opacity=1.0, close=True):
    sh.draw_polyline(pts + ([pts[0]] if close else []))
    sh.finish(color=hex_to_rgb01(stroke) if stroke else None, fill=hex_to_rgb01(fill) if fill else None,
              width=width, fill_opacity=opacity, stroke_opacity=opacity, closePath=close, lineJoin=1)


def _fx_leaf_outline(shape):
    import math
    if shape == "maple":
        return [(50, 82), (36, 87), (38, 74), (17, 79), (22, 66), (5, 60), (16, 52), (7, 39), (24, 40), (19, 23),
                (34, 32), (37, 13), (46, 22), (50, 3), (54, 22), (63, 13), (66, 32), (81, 23), (76, 40), (93, 39),
                (84, 52), (95, 60), (78, 66), (83, 79), (62, 74), (64, 87)]
    pts = []
    n = 72
    if shape == "ginkgo":                                  # a fan with a notch in the middle of its wavy edge
        pts.append((50, 70))
        for k in range(n + 1):
            th = math.radians(-64 + 128 * k / n)
            r = 46 * (1 - 0.2 * math.exp(-(math.degrees(th) / 7) ** 2)) * (1 + 0.025 * math.sin(k * 1.9))
            pts.append((50 + r * math.sin(th), 70 - r * math.cos(th)))
        return pts
    for k in range(n):
        t = 2 * math.pi * k / n
        if shape == "oak":
            w = 21 * (1 + 0.28 * abs(math.sin(4.5 * t))) * (0.75 + 0.25 * math.cos(t / 2) ** 2)
            pts.append((50 + w * math.sin(t), 48 - 41 * math.cos(t)))
        else:                                              # birch: an oval with a point and a fine saw edge
            w = 25 * (1 - 0.42 * ((1 + math.cos(t)) / 2) ** 2.2) * (1 + 0.045 * (1 if k % 2 else -1))
            pts.append((50 + w * math.sin(t), 50 - 43 * math.cos(t)))
    return pts


