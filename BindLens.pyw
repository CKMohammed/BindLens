class _IconRec:
    """Records what draw_icon draws (like a Tk canvas) so PyMuPDF can draw it again, smooth."""

    def __init__(self):
        self.ops = []
        self._n = 0

    def _id(self):
        self._n += 1
        return self._n

    def create_line(self, *p, **k):
        pts = [(p[i], p[i + 1]) for i in range(0, len(p) - 1, 2)]
        self.ops.append(["line", pts, k])
        return self._id()

    def create_oval(self, x0, y0, x1, y1, **k):
        self.ops.append(["oval", (x0, y0, x1, y1), k])
        return self._id()

    def create_arc(self, x0, y0, x1, y1, **k):
        self.ops.append(["arc", (x0, y0, x1, y1), k])
        return self._id()

    def create_polygon(self, *p, **k):
        if len(p) == 1 and isinstance(p[0], (list, tuple)):
            p = p[0]
        pts = [(p[i], p[i + 1]) for i in range(0, len(p) - 1, 2)]
        self.ops.append(["poly", pts, k])
        return self._id()

    def create_rectangle(self, x0, y0, x1, y1, **k):
        self.ops.append(["poly", [(x0, y0), (x1, y0), (x1, y1), (x0, y1)], k])
        return self._id()

    def create_text(self, *a, **k):
        return self._id()

    def find_all(self):
        return list(range(1, self._n + 1))

    def itemconfigure(self, item, **k):
        if 1 <= item <= len(self.ops):
            self.ops[item - 1][2].update(k)

    def paint(self, page, fitz, color=None):
        import math
        for kind, geo, k in self.ops:
            sh = page.new_shape()
            width = float(k.get("width", 1.5))
            dash = k.get("dash")
            dashes = f"[{' '.join(str(int(x)) for x in dash)}] 0" if dash else None
            if kind == "line":
                if len(geo) < 2:
                    continue
                sh.draw_polyline(geo)
                sh.finish(color=_rgb(color or k.get("fill") or "#000000"), width=width, lineCap=1, lineJoin=1,
                          closePath=False, dashes=dashes)
            elif kind == "oval":
                sh.draw_oval(fitz.Rect(*geo))
                fill = k.get("fill")
                out = k.get("outline", "")
                sh.finish(color=_rgb(color or out) if out else None, width=width,
                          fill=_rgb(color or fill) if fill else None)
            elif kind == "arc":
                x0, y0, x1, y1 = geo
                st, ex = float(k.get("start", 0)), float(k.get("extent", 90))
                cxx, cyy, rx, ry = (x0 + x1) / 2, (y0 + y1) / 2, (x1 - x0) / 2, (y1 - y0) / 2
                n = max(6, int(abs(ex) / 8))
                pts = [(cxx + rx * math.cos(math.radians(st + ex * i / n)),
                        cyy - ry * math.sin(math.radians(st + ex * i / n))) for i in range(n + 1)]
                sh.draw_polyline(pts)
                sh.finish(color=_rgb(color or k.get("outline") or "#000000"), width=width, lineCap=1, lineJoin=1,
                          closePath=False)
            else:
                fill = k.get("fill")
                out = k.get("outline")
                sh.draw_polyline(geo + [geo[0]])
                sh.finish(color=_rgb(color or out) if out else None, width=width,
                          fill=_rgb(color or fill) if fill else None, closePath=True, lineJoin=1)
            sh.commit()


def _tile_text(page, fitz, text, cx, cy, size, color, maxw):
    fs = size
    while fs > 4 and fitz.get_text_length(text, fontname="hebo", fontsize=fs) > maxw:
        fs -= 0.5
    tw = fitz.get_text_length(text, fontname="hebo", fontsize=fs)
    page.insert_text((cx - tw / 2, cy + fs * 0.36), text, fontname="hebo", fontsize=fs, color=_rgb(color))


def tile_png(size, color, icon=None, text=None, style="3d", badge=None, selected=False, dim=False):
    """A book tile as a PNG (with transparency), drawn by PyMuPDF: smooth at every size."""
    fitz = _FITZ
    m = 5
    W = size + 2 * m
    doc = fitz.open()
    pg = doc.new_page(width=W, height=W)
    x, y, s = m, m, size
    r = s * 0.27
    rad = min(0.5, r / s)
    col = color
    sh = pg.new_shape()
    if style == "light":
        face = mix(col, "#FFFFFF", 0.80)
        sh.draw_rect(fitz.Rect(x + 0.5, y + 1.6, x + s + 0.5, y + s + 1.6), radius=rad)
        sh.finish(color=None, fill=(0, 0, 0), fill_opacity=0.07)
        sh.draw_rect(fitz.Rect(x, y, x + s, y + s), radius=rad)
        sh.finish(color=_rgb(mix(col, "#FFFFFF", 0.45)), width=max(0.8, s / 40), fill=_rgb(face))
        ink, shade = mix(col, "#000000", 0.25) if is_light(col) else col, None
    elif style == "flat":
        sh.draw_rect(fitz.Rect(x, y, x + s, y + s), radius=rad)
        sh.finish(color=None, fill=_rgb(col))
        ink, shade = ("#1F1F1F" if is_light(col) else "#FFFFFF"), None
    else:
        sh.draw_rect(fitz.Rect(x + 0.8, y + s * 0.08, x + s + 0.8, y + s * 1.08), radius=rad)
        sh.finish(color=None, fill=(0, 0, 0), fill_opacity=0.16)
        sh.draw_rect(fitz.Rect(x, y, x + s, y + s), radius=rad)
        sh.finish(color=None, fill=_rgb(mix(col, "#000000", 0.2)))
        sh.draw_rect(fitz.Rect(x, y, x + s, y + s * 0.94), radius=rad)
        sh.finish(color=None, fill=_rgb(col))
        sh.draw_rect(fitz.Rect(x + s * 0.07, y + s * 0.05, x + s * 0.93, y + s * 0.52), radius=min(0.5, r * 0.8 / s))
        sh.finish(color=None, fill=(1, 1, 1), fill_opacity=0.2)
        ink = "#1F1F1F" if is_light(col) else "#FFFFFF"
        shade = mix(col, "#000000", 0.35)
    if selected:
        sh.draw_rect(fitz.Rect(x - 3, y - 3, x + s + 3, y + s + 3), radius=min(0.5, (r + 3) / (s + 6)))
        sh.finish(color=_rgb(col), width=1.6)
    sh.commit()
    cx, cy = x + s / 2, y + s * (0.47 if style == "3d" else 0.5)
    icon = icon or "letters"
    under = ""
    if "|" in icon:                                   # 1.9: an icon with your own text under it
        icon, under = icon.split("|", 1)
        icon = icon or "folder"
    kind, _, val = icon.partition(":") if ":" in icon else (icon, "", "")
    k_ = s / 46
    if under and ":" not in icon and icon != "letters":
        k2 = k_ * 0.68
        iy = y + s * 0.36
        if shade:
            rec = _IconRec()
            draw_icon(rec, icon, cx + 0.6, iy + 0.8, shade, s=k2, w=1.8)
            rec.paint(pg, fitz)
        rec = _IconRec()
        draw_icon(rec, icon, cx, iy, ink, s=k2, w=1.8)
        rec.paint(pg, fitz)
        ty = y + s * (0.76 if style == "3d" else 0.78)
        fs = s * (0.27 if len(under) <= 2 else (0.23 if len(under) <= 3 else 0.2))
        if shade:
            _tile_text(pg, fitz, under, cx + 0.6, ty + 0.8, fs, shade, s * 0.86)
        _tile_text(pg, fitz, under, cx, ty, fs, ink, s * 0.86)
        icon = None
    if icon is None:
        pass
    elif kind in ("fl", "yr", "mo", "q", "wk", "ay", "cal", "dt") or icon == "letters" or kind == "tx":
        frame = {"fl": "folder", "yr": "folder", "q": "folder", "ay": "folder", "mo": "calendar", "cal": "calendar",
                 "wk": "calendar", "dt": "doc"}.get(kind)
        txt = val or (text or "?")
        if icon == "letters":
            txt = text or "?"
        if kind == "mo":
            txt = val[:3].upper()
        if kind == "wk":
            txt = "W" + val
        if frame:
            # a white (ink) folder / calendar / page, with the letters in the colour of the tile
            u = k_ * 1.3
            P_ = lambda pts: [(cx + px * u, cy + py * u) for px, py in pts]
            on_ink = mix(col, "#000000", 0.15) if is_light(ink) else (col if not is_light(col) else "#FFFFFF")
            if style == "light":
                on_ink = "#FFFFFF"
            sh = pg.new_shape()
            if shade:
                pts0 = {"folder": [(-9, -7), (-4, -7), (-2, -5), (9, -5), (9, 8), (-9, 8)],
                        "calendar": [(-9, -7), (9, -7), (9, 9), (-9, 9)],
                        "doc": [(-7, -9), (3, -9), (7, -5), (7, 9), (-7, 9)]}[frame]
                sh.draw_polyline([(x_ + 0.8, y_ + 1.1) for x_, y_ in P_(pts0)] + [P_(pts0)[0]])
                sh.finish(color=None, fill=_rgb(shade), closePath=True)
            if frame == "folder":
                sh.draw_polyline(P_([(-9, -7), (-4, -7), (-2, -5), (9, -5), (9, 8), (-9, 8), (-9, -7)]))
                sh.finish(color=None, fill=_rgb(ink), closePath=True)
                sh.draw_line(P_([(-9, -3)])[0], P_([(9, -3)])[0])
                sh.finish(color=_rgb(mix(ink, on_ink, 0.3)), width=max(0.6, u * 0.5))
                ty, mw = cy + 2.6 * u, 16 * u
                fs = u * (11 if len(txt) <= 1 else (9 if len(txt) <= 2 else (6.4 if len(txt) <= 4 else 5.2)))
            elif frame == "calendar":
                sh.draw_rect(fitz.Rect(*P_([(-9, -7)])[0], *P_([(9, 9)])[0]), radius=0.12)
                sh.finish(color=None, fill=_rgb(ink))
                sh.draw_rect(fitz.Rect(*P_([(-9, -7)])[0], *P_([(9, -2.5)])[0]), radius=0.12)
                sh.finish(color=None, fill=_rgb(mix(ink, on_ink, 0.55)))
                for rx_ in (-4.5, 4.5):
                    sh.draw_line(P_([(rx_, -9.5)])[0], P_([(rx_, -5)])[0])
                    sh.finish(color=_rgb(ink), width=max(1.0, u * 1.3), lineCap=1)
                ty, mw = cy + 3.4 * u, 15 * u
                fs = u * (9.5 if len(txt) <= 2 else 6.6)
            else:
                sh.draw_polyline(P_([(-7, -9), (3, -9), (7, -5), (7, 9), (-7, 9), (-7, -9)]))
                sh.finish(color=None, fill=_rgb(ink), closePath=True)
                sh.draw_polyline(P_([(3, -9), (3, -5), (7, -5)]))
                sh.finish(color=_rgb(mix(ink, on_ink, 0.45)), width=max(0.6, u * 0.6), closePath=False)
                ty, mw = cy + 1.5 * u, 12.5 * u
                fs = u * (6.5 if len(txt) <= 3 else 5)
            sh.commit()
            _tile_text(pg, fitz, txt, cx, ty, fs, on_ink, mw)
        else:
            ty, mw, fs = cy, s * 0.78, s * (0.42 if len(txt) <= 2 else 0.3)
            if shade:
                _tile_text(pg, fitz, txt, cx + 0.8, ty + 1.1, fs, shade, mw)
            _tile_text(pg, fitz, txt, cx, ty, fs, ink, mw)
    else:
        if shade:
            rec = _IconRec()
            draw_icon(rec, icon, cx + 0.8, cy + 1.1, shade, s=k_, w=1.9)
            rec.paint(pg, fitz)
        rec = _IconRec()
        draw_icon(rec, icon, cx, cy, ink, s=k_, w=1.9)
        rec.paint(pg, fitz)
    if badge and badge.get("t"):
        br = max(5.0, s * 0.2)
        bx, by = x + s - br * 0.55, y + br * 0.55
        sh = pg.new_shape()
        sh.draw_circle((bx, by), br + 1.2)
        sh.finish(color=None, fill=(1, 1, 1))
        sh.draw_circle((bx, by), br)
        sh.finish(color=None, fill=_rgb(badge.get("c") or "#D93025"))
        sh.commit()
        bt = str(badge["t"])[:3]
        if bt == "✓":
            rec = _IconRec()
            rec.create_line(bx - br * 0.45, by, bx - br * 0.1, by + br * 0.4, bx + br * 0.5, by - br * 0.4,
                            fill="#FFFFFF", width=max(1.2, br * 0.28))
            rec.paint(pg, fitz)
        elif bt == "★":
            rec = _IconRec()
            draw_icon(rec, "star2", bx, by, "#FFFFFF", s=br / 11, w=1)
            for op in rec.ops:
                op[2]["fill"] = "#FFFFFF"
            pts = rec.ops[0][1] if rec.ops else []
            if pts:
                sh = pg.new_shape()
                sh.draw_polyline(pts)
                sh.finish(color=None, fill=(1, 1, 1), closePath=True)
                sh.commit()
        else:
            _tile_text(pg, fitz, bt, bx, by, br * (1.25 if len(bt) == 1 else 0.95), "#FFFFFF", br * 1.7)
    pix = pg.get_pixmap(alpha=True)
    if dim:
        pass
    data = pix.tobytes("png")
    doc.close()
    return data, m


def evict_pictures(cache, keep_max, pic=lambda v: v[0]):
    """3.0: a full picture store drops its OLDEST pictures that are not on the screen - before, it emptied
    itself and pictures still shown went blank (book tiles, the calendar, the clock, numbers on the cards)."""
    if len(cache) <= keep_max:
        return
    drop = len(cache) - int(keep_max * 0.75)
    for k in list(cache.keys()):
        if drop <= 0:
            break
        try:
            im = pic(cache[k])
            used = im is not None and bool(int(im.tk.call("image", "inuse", im.name)))
        except Exception:
            used = False
        if not used:
            cache.pop(k, None)
            drop -= 1


def tile_photo(size, color, icon=None, text=None, style="3d", badge=None, selected=False):
    key = (size, color, icon, text, style, json.dumps(badge or {}, sort_keys=True), selected)
    if key not in _TILE_CACHE:
        evict_pictures(_TILE_CACHE, 600)
        data, m = tile_png(size, color, icon, text, style, badge, selected)
        _TILE_CACHE[key] = (tk.PhotoImage(data=data), m)
    return _TILE_CACHE[key]


