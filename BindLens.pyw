    def quick_search(self, query=None):
        """Ctrl+K: find a document by its name (not exact: 'week 38', 'wk38') or a word inside any document.
        3.0: actions too ('print', 'reports', 'expiring'…), and with nothing typed: your recent documents."""
        T = self.T
        if getattr(self, "_qs", None) is not None and self._qs.winfo_exists():
            self._qs.lift()
            if query:
                self._qs_var.set(query)
            return
        d = tk.Toplevel(self.root)
        self._qs = d
        d.title("Find anywhere")
        d.transient(self.root)
        d.configure(bg=T["panel"])
        var = tk.StringVar()
        self._qs_var = var
        en = ttk.Entry(d, textvariable=var, width=60, font=UI_FONT_L)
        en.pack(fill="x", padx=14, pady=(14, 6))
        mrow = tk.Frame(d, bg=T["panel"])
        mrow.pack(fill="x", padx=14)
        mode = {"m": self.lib.settings.get("qs_mode", "all")}
        mlbl = {}

        def paint_modes():
            for k_, lb_ in mlbl.items():
                on = mode["m"] == k_
                lb_.configure(bg=self.accent if on else T["chip"], fg="#FFFFFF" if on else T["text"])

        def set_mode(k_):
            mode["m"] = k_
            self.lib.settings["qs_mode"] = k_
            paint_modes()
            run()
        for k_, lab in (("all", "Everything"), ("names", "Document names"), ("text", "Inside the documents")):
            lb_ = tk.Label(mrow, text=lab, font=self.F(9), padx=10, pady=3, cursor="hand2")
            lb_.pack(side="left", padx=(0, 4))
            lb_.bind("<Button-1>", lambda e, k_=k_: set_mode(k_))
            mlbl[k_] = lb_
        paint_modes()
        info = ttk.Label(d, text="Names don't have to be exact - e.g.  week 38,  wk38,  invoce march",
                         style="Muted.TLabel")
        info.pack(anchor="w", padx=16, pady=(6, 0))
        lb = RowList(d, self)                          # 3.0: real rows (kind, title, where, shortcut)
        lb.pack(fill="both", expand=True, padx=10, pady=(6, 12))
        results = []

        def run(*_):
            raw = var.get().strip()
            q = fold(raw)
            lb.delete(0, "end")
            results.clear()
            if not q:                                   # 3.0: nothing typed - recent documents
                rec = [x for x in self.lib.settings.get("recent_docs", []) if x.get("f") in self.lib.folders and
                       not self._book_locked(x.get("f"))][:8]
                for x in rec:
                    results.append(("file", x["f"], x["rel"], x.get("p", 0)))
                    lb.insert("end", ("Recent", os.path.basename(x['rel']),
                                      f"{self.lib.label(x['f'])}  ·  page {int(x.get('p', 0)) + 1}", ""))
                info.config(text="Recent documents - or type a name, a word, or what you want to do (print, "
                                 "reports, expiring…)")
                if results:
                    lb.selection_set(0)
                return
            m = mode["m"]
            if m == "all":                              # 3.0: actions by name
                qt_ = q.split()
                for act in self._actions():
                    if not act or not act[4]:
                        continue
                    hay = fold(act[0] + " " + act[2])
                    if all(any(w_.startswith(t_) for w_ in hay.split()) for t_ in qt_):
                        results.append(("action", None, act, None))
                        lb.insert("end", ("Do", act[0], "", act[1] or ""))
            if m in ("all", "names"):
                qt = fuzzy_tokens(raw)
                for f in self.lib.folders:
                    lab_ = self.lib.label(f)
                    if q in fold(lab_) or (qt and fuzzy_score(qt, fuzzy_tokens(lab_)) >= 1.5 * len(qt)):
                        results.append(("folder", f, None, None))
                        lb.insert("end", ("Book", lab_, f"{len(self.lib.folders.get(f, []))} files", ""))
                for _sc, f, rel in self._find_docs(raw, limit=60 if m == "names" else 15):
                    if self._book_locked(f):
                        continue                          # 4.1: a locked book stays hidden until it is opened
                    results.append(("file", f, rel, 0))
                    lb.insert("end", ("Document", os.path.basename(rel), self.lib.label(f) +
                                      (f" / {os.path.dirname(rel)}" if "/" in rel else ""), ""))
            n = 0
            if m in ("all", "text"):
                t_end = time.time() + 0.25                # typing stays quick in a very big library
                low_cache = self.__dict__.setdefault("_qs_low", {})
                for key, entry in self.indexer.items():
                    if time.time() > t_end:
                        break
                    loc = self.lib.where.get(key)
                    if not loc:
                        continue
                    folder, rel = loc
                    if self._book_locked(folder):
                        continue
                    lows = low_cache.get(key)
                    if lows is None or lows[0] is not entry:
                        lows = (entry, [fold(t) for t in entry.get("pages", [])])
                        low_cache[key] = lows
                    for pi, text in enumerate(entry.get("pages", [])):
                        low = lows[1][pi]
                        i = low.find(q)
                        if i < 0 or ("text", folder, rel, pi) in results:
                            continue
                        a0 = text.rfind(" ", 0, max(0, i - 30)) + 1
                        snip = " ".join(text[a0:i + 50].split())
                        results.append(("text", folder, rel, pi))
                        lb.insert("end", ("Text", f"{os.path.basename(rel)}  ·  page {pi + 1}", f"…{snip}…", ""))
                        n += 1
                        if n >= 80:
                            break
                    if n >= 80:
                        break
            pend = len(self._index_queue)
            info.config(text=f"{len(results)} result{'s' if len(results) != 1 else ''}" +
                        (f"   (still reading {pend} files…)" if pend and
                                                          m != "names" else ""))
            if results:
                lb.selection_set(0)

        def go(_e=None):
            sel = lb.curselection()
            if not sel:
                return
            kind, folder, rel, pi = results[sel[0]]
            q = var.get().strip()
            d.destroy()
            if kind == "action":
                self.close_home()
                self.root.after(30, rel[3])
                return
            if folder not in self.lib.folders:
                return
            if kind == "folder":
                self.open_folder(folder)
                return
            self._go_doc(folder, rel, pi or 0, q if kind == "text" else None)

        job = [None]
        var.trace_add("write", lambda *a: (job[0] and d.after_cancel(job[0]),
                                           job.__setitem__(0, d.after(180, run))))
        en.bind("<Return>", go)
        en.bind("<Down>", lambda e: (lb.move(1), "break")[1])     # 3.0: the arrows choose while you type
        en.bind("<Up>", lambda e: (lb.move(-1), "break")[1])
        lb.bind("<Return>", go)
        lb.bind("<<RowChosen>>", go)
        d.bind("<Escape>", lambda e: d.destroy())
        d.update_idletasks()
        w = 680
        x = self.root.winfo_rootx() + (self.root.winfo_width() - w) // 2
        d.geometry(f"{w}x460+{max(0, x)}+{self.root.winfo_rooty() + 70}")
        if query:
            var.set(query)
            en.icursor("end")
        else:
            run()
        en.focus_set()

