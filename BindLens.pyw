                lb.pack(side="left", padx=1)
                lb.bind("<Button-1>", lambda e, k=k: (st.__setitem__("repeat", k), paint_opts()))
        paint_opts()

        def add(_e=None):
            text = tv.get().strip()
            if not text:
                ent.focus_set()
                return
            tm = tmv.get().strip().replace(".", ":")
            if tm and not re.fullmatch(r"\d{1,2}(:\d{2})?", tm):
                tm = ""
            if tm and ":" not in tm:
                tm += ":00"
            data["notes"].append({"id": f"n{int(time.time() * 1000)}", "date": day.isoformat(), "text": text[:200],
                                  "color": st["color"], "icon": st["icon"], "repeat": st["repeat"],
                                  "time": tm.zfill(5) if tm else ""})
            tv.set("")
            tmv.set("")
            self._cal_changed(save=True)
            fill_list()
        ent.bind("<Return>", add)
        bf = tk.Frame(d, bg=T["panel"])
        bf.pack(fill="x", padx=20, pady=14)
        PillButton(bf, self, "Add", add, kind="accent").pack(side="right")
