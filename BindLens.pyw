                    lb.delete(0, "end")
                    one = next(iter(S["books"])) if S["scope"] == "books" and len(S["books"]) == 1 else None
                    docs["res"] = self._find_docs(dv.get(), limit=30, folder=one or (self.folder if S["scope"] in (
