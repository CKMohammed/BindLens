    def pin_settings(self):
        """Set, change or remove the PIN (it protects BindLens on this computer - not the files themselves)."""
        T, A = self.T, self.accent
        cur = pin_load()
        d = self._dialog("PIN")
        d.configure(padx=24, pady=18)
        tk.Label(d, text="Lock BindLens with a PIN", font=self.F(14, "bold"), bg=T["panel"], fg=T["text"]).pack(
            anchor="w")
        tk.Label(d, text="The PIN is asked when BindLens opens and after the resting screen. It protects BindLens "
                         "on this computer - your files can still be opened in Explorer or other programs "
                         "(Windows + L locks the whole computer). A BindLens zip you share carries no PIN.",
                 font=self.F(9), bg=T["panel"], fg=T["muted"], wraplength=420, justify="left").pack(anchor="w",
                                                                                                    pady=(4, 10))
        vals = {}

        def field(lab, key):
            tk.Label(d, text=lab, font=self.F(9), bg=T["panel"], fg=T["text"]).pack(anchor="w", pady=(6, 2))
            v = tk.StringVar()
            mx = 8 if key == "old" else 4
            vc = (d.register(lambda P, mx=mx: P == "" or (P.isdigit() and len(P) <= mx)), "%P")
            e = ttk.Entry(d, textvariable=v, show="•", width=16, validate="key", validatecommand=vc)
            e.pack(anchor="w")
            vals[key] = v
            return e
        first = field("Your PIN now", "old") if cur else None
        e1 = field("New PIN (4 digits)" if cur else "PIN (4 digits)", "new")
        field("The new PIN again" if cur else "The PIN again", "new2")
        msg = tk.Label(d, text="", font=self.F(9), bg=T["panel"], fg="#B3261E", wraplength=420, justify="left")
        msg.pack(anchor="w", pady=(8, 0))
        bb = tk.Frame(d, bg=T["panel"])
        bb.pack(fill="x", pady=(12, 0))

        def check_old():
            if not cur:
                return True
            if pin_hash(vals["old"].get().strip(), cur["salt"]) == cur["hash"]:
                return True
            msg.configure(text="That is not the PIN now.")
            return False

        def save():
            if not check_old():
                return
            p1, p2 = vals["new"].get().strip(), vals["new2"].get().strip()
            if not re.fullmatch(r"\d{4}", p1):
                msg.configure(text="Use 4 digits.")
                return
            if p1 != p2:
                msg.configure(text="The two PINs are not the same.")
                return
            import secrets
            salt = secrets.token_hex(16)
            code = "-".join(secrets.token_hex(2).upper() for _ in range(3))
            rsalt = secrets.token_hex(16)
            pin_save({"salt": salt, "hash": pin_hash(p1, salt), "rsalt": rsalt, "n": len(p1),
                      "rhash": pin_hash(code.replace("-", ""), rsalt), "fails": 0, "until": 0})
            d.destroy()
            messagebox.showinfo(APP_NAME, f"The PIN is set.\n\nIf you ever forget it, this code opens BindLens "
                                          f"(write it down and keep it somewhere safe):\n\n      {code}\n\n"
                                          "It is shown only now.")

        def remove():
            if not check_old():
                return
            pin_save(None)
            d.destroy()
            self._toast("The PIN is removed - BindLens opens without it.")
        PillButton(bb, self, "Save the PIN", save, kind="accent", bg_key="panel").pack(side="right")
        if cur:
            PillButton(bb, self, "Remove the PIN", remove, bg_key="panel").pack(side="right", padx=(0, 8))
        PillButton(bb, self, "Cancel", d.destroy, bg_key="panel").pack(side="left")
        (first or e1).focus_set()
        d.bind("<Return>", lambda e: save())
        d.bind("<Escape>", lambda e: d.destroy())
        self._center(d)

    def lock_now(self):
        if not pin_load():
            if messagebox.askyesno(APP_NAME, "There is no PIN yet. Set one now?"):
                self.pin_settings()
            return
        self._lock_show()

    # ---- 4.4.4: the lock screen - a paper file with a leather strap, locked by a brass combination padlock -------
    LOCK_BLOBS = (((103, 94, 244), 0.31, 1.13, 0.0, 0.83, 1.7), ((255, 120, 190), 0.29, 0.91, 2.1, 1.27, 0.4),
                  ((255, 196, 58), 0.24, 1.41, 4.0, 0.67, 2.9), ((40, 120, 255), 0.30, 0.73, 1.0, 1.05, 5.1),
                  ((234, 54, 143), 0.22, 1.21, 3.3, 1.49, 3.6))
    LOCK_NUMPAD = {"KP_Insert": "0", "KP_End": "1", "KP_Down": "2", "KP_Next": "3", "KP_Left": "4", "KP_Begin": "5",
                   "KP_Right": "6", "KP_Home": "7", "KP_Up": "8", "KP_Prior": "9"}

    def _lock_bg_ppm(self, W, H, t, gw=46):
        """The moving colours behind the PIN: the logo's violet, pink, gold and a blue glide over a deep midnight,
        with a band of gold light sweeping across. Worked out on a small grid, smoothed by PyMuPDF (half size)."""
        gh = max(14, int(round(gw * H / float(max(1, W)))))
        ex, sn, cs = math.exp, math.sin, math.cos
        blobs = []
        for col, r, fx, px, fy, py in self.LOCK_BLOBS:
            cx = 0.5 + 0.44 * sn(t * fx + px) + 0.08 * sn(t * 2.3 * fy + px)
            cy = 0.5 + 0.40 * cs(t * fy + py)
            blobs.append((col, cx, cy, 1.0 / (r * r)))
        band = (t * 0.23) % 1.6 - 0.3
        out = bytearray(gw * gh * 3)
        i = 0
        aspect = H / float(max(1, W))
        for yy in range(gh):
            v = yy / float(gh - 1)
            br, bg_, bb = 12 + 20 * v, 12 + 4 * v, 40 + 44 * v
            for xx in range(gw):
                u = xx / float(gw - 1)
                r_, g_, b_ = br, bg_, bb
                for col, cx, cy, k in blobs:
                    dx, dy = u - cx, (v - cy) * aspect
                    w_ = ex(-(dx * dx + dy * dy) * k) * 0.86
                    r_ += (col[0] - r_) * w_
                    g_ += (col[1] - g_) * w_
                    b_ += (col[2] - b_) * w_
                d_ = (u * 0.8 + v * 0.45) * 0.8 - band
                w_ = ex(-d_ * d_ * 90.0) * 0.30
                r_ += (255 - r_) * w_
                g_ += (214 - g_) * w_
                b_ += (120 - b_) * w_
                out[i] = int(r_)
                out[i + 1] = int(g_)
                out[i + 2] = int(b_)
                i += 3
        f = self.fitz
        pix = f.Pixmap(f.csRGB, gw, gh, bytes(out), False)
        pix = f.Pixmap(pix, max(2, W // 2), max(2, H // 2), None)
        return pix.tobytes("ppm")

    def _lock_show(self):
        """4.4.4: the lock screen. A paper file - the BindLens logo on its tab, your papers inside - with a leather
        strap held by a brass combination padlock. Each digit you type turns a wheel of the padlock; the right PIN
        springs the shackle, the padlock drops, the file opens and BindLens appears. The keys are like an old
        typewriter's. Type on the keyboard (also the number pad) or click the keys.
        Made never to get stuck: the moving colours slow down by themselves when the computer is slow (they never
        take more than about a fifth of the time), the PIN is checked in the background, BindLens opens at most a
        second after the right PIN whatever happens, and no other window can come over the PIN or take its keys."""
        if getattr(self, "_lock", None) is not None:
            return
        cur = pin_load()
        if not cur:
            return
        ov = tk.Frame(self.root, bg="#120F2E")
        self._lock = ov
        self._lock_place()
        ov.lift()
        self.__dict__.setdefault("_after_unlock", [])
        c = tk.Canvas(ov, bg="#120F2E", highlightthickness=0, bd=0)
        c.pack(fill="both", expand=True)
        now0 = time.time()
        st = {"v": "", "code": False, "t": random.random() * 50, "W": 0, "H": 0, "s": 1.0, "roll": {},
              "shake": None, "open": None, "hover": None, "pages": [], "clock": "", "job": None, "frame": 0,
              "bg_next": 0.0, "bg_cost": 0.0, "hidden": [], "tok": 0, "res": None, "busy": False, "applied": {},
              "safety": now0, "down": None}
        code_v = tk.StringVar()
        code_en = tk.Entry(ov, textvariable=code_v, font=self.F(14), width=18, justify="center", relief="flat",
                           bd=0, highlightthickness=2, highlightcolor="#B8862A", highlightbackground="#8A6A35",
                           bg="#FFFDF5", fg="#2A2233", insertbackground="#2A2233")
        rnd = random.Random()
        for _ in range(12):
            st["pages"].append([rnd.random(), rnd.random(), rnd.uniform(0.6, 1.4), rnd.uniform(0, 6.28),
                                rnd.uniform(-0.9, 0.9), rnd.uniform(0.05, 0.11), rnd.random() < 0.3])
        try:
            fams = set(tkfont.families(self.root))
        except Exception:
            fams = set()
        serif = next((f_ for f_ in ("Georgia", "Cambria", "Times New Roman") if f_ in fams), self.family)
        try:
            logo_name = self.lib.settings.get("icon") if self.lib.settings.get("icon") in LOGO_COLORS else "Black"
        except Exception:
            logo_name = "Black"
        imgs = st["imgs"] = {}

        def n_wheels():
            return max(int(cur.get("n", 4)), min(8, len(st["v"])))

        def S(v):
            return v * st["s"]

        def font(sz, w="normal", fam=None):
            sz = max(8, int(round(sz * st["s"])))
            return (fam or self.family, sz, w) if w != "normal" else (fam or self.family, sz)

        def grad(x0, y0, x1, y1, c0, c1, n, tags):
            """A colour that changes from top to bottom (thin bands)."""
            h = (y1 - y0) / float(n)
            for k in range(n):
                c.create_rectangle(x0, y0 + k * h, x1, y0 + (k + 1) * h + 1, outline="", tags=tags,
                                   fill=mix(c0, c1, k / float(max(1, n - 1))))

        # ---- the drawing (everything again when the size changes; the moving parts are only moved)
        def layout():
            self._lock_place()
            W, H = max(200, c.winfo_width()), max(200, c.winfo_height())
            st["W"], st["H"] = W, H
            s = st["s"] = max(0.6, min(1.25, W / 1080.0, H / 680.0))
            c.delete("all")
            st["bgsmall"] = st["bgbig"] = None
            st["bg_next"] = 0.0
            st["applied"] = {}
            c.create_image(0, 0, anchor="nw", tags=("bg",))
            for i in range(len(st["pages"])):
                c.create_polygon(0, 0, 0, 0, 0, 0, fill="", outline="#FFFFFF", width=1, tags=("page", f"pg{i}"))
            FW, FH = S(380), S(256)
            kr, kg = S(31), S(16)
            KW, KH = 6 * kr + 2 * kg, 8 * kr + 3 * kg
            wide = W >= FW + S(90) + KW + 60
            if wide:
                gx = (W - (FW + S(90) + KW)) / 2.0
                fx, fy = gx, H / 2.0 - FH / 2.0 + S(14)
                kx, ky = gx + FW + S(90), H / 2.0 - KH / 2.0 + S(2)
            else:
                k_ = 0.78
                kr, kg = kr * k_, kg * k_
                KW, KH = 6 * kr + 2 * kg, 8 * kr + 3 * kg
                fx, fy = (W - FW) / 2.0, S(100)
                kx, ky = (W - KW) / 2.0, fy + FH + S(70)
            st["geo"] = (fx, fy, FW, FH, kx, ky, kr, kg)
            draw_file(fx, fy, FW, FH)
            draw_keys(kx, ky, kr, kg)
            cy_ = S(52) if wide else S(38)
            c.create_text(W / 2.0, cy_, text="", fill="#FFFFFF", font=font(26, "bold"), tags=("clock",))
            c.create_text(W / 2.0, cy_ + S(30), text=time.strftime("%A %d %B").replace(" 0", " "),
                          fill="#E9E4FF", font=font(10), tags=("date",))
            st["clock"] = ""
            if st["code"]:
                code_mode(True)
            draw_wheels()
            pages_frame()

        def draw_file(fx, fy, FW, FH):
            ink, edge = "#4A3517", "#7E5E2C"
            tg = ("file",)
            # a soft shadow under the file
            for k_, col in ((12, "#0B0920"), (8, "#120F2E"), (4, "#1A1640")):
                self._round_rect(c, fx + S(k_) * 0.6, fy + S(k_) * 0.5, fx + FW + S(k_) * 0.6, fy + FH + S(k_),
                                 S(12), fill=col, outline="", tags=tg + ("shadow",))
            # the back of the file and its tab - with the logo on it
            tab = (fx + S(20), fx + S(132))
            c.create_polygon(tab[0], fy + S(2), tab[0] + S(14), fy - S(34), tab[1] - S(14), fy - S(34), tab[1],
                             fy + S(2), fill="#C99A55", outline=edge, tags=tg + ("back",))
            self._round_rect(c, fx, fy, fx + FW, fy + FH, S(10), fill="#C99A55", outline=edge, tags=tg + ("back",))
            grad(fx + 2, fy + 2, fx + FW - 2, fy + S(40), "#D3A862", "#C99A55", 6, tg + ("back",))
            ls = max(16, int(S(28)))
            try:
                key = ("logo", logo_name, ls)
                if key not in imgs:
                    imgs[key] = tk.PhotoImage(data=logo_icon_data(logo_name, ls))
                c.create_image((tab[0] + tab[1]) / 2.0, fy - S(15), image=imgs[key], tags=tg)
            except Exception as ex:
                _log(f"lock logo: {ex}")
            # the papers inside, and the pink ribbon of the logo
            c.create_polygon(fx + S(22), fy + S(16), fx + FW - S(12), fy + S(8), fx + FW - S(8), fy + FH - S(14),
                             fx + S(26), fy + FH - S(6), fill="#F1ECE1", outline="#CFC6B3", tags=tg + ("papers",))
            c.create_rectangle(fx + S(14), fy + S(14), fx + FW - S(16), fy + FH - S(8), fill="#FFFDF7",
                               outline="#D8D0BE", tags=tg + ("papers",))
            c.create_line(fx + S(34), fy + S(27), fx + S(150), fy + S(27), fill="#6C63FF", width=max(2, int(S(4))),
                          tags=tg + ("papers",))
            j, y_ = 0, fy + S(40)
            while y_ < fy + FH - S(26):
                c.create_line(fx + S(34), y_, fx + FW - S((110, 60, 80, 70, 130)[j % 5]), y_, fill="#B9B4C8",
                              width=max(1, int(S(2))), tags=tg + ("papers",))
                j += 1
                y_ += S(11) if j % 6 else S(20)
            c.create_polygon(fx + FW - S(66), fy - S(12), fx + FW - S(46), fy - S(12), fx + FW - S(46),
                             fy + S(46), fx + FW - S(56), fy + S(38), fx + FW - S(66), fy + S(46), fill="#FF85C2",
                             outline="#E0559E", tags=tg + ("papers",))
            # the front cover: manila card, lighter at the top, a fold near the bottom, a little paper grain
            top = fy + S(50)
            st["cover0"] = [fx, top, fx + FW, top, fx + FW, fy + FH, fx, fy + FH]
            c.create_polygon(*st["cover0"], fill="#E6BF7A", outline=edge, tags=tg + ("cover",))
            grad(fx + 1, top + 1, fx + FW - 1, fy + FH - 1, "#EFCF92", "#DDB067", 12, tg + ("covers",))
            c.create_line(fx, top, fx + FW, top, fill="#F7E3B8", width=max(1, int(S(2))), tags=tg + ("covers",))
            c.create_line(fx, top, fx + FW, top, fill=edge, tags=tg + ("covers",))
            c.create_line(fx, top, fx, fy + FH, fx + FW, fy + FH, fx + FW, top, fill=edge, tags=tg + ("covers",))
            for yy in (fy + FH - S(18), fy + FH - S(13)):
                c.create_line(fx + S(8), yy, fx + FW - S(8), yy, fill="#CFA25C", tags=tg + ("covers",))
            gr = random.Random(7)
            for _ in range(70):
                x_, y_ = fx + gr.uniform(6, FW - 6), gr.uniform(top + 4, fy + FH - 6)
                c.create_line(x_, y_, x_ + S(gr.uniform(2, 5)), y_, fill="#D9AE69", tags=tg + ("covers",))
            # the leather strap over the file, stitched, ending in a steel hasp
            sx = fx + FW / 2.0
            sw = S(40)
            s0, s1 = fy - S(6), top + S(70)
            c.create_rectangle(sx - sw / 2, s0, sx + sw / 2, s1, fill="#6B4222", outline="#3E2410",
                               tags=tg + ("covers", "strap"))
            c.create_rectangle(sx - sw / 2 + S(3), s0, sx - sw / 2 + S(9), s1, fill="#7D5130", outline="",
                               tags=tg + ("covers", "strap"))
            for dx_ in (-sw / 2 + S(5), sw / 2 - S(5)):
                c.create_line(sx + dx_, s0 + S(4), sx + dx_, s1 - S(4), fill="#E8CFA0", dash=(4, 3),
                              tags=tg + ("covers", "strap"))
            hy = s1 - S(6)
            self._round_rect(c, sx - S(26), hy - S(8), sx + S(26), hy + S(20), S(5), fill="#A9AEB8",
                             outline="#5D626C", tags=tg + ("covers", "hasp"))
            c.create_line(sx - S(22), hy - S(5), sx + S(22), hy - S(5), fill="#E9ECF2", tags=tg + ("covers", "hasp"))
            for dx_ in (-S(18), S(18)):
                c.create_oval(sx + dx_ - S(3), hy + S(6) - S(3), sx + dx_ + S(3), hy + S(6) + S(3), fill="#7D828E",
                              outline="#4D525C", tags=tg + ("covers", "hasp"))
            # the padlock: a steel shackle through the hasp, a brass body with the wheels
            n = n_wheels()
            ww, wg = S(26), S(6)
            BW = n * ww + (n - 1) * wg + S(40)
            BH = S(104)
            bx0, by0 = sx - BW / 2.0, hy + S(26)
            R = S(30)
            scy = by0 - S(4)
            for wdt, col, dr in ((S(13), "#5D626C", 0), (S(9), "#B7BCC6", 0), (S(3), "#EEF1F6", -S(2))):
                c.create_arc(sx - R + dr, scy - R - S(40) + dr, sx + R - dr, scy + R - S(40) - dr, start=0,
                             extent=180, style="arc", width=wdt, outline=col, tags=tg + ("covers", "shackle"))
                for lx in (sx - R + dr, sx + R - dr):
                    c.create_line(lx, scy - S(40), lx, scy + S(4), width=wdt, fill=col,
                                  tags=tg + ("covers", "shackle"))
            c.create_rectangle(sx - R - S(8), hy + S(4), sx - R + S(8), hy + S(14), fill="#A9AEB8",
                               outline="#5D626C", tags=tg + ("covers", "hasp"))        # the staple in front
            self._round_rect(c, bx0 + S(3), by0 + S(5), bx0 + BW + S(3), by0 + BH + S(5), S(14), fill="#5A3F0B",
                             outline="", tags=tg + ("covers", "padlock"))
            self._round_rect(c, bx0, by0, bx0 + BW, by0 + BH, S(14), fill="#D9A632", outline="#8A6410",
                             tags=tg + ("covers", "padlock"))
            grad(bx0 + S(6), by0 + S(4), bx0 + BW - S(6), by0 + BH - S(6), "#F6D57A", "#B88418", 14,
                 tg + ("covers", "padlock"))
            c.create_line(bx0 + S(10), by0 + S(5), bx0 + BW - S(10), by0 + S(5), fill="#FFF0BF",
                          width=max(1, int(S(2))), tags=tg + ("covers", "padlock"))
            c.create_line(bx0 + S(4), by0 + S(14), bx0 + S(4), by0 + BH - S(14), fill="#F1CF73",
                          tags=tg + ("covers", "padlock"))
            st["wheels"] = []
            wy = by0 + S(22)
            for i in range(n):
                x_ = bx0 + S(20) + i * (ww + wg)
                c.create_rectangle(x_ - 1, wy - 1, x_ + ww + 1, wy + S(48) + 1, fill="#7A5609", outline="",
                                   tags=tg + ("covers", "padlock"))
                c.create_rectangle(x_, wy, x_ + ww, wy + S(48), fill="#2A2238", outline="#120E1C",
                                   tags=tg + ("covers", "padlock", "slot", f"slot{i}"))
                for k_ in range(5):                               # the ridges of a wheel
                    yy = wy + S(3) + k_ * S(2)
                    c.create_line(x_ + 2, yy, x_ + ww - 2, yy, fill="#3E3452", tags=tg + ("covers", "padlock",
                                                                                           "slotsh"))
                    yy = wy + S(45) - k_ * S(2)
                    c.create_line(x_ + 2, yy, x_ + ww - 2, yy, fill="#3E3452", tags=tg + ("covers", "padlock",
                                                                                           "slotsh"))
                t_ = c.create_text(x_ + ww / 2.0, wy + S(24), text="", font=font(17, "bold", serif),
                                   fill="#FFE6A0", tags=tg + ("covers", "padlock", "wheel"))
                r_ = S(5.5)                                       # a set wheel: a gold dot (any font)
                c.create_oval(x_ + ww / 2.0 - r_, wy + S(24) - r_, x_ + ww / 2.0 + r_, wy + S(24) + r_,
                              fill="#FFD36B", outline="#FFF0BF", state="hidden",
                              tags=tg + ("covers", "padlock", f"dot{i}"))
                st["wheels"].append(t_)
            c.create_polygon(bx0 + BW / 2.0 - S(6), wy + S(54), bx0 + BW / 2.0 + S(6), wy + S(54), bx0 + BW / 2.0,
                             wy + S(62), fill="#7A5609", outline="", tags=tg + ("covers", "padlock"))
            st["padlock_y"] = by0 + BH
            # under the file: what to do, and what happened
            c.create_text(fx + FW / 2.0, fy + FH + S(28), text="Type your PIN", font=font(11, "bold"),
                          fill="#FFFFFF", tags=("hint",))
            c.create_text(fx + FW / 2.0, fy + FH + S(50), text="", font=font(10, "bold"), fill="#FFD1E0",
                          tags=("msg",))

        def draw_keys(kx, ky, kr, kg):
            """Keys like an old typewriter's: a brass ring, a cream face, the digit in ink."""
            st["keys"] = []
            rows = (("1", "2", "3"), ("4", "5", "6"), ("7", "8", "9"), ("back", "0", "ok"))
            for r_, row in enumerate(rows):
                for c_, k_ in enumerate(row):
                    cx = kx + kr + c_ * (2 * kr + kg)
                    cy = ky + kr + r_ * (2 * kr + kg)
                    tg = ("key", f"key_{k_}")
                    c.create_oval(cx - kr + 2, cy - kr + 5, cx + kr + 2, cy + kr + 5, fill="#0B0920", outline="",
                                  tags=tg)
                    c.create_oval(cx - kr, cy - kr, cx + kr, cy + kr, fill="#B8862A", outline="#6E4F12", width=1,
                                  tags=tg + ("ring", f"ring_{k_}"))
                    c.create_oval(cx - kr + 3, cy - kr + 2, cx + kr - 3, cy + kr - 5, fill="#F2CE6E", outline="",
                                  tags=tg)
                    fi_ = kr * 0.72
                    c.create_oval(cx - fi_, cy - fi_, cx + fi_, cy + fi_, fill="#F7F1E3", outline="#D9CFB8",
                                  width=2, tags=tg + ("face", f"face_{k_}"))
                    lab = {"back": "⌫", "ok": "OK"}.get(k_, k_)
                    if k_ == "back":
                        lab = "Del"
                    c.create_text(cx, cy, text=lab, fill="#2A2233",
                                  font=font(19 if len(lab) == 1 else 11, "bold", serif if len(lab) == 1 else None),
                                  tags=tg + (f"lab_{k_}",))
                    st["keys"].append((cx, cy, kr, k_))
            c.create_text(kx + (6 * kr + 2 * kg) / 2.0, ky + 8 * kr + 3 * kg + S(28),
                          text="Forgot it? Use the code you wrote down", fill="#FFE6A0", font=font(9),
                          tags=("forgot",))

        def press_key(k_, down):
            try:
                d_ = 2 if down else -2
                c.move(f"face_{k_}", 0, d_)
                c.move(f"lab_{k_}", 0, d_)
                c.itemconfigure(f"face_{k_}", fill="#E9DFC6" if down else "#F7F1E3")
            except Exception:
                pass

        def draw_wheels():
            for i, t_ in enumerate(st.get("wheels", [])):
                if i in st["roll"]:
                    c.itemconfigure(f"dot{i}", state="hidden")
                    continue
                on_ = i < len(st["v"])
                c.itemconfigure(t_, text="" if on_ else "-", fill="#8C7A4A")
                c.itemconfigure(f"dot{i}", state="normal" if on_ else "hidden")

        def code_mode(on):
            c.delete("codewin")
            if on:
                c.itemconfigure("key", state="hidden")
                fx, fy, FW, FH = st["geo"][:4]
                c.create_window(fx + FW / 2.0, fy + FH + S(78), window=code_en, tags=("codewin",))
                c.itemconfigure("hint", text="Type the code you wrote down (like 1A2B-3C4D-5E6F), then Enter")
                c.itemconfigure("forgot", text="")
                say("Then you choose a new PIN.", "#FFE6A0")

        # ---- the moving parts
        def bg_frame(force=False):
            W, H = st["W"], st["H"]
            if W < 50:
                return
            try:
                data = self._lock_bg_ppm(W, H, st["t"], gw=40 if W * H > 2000000 else 46)
                small, big = st.get("bgsmall"), st.get("bgbig")
                if small is None or force:
                    small = st["bgsmall"] = tk.PhotoImage(data=data)
                    big = st["bgbig"] = small.zoom(2, 2)
                    c.itemconfigure("bg", image=big)
                else:
                    small.configure(data=data)
                    big.tk.call(big.name, "copy", small.name, "-zoom", 2, 2)
            except Exception as ex:
                _log(f"lock background: {ex}")

        def pages_frame():
            W, H = st["W"], st["H"]
            for i, p in enumerate(st["pages"]):
                x, y, sz, ang, va, vy, gold = p
                w_, h_ = 34 * sz * st["s"], 44 * sz * st["s"]
                X = x * W + 24 * math.sin(st["t"] * 0.9 + i)
                Y = y * (H + 120) - 60
                ca, sa = math.cos(ang), math.sin(ang)
                pts = []
                for px_, py_ in ((-w_ / 2, -h_ / 2), (w_ / 2, -h_ / 2), (w_ / 2, h_ / 2), (-w_ / 2, h_ / 2)):
                    pts += [X + px_ * ca - py_ * sa, Y + px_ * sa + py_ * ca]
                c.coords(f"pg{i}", *pts)
                if gold:
                    c.itemconfigure(f"pg{i}", outline="#FFD36B")

        def move_to(tag, key, dx, dy):
            """Move a part to where it should be now (it is moved by what is missing - smooth when slow)."""
            ax, ay = st["applied"].get(key, (0.0, 0.0))
            if dx != ax or dy != ay:
                c.move(tag, dx - ax, dy - ay)
                st["applied"][key] = (dx, dy)

        def safety(now):
            """Every second: nothing over the PIN, no other window holding the mouse or the keys."""
            st["safety"] = now
            try:
                ov.lift()
            except Exception:
                pass
            try:
                g_ = self.root.grab_current()
                if g_ is not None and str(g_) != str(ov):
                    g_.grab_release()
            except Exception:
                pass
            try:
                for w_ in self.root.winfo_children():
                    if isinstance(w_, tk.Toplevel) and w_.winfo_ismapped() and w_ not in st["hidden"]:
                        w_.withdraw()                    # (shown again when the PIN is right)
                        st["hidden"].append(w_)
            except Exception:
                pass
            try:
                fw_ = self.root.focus_get()
                if fw_ is not None and fw_ not in (catcher, code_en):
                    (code_en if st["code"] else catcher).focus_set()
            except Exception:
                pass

        def tick(now):
            try:
                fast = self._fast()
                iconic = self.root.state() == "iconic"
            except Exception:
                fast, iconic = False, False
            st["frame"] += 1
            if now - st["safety"] > 1.0:
                safety(now)
            # the moving colours: as smooth as the computer allows, never more than about a fifth of the time
            if not iconic and now >= st["bg_next"]:
                t0 = time.time()
                bg_frame(force=st.get("bgsmall") is None)
                cost = time.time() - t0
                st["bg_cost"] = cost if not st["bg_cost"] else st["bg_cost"] * 0.7 + cost * 0.3
                base = 2.5 if fast else (0.09 if st["W"] * st["H"] < 1600000 else 0.16)
                gap = max(base, st["bg_cost"] * 5.0)
                st["bg_next"] = now + gap
                st["t"] += (0.05 if fast else 1.15) * gap
            if not iconic and not fast:
                for p in st["pages"]:
                    p[1] -= p[5] * 0.04
                    p[3] += p[4] * 0.04
                    if p[1] < -0.05:
                        p[1], p[0] = 1.05, random.random()
                pages_frame()
            hm = time.strftime("%H:%M")
            if hm != st["clock"]:
                st["clock"] = hm
                c.itemconfigure("clock", text=hm)
            # the PIN, checked in the background
            if st["res"] is not None:
                ok, st["res"] = st["res"], None
                st["busy"] = False
                answer(ok)
            # a wheel that turns
            for i in list(st["roll"]):
                if now >= st["roll"][i]:
                    del st["roll"][i]
                    draw_wheels()
                elif i < len(st.get("wheels", [])):
                    c.itemconfigure(f"dot{i}", state="hidden")
                    c.itemconfigure(st["wheels"][i], text=str(random.randint(0, 9)), fill="#9C8A55")
            # a wrong PIN: the file shakes
            if st["shake"] is not None:
                q = (now - st["shake"]) / 0.45
                if q >= 1:
                    move_to("file", "shake", 0, 0)
                    st["shake"] = None
                else:
                    move_to("file", "shake", S(16) * math.sin(q * 26) * (1 - q), 0)
            # the right PIN: the shackle springs, the padlock drops, the file opens and comes to you
            if st["open"] is not None:
                p = (now - st["open"]) / 1.0
                fx, fy, FW, FH = st["geo"][:4]

                def ph(a, b):
                    return max(0.0, min(1.0, (p - a) / (b - a)))
                e1 = ph(0.08, 0.28)
                move_to("shackle", "sh", 0, -S(18) * (e1 * (2 - e1)))
                e2 = ph(0.30, 0.55)
                if e2 > 0:
                    move_to("padlock", "pl", 0, S(160) * e2 * e2)
                    move_to("shackle", "sh2", 0, S(160) * e2 * e2)
                if e2 >= 1:
                    c.itemconfigure("covers", state="hidden")
                e3 = ph(0.55, 0.82)
                if e3 > 0:
                    e3 = e3 * e3 * (3 - 2 * e3)
                    x0, t0_, x1, _t, _x, b0, _x2, _b = st["cover0"]
                    lift = S(36)
                    c.coords("cover", x0 - lift * e3, t0_ + (b0 - t0_ + S(30)) * e3, x1 + lift * e3,
                             t0_ + (b0 - t0_ + S(30)) * e3, x1, b0, x0, b0)
                    move_to("papers", "pp", 0, -S(24) * e3)
                e4 = ph(0.78, 1.0)
                if e4 > 0:
                    c.itemconfigure("key", state="hidden")
                    c.itemconfigure("forgot", state="hidden")
                    k_ = (1.0 + 0.5 * e4) / st.get("zoomed", 1.0)
                    st["zoomed"] = 1.0 + 0.5 * e4
                    c.scale("file", fx + FW / 2.0, fy + FH / 2.0, k_, k_)
                if p >= 1.0:
                    finish_open()
                    return False
            return True

        def step():
            st["job"] = None
            if getattr(self, "_lock", None) is not ov:
                return
            go_on = True
            try:
                go_on = tick(time.time())
            except Exception as ex:
                _log(f"lock: {ex}")
            if go_on and getattr(self, "_lock", None) is ov:
                busy = st["roll"] or st["shake"] is not None or st["open"] is not None or st["busy"]
                try:
                    iconic = self.root.state() == "iconic"
                except Exception:
                    iconic = False
                st["job"] = self.root.after(400 if iconic else (25 if busy else 45), step)

        def finish_open():
            if getattr(self, "_lock", None) is not ov:
                return
            was_code = st["code"]
            self._lock_hide()
            if was_code:
                self.root.after(300, self.pin_settings)

        # ---- the PIN
        def say(text, col="#FFD1E0"):
            c.itemconfigure("msg", text=text, fill=col)

        def check():
            st["tok"] += 1
            if st["open"] is not None or st["busy"]:
                return
            if not st["code"] and len(st["v"]) < 4:
                return
            d = pin_load() or {}
            now = time.time()
            if now < float(d.get("until", 0)):
                say(f"Too many tries - wait {int(float(d['until']) - now) + 1} seconds.")
                st["v"] = ""
                draw_wheels()
                return
            if st["code"]:
                val, salt, want = code_v.get().strip().replace("-", "").upper(), d.get("rsalt", "00"), d.get("rhash")
            else:
                val, salt, want = st["v"], d.get("salt", "00"), d.get("hash")
            st["busy"] = True
            say("")

            def work():                                  # (the PIN takes a moment to check - not in the window)
                try:
                    st["res"] = bool(want) and pin_hash(val, salt) == want
                except Exception:
                    st["res"] = False
            threading.Thread(target=work, daemon=True).start()

        def answer(ok):
            d = pin_load() or {}
            now = time.time()
            if ok:
                d["fails"], d["until"] = 0, 0
                pin_save(d)
                st["roll"] = {}
                st["v"] = "*" * len(st.get("wheels", []))
                draw_wheels()
                c.itemconfigure("slot", fill="#F2C45A")
                for i_ in range(len(st.get("wheels", []))):
                    c.itemconfigure(f"dot{i_}", fill="#3B2A05", outline="#3B2A05")
                c.itemconfigure("hint", text="Welcome back")
                st["open"] = time.time()
                self.root.after(1600, finish_open)       # whatever happens: open within a second and a half
                return
            d["fails"] = int(d.get("fails", 0)) + 1
            if d["fails"] >= 5:
                d["until"], d["fails"] = now + 60, 0
                say("5 wrong tries - wait a minute.")
            else:
                say("Not right - try again.")
            pin_save(d)
            st["v"] = ""
            code_v.set("")
            st["shake"] = time.time()
            for i in range(len(st.get("wheels", []))):
                st["roll"][i] = time.time() + 0.25 + 0.08 * i

        def key(ch):
            if st["code"] or st["open"] is not None or st["busy"]:
                return
            if ch == "back":
                st["v"] = st["v"][:-1]
            elif ch == "ok":
                if len(st["v"]) >= 4:
                    check()
                return
            elif ch.isdigit() and len(st["v"]) < 8:
                st["v"] += ch
                say("")
                if len(st["v"]) > len(st.get("wheels", [])):
                    layout()
                else:
                    st["roll"][len(st["v"]) - 1] = time.time() + 0.18
            draw_wheels()
            if ch.isdigit():
                press_key(ch, True)
                self.root.after(110, lambda: press_key(ch, False))
            if "n" in cur and len(st["v"]) == int(cur["n"]):  # all the digits: it opens by itself
                st["tok"] += 1
                tok = st["tok"]
                self.root.after(160, lambda: check() if st["tok"] == tok and len(st["v"]) == int(cur["n"]) else None)

        def use_code():
            st["code"] = True
            code_mode(True)
            code_en.focus_set()

        # ---- the mouse: the keys and "Forgot it?"
        def hit_key(x, y):
            for cx, cy, kr, k_ in st.get("keys", []):
                if (x - cx) ** 2 + (y - cy) ** 2 <= kr * kr:
                    return k_
            return None

        def on_forgot(x, y):
            return any("forgot" in c.gettags(i) for i in c.find_overlapping(x - 2, y - 2, x + 2, y + 2))

        def set_hover(k_):
            if k_ == st["hover"]:
                return
            if st["hover"]:
                c.itemconfigure(f"ring_{st['hover']}", fill="#B8862A")
            st["hover"] = k_
            if k_:
                c.itemconfigure(f"ring_{k_}", fill="#FFC83D")

        def on_motion(e):
            k_ = None if st["code"] else hit_key(e.x, e.y)
            set_hover(k_)
            c.configure(cursor="hand2" if (k_ or (not st["code"] and on_forgot(e.x, e.y))) else "")

        def on_press(e):
            try:
                (code_en if st["code"] else catcher).focus_force()
            except Exception:
                pass
            k_ = None if st["code"] else hit_key(e.x, e.y)
            if k_:
                if k_ in ("back", "ok"):
                    press_key(k_, True)
                    self.root.after(110, lambda: press_key(k_, False))
                key(k_)
                return
            if not st["code"] and on_forgot(e.x, e.y):
                use_code()

        c.bind("<Configure>", lambda e: layout() if (e.width, e.height) != (st["W"], st["H"]) else None)
        c.bind("<Motion>", on_motion)
        c.bind("<ButtonPress-1>", on_press)
        c.bind("<Leave>", lambda e: set_hover(None))
        code_en.bind("<Return>", lambda e: (check(), "break")[1])
        code_en.bind("<KP_Enter>", lambda e: (check(), "break")[1])

        def on_key(e):
            if st["code"]:
                return None
            ks = e.keysym
            ch = e.char if (e.char and e.char.isdigit()) else \
                (ks[3:] if ks.startswith("KP_") and ks[3:].isdigit() else self.LOCK_NUMPAD.get(ks, ""))
            if ks in ("BackSpace", "Delete", "KP_Delete"):
                key("back")
            elif ks in ("Return", "KP_Enter"):
                key("ok")
            elif ch:
                key(ch)
            return "break"
        catcher = tk.Entry(ov, width=1, bd=0, highlightthickness=0, bg="#120F2E", fg="#120F2E",
                           insertbackground="#120F2E", relief="flat")
        catcher.place(x=0, y=0, width=1, height=1)          # takes the keys - nothing else gets them
        catcher.bind("<Key>", on_key)

        def root_key(e):                                     # whatever has the focus in BindLens: keys to the PIN
            if getattr(self, "_lock", None) is not ov or st["code"]:
                return None
            return on_key(e)
        self.root.bind("<Key>", root_key)
        for k in ("<Control-Key>", "<Alt-Key>", "<F1>", "<F4>", "<F5>", "<F6>", "<F9>", "<F11>", "<Escape>"):
            catcher.bind(k, lambda e: "break")
            code_en.bind(k, lambda e: "break")

        def take_focus():                                    # the window in front, the keys to the PIN
            if getattr(self, "_lock", None) is not ov:
                return
            try:
                if self.root.state() != "iconic":
                    self.root.lift()
                    self.root.focus_force()
                    (code_en if st["code"] else catcher).focus_force()
            except Exception:
                pass
        for ms_ in (60, 450, 1300, 2600):
            self.root.after(ms_, take_focus)
        self._lock_focus = catcher
        self._lock_key = key
        self._lock_st = st
        self._lock_layout = layout
        st["job"] = self.root.after(30, step)

    def _lock_place(self):
        """4.4.1: where the PIN screen sits - under BindLens's own top band on Windows (the frame and minimise /
        maximise / close stay at the very top, and the band moves the window), over the whole window otherwise."""
        ov = getattr(self, "_lock", None)
        if ov is None:
            return
        top = 0
        try:
            if self._cap_on() and self.topband.winfo_ismapped():
                top = max(self.TB_H, self.topband.winfo_height())
        except Exception:
            top = 0
        if getattr(self, "_lock_top", None) != top or not ov.winfo_ismapped():
            self._lock_top = top
            ov.place(x=0, y=top, relwidth=1.0, relheight=1.0, height=-top)
        try:
            self._topband_draw()
        except Exception:
            pass

    def _round_rect(self, c, x0, y0, x1, y1, r, **kw):
        """A rectangle with round corners on a canvas (a smooth polygon)."""
        r = max(0.0, min(r, (x1 - x0) / 2.0, (y1 - y0) / 2.0))
        pts = [x0 + r, y0, x1 - r, y0, x1, y0, x1, y0 + r, x1, y1 - r, x1, y1, x1 - r, y1, x0 + r, y1, x0, y1,
               x0, y1 - r, x0, y0 + r, x0, y0]
        return c.create_polygon(*pts, smooth=True, **kw)

    def _when_unlocked(self, fn):
        """4.4: while the PIN is asked, things that would show over it wait until it is right. True = it waits."""
        if getattr(self, "_lock", None) is None:
            return False
        lst = self.__dict__.setdefault("_after_unlock", [])
        if fn not in lst:
            lst.append(fn)
        return True

    # ---- 4.4: videos, played here -------------------------------------------------------------------------------
    def play_video(self, path):
        """Play a video inside BindLens, over the pages (the frame stays round it). Space: play / pause; ← →: ten
        seconds back / on; M: sound off / on; Esc: close. On Windows it uses Windows' own media engine; when that
        can't play the video (or not on Windows), it opens in your video player."""
        if not path or not os.path.isfile(path):
            self._toast("The video is not there any more.")
            return
        self.close_video()
        if os.name != "nt":
            open_in_os(path)
            self._toast("The video opens in your video player.")
            return
        T, A = self.T, self.accent
        ov = tk.Frame(self.root, bg="#07060F")
        try:
            top = self.topband.winfo_height() if self.topband.winfo_ismapped() else 0
        except Exception:
            top = 0
        ov.place(x=0, y=top, relwidth=1, relheight=1, height=-top)
        ov.lift()
        self._video = ov
        st = {"p": path, "mci": None, "job": None, "mute": False, "drag": False, "ended": False, "hov": None}
        self._video_st = st
        head = tk.Frame(ov, bg="#0E0C1F", height=42)
        head.pack(fill="x")
        head.pack_propagate(False)
        tk.Label(head, text=os.path.basename(path), font=self.F(10, "bold"), bg="#0E0C1F", fg="#FFFFFF").pack(
            side="left", padx=16)
        for lab, fn in (("✕  Close (Esc)", self.close_video),
                        ("Open in my video player", lambda: (self.close_video(), open_in_os(path)))):
            b_ = tk.Label(head, text=lab, font=self.F(9), bg="#0E0C1F", fg="#CFC8F2", cursor="hand2", padx=10)
            b_.pack(side="right", padx=4)
            b_.bind("<Button-1>", lambda e, fn=fn: fn())
            b_.bind("<Enter>", lambda e, w=b_: w.configure(fg="#FFC83D"))
            b_.bind("<Leave>", lambda e, w=b_: w.configure(fg="#CFC8F2"))
        bar = tk.Canvas(ov, bg="#0E0C1F", height=58, highlightthickness=0, bd=0)
        bar.pack(side="bottom", fill="x")
        screen = tk.Frame(ov, bg="#000000")
        screen.pack(fill="both", expand=True)

        def fmt(ms):
            s_ = int(ms // 1000)
            return f"{s_ // 3600}:{s_ // 60 % 60:02d}:{s_ % 60:02d}" if s_ >= 3600 else f"{s_ // 60}:{s_ % 60:02d}"

        def fit():
            m = st["mci"]
            if m is None:
                return
            W, H = max(2, screen.winfo_width()), max(2, screen.winfo_height())
            vw, vh = m.size
            k = min(W / float(max(1, vw)), H / float(max(1, vh)))
            w_, h_ = vw * k, vh * k
            try:
                m.put((W - w_) / 2, (H - h_) / 2, w_, h_)
            except Exception as ex:
                _log(f"video (size): {ex}")

        def draw():
            bar.delete("all")
            W = max(200, bar.winfo_width())
            m = st["mci"]
            playing = m is not None and m.mode() == "playing"
            pos = m.position() if m else 0
            ln = m.length if m else 0
            # play / pause
            cx, cy = 34, 29
            on = st["hov"] == "pp"
            bar.create_oval(cx - 18, cy - 18, cx + 18, cy + 18, fill="#E8467C" if not on else "#FF5C93", outline="")
            if playing:
                bar.create_rectangle(cx - 7, cy - 8, cx - 2, cy + 8, fill="#FFFFFF", outline="")
                bar.create_rectangle(cx + 2, cy - 8, cx + 7, cy + 8, fill="#FFFFFF", outline="")
            else:
                bar.create_polygon(cx - 5, cy - 9, cx + 9, cy, cx - 5, cy + 9, fill="#FFFFFF", outline="")
            # time and the line to go anywhere
            bar.create_text(66, cy, text=fmt(pos), anchor="w", font=self.F(9), fill="#FFFFFF")
            x0, x1 = 120, W - 150
            st["line"] = (x0, x1)
            bar.create_line(x0, cy, x1, cy, fill="#3A3470", width=4, capstyle="round")
            if ln:
                xx = x0 + (x1 - x0) * min(1.0, pos / float(ln))
                bar.create_line(x0, cy, xx, cy, fill="#FFC83D", width=4, capstyle="round")
                bar.create_oval(xx - 7, cy - 7, xx + 7, cy + 7, fill="#FFFFFF", outline="")
            bar.create_text(x1 + 12, cy, text=fmt(ln), anchor="w", font=self.F(9), fill="#CFC8F2")
            on = st["hov"] == "snd"
            bar.create_text(W - 24, cy, text="Sound off" if st["mute"] else "Sound on", anchor="e", font=self.F(9),
                            fill="#FFC83D" if on else "#CFC8F2")
            st["snd"] = (W - 100, W - 10)

        def tick():
            st["job"] = None
            if getattr(self, "_video", None) is not ov:
                return
            m = st["mci"]
            if m is not None and not st["drag"]:
                if m.mode() == "stopped" and m.length and m.position() >= m.length - 400:
                    st["ended"] = True
                draw()
            st["job"] = self.root.after(250, tick)

        def toggle():
            m = st["mci"]
            if m is None:
                return
            try:
                if m.mode() == "playing":
                    m.pause()
                elif st["ended"]:
                    st["ended"] = False
                    m.seek(0)
                else:
                    m.play()
            except Exception as ex:
                _log(f"video (play): {ex}")
            draw()

        def jump(ms):
            m = st["mci"]
            if m is not None:
                try:
                    m.seek(m.position() + ms, play=m.mode() == "playing")
                except Exception:
                    pass
                draw()

        def mute():
            m = st["mci"]
            st["mute"] = not st["mute"]
            if m is not None:
                m.volume(0 if st["mute"] else 1000)
            draw()

        def where(e):
            if 10 <= e.x <= 58:
                return "pp"
            x0, x1 = st.get("line", (0, 0))
            if x0 - 8 <= e.x <= x1 + 8:
                return "line"
            a_, b_ = st.get("snd", (0, 0))
            if a_ <= e.x <= b_:
                return "snd"
            return None

        def seek_to(e):
            m = st["mci"]
            x0, x1 = st.get("line", (0, 1))
            if m is not None and m.length:
                f_ = min(1.0, max(0.0, (e.x - x0) / float(max(1, x1 - x0))))
                try:
                    m.seek(m.length * f_, play=m.mode() == "playing" or st["ended"])
                    st["ended"] = False
                except Exception:
                    pass
                draw()

        def press(e):
            k = where(e)
            if k == "pp":
                toggle()
            elif k == "line":
                st["drag"] = True
                seek_to(e)
            elif k == "snd":
                mute()

        def motion(e):
            k = where(e)
            bar.configure(cursor="hand2" if k else "")
            if k != st["hov"]:
                st["hov"] = k
                draw()
        bar.bind("<ButtonPress-1>", press)
        bar.bind("<B1-Motion>", lambda e: seek_to(e) if st["drag"] else None)
        bar.bind("<ButtonRelease-1>", lambda e: st.update(drag=False))
        bar.bind("<Motion>", motion)
        bar.bind("<Configure>", lambda e: draw())
        screen.bind("<Configure>", lambda e: fit())
        screen.bind("<Button-1>", lambda e: (ov.focus_set(), toggle()))
        for w_ in (ov, bar, screen, head):
            w_.bind("<Escape>", lambda e: (self.close_video(), "break")[1])
            w_.bind("<space>", lambda e: (toggle(), "break")[1])
            w_.bind("<Left>", lambda e: (jump(-10000), "break")[1])
            w_.bind("<Right>", lambda e: (jump(10000), "break")[1])
            w_.bind("<m>", lambda e: (mute(), "break")[1])
        st["toggle"], st["fit"] = toggle, fit

        def start():
            if getattr(self, "_video", None) is not ov:
                return
            try:
                self.root.update_idletasks()
                st["mci"] = MciVideo(path, screen.winfo_id())
                fit()
                st["mci"].play()
            except Exception as ex:
                _log(f"video: {ex}")
                self.close_video()
                open_in_os(path)
                self._toast("Windows can't play this video inside BindLens - it opens in your video player.",
                            ms=6000)
                return
            draw()
            ov.focus_set()
            st["job"] = self.root.after(250, tick)
        self.root.after(60, start)

    def close_video(self):
        ov = getattr(self, "_video", None)
        st = getattr(self, "_video_st", None) or {}
        self._video = None
        self._video_st = None
        if st.get("job"):
            try:
                self.root.after_cancel(st["job"])
            except Exception:
                pass
        if st.get("mci") is not None:
            st["mci"].close()
        if ov is not None:
            try:
                ov.destroy()
            except Exception:
                pass
            try:
                (self._stage if getattr(self, "_stage", None) is not None else self.canvas).focus_set()
            except Exception:
                pass

    def _book_locked(self, f):
        """A book locked with the PIN, not opened yet since BindLens started."""
        return f in self.lib.settings.get("locked_books", []) and f not in getattr(self, "_unlocked", set()) and \
            bool(pin_load())

    def lock_book(self, f, on=True):
        if on and not pin_load():
            if messagebox.askyesno(APP_NAME, "To lock a book, BindLens needs a PIN first. Set one now?"):
                self.pin_settings()
            return
        lst = self.lib.settings.setdefault("locked_books", [])

        def done():
            if on and f not in lst:
                lst.append(f)
                self.__dict__.setdefault("_unlocked", set()).discard(f)
            elif not on and f in lst:
                lst.remove(f)
            self.lib.save_meta()
            self._fill_folders()
            self._draw_rail()
            self._toast(("Locked: " if on else "No lock now: ") + self.lib.label(f) +
                        (" - it asks for the PIN when you open it, and stays out of search and reports until then."
                         if on else ""))
            if on and f == self.folder:
                self.show_home()
        if on:
            done()
        else:
            self._ask_book_pin(f, done)

    def _ask_book_pin(self, f, then):
        """The PIN for one book (once per time BindLens is open)."""
        cur = pin_load()
        if not cur:
            then()
            return
        T, A = self.T, self.accent
        d = self._dialog("Locked book")
        d.configure(padx=24, pady=18)
        tk.Label(d, text=f"“{self.lib.label(f)}” is locked", font=self.F(13, "bold"), bg=T["panel"],
                 fg=T["text"]).pack(anchor="w")
        tk.Label(d, text="Type the PIN to open it.", font=self.F(9), bg=T["panel"], fg=T["muted"]).pack(anchor="w")
        v = tk.StringVar()
        en = ttk.Entry(d, textvariable=v, show="•", width=10, font=self.F(14), justify="center")
        en.pack(pady=(10, 4))
        msg = tk.Label(d, text="", font=self.F(9), bg=T["panel"], fg="#B3261E")
        msg.pack()

        def ok(_e=None):
            if pin_hash(v.get().strip(), cur["salt"]) == cur["hash"]:
                self.__dict__.setdefault("_unlocked", set()).add(f)
                d.destroy()
                then()
            else:
                msg.configure(text="Not right.")
                v.set("")

        def typed(*_):
            if "n" in cur and len(v.get().strip()) == int(cur["n"]):
                d.after(100, ok)
        v.trace_add("write", typed)
        en.bind("<Return>", ok)
        d.bind("<Escape>", lambda e: d.destroy())
        self._center(d)
        en.focus_set()

    def _lock_hide(self):
        ov = getattr(self, "_lock", None)
        self._lock = None
        st = getattr(self, "_lock_st", None) or {}
        for w_ in st.get("hidden", []):                 # 4.4.4: the windows kept away while the PIN was asked
            try:
                if w_.winfo_exists():
                    w_.deiconify()
            except Exception:
                pass
        if st.get("job"):
            try:
                self.root.after_cancel(st["job"])
            except Exception:
                pass
        self._lock_st = None
        later, self._after_unlock = list(getattr(self, "_after_unlock", None) or []), []
        later.sort(key=lambda fn: 0 if getattr(fn, "__name__", "") == "show_home" else 1)     # Home first
        self._lock_top = None
        try:
            self._topband_draw()                           # the menus come back
        except Exception:
            pass
        for i_, fn in enumerate(later):                  # 4.4: what waited for the PIN (Home, What's new...)
            self.root.after(40 + 350 * i_, fn)
        try:
            self.root.unbind("<Key>")                     # 4.2.2: the PIN no longer takes the keys
        except Exception:
            pass
        if ov is not None:
            try:
                ov.destroy()
            except Exception:
                pass
        try:
            self.canvas.focus_set()
        except Exception:
            pass

    # ---- update by dragging the new zip ----------------------------------------------------------------------------
    def update_from_zip(self, path=None):
        """Install a new BindLens from its zip, keep the version before (Help > Go back), restart."""
        if FROZEN:                                       # 4.5: the program is updated with its new installer
            messagebox.showinfo(APP_NAME, "To update BindLens, download the new 'BindLens Setup.exe' and run it.\n\n"
                                          "Your books, marks and settings stay as they are.")
            return
        if path is None:
            path = filedialog.askopenfilename(title="Choose the new BindLens zip", filetypes=[("BindLens zip",
                                                                                                "*.zip")])
            if not path:
                return
        try:
            with zipfile.ZipFile(path) as z:
                names = z.namelist()
                main = next((n for n in names if n.replace("\\", "/").split("/")[-1] == "BindLens.pyw"), None)
                if not main:
                    messagebox.showerror(APP_NAME, "This zip has no BindLens in it.")
                    return
                src = z.read(main).decode("utf-8", "replace")
                m = re.search(r'^APP_VERSION = "([^"]+)"', src, re.M)
                ver = m.group(1) if m else "?"
                prefix = main[:-len("BindLens.pyw")]
                if not messagebox.askyesno(APP_NAME, f"Update BindLens {APP_VERSION} to {ver}?\n\nYour books, marks "
                                                     "and settings stay as they are. The version you have now is "
                                                     "kept (Help > Go back to the version before). BindLens starts "
                                                     "again by itself."):
                    return
                back = os.path.join(data_dir(), "previous version")
                if os.path.isdir(back):
                    shutil.rmtree(back, ignore_errors=True)
                os.makedirs(back, exist_ok=True)
                for nm in os.listdir(APP_DIR):
                    p = os.path.join(APP_DIR, nm)
                    if os.path.isfile(p) and not nm.endswith(".log"):
                        shutil.copy2(p, os.path.join(back, nm))
                with open(os.path.join(back, "version.txt"), "w", encoding="utf-8") as fh:
                    fh.write(APP_VERSION)
                for n in names:
                    nn = n.replace("\\", "/")
                    if not nn.startswith(prefix) or nn.endswith("/") or "__pycache__" in nn or ".." in nn:
                        continue
                    rel = nn[len(prefix):]
                    dst = os.path.join(APP_DIR, *rel.split("/"))
                    os.makedirs(os.path.dirname(dst), exist_ok=True)
                    with z.open(n) as fsrc, open(dst + ".new", "wb") as fdst:
                        shutil.copyfileobj(fsrc, fdst)
                    os.replace(dst + ".new", dst)
        except Exception as ex:
            messagebox.showerror(APP_NAME, f"The update could not be installed:\n{ex}")
            return
        self._restart()

    def go_back_version(self):
        if FROZEN:
            messagebox.showinfo(APP_NAME, "To go back to an earlier BindLens, run that version's "
                                          "'BindLens Setup.exe' again. Your books and marks stay as they are.")
            return
        back = os.path.join(data_dir(), "previous version")
        try:
            ver = open(os.path.join(back, "version.txt"), encoding="utf-8").read().strip()
        except Exception:
            messagebox.showinfo(APP_NAME, "There is no earlier version kept.")
            return
        if not messagebox.askyesno(APP_NAME, f"Go back to BindLens {ver}? (Your books and marks stay as they are.)"):
            return
        try:
            for nm in os.listdir(back):
                if nm != "version.txt":
                    shutil.copy2(os.path.join(back, nm), os.path.join(APP_DIR, nm))
        except Exception as ex:
            messagebox.showerror(APP_NAME, f"Could not go back:\n{ex}")
            return
        self._restart()

    def _restart(self):
        if FROZEN:                                       # 4.5: BindLens.exe starts itself again
            try:
                subprocess.Popen([sys.executable], cwd=APP_DIR, creationflags=0x00000008 if os.name == "nt" else 0)
            except Exception as ex:
                messagebox.showinfo(APP_NAME, f"Please open BindLens again.\n({ex})")
            self.on_close()
            return
        try:
            exe = sys.executable
            if os.name == "nt" and exe.lower().endswith("python.exe"):
                cand = exe[:-10] + "pythonw.exe"
                exe = cand if os.path.isfile(cand) else exe
            subprocess.Popen([exe, os.path.join(APP_DIR, "BindLens.pyw")], cwd=APP_DIR,
                             creationflags=0x00000008 if os.name == "nt" else 0)
        except Exception as ex:
            messagebox.showinfo(APP_NAME, f"Updated. Please open BindLens again.\n({ex})")
        self.on_close()

    def _qbar_size_later(self):
        if not getattr(self, "_qb_size_job", None):
            self._qb_size_job = self.root.after(250, self._qbar_size_now)

    def _qbar_size_now(self):
        self._qb_size_job = None
        w = self.root.winfo_width()
        if w <= 1:
            self._qb_size_job = self.root.after(300, self._qbar_size_now)
            return
        if (w >= 980) != getattr(self, "_qb_wide", None):
            self._qb_wide = w >= 980
            self._qbar_place()
        if getattr(self, "_fr", None):
            self._frame_draw(force=True)

    # ---- start-up of the 4.0 things --------------------------------------------------------------------------------
    def _pin_ask_once(self):
        """4.1: once - 'Protect BindLens with a 4-digit PIN?' (never again after the answer)."""
        s = self.lib.settings
        if s.get("pin_asked") or pin_load() or not self.lib.folders:
            return
        if any(isinstance(w, tk.Toplevel) and w.winfo_viewable() for w in self.root.winfo_children()):
            self.root.after(4000, self._pin_ask_once)             # after the What's new window
            return
        s["pin_asked"] = True
        self.lib.save_meta()
        if messagebox.askyesno(APP_NAME, "Protect BindLens with a 4-digit PIN?\n\nIt is asked when BindLens opens "
                                         "and after the resting screen. You can also lock single books.\n\n(Later: "
                                         "File > Lock with a PIN.)"):
            self.pin_settings()

    def _v40_start(self):
        self.root.after(3500, self._pin_ask_once)
        try:
            self._qb_wide = None
            self._qbar_size_now()
        except Exception:
            pass
        try:
            self._frame_build()
            if self._cap_on():
                self._grip_install()                     # the frame's thin lines (reading) resize too
        except Exception as ex:
            _log(f"frame: {ex}")
        try:
            self.root.after(900, self.whats_new)
        except Exception:
            pass

    def _save_window(self):
        st = self.lib.settings
        cap = getattr(self, "_cap", None)
        if cap is not None and cap.ok:                      # 4.3: own title bar - BindLens knows its size itself
            st["maximized"] = bool(cap.maxed)
            if cap.normal and cap.normal[0] > 200:
                st["geometry"] = "%dx%d+%d+%d" % tuple(cap.normal)
            elif not cap.maxed:
                st["geometry"] = self.root.geometry()
        else:
            st["maximized"] = self.root.state() == "zoomed"
            if not st["maximized"]:
                st["geometry"] = self.root.geometry()
        try:
            os.remove(self._ownbar_flag())                  # a normal close: the own bar did start fine
        except Exception:
            pass

    def on_close(self):
        """Save everything, then really quit - nothing is left running in the taskbar, ever."""
        if getattr(self, "_closing", False):
            os._exit(0)
        self._closing = True
        t0 = time.time()

        def watchdog():
            time.sleep(14)
            _log(f"close: forced exit after 14 s (stuck in: {getattr(self, '_close_step', '?')})")
            try:                                   # 3.0: never lose marks that are not on the disk yet
                self.writer.rescue(os.path.join(self.lib.meta_dir, "rescued"))
            except Exception:
                pass
            os._exit(0)
        threading.Thread(target=watchdog, daemon=True).start()
        try:
            self.root.withdraw()                     # the window goes away at once
        except Exception:
            pass
        steps = [("video", self.close_video),
                 ("voice", lambda: self._speaker.close() if getattr(self, "_speaker", None) else None),
                 ("position", self._remember_position),
                 ("fullscreen", lambda: self.toggle_fullscreen() if self.fullscreen else None),
                 ("window", self._save_window),
                 ("book", self._close_book),
                 ("library", self.lib.save_meta),
                 ("writes", lambda: self.writer.wait(3)),
                 # 3.0: what could not be saved (a file open in another program) is kept and offered next time
                 ("rescue", lambda: self.writer.rescue(os.path.join(self.lib.meta_dir, "rescued"))),
                 ("index", lambda: (setattr(self.indexer, "stop", True),
                                    self.indexer.save() if self.indexer.changed else None))]
        for name, st in steps:
            self._close_step = name
            try:
                st()
            except Exception as ex:
                _log(f"close: step {name} failed: {ex}")
        if time.time() - t0 > 4:
            _log(f"close: slow ({time.time() - t0:.1f} s)")
        try:
            self.root.destroy()
        except Exception:
            pass
        os._exit(0)


def _log(msg):
    try:
        with open(os.path.join(APP_DIR, "BindLens-error.log"), "a", encoding="utf-8") as fh:
            fh.write(time.strftime("%Y-%m-%d %H:%M:%S ") + msg + "\n")
    except Exception:
        pass


def build_ico(name=None, style=None):
    """A Windows .ico with every size the desktop, Explorer and the taskbar use: 16-128 as classic bitmaps (they
    always show) and 256 as PNG. (1.9.2: an .ico with only PNG pictures could show no logo on the desktop.)"""
    import pymupdf as _f
    colors = LOGO_COLORS.get(name or "Black", LOGO_COLORS["Black"])
    entries = []
    for size in (16, 20, 24, 32, 40, 48, 64, 128, 256):
        doc = _f.open()
        pg = doc.new_page(width=size, height=size)
        draw_logo(pg, _f, 0, 0, size, colors, style=style)
        if size >= 32:                                   # 1.9.4: the golden line, with its light
            draw_gold_ring(pg, _f, size, head=0.3)
        pix = pg.get_pixmap(alpha=True)
        doc.close()
        if size == 256:
            entries.append((size, pix.tobytes("png")))
            continue
        w, h, n = pix.width, pix.height, pix.n
        sm = pix.samples
        rows = []
        for y in range(h - 1, -1, -1):                       # bottom-up rows, BGRA
            row = bytearray(w * 4)
            src = sm[y * pix.stride:y * pix.stride + w * n]
            row[0::4], row[1::4], row[2::4] = src[2::n], src[1::n], src[0::n]
            row[3::4] = src[3::n] if n == 4 else b"\xff" * w
            rows.append(bytes(row))
        mask_row = ((w + 31) // 32) * 4
        head = struct.pack("<IiiHHIIiiII", 40, w, h * 2, 1, 32, 0, w * h * 4 + mask_row * h, 0, 0, 0, 0)
        entries.append((size, head + b"".join(rows) + b"\x00" * (mask_row * h)))
    out = struct.pack("<HHH", 0, 1, len(entries))
    off = 6 + 16 * len(entries)
    body = b""
    for size, data in entries:
        out += struct.pack("<BBBBHHII", 0 if size >= 256 else size, 0 if size >= 256 else size, 0, 0, 1, 32,
                           len(data), off + len(body))
        body += data
    return out + body


def _saved_logo_style():
    """Classic or the new logo (Personalise), read from the settings file without opening the library."""
    try:
        st = (load_json(os.path.join(data_dir(), "library.json"), {}).get("settings") or {}).get("logo_style")
        if st in LOGO_STYLES:
            return "classic"                    # 4.4.1: one logo only - the original
    except Exception:
        pass
    return "classic"


def _saved_icon_name():
    """The app icon chosen in Personalise (read from the settings file, without opening the library)."""
    try:
        st_ = load_json(os.path.join(data_dir(), "library.json"), {}).get("settings") or {}
        ic = st_.get("icon")
        if ic == "Custom":
            logo_custom(st_.get("icon_custom"))
        if ic in LOGO_COLORS:
            return ic
    except Exception:
        pass
    return "Black"


def _desktop_link():
    try:
        import ctypes.wintypes
        buf = ctypes.create_unicode_buffer(260)
        ctypes.windll.shell32.SHGetFolderPathW(None, 0x0010, None, 0, buf)      # CSIDL_DESKTOPDIRECTORY
        return os.path.join(buf.value, "BindLens.lnk")
    except Exception:
        return os.path.join(os.path.expanduser("~"), "Desktop", "BindLens.lnk")


def ico_ok(path):
    """True when the .ico has small classic bitmaps (16 and 32) - what the desktop shortcut needs."""
    try:
        with open(path, "rb") as fh:
            d = fh.read()
        n = struct.unpack("<H", d[4:6])[0]
        small = set()
        for i in range(n):
            w, h, _c, _r, _p, _b, size, off = struct.unpack("<BBBBHHII", d[6 + 16 * i:22 + 16 * i])
            if d[off:off + 4] != b"\x89PNG" and w in (16, 32):
                small.add(w)
        return small == {16, 32}
    except Exception:
        return False


def refresh_shell_icons():
    """Ask Windows to show new icons at once (its icon cache)."""
    if os.name != "nt":
        return
    try:
        import ctypes
        ctypes.windll.shell32.SHChangeNotify(0x08000000, 0, None, None)      # SHCNE_ASSOCCHANGED
    except Exception:
        pass
    try:
        subprocess.Popen(["ie4uinit.exe", "-show"], creationflags=0x08000000)
    except Exception:
        pass


def in_temp_folder(path=None):
    """True when BindLens runs from a temporary folder (for example opened straight from inside the zip): a
    shortcut to it would stop working as soon as Windows cleans that folder ('the item has been moved')."""
    p = os.path.normcase(os.path.abspath(path or APP_DIR))
    tmps = {os.path.normcase(os.path.abspath(t)) for t in (os.environ.get("TEMP"), os.environ.get("TMP")) if t}
    try:
        import tempfile
        tmps.add(os.path.normcase(os.path.abspath(tempfile.gettempdir())))
    except Exception:
        pass
    if any(p == t or p.startswith(t + os.sep) for t in tmps):
        return True
    low = p.replace("/", "\\").lower()
    return "\\appdata\\local\\temp\\" in low + "\\" or ".zip\\" in low


def python_launcher():
    """(program, arguments) that open BindLens without a black window: the Windows 'pyw' launcher when there is
    one (it survives Python updates), else pythonw.exe."""
    if FROZEN:                                           # 4.5: the program itself
        return sys.executable, ""
    app = os.path.join(APP_DIR, "BindLens.pyw")
    cands = [shutil.which("pyw") or "", os.path.join(os.environ.get("WINDIR", r"C:\Windows"), "pyw.exe"),
             os.path.join(os.environ.get("LOCALAPPDATA", ""), "Programs", "Python", "Launcher", "pyw.exe")]
    exe_dir = os.path.dirname(sys.executable or "")
    cands += [os.path.join(exe_dir, "pythonw.exe"), shutil.which("pythonw") or ""]
    for c in cands:
        if c and os.path.isfile(c):
            return c, f'"{app}"'
    return os.path.join(APP_DIR, "Start BindLens.bat"), ""


def shortcut_ico(name=None):
    """The .ico the shortcuts use. One file per logo colour (BindLens-Black.ico …): Windows keeps icons in a cache
    by file name, so a new name makes the desktop show a new colour at once."""
    name = name if name in LOGO_COLORS else _saved_icon_name()
    style = LOGO_STYLE if _LOGO_SET else _saved_logo_style()
    tag = name + (LOGO_COLORS[name][0][1:] if name == "Custom" else "")
    ico = os.path.join(APP_DIR, f"BindLens-{tag}-gold.ico" if style == "classic" else f"BindLens-{tag}-{style}.ico")
    if not ico_ok(ico):
        with open(ico, "wb") as fh:
            fh.write(build_ico(name, style))
    main_ico = os.path.join(APP_DIR, "BindLens.ico")
    try:                                     # 3.1: the same picture as the chosen one (also when going back)
        with open(ico, "rb") as a_, open(main_ico, "rb") as b_:
            same = a_.read() == b_.read()
    except Exception:
        same = False
    if not same:
        try:
            shutil.copyfile(ico, main_ico)
        except Exception:
            pass
    return ico


def _ps(script, timeout=40):
    """Run a short PowerShell script without a window; returns its output ('' on failure)."""
    try:
        enc = base64.b64encode(script.encode("utf-16-le")).decode("ascii")     # no quoting problems with paths
        out = subprocess.run(["powershell", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass",
                              "-EncodedCommand", enc], capture_output=True, timeout=timeout,
                             creationflags=0x08000000)
        return (out.stdout or b"").decode("utf-8", "replace") if out.returncode == 0 else ""
    except Exception:
        return ""


def read_shortcut(path):
    """(target, arguments, icon) of a Windows shortcut, or None."""
    if os.name != "nt" or not os.path.exists(path):
        return None
    q = path.replace("'", "''")
    out = _ps("[Console]::OutputEncoding=[Text.Encoding]::UTF8;"
              f"$s=(New-Object -ComObject WScript.Shell).CreateShortcut('{q}');"
              "Write-Output ($s.TargetPath+'|'+$s.Arguments+'|'+$s.IconLocation)")
    parts = out.strip().split("|")
    if len(parts) < 3:
        return None
    return parts[0], parts[1], "|".join(parts[2:])


def shortcut_broken(path):
    """True when the shortcut is missing its program, the BindLens file it opens, or its icon."""
    info = read_shortcut(path)
    if info is None:
        return True
    target, args, icon = info
    files = [target] + re.findall(r'"([^"]+\.pyw)"', args)
    ic = icon.rsplit(",", 1)[0].strip()
    if ic:
        files.append(ic)
    return any(not f or not os.path.exists(os.path.expandvars(f)) for f in files)


def make_shortcut(quiet=False):
    """Windows: put a BindLens shortcut (with its logo) on the desktop and in the Start menu.
    It opens BindLens.pyw with the 'pyw' launcher - no black window, and it keeps working after Python updates.
    Never made for a copy in a temporary folder (inside the zip): that shortcut would soon say 'moved or deleted'."""
    if os.name != "nt":
        return False
    if in_temp_folder():
        if not quiet:
            messagebox.showwarning(APP_NAME, "BindLens is running from a temporary folder (straight from the zip).\n\n"
                                   "A shortcut to it would stop working. Please extract the zip first (right-click it,"
                                   " Extract All), then run Install.bat in the extracted folder.")
        return False
    try:
        ico = shortcut_ico()
    except Exception:
        ico = os.path.join(APP_DIR, "BindLens.ico")
    prog, args = python_launcher()
    q = lambda p: p.replace("'", "''")
    one = ("$s=$W.CreateShortcut($p);"
           f"$s.TargetPath='{q(prog)}';$s.Arguments='{q(args)}';$s.WorkingDirectory='{q(APP_DIR)}';"
           f"$s.WindowStyle={7 if prog.lower().endswith('.bat') else 1};"
           f"$s.IconLocation='{q(ico)},0';$s.Description='BindLens - your folders as books';$s.Save();")
    ps = ("$ErrorActionPreference='Stop';$W=New-Object -ComObject WScript.Shell;"
          "$p=Join-Path ([Environment]::GetFolderPath('Desktop')) 'BindLens.lnk';" + one +
          "try{$p=Join-Path ([Environment]::GetFolderPath('Programs')) 'BindLens.lnk';" + one + "}catch{};"
          "Write-Output 'ok'")
    ok = "ok" in _ps(ps)
    if ok:
        refresh_shell_icons()
        if not quiet:
            messagebox.showinfo(APP_NAME, "A BindLens shortcut with the logo was added to your desktop "
                                          "(and to the Start menu).")
    elif not quiet:
        messagebox.showerror(APP_NAME, "Could not create the shortcut.\n\nTry running Install.bat again.")
    return ok


def check_shortcut(force_once=None):
    """At start (Windows, in a thread): make the desktop shortcut when there is none yet (once), and repair it when
    it points to a BindLens that is no longer there. A working shortcut to another copy is left alone."""
    if os.name != "nt" or in_temp_folder():
        return None
    link = _desktop_link()
    if not os.path.exists(link):
        if force_once:
            return "made" if make_shortcut(quiet=True) else None
        return None
    if shortcut_broken(link):
        return "fixed" if make_shortcut(quiet=True) else None
    return None


def main():
    if HELPER_ARG in sys.argv:              # an invisible reader for the window (see HelperPool)
        try:
            helper_main()
        finally:
            os._exit(0)
    try:
        _main()
    except SystemExit:
        raise
    except Exception:
        import traceback
        err = traceback.format_exc()
        log = os.path.join(APP_DIR, "BindLens-error.log")
        try:
            with open(log, "w", encoding="utf-8") as fh:
                fh.write(time.strftime("%Y-%m-%d %H:%M:%S") + "\n" + err)
        except Exception:
            pass
        try:
            r = tk.Tk()
            r.withdraw()
            messagebox.showerror(APP_NAME, "BindLens could not start.\n\nThe details were saved in:\n" + log +
                                 "\n\n" + err[-600:])
        except Exception:
            pass


def _selftest(out):
    """4.5: BindLens.exe --selftest <file>: the parts the program needs, checked without opening a window (used
    when the program is built on GitHub). Writes 'OK' or what failed into the file."""
    lines, ok = [], True
    try:
        fitz = agpl_producer(ensure_pymupdf())
        d = fitz.open()
        pg = d.new_page(width=200, height=200)
        pg.insert_text((20, 40), "BindLens self-test", fontsize=12)
        pix = pg.get_pixmap()
        lines.append(f"pymupdf {fitz.VersionBind}: page drawn {pix.width}x{pix.height}")
        d.close()
    except Exception as ex:
        ok = False
        lines.append(f"pymupdf FAILED: {ex!r}")
    try:
        import tkinterdnd2                          # (drag and drop)
        lines.append("tkinterdnd2 " + os.path.dirname(tkinterdnd2.__file__))
    except Exception as ex:
        ok = False
        lines.append(f"tkinterdnd2 FAILED: {ex!r}")
    try:                                            # a helper process answers (the window never waits for files)
        p = subprocess.Popen([sys.executable, HELPER_ARG] if FROZEN else
                             [sys.executable, os.path.abspath(__file__), HELPER_ARG],
                             stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             creationflags=0x08000000 if os.name == "nt" else 0, cwd=APP_DIR)
        p.stdin.close()
        p.wait(timeout=60)
        lines.append(f"helper process started and ended (code {p.returncode})")
    except Exception as ex:
        ok = False
        lines.append(f"helper FAILED: {ex!r}")
    lines.append(f"app dir {APP_DIR}; frozen {FROZEN}; version {APP_VERSION}")
    with open(out, "w", encoding="utf-8") as fh:
        fh.write(("OK" if ok else "FAILED") + "\n" + "\n".join(lines) + "\n")
    return ok


def _main():
    if "--selftest" in sys.argv:
        i = sys.argv.index("--selftest")
        out = sys.argv[i + 1] if len(sys.argv) > i + 1 else os.path.join(APP_DIR, "selftest.txt")
        os._exit(0 if _selftest(out) else 1)
    if "--shortcut" in sys.argv:
        ok = make_shortcut(quiet=True)
        print("Desktop shortcut created." if ok else "Could not create the desktop shortcut.")
        return
    if os.name == "nt":
        try:
            import ctypes
            ctypes.windll.shcore.SetProcessDpiAwareness(1)
            ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID("BindLens.App")
        except Exception:
            pass
    fitz = agpl_producer(ensure_pymupdf())
    root, dnd = make_root()
    App(root, fitz, dnd)
    root.mainloop()
    for t in threading.enumerate():          # let the last save finish, then end the process for good
        if t is not threading.current_thread() and not t.daemon:
            t.join(5)
    os._exit(0)


if __name__ == "__main__":
    main()
