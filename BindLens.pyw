_TEX_CACHE = {}


def _tex_tile(name):
    """A small piece of a texture (made once): rows of RGB bytes that repeat."""
    import math
    import random
    if name in _TEX_CACHE:
        return _TEX_CACHE[name]
    rnd = random.Random(7)
    TW, TH = (256, 128) if name == "Wood" else (128, 128)
    rows = []
    if name == "Wood":
        # planks lying across, with long grain lines that wave a little
        a, b = (216, 181, 136), (184, 143, 98)
        planks = [(rnd.uniform(-8, 8), rnd.uniform(0, 6.3), rnd.uniform(0.28, 0.42)) for _ in range(2)]
        streak = [rnd.uniform(-5, 5) for _ in range(TH)]
        for y in range(TH):
            tone, ph, fr = planks[(y // 64) % 2]
            row = bytearray()
            for x in range(TW):
                g1 = 0.5 + 0.5 * math.sin(y * fr + 1.9 * math.sin(x * 0.011 + ph) + 0.5 * math.sin(x * 0.047 + y * 0.03))
                g2 = 0.5 + 0.5 * math.sin(y * fr * 2.9 + 3.1 * math.sin(x * 0.017 + ph * 2) + x * 0.004)
                g = (0.62 * g1 + 0.38 * g2) ** 2.0
                n = streak[y] * 0.6 + rnd.uniform(-2.5, 2.5)
                seam = 0.78 if y % 64 in (0, 1) or (x + (y // 64) * 97) % 256 in (0,) else 1.0
                row += bytes(max(0, min(255, int((a[k] + (b[k] - a[k]) * g + n + tone) * seam))) for k in range(3))
            rows.append(bytes(row))
    else:
        base = {"Paper": (246, 242, 232), "Linen": (236, 230, 218), "Slate": (60, 64, 72),
                "Parchment": (239, 227, 200)}.get(name, (246, 242, 232))
        amp = {"Paper": 4, "Linen": 4, "Slate": 6, "Parchment": 7}.get(name, 4)
        fib = [(rnd.randrange(TW), rnd.randrange(TH), rnd.uniform(0, 6.3), rnd.randrange(6, 18))
               for _ in range(26 if name == "Paper" else 0)]
        dark = set()
        for fx_, fy_, ang, ln in fib:
            for i in range(ln):
                dark.add((int(fx_ + i * math.cos(ang)) % TW, int(fy_ + i * math.sin(ang)) % TH))
        for y in range(TH):
            row = bytearray()
            for x in range(TW):
                v = rnd.uniform(-amp, amp)
                if name == "Linen":
                    v += 5 if ((x % 4 < 2) ^ (y % 4 < 2)) else -4
                    v += 3 * math.sin(y * 0.7) * (1 if x % 9 < 5 else 0)
                elif name == "Parchment":                    # (waves that repeat with the tile: no seams)
                    v += 4 * math.sin(2 * math.pi * 2 * x / TW + 2.2 * math.sin(2 * math.pi * 2 * y / TH))
                if (x, y) in dark:
                    v -= 7
                row += bytes(max(0, min(255, int(base[k] + v))) for k in range(3))
            rows.append(bytes(row))
    _TEX_CACHE[name] = (TW, TH, rows)
    return _TEX_CACHE[name]


def texture_ppm(name, W, H, canvas="#FFFFFF"):
    """A texture behind the pages (paper, linen, wood…) as a PPM picture of W x H."""
    TW, TH, rows = _tex_tile(name)
    if not is_light(canvas) and name != "Slate":         # a dark theme: a dark version of it
        cr = tuple(int(canvas[i:i + 2], 16) for i in (1, 3, 5))
        rows = [bytes(int(v * 0.22 + cr[j % 3] * 0.78) for j, v in enumerate(r)) for r in rows]
    reps = W // TW + 1
    full = [(r * reps)[:W * 3] for r in rows]
    out = [full[y % TH] for y in range(H)]
    return b"P6\n%d %d\n255\n" % (W, H) + b"".join(out)


