def draw_logo(page, fitz, ox, oy, S, colors, parts=("bg", "spine", "arc", "pages", "lens"), lens=(0.0, 0.0),
              pages=3, glint=None, lens_scale=1.0, style=None):
    """The BindLens logo (D1) drawn by PyMuPDF at (ox, oy), size S. lens = how far the lens has moved (in logo
    units, 256 = the whole logo); glint = 0..1 where a light passes over the glass (None = no light)."""
    import math
    if (style or LOGO_STYLE) == "stack":
        return draw_logo_stack(page, fitz, ox, oy, S, colors, parts, lens, pages, glint, lens_scale)
    bg, spine, pink, lensc, pagec = colors
    k = S / 256.0
    P = lambda x, y: (ox + x * k, oy + y * k)
    R = lambda x0, y0, x1, y1: fitz.Rect(ox + x0 * k, oy + y0 * k, ox + x1 * k, oy + y1 * k)
    sh = page.new_shape()
    if "bg" in parts:
        sh.draw_rect(R(18, 18, 238, 238), radius=0.24)
        sh.finish(color=None, fill=_rgb(bg))
        if bg.upper() == "#FFFFFF":
            sh.draw_rect(R(18, 18, 238, 238), radius=0.24)
            sh.finish(color=_rgb("#D9D9DE"), width=max(0.5, 2 * k))
    if "spine" in parts:
        sh.draw_rect(R(74, 48, 101, 199), radius=0.12)
        sh.finish(color=None, fill=_rgb(spine))
        for yy in (80, 120, 160):
            sh.draw_circle(P(87, yy), 4.6 * k)
            sh.finish(color=None, fill=_rgb(bg))
    if "arc" in parts:
        cx, cy, rr = 155.7, 118.5, 45.2
        pts = [P(101, 78), P(cx + rr * math.cos(math.radians(126)), 78)]
        for i in range(25):
            a = math.radians(126 + (234 - 126) * i / 24)
            pts.append(P(cx + rr * math.cos(a), cy - rr * math.sin(a)))
        pts += [P(cx + rr * math.cos(math.radians(234)), 159), P(101, 159)]
        sh.draw_polyline(pts)
        sh.finish(color=_rgb(pink), width=max(0.6, 3.6 * k), closePath=False, lineJoin=1, lineCap=1)
    if "pages" in parts:
        for i, (x1, y0, y1) in enumerate(((164.5, 165, 177.5), (169.5, 180, 188.5), (175, 191, 199.5))):
            if i >= pages:
                break
            sh.draw_rect(R(99, y0, x1, y1), radius=0.45)
            sh.finish(color=None, fill=_rgb(pagec))
    if "lens" in parts:
        dx, dy = lens
        cx, cy = 153 + dx, 121 + dy
        r = 27 * lens_scale
        sh.draw_circle(P(cx, cy), r * k)
        sh.finish(color=_rgb(lensc), width=16 * k * lens_scale)
        a0 = P(cx + 19.5 * lens_scale, cy + 19.5 * lens_scale)
        a1 = P(cx + 43 * lens_scale, cy + 43 * lens_scale)
        sh.draw_line(a0, a1)
        sh.finish(color=_rgb(lensc), width=14 * k * lens_scale, lineCap=1)
        _logo_glint(sh, P, cx, cy, 19 * lens_scale, glint)
    sh.commit()


def _logo_glint(sh, P, cx, cy, ri, glint):
    """A light passing over the glass: the part of a slanted band that is inside the glass (glint = 0…1)."""
    import math
    if glint is None or not 0 <= glint <= 1:
        return
    off = -ri * 1.6 + glint * ri * 3.2
    band = []
    for i in range(73):
        a = math.radians(i * 5)
        x, y = math.cos(a) * ri, math.sin(a) * ri
        if off - 3.5 <= (x - y) / 1.414 <= off + 3.5:
            band.append((x, y))
    if len(band) > 2:
        for t in (off - 3.5, off + 3.5):      # where the band's edges cross the glass
            for sgn in (1, -1):
                q = t / 1.414
                h = math.sqrt(max(0.0, ri * ri - t * t)) / 1.414
                band.append((q + sgn * h, -q + sgn * h))
        band = [(x, y) for x, y in band if x * x + y * y <= ri * ri + 0.5]
        if len(band) > 2:
            mx = sum(q[0] for q in band) / len(band)
            my = sum(q[1] for q in band) / len(band)
            band.sort(key=lambda p_: math.atan2(p_[1] - my, p_[0] - mx))
            sh.draw_polyline([P(cx + x, cy + y) for x, y in band] + [P(cx + band[0][0], cy + band[0][1])])
            sh.finish(color=None, fill=(1, 1, 1), fill_opacity=0.42, closePath=True)


def _rrect_pts(cx, cy, w, h, r, ang=0.0, n=6):
    """The outline of a rounded rectangle centred on (cx, cy), turned by ang degrees."""
    import math
    pts = []
    for (qx, qy, a0) in ((w / 2 - r, -h / 2 + r, -90), (w / 2 - r, h / 2 - r, 0), (-w / 2 + r, h / 2 - r, 90),
                         (-w / 2 + r, -h / 2 + r, 180)):
        for i in range(n + 1):
            a = math.radians(a0 + 90 * i / n)
            pts.append((qx + r * math.cos(a), qy + r * math.sin(a)))
    ca, sa = math.cos(math.radians(ang)), math.sin(math.radians(ang))
    return [(cx + x * ca - y * sa, cy + x * sa + y * ca) for x, y in pts]


def draw_logo_stack(page, fitz, ox, oy, S, colors, parts=("bg", "spine", "arc", "pages", "lens"), lens=(0.0, 0.0),
                    pages=3, glint=None, lens_scale=1.0):
    """3.1: the new logo - a page with a bookmark on a little fan of pages, and the golden lens reading it. The
    same parts as the classic one (bg, arc = the pages behind, spine = the front page, pages = its lines, lens),
    and the lens sits in the same place, so every animation works with both."""
    import math
    bg, ink, pink, gold, pagec = colors
    k = S / 256.0
    P = lambda x, y: (ox + x * k, oy + y * k)
    white_bg = bg.upper() == "#FFFFFF"
    sh = page.new_shape()
    if "bg" in parts:                                   # the square, a soft light from above
        x0, y0, x1, y1, rr = 18.0, 18.0, 238.0, 238.0, 0.26 * 220
        top = mix(bg, "#FFFFFF", 0.16) if not white_bg else "#FFFFFF"
        bot = mix(bg, "#000000", 0.18) if not white_bg else "#EDEDF2"
        sh.draw_rect(fitz.Rect(P(x0, y0), P(x1, y1)), radius=0.26)
        sh.finish(color=None, fill=_rgb(mix(top, bot, 0.5)))
        sh.commit()
        sh = page.new_shape()
        N = max(10, min(72, int(220 * k / 3)))
        over = 2.0 / max(k, 0.01)                       # the strips overlap by 2 pixels: no lines between them
        e_ = 0.8 / max(k, 0.01)

        def inset(y):
            if y < y0 + rr:
                d = y0 + rr - y
                return rr - math.sqrt(max(0.0, rr * rr - d * d))
            if y > y1 - rr:
                d = y - (y1 - rr)
                return rr - math.sqrt(max(0.0, rr * rr - d * d))
            return 0.0
        for i in range(N):
            ya, yb = y0 + (y1 - y0) * i / N, min(y1, y0 + (y1 - y0) * (i + 1) / N + over)
            ia, ib = inset(ya) + e_, inset(yb) + e_
            if ya < y0 + 1:
                ya = y0 + e_
            if yb > y1 - 1:
                yb = y1 - e_
            sh.draw_polyline([P(x0 + ia, ya), P(x1 - ia, ya), P(x1 - ib, yb), P(x0 + ib, yb), P(x0 + ia, ya)])
            sh.finish(color=None, fill=_rgb(mix(top, bot, (i + 0.5) / N)), closePath=True)
        if white_bg:
            sh.draw_rect(fitz.Rect(P(x0, y0), P(x1, y1)), radius=0.26)
            sh.finish(color=_rgb("#D6D6DE"), width=max(0.5, 2 * k))
        sh.commit()
        sh = page.new_shape()
    page_col = pagec if not white_bg else "#FFFFFF"
    edge = None if not white_bg else _rgb("#C9C9D4")
    if "arc" in parts:                                  # the pages behind: documents bound together
        for ang, dx, dy, t in ((-12, -6, 6, 0.55), (-5, -2, 2, 0.30)):
            pts = _rrect_pts(128 + dx, 128 + dy, 104, 136, 12, ang)
            sh.draw_polyline([P(*q) for q in pts] + [P(*pts[0])])
            col = mix(page_col, bg, t) if not white_bg else mix("#FFFFFF", pink, 0.15 + t * 0.3)
            sh.finish(color=edge, width=1.2 * k, fill=_rgb(col), closePath=True)
        sh.commit()
        sh = page.new_shape()
    if "spine" in parts:                                # the front page, with a bookmark
        pts = _rrect_pts(134, 130, 104, 136, 12, 0)
        sh.draw_polyline([P(*q) for q in pts] + [P(*pts[0])])
        sh.finish(color=edge, width=1.2 * k, fill=_rgb(page_col), closePath=True)
        sh.draw_polyline([P(160, 62), P(176, 62), P(176, 98), P(168, 90), P(160, 98), P(160, 62)])
        sh.finish(color=None, fill=_rgb(pink), closePath=True)
        sh.commit()
        sh = page.new_shape()
    line_col = mix(page_col, bg if not white_bg else ink, 0.38)
    if "pages" in parts:                                # lines of writing
        for i, (xa, xb) in enumerate(((98, 150), (98, 170), (98, 162), (98, 140))[:max(1, pages + 1)]):
            y = 96 + i * 20
            sh.draw_line(P(xa, y), P(xb, y))
            sh.finish(color=_rgb(line_col), width=7 * k, lineCap=1)
        sh.commit()
        sh = page.new_shape()
    if "lens" in parts:
        dx, dy = lens
        cx, cy = 153 + dx, 121 + dy
        r = 27 * lens_scale
        ls = lens_scale
        sh.draw_circle(P(cx, cy), (r - 1) * k)          # the glass, with bigger writing in it
        sh.finish(color=None, fill=_rgb(mix(gold, "#FFFFFF", 0.75)), fill_opacity=0.55)
        for yy in (-9, 9):
            yy *= ls
            hw = math.sqrt(max(0.0, (r - 9 * ls) ** 2 - yy * yy))
            sh.draw_line(P(cx - hw, cy + yy), P(cx + hw * 0.6, cy + yy))
            sh.finish(color=_rgb(mix(line_col, bg if not white_bg else ink, 0.35)), width=9 * k * ls, lineCap=1)
        sh.draw_circle(P(cx + 2, cy + 3), r * k)        # a soft shadow, then the ring and the handle
        sh.finish(color=(0, 0, 0), width=15 * k * ls, stroke_opacity=0.18)
        sh.draw_line(P(cx + 21.5 * ls, cy + 22.5 * ls), P(cx + 46 * ls, cy + 47 * ls))
        sh.finish(color=(0, 0, 0), width=15 * k * ls, lineCap=1, stroke_opacity=0.18)
        sh.draw_circle(P(cx, cy), r * k)
        sh.finish(color=_rgb(gold), width=15 * k * ls)
        sh.draw_line(P(cx + 19.5 * ls, cy + 19.5 * ls), P(cx + 44 * ls, cy + 44 * ls))
        sh.finish(color=_rgb(gold), width=15 * k * ls, lineCap=1)
        pts = [P(cx + r * math.cos(math.radians(200 + i * 6)), cy + r * math.sin(math.radians(200 + i * 6)))
               for i in range(12)]
        sh.draw_polyline(pts)
        sh.finish(color=(1, 1, 1), width=3.4 * k * ls, closePath=False, lineCap=1, stroke_opacity=0.6)
        _logo_glint(sh, P, cx, cy, 19 * ls, glint)
    sh.commit()


def logo_icon_data(name, size, ring=False):
    """The logo as a picture (base64 PNG) in the chosen colours and the logo chosen in Personalise."""
    if LOGO_STYLE == "classic" and not ring and name in ICONS and size in ICONS[name]:
        return ICONS[name][size]                       # (the 4 first colours, drawn once; the others are drawn now)
    cols = LOGO_COLORS.get(name, LOGO_COLORS["Black"])
    if ring:
        return base64.b64encode(logo_ring_png(size, cols)).decode()
    return base64.b64encode(logo_frame_png(size, cols)).decode()


GOLD_RING, GOLD_LIGHT = "#B48A1C", "#FFFBE6"


def draw_gold_ring(page, fitz, S, head=None, ox=0.0, oy=0.0):
    """1.9.4: the golden line round the logo - a thin ring, and (head = 0…1) a brighter light that runs along it."""
    k = S / 256.0
    gap = 6 * k
    x0, y0, x1, y1 = ox + 18 * k - gap, oy + 18 * k - gap, ox + 238 * k + gap, oy + 238 * k + gap
    r = 0.24 * 220 * k + gap
    sh = page.new_shape()
    sh.draw_rect(fitz.Rect(x0, y0, x1, y1), radius=min(0.5, r / (x1 - x0)))
    sh.finish(color=_rgb(GOLD_RING), fill=None, width=max(0.8, 5 * k))
    if head is not None:
        pts = round_path(x0, y0, x1, y1, r, max(0.4, 2.0 * k))
        n = len(pts)
        tail = max(10, int(n * 0.3))
        h0 = int((head % 1.0) * n)
        parts = 10
        for i in range(parts):
            a0 = h0 - i * tail // parts
            seg = [pts[(a0 - j) % n] for j in range(tail // parts + 2)]
            sh.draw_polyline(seg)
            sh.finish(color=_rgb(mix(GOLD_LIGHT, "#F2C94C", min(1.0, i / (parts * 0.6)))), fill=None, closePath=False,
                      lineCap=1, width=max(1.0, (14 - i * 0.9) * k))
    sh.commit()


def logo_ring_png(size, colors, head=None):
    """The logo with its golden line (the window and taskbar icon; head = where the light is)."""
    fitz = _FITZ
    d = fitz.open()
    pg = d.new_page(width=size, height=size)
    draw_logo(pg, fitz, 0, 0, size, colors)
    if size >= 28:
        draw_gold_ring(pg, fitz, size, head)
    data = pg.get_pixmap(alpha=True).tobytes("png")
    d.close()
    return data


