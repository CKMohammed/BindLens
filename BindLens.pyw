def name_key(name):
    """A key that is the same for the same person written differently: 'Seán Ó Briain' = 'Sean O'Briain' =
    'O BRIAIN, Sean' -> ('sean', 'obriain'); Mc/Mac and Ní/Nic are read as one."""
    t = person_like(name) or (name or "")
    if "," in t:                                             # 'O BRIAIN, Sean' -> 'Sean O BRIAIN'
        a_, _, b_ = t.partition(",")
        t = b_.strip() + " " + a_.strip()
    t = fold(t)
    t = re.sub(r"[.]", " ", t)
    toks = [w for w in re.split(r"[\s-]+", t) if w and w not in TITLES]
    out = []
    k = 0
    while k < len(toks):
        w = toks[k].replace("'", "")
        if w in ("o", "ni", "ui", "ua") and k + 1 < len(toks):
            nxt = toks[k + 1].replace("'", "")
            if w in ("ni", "ui") and len(nxt) > 2 and nxt[1] == "h":
                nxt = nxt[0] + nxt[2:]                # Ní Bhriain -> o briain
            out.append("o" + nxt)
            k += 2
            continue
        if w in ("mac", "mc", "nic", "mhic") and k + 1 < len(toks):
            nxt = toks[k + 1].replace("'", "")
            if w in ("nic", "mhic") and len(nxt) > 2 and nxt[1] == "h":
                nxt = nxt[0] + nxt[2:]
            out.append("mac" + nxt)
            k += 2
            continue
        if w.startswith("mc") and len(w) > 3:
            w = "mac" + w[2:]
        out.append(w)
        k += 1
    if not out:
        return ("", "")
    return (out[0], out[-1] if len(out) > 1 else "")


def same_person(a, b):
    """Two names that are the same person (same surname; same first name, an alias, or one is an initial)."""
    ka, kb = name_key(a), name_key(b)
    if not ka[1] or ka[1] != kb[1]:
        return False
    fa, fb = ka[0], kb[0]
    if fa == fb or NAME_ALIASES.get(fa, fa) == NAME_ALIASES.get(fb, fb):
        return True
    return (len(fa) == 1 and fb.startswith(fa)) or (len(fb) == 1 and fa.startswith(fb))


# ---------------------------------------------------------------------------
# Charts for reports - drawn by BindLens itself (vector in PDF, picture in Word / preview, native in Excel).
# Quiet marks: thin bars with rounded ends, hairline grid, values at the tips, legend for 2+ series.
# ---------------------------------------------------------------------------
CHART_CAT = ["#2A78D6", "#EB6834", "#1BAF7A", "#EDA100", "#E87BA4", "#008300", "#4A3AA7", "#E34948"]
CHART_SEQ = ["#CDE2FB", "#B7D3F6", "#9EC5F4", "#86B6EF", "#6DA7EC", "#5598E7", "#3987E5", "#2A78D6", "#256ABF",
             "#1C5CAB", "#184F95", "#104281", "#0D366B"]
STATUS_COL = {"good": "#0CA30C", "warning": "#FAB219", "serious": "#EC835A", "critical": "#D03B3B", "none": "#B9B8B2"}
INK = {"primary": "#0B0B0B", "secondary": "#52514E", "muted": "#898781", "grid": "#E1E0D9", "base": "#C3C2B7",
       "surface": "#FFFFFF"}
DIVERGE = {"neg": ["#F4B9B8", "#E98685", "#D03B3B"], "mid": "#E6E5E1", "pos": ["#B7D3F6", "#6DA7EC", "#2A78D6"]}


_CH_FONTS = {}

# 1.9.6: reports and charts wear the app's colours (the accent of the theme in use) and a good font
_RT = {"accent": "#6C63FF", "logo": "Black", "style": "classic"}


def set_report_theme(accent=None, logo=None):
    """The accent colour (and logo colours) reports and charts are drawn with - the theme in use."""
    if accent and re.fullmatch(r"#[0-9A-Fa-f]{6}", accent):
        _RT["accent"] = accent.upper()
    name, _, style = str(logo or "").partition("|")
    if name in LOGO_COLORS:
        _RT["logo"] = name
        _RT["style"] = "classic"


def _lum(c):
    r, g, b = [int(c.lstrip("#")[i:i + 2], 16) / 255 for i in (0, 2, 4)]
    f = lambda v: v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4
    return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b)


def rt_accent():
    """The theme's accent, made dark enough to read on white paper (a pale accent gets a deeper step)."""
    a = _RT["accent"]
    k = 0.0
    while _lum(mix(a, "#000000", k)) > 0.30 and k < 0.6:
        k += 0.08
    return mix(a, "#000000", k) if k else a


def rt_seq(n=13):
    """A one-hue ramp light -> dark in the theme's colour (heat maps, calendars, word clouds)."""
    a = rt_accent()
    out = []
    for i in range(n):
        t = i / (n - 1)
        out.append(mix(a, "#FFFFFF", 0.86 * (1 - t / 0.55)) if t <= 0.55 else
                   mix(a, "#000000", 0.42 * (t - 0.55) / 0.45))
    return out


def rt_tint(k=0.85):
    return mix(rt_accent(), "#FFFFFF", k)


def report_font_files():
    """(regular, bold) font files for reports and charts: the computer's own UI font when it has one (Segoe UI on
    Windows), else a good open font. None = PDF's built-in Helvetica."""
    cands = []
    if os.name == "nt":
        fd = os.path.join(os.environ.get("WINDIR", r"C:\Windows"), "Fonts")
        cands += [(os.path.join(fd, "segoeui.ttf"), os.path.join(fd, "segoeuib.ttf")),
                  (os.path.join(fd, "calibri.ttf"), os.path.join(fd, "calibrib.ttf")),
                  (os.path.join(fd, "arial.ttf"), os.path.join(fd, "arialbd.ttf"))]
    elif sys.platform == "darwin":
        cands += [("/System/Library/Fonts/Supplemental/Arial.ttf", "/System/Library/Fonts/Supplemental/Arial Bold.ttf"),
                  ("/Library/Fonts/Arial.ttf", "/Library/Fonts/Arial Bold.ttf")]
    for base in ("/usr/share/fonts/truetype", "/usr/share/fonts/TTF", "/usr/share/fonts"):
        cands += [(f"{base}/crosextra/Carlito-Regular.ttf", f"{base}/crosextra/Carlito-Bold.ttf"),
                  (f"{base}/liberation/LiberationSans-Regular.ttf", f"{base}/liberation/LiberationSans-Bold.ttf"),
                  (f"{base}/dejavu/DejaVuSans.ttf", f"{base}/dejavu/DejaVuSans-Bold.ttf")]
    for r, b in cands:
        try:
            if os.path.isfile(r) and os.path.isfile(b):
                return r, b
        except Exception:
            pass
    return None


def _chf(bold=False):
    import pymupdf as _f
    k = "b" if bold else "r"
    if k not in _CH_FONTS:
        ff = _CH_FONTS.get("files", 0)
        if ff == 0:
            ff = _CH_FONTS["files"] = report_font_files()
        font = None
        if ff:
            try:
                font = _f.Font(fontfile=ff[1 if bold else 0])
            except Exception:
                font = None
        _CH_FONTS[k] = font or _f.Font("hebo" if bold else "helv")
    return _CH_FONTS[k]


def _tl(text, size=8, bold=False):
    try:
        return _chf(bold).text_length(str(text), fontsize=size)
    except Exception:
        return len(str(text)) * size * 0.5


def _ch_text(page, fitz, x, y, text, size=8, color=None, bold=False, align="l", maxw=None):
    text = str(text)
    if maxw is not None:
        if _tl(text, size, bold) > maxw:
            while text and _tl(text + "…", size, bold) > maxw:
                text = text[:-1]
            text = (text + "…") if text else ""
    tw = _tl(text, size, bold)
    if align == "r":
        x -= tw
    elif align == "c":
        x -= tw / 2
    if not text:
        return 0
    try:
        wr = fitz.TextWriter(page.rect, color=hex_to_rgb01(color or INK["primary"]))
        wr.append((x, y), text, font=_chf(bold), fontsize=size)
        wr.write_text(page)
    except Exception:
        pass
    return tw


def _fmt_num(v, unit=""):
    try:
        v = float(v)
    except Exception:
        return str(v)
    a = abs(v)
    if a >= 1e6:
        s = f"{v / 1e6:.1f}M"
    elif a >= 1e4:
        s = f"{v / 1e3:.1f}K"
    elif abs(v - round(v)) < 1e-9:
        s = f"{int(round(v)):,}"
    else:
        s = f"{v:,.1f}" if a >= 10 else f"{v:,.2f}"
    return f"{unit}{s}" if unit in ("€", "$", "£") else (f"{s}{unit}" if unit else s)


def _fmt_money(v, unit=""):
    """Money as written on an invoice: always the cents (190.65, 1,204.00) - charts keep the short form."""
    try:
        v = float(v)
    except Exception:
        return str(v)
    s = f"{v:,.2f}"
    return f"{unit}{s}" if unit in ("€", "$", "£") else (f"{s} {unit}" if unit else s)


def _nice_max(v):
    import math
    if v <= 0:
        return 1
    e = 10 ** math.floor(math.log10(v))
    for m in (1, 1.2, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10):
        if v <= m * e:
            return m * e
    return 10 * e


def _nice_scale(maxv, n=4, ints=False):
    """(top, step) of a value axis with round ticks: 0, 5, 10, 15 - never 3.75 (1.9.6)."""
    import math
    if maxv <= 0:
        return 1, 1
    raw = maxv / n
    e = 10 ** math.floor(math.log10(raw))
    step = 10 * e
    for m in (1, 2, 2.5, 5, 10):
        if raw <= m * e + 1e-12:
            step = m * e
            break
    if ints:
        step = max(1, round(step)) if step >= 1 else 1
    top = step * math.ceil(maxv / step - 1e-9)
    return top, step


def _bar(page, fitz, x0, y0, x1, y1, color, horizontal=True, r=3):
    """A bar with a rounded data-end and a square baseline end."""
    if x1 - x0 < 0.5 or y1 - y0 < 0.5:
        return
    sh = page.new_shape()
    rr = min(r, (y1 - y0) / 2 if horizontal else (x1 - x0) / 2, (x1 - x0) / 2 if horizontal else (y1 - y0) / 2)
    if rr >= 1:
        sh.draw_rect(fitz.Rect(x0, y0, x1, y1), radius=min(0.5, rr / max(1.0, min(x1 - x0, y1 - y0))))
        sh.finish(color=None, fill=hex_to_rgb01(color))
        if horizontal:
            sh.draw_rect(fitz.Rect(x0, y0, x0 + min(rr + 1, x1 - x0), y1))
        else:
            sh.draw_rect(fitz.Rect(x0, y1 - min(rr + 1, y1 - y0), x1, y1))
    else:
        sh.draw_rect(fitz.Rect(x0, y0, x1, y1))
    sh.finish(color=None, fill=hex_to_rgb01(color))
    sh.commit()


CH_GREY = "#C4C4C4"
CH_ALERT = "#D55E00"                 # Okabe-Ito red-orange: late, missing, over the limit (never red vs green)
CH_EXTRA = "#E69F00"
_NATURAL_ORDER = re.compile(r"^(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec|mon|tue|wed|thu|fri|sat|sun|"
                            r"q[1-4]\b|week|wk|under|over|up to|less|more than|\d|[<>≤≥]|before|after|today|this|"
                            r"next|last|first|second|third)", re.I)


def chart_rules(ch):
    """4.0: the same honest rules for every chart (Datawrapper, ONS, FT, IBCS): a pie of more than 5 parts becomes
    sorted bars; bars of things are sorted biggest first (months, days and bands keep their order); more than 15 ->
    the top 14 + 'Other (n)'; the colour only for what the finding is about, grey for the rest; and a finding line
    (what the chart shows, in words) when there is none."""
    if not isinstance(ch, dict) or ch.get("_ruled"):
        return ch
    ch["_ruled"] = True
    t = ch.get("type", "bar")
    series = ch.get("series") or []
    if t == "donut" and series:
        vals = list(series[0].get("values") or [])
        if sum(1 for v in vals if v) > 5:
            ch["type"] = t = "bar"
            if ch.get("colors"):
                ch["bar_colors"] = list(ch.pop("colors"))[:len(vals)]
            ch["series"] = series = [{"name": series[0].get("name") or ch.get("center") or "Total", "values": vals}]
    labels = [str(x) for x in (ch.get("labels") or [])]
    unit = ch.get("unit", "")
    if t == "bar" and len(series) == 1 and labels:
        vals = list(series[0].get("values") or [])[:len(labels)]
        n = len(vals)
        labels = labels[:n]
        numeric = n > 0 and all(isinstance(v, (int, float)) for v in vals)
        natural = ch.get("order") == "keep" or \
            sum(1 for lb in labels if _NATURAL_ORDER.match(lb.strip())) >= max(2, n * 0.6)
        vt = list(ch.get("value_text") or [])
        bc = list(ch.get("bar_colors") or [])
        if numeric and not natural and not bc:
            idx = sorted(range(n), key=lambda i: -(vals[i] or 0))
            if idx != list(range(n)):
                labels = [labels[i] for i in idx]
                vals = [vals[i] for i in idx]
                if len(vt) >= n:
                    vt = [vt[i] for i in idx]
            if n > 15 and all(v >= 0 for v in vals):
                rest = vals[14:]
                labels = labels[:14] + [f"Other ({len(rest)})"]
                vals = vals[:14] + [sum(rest)]
                if vt:
                    vt = vt[:14] + [_fmt_num(sum(rest), unit)]
            ch["labels"] = labels
            ch["series"] = [dict(series[0], values=vals)]
            if vt:
                ch["value_text"] = vt
        if numeric and not natural and not bc and not ch.get("colors") and len(vals) >= 4 and \
                all(v >= 0 for v in vals):
            f_ = (ch.get("finding") or "").lower()
            hot = {i for i, lb in enumerate(labels) if len(lb) >= 3 and lb.lower() in f_}
            sv_ = sorted(vals, reverse=True)
            if not hot and sv_[0] > sv_[1]:
                hot = {max(range(len(vals)), key=lambda i: vals[i])}
            if hot:                       # a tie at the top: no bar is singled out
                ch["bar_colors"] = [None if i in hot else CH_GREY for i in range(len(labels))]
        if numeric and not ch.get("finding") and len(vals) >= 2 and all(v >= 0 for v in vals) and sum(vals):
            sv = sorted(vals, reverse=True)
            i0 = max(range(len(vals)), key=lambda i: vals[i])
            txt = f"{labels[i0]} is highest: {_fmt_num(vals[i0], unit)}"
            if len(sv) > 1 and sv[0] == sv[1]:
                k_ = sum(1 for v in vals if v == sv[0])
                txt = f"{k_} are level at the top: {_fmt_num(sv[0], unit)} each"
            tot = sum(vals)
            if len(sv) > 1 and sv[1] and sv[0] / sv[1] >= 1.5:
                txt += f", {sv[0] / sv[1]:.1f}× the next"
            elif len(sv) >= 5 and 100 * sum(sv[:3]) / tot >= 50:
                txt += f" - the top 3 make {100 * sum(sv[:3]) / tot:.0f}% of the total"
            ch["finding"] = txt + "."
    elif t == "col" and len(series) == 1 and labels and not ch.get("finding"):
        vals = [v if isinstance(v, (int, float)) else 0 for v in (series[0].get("values") or [])][:len(labels)]
        if len(vals) >= 3 and any(vals):
            i0 = max(range(len(vals)), key=lambda i: vals[i])
            ch["finding"] = (f"Highest: {labels[i0]} ({_fmt_num(vals[i0], unit)}). "
                             f"Latest: {labels[len(vals) - 1]} ({_fmt_num(vals[-1], unit)}).")
    return ch


def chart_size(ch, width=520):
    """(width, height) a chart wants."""
    chart_rules(ch)
    t = ch.get("type", "bar")
    n = len(ch.get("labels") or [])
    title = 22 if ch.get("title") else 4
    if ch.get("finding"):                       # 1.9.6: the one line that says what the chart shows
        title += len(_wrap(ch["finding"], width - 4, 8.3)) * 8.3 * 1.3 + 4
    if t == "bar":
        ns = max(1, len(ch.get("series") or [1]))
        row = 16 if ns == 1 else 9 * ns + 8
        legend = 18 if ns > 1 else 0
        return width, title + legend + max(1, n) * row + 26
    if t == "heat":
        return width, title + 34 + len(ch.get("rows") or []) * 18 + 8
    if t == "stack":
        return width, title + 26 + max(1, n) * 22 + 10
    if t == "diverging":
        return width, title + 30 + max(1, n) * 20 + 12
    if t == "cloud":
        return width, max(160, min(320, 60 + len(ch.get("words") or []) * 4))
    if t == "network":
        return width, 150 + 12 * min(16, len(ch.get("nodes") or []))
    if t == "donut":
        return width, title + 170
    if t == "calendar":
        weeks = max(1, int(ch.get("weeks") or 53))
        cell = min(13.0, max(6.0, (width - 34) / weeks))
        return width, title + 16 + 7 * cell + 30
    if t == "timeline":
        return width, title + 30 + max(1, len(ch.get("items") or [])) * 17 + 18
    return width, title + 200


def draw_chart(fitz, page, rect, ch):
    """Draw one chart in rect. Returns clickable regions [(label, Rect)]."""
    chart_rules(ch)
    t = ch.get("type", "bar")
    regions = []
    x0, y0, x1, y1 = rect.x0, rect.y0, rect.x1, rect.y1
    if ch.get("title"):
        _ch_text(page, fitz, x0, y0 + 12, ch["title"], 10.5, INK["primary"], bold=True, maxw=rect.width)
        if ch.get("note"):
            tw = _tl(ch["title"], 10.5, True)
            _ch_text(page, fitz, x0 + tw + 8, y0 + 12, ch["note"], 8, INK["muted"], maxw=rect.width - tw - 8)
        y0 += 22
    if ch.get("finding"):
        f_lines = _wrap(ch["finding"], rect.width - 4, 8.3)
        _draw_lines(page, fitz, x0, y0 - 6, f_lines, 8.3, False, INK["secondary"], 1.3)
        y0 += len(f_lines) * 8.3 * 1.3 + 4
    labels = [str(x) for x in (ch.get("labels") or [])]
    series = ch.get("series") or []
    unit = ch.get("unit", "")
    colors = ch.get("colors")
    sh = page.new_shape()

    def legend(y, names, cols):
        x = x0
        for nm, c in zip(names, cols):
            s2 = page.new_shape()
            s2.draw_rect(fitz.Rect(x, y - 7, x + 9, y + 1), radius=0.3)
            s2.finish(color=None, fill=hex_to_rgb01(c))
            s2.commit()
            x += 13 + _ch_text(page, fitz, x + 13, y, nm, 8, INK["secondary"]) + 14
        return y + 10
    if t == "bar":
        ns = max(1, len(series))
        cols = colors or ([rt_accent()] if ns == 1 else CHART_CAT[:ns])
        if ns > 1:
            y0 = legend(y0 + 10, [s.get("name", "") for s in series], cols) + 2
        maxv = max([v for s in series for v in s.get("values", []) if isinstance(v, (int, float))] + [0])
        neg = min([v for s in series for v in s.get("values", []) if isinstance(v, (int, float))] + [0])
        lab_w = min(rect.width * 0.36, max([_tl(lb, 8) for lb in labels]
                                           + [20]) + 8)
        val_w = 46
        if ch.get("value_text"):
            val_w = min(rect.width * 0.34, max([_tl(t_, 7.5) for t_ in ch["value_text"] if t_] + [30]) + 10)
        px0, px1 = x0 + lab_w, x1 - val_w
        nums = [v for s_ in series for v in s_.get("values", []) if isinstance(v, (int, float))]
        ints = all(float(v).is_integer() for v in nums)
        top, step = _nice_scale(max(maxv, -neg if neg < 0 else 0), ints=ints)
        top = step * __import__("math").ceil(maxv / step - 1e-9) if maxv > 0 else 0
        if neg < 0:
            neg = -step * __import__("math").ceil(-neg / step - 1e-9)
        span = (top - neg) or 1
        nt = max(1, int(round(span / step)))
        zero = px0 + (px1 - px0) * ((-neg) / span) if neg < 0 else px0
        row = 16 if ns == 1 else 9 * ns + 8
        thick = min(12, row - 5) if ns == 1 else 8
        # 4.0: no grid and no value axis - every bar says its value at its end
        lolli = ns == 1 and len(labels) > 15
        sh.draw_line((zero, y0 - 2), (zero, y0 + len(labels) * row))
        sh.finish(color=hex_to_rgb01(INK["base"]), width=0.8)
        sh.commit()
        for i, lb in enumerate(labels):
            ry = y0 + i * row
            _ch_text(page, fitz, px0 - 6, ry + row / 2 + 3, lb, 8, INK["secondary"], align="r", maxw=lab_w - 8)
            for k, s in enumerate(series):
                vals = s.get("values", [])
                v = vals[i] if i < len(vals) else 0
                v = v if isinstance(v, (int, float)) else 0
                by = ry + (row - thick * ns - 2 * (ns - 1)) / 2 + k * (thick + 2)
                w_ = (px1 - px0) * abs(v) / span
                bcs = ch.get("bar_colors") or []
                c = (bcs[i] if i < len(bcs) else None) if ns == 1 and bcs else None
                c = c or cols[k % len(cols)]
                vt = (ch.get("value_text") or [None] * len(labels))
                vtxt = vt[i] if ns == 1 and i < len(vt) and vt[i] is not None else _fmt_num(v, unit)
                if v >= 0 and lolli:
                    s3 = page.new_shape()
                    s3.draw_line((zero, by + thick / 2), (zero + w_, by + thick / 2))
                    s3.finish(color=hex_to_rgb01(c), width=1.4)
                    s3.draw_circle((zero + w_, by + thick / 2), 3.4)
                    s3.finish(color=None, fill=hex_to_rgb01(c))
                    s3.commit()
                    _ch_text(page, fitz, zero + w_ + 6, by + thick / 2 + 3, vtxt, 7.5, INK["primary"],
                             maxw=max(30, x1 - (zero + w_ + 6)))
                elif v >= 0:
                    _bar(page, fitz, zero, by, zero + w_, by + thick, c)
                    _ch_text(page, fitz, zero + w_ + 4, by + thick / 2 + 3, vtxt, 7.5, INK["primary"],
                             maxw=max(30, x1 - (zero + w_ + 4)))
                else:
                    _bar(page, fitz, zero - w_, by, zero, by + thick, c)
                    _ch_text(page, fitz, zero - w_ - 4, by + thick / 2 + 3, vtxt, 7.5, INK["primary"],
                             align="r")
            regions.append((lb, fitz.Rect(x0, ry, x1, ry + row)))
        return regions
    if t in ("col", "line"):
        ns = max(1, len(series))
        cols = colors or ([rt_accent()] if ns == 1 else CHART_CAT[:ns])
        stacked = ch.get("stacked")
        if ns > 1:
            y0 = legend(y0 + 10, [s.get("name", "") for s in series], cols) + 4
        if stacked:
            tots = [sum((s.get("values", [0] * len(labels))[i] or 0) for s in series) for i in range(len(labels))]
            maxv = max(tots + [0])
        else:
            maxv = max([v for s in series for v in s.get("values", []) if isinstance(v, (int, float))] + [0])
        nums = [v for s_ in series for v in s_.get("values", []) if isinstance(v, (int, float))]
        top, step = _nice_scale(maxv, ints=all(float(v).is_integer() for v in nums))
        nt = max(1, int(round(top / step)))
        ax_w = max(_tl(_fmt_num(top, unit), 7), 14) + 6
        px0, px1 = x0 + ax_w, x1 - 4
        py0, py1 = y0 + 6, y1 - 20
        for k in range(0, nt + 1):
            gy = py1 - (py1 - py0) * k / nt
            sh.draw_line((px0, gy), (px1, gy))
            _ch_text(page, fitz, px0 - 4, gy + 2.5, _fmt_num(step * k, unit), 7, INK["muted"], align="r")
        sh.finish(color=hex_to_rgb01(INK["grid"]), width=0.5)
        sh.draw_line((px0, py1), (px1, py1))
        sh.finish(color=hex_to_rgb01(INK["base"]), width=0.8)
        sh.commit()
        n = max(1, len(labels))
        slot = (px1 - px0) / n
        every = max(1, int(n / max(1, (px1 - px0) / 46) + 0.999))
        for i, lb in enumerate(labels):
            cx = px0 + slot * (i + 0.5)
            if i % every == 0 or (i == n - 1 and (n - 1) % every >= max(1, every * 0.6)):
                _ch_text(page, fitz, cx, py1 + 11, lb, 7, INK["muted"], align="c", maxw=slot * every - 2)
            regions.append((lb, fitz.Rect(px0 + slot * i, py0, px0 + slot * (i + 1), py1 + 14)))
        if t == "col":
            if stacked:
                bw = min(24, slot * 0.62)
                for i in range(len(labels)):
                    cx = px0 + slot * (i + 0.5)
                    base = py1
                    for k, s in enumerate(series):
                        v = (s.get("values") or [0] * n)[i] or 0
                        h = (py1 - py0) * v / top
                        if h > 0.5:
                            last = all(((ss.get("values") or [0] * n)[i] or 0) == 0 for ss in series[k + 1:])
                            if last:
                                _bar(page, fitz, cx - bw / 2, base - h, cx + bw / 2, base - 1 if k else base,
                                     cols[k % len(cols)], horizontal=False)
                            else:
                                s2 = page.new_shape()
                                s2.draw_rect(fitz.Rect(cx - bw / 2, base - h + 1, cx + bw / 2, base - (1 if k else 0)))
                                s2.finish(color=None, fill=hex_to_rgb01(cols[k % len(cols)]))
                                s2.commit()
                            base -= h
                    tot = sum((s.get("values") or [0] * n)[i] or 0 for s in series)
                    if tot and n <= 16:
                        _ch_text(page, fitz, cx, base - 3, _fmt_num(tot, unit), 7, INK["primary"], align="c")
            else:
                gw = min(24 * ns + 2 * (ns - 1), slot * 0.7)
                bw = (gw - 2 * (ns - 1)) / ns
                v0s = (series[0].get("values") or [0] * n) if series else []
                imax = max(range(len(v0s)), key=lambda i: v0s[i] or 0) if v0s else -1
                partial = ch.get("partial_last")
                for i in range(len(labels)):
                    cx = px0 + slot * (i + 0.5)
                    for k, s in enumerate(series):
                        v = (s.get("values") or [0] * n)[i] or 0
                        h = (py1 - py0) * max(0, v) / top
                        bx = cx - gw / 2 + k * (bw + 2)
                        cc = cols[k % len(cols)]
                        if partial and i == len(labels) - 1:
                            # 4.0: this period is not over yet - lighter and dashed, so it does not read as a drop
                            _bar(page, fitz, bx, py1 - h, bx + bw, py1, mix(cc, "#FFFFFF", 0.6), horizontal=False)
                            if h > 1:
                                s3 = page.new_shape()
                                s3.draw_rect(fitz.Rect(bx, py1 - h, bx + bw, py1))
                                s3.finish(color=hex_to_rgb01(cc), width=0.8, dashes="[2 1.6] 0")
                                s3.commit()
                        else:
                            _bar(page, fitz, bx, py1 - h, bx + bw, py1, cc, horizontal=False)
                        if ns == 1 and v and (n <= 16 or i in (imax, n - 1)):
                            vt_ = _fmt_num(v, unit) + (" so far" if partial and i == len(labels) - 1 else "")
                            _ch_text(page, fitz, bx + bw / 2, py1 - h - 3, vt_, 7, INK["primary"], align="c")
        else:
            for k, s in enumerate(series):
                pts = []
                vals_ = s.get("values") or [0] * n
                for i in range(len(labels)):
                    v = vals_[i] if i < len(vals_) else None
                    if v is None:                          # no value yet (e.g. the months still to come)
                        continue
                    pts.append((px0 + slot * (i + 0.5), py1 - (py1 - py0) * (v or 0) / top))
                s2 = page.new_shape()
                if len(pts) > 1:
                    if ns == 1:
                        s2.draw_polyline(pts + [(pts[-1][0], py1), (pts[0][0], py1)])
                        s2.finish(color=None, fill=hex_to_rgb01(cols[k]), fill_opacity=0.10, closePath=True)
                    s2.draw_polyline(pts)
                    s2.finish(color=hex_to_rgb01(cols[k % len(cols)]), width=1.6, closePath=False, lineJoin=1,
                              lineCap=1)
                for p in pts[-1:]:                          # an end-dot (no marker on every point)
                    s2.draw_circle(p, 3.6)
                    s2.finish(color=hex_to_rgb01(INK["surface"]), width=1.2, fill=hex_to_rgb01(cols[k % len(cols)]))
                s2.commit()
                if pts:
                    v = next((x for x in reversed(vals_) if x is not None), 0) or 0
                    _ch_text(page, fitz, pts[-1][0] - 2, pts[-1][1] - 6, _fmt_num(v, unit), 7, INK["primary"],
                             align="r")
        return regions
    if t == "donut":
        import math
        vals = [max(0, float(v or 0)) for v in (series[0].get("values") if series else [])]
        cmap = dict(zip(labels, colors)) if colors else {}
        pairs = sorted(zip(labels, vals), key=lambda p: -p[1]) if not colors else list(zip(labels, vals))
        if len(pairs) > 7:
            pairs = pairs[:6] + [("Other", sum(v for _, v in pairs[6:]))]
        tot = sum(v for _, v in pairs) or 1
        cols = [cmap.get(lb, "#B9B8B2") for lb, _ in pairs] if colors else CHART_CAT
        R = min(70, (y1 - y0) / 2 - 6)
        cx, cy = x0 + R + 8, y0 + R + 6
        a = -90.0
        for k, (lb, v) in enumerate(pairs):
            ang = 360 * v / tot
            if ang <= 0:
                continue
            s2 = page.new_shape()
            steps = max(2, int(ang / 4))
            pts = [(cx + R * math.cos(math.radians(a + ang * j / steps)), cy + R * math.sin(math.radians(a + ang * j / steps)))
                   for j in range(steps + 1)]
            inner = [(cx + R * 0.58 * math.cos(math.radians(a + ang * j / steps)),
                      cy + R * 0.58 * math.sin(math.radians(a + ang * j / steps))) for j in range(steps, -1, -1)]
            s2.draw_polyline(pts + inner + [pts[0]])
            s2.finish(color=hex_to_rgb01(INK["surface"]), width=1.5, fill=hex_to_rgb01(cols[k % len(cols)]),
                      closePath=True)
            s2.commit()
            a += ang
        _ch_text(page, fitz, cx, cy + 1, _fmt_num(tot, unit), 13, INK["primary"], bold=True, align="c")
        _ch_text(page, fitz, cx, cy + 12, ch.get("center", "total"), 7, INK["muted"], align="c")
        ly = y0 + 10
        lx = cx + R + 22
        for k, (lb, v) in enumerate(pairs):
            s2 = page.new_shape()
            s2.draw_rect(fitz.Rect(lx, ly - 7, lx + 9, ly + 1), radius=0.3)
            s2.finish(color=None, fill=hex_to_rgb01(cols[k % len(cols)]))
            s2.commit()
            _ch_text(page, fitz, lx + 14, ly, lb, 8.5, INK["secondary"], maxw=x1 - lx - 120)
            _ch_text(page, fitz, x1 - 4, ly, f"{_fmt_num(v, unit)}  ·  {100 * v / tot:.0f}%", 8.5, INK["primary"],
                     align="r")
            regions.append((lb, fitz.Rect(lx, ly - 10, x1, ly + 4)))
            ly += 17
        return regions
    if t == "heat":
        rows = [str(r) for r in ch.get("rows") or []]
        cols_ = [str(c) for c in ch.get("cols") or []]
        mat = ch.get("matrix") or []
        mx = max([v for r in mat for v in r if isinstance(v, (int, float))] + [1])
        lab_w = min(rect.width * 0.3, max([_tl(r, 8) for r in rows] + [30]) + 8)
        cw = (x1 - x0 - lab_w) / max(1, len(cols_))
        for j, c in enumerate(cols_):
            _ch_text(page, fitz, x0 + lab_w + cw * (j + 0.5), y0 + 12, c, 7.5, INK["secondary"], align="c", maxw=cw - 2)
        yy = y0 + 22
        for i, r in enumerate(rows):
            _ch_text(page, fitz, x0 + lab_w - 6, yy + 12, r, 8, INK["secondary"], align="r", maxw=lab_w - 8)
            for j in range(len(cols_)):
                v = mat[i][j] if i < len(mat) and j < len(mat[i]) else 0
                v = v if isinstance(v, (int, float)) else 0
                seq = rt_seq()
                k = int((len(seq) - 1) * (v / mx)) if v else -1
                col = seq[k] if k >= 0 else "#F3F2EF"
                s2 = page.new_shape()
                s2.draw_rect(fitz.Rect(x0 + lab_w + cw * j + 1, yy + 1, x0 + lab_w + cw * (j + 1) - 1, yy + 17))
                s2.finish(color=None, fill=hex_to_rgb01(col))
                s2.commit()
                if v:
                    _ch_text(page, fitz, x0 + lab_w + cw * (j + 0.5), yy + 12, _fmt_num(v, unit), 7,
                             "#FFFFFF" if k >= 6 else INK["primary"], align="c", maxw=cw - 2)
            regions.append((r, fitz.Rect(x0, yy, x1, yy + 18)))
            yy += 18
        return regions
    if t in ("stack", "diverging"):
        names = [s.get("name", "") for s in series]
        n = len(labels)
        if t == "diverging":
            # series: negative ones first (strong -> mild), neutral, positive (mild -> strong)
            neg = ch.get("neg", 0)
            neu = ch.get("neutral", 0)
            npos = len(series) - neg - neu
            cols = (DIVERGE["neg"][-neg:][::-1] if neg else []) + ([DIVERGE["mid"]] * neu) + \
                (DIVERGE["pos"][-npos:] if npos > 0 else [])
            cols = colors or cols
        else:
            cols = colors or CHART_CAT
        y0 = legend(y0 + 10, names, cols) + 4
        lab_w = min(rect.width * 0.34, max([_tl(lb, 8) for lb in labels]
                                           + [20]) + 8)
        px0, px1 = x0 + lab_w, x1 - 4
        row = 22 if t == "stack" else 20
        for i, lb in enumerate(labels):
            ry = y0 + i * row
            vals = [max(0, float((s.get("values") or [0] * n)[i] or 0)) for s in series]
            tot = sum(vals) or 1
            _ch_text(page, fitz, px0 - 6, ry + row / 2 + 3, lb, 8, INK["secondary"], align="r", maxw=lab_w - 8)
            if t == "diverging":
                negs = sum(vals[:ch.get("neg", 0)]) + vals[ch.get("neg", 0)] / 2 if ch.get("neutral") else \
                    sum(vals[:ch.get("neg", 0)])
                mid = px0 + (px1 - px0) / 2
                x = mid - (px1 - px0) / 2 * negs / tot
            else:
                x = px0
            for k, v in enumerate(vals):
                w_ = (px1 - px0) * v / tot * (0.5 if t == "diverging" else 1)
                if t == "diverging":
                    w_ = (px1 - px0) / 2 * v / tot
                if w_ > 0.5:
                    s2 = page.new_shape()
                    s2.draw_rect(fitz.Rect(x + (1 if k else 0), ry + 4, x + w_, ry + row - 4))
                    s2.finish(color=None, fill=hex_to_rgb01(cols[k % len(cols)]))
                    s2.commit()
                    pct = 100 * v / tot
                    lab = f"{pct:.0f}%"
                    if _tl(lab, 7) + 6 < w_:
                        _ch_text(page, fitz, x + w_ / 2, ry + row / 2 + 2.5, lab, 7,
                                 "#FFFFFF" if not is_light(cols[k % len(cols)]) else INK["primary"], align="c")
                x += w_
            regions.append((lb, fitz.Rect(x0, ry, x1, ry + row)))
        if t == "diverging":
            s2 = page.new_shape()
            s2.draw_line((px0 + (px1 - px0) / 2, y0), (px0 + (px1 - px0) / 2, y0 + n * row))
            s2.finish(color=hex_to_rgb01(INK["base"]), width=0.8)
            s2.commit()
        return regions
    if t == "calendar":
        # 1.9.6: a calendar heat map - one square per day (weeks across, Monday to Sunday down), darker = more
        import datetime
        days = ch.get("days") or {}
        try:
            end = datetime.date.fromisoformat(ch.get("end")) if ch.get("end") else datetime.date.today()
        except Exception:
            end = datetime.date.today()
        weeks = max(1, int(ch.get("weeks") or 53))
        start = end - datetime.timedelta(days=end.weekday() + 7 * (weeks - 1))
        cell = min(13.0, max(6.0, (rect.width - 34) / weeks))
        gx0, gy0 = x0 + 28, y0 + 16
        mx = max([v for v in days.values() if isinstance(v, (int, float))] + [1])
        seq = rt_seq()
        last_month = None
        for w in range(weeks):
            d0 = start + datetime.timedelta(days=7 * w)
            if d0.month != last_month and (d0.day <= 7 or w == 0):
                if w < weeks - 2:
                    _ch_text(page, fitz, gx0 + w * cell, y0 + 10, d0.strftime("%b"), 7, INK["muted"])
                last_month = d0.month
            for k in range(7):
                d_ = d0 + datetime.timedelta(days=k)
                if d_ > end:
                    continue
                v = days.get(d_.isoformat(), 0) or 0
                lvl = 0 if not v else 1 + int(4 * (v / mx) ** 0.75 - 1e-9)
                col = ["#EEEDE8", seq[2], seq[5], seq[8], seq[11]][min(4, lvl)]
                s2 = page.new_shape()
                s2.draw_rect(fitz.Rect(gx0 + w * cell + 0.8, gy0 + k * cell + 0.8, gx0 + (w + 1) * cell - 0.8,
                                       gy0 + (k + 1) * cell - 0.8), radius=0.18)
                s2.finish(color=None, fill=hex_to_rgb01(col))
                s2.commit()
                if v:
                    regions.append((d_.strftime("%d %b %Y") + f" - {_fmt_num(v)}",
                                    fitz.Rect(gx0 + w * cell, gy0 + k * cell, gx0 + (w + 1) * cell,
                                              gy0 + (k + 1) * cell)))
        for k, nm in ((0, "Mon"), (2, "Wed"), (4, "Fri")):
            _ch_text(page, fitz, x0, gy0 + k * cell + cell * 0.75, nm, 6.5, INK["muted"])
        ly = gy0 + 7 * cell + 14
        lx = gx0 + weeks * cell - _tl("More", 7) - 4          # Less [] [] [] [] [] More - at the right
        _ch_text(page, fitz, lx + 4, ly, "More", 7, INK["muted"])
        for i_, col in enumerate(reversed(["#EEEDE8", seq[2], seq[5], seq[8], seq[11]])):
            s2 = page.new_shape()
            s2.draw_rect(fitz.Rect(lx - (i_ + 1) * 11, ly - 8, lx - i_ * 11 - 2, ly + 1), radius=0.18)
            s2.finish(color=None, fill=hex_to_rgb01(col))
            s2.commit()
        _ch_text(page, fitz, lx - 5 * 11 - 4, ly, "Less", 7, INK["muted"], align="r")
        if ch.get("foot"):
            _ch_text(page, fitz, gx0, ly, ch["foot"], 7, INK["muted"], maxw=rect.width * 0.5)
        return regions
    if t == "timeline":
        # 4.0: what is due when, and what is already late - one row each, a Today line, the window 30 days back to
        # 90 ahead; late in red-orange, the next 30 days in the theme's colour, later in grey (with words, not colour
        # alone: '8 days late', 'in 12 days')
        import datetime
        items = ch.get("items") or []
        back, ahead = int(ch.get("back", 30)), int(ch.get("ahead", 90))
        try:
            today = datetime.date.fromisoformat(ch["today"]) if ch.get("today") else datetime.date.today()
        except Exception:
            today = datetime.date.today()
        row = 17
        lab_w = min(rect.width * 0.36, max([_tl(it.get("label", ""), 8) for it in items] + [40]) + 10)
        px0, px1 = x0 + lab_w, x1 - 74
        span = float(back + ahead) or 1.0
        X = lambda d: px0 + (px1 - px0) * (max(-back, min(ahead, d)) + back) / span
        top = y0 + 22
        bottom = top + len(items) * row
        s2 = page.new_shape()
        s2.draw_rect(fitz.Rect(px0, top - 4, X(0), bottom))              # the past: lightly tinted
        s2.finish(color=None, fill=hex_to_rgb01(mix(CH_ALERT, "#FFFFFF", 0.93)))
        s2.commit()
        d_ = today - datetime.timedelta(days=back)
        d_ = d_.replace(day=1)
        while d_ <= today + datetime.timedelta(days=ahead):
            dd = (d_ - today).days
            if -back <= dd <= ahead:
                gx = X(dd)
                s2 = page.new_shape()
                s2.draw_line((gx, top - 4), (gx, bottom))
                s2.finish(color=hex_to_rgb01(INK["grid"]), width=0.5)
                s2.commit()
                if abs(gx - X(0)) > 30:
                    _ch_text(page, fitz, gx + 2, y0 + 12, d_.strftime("%b"), 7, INK["muted"])
            d_ = (d_ + datetime.timedelta(days=32)).replace(day=1)
        tx = X(0)
        s2 = page.new_shape()
        s2.draw_line((tx, top - 6), (tx, bottom + 2))
        s2.finish(color=hex_to_rgb01(INK["primary"]), width=1.1)
        s2.commit()
        _ch_text(page, fitz, tx, y0 + 12, "Today " + today.strftime("%d %b"), 7, INK["primary"], bold=True,
                 align="c")
        acc = rt_accent()
        for i, it in enumerate(items):
            cy = top + i * row + row / 2
            left = int(it.get("left", 0))
            _ch_text(page, fitz, px0 - 6, cy + 3, it.get("label", ""), 8, INK["secondary"], align="r",
                     maxw=lab_w - 10)
            s2 = page.new_shape()
            s2.draw_line((px0, cy), (px1, cy))
            s2.finish(color=hex_to_rgb01(INK["grid"]), width=0.4, dashes="[1 2] 0")
            s2.commit()
            col_ = CH_ALERT if left < 0 else (acc if left <= 30 else "#9A9A9A")
            px = X(left)
            s2 = page.new_shape()
            if left < -back or left > ahead:                        # outside the window: an arrow at its edge
                k_ = -1 if left < 0 else 1
                s2.draw_polyline([(px - 4 * k_, cy - 4), (px + 3 * k_, cy), (px - 4 * k_, cy + 4)])
                s2.finish(color=None, fill=hex_to_rgb01(col_), closePath=True)
            else:
                s2.draw_circle((px, cy), 4.2)
                s2.finish(color=hex_to_rgb01("#FFFFFF"), width=1.2, fill=hex_to_rgb01(col_))
            s2.commit()
            word = (f"{-left} day{'s' if left != -1 else ''} late" if left < 0 else
                    ("today" if left == 0 else f"in {left} day{'s' if left != 1 else ''}"))
            _ch_text(page, fitz, px1 + 8, cy + 3, word, 7.5, CH_ALERT if left < 0 else INK["primary"],
                     bold=left < 0 or left <= 7)
            regions.append((it.get("label", ""), fitz.Rect(x0, cy - row / 2, x1, cy + row / 2)))
        if ch.get("foot"):
            _ch_text(page, fitz, px0, bottom + 13, ch["foot"], 7, INK["muted"], maxw=rect.width - lab_w)
        return regions
    if t == "cloud":
        import math
        words = ch.get("words") or []
        if not words:
            return regions
        mx = max(c for _, c in words) or 1
        mn = min(c for _, c in words)
        placed = []
        cx, cy = (x0 + x1) / 2, (y0 + y1) / 2
        for k, (wd, c) in enumerate(words[:70]):
            f = 9 + 22 * ((c - mn) / max(1, mx - mn)) ** 0.7
            tw = _tl(wd, f, f > 18)
            th = f * 0.92
            ok = False
            a, rr = 0.0, 0.0
            while rr < max(x1 - x0, y1 - y0):
                bx = cx + rr * math.cos(a) * 1.6 - tw / 2
                by = cy + rr * math.sin(a) - th / 2
                box = fitz.Rect(bx - 2, by - 1, bx + tw + 2, by + th + 1)
                if box.x0 >= x0 and box.x1 <= x1 and box.y0 >= y0 and box.y1 <= y1 and \
                        not any(box.intersects(p) for p in placed):
                    ok = True
                    break
                a += 0.45
                rr += 0.9
            if not ok:
                continue
            placed.append(box)
            seq = rt_seq()
            shade = seq[min(len(seq) - 1, 5 + int(7 * (c - mn) / max(1, mx - mn)))]
            _ch_text(page, fitz, bx, by + th * 0.82, wd, f, shade, bold=f > 18)
            regions.append((wd, box))
        return regions
    if t == "network":
        import math
        nodes = ch.get("nodes") or []
        edges = ch.get("edges") or []
        if not nodes:
            return regions
        cx, cy = (x0 + x1) / 2, (y0 + y1) / 2
        rx, ry = (x1 - x0) / 2 - 95, (y1 - y0) / 2 - 18
        pos = {}
        for k, nd in enumerate(nodes):
            a = 2 * math.pi * k / len(nodes) - math.pi / 2
            pos[nd[0]] = (cx + rx * math.cos(a), cy + ry * math.sin(a))
        mw = max([e[2] for e in edges] + [1])
        for a_, b_, wgt in edges:
            if a_ in pos and b_ in pos:
                s2 = page.new_shape()
                s2.draw_line(pos[a_], pos[b_])
                s2.finish(color=hex_to_rgb01(rt_seq()[3 + int(6 * wgt / mw)]), width=0.6 + 2.4 * wgt / mw,
                          stroke_opacity=0.85)
                s2.commit()
        mx = max([nd[1] for nd in nodes] + [1])
        for name, cnt in nodes:
            p = pos[name]
            r = 3.5 + 6 * cnt / mx
            s2 = page.new_shape()
            s2.draw_circle(p, r)
            s2.finish(color=hex_to_rgb01(INK["surface"]), width=1.5, fill=hex_to_rgb01(rt_accent()))
            s2.commit()
            al = "l" if p[0] >= cx else "r"
            _ch_text(page, fitz, p[0] + (r + 3 if al == "l" else -r - 3), p[1] + 3, name, 7.5, INK["secondary"],
                     align=al, maxw=110)
            regions.append((name, fitz.Rect(p[0] - r - 2, p[1] - r - 2, p[0] + r + 2, p[1] + r + 2)))
        return regions
    return regions


def chart_doc(fitz, ch, width=520):
    W, H = chart_size(ch, width)
    doc = fitz.open()
    pg = doc.new_page(width=W + 16, height=H + 12)
    regions = draw_chart(fitz, pg, fitz.Rect(8, 6, W + 8, H + 6), ch)
    return doc, regions


def chart_png(fitz, ch, width=520, scale=2.0):
    """(png, width pt, height pt, regions) - regions in points of the picture."""
    doc, regions = chart_doc(fitz, ch, width)
    pg = doc[0]
    png = pg.get_pixmap(matrix=fitz.Matrix(scale, scale), alpha=False).tobytes("png")
    W, H = pg.rect.width, pg.rect.height
    doc.close()
    return png, W, H, regions


# ---------------------------------------------------------------------------
# Report writers: PDF (PyMuPDF), Word (.docx) and Excel (.xlsx) - no extra packages
# A report = {"title", "subtitle", "blocks": [...]} with blocks:
#   ("h", text) · ("h3", text) · ("p", text) · ("li", text)
#   ("kpis", [{"label", "value", "tone": good|warning|serious|critical|info, "note"}])   key numbers
#   ("alert", {"tone", "text"})                                                           a finding to act on
#   ("chart", chart dict - see draw_chart)
#   ("img", {"png", "w", "h", "caption"})                                                 rows as they look
#   ("table", {"name", "headers", "rows", "colors", "widths", "total_row"})
# ---------------------------------------------------------------------------
from xml.sax.saxutils import escape as xesc

TONE_COL = {"good": "#0CA30C", "warning": "#FAB219", "serious": "#EC835A", "critical": "#D03B3B", "info": "#2A78D6"}
TONE_BG = {"good": "#E7F6E7", "warning": "#FFF4DA", "serious": "#FDEDE6", "critical": "#FBE7E7", "info": "#E8F1FC"}
TONE_WORD = {"good": "OK", "warning": "Soon", "serious": "Check", "critical": "Act now", "info": "Note"}


def _cell_str(v):
    if v is None:
        return ""
    return str(v)


def _wrap(text, width, size=8.5, bold=False):
    """Lines of a text that fit a width (Helvetica, with €, accents…)."""
    f = _chf(bold)
    out = []
    for para in str(text).split("\n"):
        line = ""
        for w in para.split(" "):
            cand = (line + " " + w) if line else w
            if not line or f.text_length(cand, fontsize=size) <= width:
                line = cand
            else:
                out.append(line)
                line = w
        out.append(line)
    res = []
    for ln in out:
        while len(ln) > 1 and f.text_length(ln, fontsize=size) > width:
            k = len(ln)
            while k > 1 and f.text_length(ln[:k], fontsize=size) > width:
                k -= 1
            res.append(ln[:k])
            ln = ln[k:]
        res.append(ln)
    return res


def _draw_lines(page, fitz, x, y, lines, size=8.5, bold=False, color="#1F2328", lh=1.28):
    tw = fitz.TextWriter(page.rect, color=hex_to_rgb01(color))
    for k, ln in enumerate(lines):
        if ln:
            tw.append((x, y + size + k * size * lh), ln, font=_chf(bold), fontsize=size)
    tw.write_text(page)
    return len(lines) * size * lh


def _kpi_rows(kpis, per=4):
    return [kpis[i:i + per] for i in range(0, len(kpis), per)]


def _is_num_cell(v):
    if isinstance(v, (int, float)):
        return True
    t = str(v or "").strip()
    return bool(t) and bool(re.fullmatch(r"[-+(]?[€$£]?\s?[\d.,]+\s?(?:%|€|\$|£|h|hrs?|days?)?\)?", t))


def write_report_pdf(fitz, rep, path, accent="#6C63FF"):
    """1.9.6: a calm, minimal PDF - the app's accent colour, a good font, the BindLens logo and title on the first
    page, a fine frame round every page, page numbers. Pictures of rows are never cut; charts stay sharp; long
    tables repeat their column titles on each page; numbers line up on the right."""
    set_report_theme(accent, rep.get("_logo"))
    A = rt_accent()
    blocks = rep.get("blocks") or []
    wide = any(b[0] == "img" and b[1].get("w", 0) > 520 for b in blocks) or \
        any(b[0] == "table" and len(b[1].get("headers") or []) > 8 for b in blocks)
    W, H = (842, 595) if wide else (595, 842)
    FR, M = 22, 52
    BOT = H - 64
    CW = W - 2 * M
    doc = fitz.open()
    st = {"page": None, "y": 0}
    title = str(rep.get("title") or "Report")
    when = time.strftime("%d %B %Y").lstrip("0") if rep.get("_date") else ""     # 4.2: only when asked for
    logo_cols = LOGO_COLORS.get(_RT.get("logo"), LOGO_COLORS["Black"])
    ink2 = "#2D2D2F"

    def frame(page):
        sh = page.new_shape()
        sh.draw_rect(fitz.Rect(FR, FR, W - FR, H - FR), radius=0.018)
        sh.finish(color=hex_to_rgb01(rt_tint(0.70)), width=0.7)
        sh.commit()

    def new_page(first=False):
        page = doc.new_page(width=W, height=H)
        st["page"] = page
        frame(page)
        if first:
            try:
                draw_logo(page, fitz, M - 2, 44, 30, logo_cols, style=_RT.get("style"))
            except Exception:
                pass
            x = M + 32
            x += _ch_text(page, fitz, x, 64, "Bind", 11, INK["primary"], bold=True)
            _ch_text(page, fitz, x, 64, "Lens", 11, A)
            _ch_text(page, fitz, W - M, 64, when, 8.5, INK["muted"], align="r")
            st["y"] = 96
        else:
            try:
                draw_logo(page, fitz, M - 1, 33, 15, logo_cols, style=_RT.get("style"))
            except Exception:
                pass
            _ch_text(page, fitz, M + 18, 44, title, 7.5, INK["muted"], maxw=CW - 120)
            _ch_text(page, fitz, W - M, 44, when, 7.5, INK["muted"], align="r")
            st["y"] = 70

    def need(h):
        if st["page"] is None or st["y"] + h > BOT:
            new_page()
            return True
        return False

    def lines_h(lines, size, lh=1.38):
        return len(lines) * size * lh

    def text(t, size=9.6, color=ink2, bold=False, gap=5, x=None, width=None, lh=1.38):
        x = M if x is None else x
        lines = _wrap(t, (width or (W - M - x)), size, bold)
        k = 0
        while k < len(lines):                       # long paragraphs go on over the page
            room = max(1, int((BOT - st["y"]) // (size * lh)))
            part = lines[k:k + room]
            if st["y"] + lines_h(part, size, lh) > BOT and st["y"] > 80:
                new_page()
                continue
            _draw_lines(st["page"], fitz, x, st["y"], part, size, bold, color, lh)
            st["y"] += lines_h(part, size, lh)
            k += len(part)
        st["y"] += gap

    # ---- the first page: logo, title, a short line in the accent colour
    new_page(first=True)
    text(title, 21, INK["primary"], bold=True, gap=2, lh=1.22)
    if rep.get("subtitle"):
        text(str(rep["subtitle"]), 9.5, INK["muted"], gap=6)
    sh = st["page"].new_shape()
    sh.draw_rect(fitz.Rect(M, st["y"], M + 34, st["y"] + 2.6), radius=0.5)
    sh.finish(color=None, fill=hex_to_rgb01(A))
    sh.commit()
    st["y"] += 20
    for b in blocks:
        kind = b[0]
        if kind == "h":
            need(64)
            st["y"] += 8
            sh = st["page"].new_shape()
            sh.draw_rect(fitz.Rect(M, st["y"] + 4.5, M + 6, st["y"] + 10.5), radius=0.3)
            sh.finish(color=None, fill=hex_to_rgb01(A))
            sh.commit()
            text(b[1], 12.5, INK["primary"], bold=True, gap=6, x=M + 13, lh=1.25)
        elif kind == "h3":
            need(40)
            st["y"] += 2
            text(b[1], 10.5, INK["primary"], bold=True, gap=3, lh=1.25)
        elif kind == "p":
            text(b[1], 9.6, ink2, gap=6)
        elif kind == "li":
            need(14)
            _ch_text(st["page"], fitz, M + 2, st["y"] + 9.6, "•", 10, A, bold=True)
            text(b[1], 9.6, ink2, gap=3, x=M + 13)
        elif kind == "kpis":
            for line in _kpi_rows(b[1]):
                need(66)
                y0 = st["y"]
                n = max(1, len(line))
                cw = CW / n
                sh = st["page"].new_shape()
                sh.draw_line((M, y0), (W - M, y0))
                sh.draw_line((M, y0 + 54), (W - M, y0 + 54))
                for k in range(1, n):
                    sh.draw_line((M + k * cw, y0 + 10), (M + k * cw, y0 + 44))
                sh.finish(color=hex_to_rgb01(INK["grid"]), width=0.6)
                sh.commit()
                for k, kp in enumerate(line):
                    x = M + k * cw + (0 if k == 0 else 12)
                    lx = x
                    tone = kp.get("tone")
                    if tone in TONE_COL:
                        s2 = st["page"].new_shape()
                        s2.draw_circle((x + 3, y0 + 14.5), 3)
                        s2.finish(color=None, fill=hex_to_rgb01(TONE_COL[tone]))
                        s2.commit()
                        lx += 10
                    _ch_text(st["page"], fitz, lx, y0 + 17.5, str(kp.get("label", "")), 8, INK["muted"],
                             maxw=cw - 18 - (lx - x))
                    _ch_text(st["page"], fitz, x, y0 + 42, str(kp.get("value", "")), 18, INK["primary"], bold=True,
                             maxw=cw - 16)
                st["y"] = y0 + 64
        elif kind == "alert":
            al = b[1]
            tone = al.get("tone")
            word = TONE_WORD.get(tone, "")
            body_ = str(al.get("text", ""))
            lines = _wrap((word + ":  " if word else "") + body_, CW - 26, 9.3)
            h = lines_h(lines, 9.3, 1.32) + 12
            need(h + 6)
            r = fitz.Rect(M, st["y"], W - M, st["y"] + h)
            sh = st["page"].new_shape()
            sh.draw_rect(r, radius=min(0.25, 6 / max(1.0, h)))
            sh.finish(color=None, fill=hex_to_rgb01(TONE_BG.get(tone, "#F6F5F2")))
            sh.draw_rect(fitz.Rect(r.x0, r.y0 + 4, r.x0 + 3, r.y1 - 4), radius=0.5)
            sh.finish(color=None, fill=hex_to_rgb01(TONE_COL.get(tone, INK["muted"])))
            sh.commit()
            _draw_lines(st["page"], fitz, r.x0 + 14, r.y0 + 4.5, lines, 9.3, False, INK["primary"], 1.32)
            st["y"] += h + 7
        elif kind == "chart":
            try:
                cd, _reg = chart_doc(fitz, b[1], min(CW + 8, 640))
            except Exception:
                continue
            r = cd[0].rect
            k_ = min(1.0, (CW + 16) / max(1.0, r.width))
            need(r.height * k_ + 8)
            st["page"].show_pdf_page(fitz.Rect(M - 8, st["y"], M - 8 + r.width * k_, st["y"] + r.height * k_), cd, 0)
            cd.close()
            st["y"] += r.height * k_ + 10
        elif kind == "img":
            im = b[1]
            k = min(1.0, CW / max(1, im.get("w", 400)))
            w_, h_ = im.get("w", 400) * k, im.get("h", 60) * k
            cap = im.get("caption")
            need(h_ + (14 if cap else 0) + 8)
            if cap:
                _ch_text(st["page"], fitz, M, st["y"] + 9, cap, 8, INK["muted"], maxw=CW)
                st["y"] += 13
            st["page"].insert_image(fitz.Rect(M, st["y"], M + w_, st["y"] + h_), stream=im["png"])
            sh = st["page"].new_shape()
            sh.draw_rect(fitz.Rect(M, st["y"], M + w_, st["y"] + h_))
            sh.finish(color=hex_to_rgb01(INK["grid"]), width=0.5)
            sh.commit()
            st["y"] += h_ + 10
        elif kind == "table":
            t = b[1]
            hdr = [str(x) for x in (t.get("headers") or [])]
            n = len(hdr)
            if not n:
                continue
            ws = t.get("widths") or [1] * n
            ws = (list(ws) + [10] * n)[:n]
            tot = sum(ws) or 1
            cw = [CW * w / tot for w in ws]
            rows = t.get("rows") or []
            colors = t.get("colors") or []
            right = []
            for j in range(n):
                vals = [r[j] for r in rows[:300] if j < len(r) and str(r[j] if r[j] is not None else "").strip()]
                right.append(bool(vals) and sum(1 for v in vals if _is_num_cell(v)) >= 0.8 * len(vals))

            def measure(cells, bold=False, fill=None, size=8.6, header=False):
                wrapped = []
                for j in range(n):
                    c = cells[j] if j < len(cells) else ""
                    pad = 9 if j == 0 and fill else 3
                    wrapped.append(_wrap(_cell_str(c), max(10, cw[j] - pad - 4), size, bold))
                return wrapped, max([len(x) for x in wrapped] + [1]) * size * 1.3 + (8 if header else 9)

            def paint(wrapped, h_, bold=False, color=INK["primary"], fill=None, size=8.6, header=False, top=False):
                pg = st["page"]
                y = st["y"]
                if fill:
                    sh = pg.new_shape()
                    sh.draw_rect(fitz.Rect(M, y + 3, M + 3, y + h_ - 3), radius=0.5)
                    sh.finish(color=None, fill=hex_to_rgb01(fill))
                    sh.commit()
                x = M
                for j, lines in enumerate(wrapped):
                    pad = 9 if j == 0 and fill else 3
                    if right[j]:
                        tw = fitz.TextWriter(pg.rect, color=hex_to_rgb01(color))
                        for k_, ln in enumerate(lines):
                            if ln:
                                tw.append((x + cw[j] - 6 - _tl(ln, size, bold), y + 4 + size + k_ * size * 1.3), ln,
                                          font=_chf(bold), fontsize=size)
                        tw.write_text(pg)
                    else:
                        _draw_lines(pg, fitz, x + pad, y + 4, lines, size, bold, color, 1.3)
                    x += cw[j]
                sh = pg.new_shape()
                if top:
                    sh.draw_line((M, y), (W - M, y))
                    sh.finish(color=hex_to_rgb01(INK["base"]), width=0.9)
                sh.draw_line((M, y + h_), (W - M, y + h_))
                sh.finish(color=hex_to_rgb01(rt_tint(0.5) if header else "#ECEBE6"), width=0.9 if header else 0.5)
                sh.commit()
                st["y"] += h_

            head_w, head_h = measure(hdr, True, size=7.8, header=True)
            need(head_h + 26)
            paint(head_w, head_h, True, INK["muted"], size=7.8, header=True)
            for i, r in enumerate(rows):
                is_tot = bool(t.get("total_row") and i == len(rows) - 1)
                fill = colors[i] if i < len(colors) else None
                wr, h_ = measure(r, is_tot, fill=fill)
                if st["y"] + h_ > BOT:
                    new_page()
                    paint(head_w, head_h, True, INK["muted"], size=7.8, header=True)
                paint(wr, h_, is_tot, fill=fill, top=is_tot)
            st["y"] += 14
    # the name and the page number at the bottom of every page
    n = doc.page_count
    for i, pg in enumerate(doc):
        x = M
        x += _ch_text(pg, fitz, x, H - 38, "BindLens", 7.5, A, bold=True)
        _ch_text(pg, fitz, x + 6, H - 38, "·  " + title, 7.5, INK["muted"], maxw=CW - 90)
        _ch_text(pg, fitz, W - M, H - 38, f"{i + 1} / {n}", 7.5, INK["muted"], align="r")
    try:
        doc.subset_fonts()
    except Exception:
        pass
    doc.save(path, garbage=3, deflate=True)
    doc.close()


def _zip_write(path, files):
    tmp = path + ".bindlens-tmp"
    with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as z:
        for name, data in files.items():
            z.writestr(name, data)
    os.replace(tmp, path)


def write_report_docx(rep, path, accent="#6C63FF", fitz=None):
    acc = accent.lstrip("#").upper()

    def run(text, bold=False, color=None, size=None):
        props = ""
        if bold:
            props += "<w:b/>"
        if color:
            props += f'<w:color w:val="{color}"/>'
        if size:
            props += f'<w:sz w:val="{size}"/>'
        out = []
        for k, line in enumerate(_cell_str(text).split("\n")):
            if k:
                out.append("<w:br/>")
            out.append(f'<w:t xml:space="preserve">{xesc(line)}</w:t>')
        return f"<w:r>{'<w:rPr>' + props + '</w:rPr>' if props else ''}{''.join(out)}</w:r>"

    def para(text, style=None, shade=None, border=None, **kw):
        ppr = ""
        if style:
            ppr += f'<w:pStyle w:val="{style}"/>'
        if border:
            ppr += (f'<w:pBdr><w:left w:val="single" w:sz="24" w:space="6" w:color="{border}"/></w:pBdr>')
        if shade:
            ppr += f'<w:shd w:val="clear" w:color="auto" w:fill="{shade}"/>'
        ppr = f"<w:pPr>{ppr}</w:pPr>" if ppr else ""
        return f"<w:p>{ppr}{run(text, **kw)}</w:p>"

    body = [para(rep["title"], "Title")]
    media = {}

    def picture(png, wpt, hpt, caption=None):
        k = len(media) + 1
        media[k] = png
        cx, cy = int(wpt * 12700), int(hpt * 12700)
        if caption:
            body.append(para(caption, color="76767F", size=16))
        body.append(
            '<w:p><w:r><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0">'
            f'<wp:extent cx="{cx}" cy="{cy}"/><wp:docPr id="{k}" name="Picture {k}"/>'
            '<a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main">'
            '<a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture">'
            '<pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture">'
            f'<pic:nvPicPr><pic:cNvPr id="{k}" name="image{k}.png"/><pic:cNvPicPr/></pic:nvPicPr>'
            f'<pic:blipFill><a:blip r:embed="rIdImg{k}"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill>'
            f'<pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="{cx}" cy="{cy}"/></a:xfrm>'
            '<a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic>'
            '</wp:inline></w:drawing></w:r></w:p>')
    if rep.get("subtitle"):
        body.append(para(rep["subtitle"], "Subtitle"))
    for b in rep["blocks"]:
        if b[0] == "img":
            im = b[1]
            wpt = min(im.get("w", 480), 480)
            hpt = wpt * im.get("h", 100) / max(1, im.get("w", 480))
            picture(im["png"], wpt, hpt, im.get("caption"))
            continue
        if b[0] == "chart":
            if fitz is not None:
                png, W, H, _r = chart_png(fitz, b[1], 520, scale=2.4)
                picture(png, min(W, 480), min(W, 480) * H / max(1, W))
            continue
        if b[0] == "kpis":
            for line in _kpi_rows(b[1]):
                cw = int(9600 / max(1, len(line)))
                cells = []
                for kp in line:
                    fill = TONE_BG.get(kp.get("tone"), "#F4F4F5").lstrip("#")
                    cells.append(f'<w:tc><w:tcPr><w:tcW w:w="{cw}" w:type="dxa"/><w:shd w:val="clear" w:color="auto" '
                                 f'w:fill="{fill}"/></w:tcPr><w:p>{run(kp.get("value", ""), bold=True, size=34)}</w:p>'
                                 f'<w:p>{run(kp.get("label", ""), color="52514E", size=17)}</w:p></w:tc>')
                body.append('<w:tbl><w:tblPr><w:tblW w:w="5000" w:type="pct"/><w:tblBorders>'
                            '<w:insideV w:val="single" w:sz="18" w:color="FFFFFF"/></w:tblBorders>'
                            '<w:tblCellMar><w:top w:w="80" w:type="dxa"/><w:left w:w="140" w:type="dxa"/>'
                            '<w:bottom w:w="80" w:type="dxa"/></w:tblCellMar></w:tblPr>'
                            f'<w:tblGrid>{"".join(f"<w:gridCol w:w={chr(34)}{cw}{chr(34)}/>" for _ in line)}</w:tblGrid>'
                            f'<w:tr>{"".join(cells)}</w:tr></w:tbl>')
                body.append("<w:p/>")
            continue
        if b[0] == "alert":
            al = b[1]
            tone = al.get("tone")
            body.append(para((TONE_WORD.get(tone, "") + ":  " if tone else "") + al.get("text", ""),
                             shade=TONE_BG.get(tone, "#F4F4F5").lstrip("#"),
                             border=TONE_COL.get(tone, "#898781").lstrip("#")))
            continue
        if b[0] == "h":
            body.append(para(b[1], "Heading1"))
        elif b[0] == "h3":
            body.append(para(b[1], "Heading2"))
        elif b[0] == "p":
            body.append(para(b[1]))
        elif b[0] == "li":
            body.append(para("•  " + b[1]))
        elif b[0] == "table":
            t = b[1]
            n = len(t["headers"])
            widths = (list(t.get("widths") or [1] * n) + [10] * n)[:n]
            tot = sum(widths)
            tw = [int(9600 * w / tot) for w in widths]
            grid = "".join(f'<w:gridCol w:w="{w}"/>' for w in tw)
            rows = []

            def cell(v, w, header=False, fill=None):
                shd = f'<w:shd w:val="clear" w:color="auto" w:fill="{fill}"/>' if fill else ""
                return (f'<w:tc><w:tcPr><w:tcW w:w="{w}" w:type="dxa"/>{shd}</w:tcPr>'
                        f'<w:p>{run(v, bold=header, color="6B7280" if header else None, size=18 if header else 19)}'
                        f"</w:p></w:tc>")
            rows.append("<w:tr><w:trPr><w:tblHeader/></w:trPr>" +
                        "".join(cell(h, tw[j], True) for j, h in enumerate(t["headers"])) + "</w:tr>")
            colors = t.get("colors") or []
            for i, r in enumerate(t["rows"]):
                col = colors[i] if i < len(colors) else None
                fill = mix(col, "#FFFFFF", 0.55).lstrip("#") if col else None
                rows.append("<w:tr>" + "".join(cell(v, tw[j], fill=fill if j == 0 else None)
                                                for j, v in enumerate(list(r)[:n])) + "</w:tr>")
            body.append(
                '<w:tbl><w:tblPr><w:tblW w:w="5000" w:type="pct"/><w:tblBorders>'
                '<w:bottom w:val="single" w:sz="4" w:color="E4E4E7"/>'
                '<w:insideH w:val="single" w:sz="4" w:color="E4E4E7"/></w:tblBorders>'
                '<w:tblCellMar><w:top w:w="40" w:type="dxa"/><w:bottom w:w="40" w:type="dxa"/></w:tblCellMar>'
                f'</w:tblPr><w:tblGrid>{grid}</w:tblGrid>{"".join(rows)}</w:tbl>')
            body.append("<w:p/>")
    W = 'xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"'
    WD = (W + ' xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"'
          ' xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing"')
    document = (f'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document {WD}><w:body>'
                + "".join(body) +
                '<w:sectPr><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1134" w:right="1134" '
                'w:bottom="1134" w:left="1134" w:header="567" w:footer="567" w:gutter="0"/></w:sectPr>'
                "</w:body></w:document>")
    styles = (f'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:styles {W}>'
              '<w:docDefaults><w:rPrDefault><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/>'
              '<w:sz w:val="21"/></w:rPr></w:rPrDefault><w:pPrDefault><w:pPr><w:spacing w:after="80"/></w:pPr>'
              '</w:pPrDefault></w:docDefaults>'
              '<w:style w:type="paragraph" w:default="1" w:styleId="Normal"><w:name w:val="Normal"/></w:style>'
              '<w:style w:type="paragraph" w:styleId="Title"><w:name w:val="Title"/><w:basedOn w:val="Normal"/>'
              '<w:rPr><w:b/><w:sz w:val="44"/><w:color w:val="18181B"/></w:rPr></w:style>'
              '<w:style w:type="paragraph" w:styleId="Subtitle"><w:name w:val="Subtitle"/><w:basedOn w:val="Normal"/>'
              '<w:pPr><w:spacing w:after="240"/></w:pPr><w:rPr><w:color w:val="76767F"/><w:sz w:val="18"/></w:rPr>'
              '</w:style>'
              '<w:style w:type="paragraph" w:styleId="Heading1"><w:name w:val="heading 1"/><w:basedOn w:val="Normal"/>'
              '<w:pPr><w:keepNext/><w:spacing w:before="320" w:after="120"/><w:outlineLvl w:val="0"/></w:pPr>'
              f'<w:rPr><w:b/><w:sz w:val="28"/><w:color w:val="{acc}"/></w:rPr></w:style>'
              '<w:style w:type="paragraph" w:styleId="Heading2"><w:name w:val="heading 2"/><w:basedOn w:val="Normal"/>'
              '<w:pPr><w:keepNext/><w:spacing w:before="200" w:after="80"/><w:outlineLvl w:val="1"/></w:pPr>'
              '<w:rPr><w:b/><w:sz w:val="23"/><w:color w:val="3F3F46"/></w:rPr></w:style></w:styles>')
    ct = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
          '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
          '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
          '<Default Extension="xml" ContentType="application/xml"/>'
          '<Default Extension="png" ContentType="image/png"/>'
          '<Override PartName="/word/document.xml" '
          'ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/>'
          '<Override PartName="/word/styles.xml" '
          'ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.styles+xml"/></Types>')
    rels = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
            '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
            '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/'
            'officeDocument" Target="word/document.xml"/></Relationships>')
    drels = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
             '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
             '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/'
             'styles" Target="styles.xml"/>' +
             "".join(f'<Relationship Id="rIdImg{k}" Type="http://schemas.openxmlformats.org/officeDocument/2006/'
                     f'relationships/image" Target="media/image{k}.png"/>' for k in media) +
             '</Relationships>')
    files = {"[Content_Types].xml": ct, "_rels/.rels": rels, "word/document.xml": document,
             "word/styles.xml": styles, "word/_rels/document.xml.rels": drels}
    for k, data in media.items():
        files[f"word/media/image{k}.png"] = data
    _zip_write(path, files)


def _xl_col(i):
    s = ""
    i += 1
    while i:
        i, r = divmod(i - 1, 26)
        s = chr(65 + r) + s
    return s


def _xl_chart_xml(ch, sheet, first_row, n, ns):
    """A native Excel chart reading its numbers from the 'Charts' sheet."""
    t = ch.get("type", "bar")
    q = "'" + sheet.replace("'", "''") + "'"
    cat = f"{q}!$A${first_row + 1}:$A${first_row + n}"
    cols = ch.get("colors") or CHART_CAT
    title = xesc(ch.get("title", ""))
    tx = (f'<c:title><c:tx><c:rich><a:bodyPr/><a:p><a:pPr><a:defRPr sz="1100" b="1"/></a:pPr><a:r>'
          f'<a:rPr lang="en-US" sz="1100" b="1"/><a:t>{title}</a:t></a:r></a:p></c:rich></c:tx>'
          f'<c:overlay val="0"/></c:title><c:autoTitleDeleted val="0"/>') if title else '<c:autoTitleDeleted val="1"/>'
    sers = []
    for k in range(ns):
        col = _xl_col(1 + k)
        fill = cols[k % len(cols)].lstrip("#")
        dpts = ""
        if t == "donut":
            dpts = "".join(f'<c:dPt><c:idx val="{i}"/><c:bubble3D val="0"/><c:spPr><a:solidFill><a:srgbClr '
                           f'val="{cols[i % len(cols)].lstrip("#")}"/></a:solidFill></c:spPr></c:dPt>' for i in range(n))
        sp = (f'<c:spPr><a:ln w="22225" cap="rnd"><a:solidFill><a:srgbClr val="{fill}"/></a:solidFill>'
              f'<a:round/></a:ln></c:spPr><c:marker><c:symbol val="circle"/><c:size val="6"/></c:marker>') \
            if t == "line" else f'<c:spPr><a:solidFill><a:srgbClr val="{fill}"/></a:solidFill></c:spPr>'
        lbl = ('<c:dLbls><c:showLegendKey val="0"/><c:showVal val="1"/><c:showCatName val="0"/>'
               '<c:showSerName val="0"/><c:showPercent val="0"/><c:showBubbleSize val="0"/></c:dLbls>') \
            if (ns == 1 and t in ("bar", "col")) else ""
        if t == "donut":
            lbl = ('<c:dLbls><c:showLegendKey val="0"/><c:showVal val="0"/><c:showCatName val="0"/>'
                   '<c:showSerName val="0"/><c:showPercent val="1"/><c:showBubbleSize val="0"/></c:dLbls>')
        inv = '<c:invertIfNegative val="0"/>' if t in ("bar", "col", "stack", "diverging") else ""
        smooth = '<c:smooth val="0"/>' if t == "line" else ""
        sers.append(f'<c:ser><c:idx val="{k}"/><c:order val="{k}"/><c:tx><c:strRef><c:f>{q}!${col}${first_row}</c:f>'
                    f'</c:strRef></c:tx>{sp}{inv}{dpts}{lbl}<c:cat><c:strRef><c:f>{cat}</c:f></c:strRef></c:cat>'
                    f'<c:val><c:numRef><c:f>{q}!${col}${first_row + 1}:${col}${first_row + n}</c:f></c:numRef>'
                    f'</c:val>{smooth}</c:ser>')
    axes = ('<c:axId val="111"/><c:axId val="222"/>')
    if t == "donut":
        plot = (f'<c:doughnutChart><c:varyColors val="1"/>{"".join(sers)}<c:firstSliceAng val="0"/>'
                f'<c:holeSize val="58"/></c:doughnutChart>')
    elif t == "line":
        plot = f'<c:lineChart><c:grouping val="standard"/><c:varyColors val="0"/>{"".join(sers)}' \
               f'<c:marker val="1"/>{axes}</c:lineChart>'
    else:
        bar_dir = "col" if t == "col" else "bar"
        grouping = "percentStacked" if t in ("stack", "diverging") else ("stacked" if ch.get("stacked") else
                                                                         "clustered")
        overlap = '<c:overlap val="100"/>' if grouping != "clustered" else ""
        plot = (f'<c:barChart><c:barDir val="{bar_dir}"/><c:grouping val="{grouping}"/><c:varyColors val="0"/>'
                f'{"".join(sers)}<c:gapWidth val="70"/>{overlap}{axes}</c:barChart>')
    grid = ('<c:majorGridlines><c:spPr><a:ln w="6350"><a:solidFill><a:srgbClr val="E1E0D9"/></a:solidFill></a:ln>'
            '</c:spPr></c:majorGridlines>')
    ax = ""
    if t != "donut":
        horiz = t in ("bar", "stack", "diverging")
        ax = (f'<c:catAx><c:axId val="111"/><c:scaling><c:orientation val="{"maxMin" if horiz else "minMax"}"/>'
              f'</c:scaling><c:delete val="0"/><c:axPos val="{"l" if horiz else "b"}"/>'
              f'<c:numFmt formatCode="General" sourceLinked="0"/><c:tickLblPos val="nextTo"/><c:crossAx val="222"/>'
              f'<c:crosses val="{"max" if horiz else "autoZero"}"/><c:auto val="1"/><c:lblAlgn val="ctr"/>'
              f'<c:lblOffset val="100"/></c:catAx>'
              f'<c:valAx><c:axId val="222"/><c:scaling><c:orientation val="minMax"/>'
              f'{"" if t == "line" else chr(60) + "c:min val=" + chr(34) + "0" + chr(34) + "/" + chr(62)}'
              f'</c:scaling><c:delete val="0"/>'
              f'<c:axPos val="{"b" if horiz else "l"}"/>{grid}<c:numFmt formatCode="General" sourceLinked="1"/>'
              f'<c:tickLblPos val="nextTo"/><c:crossAx val="111"/><c:crosses val="autoZero"/>'
              f'<c:crossBetween val="between"/></c:valAx>')
    legend = '<c:legend><c:legendPos val="t"/><c:overlay val="0"/></c:legend>' if (ns > 1 or t == "donut") else ""
    return ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
            '<c:chartSpace xmlns:c="http://schemas.openxmlformats.org/drawingml/2006/chart" '
            'xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" '
            'xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">'
            '<c:roundedCorners val="0"/>'
            f'<c:chart>{tx}<c:plotArea><c:layout/>{plot}{ax}</c:plotArea>{legend}<c:plotVisOnly val="1"/>'
            '<c:dispBlanksAs val="gap"/></c:chart>'
            '<c:spPr><a:noFill/><a:ln><a:noFill/></a:ln></c:spPr></c:chartSpace>')


def write_report_xlsx(rep, path, fitz=None):
    """Summary sheet (key numbers, findings, text), a Charts sheet with real Excel charts, one sheet per table."""
    sheets = []
    summary = [[rep["title"]]]
    if rep.get("subtitle"):
        summary.append([rep["subtitle"]])
    summary.append([])
    last_h = None
    charts = []
    for b in rep["blocks"]:
        if b[0] in ("h", "h3"):
            last_h = b[1]
            summary.append([b[1]])
        elif b[0] in ("p", "li"):
            summary.append([b[1]])
        elif b[0] == "kpis":
            for kp in b[1]:
                v = kp.get("value", "")
                n = parse_number(v) if isinstance(v, str) and re.fullmatch(r"[\d.,]+", v.strip() or "x") else None
                summary.append([kp.get("label", ""), n if n is not None else v])
            summary.append([])
        elif b[0] == "alert":
            summary.append([(TONE_WORD.get(b[1].get("tone"), "") + ": " if b[1].get("tone") else "") +
                            b[1].get("text", "")])
        elif b[0] == "chart":
            charts.append(b[1])
            if b[1].get("finding"):
                summary.append([(b[1].get("title") or "Chart") + ":  " + b[1]["finding"]])
        elif b[0] == "table":
            t = b[1]
            sheets.append((t.get("name") or last_h or f"Table {len(sheets) + 1}", t))
    colors = sorted({c for _, t in sheets for c in (t.get("colors") or []) if c})
    fills = ['<fill><patternFill patternType="none"/></fill>', '<fill><patternFill patternType="gray125"/></fill>',
             '<fill><patternFill patternType="solid"><fgColor rgb="FFF4F4F5"/></patternFill></fill>']
    for c in colors:
        fills.append(f'<fill><patternFill patternType="solid"><fgColor rgb="FF{mix(c, "#FFFFFF", 0.45).lstrip("#")}"/>'
                     f'</patternFill></fill>')
    # cellXfs: 0 normal, 1 header, 2 title, 3 wrap, 4.. colour fills
    xfs = ['<xf numFmtId="0" fontId="0" fillId="0" borderId="0"/>',
           '<xf numFmtId="0" fontId="1" fillId="2" borderId="0" applyFont="1" applyFill="1"/>',
           '<xf numFmtId="0" fontId="2" fillId="0" borderId="0" applyFont="1"/>',
           '<xf numFmtId="0" fontId="0" fillId="0" borderId="0" applyAlignment="1">'
           '<alignment wrapText="1" vertical="top"/></xf>']
    for k in range(len(colors)):
        xfs.append(f'<xf numFmtId="0" fontId="0" fillId="{3 + k}" borderId="0" applyFill="1" applyAlignment="1">'
                   f'<alignment vertical="top"/></xf>')
    styles = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
              '<styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
              '<fonts count="3"><font><sz val="11"/><name val="Calibri"/></font>'
              '<font><b/><sz val="11"/><color rgb="FF52525B"/><name val="Calibri"/></font>'
              '<font><b/><sz val="16"/><name val="Calibri"/></font></fonts>'
              f'<fills count="{len(fills)}">{"".join(fills)}</fills>'
              '<borders count="1"><border><left/><right/><top/><bottom/><diagonal/></border></borders>'
              '<cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs>'
              f'<cellXfs count="{len(xfs)}">{"".join(xfs)}</cellXfs>'
              '<cellStyles count="1"><cellStyle name="Normal" xfId="0" builtinId="0"/></cellStyles>'
              '<dxfs count="0"/></styleSheet>')

    def cell(ref, v, style=0):
        if isinstance(v, (int, float)) and not isinstance(v, bool):
            return f'<c r="{ref}" s="{style}"><v>{v}</v></c>'
        v = _cell_str(v)
        if not v:
            return f'<c r="{ref}" s="{style}"/>' if style else ""
        if style == 0 and re.fullmatch(r"-?(?:0|[1-9]\d{0,11})(?:\.\d+)?", v):
            return f'<c r="{ref}" s="{style}"><v>{v}</v></c>'          # real numbers: Excel can add them up
        v = re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f]", "", v)[:32000]
        return f'<c r="{ref}" t="inlineStr" s="{style}"><is><t xml:space="preserve">{xesc(v)}</t></is></c>'

    def sheet_xml(rows, widths=None, header=True, title_rows=0, colors=None, wrap_cols=(), extra="",
                  bold_rows=()):
        out = []
        for i, r in enumerate(rows):
            cells = []
            for j, v in enumerate(r):
                st = 0
                if header and i == 0:
                    st = 1
                elif i < title_rows:
                    st = 2 if i == 0 else 0
                elif i in bold_rows:
                    st = 1
                elif colors and j == 0 and i - 1 < len(colors) and colors[i - 1]:
                    st = 4 + colors_index[colors[i - 1]]
                elif j in wrap_cols:
                    st = 3
                cells.append(cell(f"{_xl_col(j)}{i + 1}", v, st))
            out.append(f'<row r="{i + 1}">{"".join(cells)}</row>')
        cols = ""
        if widths:
            cols = "<cols>" + "".join(f'<col min="{j + 1}" max="{j + 1}" width="{w}" customWidth="1"/>'
                                      for j, w in enumerate(widths)) + "</cols>"
        pane = ('<sheetViews><sheetView workbookViewId="0"><pane ySplit="1" topLeftCell="A2" activePane="bottomLeft" '
                'state="frozen"/></sheetView></sheetViews>') if header and len(rows) > 1 else \
            '<sheetViews><sheetView workbookViewId="0"/></sheetViews>'
        af = (f'<autoFilter ref="A1:{_xl_col(max(len(rows[0]), 1) - 1)}{len(rows)}"/>'
              if header and len(rows) > 1 and rows[0] else "")
        return ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
                '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" '
                'xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">'
                f'{pane}{cols}<sheetData>{"".join(out)}</sheetData>{af}{extra}</worksheet>')

    colors_index = {c: k for k, c in enumerate(colors)}
    files = {}
    names = []
    used = set()
    rels_extra = {}
    overrides = []

    def safe_name(n):
        n = re.sub(r"[\[\]\*\?/\\:]", " ", n).strip()[:28] or "Sheet"
        base, k = n, 2
        while n.lower() in used:
            n = f"{base[:25]} {k}"
            k += 1
        used.add(n.lower())
        return n
    all_sheets = [("Summary", None)] + ([("Charts", "charts")] if charts else []) + sheets
    for idx, (name, t) in enumerate(all_sheets, 1):
        nm = safe_name(name)
        names.append(nm)
        if t is None:
            files[f"xl/worksheets/sheet{idx}.xml"] = sheet_xml(summary, [60, 22], header=False, title_rows=1)
        elif t == "charts":
            rows, anchors, cond, bold = [], [], [], []
            pics = []
            for ch in charts:
                start = len(rows)
                typ = ch.get("type")
                if typ == "heat":
                    rows.append([ch.get("title", "")])
                    bold.append(len(rows) - 1)
                    rows.append([""] + list(ch.get("cols") or []))
                    for r_, vals in zip(ch.get("rows") or [], ch.get("matrix") or []):
                        rows.append([r_] + list(vals))
                    ref = f"B{start + 3}:{_xl_col(len(ch.get('cols') or []))}{len(rows)}"
                    cond.append(f'<conditionalFormatting sqref="{ref}"><cfRule type="colorScale" priority="{len(cond) + 1}">'
                                '<colorScale><cfvo type="min"/><cfvo type="max"/><color rgb="FFEEF4FC"/>'
                                '<color rgb="FF184F95"/></colorScale></cfRule></conditionalFormatting>')
                    rows.append([])
                    continue
                if typ in ("cloud", "network", "calendar", "timeline"):
                    rows.append([ch.get("title", "")])
                    bold.append(len(rows) - 1)
                    if typ == "timeline":
                        rows.append(["What", "Date", "Days left"])
                        rows += [[it_.get("label", ""), it_.get("date", ""), it_.get("left", "")]
                                 for it_ in (ch.get("items") or [])]
                    elif typ == "cloud":
                        rows.append(["Word", "Times"])
                        rows += [[w_, c_] for w_, c_ in (ch.get("words") or [])]
                    elif typ == "calendar":
                        rows.append(["Day", ch.get("what", "Times")])
                        rows += [[d_, c_] for d_, c_ in sorted((ch.get("days") or {}).items()) if c_]
                    else:
                        rows.append(["Person", "With", "Times together"])
                        rows += [[a_, b_, w_] for a_, b_, w_ in (ch.get("edges") or [])]
                    if fitz is not None:
                        png, W, H, _r = chart_png(fitz, ch, 520, scale=1.6)
                        pics.append((png, start, W, H))
                    rows.append([])
                    rows += [[] for _ in range(max(0, int(chart_size(ch)[1] / 15) - (len(rows) - start)))]
                    continue
                series = ch.get("series") or []
                labels = ch.get("labels") or []
                rows.append(["" if typ != "donut" else ch.get("title", "")] + [s.get("name") or ch.get("title", "")
                                                                                or "Value" for s in series])
                for i, lb in enumerate(labels):
                    rows.append([lb] + [((s.get("values") or [])[i] if i < len(s.get("values") or []) else None)
                                        for s in series])
                anchors.append((ch, start + 1, len(labels), max(1, len(series))))
                height = max(len(labels) + 2, int(chart_size(ch)[1] / 15) + 2)
                rows += [[] for _ in range(max(1, height - len(labels) - 1))]
            draw_parts, drels = [], []
            for k, (ch, first, n, ns) in enumerate(anchors, 1):
                cn = len([f for f in files if f.startswith("xl/charts/")]) + 1
                files[f"xl/charts/chart{cn}.xml"] = _xl_chart_xml(ch, nm, first, n, ns)
                overrides.append(f'<Override PartName="/xl/charts/chart{cn}.xml" '
                                 f'ContentType="application/vnd.openxmlformats-officedocument.drawingml.chart+xml"/>')
                rid = f"rIdC{k}"
                drels.append(f'<Relationship Id="{rid}" Type="http://schemas.openxmlformats.org/officeDocument/2006/'
                             f'relationships/chart" Target="../charts/chart{cn}.xml"/>')
                h_rows = max(n + 2, int(chart_size(ch)[1] / 15) + 1)
                draw_parts.append(
                    f'<xdr:twoCellAnchor><xdr:from><xdr:col>{ns + 2}</xdr:col><xdr:colOff>0</xdr:colOff>'
                    f'<xdr:row>{first - 1}</xdr:row><xdr:rowOff>0</xdr:rowOff></xdr:from><xdr:to><xdr:col>{ns + 11}'
                    f'</xdr:col><xdr:colOff>0</xdr:colOff><xdr:row>{first - 1 + h_rows}</xdr:row><xdr:rowOff>0'
                    f'</xdr:rowOff></xdr:to><xdr:graphicFrame macro=""><xdr:nvGraphicFramePr><xdr:cNvPr id="{k + 1}" '
                    f'name="Chart {k}"/><xdr:cNvGraphicFramePr/></xdr:nvGraphicFramePr><xdr:xfrm><a:off x="0" y="0"/>'
                    f'<a:ext cx="0" cy="0"/></xdr:xfrm><a:graphic><a:graphicData '
                    f'uri="http://schemas.openxmlformats.org/drawingml/2006/chart"><c:chart '
                    f'xmlns:c="http://schemas.openxmlformats.org/drawingml/2006/chart" r:id="{rid}"/></a:graphicData>'
                    f'</a:graphic></xdr:graphicFrame><xdr:clientData/></xdr:twoCellAnchor>')
            for k, (png, start, W, H) in enumerate(pics, 1):
                files[f"xl/media/chartpic{k}.png"] = png
                rid = f"rIdP{k}"
                drels.append(f'<Relationship Id="{rid}" Type="http://schemas.openxmlformats.org/officeDocument/2006/'
                             f'relationships/image" Target="../media/chartpic{k}.png"/>')
                cx, cy = int(W * 12700), int(H * 12700)
                draw_parts.append(
                    f'<xdr:oneCellAnchor><xdr:from><xdr:col>4</xdr:col><xdr:colOff>0</xdr:colOff><xdr:row>{start}'
                    f'</xdr:row><xdr:rowOff>0</xdr:rowOff></xdr:from><xdr:ext cx="{cx}" cy="{cy}"/><xdr:pic>'
                    f'<xdr:nvPicPr><xdr:cNvPr id="{100 + k}" name="Picture {k}"/><xdr:cNvPicPr/></xdr:nvPicPr>'
                    f'<xdr:blipFill><a:blip r:embed="{rid}"/><a:stretch><a:fillRect/></a:stretch></xdr:blipFill>'
                    f'<xdr:spPr><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></xdr:spPr></xdr:pic>'
                    f'<xdr:clientData/></xdr:oneCellAnchor>')
            extra = "".join(cond)
            if draw_parts:
