def parse_question(q):
    """'John Smith - date, amount and invoice number' -> look for John Smith, take Date, Amount, Invoice number.
    Returns {"terms", "fields": [(label, kind)], "agg", "per": (kind, column), "types", "from", "to", "say"}."""
    import datetime
    text = " " + (q or "").strip() + " "
    out = {"terms": [], "fields": [], "agg": None, "per": None, "types": [], "from": None, "to": None}
    for m in re.finditer(r"[\"“”«»]([^\"“”«»]{2,60})[\"“”«»]", text):           # "quoted" = look for exactly this
        out["terms"].append(m.group(1).strip())
    rest = re.sub(r"[\"“”«»][^\"“”«»]{2,60}[\"“”«»]", " , ", text)
    found = []

    def take_fields(kinds):
        """Fields asked for (every way of saying them is taken out of the sentence)."""
        nonlocal rest
        for label, (words, kind) in ASK_FIELDS.items():
            if kind not in kinds:
                continue
            first, word = None, None
            for w in sorted(words, key=len, reverse=True):
                for mm in list(re.finditer(r"(?<![\w])" + re.escape(w) + r"(?![\w])", rest, re.I)):
                    if first is None or mm.start() < first:
                        first, word = mm.start(), mm.group(0)
                    rest = rest[:mm.start()] + " " * len(mm.group(0)) + rest[mm.end():]
            if first is not None:
                lab = label
                if kind in ("Amounts", "Dates") and word and re.fullmatch(r"[a-z ]+", word.lower()) and \
                        word.lower() not in ("amounts", "amount", "dates", "date", "when", "day", "money"):
                    lab = word[:1].upper() + word[1:].lower()       # 'Fee', 'Total': as you wrote it
                found.append((first, lab, kind))
    take_fields({"invoice", "dob", "pps", "iban", "ref"})          # long names first ('number of', 'date of…')
    for kind, pat in (("count", r"\b(how many|count|number of|cuántos|cuantos|cuántas|cuantas|contar|número de)\b"),
                      ("avg", r"\b(average|mean|avg|media|promedio)\b"),
                      ("max", r"\b(highest|largest|biggest|maximum|max|mayor|máximo)\b"),
                      ("min", r"\b(lowest|smallest|minimum|min|menor|mínimo)\b"),
                      ("sum", r"\b(sum|add up|how much|in total|total of|total amount|suma|sumar|cuánto|cuanto|"
                              r"en total|total de|importe total)\b")):
        if re.search(pat, rest, re.I):
            out["agg"] = kind
            rest = re.sub(pat if kind != "sum" else r"\b(sum|add up|how much|in total|suma|sumar|cuánto|cuanto|"
                                                    r"en total)\b", " ", rest, flags=re.I)
            break
    m = re.search(r"\b(?:per|by|for each|each|por cada|por|agrupad[oa]s? por|grouped by)\s+([a-záéíóúñ][\w ]{1,24}?)"
                  r"(?=$|[,.;:]|\s+(?:and|y|in|en|from|de|desde|for|para|with|con)\b|\s*$)", rest, re.I)
    if m:
        what = m.group(1).strip().lower()
        kind = next((k for k, p in ASK_GROUPS if re.fullmatch(p, what)), None)
        out["per"] = (kind, None) if kind else ("col", m.group(1).strip())
        rest = rest[:m.start()] + " " + rest[m.end():]
        out["agg"] = out["agg"] or "sum"
    take_fields({"Dates", "Amounts", "Phone numbers", "Emails", "Addresses", "name"})
    out["fields"] = [(lab, kind) for _p, lab, kind in sorted(found)]
    for label, pat in ASK_TYPES:                                    # only some kinds of documents
        if re.search(r"\b(" + pat + r")\b", rest, re.I):
            out["types"].append(label)
            rest = re.sub(r"\b(" + pat + r")\b", " ", rest, flags=re.I)
    today = datetime.date.today()                                    # when
    ds = parse_dates(rest)
    if len(ds) >= 2:
        out["from"], out["to"] = min(ds[:2]), max(ds[:2])
        rest = EXTRACT_PATTERNS["Dates"].sub(" ", rest)
        rest = re.sub(r"\b(from|to|between|desde|hasta|entre)\b", " ", rest, flags=re.I)
    for pat, rng in ((r"\b(this month|este mes)\b", "tm"), (r"\b(last month|el mes pasado|mes pasado)\b", "lm"),
                     (r"\b(this year|este año)\b", "ty"), (r"\b(last year|el año pasado|año pasado)\b", "ly")):
        if out["from"] is None and re.search(pat, rest, re.I):
            first = today.replace(day=1)
            if rng == "tm":
                out["from"], out["to"] = first, today
            elif rng == "lm":
                last = first - datetime.timedelta(days=1)
                out["from"], out["to"] = last.replace(day=1), last
            elif rng == "ty":
                out["from"], out["to"] = today.replace(month=1, day=1), today.replace(month=12, day=31)
            else:
                out["from"], out["to"] = datetime.date(today.year - 1, 1, 1), datetime.date(today.year - 1, 12, 31)
            rest = re.sub(pat, " ", rest, flags=re.I)
    m = re.search(r"\b(?:in|en|of|de|during|durante)?\s*(" + "|".join(sorted(_ASK_MONTHS, key=len, reverse=True)) +
                  r")\b(?:\s+(?:of\s+|de\s+)?((?:19|20)\d{2}))?", rest, re.I)
    if m and out["from"] is None:
        mon = _ASK_MONTHS[m.group(1).lower()]
        yr = int(m.group(2)) if m.group(2) else today.year
        last_day = (datetime.date(yr + (mon == 12), mon % 12 + 1, 1) - datetime.timedelta(days=1)).day
        out["from"], out["to"] = datetime.date(yr, mon, 1), datetime.date(yr, mon, last_day)
        rest = rest[:m.start()] + " " + rest[m.end():]
    m = re.search(r"\b(?:in|en|of|de|during|durante)?\s*((?:19|20)\d{2})\b", rest)
    if m and out["from"] is None:
        yr = int(m.group(1))
        out["from"], out["to"] = datetime.date(yr, 1, 1), datetime.date(yr, 12, 31)
        rest = rest[:m.start()] + " " + rest[m.end():]
    # what is left: names / values to look for - and column names after a dash or 'give me'
    parts = re.split(r"\s[-–—:]\s|\b(?:and give me|give me|get me|with their|with the|with|y dame|dame|con sus|con)\b",
                     rest, maxsplit=1, flags=re.I)
    head, tail = parts[0], (parts[1] if len(parts) > 1 else "")

    def clean(s_):
        toks = [t for t in re.split(r"\s+", s_.strip(" ,.;:?¿!¡-–—")) if t]
        keep = [t for t in toks if t.lower().strip(",.;:?¿!¡") not in ASK_FILLER]
        return " ".join(keep).strip(" ,.;:?¿!¡")
    cols = []
    for piece in re.split(r",|;|\band\b|\by\b|\bor\b|\bo\b", head):
        c_ = clean(piece)
        if not c_ or len(c_) < 2 or c_ in out["terms"]:
            continue
        if out["agg"] and c_ == c_.lower() and not re.search(r"\d", c_):
            cols.append(c_)                 # 'hours per child': hours is what is added up (a column)
        else:
            out["terms"].append(c_)
    for piece in re.split(r",|;|\band\b|\by\b", tail):              # other things to take = column names
        c_ = clean(piece)
        if c_ and len(c_) >= 2:
            cols.append(c_)
    for c_ in cols:
        if not any(c_.lower() == f[0].lower() for f in out["fields"]):
            out["fields"].append((c_[:1].upper() + c_[1:], "col"))
    if out["agg"] in ("sum", "avg", "max", "min") and not any(k in ("Amounts", "col") for _l, k in out["fields"]):
        out["fields"].append(("Amount", "Amounts"))
    if (out["per"] and out["per"][0] in ("month", "year") or out["from"]) and \
            not any(k == "Dates" for _l, k in out["fields"]):
        out["fields"].insert(0, ("Date", "Dates"))
    out["say"] = ask_summary(out)
    return out


def ask_summary(a):
    """What BindLens understood, in one line (shown while you type, and on the report)."""
    parts = []
    if a["terms"]:
        parts.append("Look for: " + ", ".join(a["terms"][:5]))
    if a["types"]:
        parts.append("Only: " + ", ".join(t.split(" /")[0].lower() + "s" for t in a["types"]))
    if a["fields"]:
        parts.append("Take: " + ", ".join(l for l, _k in a["fields"]))
    if a["agg"] and a["per"]:
        num = next((l for l, k in a["fields"] if k in ("Amounts", "col")), "rows")
        per = a["per"][1] if a["per"][0] == "col" else {"month": "month", "year": "year", "person": "person",
                                                         "file": "document", "org": "organisation",
                                                         "book": "book"}[a["per"][0]]
        how = {"sum": "Add up", "count": "Count", "avg": "Average of", "max": "Highest", "min": "Lowest"}[a["agg"]]
        parts.append(f"{how} {num if a['agg'] != 'count' else 'rows'} per {per}")
    elif a["agg"]:
        parts.append({"sum": "Add up", "count": "Count", "avg": "Average", "max": "Highest", "min": "Lowest"}[a["agg"]])
    if a["from"]:
        parts.append(f"Dates: {a['from'].strftime('%d/%m/%Y')} - {a['to'].strftime('%d/%m/%Y')}")
    return "  ·  ".join(parts) if parts else ""


def ask_value(row, label, kind):
    """The value of one field on one row: a column with that title, a 'Label: value', or a value of that kind."""
    text = row.get("text", "")
    syn = ASK_FIELDS.get(label, ([], None))[0]
    if not syn and kind != "col":                      # 'Fee', 'Total'… asked as an amount: its other names too
        syn = next((w for w, k in ASK_FIELDS.values() if k == kind), [])
    names = [label.lower()] + [w for w in syn if len(w) > 2 and w != label.lower()]
    hdr = row.get("header") or []
    cells = row.get("cells", [])
    for n in names:                                    # the word you used first, then its other names
        for h, c in zip(hdr, cells):
            hl = (h or "").lower().strip()
            if hl and c and (n == hl or re.search(r"(?<!\w)" + re.escape(n) + r"(?!\w)", hl) or
                             (len(hl) >= 4 and len(hl) >= 0.6 * len(n) and hl in n)):
                if kind in EXTRACT_PATTERNS and not find_values(kind, c):
                    continue
                return c.strip()
    if kind == "invoice":
        m = INVOICE_NO_RE.search(text)
        return m.group(1) if m else ""
    if kind == "ref":
        m = REF_NO_RE.search(text)
        return m.group(1) if m else ""
    if kind == "dob":
        m = PII_PATTERNS["Date of birth"].search(text)
        return m.group(1) if m else ""
    if kind == "pps":
        m = PII_PATTERNS["PPS number"].search(text)
        return m.group(0) if m else ""
    if kind == "iban":
        m = PII_PATTERNS["IBAN / bank account"].search(text)
        return m.group(0) if m else ""
    if kind == "name":
        return person_name(row) if row.get("cells") else ""
    for n in names:                                            # 'Total due: €1,230.00' · 'Hours - 8'
        m = re.search(r"(?<!\w)" + re.escape(n) + r"(?:\s*(?:due|no\.?|number))?\s*[:=–-]\s*([^|]{1,60}?)\s*(?:\||$)",
                      text, re.I)
        if m:
            v = m.group(1).strip()
            if kind in EXTRACT_PATTERNS:
                vs = find_values(kind, v)
                if vs:
                    return vs[0]
                continue
            return v
    if kind in EXTRACT_PATTERNS:
        vs = find_values(kind, text)
        if vs:
            return vs[-1] if kind == "Amounts" else vs[0]
    return ""


def read_list_file(path):
    """First column of a .txt / .csv / .xlsx file (no extra libraries needed)."""
    ext = os.path.splitext(path)[1].lower()
    vals = []
    if ext == ".xlsx":
        import zipfile
        import xml.etree.ElementTree as ET
        ns = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
        with zipfile.ZipFile(path) as z:
            shared = []
            if "xl/sharedStrings.xml" in z.namelist():
                for si in ET.fromstring(z.read("xl/sharedStrings.xml")).iter(ns + "si"):
                    shared.append("".join(t.text or "" for t in si.iter(ns + "t")))
            sheets = sorted(n for n in z.namelist() if re.match(r"xl/worksheets/sheet\d+\.xml$", n))
            root = ET.fromstring(z.read(sheets[0]))
            for c in root.iter(ns + "c"):
                ref = c.get("r", "")
                if not re.match(r"A\d+$", ref):
                    continue
                t = c.get("t")
                if t == "s":
                    v = c.find(ns + "v")
                    val = shared[int(v.text)] if v is not None else ""
                elif t == "inlineStr":
                    val = "".join(x.text or "" for x in c.iter(ns + "t"))
                else:
                    v = c.find(ns + "v")
                    val = v.text if v is not None else ""
                    if val and re.match(r"^-?\d+\.0$", val):
                        val = val[:-2]
                vals.append(val)
    else:
        import csv
        with open(path, encoding="utf-8-sig", errors="replace") as fh:
            text = fh.read()
        if ext == ".csv":
            try:
                dialect = csv.Sniffer().sniff(text[:2000], delimiters=",;\t")
            except Exception:
                dialect = csv.excel
            for row in csv.reader(text.splitlines(), dialect):
                if row:
                    vals.append(row[0])
        else:
            vals = text.splitlines()
    out = []
    for v in vals:
        v = " ".join(str(v).split())
        if v and v not in out:
            out.append(v)
    return out


def parse_dates(text):
    """Every date found in a text, as datetime.date (day first for 03/04/2026)."""
    return [d for d, _a, _b in parse_dates_at(text)]


def parse_dates_at(text):
    """Every date in a text with where it is: [(date, start, end)]. 3.0: a two-digit year far in the future is
    the last century (a date of birth '15/06/85' is 1985, not 2085)."""
    import datetime
    out = []
    this_year = datetime.date.today().year
    for m in EXTRACT_PATTERNS["Dates"].finditer(text or ""):
        v = m.group(0).lower().replace(",", " ").replace(" de ", " ")
        try:
            n = re.match(r"(\d{1,2})[/.-](\d{1,2})[/.-](\d{2,4})$", v)
            if n:
                d, mo, y = map(int, n.groups())
                if y < 100:
                    y = y + 2000 if y + 2000 <= this_year + 30 else y + 1900
                out.append((datetime.date(y, mo, d), m.start(), m.end()))
                continue
            n = re.match(r"(\d{4})-(\d{2})-(\d{2})$", v)
            if n:
                out.append((datetime.date(*map(int, n.groups())), m.start(), m.end()))
                continue
            parts = re.findall(r"[a-záéíóú]+|\d+", v)
            nums = [int(p) for p in parts if p.isdigit()]
            mon = next((_MONTHS[p.rstrip(".")] for p in parts if p.rstrip(".") in _MONTHS), None)
            year = next((x for x in nums if x > 31), None)
            day = next((x for x in nums if x <= 31), None)
            if mon and year and day:
                out.append((datetime.date(year, mon, day), m.start(), m.end()))
        except ValueError:
            pass
    return out


NOT_EXPIRY = re.compile(r"\b(issued?|date of issue|issue date|received|d\.?o\.?b\.?|date of birth|birth|born|"
                        r"started?|start date|signed|completed|attended|commenced|joined|from|printed|"
                        r"created|dated)\b", re.I)
EXPIRY_COL = re.compile(r"expir|valid|renew|due|review|deadline|until|ends?\b|caduc|vence", re.I)


def expiry_dates(row):
    """3.0 - the dates of a row that are really expiry dates: under an 'Expiry' / 'Valid until' column when the
    row is in a table; otherwise the date that follows the expiry words - never a date of issue, of birth, a
    start date or a 'received' date."""
    cells, hdr = row.get("cells") or [], row.get("header") or []
    if hdr and cells and len(hdr) == len(cells):
        cols = [j for j, h in enumerate(hdr) if EXPIRY_COL.search(h or "") and not NOT_EXPIRY.search(h or "")]
        if cols:
            return [d for j in cols for d in parse_dates(cells[j])]
        if any(NOT_EXPIRY.search(h or "") for h in hdr) and not any(EXPIRY_COL.search(h or "") for h in hdr):
            return []
    text = row.get("text") or ""
    found = parse_dates_at(text)
    if not found:
        return []
    keys = [m.end() for m in EXPIRY_RE.finditer(text)]
    good = []
    for d, a, b in found:
        before = text[max(0, a - 28):a]
        nots = [m.end() for m in NOT_EXPIRY.finditer(before)]
        exps = [m.end() for m in EXPIRY_RE.finditer(before)]
        if nots and (not exps or max(nots) > max(exps)):
            continue                       # 'Issued 01/02/2024', 'DOB 15/06/85', 'Received 3 May'
        good.append((d, a))
    if not good:
        return []
    if keys and len(good) > 1:
        after = [d for d, a in good if any(k <= a for k in keys)]
        if after:
            return after[:1] if len(after) > 1 and not any(EXPIRY_RE.search(text[a - 28:a]) for _d, a in good
                                                             [1:]) else after
    return [d for d, _a in good]


def parse_date_text(s):
    ds = parse_dates((s or "").strip())
    return ds[0] if ds else None


