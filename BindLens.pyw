        # ---- templates (new pages) ------------------------------------------------------------------------
        if side is not None:
            tk.Label(side, text="START FROM", font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(
                anchor="w", padx=14, pady=(14, 6))
            tiles = {}

            def paint_tiles():
                for k, lb in tiles.items():
                    on = state["template"] == k
                    lb.configure(bg=mix(T["panel"], ACC, 0.18) if on else T["panel"], fg=ACC if on else T["text"])

            def use(k):
                if state["dirty"] and not messagebox.askyesno(APP_NAME, "Start again from this template?\n\n"
                                                                        "What you wrote will be replaced.", parent=w):
                    return
                name, opts, blocks = PAGE_TEMPLATES[k]
                for key in ("paper", "orient", "margin"):
                    src[key] = opts.get(key, {"paper": "blank", "orient": "", "margin": 56}[key])
                pv.set(dict(self.PAPERS).get(src["paper"], "Blank"))
                ov.set("Landscape" if src.get("orient") == "landscape" else "Portrait")
                rt.set_doc({"blocks": json.loads(json.dumps(blocks))})
                state["template"] = k
                state["dirty"] = False
                paint_tiles()
                layout()
                rt.t.focus_set()
                count_words()
            for k, (name, _o, _b) in PAGE_TEMPLATES.items():
                lb = tk.Label(side, text=name, font=self.F(10), bg=T["panel"], fg=T["text"], anchor="w", padx=14,
                              pady=6, cursor="hand2")
                lb.pack(fill="x")
                lb.bind("<Button-1>", lambda e, k=k: use(k))
                tiles[k] = lb
            paint_tiles()

        # ---- save / close ----------------------------------------------------------------------------------
        def collect():
            s_ = dict(src)
            s_["doc"] = rt.get_doc()
            s_["doc"]["base"] = {}
            s_["header"] = "" if getattr(head_e, "ph", False) else head_e.get().strip()
            s_["footer"] = "" if getattr(foot_e, "ph", False) else foot_e.get().strip()
            s_["numbers"] = bool(nv.get())
            return s_

        def close_window():
            state["closed"] = True
            self._page_win = None
            try:
                w.withdraw()
            except Exception:
                pass
            try:
                w.destroy()
            except Exception:
                pass

        def save(_e=None):
            if state["closed"]:
                return "break"
            s_ = collect()
            try:
                Wp, Hp = page_size(self.fitz, s_, ref)
                out = render_page_doc(self.fitz, s_, Wp, Hp, self.images_dir)
            except Exception as ex:
                messagebox.showerror(APP_NAME, f"Could not write the page:\n{ex}", parent=w)
                return "break"
            # 3.0: into the same file it was opened for - even if another book was opened meanwhile; the window
            # closes only when the page is really in the file (your text was lost when saving failed)
            fi_ = next((k for k, f_ in enumerate(self.book.files) if f_["path"] == ed_path), None) \
                if self.book else None
            if fi_ is None:
                messagebox.showinfo(APP_NAME, f"Open the book of “{os.path.basename(ed_path)}” again, then press "
                                              f"Save - your page is still here.", parent=w)
                return "break"
            if self._save_written_pages(fi_, pi, mode, where, s_, out):
                close_window()
            return "break"

        def cancel(_e=None):
            if state["dirty"] and not messagebox.askyesno(APP_NAME, "Close without saving the page?", parent=w):
                return "break"
            close_window()
            return "break"
        wc = tk.Label(foot, text="", font=self.F(8), bg=T["panel"], fg=T["muted"])
        wc.pack(side="left")
        tk.Label(foot, text="   ·   tables: Tab moves on · pictures: click to change · Ctrl+S saves · Esc closes",
                 font=self.F(8), bg=T["panel"], fg=T["muted"]).pack(side="left")
        PillButton(foot, self, "Save on the page" if mode == "edit" else "Add the page", save, kind="accent").pack(
            side="right")
        PillButton(foot, self, "Cancel", cancel, kind="ghost").pack(side="right", padx=6)
        PillButton(foot, self, "Preview", preview, kind="soft").pack(side="right", padx=(0, 6))

        def count_words():
            state["wc_job"] = None
            try:
                d_ = rt.get_doc()
                n_ = len(re.findall(r"\w+", rich_plain(d_)))
                tb_ = sum(1 for b_ in d_["blocks"] if b_.get("t") == "table")
                im_ = sum(1 for b_ in d_["blocks"] if b_.get("t") == "img")
                wc.configure(text=f"{n_} word{'s' if n_ != 1 else ''}" + (f" · {tb_} table{'s' if tb_ != 1 else ''}"
                                                                         if tb_ else "") +
                             (f" · {im_} picture{'s' if im_ != 1 else ''}" if im_ else ""))
            except Exception:
                pass
        w.bind("<Control-Return>", save)
        w.bind("<Control-s>", save)
        w.bind("<Control-p>", lambda e: (preview(), "break")[1])
        w.protocol("WM_DELETE_WINDOW", cancel)
        w.bind("<Escape>", cancel)
        rt.t.bind("<Control-z>", undo)
        rt.t.bind("<Control-y>", redo)
        rt.t.bind("<Control-Z>", redo)

        def sync_style(_e=None):
            try:
                pt = rt.para_type()
                stv.set(dict(styles).get(pt, "Normal text"))
                f_ = rt.cur_fmt()
                fv.set(f_["f"])
                zv.set(f"{float(f_['z']):g}")
                for k, b_ in (("b", b_b), ("i", b_i), ("u", b_u), ("s", b_s)):
                    set_on(b_, bool(f_.get(k)))
                al_ = rt.para_align()
                for k, b_ in al_btns.items():
                    set_on(b_, al_ == k)
            except Exception:
                pass
        rt.t.bind("<ButtonRelease-1>", lambda e: (setattr(rt, "pending", None), sync_style()), add="+")
        rt.t.bind("<KeyRelease>", lambda e: sync_style(), add="+")
        rt.t.bind("<FocusIn>", lambda e: on_embed(None) if state["embed"] is not None and
                  not isinstance(e.widget.focus_get(), tk.Entry) else None, add="+")
        show_tab("home")
        w.after(80, lambda: (layout(), rt.t.focus_set(), sync_style(), count_words()))
        w.save, w.rt, w.preview, w.show_tab = save, rt, preview, show_tab
        w._vars = [stv, fv, zv, szv, ov, mv, cv_, pv, nv, lv, bfv, twv, pdv, pwv]
        self._page_win = w
        return w

    def _save_written_pages(self, fi, pi, mode, where, src, out):
        """Put the written pages into the PDF: new pages, or the same pages written again (marks kept)."""
        import uuid
        f = self.book.files[fi]
        self._begin_edit(fi)
        doc = self.book.doc(fi)
        n_new = out.page_count
        try:
            if mode == "edit":
                grp_ = self._page_group(doc, pi) if pi < doc.page_count else None
                if not grp_:
                    raise RuntimeError("the written page was moved or deleted meanwhile - add it as a new page")
                first, n_old, _old = grp_
                gid = page_source(doc, doc.load_page(first)).get("id")
                for k in range(min(n_old, n_new)):
                    pg = doc.load_page(first + k)
                    wipe_page(doc, pg)
                    if abs(pg.rect.width - out[k].rect.width) > 1 or abs(pg.rect.height - out[k].rect.height) > 1:
                        pg.set_mediabox(out[k].rect)
                    pg.show_pdf_page(pg.rect, out, k)
                if n_new > n_old:
                    doc.insert_pdf(out, from_page=n_old, to_page=n_new - 1, start_at=first + n_old)
                elif n_old > n_new:
                    doc.delete_pages(list(range(first + n_new, first + n_old)))
                at = first
            else:
                gid = uuid.uuid4().hex[:10]
                at = pi + 1 if where == "after" else pi
                doc.insert_pdf(out, start_at=at)
            try:
                day = (page_source(doc, doc.load_page(at)) or {}).get("d") if mode == "edit" else None
            except Exception:
                day = None
            day = day or time.strftime("%Y-%m-%d")
            for k in range(n_new):
                info = {"id": gid, "i": k, "n": n_new, "d": day}
                if k == 0:
                    info["src"] = src
                set_page_source(doc, doc.load_page(at + k), info)
        except Exception as ex:
            if self.undo_stack:
                self.undo_stack.pop()
            self.book.reopen(fi)
            messagebox.showerror(APP_NAME, f"Could not write the page:\n{ex}")
            return False
        self._save_file(fi)
        g = f["first"] + at
        self._structure_changed(fi, goto=g)
        self.set_status(("Page saved." if mode == "edit" else f"{n_new} page{'s' if n_new > 1 else ''} added.") +
                        "  Double-click it to edit · Ctrl+Z to undo.")
        return True

    def compress_file(self):
        """3.0 - a big PDF (scans, photos) made smaller: pictures stored at a sensible sharpness for screens and
        printing (150 dpi), unused parts removed. Your marks stay; Ctrl+Z gives the file back as it was."""
        if not self.book or not self.book.total:
            return
        fi, pi, g = self._here()
        f = self.book.files[fi]
        if not f["pdf"]:
            self._require_pdf(g)
            return
        try:
            before = os.path.getsize(f["path"])
        except OSError:
            return
        doc = self.book.doc(fi)
        if (doc.metadata or {}).get("encryption"):
            messagebox.showinfo(APP_NAME, "This PDF is protected with a password - it can't be made smaller here.")
            return
        mb = lambda n: f"{n / 1048576:.1f} MB" if n >= 1048576 else f"{max(1, n // 1024)} KB"
        if not messagebox.askyesno(APP_NAME, f"Make “{os.path.basename(f['path'])}” smaller?\n\nNow: {mb(before)}."
                                             f"\n\nPictures and scans are kept sharp enough for the screen and "
                                             f"for printing (150 dpi). Your marks stay.\n\nCtrl+Z gives it back "
                                             f"while BindLens is open - after closing BindLens it can't be undone."):
            return
        self.root.config(cursor="watch")
        self.set_status("Making the file smaller…")
        self.root.update_idletasks()
        self._begin_edit(fi)
        try:
            doc.rewrite_images(dpi_threshold=200, dpi_target=150, quality=75)
            data = doc.tobytes(garbage=3, deflate=True, deflate_images=True, deflate_fonts=True)
        except Exception as ex:
            self.root.config(cursor="")
            if self.undo_stack and self.undo_stack[-1][1] == f["path"]:
                self.undo_stack.pop()
            self.book.reopen(fi)
            messagebox.showerror(APP_NAME, f"Could not make it smaller:\n{ex}")
            return
        self.root.config(cursor="")
        if len(data) > before * 0.95:
            if self.undo_stack and self.undo_stack[-1][1] == f["path"]:
                self.undo_stack.pop()
            self.book.reopen(fi)
            self.set_status("")
            messagebox.showinfo(APP_NAME, f"“{os.path.basename(f['path'])}” is already small ({mb(before)}) - "
                                          f"nothing changed.")
            return
        self.writer.put(f["path"], data, expect=self.book.disk.get(f["path"]))
        self.book.keep.add(fi)
        self.book.reopen(fi, data=data)
        self._watch_writer()
        self._invalidate_file(fi)
        self._refresh_file_marks(fi)
        self.redraw()
        self._toast(f"Smaller: {mb(before)} → {mb(len(data))}  ·  {os.path.basename(f['path'])}", ms=6000,
                    action=("Undo", self.undo))
        self.set_status(f"“{os.path.basename(f['path'])}” is now {mb(len(data))} (was {mb(before)}). Ctrl+Z to undo.")

    def rotate_page(self, by):
        self._page_edit(lambda doc, pi: doc.load_page(pi).set_rotation((doc.load_page(pi).rotation + by) % 360),
                        "Page turned.")

    def delete_page(self):
        if not self.book or not self.book.total:
            return
        fi, pi, g = self._here()
        if self.book.files[fi]["count"] <= 1:
            messagebox.showinfo(APP_NAME, "This is the only page of the file - remove the file from the book instead.")
            return
        if not messagebox.askyesno(APP_NAME, f"Delete page {pi + 1} of \"{self.book.files[fi]['rel']}\"?\n\n"
                                             f"It goes to Deleted pages: you can put it back any time "
                                             f"(Pages > Deleted pages…)."):
            return
        path = self.book.files[fi]["path"]

        def go(doc, pi):
            self._to_bin(doc, pi, path)                 # 3.1: the page is kept - it can always come back
            doc.delete_page(pi)
            self.__dict__.setdefault("_full_next", set()).add(path)   # 3.2: really out of the file
        self._page_edit(go, "Page deleted - Pages > Deleted pages… puts it back.")

    # ---- 3.1: deleted pages are kept (only those pages) and can be put back any time ------------------------
    def _bin_dir(self):
        d = os.path.join(self.lib.meta_dir, "deleted pages")
        os.makedirs(d, exist_ok=True)
        return d

    def _bin_list(self):
        lst = load_json(os.path.join(self._bin_dir(), "pages.json"), [])
        return [x for x in lst if isinstance(x, dict) and os.path.exists(x.get("pdf", ""))]

    def _to_bin(self, doc, pi, path):
        import uuid
        try:
            one = self.fitz.open()
            one.insert_pdf(doc, from_page=pi, to_page=pi)
            name = time.strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:6] + ".pdf"
            dst = os.path.join(self._bin_dir(), name)
            one.save(dst, garbage=1, deflate=True)
            one.close()
            lst = self._bin_list()
            lst.insert(0, {"pdf": dst, "file": path, "page": pi, "when": time.strftime("%d %b %Y %H:%M"),
                           "t": time.time()})
            save_json(os.path.join(self._bin_dir(), "pages.json"), lst)
        except Exception as ex:
            _log(f"deleted page bin: {ex}")

    def deleted_pages_dialog(self):
        """Pages > Deleted pages…: every page you deleted - put it back where it was, or delete it for good."""
