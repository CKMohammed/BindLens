    # ---- floating page bar (drawn on the page canvas) ---------------------
    def _draw_overlay(self):
        c = self.canvas
        c.delete("ui")
        if not self.book or not self.book.total:
            return
        T = self.T
        vw, vh = c.winfo_width(), c.winfo_height()
        if vw < 300:
            return
        page_txt = f"{self.current_page + 1}  /  {self._total()}"
        zoom_txt = f"{round(self.zoom * 100)}%"
        f_ = self._sfont(10)                      # 3.0: cached measuring (it made a font on every scroll)
        pw, zw = self._measure(page_txt, f_) + 24, self._measure(zoom_txt, f_) + 18
        gal = self._is_picture_book()                          # 4.4.3: a gallery - see big, personalise
        W = 34 + pw + 34 + 14 + 30 + zw + 30 + 34 + 34 + 14 + (8 + 34 + 34 if gal else 0)
        H = 40
        x0 = c.canvasx(vw / 2 - W / 2)
        y0 = c.canvasy(vh - H - 18)
        round_rect(c, x0 + 1, y0 + 3, x0 + W + 1, y0 + H + 3, 20, fill=T["shadow2"], outline="", tags="ui")
        round_rect(c, x0, y0, x0 + W, y0 + H, 20, fill=T["pill"], outline=T["border"], tags=("ui",))
        x = x0 + 8
        cy = y0 + H / 2

        bound = self.__dict__.setdefault("_ui_bound", set())

        def hit(name, x, w, cmd):
            c.create_rectangle(x, y0 + 4, x + w, y0 + H - 4, fill=T["pill"], outline="", tags=("ui", name))
            if name not in bound:                 # 3.0: bound once (a new binding on every scroll piled up)
                bound.add(name)
                c.tag_bind(name, "<ButtonRelease-1>", lambda e: cmd())
                c.tag_bind(name, "<Enter>", lambda e: c.config(cursor="hand2"))
                c.tag_bind(name, "<Leave>", lambda e: c.config(cursor=""))
        hit("ui_prev", x, 30, lambda: self.goto_page(self.current_page - 1))
        draw_icon(c, "left", x + 15, cy, T["icon"], s=0.75, tag=("ui", "ui_prev"))
        x += 30
        hit("ui_page", x, pw, self._ask_page)
        c.create_text(x + pw / 2, cy, text=page_txt, fill=T["text"], font=self.F(10), tags=("ui", "ui_page"))
        x += pw
        hit("ui_next", x, 30, lambda: self.goto_page(self.current_page + 1))
        draw_icon(c, "right", x + 15, cy, T["icon"], s=0.75, tag=("ui", "ui_next"))
        x += 30 + 8
        c.create_line(x, y0 + 12, x, y0 + H - 12, fill=T["border"], tags="ui")
        x += 8
        hit("ui_zout", x, 30, lambda: self.change_zoom(1 / 1.2))
        draw_icon(c, "minus", x + 15, cy, T["icon"], s=0.7, tag=("ui", "ui_zout"))
        x += 30
        hit("ui_zoom", x, zw, self._toggle_fit)
        c.create_text(x + zw / 2, cy, text=zoom_txt, fill=T["muted"], font=self.F(10), tags=("ui", "ui_zoom"))
        x += zw
        hit("ui_zin", x, 30, lambda: self.change_zoom(1.2))
        draw_icon(c, "plus", x + 15, cy, T["icon"], s=0.7, tag=("ui", "ui_zin"))
        x += 30
        hit("ui_fit", x, 34, self._toggle_fit)
        draw_icon(c, "fit", x + 17, cy, T["icon"], s=0.75, tag=("ui", "ui_fit"))
        x += 34
        hit("ui_grid", x, 34, self.pages_overview)                   # 3.0: all the pages as pictures (F4)
        draw_icon(c, "grid", x + 17, cy, T["icon"], s=0.72, tag=("ui", "ui_grid"))
        if gal:
            x += 34 + 4
            c.create_line(x, y0 + 12, x, y0 + H - 12, fill=T["border"], tags="ui")
            x += 4
            hit("ui_galview", x, 34, lambda: self.gallery_view(self.current_page))
            draw_icon(c, "image", x + 17, cy, self.accent, s=0.72, tag=("ui", "ui_galview"))
            x += 34
            hit("ui_galmenu", x, 34, lambda: self.gallery_menu())
            draw_icon(c, "palette", x + 17, cy, self.accent, s=0.72, tag=("ui", "ui_galmenu"))
        c.tag_raise("ui")

    def _over_ui(self, e):
        items = self.canvas.find_overlapping(self.canvas.canvasx(e.x), self.canvas.canvasy(e.y),
                                             self.canvas.canvasx(e.x), self.canvas.canvasy(e.y))
        return any("ui" in self.canvas.gettags(i) for i in items)

    def _ask_page(self):
        c = self.canvas
        e = tk.Entry(c, width=6, justify="center", font=self.F(10), relief="flat", bg=self.T["chip"],
                     fg=self.T["text"], insertbackground=self.T["text"], highlightthickness=1,
                     highlightcolor=self.accent)
        vw, vh = c.winfo_width(), c.winfo_height()
        # 3.0: placed over the canvas (as a canvas item it vanished when a page picture arrived)
        e.place(x=vw / 2, y=vh - 90, anchor="center")
        e.insert(0, str(self.current_page + 1))
        e.select_range(0, "end")
        e.focus_set()

        def done(go):
            v = e.get().strip()
            try:
                e.destroy()
            except Exception:
                return
            if go:
                try:
                    self.goto_page(int(v) - 1)
                except ValueError:
                    pass
            self.canvas.focus_set()
        e.bind("<Return>", lambda ev: done(True))
        e.bind("<Escape>", lambda ev: done(False))
        e.bind("<FocusOut>", lambda ev: done(False))

    def _scroll(self, parent, tree):
        sb = ttk.Scrollbar(parent, orient="vertical", command=tree.yview)
        tree.config(yscrollcommand=sb.set)
        tree.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")

