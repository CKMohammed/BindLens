        d.bind("<Escape>", lambda e: d.destroy())
        d.geometry(f"760x520+{self.root.winfo_rootx() + max(0, (self.root.winfo_width() - 760) // 2)}+"
                   f"{self.root.winfo_rooty() + 70}")
        qe.focus_set()

    # the contents (left) while reading: like the first page of a book
    def _toc_draw(self):
        cv = self._side_l
        geo = self._sides_geo.get("l")
        if not geo or not self.book or not self.book.total:
            return
        T, A = self.T, self.accent
        light = is_light(T["canvas"])
        paper = mix(T["panel"], "#FFF4E2", 0.55) if light else mix(T["panel"], T["canvas"], 0.25)
        card = self._side_bg(cv, "l", fill=paper)
        w, h = geo[2], geo[3]
        b = self.book
        g = max(0, min(self.current_page, b.total - 1))
        cur_fi = b.pages[g][0]
        f = b.files[cur_fi]
        pct = (g - f["first"] + 1) / max(1, f["count"])
        ink = T["text"]
        # a ribbon bookmark hanging from the top
        rx = w - 44
        cv.create_polygon(rx, 0, rx + 16, 0, rx + 16, 46, rx + 8, 39, rx, 46, fill=A, outline="")
        cv.create_line(rx + 3, 0, rx + 3, 40, fill=mix(A, "#FFFFFF", 0.35))
        # Contents
        im = self._text_img("Contents", 26, ink, style="serif_i")
        cv.create_image(22, 16, image=im[0], anchor="nw")
        name = self.lib.label(self.folder) + (" / " + self.prefix.rstrip("/").split("/")[-1] if self.prefix else "")
        cv.create_text(24, 16 + im[2] + 4, text=self._fit_text(" ".join(name.upper()), self._sfont(7, "bold"),
                                                               w - 80), anchor="w", font=self.F(7, "bold"),
                       fill=T["muted"])
        yl = 16 + im[2] + 18
        cv.create_line(22, yl, w - 22, yl, fill=mix(card, ink, 0.35))
        cv.create_line(22, yl + 3, w - 22, yl + 3, fill=mix(card, ink, 0.15))
        self._map_btns = []
        yl = self._shelf(cv, 22, yl + 12, w - 22, card, ink, cur_fi, g, serif=True) - 4   # 1.9.9: the bookshelf
        rows = self._map_rows()
        RH = 27
        y0 = yl + 14
        foot = 48
        fit = max(1, int((h - y0 - foot) // RH))
        self._map_fit = fit
        vis = self._sec_vis(cur_fi) or []
        pi_now = g - f["first"]
        cur_k = self._part_at(cur_fi, pi_now) if vis else -1
        cur_row = next(i for i, r in enumerate(rows) if r[0] == "doc" and r[1] == cur_fi)
        if cur_k >= 0:
            cur_row = next((i for i, r in enumerate(rows) if r[0] == "part" and r[2] == cur_k), cur_row)
        base = max(0, min(len(rows) - fit, cur_row - fit // 3))
        if len(rows) <= fit:
            start = base = 0
        else:
            start = max(0, min(len(rows) - fit, base + self._map_off))
            self._map_off = start - base
        self._map_geom = (base, fit, len(rows))
        shown = rows[start:start + fit]
        self._map_hits = []
        fn, fb = self._sfont(10), self._sfont(10, "bold")
        num = 0
        for r in rows[:start]:
            num += r[0] == "doc"
        w_full = w
        if len(rows) > fit:                 # 1.9.3: round ▲ ▼ buttons and a pill to go through the contents
            self._map_scroller(cv, w - 17, y0 + 1, y0 + fit * RH - 1, start, fit, len(rows), card)
            w = w - 22
        for i, r in enumerate(shown):
            yc = y0 + i * RH + RH / 2
            if r[0] == "part":                 # 1.9.4: the chapters of the document you are reading
                k = r[2]
                lvl, title, ppi = vis[k][0], vis[k][1], vis[k][2]
                hit = ("part", r[1], ppi, vis[k][3] if len(vis[k]) > 3 else None)
                on = k == cur_k
                ind = 52 + (min(lvl, 3) - 1) * 12
                if on:
                    round_rect(cv, ind - 8, yc - RH / 2 + 3, w - 12, yc + RH / 2 - 3, 6, fill=mix(card, A, 0.16),
                               outline="")
                elif self._map_hover == hit:
                    round_rect(cv, ind - 8, yc - RH / 2 + 3, w - 12, yc + RH / 2 - 3, 6, fill=mix(card, A, 0.07),
                               outline="")
                cv.create_text(ind - 2, yc, text="›" if lvl > 1 else "§", anchor="e", font=self.F(8),
                               fill=A if on else mix(A, card, 0.4))
                pg = str(b.files[r[1]]["first"] + ppi + 1)
                fs = self._sfont(9, "bold") if on else self._sfont(9)
                pw_ = self._measure(pg, self._sfont(8))
                t_ = self._fit_text(title, fs, w - ind - 22 - pw_ - 14)
                cv.create_text(ind + 2, yc, text=t_, anchor="w", font=self.F(9, "bold") if on else self.F(9),
                               fill=A if on else (mix(ink, card, 0.4) if ppi < pi_now else ink))
                tw = self._measure(t_, fs)
                if ind + 2 + tw + 8 < w - 22 - pw_ - 6:
                    cv.create_line(ind + 2 + tw + 6, yc + 4, w - 22 - pw_ - 6, yc + 4, fill=mix(card, ink, 0.25),
                                   dash=(1, 3))
                cv.create_text(w - 22, yc, text=pg, anchor="e", font=self.F(8), fill=A if on else T["muted"])
                self._map_hits.append((yc - RH / 2, yc + RH / 2, hit))
                continue
            if r[0] == "sec":
                lab = " ".join(r[1].upper())
                lab = self._fit_text(lab, self._sfont(7, "bold"), w - 90)
                tw = self._measure(lab, self._sfont(7, "bold"))
                cv.create_text(w / 2, yc, text=lab, font=self.F(7, "bold"), fill=A)
                cv.create_line(22, yc, w / 2 - tw / 2 - 8, yc, fill=mix(card, A, 0.5))
                cv.create_line(w / 2 + tw / 2 + 8, yc, w - 22, yc, fill=mix(card, A, 0.5))
                self._map_hits.append((yc - RH / 2, yc + RH / 2, r[2]))
                continue
            num += 1
            fi = r[1]
            ff = b.files[fi]
            on = fi == cur_fi
            if on:
                round_rect(cv, 12, yc - RH / 2 + 1, w - 12, yc + RH / 2 - 1, 7, fill=mix(card, A, 0.13), outline="")
                cv.create_rectangle(12, yc - RH / 2 + 4, 15, yc + RH / 2 - 4, fill=A, outline="")
            elif self._map_hover == fi:
                round_rect(cv, 12, yc - RH / 2 + 1, w - 12, yc + RH / 2 - 1, 7, fill=mix(card, A, 0.07), outline="")
            nim = self._text_img(f"{num:02d}", 13, A if on or fi > cur_fi else mix(A, card, 0.45), style="serif")
            cv.create_image(22, yc - 1, image=nim[0], anchor="w")
            pg = str(ff["first"] + 1)
            pw_ = self._measure(pg, fn)
            label = os.path.splitext(os.path.basename(ff["rel"]))[0]
            maxw = w - 52 - 22 - pw_ - 16
            t_ = self._fit_text(label, fb if on else fn, maxw)
            col = A if on else (ink if fi > cur_fi else mix(ink, card, 0.4))
            cv.create_text(52, yc - (2 if on else 0), text=t_, anchor="w", font=self.F(10, "bold") if on else
                           self.F(10), fill=col)
            tw = self._measure(t_, fb if on else fn)
            if 52 + tw + 8 < w - 22 - pw_ - 6:              # the dotted line to the page number
                cv.create_line(52 + tw + 6, yc + 4, w - 22 - pw_ - 6, yc + 4, fill=mix(card, ink, 0.35),
                               dash=(1, 3))
            cv.create_text(w - 22, yc - (2 if on else 0), text=pg, anchor="e", font=self.F(9),
                           fill=A if on else T["muted"])
            if on:
                x1 = 52 + (w - 22 - 52) * min(1.0, pct)
                cv.create_line(52, yc + 9, w - 22, yc + 9, fill=mix(card, A, 0.25), width=2)
                cv.create_line(52, yc + 9, x1, yc + 9, fill=A, width=2)
            self._map_hits.append((yc - RH / 2, yc + RH / 2, fi))
        w = w_full
        # how far you are in the book
        allp = (g + 1) / b.total
        yf = h - 30
        cv.create_line(22, yf, w - 22, yf, fill=mix(card, ink, 0.18), width=3, capstyle="round")
        cv.create_line(22, yf, 22 + (w - 44) * allp, yf, fill=A, width=3, capstyle="round")
        cv.create_oval(22 + (w - 44) * allp - 4, yf - 4, 22 + (w - 44) * allp + 4, yf + 4, fill=card, outline=A,
                       width=2)
        cv.create_text(22, yf + 14, text=f"Page {g + 1} of {b.total}", anchor="w", font=self.F(8),
                       fill=T["muted"])
        cv.create_text(w - 22, yf + 14, text=f"{int(allp * 100)}% of the book", anchor="e", font=self.F(8),
                       fill=T["muted"])

    # the calendar and clock (right) while reading
    def _desk_h(self, w):
        cal = int(min(w - 40, 190) * 0.8) + 20
        ring = int(min(w - 64, 164)) + 8
        h = 22 + cal + 22 + ring + 20
        att = getattr(self, "_attention", None)
        if att and att.get("items") and self._beside_conf()["deadline"]:
            h += 46
        return int(h + 6)

    def _desk_draw(self, full=False):
        cv = self._side_r
        geo = self._sides_geo.get("r")
        if not geo:
            return
        T, A = self.T, self.accent
        now = time.localtime()
        w, h = geo[2], geo[3]
        if full or getattr(self, "_desk_day", None) != now.tm_yday:
            full = True
            self._desk_day = now.tm_yday
            card = self._side_bg(cv, "r")
            self._clock_card = card
            # a tear-off calendar
            cw = min(w - 40, 190)
            ch = int(cw * 0.8)
            x0, y0 = (w - cw) / 2, 24
            cv.create_rectangle(x0 + 2, y0 + 3, x0 + cw + 2, y0 + ch + 3, fill=mix(card, "#000000", 0.08), outline="")
            cv.create_rectangle(x0, y0, x0 + cw, y0 + ch, fill="#FFFFFF" if is_light(T["canvas"]) else
                                mix(T["panel"], "#FFFFFF", 0.08), outline=mix(card, T["border"], 0.8))
            band = int(ch * 0.28)
            cv.create_rectangle(x0, y0, x0 + cw, y0 + band, fill=A, outline="")
            mon = self._text_img(time.strftime("%B %Y", now).upper(), max(10, int(band * 0.36)), "#FFFFFF", bold=True)
            cv.create_image(x0 + cw / 2, y0 + band / 2 + 1, image=mon[0])
            for rx in (x0 + cw * 0.25, x0 + cw * 0.75):                 # the rings at the top
                cv.create_oval(rx - 4, y0 - 7, rx + 4, y0 + 7, outline=mix(card, "#000000", 0.45), width=2)
                cv.create_oval(rx - 2.5, y0 + 3, rx + 2.5, y0 + 8, fill=mix(A, "#000000", 0.35), outline="")
            day = self._text_img(str(now.tm_mday), int((ch - band) * 0.56), T["text"] if is_light(T["canvas"])
                                 else "#FFFFFF", style="serif_b")
            cv.create_image(x0 + cw / 2, y0 + band + (ch - band) * 0.43, image=day[0])
            cv.create_text(x0 + cw / 2, y0 + ch - 13, text=time.strftime("%A", now), font=self.F(10),
                           fill=T["muted"])
            for k in range(int(cw // 7)):                              # where it tears off
                xx = x0 + 3 + k * 7
                cv.create_line(xx, y0 + ch, xx + 3.5, y0 + ch, fill=mix(card, T["border"], 0.9))
            self._desk_ring_y = y0 + ch + 22
            att = getattr(self, "_attention", None)
            if att and att.get("items") and self._beside_conf()["deadline"]:
                items = att["items"]
                nxt = next((x for x in items if x.startswith(("In ", "Today", "Tomorrow"))), items[0])
                when, _, what = nxt.partition(": ")
                y = h - 52
                cv.create_line(16, y + 4, w - 16, y + 4, fill=mix(card, T["border"], 0.6))
                colr = "#D93025" if when.startswith("Expired") else "#E8772E"
                cv.create_oval(16, y + 15, 24, y + 23, fill=colr, outline="")
                cv.create_text(30, y + 19, text=("Next: " + when) if not when.startswith("Expired") else when, anchor="w",
                               font=self.F(8, "bold"), fill=colr)
                cv.create_text(16, y + 36, text=self._fit_text(what, self._sfont(8), w - 32), anchor="w",
                               font=self.F(8), fill=T["muted"])
        self._desk_clock(now, full)

    def _desk_geo(self):
        geo = self._sides_geo.get("r")
        w = geo[2] if geo else 240
        D = int(min(w - 64, 164))
        R = D / 2
        return w / 2, getattr(self, "_desk_ring_y", 200) + 18 + R, D, R

    def _desk_clock(self, now, full=False):
        """2.0 - the reading clock: the sky of the hour in a round window (the sun or the moon crossing it), the
        minutes as a ring of dots around it, the time on the hills - and, with the animation on, a little comet
        for the seconds, twinkling stars and a ripple when the minute changes."""
        cv = self._side_r
        T, A = self.T, self.accent
        card = self._clock_card
        cx, cy, D, R = self._desk_geo()
        hf = now.tm_hour + now.tm_min / 60
        skey = (D, int(hf * 6))                        # a new sky every 10 minutes
        mkey = (now.tm_hour, now.tm_min, D, card, A)
        if full or getattr(self, "_desk_mkey", None) != mkey or getattr(self, "_desk_skey", None) != skey:
            cv.delete("deskmin")
            if getattr(self, "_desk_skey", None) != skey or getattr(self, "_desk_sky", None) is None:
                try:
                    self._desk_sky = tk.PhotoImage(data=sky_disc_png(self.fitz, D, hf))
                except Exception:
                    self._desk_sky = None
                self._desk_skey = skey
            if getattr(self, "_desk_mkey", None) not in (None, mkey) and not full:
                self._desk_ripple = time.time()            # the minute changed
            self._desk_mkey = mkey
            cv.create_oval(cx - R - 3, cy - R - 1, cx + R + 3, cy + R + 5, fill=mix(card, "#000000", 0.07),
                           outline="", tags="deskmin")
            if self._desk_sky is not None:
                cv.create_image(cx, cy, image=self._desk_sky, tags="deskmin")
            else:
                cv.create_oval(cx - R, cy - R, cx + R, cy + R, fill=A, outline="", tags="deskmin")
            # the minutes: 60 dots around the sky - the hour so far in your colour
            import math
            rr = R + 9
            for i in range(60):
                a = math.radians(i * 6 - 90)
                x, y = cx + rr * math.cos(a), cy + rr * math.sin(a)
                big = i % 5 == 0
                if i < now.tm_min:
                    col, rd = A, (2.3 if big else 1.7)
                elif i == now.tm_min:
                    col, rd = A, 3.4
                else:
                    col, rd = mix(card, T["muted"], 0.45 if big else 0.28), (1.9 if big else 1.2)
                cv.create_oval(x - rd, y - rd, x + rd, y + rd, fill=col, outline="", tags="deskmin")
            _t, _b, day, _body = sky_at(hf)
            sh_ = "#0E1630" if day < 0.5 else "#1E3A2A"
            tim = time.strftime("%H:%M", now)
            big1 = self._text_img(tim, int(D * 0.25), sh_, True)
            big2 = self._text_img(tim, int(D * 0.25), "#FFFFFF", True)
            ty = cy + R * 0.30
            cv.create_image(cx + 1.5, ty + 1.5, image=big1[0], tags="deskmin")
            cv.create_image(cx, ty, image=big2[0], tags="deskmin")
            part = ("Night" if now.tm_hour < 5 else "Early morning" if now.tm_hour < 8 else "Morning" if
                    now.tm_hour < 12 else "Afternoon" if now.tm_hour < 17 else "Evening" if now.tm_hour < 21
                    else "Night")
            cv.create_text(cx, ty + D * 0.17, text=part, font=self.F(8, "bold"), fill=mix("#FFFFFF", sh_, 0.12),
                           tags="deskmin")
        self._desk_sec()

    def _desk_sec(self):
        """The seconds (animation on): a comet going round, the stars twinkle, a ripple at each new minute."""
        import math
        cv = self._side_r
        cv.delete("desksec")
        if not getattr(self, "_reading", False) or not self._sides_geo.get("r") or \
                self._beside_conf().get("read_clock", "sky") != "sky":
            return
        if not self._beside_conf().get("anim", True):
            return
        A = self.accent
        card = self._clock_card
        cx, cy, D, R = self._desk_geo()
        t = time.time()
        sec = (t % 60)
        orbit = R + 17
        for k in range(8, -1, -1):                        # the tail, then the head
            a = math.radians((sec - k * 0.32) * 6 - 90)
            x, y = cx + orbit * math.cos(a), cy + orbit * math.sin(a)
            rd = 3.4 if k == 0 else max(0.8, 2.6 - k * 0.22)
            cv.create_oval(x - rd, y - rd, x + rd, y + rd, fill=mix(card, A, 1.0 - k * 0.1) if k else A,
                           outline="", tags="desksec")
        a = math.radians(sec * 6 - 90)
        x, y = cx + orbit * math.cos(a), cy + orbit * math.sin(a)
        cv.create_oval(x - 6, y - 6, x + 6, y + 6, outline=mix(card, A, 0.35), width=1, tags="desksec")
        rp = getattr(self, "_desk_ripple", 0)
        if t - rp < 0.9:                                  # a new minute: a ring goes out and fades
            f = (t - rp) / 0.9
            r2 = R + 4 + 22 * f
            cv.create_oval(cx - r2, cy - r2, cx + r2, cy + r2, outline=mix(A, card, f), width=2.2 * (1 - f) + 0.5,
                           tags="desksec")
        _t, _b, day, _body = sky_at(time.localtime().tm_hour + time.localtime().tm_min / 60)
        if day < 0.5:                                     # a few stars twinkle
            import random
            rnd = random.Random(11)
            for i in range(7):
                sx = cx + (rnd.uniform(0.15, 0.85) - 0.5) * D
                sy = cy + (rnd.uniform(0.10, 0.45) - 0.5) * D
                tw = 0.5 + 0.5 * math.sin(t * (1.3 + i * 0.37) + i * 1.7)
                rd = 0.6 + 1.1 * tw
                cv.create_oval(sx - rd, sy - rd, sx + rd, sy + rd, fill=mix("#9AA6D8", "#FFFFFF", tw), outline="",
                               tags="desksec")
        cv.tag_raise("desksec")

    def _desk_anim(self):
        """With the animation on, the seconds move smoothly (10 times a second) - only while BindLens is in front
        and you are not scrolling or typing; otherwise once a second (or once a minute, animation off)."""
        self._desk_anim_job = None
        if not getattr(self, "_reading", False):
            return
        if self._beside_conf().get("anim", True) and self._anim_ok(quiet=0.8):
            try:
                self._desk_sec()
            except Exception:
                pass
            self._desk_anim_job = self.root.after(100, self._desk_anim)
        else:
            self._desk_anim_job = self.root.after(600, self._desk_anim)

    # ---- library panel: pinned (always open) or opens when the mouse is on the icon rail ----------
    def toggle_sidebar(self):
        self.side_pinned = not self.side_pinned
        self.lib.settings["side_pinned"] = self.side_pinned
        self.lib.save_meta()
        self._place_side()
        if not self.side_pinned:
            self.set_status("Library panel: opens when you move the mouse onto the icons on the left.  F9 keeps it open.")
        self.root.after(60, self._relayout_after_side)

    def _relayout_after_side(self):
        if self.book and self.fit_mode:
            self._apply_zoom(self._fit_zoom(self.fit_mode))

    def _place_side(self):
        for w in (self.side, self.side_sep):
            w.place_forget()
            w.pack_forget()
        self._side_overlay = False
        self.sidebar_visible = self.side_pinned and not self.fullscreen and not getattr(self, "_reading", False)
        if self.sidebar_visible:
            self.side.pack(side="left", fill="y", before=self.view)
            self.side_sep.pack(side="left", fill="y", before=self.view)
        self._update_pin_btn()

    def _update_pin_btn(self):
        if hasattr(self, "btn_pin"):
            self.btn_pin.tip = "Open on hover only" if self.side_pinned else "Keep open"
            self.btn_pin.set_active(self.side_pinned)
            self.btn_sidebar.set_active(self.side_pinned)

    def _rail_enter(self, _e=None):
        if self.side_pinned or self.fullscreen or self._side_overlay:
            return
        if self._side_job:
            self.root.after_cancel(self._side_job)
        self._side_job = self.root.after(220, self._open_overlay)

    def _open_overlay(self):
        self._side_job = None
        px, py = self.root.winfo_pointerxy()
        if not self._inside(self.rail, px, py) or self.side_pinned or self.fullscreen:
            return
        self._rail_tip(None)
        x = self.rail.winfo_width() + 1
        self.side.place(in_=self.paned, x=x, y=0, width=280, relheight=1)
        self.side_sep.place(in_=self.paned, x=x + 280, y=0, width=1, relheight=1)
        self.side.lift()
        self.side_sep.lift()
        self._side_overlay = True
        self._side_check_later()

    def _inside(self, w, px, py, pad=0):
        try:
            x, y = w.winfo_rootx(), w.winfo_rooty()
            return x - pad <= px < x + w.winfo_width() + pad and y - pad <= py < y + w.winfo_height() + pad
        except Exception:
            return False

    def _side_check_later(self):
        if self._side_overlay:
            self.root.after(350, self._side_check)

    def _side_check(self):
        if not self._side_overlay:
            return
        px, py = self.root.winfo_pointerxy()
        busy = self._menu_open or self.root.grab_current() is not None
        if busy or self._inside(self.side, px, py, 6) or self._inside(self.rail, px, py):
            self.root.after(350, self._side_check)
            return
        self.side.place_forget()
        self.side_sep.place_forget()
        self._side_overlay = False

    # ---- icon rail
    def _draw_rail(self):
        c, T = self.rail_c, self.T
        c.delete("all")
        y = 12
        self._rail_rows = []
        hov = getattr(self, "_rail_hov", None)
        drag = getattr(self, "_rail_drag", None)
        TS = RAIL_TILE
        for f in self.lib.folders:
            col = self.lib.color(f)
            on = f == self.folder
            x0 = (RAIL_W - TS) / 2
            if on:
                round_rect(c, 0, y + TS * 0.25, 4, y + TS * 0.75, 2, fill=self.accent, outline="")
            fill = col if on else mix(col, T["bg"], 0.3)
            ic = self.lib.icon(f)
            if drag and drag.get("on") and drag["f"] == f:
                round_rect(c, x0, y, x0 + TS, y + TS, TS * 0.27, fill="", outline=mix(T["bg"], col, 0.6),
                           width=1.5, dash=(3, 3))
            else:
                draw_tile(c, x0, y, TS, fill, icon=ic, text=initials(self.lib.label(f)), font=self.F(11, "bold"),
                          bg=T["bg"], style=self.lib.tstyle(f), badge=self.lib.badge(f))
                # ↻ read the folder again: faint on every book, clear when the mouse is on it
                bx, by = x0 + TS - 7, y + TS - 8
                spin = getattr(self, "_refreshing", None) == f
                if hov == f or spin:
                    c.create_oval(bx - 9, by - 9, bx + 9, by + 9, fill="#FFFFFF", outline=mix(col, "#000000", 0.2))
                    draw_refresh(c, bx, by, 5, mix(col, "#000000", 0.25), 1.8,
                                 getattr(self, "_spin_a", 0) if spin else 0)
                else:
                    draw_refresh(c, bx, by, 4.5, mix(fill, "#FFFFFF", 0.55), 1.5, 0)
            if self.lib.missing.get(f) and not self.lib.folders[f]:
                c.create_oval(x0 + TS - 8, y - 2, x0 + TS + 4, y + 10, fill="#B3261E", outline=T["bg"], width=2)
            self._rail_rows.append((y, y + TS, f))
            y += TS + 11
        if drag and drag.get("on"):
            # where it will go: a line between the books, and the book under the mouse
            ins = drag.get("ins", 0)
            ly = 12 + ins * (TS + 11) - 6
            c.create_line(8, ly, RAIL_W - 8, ly, fill=self.accent, width=3, capstyle="round")
            f = drag["f"]
            draw_tile(c, (RAIL_W - TS) / 2 + 3, drag["y"] - TS / 2, TS, self.lib.color(f), icon=self.lib.icon(f),
                      text=initials(self.lib.label(f)), font=self.F(11, "bold"), bg=T["bg"],
                      style=self.lib.tstyle(f), badge=self.lib.badge(f))
        c.configure(scrollregion=(0, 0, RAIL_W, y + 4), yscrollincrement=TS + 11)

    def _rail_at(self, e):
        yy = self.rail_c.canvasy(e.y)
        for y0, y1, f in getattr(self, "_rail_rows", []):
            if y0 - 4 <= yy <= y1 + 4:
                return f, y0
        return None, None

    def _rail_press(self, e):
        f, y0 = self._rail_at(e)
        self._rail_drag = {"f": f, "y0": self.rail_c.canvasy(e.y), "y": self.rail_c.canvasy(e.y), "on": False} \
            if f is not None else None

    def _rail_motion_drag(self, e):
        d = getattr(self, "_rail_drag", None)
        if not d:
            return
        y = self.rail_c.canvasy(e.y)
        if not d["on"] and abs(y - d["y0"]) > 8 and len(self.lib.folders) > 1:
            d["on"] = True
            self._rail_tip(None)
        if d["on"]:
            d["y"] = y
            d["ins"] = max(0, min(len(self.lib.folders), int((y - 12 + (RAIL_TILE + 11) / 2) // (RAIL_TILE + 11))))
            self._draw_rail()

    def _rail_release(self, e):
        d = getattr(self, "_rail_drag", None)
        self._rail_drag = None
        if d and d["on"]:
            names = list(self.lib.folders)
            old = names.index(d["f"]) if d["f"] in names else 0
            new = d.get("ins", old)
            if new > old:
                new -= 1
            if new != old:
                self.lib.move_collection(d["f"], new)
                self.set_status(f"{self.lib.label(d['f'])} moved.")
            self._fill_folders()
            return
        self._rail_click(e)

    def _rail_click(self, e):
        f, y0 = self._rail_at(e)
        if f is not None:
            x0 = (RAIL_W - RAIL_TILE) / 2
            bx, by = x0 + RAIL_TILE - 7, y0 + RAIL_TILE - 8
            if (e.x - bx) ** 2 + (self.rail_c.canvasy(e.y) - by) ** 2 <= 11 ** 2:
                self.refresh_book(f)                 # the little ↻
                return
        if f is not None and self._icon_clicks(f):
            return
        if f is not None and (f != self.folder or self.book is None):
            self.open_folder(f)

    def _icon_clicks(self, f):
        """Click a book's icon 3 times (or more) quickly: its icon and colour open."""
        now = time.time()
        last = getattr(self, "_iclicks", None)
        if last and last[0] == f and now - last[2] < 0.7:
            n = last[1] + 1
        else:
            n = 1
        self._iclicks = (f, n, now)
        if n >= 3:
            self._iclicks = None
            self._rail_tip(None)
            self.root.after(10, lambda: self.book_style_dialog(f))
            return True
        return False

    def _rail_right(self, e):
        f, _ = self._rail_at(e)
        self._rail_tip(None)
        self._folder_menu(f, e)

    def _rail_motion(self, e):
        f, y0 = self._rail_at(e)
        if f != getattr(self, "_rail_hov", None):
            self._rail_hov = f
            self._draw_rail()
        if f is None or self._side_overlay or self.sidebar_visible:
            self._rail_tip(None)
            return
        if getattr(self, "_rail_tip_for", None) != f:
            self._rail_tip((f, y0))

    def _rail_tip(self, what):
        if self._rail_tipwin is not None:
            try:
                self._rail_tipwin.destroy()
            except Exception:
                pass
            self._rail_tipwin = None
        self._rail_tip_for = None
        if not what:
            return
        f, y0 = what
        T = self.T
        w = tk.Toplevel(self.root)
        w.wm_overrideredirect(True)
        try:
            w.attributes("-topmost", True)
        except Exception:
            pass
        n = len(self.lib.folders.get(f, []))
        tk.Label(w, text=f"{self.lib.label(f)}   ·   {n} file{'s' if n != 1 else ''}", bg=T["tip_bg"],
                 fg=T["tip_fg"], font=self.F(9), padx=9, pady=4).pack()
        w.update_idletasks()
        y = self.rail_c.winfo_rooty() + int(y0 - self.rail_c.canvasy(0)) + RAIL_TILE // 2 - w.winfo_reqheight() // 2
        w.geometry(f"+{self.rail.winfo_rootx() + self.rail.winfo_width() + 6}+{y}")
        self._rail_tipwin, self._rail_tip_for = w, f

    def toggle_fullscreen(self, _e=None):
        self.fullscreen = not self.fullscreen
        if self.fullscreen:
            self.close_launcher()
            self._place_side()
            self.rail.pack_forget()
            self.rail_sep.pack_forget()
            self._frame_layout()
            try:
                if getattr(self, "_cap", None) is not None and self._cap.ok:
                    self._cap.fullscreen(True)                  # 4.3: own title bar - the whole screen by itself
                else:
                    self.root.attributes("-fullscreen", True)
            except Exception:
                pass
            self.fs_label.config(bg=self.T["pill"], fg=self.T["muted"])
            self.fs_label.place(relx=1.0, rely=1.0, x=-28, y=-24, anchor="se")
            self.set_status("")
        else:
            try:
                if getattr(self, "_cap", None) is not None and self._cap.ok:
                    self._cap.fullscreen(False)
                else:
                    self.root.attributes("-fullscreen", False)
            except Exception:
                pass
            self._frame_layout()
            if not getattr(self, "_reading", False):          # (reading mode keeps them hidden)
                self.rail.pack(side="left", fill="y", before=self.view)
                self.rail_sep.pack(side="left", fill="y", before=self.view)
            self._place_side()
            self.fs_label.place_forget()
        self.canvas.focus_set()
        self.root.after(100, self._update_current)

    # ---- library name
    def rename_library(self):
        new = self._ask_string("Rename", "Name of your library:", self.lib.title)
        if new is None:
            return
        self.lib.settings["library_title"] = new.strip() or "Library"
        self.lib.save_meta()
        self.lib_title.configure(text=self.lib.title)
        if self._launcher is not None:
            self.close_launcher()
            self.show_launcher()

    def _title_menu(self, e):
        m = self._menu()
        m.add_command(label="Rename library…", command=self.rename_library)
        m.add_command(label="Add a folder…", command=self.import_folder)
        m.add_command(label="Add documents as books…", command=self.import_documents)
        m.add_command(label="New empty book…", command=self.new_folder)
        self._popup(m, e)

    # ---- book icon and colour
    def book_style_dialog(self, f):
        """Icon, colour, style and a little badge for a book - with categories, letters, dates and a search."""
        T = self.T
        d = self._dialog("Icon and colour")
        st = {"icon": self.lib.icon(f), "color": self.lib.color(f), "tstyle": self.lib.tstyle(f),
              "badge": dict(self.lib.badge(f) or {}), "group": "Folders", "q": ""}
        name = self.lib.label(f)
        top = tk.Frame(d, bg=T["panel"])
        top.pack(fill="x", padx=20, pady=(16, 6))
        pv = tk.Canvas(top, width=84, height=84, bg=T["panel"], highlightthickness=0)
        pv.pack(side="left")
        info = tk.Frame(top, bg=T["panel"])
        info.pack(side="left", padx=14, fill="x", expand=True)
        tk.Label(info, text=name, font=self.F(13, "bold"), bg=T["panel"], fg=T["text"]).pack(anchor="w")
        srow = tk.Frame(info, bg=T["panel"])
        srow.pack(anchor="w", pady=(6, 0))
        tk.Label(srow, text="STYLE", font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(side="left",
                                                                                                padx=(0, 8))
        style_lbls = {}
        for k, lab in TILE_STYLES.items():
            lb = tk.Label(srow, text=lab, font=self.F(9), padx=10, pady=3, cursor="hand2")
            lb.pack(side="left", padx=2)
            lb.bind("<Button-1>", lambda e, k=k: (st.__setitem__("tstyle", k), paint()))
            style_lbls[k] = lb
        qv = tk.StringVar()
        qrow = tk.Frame(info, bg=T["panel"])
        qrow.pack(anchor="w", pady=(6, 0))
        tk.Label(qrow, text="FIND", font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(side="left",
                                                                                               padx=(0, 8))
        qe = ttk.Entry(qrow, textvariable=qv, width=24)
        qe.pack(side="left")
        tk.Label(qrow, text="e.g. money, staff, kids, health", font=self.F(8), bg=T["panel"],
                 fg=T["muted"]).pack(side="left", padx=8)
        # groups
        groups = list(ICON_GROUPS) + ["Letters & numbers", "Dates"]
        grow = tk.Frame(d, bg=T["panel"])
        grow.pack(fill="x", padx=20, pady=(6, 2))
        g_lbls = {}
        for gname in groups:
            lb = tk.Label(grow, text=gname, font=self.F(9), padx=9, pady=4, cursor="hand2")
            lb.pack(side="left", padx=(0, 3))
            lb.bind("<Button-1>", lambda e, gname=gname: (st.update(group=gname, q=""), qv.set(""), build()))
            g_lbls[gname] = lb
        body = tk.Frame(d, bg=T["panel"], height=300)
        body.pack(fill="both", expand=True, padx=20, pady=(6, 4))
        cells = {}

        def tile_of(cv, ic, size=40):
            cv.delete("all")
            on = ic == st["icon"]
            col = st["color"] if on else mix(st["color"], T["panel"], 0.4)
            draw_tile(cv, 5, 4, size, col, icon=ic, text=initials(name), font=self.F(11, "bold"), selected=on,
                      bg=T["panel"], style=st["tstyle"])

        def paint():
            pv.delete("all")
            draw_tile(pv, 10, 8, 62, st["color"], icon=st["icon"], text=initials(name), font=self.F(16, "bold"),
                      bg=T["panel"], style=st["tstyle"], badge=st["badge"] if st["badge"].get("t") else None)
            for k, lb in style_lbls.items():
                on = st["tstyle"] == k
                lb.configure(bg=mix(T["panel"], self.accent, 0.2) if on else T["chip"],
                             fg=self.accent if on else T["text"])
            for gname, lb in g_lbls.items():
                on = st["group"] == gname and not st["q"]
                lb.configure(bg=mix(T["panel"], self.accent, 0.2) if on else T["panel"],
                             fg=self.accent if on else T["text"], font=self.F(9, "bold") if on else self.F(9))
            for ic, cv in cells.items():
                tile_of(cv, ic)

        def set_icon(ic):
            st["icon"] = ic
            paint()

        def grid_of(parent, icons, per=14):
            fr = tk.Frame(parent, bg=T["panel"])
            fr.pack(anchor="w")
            for i, ic in enumerate(icons):
                cv = tk.Canvas(fr, width=52, height=52, bg=T["panel"], highlightthickness=0, cursor="hand2")
                cv.grid(row=i // per, column=i % per, padx=1, pady=1)
                cv.bind("<Button-1>", lambda e, ic=ic: set_icon(ic))
                cells[ic] = cv
            return fr

        def build():
            for wd in body.winfo_children():
                wd.destroy()
            cells.clear()
            q = st["q"].strip().lower()
            if q:
                found = []
                extra = " ".join(v for k, v in ICON_WORDS.items() if q in k or k in q).split()
                for gname, icons in ICON_GROUPS.items():
                    for ic in icons:
                        if (q in ic.replace("_", " ") or ic in extra or q in gname.lower()) and ic not in found:
                            found.append(ic)
                if not found:
                    tk.Label(body, text="No icon with that name - try another word, or look in the groups.",
                             font=self.F(9), bg=T["panel"], fg=T["muted"]).pack(anchor="w", pady=10)
                grid_of(body, found)
            elif st["group"] == "Letters & numbers":
                grid_of(body, ["fl:" + ch for ch in "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"], per=14)
                row = tk.Frame(body, bg=T["panel"])
                row.pack(anchor="w", pady=(8, 0))
                tk.Label(row, text="Your own letters (1-4):", font=self.F(9), bg=T["panel"],
                         fg=T["text"]).pack(side="left")
                lv = tk.StringVar(value=initials(name))
                ttk.Entry(row, textvariable=lv, width=6).pack(side="left", padx=6)
                for kind, lab in (("tx", "Big letters"), ("fl", "On a folder"), ("dt", "On a page")):
                    b_ = tk.Label(row, text=lab, font=self.F(9), bg=T["chip"], fg=T["text"], padx=8, pady=3,
                                  cursor="hand2")
                    b_.pack(side="left", padx=2)
                    b_.bind("<Button-1>", lambda e, kind=kind: set_icon(
                        f"{kind}:{re.sub(r'[^0-9A-Za-zÀ-ÿ&/+-]', '', lv.get())[:4].upper() or 'A'}"))
            elif st["group"] == "Dates":
                yr = int(time.strftime("%Y"))
                tk.Label(body, text="YEAR", font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(anchor="w")
                grid_of(body, [f"yr:{y}" for y in range(yr - 4, yr + 3)])
                tk.Label(body, text="MONTH", font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(
                    anchor="w", pady=(6, 0))
                grid_of(body, ["mo:" + m_ for m_ in ("JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP",
                                                      "OCT", "NOV", "DEC")], per=12)
                tk.Label(body, text="QUARTER · SCHOOL YEAR · WEEK · DAY", font=self.F(8, "bold"), bg=T["panel"],
                         fg=T["muted"]).pack(anchor="w", pady=(6, 0))
                ay = [f"ay:{str(y)[2:]}/{str(y + 1)[2:]}" for y in (yr - 2, yr - 1, yr, yr + 1)]
                grid_of(body, ["q:Q1", "q:Q2", "q:Q3", "q:Q4"] + ay +
                        [f"wk:{int(time.strftime('%V'))}", f"cal:{int(time.strftime('%d'))}"])
                row = tk.Frame(body, bg=T["panel"])
                row.pack(anchor="w", pady=(8, 0))
                tk.Label(row, text="Your own:", font=self.F(9), bg=T["panel"], fg=T["text"]).pack(side="left")
                dv = tk.StringVar(value=str(yr))
                ttk.Entry(row, textvariable=dv, width=8).pack(side="left", padx=6)
                for kind, lab in (("yr", "Year / folder"), ("cal", "Day / calendar"), ("wk", "Week"),
                                  ("ay", "School year")):
                    b_ = tk.Label(row, text=lab, font=self.F(9), bg=T["chip"], fg=T["text"], padx=8, pady=3,
                                  cursor="hand2")
                    b_.pack(side="left", padx=2)
                    b_.bind("<Button-1>", lambda e, kind=kind: set_icon(f"{kind}:{dv.get().strip()[:6] or yr}"))
            else:
                grid_of(body, ICON_GROUPS.get(st["group"], []))
            paint()
        qv.trace_add("write", lambda *a: (st.__setitem__("q", qv.get()), build()))
        # colour + badge
        pal = tk.Frame(d, bg=T["panel"])
        pal.pack(fill="x", padx=20, pady=(8, 2))
        tk.Label(pal, text="COLOUR", font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(side="left",
                                                                                                padx=(0, 10))

        def set_c(c):
            st["color"] = c
            paint()
        self._inline_palette(pal, st["color"], set_c).pack(side="left")
        brow = tk.Frame(d, bg=T["panel"])
        brow.pack(fill="x", padx=20, pady=(8, 2))
        tk.Label(brow, text="BADGE", font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(side="left",
                                                                                               padx=(0, 10))
        bv = tk.StringVar(value=st["badge"].get("t", ""))

        def set_badge(t_=None, c_=None):
            if t_ is not None:
                st["badge"]["t"] = t_
                bv.set(t_)
            if c_:
                st["badge"]["c"] = c_
            paint()
        for t_, lab in (("", "None"), ("✓", "✓"), ("!", "!"), ("★", "★")):
            b_ = tk.Label(brow, text=lab, font=self.F(9, "bold"), bg=T["chip"], fg=T["text"], padx=9, pady=2,
                          cursor="hand2")
            b_.pack(side="left", padx=2)
            b_.bind("<Button-1>", lambda e, t_=t_: set_badge(t_))
        tk.Label(brow, text="or a number / letter:", font=self.F(9), bg=T["panel"], fg=T["text"]).pack(
            side="left", padx=(10, 4))
        be = ttk.Entry(brow, textvariable=bv, width=4)
        be.pack(side="left")
        bv.trace_add("write", lambda *a: (st["badge"].__setitem__("t", bv.get().strip()[:3]), paint()))
        for c_ in ("#D93025", "#F28C28", "#1E8E3E", "#2F80ED", "#8E5CE6", "#1F1F1F"):
            cv = tk.Canvas(brow, width=20, height=20, bg=T["panel"], highlightthickness=0, cursor="hand2")
            cv.pack(side="left", padx=(6 if c_ == "#D93025" else 1, 1))
            cv.create_oval(3, 3, 17, 17, fill=c_, outline="")
            cv.bind("<Button-1>", lambda e, c_=c_: set_badge(c_=c_))
        # 1.9: your own text (up to 4) - under the icon, on a folder, big, on a page or a calendar
        trow = tk.Frame(d, bg=T["panel"])
        trow.pack(fill="x", padx=20, pady=(10, 2))
        tk.Label(trow, text="YOUR TEXT", font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(side="left",
                                                                                                   padx=(0, 10))
        cur_ic = str(st["icon"] or "")
        tv = tk.StringVar(value=cur_ic.split("|", 1)[1] if "|" in cur_ic else
                          (cur_ic.split(":", 1)[1] if cur_ic.split(":", 1)[0] in ("fl", "tx", "dt", "cal") else ""))
        te = ttk.Entry(trow, textvariable=tv, width=7, font=self.F(11, "bold"))
        te.pack(side="left")
        tk.Label(trow, text="up to 4 - e.g. 2028, W38, HR", font=self.F(8), bg=T["panel"], fg=T["muted"]).pack(
            side="left", padx=(6, 10))

        def own_text():
            return re.sub(r"[^0-9A-Za-zÀ-ÿ&/+#.-]", "", tv.get())[:4].upper()

        def put_text(kind):
            t_ = own_text()
            if not t_:
                te.focus_set()
                return
            if kind == "ic":
                base = str(st["icon"] or "folder").split("|", 1)[0]
                if ":" in base or base == "letters":
                    base = "folder"
                set_icon(f"{base}|{t_}")
            else:
                set_icon(f"{kind}:{t_}")
        tv.trace_add("write", lambda *a: tv.get() != tv.get()[:4] and tv.set(tv.get()[:4]))
        for kind, lab in (("ic", "Under the icon"), ("fl", "On a folder"), ("tx", "Big"), ("dt", "On a page"),
                          ("cal", "On a calendar")):
            b_ = tk.Label(trow, text=lab, font=self.F(9), bg=T["chip"], fg=T["text"], padx=8, pady=3, cursor="hand2")
            b_.pack(side="left", padx=2)
            b_.bind("<Button-1>", lambda e, kind=kind: put_text(kind))
        te.bind("<Return>", lambda e: (put_text("ic"), "break")[1])
        res = [False]

        def ok(_e=None):
            res[0] = True
            d.destroy()
        bf = tk.Frame(d, bg=T["panel"])
        bf.pack(fill="x", padx=20, pady=(12, 16))
        PillButton(bf, self, "Save", ok, kind="accent").pack(side="right")
        PillButton(bf, self, "Cancel", d.destroy, kind="ghost").pack(side="right", padx=6)
        allv = tk.BooleanVar(value=False)
        ttk.Checkbutton(bf, text="Use this style for all my books", variable=allv).pack(side="left")
        d.bind("<Return>", ok)
        d.bind("<Escape>", lambda e: d.destroy())
        for gname, icons in ICON_GROUPS.items():
            if st["icon"] in icons:
                st["group"] = gname
        if ":" in str(st["icon"]):
            st["group"] = "Dates" if st["icon"].split(":")[0] in ("yr", "mo", "q", "wk", "ay", "cal") else \
                "Letters & numbers"
        build()
        self._center(d)
        d.grab_set()
        self.root.wait_window(d)
        if res[0]:
            col = self.lib.col(f)
            if col:
                col["icon"], col["color"], col["tstyle"] = st["icon"], st["color"], st["tstyle"]
                col["badge"] = dict(st["badge"]) if st["badge"].get("t") else None
                if allv.get():
                    self.lib.settings["tile_style"] = st["tstyle"]
                    for c_ in self.lib.collections:
                        c_.pop("tstyle", None)
                self.lib.save_meta()
            self._fill_folders()
            if self._launcher is not None:
                self.close_launcher()
                self.show_launcher()

    # ==================================================================== 4.3: Home - calm, minimal, your books first
    HOME_LAYOUTS = OrderedDict([("circle", "Circle"), ("flow", "Cover flow"), ("wave", "Wave"), ("shelf", "Shelf"),
                                ("grid", "Grid")])
    HOME_BGS = OrderedDict([("lava", "Lava - the app's colours"), ("colours", "Lava - my colours"),
                            ("photo", "A photo"), ("plain", "Plain")])
    HB_W, HB_H = 132, 176                       # a book's cover at full size (made smaller for depth)
    HB_SCALES = [0.30 + 0.05 * k for k in range(15)]

    def _home_conf(self):
        c = self.lib.settings.setdefault("home", {})
        c.setdefault("bg", "lava")              # lava | colours | photo | plain
        c.setdefault("colors", [])
        c.setdefault("photo", "")
        c.setdefault("motion", True)
        c.setdefault("books", "circle")
        c.setdefault("gold", True)              # the frame round the window turns gold on Home
        c.setdefault("soften", 0.30)
        return c

    def _frame_cols(self):
        """The frame's colours - gold while Home is shown (like the logo's lens), else the chosen palette."""
        if getattr(self, "_home", None) is not None and self._home_conf().get("gold", True):
            return list(FRAME_PALETTES["gold"][1])
        return frame_palette(self._frame_conf(), self.accent)

    def show_home(self, _e=None):
        """Home (Ctrl+H, the house at the top): your books - on a turning circle, a cover flow, a wave, a shelf or
        a grid - with Continue, Find and a few calm icons. A lava of the app's colours (or your photo) behind it,
        and the frame round the window in gold."""
        if self._when_unlocked(self.show_home):             # 4.4: the PIN first - Home only once it is right
            return
        if getattr(self, "_home", None) is not None:
            try:
                self._home.lift()
                self._home_draw()
            except Exception:
                pass
            return
        if getattr(self, "_reading", False):
            self.reading_mode(False)
        self.close_launcher()
        T = self.T
        ov = tk.Frame(self.root, bg=T["bg"])
        self._home = ov
        self._home_geo = None
        self._home_place()
        ov.lift()
        c = tk.Canvas(ov, bg=T["bg"], highlightthickness=0, bd=0)
        c.pack(fill="both", expand=True)
        self._home_c = c
        self._home_hover = None
        self._home_hits = []
        self._home_bhits = []
        self._home_phase = getattr(self, "_home_phase", 0.0)
        self._home_lava = 0.0
        self._home_bgkey = None
        c.bind("<Configure>", lambda e: self._home_draw())
        c.bind("<Motion>", self._home_motion)
        c.bind("<Leave>", lambda e: self._home_set_hover(None))
        c.bind("<Button-1>", self._home_click)
        c.bind("<MouseWheel>", lambda e: self._home_spin(-1 if e.delta > 0 else 1))
        c.bind("<Button-4>", lambda e: self._home_spin(-1))
        c.bind("<Button-5>", lambda e: self._home_spin(1))
        for w_ in (ov, c):
            w_.bind("<Escape>", lambda e: (self.close_home(), "break")[1])
            w_.bind("<Return>", lambda e: (self._home_continue(), "break")[1])
            w_.bind("<Left>", lambda e: (self._home_spin(-1), "break")[1])
            w_.bind("<Right>", lambda e: (self._home_spin(1), "break")[1])
            w_.bind("<Control-k>", lambda e: (self.close_home(), self.quick_search(), "break")[2])
        c.focus_set()
        if self.lib.settings.get("attention_badge", True) and getattr(self, "_attention", None) is None:
            try:
                self._attention_scan()
            except Exception:
                pass
        try:
            self._frame_layout()                 # the frame turns gold
        except Exception:
            pass
        self._home_tick()
        self._home_anim_job = self.root.after(400, self._home_anim)

    def close_home(self):
        ov = getattr(self, "_home", None)
        if ov is not None:
            self._home = None
            for j in ("_home_anim_job",):
                if getattr(self, j, None):
                    try:
                        self.root.after_cancel(getattr(self, j))
                    except Exception:
                        pass
                    setattr(self, j, None)
            try:
                ov.destroy()
            except Exception:
                pass
            self._home_c = None
            try:
                self._frame_layout()             # the frame's own colours again
            except Exception:
                pass
            try:
                self.canvas.focus_set()
            except Exception:
                pass

    def _home_place(self):
        """Home sits inside the frame (the frame stays all round it)."""
        ov = getattr(self, "_home", None)
        if ov is None:
            return
        try:
            top = self.topband.winfo_height() if self.topband.winfo_ismapped() else 0
            lw = self.lband.winfo_width() if self.lband.winfo_ismapped() else 0
            rw = max(self.qbar.winfo_width() if self.qbar.winfo_ismapped() else 0,
                     self.rband.winfo_width() if self.rband.winfo_ismapped() else 0)
            bh = self.status.winfo_height() if self.status.winfo_ismapped() else 0
        except Exception:
            top = lw = rw = bh = 0
        geo = (lw, top, rw, bh)
        if getattr(self, "_home_geo", None) != geo:
            self._home_geo = geo
            ov.place(x=lw, y=top, relwidth=1, width=-(lw + rw), relheight=1, height=-(top + bh))

    def _home_tick(self):
        """Redraw now and then (the attention list arrives in the background; the time of day changes)."""
        if getattr(self, "_home", None) is None:
            return
        sig = (json.dumps(getattr(self, "_attention", None) or {}, default=str)[:4000], time.strftime("%H:%M"))
        if sig != getattr(self, "_home_sig", None):
            self._home_sig = sig
            self._home_draw()
        self._home_place()
        self.root.after(2000, self._home_tick)

    @staticmethod
    def _ago(t):
        d = max(0, time.time() - (t or 0))
        if d < 90:
            return "just now"
        if d < 3600:
            return f"{int(d // 60)} min ago"
        if d < 86400:
            return f"{int(d // 3600)} h ago"
        if d < 2 * 86400:
            return "yesterday"
        return f"{int(d // 86400)} days ago"

    def _home_continue(self):
        rec = [x for x in self.lib.settings.get("recent_docs", []) if x.get("f") in self.lib.folders]
        self.close_home()
        if rec:
            x = rec[0]
            if self.folder == x["f"] and self.book is not None:
                return                                   # the book is open at that place already
            self._go_doc(x["f"], x["rel"], x.get("p", 0))

    def _home_open_book(self, f):
        self.close_home()
        if f != self.folder or self.book is None:
            self.open_folder(f)

    def _home_set_hover(self, k):
        if k != getattr(self, "_home_hover", None):
            old = getattr(self, "_home_hover", None)
            self._home_hover = k
            if (k or "").startswith("bk") or (old or "").startswith("bk") or k is None and old is None:
                self._home_books_draw()
            else:
                self._home_draw()

    def _home_hit(self, e):
        c = self._home_c
        x, y = c.canvasx(e.x), c.canvasy(e.y)
        for x0, y0, x1, y1, key, fn in reversed(getattr(self, "_home_bhits", [])):
            if x0 <= x <= x1 and y0 <= y <= y1:
                return key, fn
        for x0, y0, x1, y1, key, fn in reversed(getattr(self, "_home_hits", [])):
            if x0 <= x <= x1 and y0 <= y <= y1:
                return key, fn
        return None, None

    def _home_motion(self, e):
        key, fn = self._home_hit(e)
        self._home_c.configure(cursor="hand2" if fn else "")
        self._home_set_hover(key)

    def _home_click(self, e):
        key, fn = self._home_hit(e)
        if fn:
            fn()

    def _home_spin(self, d):
        """The wheel / ← → turn the circle (or move the cover flow) by one book."""
        lay = self._home_conf().get("books", "circle")
        n = len(self._home_books())
        if n < 2 or lay not in ("circle", "flow"):
            return
        import math
        if lay == "circle":
            self._home_phase -= d * 2 * math.pi / max(1, min(n, 16))
        else:
            self._home_phase = (self._home_phase + d) % n
        self._home_books_draw()

    def _home_books(self):
        return [f for f in self.lib.folders]

    # ---- the background: a lava of colours, a photo, or plain
    def _home_bg_cols(self):
        hc = self._home_conf()
        T, A = self.T, self.accent
        base = T["bg"]
        if hc.get("bg") == "colours" and hc.get("colors"):
            return [mix(base, c_, 0.62) for c_ in hc["colors"][:4]]
        light = is_light(base)
        k = 0.34 if light else 0.42
        return [mix(base, A, k), mix(base, hue_shift(A, 46), k * 0.85), mix(base, "#FFFFFF" if light else "#000000",
                                                                            0.10),
                mix(base, hue_shift(A, -40), k * 0.9)]

    def _home_bg(self, W, H, force=False):
        """The picture behind Home (made at half size and doubled for the moving lava: smooth and cheap)."""
        hc = self._home_conf()
        mode = hc.get("bg", "lava")
        if mode == "photo" and not (hc.get("photo") and os.path.isfile(hc["photo"])):
            mode = "lava"
        if mode == "plain":
            return None
        try:
            if mode == "photo":
                key = ("photo", hc["photo"], W, H, hc.get("soften"), self.T["bg"])
                if self._home_bgkey == key and getattr(self, "_home_bgimg", None) is not None:
                    return self._home_bgimg
                conf = {"mode": "picture", "picture": hc["photo"], "soften": float(hc.get("soften", 0.3))}
                save = self.T.get("canvas")
                self.T["canvas"] = self.T["bg"]
                try:
                    data = self._bg_ppm(conf, W, H)
                finally:
                    self.T["canvas"] = save
                self._home_bgimg = tk.PhotoImage(data=data)
                self._home_bgkey = key
                return self._home_bgimg
            moving = bool(hc.get("motion", True)) and not self._fast()
            cols = self._home_bg_cols()
            key = ("lava", tuple(cols), W, H, round(self._home_lava, 3) if moving else 0)
            if self._home_bgkey == key and getattr(self, "_home_bgimg", None) is not None and not force:
                return self._home_bgimg
            k = 2
            w2, h2 = (W + k - 1) // k, (H + k - 1) // k
            data = self._bg_ppm({"mode": "gradient", "colors": cols, "motion": "flow"}, w2, h2,
                                self._home_lava if moving else 0.13)
            small = getattr(self, "_home_bgsmall", None)
            big = getattr(self, "_home_bgimg", None)
            if small is not None and big is not None and (small.width(), small.height()) == (w2, h2) and \
                    (big.width(), big.height()) == (w2 * k, h2 * k) and self._home_bgkey and \
                    self._home_bgkey[0] == "lava":
                small.configure(data=data)
                big.tk.call(big.name, "copy", small.name, "-zoom", k, k)
            else:
                self._home_bgsmall = tk.PhotoImage(data=data)
                self._home_bgimg = self._home_bgsmall.zoom(k, k)
            self._home_bgkey = key
            return self._home_bgimg
        except Exception as ex:
            _log(f"home background: {ex}")
            return None

    def _home_anim(self):
        """The lava drifts, the circle turns, the wave moves - slowly; nothing moves in Fast mode, while a window
        is open over BindLens, or while BindLens is minimised."""
        self._home_anim_job = None
        if getattr(self, "_home", None) is None or self._home_c is None:
            return
        delay = 60
        try:
            hc = self._home_conf()
            ok = (hc.get("motion", True) and not self._fast() and self.root.state() != "iconic" and
                  self.root.grab_current() is None and getattr(self, "_lock", None) is None and
                  getattr(self, "_idle_win", None) is None)
            if ok:
                lay = hc.get("books", "circle")
                hov = (getattr(self, "_home_hover", None) or "").startswith("bk")
                n = len(self._home_books())
                moved = False
                if lay == "circle" and not hov and n > 1:
                    self._home_phase += 0.06 * 2 * 3.14159265 / 90.0        # one turn in about 90 s
                    moved = True
                elif lay == "flow" and not hov and n > 1:
                    self._home_phase = (self._home_phase + 0.06 / 6.0) % n   # a book every 6 s
                    moved = True
                elif lay == "wave":
                    self._home_phase += 0.06 * 0.9
                    moved = True
                if moved:
                    self._home_books_draw()
                self._home_tickn = getattr(self, "_home_tickn", 0) + 1
                if self._home_tickn % 4 == 0 and hc.get("bg", "lava") in ("lava", "colours"):
                    self._home_lava = (self._home_lava + 0.0016) % 1.0
                    c = self._home_c
                    self._home_bg(max(50, c.winfo_width()), max(50, c.winfo_height()))
                if not moved and hc.get("bg", "lava") not in ("lava", "colours"):
                    delay = 500
            else:
                delay = 400
        except Exception as ex:
            _log(f"home: {ex}")
            delay = 1000
        self._home_anim_job = self.root.after(delay, self._home_anim)

    # ---- the books' covers (made by a helper, a little smaller for the ones further away)
    def _home_book_base(self, f):
        files = self.lib.folders.get(f, [])
        if not files:
            return None
        p = self.lib.file_path(f, files[0])
        if not p:
            return None
        try:
            sig = (p, os.path.getmtime(p))
        except OSError:
            return None
        bases = self.__dict__.setdefault("_hb_base", {})
        got = bases.get(f)
        if got is not None and got[0] == sig:
            return got[1]
        bases[f] = (sig, None)

        def here():                                    # 4.4.3: drawn here when the helper could not (a moment)
            try:
                doc = open_light(self.fitz, p)
                pg = doc.load_page(0)
                z = min(self.HB_W / max(1.0, pg.rect.width), self.HB_H / max(1.0, pg.rect.height)) * 1.0
                pix = pg.get_pixmap(matrix=self.fitz.Matrix(z, z), alpha=False)
                doc.close()
                return {"w": pix.width, "h": pix.height, "rgb": bytes(pix.samples)}
            except Exception as ex:
                _log(f"home cover {os.path.basename(p)}: {ex}")
                return {}

        def done(res):
            if "rgb" not in res:
                res = here()
            if "rgb" in res:
                bases[f] = (sig, (res["w"], res["h"], res["rgb"]))
                for k_ in [k_ for k_ in self.__dict__.get("_hb_imgs", {}) if k_[0] == f]:
                    self._hb_imgs.pop(k_, None)
                if getattr(self, "_home", None) is not None:
                    self._home_books_draw()
        if self.pool.disabled:
            self.root.after(30, lambda: done({}))
            return None
        self.pool.submit("render", prio=3, timeout=60, path=p, pi=0, cover=(self.HB_W, self.HB_H), cb=done)
        return None

    def _home_book_img(self, f, level):
        base = self._home_book_base(f)
        if base is None:
            return None
        imgs = self.__dict__.setdefault("_hb_imgs", {})
        key = (f, level)
        if key in imgs:
            return imgs[key]
        try:
            w, h, rgb = base
            sc = self.HB_SCALES[level]
            nw, nh = max(8, int(w * sc)), max(8, int(h * sc))
            pix = self.fitz.Pixmap(self.fitz.csRGB, w, h, rgb, False)
            if (nw, nh) != (w, h):
                pix = self.fitz.Pixmap(pix, nw, nh, None)
            img = tk.PhotoImage(data=pix.tobytes("ppm"))
        except Exception:
            img = None
        imgs[key] = img
        return img

    def _home_slots(self, n, box):
        """Where each book goes: [(index, centre x, bottom y, scale 0-1, depth)] for the chosen layout."""
        import math
        x0, y0, x1, y1 = box
        lay = self._home_conf().get("books", "circle")
        ph = self._home_phase
        W, H = x1 - x0, y1 - y0
        cx = (x0 + x1) / 2
        fit = max(0.35, min(1.0, H * 0.70 / self.HB_H))
        k_sz = {"small": 0.8, "large": 1.2}.get(self._home_conf().get("size"), 1.0)      # 4.4: book size
        fit = max(0.3, min(fit * k_sz, H * 0.86 / self.HB_H))
        out = []
        if lay == "circle":
            m = min(n, 12)
            rx = min(W * 0.38, 520)
            ry = max(30.0, min(H * 0.22, rx * 0.26))
            cy = y0 + H * 0.66
            for i in range(m):
                th = ph + 2 * math.pi * i / m
                dep = (math.cos(th) + 1) / 2
                out.append((i, cx + rx * math.sin(th), cy + ry * math.cos(th), fit * (0.40 + 0.60 * dep ** 1.3),
                            dep))
            self._home_ring = (cx, cy, rx, ry)
        elif lay == "flow":
            fpos = ph % max(1, n)
            sp1 = min(W * 0.17, self.HB_W * fit * 0.95)
            sp2 = sp1 * 0.42
            base = y0 + H / 2 + self.HB_H * fit / 2
            for i in range(n):
                d = ((i - fpos + n / 2.0) % n) - n / 2.0
                a = abs(d)
                if a > 4.6:
                    continue
                x = cx + (1 if d >= 0 else -1) * (a * sp1 if a < 1 else sp1 + (a - 1) * sp2)
                out.append((i, x, base, fit * max(0.5, 1.0 - 0.22 * min(a, 2.2)), -a))
        else:
            sc = fit * (0.80 if lay == "wave" else 0.70 if lay == "shelf" else 0.62)
            bw = self.HB_W * sc
            gap = bw * (0.30 if lay != "grid" else 0.40)
            cols = max(1, int((W + gap) // (bw + gap)))
            rows = 1 if lay == "wave" else max(1, min(2, int((H + 30) // (self.HB_H * sc + 46))))
            m = min(n, cols * rows)
            for i in range(m):
                r_, k_ = divmod(i, cols)
                inrow = min(cols, m - r_ * cols)
                rx0 = cx - (inrow * (bw + gap) - gap) / 2
                x = rx0 + k_ * (bw + gap) + bw / 2
                if lay == "wave":
                    y = y0 + H / 2 + self.HB_H * sc / 2 + math.sin(ph + i * 0.75) * min(16, H * 0.05)
                else:
                    rh = self.HB_H * sc + 46
                    tot = rows * rh
                    y = y0 + (H - tot) / 2 + r_ * rh + self.HB_H * sc + 8
                out.append((i, x, y, sc, 0))
        return out

    def _home_books_draw(self):
        """The books layer only (it moves): drawn again on its own, the rest of Home stays."""
        c = getattr(self, "_home_c", None)
        if c is None or not c.winfo_exists() or not getattr(self, "_home_box", None):
            return
        T, A = self.T, self.accent
        hc = self._home_conf()
        lay = hc.get("books", "circle")
        c.delete("books")
        hits = self._home_bhits = []
        books = self._home_books()
        x0, y0, x1, y1 = self._home_box
        hov = getattr(self, "_home_hover", None)
        ink = T["text"]
        sub = T["muted"]
        if not books:
            return
        gold_d, gold, gold_l = "#9A7417", "#D9A62E", "#FFE6A0"
        slots = self._home_slots(len(books), self._home_box)
        if lay == "circle" and getattr(self, "_home_ring", None):
            cx_, cy_, rx_, ry_ = self._home_ring
            c.create_oval(cx_ - rx_ - 8, cy_ - ry_ - 3, cx_ + rx_ + 8, cy_ + ry_ + 3, outline=gold_d, width=1,
                          tags="books")
            c.create_oval(cx_ - rx_ - 6, cy_ - ry_ - 2, cx_ + rx_ + 6, cy_ + ry_ + 2, outline=gold, width=2,
                          tags="books")
        if lay == "shelf":
            for y_ in sorted({round(s_[2]) for s_ in slots}):
                xs = [s_[1] for s_ in slots if round(s_[2]) == y_]
                bw_ = self.HB_W * slots[0][3]
                sx0, sx1 = min(xs) - bw_ * 0.75, max(xs) + bw_ * 0.75
                c.create_rectangle(sx0, y_ + 1, sx1, y_ + 6, fill=gold, outline="", tags="books")
                c.create_line(sx0, y_ + 1, sx1, y_ + 1, fill=gold_l, tags="books")
                c.create_line(sx0, y_ + 7, sx1, y_ + 7, fill=gold_d, width=2, tags="books")
        focus = None
        if lay in ("circle", "flow") and slots:
            focus = max(slots, key=lambda s_: s_[4])[0]
        order = sorted(slots, key=lambda s_: s_[4])
        for i, cx, by, sc, dep in order:
            f = books[i]
            key = f"bk{i}"
            on = hov == key
            if on and lay in ("wave", "shelf", "grid"):
                by -= 10
                sc = min(1.0, sc * 1.08)
            lvl = max(0, min(len(self.HB_SCALES) - 1, int(round((sc - 0.30) / 0.05))))
            sc = self.HB_SCALES[lvl]
            img = self._home_book_img(f, lvl)
            if img is not None:
                bw, bh = img.width(), img.height()
            else:
                bw, bh = self.HB_W * sc, self.HB_H * sc
            bx0, by0 = cx - bw / 2, by - bh
            col = self.lib.color(f)
            c.create_rectangle(bx0 + 3, by0 + 5, bx0 + bw + 3, by + 5, fill=mix(T["bg"], "#000000", 0.18),
                               outline="", tags="books")
            if img is not None:
                c.create_image(bx0, by0, image=img, anchor="nw", tags="books")
            else:
                c.create_rectangle(bx0, by0, bx0 + bw, by, fill=mix(col, "#FFFFFF", 0.82), outline="", tags="books")
                ts = max(18, int(bw * 0.42))
                draw_tile(c, cx - ts / 2, by0 + bh * 0.36 - ts / 2, ts, col, icon=self.lib.icon(f),
                          text=initials(self.lib.label(f)), font=self.F(max(7, int(ts / 3.6)), "bold"),
                          bg=mix(col, "#FFFFFF", 0.82), style=self.lib.tstyle(f), tag="books")
            c.create_rectangle(bx0, by0, bx0 + max(3, bw * 0.045), by, fill=col, outline="", tags="books")   # spine
            c.create_rectangle(bx0, by0, bx0 + bw, by, outline=gold if on else mix(col, "#000000", 0.25),
                               width=2 if on else 1, tags="books")
            if lay in ("wave", "shelf", "grid"):
                lab = self._fit_text(self.lib.label(f), self._sfont(8, "bold"), bw + 18)
                ly = by + (18 if lay == "shelf" else 12)
                c.create_text(cx, ly, text=lab, font=self.F(8, "bold"), fill=A if on else ink, tags="books")
            hits.append((bx0, by0, bx0 + bw, by, key, lambda f=f: self._home_open_book(f)))
        # the name of the book in front (circle, cover flow) - or the one under the mouse
        show = None
        if hov and hov.startswith("bk"):
            show = int(hov[2:])
        elif focus is not None:
            show = focus
        if show is not None and lay in ("circle", "flow") and show < len(books):
            f = books[show]
            nf = len(self.lib.folders.get(f, []))
            lost = bool(self.lib.missing.get(f))
            ty = y1 - 6
            c.create_text((x0 + x1) / 2, ty - 16, text=self._fit_text(self.lib.label(f), self._sfont(13, "bold"),
                                                                        x1 - x0 - 40),
                          font=self.F(13, "bold"), fill=ink, tags="books")
            c.create_text((x0 + x1) / 2, ty + 4, text="folder not found" if lost else
                          f"{nf} file{'s' if nf != 1 else ''}" + ("  ·  open now" if f == self.folder else ""),
                          font=self.F(9), fill="#D93025" if lost else sub, tags="books")
        if len(books) > len(slots) and lay not in ("flow",):
            on = hov == "allbooks2"
            t_ = f"All {len(books)} books  →"
            c.create_text(x1 - 4, y1 - 2, text=t_, anchor="e", font=self.F(9, "bold"),
                          fill=mix(A, ink, 0.3) if on else A, tags="books")
            wt = self._measure(t_, self._sfont(9, "bold"))
            hits.append((x1 - wt - 8, y1 - 14, x1, y1 + 8, "allbooks2", lambda: (self.close_home(),
                                                                                 self.show_launcher())))

    def _home_draw(self):
        c = getattr(self, "_home_c", None)
        if c is None or not c.winfo_exists():
            return
        self._home_place()
        T, A = self.T, self.accent
        dark = not is_light(T["bg"])
        c.delete("all")
        hits = []
        self._home_hits = hits
        hov = getattr(self, "_home_hover", None)
        W, H = max(400, c.winfo_width()), max(300, c.winfo_height())
        ink, sub = T["text"], T["muted"]
        soft = mix(T["bg"], "#FFFFFF" if not dark else "#000000", 0.55)      # calm pills over the lava
        line = mix(T["bg"], ink, 0.16)
        bg = self._home_bg(W, H)
        if bg is not None:
            c.create_image(0, 0, image=bg, anchor="nw", tags="bg")
        else:
            c.configure(bg=T["bg"])

        def hit(x0, y0, x1, y1, key, fn):
            hits.append((x0, y0, x1, y1, key, fn))
        M = 34 if W > 900 else 22
        # ---- top: the greeting (left), find (middle), personalise + close (right) ------------------------------
        h_ = time.localtime().tm_hour
        hello = ("Good night" if h_ < 5 else "Good morning" if h_ < 12 else "Good afternoon" if h_ < 18 else
                 "Good evening")
        gsz = 30 if W > 1000 else 24
        big = self._text_img(hello, gsz, ink, style="serif_i")
        c.create_image(M, M - 6, image=big[0], anchor="nw")
        today = time.strftime("%A %d %B").replace(" 0", " ")
        c.create_text(M + 2, M + big[2] + 2, text=today, anchor="w", font=self.F(9), fill=sub)
        # close + personalise: thin icons in thin circles
        for k_, (key, ic, fn) in enumerate((("close", "close", self.close_home),
                                            ("hpers", "palette", self.home_personalise))):
            cx_ = W - M - 16 - k_ * 44
            cy_ = M + 12
            on = hov == key
            c.create_oval(cx_ - 17, cy_ - 17, cx_ + 17, cy_ + 17, fill=soft if on else "",
                          outline=mix(line, A, 0.6) if on else line, width=1)
            draw_icon(c, ic, cx_, cy_, A if on else ink, s=0.62, w=1.4)
            hit(cx_ - 18, cy_ - 18, cx_ + 18, cy_ + 18, key, fn)
        att = getattr(self, "_attention", None)
        rows = list((att or {}).get("rows") or [])
        right_ = W - M - 100
        if rows:
            right_ -= 36 + self._measure("00 dates need you", self._sfont(9, "bold")) + 12
        fw = min(400, max(220, W * 0.32), 2 * (right_ - W / 2))
        fx0 = (W - fw) / 2
        if fw >= 200 and fx0 > M + big[1] + 16 and fx0 + fw <= right_:
            on = hov == "find"
            round_rect(c, fx0, M - 6, fx0 + fw, M + 30, 18, fill=soft, outline=mix(line, A, 0.6) if on else line)
            draw_icon(c, "search", fx0 + 20, M + 12, A if on else sub, s=0.6, w=1.4)
            c.create_text(fx0 + 36, M + 12, text="Find a document, a word, an action…", anchor="w", font=self.F(9),
                          fill=sub)
            c.create_text(fx0 + fw - 14, M + 12, text="Ctrl+K", anchor="e", font=self.F(8), fill=sub)
            hit(fx0, M - 6, fx0 + fw, M + 30, "find", lambda: (self.close_home(), self.quick_search()))
        # needs you: one small chip (only when something does)
        if rows:
            n_exp = sum(1 for r_ in rows if r_["left"] < 0)
            colr = "#D93025" if n_exp else "#E8772E"
            t_ = f"{len(rows)} date{'s' if len(rows) != 1 else ''} need{'s' if len(rows) == 1 else ''} you"
            tw_ = self._measure(t_, self._sfont(9, "bold")) + 36
            on = hov == "att"
            ax1 = W - M - 104
            round_rect(c, ax1 - tw_, M - 4, ax1, M + 28, 16, fill=soft, outline=colr if on else line)
            c.create_oval(ax1 - tw_ + 12, M + 8, ax1 - tw_ + 20, M + 16, fill=colr, outline="")
            c.create_text(ax1 - tw_ + 26, M + 12, text=t_, anchor="w", font=self.F(9, "bold"), fill=ink)
            hit(ax1 - tw_, M - 4, ax1, M + 28, "att",
                lambda: (self.close_home(), self.simple_reports(pick="expiry", run=True, scope="library")))
        # ---- bottom: continue (a pill) and the calm icon row -------------------------------------------------------
        dock_y = H - M - 10
        acts = [("openbook", "Read  (F6)", lambda: (self.close_home(), self.reading_mode(True))),
                ("clock", "Recent", self._home_recent_menu),
                ("report", "Reports", lambda: (self.close_home(), self.simple_reports())),
                ("printer", "Print", lambda: (self.close_home(), self.print_dialog())),
                ("bell", "Reminders", lambda: (self.close_home(), self.reminders_dialog())),
                ("grid", "All my books", lambda: (self.close_home(), self.show_launcher())),
                ("plus", "Add a folder", lambda: (self.close_home(), self.import_folder()))]
        step = 46
        dx0 = W / 2 - (len(acts) - 1) * step / 2
        hov_lab = None
        for k_, (ic, lab, fn) in enumerate(acts):
            key = f"act{k_}"
            on = hov == key
            cx_ = dx0 + k_ * step
            c.create_oval(cx_ - 16, dock_y - 16, cx_ + 16, dock_y + 16, fill=soft if on else "",
                          outline=mix(line, A, 0.6) if on else "", width=1)
            draw_icon(c, ic, cx_, dock_y, A if on else ink, s=0.6, w=1.35)
            hit(cx_ - 20, dock_y - 20, cx_ + 20, dock_y + 20, key, fn)
            if on:
                hov_lab = (cx_, lab)
        if hov_lab:
            c.create_text(hov_lab[0], dock_y - 30, text=hov_lab[1], font=self.F(8, "bold"), fill=ink)
        # 4.4: Personalise - quiet, in the corner (a slim panel opens on the right: books, size, what is behind)
        if getattr(self, "_home_drawer", None) is None:
            on = hov == "pers2"
            t_ = "Personalise"
            tw_ = self._measure(t_, self._sfont(9)) + 40
            px1, py_ = W - M, dock_y
            if on:
                round_rect(c, px1 - tw_, py_ - 15, px1, py_ + 15, 15, fill=soft, outline=mix(line, A, 0.6))
            draw_icon(c, "palette", px1 - tw_ + 18, py_, A if on else sub, s=0.5, w=1.3)
            c.create_text(px1 - 12, py_, text=t_, anchor="e", font=self.F(9), fill=A if on else sub)
            hit(px1 - tw_, py_ - 16, px1, py_ + 16, "pers2", self.home_personalise)
        cont_y = dock_y - 58
        rec = [x for x in self.lib.settings.get("recent_docs", []) if x.get("f") in self.lib.folders and
               self.lib.file_path(x["f"], x["rel"])]
        if rec:
            r0 = rec[0]
            nm = os.path.splitext(os.path.basename(r0["rel"]))[0]
            n_ = max(1, int(r0.get("n") or 1))
            p_ = min(n_, int(r0.get("p", 0)) + 1)
            txt = self._fit_text(f"Continue  ·  {nm}", self._sfont(10, "bold"), min(520, W * 0.5))
            sub_t = f"page {p_} of {n_}"
            tw_ = self._measure(txt, self._sfont(10, "bold")) + self._measure(sub_t, self._sfont(9)) + 70
            on = hov == "cont"
            px0 = W / 2 - tw_ / 2
            round_rect(c, px0, cont_y - 18, px0 + tw_, cont_y + 18, 18, fill=mix(A, "#000000", 0.12) if on else A,
                       outline="")
            c.create_text(px0 + 20, cont_y, text=txt, anchor="w", font=self.F(10, "bold"), fill="#FFFFFF")
            c.create_text(px0 + tw_ - 40, cont_y, text=sub_t, anchor="e", font=self.F(9),
                          fill=mix(A, "#FFFFFF", 0.75))
            draw_icon(c, "right", px0 + tw_ - 22, cont_y, "#FFFFFF", s=0.6)
            hit(px0, cont_y - 18, px0 + tw_, cont_y + 18, "cont", self._home_continue)
        elif not self.lib.folders:
            on = hov == "cont"
            t_ = "Add your first folder - each folder becomes a book"
            tw_ = self._measure(t_, self._sfont(10, "bold")) + 44
            round_rect(c, W / 2 - tw_ / 2, cont_y - 18, W / 2 + tw_ / 2, cont_y + 18, 18,
                       fill=mix(A, "#000000", 0.12) if on else A, outline="")
            c.create_text(W / 2, cont_y, text=t_, font=self.F(10, "bold"), fill="#FFFFFF")
            hit(W / 2 - tw_ / 2, cont_y - 18, W / 2 + tw_ / 2, cont_y + 18, "cont",
                lambda: (self.close_home(), self.import_folder()))
        # ---- the books, in the middle -------------------------------------------------------------------------------
        top_b = M + 54
        bot_b = cont_y - 30
        self._home_box = (M, top_b, W - M, bot_b)
        self._home_books_draw()

    def _home_recent_menu(self):
        """Recent documents and the reports you made - a small list, only when you ask."""
        m = self._menu()
        rec = [x for x in self.lib.settings.get("recent_docs", []) if x.get("f") in self.lib.folders and
               self.lib.file_path(x["f"], x["rel"])][:10]
        if rec:
            m.add_command(label="RECENT DOCUMENTS", state="disabled")
            for x in rec:
                nm = os.path.splitext(os.path.basename(x["rel"]))[0]
                m.add_command(label=f"   {nm}   ·   {self.lib.label(x['f'])}   ·   p.{int(x.get('p', 0)) + 1}"
                                    f"   ·   {self._ago(x.get('t'))}",
                              command=lambda x=x: (self.close_home(), self._go_doc(x["f"], x["rel"], x.get("p", 0))))
        runs = [r_ for r_ in self.lib.settings.get("rep_runs", []) if r_.get("k")][:6]
        if runs:
            if rec:
                m.add_separator()
            m.add_command(label="REPORTS YOU MADE", state="disabled")
            for r_ in runs:
                m.add_command(label=f"   {r_.get('title') or r_['k']}   ·   {r_.get('when', '')}",
                              command=lambda k=r_["k"]: (self.close_home(), self.simple_reports(pick=k)))
        if not rec and not runs:
            m.add_command(label="The documents you open appear here.", state="disabled")
        try:
            m.tk_popup(self.root.winfo_pointerx(), self.root.winfo_pointery())
        finally:
            try:
                m.grab_release()
            except Exception:
                pass

    def home_personalise(self):
        """4.4: a slim panel on the right of Home - how your books are shown (circle, cover flow, shelf...), how
        big, what is behind them - and Home changes at once behind it. Click again (or Esc, or the cross) to close
        it."""
        ov = getattr(self, "_home", None)
        dr = getattr(self, "_home_drawer", None)
        if dr is not None:
            self._home_drawer = None
            try:
                dr.destroy()
            except Exception:
                pass
            self._home_draw()
            return
        T = self.T
        if ov is None:                                   # (not on Home: the small window as before)
            d = self._dialog("Personalise Home")
            body = tk.Frame(self._scroll_body(d), bg=T["panel"])
            body.pack(fill="both", padx=22, pady=(12, 4))

            def fill_d():
                for w_ in body.winfo_children():
                    w_.destroy()
                self._fill_home_section(body, refresh=fill_d)
            fill_d()
            bt = ttk.Frame(d, style="Panel.TFrame", padding=(22, 12))
            bt.pack(fill="x")
            PillButton(bt, self, "Done", d.destroy, kind="accent").pack(side="right")
            d.bind("<Escape>", lambda e: d.destroy())
            self._center(d)
            return
        dr = tk.Frame(ov, bg=T["panel"], highlightthickness=1, highlightbackground=T["border"])
        dr.place(relx=1.0, x=-16, y=16, anchor="ne", width=330, relheight=1.0, height=-32)
        self._home_drawer = dr
        dr.bind("<Destroy>", lambda e: setattr(self, "_home_drawer", None) if e.widget is dr else None)
        head = tk.Frame(dr, bg=T["panel"])
        head.pack(fill="x", padx=(18, 10), pady=(12, 2))
        tk.Label(head, text="Personalise Home", font=self.F(12, "bold"), bg=T["panel"], fg=T["text"]).pack(
            side="left")
        x_ = tk.Label(head, text="\u2715", font=self.F(11), bg=T["panel"], fg=T["muted"], cursor="hand2", padx=6)
        x_.pack(side="right")
        x_.bind("<Button-1>", lambda e: self.home_personalise())
        tk.Label(dr, text="Home changes at once, behind this panel.", font=self.F(8), bg=T["panel"],
                 fg=T["muted"]).pack(anchor="w", padx=18)
        foot = tk.Frame(dr, bg=T["panel"])
        foot.pack(side="bottom", fill="x", padx=18, pady=(4, 12))
        more = tk.Label(foot, text="More: the frame, reading, the logo\u2026", font=self.F(9), bg=T["panel"],
                        fg=self.accent, cursor="hand2")
        more.pack(side="left")
        more.bind("<Button-1>", lambda e: (self.home_personalise(), self.personalise_dialog()))
        body = tk.Frame(self._scroll_body(dr), bg=T["panel"])
        body.pack(fill="both", padx=18, pady=(6, 8))

        def fill():
            for w_ in body.winfo_children():
                w_.destroy()
            self._fill_home_section(body, refresh=fill)
        fill()
        for w_ in (dr, body):
            w_.bind("<Escape>", lambda e: self.home_personalise())
        self._home_draw()

    def _home_use_picture(self, path, credit=""):
        hc = self._home_conf()
        hc["photo"] = path
        hc["credit"] = credit
        hc["bg"] = "photo"
        self.lib.save_meta()
        self._home_bgkey = None
        if getattr(self, "_home", None) is not None:
            self._home_draw()

    def _fill_home_section(self, body, refresh):
        """4.3: Personalise > Home - how your books are shown, what is behind them, the gold frame."""
        T = self.T
        hc = self._home_conf()

        def setv(k, v):
            hc[k] = v
            self.lib.save_meta()
            self._home_bgkey = None
            if getattr(self, "_home", None) is not None:
                if k == "gold":
                    self._frame_layout()
                self._home_draw()
            refresh()
        self._qp_section(body, "Home - your books")
        self._qp_chips(body, list(self.HOME_LAYOUTS.items()), hc.get("books"), lambda v: setv("books", v))
        self._qp_section(body, "Home - how big")
        self._qp_chips(body, [("small", "Small"), ("medium", "Medium"), ("large", "Large")],
                       hc.get("size", "medium"), lambda v: setv("size", v))
        self._qp_section(body, "Home - behind")
        self._qp_chips(body, [("lava", "The app's colours"), ("colours", "My colours"), ("photo", "A photo"),
                              ("plain", "Plain")], hc.get("bg"), lambda v: setv("bg", v))
        row = tk.Frame(body, bg=T["panel"])
        row.pack(anchor="w", pady=(4, 0))

        def link(text, fn):
            lb = tk.Label(row, text=text, font=self.F(9), bg=T["panel"], fg=self.accent, cursor="hand2")
            lb.pack(side="left", padx=(0, 14))
            lb.bind("<Button-1>", lambda e: fn())

        def pick_cols():
            cols = []
            old_ = list(hc.get("colors") or [])
            for i in range(4):
                c_ = colorchooser.askcolor(color=old_[i] if i < len(old_) else self.accent, parent=self.root,
                                           title=f"Home colour {i + 1} of 4 (Cancel to stop)")
                if not c_ or not c_[1]:
                    break
                cols.append(c_[1])
            if cols:
                hc["colors"] = cols
                setv("bg", "colours")

        def my_photo():
            p = filedialog.askopenfilename(parent=self.root, title="A photo for Home",
                                           filetypes=[("Pictures", "*.jpg *.jpeg *.png *.bmp *.gif *.webp"),
                                                      ("All files", "*.*")])
            if p:
                try:
                    import shutil
                    dst = os.path.join(self._bg_dir(), "home-" + os.path.basename(p))
                    if os.path.abspath(dst) != os.path.abspath(p):
                        shutil.copy2(p, dst)            # kept with BindLens's settings (the photo itself is not moved)
                    p = dst
                except Exception:
                    pass
                self._home_use_picture(p)
                refresh()

        def online():
            self.picture_gallery(on_done=refresh, use=self._home_use_picture, title="A photo for Home")
        link("Choose my colours…", pick_cols)
        link("My photo…", my_photo)
        link("A photo from the internet…", online)
        if hc.get("bg") == "photo":
            self._qp_section(body, "Photo - soften it")
            self._qp_chips(body, [(0.0, "Not"), (0.15, "A little"), (0.30, "Soft"), (0.5, "Very soft")],
                           float(hc.get("soften", 0.3)), lambda v: setv("soften", v))
        for key, lab in (("motion", "Moving (never in Fast mode)"),
                         ("gold", "A gold frame on Home")):
            var = tk.BooleanVar(value=bool(hc.get(key, True)))
            ttk.Checkbutton(body, text=lab, variable=var,
                            command=lambda k=key, v=var: setv(k, v.get())).pack(anchor="w", pady=(4, 0))
        sv = tk.BooleanVar(value=bool(self.lib.settings.get("start_home", True)))

        def flip():
            self.lib.settings["start_home"] = bool(sv.get())
            self.lib.save_meta()
        ttk.Checkbutton(body, text="Show Home when BindLens starts", variable=sv, command=flip).pack(anchor="w",
                                                                                                    pady=(4, 0))
        tk.Label(body, text="Home: Ctrl+H or the house at the top. The wheel or ← → turn the circle; click a book "
                            "to open it.", font=self.F(8), bg=T["panel"], fg=T["muted"], wraplength=380,
                 justify="left").pack(anchor="w", pady=(6, 0))

    # ---- launcher: every book as a card (Ctrl+L or click the logo) -------------------------------
    def _cover(self, f, w=132, h=104):
        files = self.lib.folders.get(f, [])
        if not files:
            return None
        p = self.lib.file_path(f, files[0])
        try:
            key = (p, os.path.getmtime(p), w, h)
        except Exception:
            return None
        if key in self._covers:
            return self._covers[key]
        if not self.pool.disabled:                 # drawn by a helper; the card shows its tile meanwhile
            self._covers[key] = None

            def got(res):
                img = None
                if "rgb" in res:
                    try:
                        img = tk.PhotoImage(data=b"P6\n%d %d\n255\n" % (res["w"], res["h"]) + res["rgb"])
                    except Exception:
                        img = None
                self._covers[key] = img
                if img is not None and self._launcher is not None:
                    self._draw_launcher()
            self.pool.submit("render", prio=3, timeout=60, path=p, pi=0, cover=(w, h), cb=got)
            return None
        img = None
        try:
            doc = self._open_any(p)
            pg = doc.load_page(0)
            z = w / max(1, pg.rect.width)
            clip = self.fitz.Rect(0, 0, pg.rect.width, min(pg.rect.height, h / z))
            pix = pg.get_pixmap(matrix=self.fitz.Matrix(z, z), clip=clip, alpha=False)
            img = tk.PhotoImage(data=pix.tobytes("ppm"))
            doc.close()
        except Exception:
            img = None
        self._covers[key] = img
        return img

