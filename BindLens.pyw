    data = out.tobytes()
    out.close()
    return data


# ---- 3.2: Word, Excel and PowerPoint exactly as they look: Microsoft Office (or LibreOffice) makes a PDF of them
# in the background, kept in BindLens's own folder - the original file is never touched --------------------------
OFFICE_WORD = {".docx", ".docm", ".dotx", ".dotm", ".doc", ".dot", ".rtf", ".odt", ".wps"}
OFFICE_EXCEL = {".xlsx", ".xlsm", ".xltx", ".xls", ".xlsb", ".xlt", ".ods"}
OFFICE_PPT = {".pptx", ".pptm", ".ppsx", ".potx", ".ppt", ".pps", ".odp"}
OFFICE_EXACT = OFFICE_WORD | OFFICE_EXCEL | OFFICE_PPT
_OFFICE_MEMO = {}


def office_pdf_dir():
    return os.path.join(data_dir(), "office pdf")


def office_pdf_path(path):
    """Where the exact copy of an Office file is kept (a new name when the file changes)."""
    import hashlib
    st = os.stat(path)
    h = hashlib.sha1(os.path.normcase(os.path.abspath(path)).encode("utf-8", "replace")).hexdigest()[:16]
    return os.path.join(office_pdf_dir(), f"{h}-{st.st_size}-{int(st.st_mtime)}.pdf")


def system_idle_seconds():
    """4.0: how long nobody has touched the computer (keyboard / mouse, any program) - Windows; None elsewhere."""
    if os.name != "nt":
        return None
    try:
        import ctypes

        class LII(ctypes.Structure):
            _fields_ = [("cbSize", ctypes.c_uint), ("dwTime", ctypes.c_uint)]
        li = LII()
        li.cbSize = ctypes.sizeof(LII)
        if not ctypes.windll.user32.GetLastInputInfo(ctypes.byref(li)):
            return None
        return max(0.0, (ctypes.windll.kernel32.GetTickCount() - li.dwTime) / 1000.0)
    except Exception:
        return None


def on_battery():
    """4.0: True when a laptop runs on its battery (Windows)."""
    if os.name != "nt":
        return False
    try:
        import ctypes

        class SPS(ctypes.Structure):
            _fields_ = [("ACLineStatus", ctypes.c_ubyte), ("BatteryFlag", ctypes.c_ubyte),
                        ("BatteryLifePercent", ctypes.c_ubyte), ("SystemStatusFlag", ctypes.c_ubyte),
                        ("BatteryLifeTime", ctypes.c_ulong), ("BatteryFullLifeTime", ctypes.c_ulong)]
        sp = SPS()
        if not ctypes.windll.kernel32.GetSystemPowerStatus(ctypes.byref(sp)):
            return False
        return sp.ACLineStatus == 0
    except Exception:
        return False


def office_failed_note(path):
    """Why the exact copy of this file could not be made (None when it was not tried, or it worked)."""
    try:
        p = office_pdf_path(path)[:-4] + ".failed"
        if os.path.exists(p):
            with open(p, "r", encoding="utf-8", errors="replace") as fh:
                return fh.read().strip() or "it could not be opened"
    except OSError:
        pass
    return None


def office_pdf_ready(path):
    """The exact copy of a Word / Excel / PowerPoint file when there is one (None otherwise)."""
    if os.path.splitext(path or "")[1].lower() not in OFFICE_EXACT:
        return None
    now = time.time()
    m = _OFFICE_MEMO.get(path)
    if m and now - m[0] < 5:
        return m[1]
    try:
        p = office_pdf_path(path)
        r = p if os.path.exists(p) else None
    except OSError:
        r = None
    _OFFICE_MEMO[path] = (now, r)
    return r


