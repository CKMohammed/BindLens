    def _on_escape(self, _e=None):
        self._close_float()
        if getattr(self, "_qb_panel", None):           # 4.0: Esc closes the quick bar's panel first
            self._qp_close()
            return
        if self.tool == "edittext":
            self.set_tool("select")
            return
        if self._launcher is not None:
            self.close_launcher()
        elif self.fullscreen:
            self.toggle_fullscreen()
        elif getattr(self, "_reading", False):
            self.reading_mode(False)
        elif self.sel or self.sel_annot:
            self.sel = None
            self.sel_annot = None
            self.redraw()
        elif self.tool != "select":
            self.set_tool("select")

    def set_status(self, t):
        self.status_lbl.config(text=t)

    # ============================================================ library UI
    def _start(self):
        self.root.after(2500, self.check_reminders)
        self.root.after(30000, self._scan_auto_tick)          # 3.2: scanned pages are read by themselves
        self.root.after(4000, self._office_tick)              # 3.2: Office files exactly as they look
        if os.name == "nt":
            first = not self.lib.settings.get("shortcut_auto")
            remake = self.lib.settings.get("shortcut_fix") != APP_VERSION
            self.lib.settings["shortcut_auto"] = True
            self.lib.settings["shortcut_fix"] = APP_VERSION

            def fix_icon():
                """1.9.3: the desktop shortcut always has the logo and opens BindLens - made when there is none yet
                (once), repaired when it points to a copy that was moved or deleted (for example a temporary folder)."""
                try:
                    shortcut_ico(self.lib.settings.get("icon"))
                    res = check_shortcut(force_once=first)
                    if res is None and remake and not in_temp_folder() and os.path.exists(_desktop_link()):
                        info = read_shortcut(_desktop_link())
                        if info and os.path.normcase(APP_DIR) in os.path.normcase(info[0] + info[1]):
                            res = "fixed" if make_shortcut(quiet=True) else None      # new launcher + icon file
                    if res == "made":
                        self.root.after(0, lambda: self.set_status("A BindLens shortcut with the logo was added to "
                                                                   "your desktop."))
                    elif res == "fixed":
                        self.root.after(0, lambda: self.set_status("The BindLens shortcut on your desktop was repaired."))
                except Exception as ex:
                    _log(f"icon: {ex}")
            self.root.after(6000, lambda: threading.Thread(target=fix_icon, daemon=True).start())
            if in_temp_folder() and self.lib.settings.get("temp_warned") != APP_VERSION:
                self.lib.settings["temp_warned"] = APP_VERSION
                self.root.after(2500, lambda: messagebox.showinfo(
                    APP_NAME, "BindLens was opened straight from the zip (a temporary folder).\n\n"
                    "To have a BindLens icon on your desktop that always works:\n"
                    "1. Right-click the zip and choose Extract All.\n"
                    "2. Open the extracted folder and double-click Install.bat.", parent=self.root))
        self.root.after(400, self.apply_background)
        last = self.lib.meta.get("last_folder")
        # 1.9.5: the first reading lists the last book again for real, and the own folder of every other book
        self._scan_async(self._start2, fresh_names={last} if last else None, fresh_roots=True)

    def _start2(self):
        self._fill_folders()
        last = self.lib.meta.get("last_folder")
        if last in self.lib.folders:
            self.open_folder(last, self.lib.meta.get("last_prefix", ""))
        elif self.lib.folders:
            self.open_folder(next(iter(self.lib.folders)))
        else:
            self.redraw()
        self._schedule_index()
        # 1.9.4: every book's folder is listed again for real right away (Windows does not always say that a
        # folder changed while BindLens was closed) - new files are there a moment after you open BindLens
        self.root.after(1200 if self._small_library() else 15000,
                        lambda: self._verify_scan(fresh=True, toast=True))
        self.root.bind("<Activate>", lambda e: self._on_activate(), add="+")
        self.root.bind("<Map>", lambda e: self._on_activate() if e.widget is self.root else None, add="+")
        self.root.after(1000, self._focus_poll)
        self._start_folder_watch()
        self.root.after(3000, self._offer_rescued)
        if self.lib.folders and self.lib.settings.get("start_home", True):
            self.root.after(250, lambda: self.show_home() if getattr(self, "_home", None) is None else None)

    def _offer_rescued(self):
        """3.0: changes that could not be saved when BindLens closed (the file was open in another program):
        put them back now - over the file if nobody changed it since, otherwise as a copy next to it."""
        if self._when_unlocked(self._offer_rescued):
            return
        folder = os.path.join(self.lib.meta_dir, "rescued")
        idx_path = os.path.join(folder, "rescued.json")
        items = [x for x in load_json(idx_path, []) if os.path.exists(x.get("copy", ""))]
        left = []
        for x in items:                    # (saved after all, at the very end: nothing to do)
            try:
                if os.path.getsize(x["path"]) == os.path.getsize(x["copy"]):
                    with open(x["path"], "rb") as a, open(x["copy"], "rb") as b:
                        if a.read() == b.read():
                            os.remove(x["copy"])
                            continue
            except OSError:
                pass
            left.append(x)
        if len(left) != len(items):
            save_json(idx_path, left)
        items = left
        if not items:
            return
        names = "\n".join("•  " + os.path.basename(x["path"]) for x in items[:8])
        if not messagebox.askyesno(APP_NAME, "When BindLens closed last time, these files were open in another "
                                             "program, so your latest marks could not be saved in them:\n\n"
                                             f"{names}\n\nPut your marks in them now?"):
            self.set_status("Your unsaved marks are kept - BindLens asks again next time.")
            return
        done, copies = 0, []
        for x in items:
            path, cp = x["path"], x["copy"]
            try:
                with open(cp, "rb") as fh:
                    data = fh.read()
                same = False
                try:
                    st = os.stat(path)
                    k = x.get("known")
                    same = bool(k) and st.st_size == k[1] and abs(st.st_mtime - k[0]) < 2.0
                except OSError:
                    pass
                if same:
                    self.writer.put(path, data)
                else:                              # changed (or gone) since: a copy next to it
                    base, ext = os.path.splitext(path)
                    dst = base + " (with my marks)" + ext
                    os.makedirs(os.path.dirname(dst), exist_ok=True)
                    with open(dst, "wb") as fh:
                        fh.write(data)
                    copies.append(os.path.basename(dst))
                os.remove(cp)
                done += 1
            except Exception as ex:
                _log(f"rescued: {ex}")
        save_json(idx_path, [x for x in items if os.path.exists(x.get("copy", ""))])
        self.writer.wait(10)
        msg = f"Your marks are back in {done} file{'s' if done != 1 else ''}."
        if copies:
            msg += "  Some files had changed meanwhile - your marks are in: " + ", ".join(copies[:3])
        self.set_status(msg)
        self._toast("✓  " + msg.split("  ")[0], ms=5000)
        if self.folder is not None:
            self.refresh_book(self.folder)

    # ---- reading the folders without holding the window up -----------------------------------------
    def _cols_sig(self):
        return json.dumps(self.lib.collections, sort_keys=True, default=str)

    def _scan_async(self, then=None, fresh=False, label="Reading your folders", fresh_names=None, fresh_roots=False):
        """Read the books' folders in a thread; the window keeps answering (a card shows if it takes long)."""
        self._scan_seq = getattr(self, "_scan_seq", 0) + 1
        seq, sig, box, t0 = self._scan_seq, self._cols_sig(), {}, time.time()
        self._scanning = True

        def work():
            try:
                box["r"] = self.lib.compute_scan(fresh, fresh_names=fresh_names, fresh_roots=fresh_roots)
            except Exception as ex:
                box["err"] = ex
                _log(f"scan: {ex}")

        def card():
            c = self.canvas
            c.delete("scancard")
            W, H = max(300, c.winfo_width()), max(200, c.winfo_height())
            x0, y0 = c.canvasx(W / 2), c.canvasy(H / 2)
            T = self.T
            round_rect(c, x0 - 190, y0 - 40, x0 + 190, y0 + 40, 14, fill=T["panel"], outline=T["border"],
                       tags="scancard")
            c.create_text(x0, y0 - 12, text=label + "…", font=UI_FONT_B, fill=T["text"], tags="scancard")
            c.create_text(x0, y0 + 14, text=f"{getattr(self.lib, 'scan_count', 0)} folders read",
                          font=UI_FONT_S, fill=T["muted"], tags="scancard")

        def check():
            if "r" not in box and "err" not in box:
                if time.time() - t0 > 0.35:
                    card()
                self.root.after(60, check)
                return
            self.canvas.delete("scancard")
            if seq == self._scan_seq:
                self._scanning = False
            if "r" in box and seq >= getattr(self, "_scan_applied", 0) and sig == self._cols_sig():
                self._scan_applied = seq
                self.lib.apply_scan(box["r"])
            elif "r" in box and sig != self._cols_sig():
                self.lib.scan()                     # the books changed meanwhile: read again (quick: remembered)
            if then:
                then()
        threading.Thread(target=work, daemon=True).start()
        self.root.after(15, check)

    def _small_library(self):
        """Few enough folders to list all of them again in a moment (most libraries)."""
        return len(getattr(self.lib, "_dc", {}) or {}) <= 700

    def _on_activate(self):
        """Back in BindLens (after saving files in Explorer, Word…): new files appear by themselves.
        1.9.3: the folders are listed again for real - Windows does not always tell that a folder changed."""
        if time.time() - getattr(self, "_last_verify", 0) > 3:
            names = set(self.lib.folders) if self._small_library() else {self.folder}
            self._verify_scan(fresh_names={n for n in names if n is not None} or None, toast=True)

    def _watch_loop(self):
        """Every 30 s (while BindLens is open and not minimised): files added to the books' folders by other
        programs (a scanner, OneDrive, Explorer…) appear without pressing anything."""
        try:
            if self.root.state() != "iconic" and time.time() - getattr(self, "_last_verify", 0) > 20 and \
                    getattr(self, "_idle_win", None) is None:
                names = set(self.lib.folders) if self._small_library() else {self.folder}
                names.discard(None)
                if names:
                    self._verify_scan(fresh_names=names, toast=True)
        except Exception:
            pass
        self.root.after(30000, self._watch_loop)

    def _focus_poll(self):
        """Back in BindLens from another program - even when Windows sends no 'activate' message."""
        try:
            has = bool(self.root.tk.call("focus"))
        except Exception:
            has = True
        if has and not getattr(self, "_had_focus", True):
            self._on_activate()
        self._had_focus = has
        self.root.after(1000, self._focus_poll)

    def _watch_map(self):
        """The folders Windows should watch: each book's folders (with everything inside them), the folders linked
        as sub-books, and for books of loose documents the folder each document is in."""
        out = {}

        def add(path, book, tree):
            k = os.path.normcase(os.path.abspath(path))
            books, t0 = out.get(k, ((), False))
            out[k] = (tuple(sorted(set(books) | {book})), t0 or tree)
        for c in self.lib.collections:
            name = c["name"]
            for src in c.get("sources", []):
                if os.path.isdir(src):
                    add(src, name, not c.get("flat"))
                elif os.path.dirname(src) and os.path.isdir(os.path.dirname(src)):
                    add(os.path.dirname(src), name, False)
            for ln in c.get("links", []):
                if os.path.isdir(ln.get("path", "")):
                    add(ln["path"], name, True)
        return out

    def _start_folder_watch(self):
        if os.name != "nt" or getattr(self, "_fwatch", None) is not None:
            return
        try:
            self._fwatch = FolderWatcher()
            self._fwatch.set_folders(self._watch_map())
            self._fwatch_sig = self._cols_sig()
            self._fwatch.start()
        except Exception as ex:
            self._fwatch = None
            _log(f"folder watch: {ex}")
            return
        self.root.after(700, self._watch_poll)

    def _watch_poll(self):
        """Every 0.7 s: did Windows tell us that a book's folder changed? Then read that book again (a small note
        says what is new)."""
        w = getattr(self, "_fwatch", None)
        if w is None:
            return
        try:
            sig = self._cols_sig()
            if sig != getattr(self, "_fwatch_sig", None):
                self._fwatch_sig = sig
                w.set_folders(self._watch_map())
            names = w.take() & set(self.lib.folders)
            if names:
                self._verify_scan(fresh_names=names, toast=True)
        except Exception as ex:
            _log(f"folder watch poll: {ex}")
        self.root.after(700, self._watch_poll)

    def _fresh_check(self, folder):
        """A book was opened: its folder is listed again in the background (cheap), so a file saved there a
        moment ago is in it even when Windows did not mark the folder as changed."""
        now = time.time()
        fa = self.__dict__.setdefault("_fresh_at", {})
        if folder is None or now - fa.get(folder, 0) < 10:
            return
        fa[folder] = now
        self.root.after(900, lambda: self._verify_scan(fresh_names={folder}, toast=True))

    # ---- 1.9.9: a book's folder that was moved or renamed on the computer is followed ---------------------
    def _moved_targets(self, force=False):
        """The missing folders to look for: {key: (old folder, {books})}."""
        lib = self.lib
        now = time.time()
        tried = self.__dict__.setdefault("_moved_tried", {})
        out = {}
        for name, paths in lib.missing.items():
            for p_ in paths:
                d_ = p_
                if os.path.splitext(p_)[1] and is_supported(p_):       # a file of the book: look for its folder
                    d_ = os.path.dirname(p_)
                    if os.path.isdir(d_):
                        continue                   # its folder is there: only the file itself was moved away
                k = lib.norm(d_)
                if k in out:
                    out[k][1].add(name)
                    continue
                if not force and now - tried.get(k, 0) < 6 * 3600:      # (once a session, or when you ask)
                    continue
                out[k] = (d_, {name})
        return out

    def _follow_moved(self, force=False, then=None):
        """Look for the missing folders in the background; the ones found are followed by themselves."""
        if getattr(self, "_moved_busy", False):
            return
        lib = self.lib
        todo = self._moved_targets(force)
        if not todo:
            if then:
                then({})
            return
        self._moved_busy = True
        now = time.time()
        fps = lib.meta.get("fps", {})
        targets = {}
        for k, (d_, _names) in todo.items():
            self._moved_tried[k] = now
            fp = fps.get(k) or [0, 0, None]
            targets[k] = (os.path.basename(os.path.normpath(d_)), fp[0], fp[1], fp[2])
        srcs = [x for c in lib.collections for x in c.get("sources", [])]
        missing = [d_ for d_, _ in todo.values()]
        box = {}
        self.redraw()

        def work():
            try:
                others = [x for x in srcs if os.path.exists(x)]
                box["r"] = find_moved(targets, moved_roots(missing, others),
                                      stop=lambda: getattr(self, "_closing", False))
            except Exception as ex:
                box["r"] = {}
                _log(f"find moved folders: {ex}")

        def check():
            if "r" not in box:
                self.root.after(250, check)
                return
            self._moved_busy = False
            res = box["r"]
            done, ask = [], []
            for k, (d_, names) in todo.items():
                r_ = res.get(k)
                if not r_:
                    continue
                if r_[0] == "ok":
                    done.append((d_, r_[1]))
                else:
                    ask.append((d_, r_[1], names))
            if done:
                self._moved_apply(done)
            else:
                self.redraw()
            if ask:
                self._ask_which_moved(ask)
            if then:
                then(res)
        threading.Thread(target=work, daemon=True).start()
        self.root.after(250, check)

    def _move_caches(self, old, new):
        """2.0 - what BindLens remembers about the files of a folder that moved (their pages, their text for the
        search) moves with it: nothing has to be read again ("Reading 0 of 10 files" stayed on the screen)."""
        lib = self.lib
        o, n = lib.norm(old), lib.norm(new)
        if o == n:
            return

        def mvk(k):
            if k == o or k.startswith(o.rstrip("\\/") + os.sep):
                return n + k[len(o):]
            return None
        moved = 0
        for k in list(self.page_sizes):
            nk = mvk(k)
            if nk:
                self.page_sizes[nk] = self.page_sizes.pop(k)
                moved += 1
        if moved:
            self._save_sizes()
        ix = getattr(self, "indexer", None)
        if ix is not None:
            try:
                with ix.lock:
                    for k in list(ix.data):
                        nk = mvk(k)
                        if nk:
                            ix.data[nk] = ix.data.pop(k)
                            ix.changed = True
            except Exception as ex:
                _log(f"move index: {ex}")
        stats = getattr(self, "_stats", None) or {}
        for k in list(stats):
            if lib.norm(k) == o or lib.norm(k).startswith(o.rstrip("\\/") + os.sep):
                stats.pop(k, None)

    def _moved_apply(self, pairs, quiet=False):
        """Follow folders to where they are now [(old, new)]: the books read their new place."""
        lib = self.lib
        names = []
        for old, new in pairs:
            hit = lib.relink(old, new)
            if hit:
                self._move_caches(old, new)
            for n in hit:
                if n not in names:
                    names.append(n)
        if not names:
            return
        box = {}

        def work():
            try:
                box["r"] = lib.compute_scan(fresh_names=set(names))
            except Exception as ex:
                box["err"] = ex

        def check():
            if "r" not in box and "err" not in box:
                self.root.after(120, check)
                return
            if "r" in box:
                lib.apply_scan(box["r"])
            else:
                lib.scan()
            self._fill_folders()
            if self.folder in names:
                self.open_folder(self.folder, self.prefix)          # the book first - then the search reads

                def heal(n_=0):
                    # (the book must show its documents now: if it opened empty, open it again)
                    if self.folder not in names or not lib.folders.get(self.folder):
                        return
                    if getattr(self, "_prescan_token", None) is not None:
                        if n_ < 60:
                            self.root.after(1000, lambda: heal(n_ + 1))
                        return
                    if self.book is None or not self.book.total:
                        _log(f"moved book opened empty - opening again ({self.folder})")
                        self.open_folder(self.folder, self.prefix)
                self.root.after(1500, heal)
            self._schedule_index()
            if quiet:
                return
            old, new = pairs[0]
            ob, nb = os.path.basename(os.path.normpath(old)), os.path.basename(os.path.normpath(new))
            where = os.path.dirname(os.path.normpath(new))
            wn = os.path.basename(where) or where
            if os.path.normcase(ob) == os.path.normcase(nb):
                txt = f"“{ob}” was moved - BindLens found it in “{wn}” and follows it now"
            else:
                txt = f"“{ob}” was moved or renamed - BindLens found it: “{nb}” in “{wn}”"
            if len(pairs) > 1:
                txt += f" (and {len(pairs) - 1} more)"
            book = names[0]
            self._toast(txt, folder=book, ms=8000,
                        click=(lambda b_=book: self.open_folder(b_)) if book != self.folder else None)
            self.set_status(f"Found where “{ob}” is now: {new}  ·  your marks, places and settings are kept.")
        threading.Thread(target=work, daemon=True).start()
        self.root.after(120, check)

    def _ask_which_moved(self, ask):
        """More than one folder could be it: you choose."""
        T = self.T
        if not ask:
            return
        old_w = getattr(self, "_moved_win", None)
        if old_w is not None and old_w.winfo_exists():
            old_w.destroy()
        old, cands, names = ask[0]
        rest = ask[1:]
        d = self._dialog("Where is it now?")
        self._moved_win = d
        tk.Label(d, text="Where is this folder now?", font=self.F(14, "bold"), bg=T["panel"], fg=T["text"]).pack(
            anchor="w", padx=20, pady=(16, 4))
        books = ", ".join(f"“{lib_n}”" for lib_n in sorted(names))
        tk.Label(d, text=f"The folder of {books} is not where it was:\n{old}\n\nBindLens found "
                         f"{'these folders' if len(cands) > 1 else 'this folder'} with its name. Which one is it?",
                 font=self.F(9), bg=T["panel"], fg=T["muted"], wraplength=600, justify="left").pack(anchor="w",
                                                                                                  padx=20)
        var = tk.StringVar(value=cands[0])
        lst = tk.Frame(d, bg=T["panel"])
        lst.pack(fill="x", padx=24, pady=(10, 0))
        for c_ in cands:
            ttk.Radiobutton(lst, text=c_, value=c_, variable=var).pack(anchor="w", pady=2)
        bf = tk.Frame(d, bg=T["panel"])
        bf.pack(fill="x", padx=20, pady=16)

        def nxt():
            if rest:
                self.root.after(300, lambda: self._ask_which_moved(rest))

        def use():
            ch = var.get()
            d.destroy()
            self._moved_apply([(old, ch)])
            nxt()

        def other():
            d.destroy()
            self.find_book_folder(next(iter(sorted(names))), old)
            nxt()

        def later():
            d.destroy()
            nxt()
        PillButton(bf, self, "Use this folder", use, kind="accent").pack(side="right")
        PillButton(bf, self, "Choose another…", other, kind="soft").pack(side="right", padx=8)
        PillButton(bf, self, "Not now", later, kind="ghost").pack(side="left")
        d.bind("<Escape>", lambda e: later())
        self._center(d)

    def find_book_folder(self, book=None, old=None):
        """'Find it…' - you show BindLens where a book's folder is now (when it was moved or renamed)."""
        book = self.folder if book is None else book
        lib = self.lib
        if old is None:
            miss = lib.missing.get(book) or []
            if not miss:
                return
            old = miss[0]
            if os.path.splitext(old)[1] and is_supported(old):
                old = os.path.dirname(old)
        start = os.path.dirname(os.path.normpath(old))
        while start and not os.path.isdir(start) and os.path.dirname(start) != start:
            start = os.path.dirname(start)
        new = filedialog.askdirectory(title=f"Where is “{os.path.basename(os.path.normpath(old))}” now?",
                                      initialdir=start if os.path.isdir(start or "") else os.path.expanduser("~"),
                                      mustexist=True)
        if not new:
            return
        new = os.path.abspath(new)
        if not lib.relink(old, new) and lib.norm(new) != lib.norm(old):
            messagebox.showinfo(APP_NAME, "Nothing to change - no book uses that folder.")
            return
        self._move_caches(old, new)
        names = [book]

        def done():
            self._fill_folders()
            if self.folder == book:
                self.open_folder(book, self.prefix)
            self._schedule_index()
            self.set_status(f"“{lib.label(book)}” now reads its folder from {new}.")
        self._scan_async(then=done, fresh_names=set(names), label="Reading the folder")

    def _toast(self, text, folder=None, ms=3800, click=None, action=None):
        """A small note that comes and goes - next to the book's icon when it is on screen, otherwise at the
        bottom right. 3.0: rounded, stays while the mouse is on it, and can carry one action (e.g. Undo)."""
        T, A = self.T, self.accent
        old = getattr(self, "_toast_w", None)
        if old is not None:
            try:
                old.destroy()
            except Exception:
                pass
        fnt = self._sfont(10, "bold")
        tw = self._measure(text, fnt)
        aw = self._measure(action[0], fnt) + 26 if action else 0
        W_, H_ = int(tw + 30 + aw + 22), 40
        bgc = self.T["bg"]
        w = tk.Canvas(self.root, width=W_, height=H_, bg=bgc, highlightthickness=0, bd=0,
                      cursor="hand2" if click else "")
        round_rect(w, 1, 2, W_ - 1, H_ - 1, 18, fill=mix(A, "#000000", 0.35), outline="")
        round_rect(w, 0, 0, W_ - 2, H_ - 3, 18, fill=A, outline="")
        w.create_text(16, H_ / 2 - 1, text=text, anchor="w", font=self.F(10, "bold"), fill="#FFFFFF")
        if action:
            ax = 16 + tw + 14
            w.create_line(ax - 6, 10, ax - 6, H_ - 12, fill=mix(A, "#FFFFFF", 0.45))
            w.create_text(ax + 6, H_ / 2 - 1, text=action[0], anchor="w", font=self.F(10, "bold"),
                          fill=mix("#FFFFFF", A, 0.08), tags="act")
        w.create_text(W_ - 16, H_ / 2 - 1, text="×", font=self.F(11, "bold"), fill=mix("#FFFFFF", A, 0.3),
                      tags="x")
        self._toast_w = w
        x, y, anchor = None, None, "w"
        try:
            if folder is not None and self.rail.winfo_ismapped():
                for y0, y1, f in getattr(self, "_rail_rows", []):
                    if f == folder:
                        yy = self.rail_c.winfo_rooty() - self.root.winfo_rooty() + (y0 + y1) / 2 - \
                            self.rail_c.canvasy(0)
                        if 0 < yy < self.root.winfo_height():
                            x = self.rail.winfo_rootx() - self.root.winfo_rootx() + self.rail.winfo_width() + 8
                            y = yy
                        break
        except Exception:
            pass
        if x is None:
            x, y, anchor = self.root.winfo_width() - 22, self.root.winfo_height() - 40, "se"
            w.configure(bg=T["canvas"])              # 3.0: its corners match the page area it floats on
        w.place(x=x, y=y, anchor=anchor)
        tk.Misc.tkraise(w)                 # (a Canvas's own lift() raises items, not the widget)
        job = [None]

        def gone(_e=None):
            if getattr(self, "_toast_w", None) is w:
                self._toast_w = None
            try:
                w.destroy()
            except Exception:
                pass

        def later(t):
            if job[0]:
                try:
                    self.root.after_cancel(job[0])
                except Exception:
                    pass
            job[0] = self.root.after(t, gone) if t else None

        def clicked(e):
            items = w.find_overlapping(e.x - 2, e.y - 2, e.x + 2, e.y + 2)
            tags = {t_ for i_ in items for t_ in w.gettags(i_)}
            if "x" in tags or e.x > W_ - 30:
                return gone()
            if action and ("act" in tags or e.x > 16 + tw + 4):
                gone()
                return action[1]()
            gone()
            if click:
                click()
        w.bind("<Button-1>", clicked)
        w.bind("<Enter>", lambda e: later(0))             # it waits while the mouse is on it
        w.bind("<Leave>", lambda e: later(2500))
        later(ms + (2500 if action else 0))
        _ = T

    @staticmethod
    def _changes_text(changes):
        """'Centre: 2 new files' / 'New files in Centre (2) and Forms (1)'."""
        bits = []
        for f, (new, gone) in changes.items():
            part = []
            if new:
                part.append(f"{new} new file{'s' if new != 1 else ''}")
            if gone:
                part.append(f"{gone} file{'s' if gone != 1 else ''} gone")
            bits.append((f, ", ".join(part)))
        if len(bits) == 1:
            return f"↻  {bits[0][0]}: {bits[0][1]}"
        return "↻  " + "  ·  ".join(f"{f}: {t}" for f, t in bits[:3]) + ("  …" if len(bits) > 3 else "")

    def refresh_book(self, f, _tries=0):
        """The small ↻ on a book: go to its folders on the computer NOW and read them again for real - every
        folder and sub-folder (nothing from memory), new files added, removed ones dropped, changed ones read
        again - and say what was found. A folder that was moved is looked for first (2.0)."""
        if f not in self.lib.folders or (getattr(self, "_refreshing", None) and not _tries):
            if _tries:                                  # (the book was renamed / removed meanwhile)
                self._refreshing = None
                self._draw_rail()
            return
        lib = self.lib
        before = list(lib.folders.get(f, []))
        old_stat = {}
        for rel in before:
            p_ = lib.file_path(f, rel)
            c_ = self.page_sizes.get(lib.norm(p_)) if p_ else None
            if c_:
                old_stat[rel] = (c_.get("m"), c_.get("s"))
        self._refreshing = f
        self._refresh_t0 = time.time()
        self._draw_rail()
        if not _tries:
            self._spin_refresh()
        sig, box = self._cols_sig(), {}

        def work():
            try:
                r_ = lib.compute_scan(False, fresh_names={f})
                # every file of the book: its date and size on the disk now (a file changed in Word / Excel)
                changed = []
                for rel in r_["folders"].get(f, []):
                    full = r_["paths"].get((f, rel))
                    o_ = old_stat.get(rel)
                    if not full or o_ is None:
                        continue
                    try:
                        st_ = os.stat(full)
                    except OSError:
                        continue
                    if o_ != (st_.st_mtime, st_.st_size):
                        changed.append(rel)
                box["changed"] = changed
                box["r"] = r_
            except Exception as ex:
                box["err"] = ex

        def check():
            if "r" not in box and "err" not in box or time.time() - self._refresh_t0 < 0.6:
                self.root.after(80, check)
                return
            r = box.get("r")
            if r is not None and sig != self._cols_sig() and _tries < 3:
                self.root.after(200, lambda: self.refresh_book(f, _tries + 1))   # the books changed: again
                return
            self._refreshing = None
            if r is None:
                self._draw_rail()
                self._toast(f"Could not read the folder of “{lib.label(f)}”: {box.get('err')}", folder=f, ms=6000)
                return
            lib.apply_scan(r)
            self._fill_folders()
            name = lib.label(f)
            if r["missing"].get(f):
                self._draw_rail()
                self._toast(f"“{name}”: its folder is not where it was - BindLens is looking for it…", folder=f,
                            ms=5000)
                self.set_status(f"The folder of {name} can't be found - looking for it on your computer…")

                def said(res):
                    if lib.missing.get(f):
                        self._toast(f"“{name}”: its folder was not found - click “Find it…” to show where it is",
                                    folder=f, ms=7000, click=lambda: self.open_folder(f))
                self._follow_moved(force=True, then=said)
                if f == self.folder:
                    self.redraw()
                return
            after = r["folders"].get(f, [])
            new, gone = len(set(after) - set(before)), len(set(before) - set(after))
            changed = box.get("changed") or []
            ndirs = len([x for x in (lib.col(f) or {}).get("sources", []) if os.path.isdir(x)]) + \
                len(r["subdirs"].get(f, [])) + len((lib.col(f) or {}).get("links", []))
            if f == self.folder and self.book is not None and (after != before or changed):
                self._reopen_keep_history()
            self._schedule_index()
            bits = []
            if new:
                bits.append(f"{new} new")
            if changed:
                bits.append(f"{len(changed)} changed")
            if gone:
                bits.append(f"{gone} gone")
            where = f"{max(1, ndirs)} folder{'s' if ndirs != 1 else ''} read on your computer"
            if bits:
                txt = f"↻  {name}: {', '.join(bits)}  ·  {where}"
                self.set_status(f"{name}: {', '.join(bits)} - {len(after)} files now ({where}).")
            else:
                txt = f"✓  {name} is up to date - {len(after)} files  ·  {where}"
                self.set_status(f"{name} is up to date: {len(after)} files, nothing new ({where}). "
                                f"A file is missing? Help > Check my folders.")
            self._toast(txt, folder=f, ms=5000,
                        click=(lambda: self.check_folders(f)) if not bits else
                        ((lambda: self.open_folder(f)) if f != self.folder else None))
        threading.Thread(target=work, daemon=True).start()
        self.root.after(80, check)

    def _spin_refresh(self):
        if getattr(self, "_refreshing", None) is None:
            return
        self._spin_a = (getattr(self, "_spin_a", 0) - 30) % 360
        self._draw_rail()
        self.root.after(60, self._spin_refresh)

    def _verify_scan(self, fresh=False, fresh_names=None, toast=False):
        """Read the books' folders again in the background; when files were added, removed or renamed the lists
        (and the open book) change by themselves, and a small note says what changed."""
        if getattr(self, "_verify_busy", False) or getattr(self, "_scanning", False):
            pend = self.__dict__.setdefault("_verify_pending", [False, set(), False])
            pend[0] = pend[0] or fresh
            pend[1] |= set(fresh_names or ())
            pend[2] = pend[2] or toast
            if not getattr(self, "_verify_busy", False):
                self._verify_later()                 # 1.9.5: a reading of the folders is on: right after it
            return
        self._verify_busy = True
        self._last_verify = time.time()
        sig, box, tries = self._cols_sig(), {}, [0]

        def work():
            try:
                box["r"] = self.lib.compute_scan(fresh, fresh_names=fresh_names)
            except Exception as ex:
                box["err"] = ex
                _log(f"verify scan: {ex}")

        def finish():
            self._verify_busy = False
            pend = self.__dict__.pop("_verify_pending", None)
            if pend:
                self.root.after(150, lambda: self._verify_scan(pend[0], pend[1] or None, pend[2]))

        def check():
            if "r" not in box and "err" not in box:
                self.root.after(150, check)
                return
            r = box.get("r")
            if r is not None and (sig != self._cols_sig() or getattr(self, "_scanning", False)):
                # the books changed meanwhile (or another reading is on): do it again, nothing is lost
                pend = self.__dict__.setdefault("_verify_pending", [False, set(), False])
                pend[0] = pend[0] or fresh
                pend[1] |= set(fresh_names or ())
                pend[2] = pend[2] or toast
                return finish()
            if r is None:
                return finish()
            lib = self.lib
            if r["folders"] == lib.folders and r["subdirs"] == lib.subdirs and r["missing"] == lib.missing:
                lib.dircache_save()
                return finish()
            busy = getattr(self, "_prescan_token", None) is not None or getattr(self, "_ed", None) or self.drag
            if busy and tries[0] < 40:                       # a book is opening / you are typing: in a moment
                tries[0] += 1
                self.root.after(400, check)
                return
            changes = {}
            for f, files in r["folders"].items():
                old_files = lib.folders.get(f)
                if old_files is None or old_files == files:
                    continue
                a_, b_ = set(old_files), set(files)
                if a_ != b_:
                    changes[lib.label(f)] = (len(b_ - a_), len(a_ - b_))
            old = lib.folders.get(self.folder)
            lib.apply_scan(r)
            self._fill_folders()
            self._schedule_index()
            if self.folder is not None and self.book is not None and lib.folders.get(self.folder) != old:
                if not getattr(self, "_ed", None) and not self.drag:
                    self._reopen_keep_history()
                else:
                    self.set_status("New or changed files in this book's folder - press F5 to show them.")
            if changes:
                self.set_status(self._changes_text(changes).lstrip("↻ ") + ".")
                if toast:
                    one = next(iter(changes)) if len(changes) == 1 else None
                    fkey = next((f for f in lib.folders if lib.label(f) == one), None) if one else None
                    self._toast(self._changes_text(changes), folder=fkey,
                                click=(lambda f_=fkey: self.open_folder(f_)) if fkey is not None and
                                fkey != self.folder else None)
            finish()
        threading.Thread(target=work, daemon=True).start()
        self.root.after(150, check)

    def check_folders(self, only=None):
        """1.9.5 - Help > Check my folders: what is really in each book's folder, and why a file is not in the book
        (a kind BindLens can't read, removed from the book by you, a folder that is gone…). New files it finds are
        added straight away."""
        T, A = self.T, self.accent
        old = getattr(self, "_check_win", None)
        if old is not None and old.winfo_exists():
            old.destroy()
        d = self._dialog("Check my folders")
        self._check_win = d
        d.resizable(True, True)
        tk.Label(d, text="Check my folders" if only is None else f"Check “{self.lib.label(only)}”",
                 font=self.F(15, "bold"), bg=T["panel"], fg=T["text"]).pack(anchor="w", padx=20, pady=(16, 2))
        w = getattr(self, "_fwatch", None)
        how = (f"Windows tells BindLens at once when a file is added to one of your books' folders "
               f"({getattr(w, 'watching', 0)} folders watched)." if w is not None else
               "BindLens reads your books' folders again when you come back to it, and every 30 seconds.")
        tk.Label(d, text=how, font=self.F(9), bg=T["panel"], fg=T["muted"], wraplength=640, justify="left").pack(
            anchor="w", padx=20)
        body = tk.Frame(d, bg=T["panel"])
        body.pack(fill="both", expand=True, padx=20, pady=10)
        txt = tk.Text(body, width=86, height=22, wrap="word", relief="flat", bd=0, font=self.F(10), bg=T["pill"],
                      fg=T["text"], padx=12, pady=10, highlightthickness=0, cursor="arrow")
        txt.pack(side="left", fill="both", expand=True)
        ScrollRail(body, self, txt).pack(side="left", fill="y", padx=(5, 0))
        txt.tag_configure("book", font=self.F(11, "bold"), foreground=A, spacing1=8)
        txt.tag_configure("path", font=self.F(9), foreground=T["muted"])
        txt.tag_configure("ok", foreground="#1E8E3E")
        txt.tag_configure("warn", foreground="#C5221F")
        txt.tag_configure("note", foreground=T["muted"])
        txt.insert("end", "Looking in your folders…", "note")
        txt.configure(state="disabled")
        bf = tk.Frame(d, bg=T["panel"])
        bf.pack(fill="x", padx=20, pady=(0, 14))
        removed_all = []

        def put_back():
            n_ = 0
            for c in self.lib.collections:
                keep = [x for x in c.get("exclude", []) if x not in removed_all]
                n_ += len(c.get("exclude", [])) - len(keep)
                c["exclude"] = keep
            self.lib.save_meta()
            d.destroy()
            self.set_status(f"{n_} file(s) put back in their books.")
            self._verify_scan(fresh=True, toast=True)
        pb = PillButton(bf, self, "Put back the files I removed", put_back, kind="soft")
        PillButton(bf, self, "Close", d.destroy, kind="ghost").pack(side="right")
        PillButton(bf, self, "Read all folders again now", lambda: (d.destroy(), self.reload()),
                   kind="accent").pack(side="right", padx=8)
        d.bind("<Escape>", lambda e: d.destroy())
        d.geometry(f"760x560+{self.root.winfo_rootx() + max(0, (self.root.winfo_width() - 760) // 2)}+"
                   f"{self.root.winfo_rooty() + 60}")
        cols = [dict(c) for c in self.lib.collections if only is None or c["name"] == only]
        in_books = {}
        for (b_, _rel), p_ in self.lib.paths.items():
            in_books.setdefault(b_, set()).add(self.lib.norm(p_))
        box = {}
        quiet = {"desktop.ini", "thumbs.db", ".ds_store"}

        def work():
            rows, budget = [], [40000]
            for c in cols:
                name = c["name"]
                have = in_books.get(name, set())
                excl = {self.lib.norm(x): x for x in c.get("exclude", [])}
                info = {"name": name, "roots": [], "gone": [], "skipped": [], "removed": [], "new": [],
                        "count": len(have), "docs": not any(os.path.isdir(x) for x in c.get("sources", []))}
                roots = [(x, not c.get("flat")) for x in c.get("sources", []) if os.path.isdir(x)]
                roots += [(ln.get("path", ""), True) for ln in c.get("links", []) if os.path.isdir(ln.get("path", ""))]
                for x in c.get("sources", []) + [ln.get("path", "") for ln in c.get("links", [])]:
                    if x and not os.path.exists(x):
                        info["gone"].append(x)
                for root, deep in roots:
                    info["roots"].append(root)
                    for dp, dns, fns in os.walk(root):
                        dns[:] = sorted(x for x in dns if not x.startswith(".")) if deep else []
                        for fn in fns:
                            budget[0] -= 1
                            if budget[0] < 0:
                                break
                            full = os.path.join(dp, fn)
                            n_ = self.lib.norm(full)
                            if n_ in have:
                                continue
                            if n_ in excl:
                                info["removed"].append(excl[n_])
                            elif fn.startswith(("~$", ".")) or fn.lower() in quiet or fn.endswith(".bindlens-tmp"):
                                continue
                            elif not is_supported(fn):
                                info["skipped"].append(full)
                            else:
                                info["new"].append(full)
                rows.append(info)
            box["rows"] = rows

        def show():
            if "rows" not in box:
                self.root.after(120, show)
                return
            if not d.winfo_exists():
                return
            txt.configure(state="normal")
            txt.delete("1.0", "end")
            new_total = 0
            for info in box["rows"]:
                txt.insert("end", self.lib.label(info["name"]) + "\n", "book")
                for r_ in info["roots"]:
                    txt.insert("end", "   " + r_ + "\n", "path")
                if info["docs"]:
                    txt.insert("end", "   A book of documents you chose one by one - other files in their folders are "
                                      "not part of it (right-click it > Add more documents).\n", "note")
                txt.insert("end", f"   ✓ {info['count']} file{'s' if info['count'] != 1 else ''} in the book\n", "ok")
                if info["new"]:
                    new_total += len(info["new"])
                    txt.insert("end", f"   + {len(info['new'])} new - they are being added now:\n", "ok")
                    for x in info["new"][:12]:
                        txt.insert("end", "       " + os.path.basename(x) + "\n")
                if info["removed"]:
                    removed_all.extend(info["removed"])
                    txt.insert("end", f"   – {len(info['removed'])} you removed from this book (the files are still "
                                      f"there):\n", "warn")
                    for x in info["removed"][:12]:
                        txt.insert("end", "       " + os.path.basename(x) + "\n")
                if info["skipped"]:
                    kinds = sorted({os.path.splitext(x)[1].lower() or "(no ending)" for x in info["skipped"]})
                    txt.insert("end", f"   – {len(info['skipped'])} of a kind BindLens can't show ({', '.join(kinds[:8])})"
                                      f":\n", "warn")
                    for x in info["skipped"][:8]:
                        txt.insert("end", "       " + os.path.basename(x) + "\n")
                for x in info["gone"]:
                    txt.insert("end", "   ! This folder or file is not there any more (moved, renamed or on a drive "
                                      "that is not connected):\n       " + x + "\n", "warn")
            if not box["rows"]:
                txt.insert("end", "No books yet.", "note")
            txt.configure(state="disabled")
            if removed_all:
                pb.pack(side="left")
            if new_total:
                self._verify_scan(fresh=True, toast=True)
        threading.Thread(target=work, daemon=True).start()
        self.root.after(120, show)

    def _verify_later(self):
        if getattr(self, "_verify_job", None):
            return

        def run():
            self._verify_job = None
            if getattr(self, "_scanning", False) or getattr(self, "_verify_busy", False):
                if not getattr(self, "_verify_busy", False):
                    self._verify_later()
                return
            pend = self.__dict__.pop("_verify_pending", None)
            if pend:
                self._verify_scan(pend[0], pend[1] or None, pend[2])
        self._verify_job = self.root.after(400, run)

    def _reopen_keep_history(self):
        """Open the book again with its new list of files - same place, and Ctrl+Z still works for the files
        that are still there."""
        stacks = [[(fi, p_, snap) for fi, p_, snap in st] for st in (self.undo_stack, self.redo_stack)]
        g = self.current_page
        cur_path = None
        try:
            cur_path = self.book.files[self.book.pages[g][0]]["path"]
            cur_pi = self.book.pages[g][1]
        except Exception:
            cur_pi = 0

        def after():
            if not self.book:
                return
            where = {f["path"]: i for i, f in enumerate(self.book.files)}
            self.undo_stack, self.redo_stack = ([(where[p_], p_, snap) for _fi, p_, snap in st if p_ in where]
                                                for st in stacks)
            fi = where.get(cur_path)
            if fi is not None:
                f = self.book.files[fi]
                if f["count"]:
                    self.goto_page(f["first"] + min(cur_pi, f["count"] - 1))
        self.open_folder(self.folder, self.prefix, then=after)

    def _tree_hover(self, e):
        """4.0: the book under the mouse is lit softly."""
        t = self.folder_tree
        row = t.identify_row(e.y) if e is not None else ""
        old = getattr(self, "_tree_hov", "")
        if row == old:
            return
        for r_, on in ((old, False), (row, True)):
            if r_ and t.exists(r_):
                tags = [x for x in t.item(r_, "tags") if x != "hover"]
                t.item(r_, tags=tags + (["hover"] if on else []))
        self._tree_hov = row

    def _fill_folders(self):
        t = self.folder_tree
        t.delete(*t.get_children())
        self._tree_hov = ""
        T, A = self.T, self.accent
        try:
            t.tag_configure("hover", background=mix(T["panel"], A, 0.07))
            t.tag_configure("cur", foreground=mix(T["text"], A, 0.55), font=self.F(10, "bold"))
        except Exception:
            pass
        q = ""
        try:
            q = self.book_find_var.get().strip()
            if q == "Find a book…":
                q = ""
            many = len(self.lib.folders) >= 6           # the find box only when there are several books
            if many and not self.book_find_frame.winfo_ismapped():
                self.book_find_frame.pack(fill="x", pady=(10, 0), before=self.folder_tree.master)
            elif not many and self.book_find_frame.winfo_ismapped() and not q:
                self.book_find_frame.pack_forget()
            self.book_find.configure(bg=mix(T["panel"], T["canvas"], 0.5), fg=T["text"] if q else T["muted"],
                                     insertbackground=T["text"], highlightbackground=T["border"],
                                     highlightcolor=A)
        except Exception:
            pass
        qf = fold(q.lower()) if q else ""
        for f, files in self.lib.folders.items():
            if qf and qf not in fold(self.lib.label(f).lower()) and not any(
                    qf in fold(sp.lower()) for sp in self.lib.subdirs.get(f, [])):
                continue
            n = "!" if self.lib.missing.get(f) and not files else str(len(files))
            iid = "f::" + f
            t.insert("", "end", iid=iid, text=f"  {self.lib.label(f)}" + ("  🔒" if self._book_locked(f) else ""),
                     image=self._book_icon_small(f),
                     values=(n, "↻"), open=(f == self.folder) or bool(qf), tags=("cur",) if f == self.folder else ())
            counts = {}                                    # files per sub-book, in one pass
            if self.lib.subdirs.get(f):
                for r in files:
                    i = r.find("/")
                    while i >= 0:
                        k = r[:i + 1]
                        counts[k] = counts.get(k, 0) + 1
                        i = r.find("/", i + 1)
            for sp in self.lib.subdirs.get(f, []):
                parent_sp = sp[:sp[:-1].rfind("/") + 1]
                parent = f"s::{f}|{parent_sp}" if parent_sp else iid
                if not t.exists(parent):
                    parent = iid
                cnt = counts.get(sp, 0)
                ln = self.lib.link_for(f, sp)
                label = sp[:-1].split("/")[-1]
                kw = {}
                if ln and ln.get("at") == sp:                   # linked from another place on the computer
                    miss = not os.path.isdir(ln.get("path", ""))
                    kw["image"] = self._link_icon(miss)
                    if miss:
                        cnt = "!"
                t.insert(parent, "end", iid=f"s::{f}|{sp}", text=" " + label, values=(cnt,),
                         open=(f == self.folder and self.prefix.startswith(sp)), **kw)
        cur = (f"s::{self.folder}|{self.prefix}" if self.prefix else f"f::{self.folder}") \
            if self.folder is not None else None
        if cur and t.exists(cur):
            t.selection_set(cur)
            t.see(cur)
        self.lib_title.configure(text=self.lib.title)
        try:
            nb = len(self.lib.folders)
            nf = sum(len(v) for v in self.lib.folders.values())
            self.lib_count.configure(text=f"{nb} book{'s' if nb != 1 else ''} · {nf} file{'s' if nf != 1 else ''}",
                                     fg=self.T["muted"])
        except Exception:
            pass
        self._draw_rail()

    @staticmethod
    def _tree_target(iid):
        """'f::Book' -> (Book, '') · 's::Book|Year 1/' -> (Book, 'Year 1/')"""
        if not iid:
            return None, ""
        if iid.startswith("s::"):
            f, sp = iid[3:].split("|", 1)
            return f, sp
        return iid[3:], ""

    def _on_folder_select(self, _e=None):
        sel = self.folder_tree.selection()
        if not sel:
            return
        f, sp = self._tree_target(sel[0])
        if getattr(self, "_prescan_token", None) is not None and (f, sp) == (self.folder, self.prefix):
            return                                    # already being opened
        if (f, sp) != (self.folder, self.prefix) or self.book is None:
            self.open_folder(f, sp)

    def _on_tree_icon(self, e):
        """The book under the mouse when the click is on its little icon (not on its name)."""
        t = self.folder_tree
        row = t.identify_row(e.y)
        if not row or not row.startswith("f::"):
            return None
        try:
            on_icon = "image" in str(t.identify_element(e.x, e.y))
        except Exception:
            on_icon = e.x < 44
        return self._tree_target(row)[0] if on_icon else None

    def _on_folder_click(self, e):
        t = self.folder_tree
        row = t.identify_row(e.y)
        self._tree_dragging = {"row": row, "y": e.y, "on": False} if row.startswith("f::") else None
        if row.startswith("f::") and t.identify_column(e.x) == "#2":       # the ↻: read this book again
            self.refresh_book(self._tree_target(row)[0])
            return "break"
        f = self._on_tree_icon(e)
        if f is not None and self._icon_clicks(f):
            return "break"

    def _tree_drag(self, e):
        d = getattr(self, "_tree_dragging", None)
        if not d:
            return
        t = self.folder_tree
        if not d["on"] and abs(e.y - d["y"]) < 10:
            return
        d["on"] = True
        t.configure(cursor="fleur")
        over = t.identify_row(e.y)
        if over and over.startswith("s::"):
            over = "f::" + self._tree_target(over)[0]
        if over and over != d["row"] and over.startswith("f::"):
            t.move(d["row"], "", t.index(over))              # the book moves while you drag it

    def _tree_drop(self, e):
        d = getattr(self, "_tree_dragging", None)
        self._tree_dragging = None
        if not d or not d["on"]:
            return
        t = self.folder_tree
        t.configure(cursor="")
        order = [self._tree_target(i)[0] for i in t.get_children("")]
        f = self._tree_target(d["row"])[0]
        if f in order and order != list(self.lib.folders):
            self.lib.move_collection(f, order.index(f))
            self.set_status(f"{self.lib.label(f)} moved.")
        self._fill_folders()

    def _on_folder_double(self, e):
        if self.folder_tree.identify_column(e.x) == "#2":
            return "break"                               # (the ↻ column: one click is enough)
        if self._on_tree_icon(e) is not None:
            f = self._on_tree_icon(e)
            if self._icon_clicks(f):
                return "break"
            return                                   # clicks on the icon: 3 open its icon and colour
        # 3.0: a double-click opens (it used to rename - easy to do by mistake); rename: right-click > Rename…
        f = self._sel_folder()
        if f is not None and (f != self.folder or self.book is None):
            self.open_folder(f)
        self.set_status("To rename a book: right-click it > Rename…")

    def _sel_folder(self):
        sel = self.folder_tree.selection()
        return self._tree_target(sel[0])[0] if sel else self.folder

    def _on_folder_right(self, e):
        row = self.folder_tree.identify_row(e.y)
        f, sp = self._tree_target(row)
        self._folder_menu(f, e, sp)

    def _folder_menu(self, f, e, sp=""):
        m = self._menu()
        explorer = "Show in Explorer" if os.name == "nt" else "Show in folder"
        if f is not None and sp:
            name = sp[:-1].split("/")[-1]
            ln = self.lib.link_for(f, sp)
            is_link = bool(ln and ln.get("at") == sp)
            m.add_command(label="Open this sub-book", command=lambda: self.open_folder(f, sp))
            m.add_command(label="Add files here…", command=lambda: self.add_files(folder=f, prefix=sp))
            m.add_separator()
            m.add_command(label="New sub-book inside…", command=lambda: self.new_subbook(f, sp))
            m.add_command(label="Add a folder from your computer inside…",
                          command=lambda: self.link_subbook(f, sp))
            m.add_separator()
            m.add_command(label=f'Rename "{name}"…', command=lambda: self.rename_subbook(f, sp))
            if is_link:
                m.add_command(label="Remove from this book (the folder stays on your computer)",
                              command=lambda: self.unlink_subbook(f, sp))
            d = self.lib.dir_for(f, sp)
            if d and os.path.isdir(d):
                m.add_command(label=explorer, command=lambda: open_in_os(d))
        elif f is not None and self._is_docbook(f):
            # a book made of loose documents (1.9.3)
            srcs = [x for x in (self.lib.col(f) or {}).get("sources", []) if os.path.isfile(x)]
            m.add_command(label="Rename…", command=lambda: self.rename_folder(f))
            m.add_command(label="Icon and colour…", command=lambda: self.book_style_dialog(f))
            m.add_separator()
            m.add_command(label="Add more documents to this book…", command=lambda: self.add_docs_to(f))
            if len(srcs) == 1:
                m.add_command(label="Open it in its own program", command=lambda: open_in_os(srcs[0]))
            if self.lib.folder_path(f):
                m.add_command(label=explorer, command=lambda: open_in_os(self.lib.folder_path(f)))
            m.add_separator()
            m.add_command(label="Remove from BindLens… (the documents stay on your computer)",
                          command=lambda: self.delete_folder(f))
        elif f is not None:
            m.add_command(label="Rename…", command=lambda: self.rename_folder(f))
            m.add_command(label="Icon and colour…", command=lambda: self.book_style_dialog(f))
            m.add_separator()
            m.add_command(label="Add files…", command=lambda: self.add_files(folder=f, prefix=""))
            m.add_command(label="New sub-book…", command=lambda: self.new_subbook(f, ""))
            m.add_command(label="Add a folder from your computer as a sub-book…",
                          command=lambda: self.link_subbook(f, ""))
            m.add_command(label="Move or copy a folder into this book…", command=lambda: self.link_folder_into(f))
            if self.lib.folder_path(f):
                m.add_command(label=explorer, command=lambda: open_in_os(self.lib.folder_path(f)))
            m.add_command(label="Check this book's folder (a file is missing?)…",
                          command=lambda: self.check_folders(f))
            m.add_separator()
            m.add_command(label="Remove from BindLens…", command=lambda: self.delete_folder(f))
        else:
            m.add_command(label="Add a folder…", command=self.import_folder)
            m.add_command(label="Add documents as books…", command=self.import_documents)
            m.add_command(label="New empty book…", command=self.new_folder)
        if f is not None and not sp:                 # 4.1: lock one book with the PIN
            m.add_separator()
            if f in self.lib.settings.get("locked_books", []):
                m.add_command(label="Take the lock off this book…", command=lambda: self.lock_book(f, False))
            else:
                m.add_command(label="Lock this book with the PIN…", command=lambda: self.lock_book(f, True))
        self._popup(m, e)

    def _menu(self, parent=None):
        T = self.T
        m = KeepMenu(parent or self.root, tearoff=0, bg=T["panel"], fg=T["text"],
                    activebackground=mix(T["panel"], self.accent, 0.25), activeforeground=T["text"],
                    bd=0, relief="flat", font=UI_FONT)
        return m

    def _popup(self, m, e=None, x=None, y=None):
        self._menu_open = True
        m.bind("<Unmap>", lambda _e: setattr(self, "_menu_open", False), add="+")
        try:
            m.tk_popup(e.x_root if e else x, e.y_root if e else y)
        finally:
            m.grab_release()
        if os.name == "nt":
            self._menu_open = False

    def reload(self):
        """F5: every book's folders are read again for real (nothing from memory) - then a note says what changed."""
        self._remember_position()
        cur = self.folder
        before = {f: set(v) for f, v in self.lib.folders.items()}
        self._close_book()

        def after():
            self._fill_folders()
            if cur in self.lib.folders:
                self.open_folder(cur)
            elif self.lib.folders:
                self.open_folder(next(iter(self.lib.folders)))
            else:
                self.folder = None
                self.redraw()
            self._schedule_index()
            changes = {}
            for f, v in self.lib.folders.items():
                a_ = before.get(f, set())
                b_ = set(v)
                if a_ != b_:
                    changes[self.lib.label(f)] = (len(b_ - a_), len(a_ - b_))
            nfiles = sum(len(v) for v in self.lib.folders.values())
            lost = [f for f in self.lib.missing if self.lib.missing.get(f)]
            if changes:
                txt = self._changes_text(changes)
            else:
                txt = f"✓  All your books are up to date - {len(self.lib.folders)} books, {nfiles} files"
            if lost:
                txt += f"  ·  {len(lost)} folder{'s' if len(lost) != 1 else ''} not found - looking for them"
                self.root.after(600, lambda: self._follow_moved(force=True))
            self._toast(txt, ms=5000)
            self.set_status(txt.lstrip("✓↻ ") + ".")
        self._scan_async(after, fresh=True, label="Reading all your folders again")

    def new_folder(self):
        """A new book = a new folder on your computer (Desktop by default) that BindLens reads."""
        name = clean_name(self._ask_string("New book", "Name of the new book:", "My documents"))
        if not name:
            return
        home = os.path.join(os.path.expanduser("~"), "Desktop")
        where = filedialog.askdirectory(title=f'Where should the folder "{name}" be created?',
                                        initialdir=home if os.path.isdir(home) else os.path.expanduser("~"))
        if not where:
            return
        path = os.path.join(where, name)
        try:
            os.makedirs(path, exist_ok=True)
            note_change("New folder", path)
        except Exception as ex:
            messagebox.showerror(APP_NAME, f"Could not create the folder:\n{ex}")
            return
        name = self.lib.add_collection(name, [path])
        self.lib.scan()
        self.open_folder(name)
        self.set_status(f'"{name}" created in {where}. Add files with "Add files" or drag them here.')

    def new_subbook(self, f, sp=""):
        """A sub-book is a real sub-folder inside the book's folder."""
        if self.lib.col(f) is None:
            return
        name = clean_name(self._ask_string("New sub-book", "Name of the sub-book (a folder is created):", "New section"))
        if not name:
            return
        base = self.lib.dir_for(f, sp)
        linked = False
        if not base:
            # a book made of single files (no folder of its own): make the folder next to its files - or ask
            c = self.lib.col(f)
            here = [os.path.dirname(x) for x in c.get("sources", []) if os.path.isfile(x)]
            base = os.path.commonpath(here) if here else None
            if not base or not os.path.isdir(base):
                home = os.path.join(os.path.expanduser("~"), "Documents")
                base = filedialog.askdirectory(title=f'Where should the folder "{name}" be created?',
                                               initialdir=home if os.path.isdir(home) else os.path.expanduser("~"))
                if not base:
                    return
            linked = True
        path = os.path.join(base, name)
        try:
            os.makedirs(path, exist_ok=True)
            note_change("New folder", path)
        except Exception as ex:
            messagebox.showerror(APP_NAME, f"Could not create the folder:\n{ex}")
            return
        new_sp = sp + name + "/"
        if linked:
            new_sp = self.lib.add_link(f, path, sp + name)
        self.lib.scan()
        self._fill_folders()
        self.open_folder(f, new_sp)
        self.set_status(f'Sub-book "{name}" created ({path}). Drag files here or use "Add files".')

    def link_subbook(self, f, sp="", src=None):
        """Any folder on the computer (Desktop, Documents, USB, OneDrive…) shown as a sub-book - it stays where it
        is: nothing is moved or copied."""
        if self.lib.col(f) is None:
            return
        if not src:
            home = os.path.expanduser("~")
            src = filedialog.askdirectory(title=f'Choose a folder to show inside "{f}" - it stays where it is',
                                          initialdir=home)
        if not src:
            return
        src = os.path.abspath(src)
        n = self.lib.norm(src)
        c = self.lib.col(f)
        for x in c.get("sources", []) + [l["path"] for l in c.get("links", [])]:
            nx = self.lib.norm(x)
            if n == nx or n.startswith(nx + os.sep.lower()) or n.startswith(nx + "/"):
                messagebox.showinfo(APP_NAME, "That folder is already part of this book.")
                return
        name = clean_name(os.path.basename(os.path.normpath(src))) or "Folder"
        at = self.lib.add_link(f, src, sp + name)

        def after():
            self._fill_folders()
            self.open_folder(f, at)
            self._schedule_index()
            self.set_status(f'"{name}" is now a sub-book of "{f}". It stays where it is: {src}')
        self._scan_async(after, label=f"Reading “{name}”")

    def unlink_subbook(self, f, sp):
        c = self.lib.col(f)
        if not c:
            return
        name = sp[:-1].split("/")[-1]
        if not messagebox.askyesno(APP_NAME, f'Remove "{name}" from "{f}"?\n\nThe folder and its files stay on your '
                                             f'computer - nothing is deleted.'):
            return
        c["links"] = [l for l in c.get("links", []) if l.get("at") != sp]
        self.lib.save_meta()
        if self.folder == f and self.prefix.startswith(sp):
            self.prefix = ""
        self.reload()

    def rename_subbook(self, f, sp):
        ln = self.lib.link_for(f, sp)
        if ln and ln.get("at") == sp:                 # a linked folder: only its name in BindLens changes
            name = sp[:-1].split("/")[-1]
            new = clean_name(self._ask_string("Rename", "New name (only in BindLens - the folder keeps its name):",
                                              name))
            if not new or new == name:
                return
            new_sp = sp[:-len(name) - 1] + new + "/"
            c = self.lib.col(f)
            for l in c.get("links", []):
                if l.get("at", "").startswith(sp):
                    l["at"] = new_sp + l["at"][len(sp):]
            self.lib.save_meta()
            if self.folder == f and self.prefix.startswith(sp):
                self.prefix = new_sp + self.prefix[len(sp):]
            self.reload()
            return
        old = self.lib.dir_for(f, sp)
        name = sp[:-1].split("/")[-1]
        new = clean_name(self._ask_string("Rename", "New name (the folder on your computer is renamed too):", name))
        if not new or new == name or not old:
            return
        dst = os.path.join(os.path.dirname(os.path.normpath(old)), new)
        if os.path.exists(dst):
            messagebox.showerror(APP_NAME, "A folder with that name already exists.")
            return
        new_sp = sp[:-len(name) - 1] + new + "/"

        def go():
            self._retry(lambda: os.rename(old, dst))
            note_change("Renamed folder", dst, old)
            self.lib.relink(old, dst)                  # 3.0: statuses, reminders, pages, search text go with it
            self._move_caches(old, dst)
            if self.folder == f and self.prefix.startswith(sp):
                self.prefix = new_sp + self.prefix[len(sp):]
        try:
            self._with_book_closed(go)
        except Exception as ex:
            messagebox.showerror(APP_NAME, f"Could not rename (is a file open in another program?)\n\n{ex}")

    @staticmethod
    def _retry(fn, tries=5):
        for k in range(tries):
            try:
                return fn()
            except PermissionError:
                if k == tries - 1:
                    raise
                time.sleep(0.4)

    def rename_folder(self, f=None):
        f = f if f is not None else self._sel_folder()
        if f is None:
            return
        new = clean_name(self._ask_string("Rename", "New name of the book:", f))
        if not new or new == f:
            return
        if self.lib.col(new):
            messagebox.showerror(APP_NAME, f'There is already a book called "{new}".')
            return
        col = self.lib.col(f)
        dirs = [x for x in col.get("sources", []) if os.path.isdir(x)]
        rename_disk = False
        if len(dirs) == 1:
            rename_disk = messagebox.askyesno(APP_NAME, f'Also rename the folder on your computer?\n\n'
                                                        f'{dirs[0]}\n→  {new}')
        if rename_disk:
            dst = os.path.join(os.path.dirname(os.path.normpath(dirs[0])), new)
            if os.path.exists(dst):
                messagebox.showerror(APP_NAME, "A folder with that name already exists there.")
                return
            was_open = self.folder == f
            if was_open:
                self._remember_position()
                self._close_book()
            try:
                self._retry(lambda: os.rename(dirs[0], dst))
                note_change("Renamed folder", dst, dirs[0])
                if not self.lib.relink(dirs[0], dst):      # 3.0: everything goes with it
                    col["sources"] = [dst if x == dirs[0] else x for x in col["sources"]]
                self._move_caches(dirs[0], dst)
            except Exception as ex:
                messagebox.showerror(APP_NAME, f"Could not rename the folder (is a file open in another "
                                               f"program?)\n\n{ex}")
        col["color"] = self.lib.color(f)
        col["name"] = new
        for k in ("colors", "positions"):
            for key in list(self.lib.meta[k]):
                if key == f or key.startswith(f + "//"):
                    self.lib.meta[k][new + key[len(f):]] = self.lib.meta[k].pop(key)
        if self.lib.meta.get("last_folder") == f:
            self.lib.meta["last_folder"] = new
        for r_ in self.lib.meta.get("reminders", []):
            if r_.get("book") == f:
                r_["book"] = new
        self.lib.save_meta()
        was = self.folder == f
        self.lib.scan()
        if was:
            self.folder = new
            if self.book is None:
                self.open_folder(new, self.prefix)
        self._fill_folders()
        if was:
            self.root.title(f"{new} - {APP_NAME}")

    def set_folder_color(self, f, c):
        col = self.lib.col(f)
        if col:
            col["color"] = c
            self.lib.save_meta()
        self._fill_folders()

    def delete_folder(self, f):
        if not messagebox.askyesno(APP_NAME, f'Remove "{f}" from BindLens?\n\nYour files are NOT deleted - they '
                                             f'stay in their folder. Only the link in BindLens is removed.'):
            return
        if self.folder == f:
            self._close_book()
            self.folder = None
        col = self.lib.col(f)
        if col:
            self.lib.collections.remove(col)
        self.lib.meta["positions"].pop(f, None)
        self.lib.save_meta()
        self.reload()

    def _ask_book_name(self, title, suggestion):
        """Suggest the folder's own name; the user can keep it or type another."""
        return self._ask_string(title, "Name in BindLens (keep it or type another):", suggestion)

    def import_folder(self, src=None):
        """Link one of your folders as a book. Nothing is copied or moved."""
        src = src or filedialog.askdirectory(title="Choose a folder - it stays where it is")
        if not src:
            return
        src = os.path.abspath(src)
        for c in self.lib.collections:
            if any(self.lib.norm(x) == self.lib.norm(src) for x in c.get("sources", [])):
                messagebox.showinfo(APP_NAME, f'That folder is already in BindLens as "{c["name"]}".')
                self.open_folder(c["name"])
                return
        subs = [d for d in sorted(os.listdir(src), key=natural_key)
                if not d.startswith(".") and os.path.isdir(os.path.join(src, d))]
        loose = [f for f in os.listdir(src) if is_supported(f)]
        split = False
        if subs:
            c = self._choice("Add folder", f'"{os.path.basename(src)}" has {len(subs)} subfolder(s).\n\nHow do you '
                                           f'want to add it?',
                             ["One book with everything", f"One book per subfolder ({len(subs) + (1 if loose else 0)})",
                              "Cancel"])
            if c not in (0, 1):
                return
            split = c == 1
        added = []
        if split:
            if loose:
                name = self._ask_book_name("Add folder", os.path.basename(src))
                if name:
                    # 1.9.5: the folder itself, only its own files (new ones saved there appear too)
                    col = self.lib.add_collection(name, [src])
                    self.lib.col(col)["flat"] = True
                    self.lib.save_meta()
                    added.append(col)
            for d in subs:
                name = self._ask_book_name("Add folder", d)
                if name:
                    added.append(self.lib.add_collection(name, [os.path.join(src, d)]))
        else:
            name = self._ask_book_name("Add folder", os.path.basename(src))
            if not name:
                return
            added.append(self.lib.add_collection(name, [src]))
        if not added:
            return

        def after():
            self.open_folder(added[0])
            self._schedule_index()
            self.set_status(f"Added: {', '.join(added)}.  Your files stay in their folder; marks are saved in them.")
        self._remember_position()
        self._close_book()
        self._fill_folders()
        self._scan_async(after, label=f"Reading “{added[0]}”")

    def import_documents(self, paths=None, one_book=False):
        """1.9.3: loose documents as books - any kind (PDF, Word, Excel, PowerPoint, pictures…). Each one becomes a
        book of its own (icon, colour, its place in the list, like every book), or all of them one book.
        Nothing is copied or moved."""
        if not paths:
            pattern = " ".join("*" + e for e in sorted(SUPPORTED))
            paths = filedialog.askopenfilenames(title="Choose documents - they stay where they are",
                                                filetypes=[("Documents", pattern), ("All files", "*.*")])
        paths = [os.path.abspath(p_) for p_ in (paths or []) if os.path.isfile(p_)]
        if not paths:
            return
        bad = [p_ for p_ in paths if not is_supported(p_)]
        paths = [p_ for p_ in paths if is_supported(p_)]
        if not paths:
            messagebox.showinfo(APP_NAME, "BindLens can't add these kinds of files:\n" +
                                "\n".join(os.path.basename(b) for b in bad[:8]))
            return
        known = {self.lib.norm(x): c["name"] for c in self.lib.collections for x in c.get("sources", [])}
        added, already = [], []
        if one_book:
            sug = os.path.splitext(os.path.basename(paths[0]))[0] if len(paths) == 1 else "My documents"
            name = self._ask_book_name("Add documents", sug)
            if not name:
                return
            added.append(self.lib.add_collection(name, sorted(paths, key=lambda x: natural_key(os.path.basename(x)))))
        else:
            for p_ in paths:
                if self.lib.norm(p_) in known:
                    already.append(known[self.lib.norm(p_)])
                    continue
                added.append(self.lib.add_collection(os.path.splitext(os.path.basename(p_))[0], [p_]))
        if not added:
            if already:
                messagebox.showinfo(APP_NAME, f'That document is already in BindLens as "{already[0]}".')
                self.open_folder(already[0])
            return

        def after():
            self.open_folder(added[0])
            self._schedule_index()
            n = len(added)
            self.set_status((f"Added {n} documents as books." if n > 1 else f'Added "{added[0]}" as a book.') +
                            "  They stay where they are. Drag the icons to put them in order." +
                            (f"  ({len(bad)} file(s) of a kind BindLens can't add were left out.)" if bad else ""))
        self._remember_position()
        self._close_book()
        self._fill_folders()
        self._scan_async(after, label=f"Reading “{added[0]}”")

    def _is_docbook(self, f):
        """A book made of loose documents (no folder behind it)."""
        c = self.lib.col(f) or {}
        srcs = c.get("sources", [])
        return bool(srcs) and not any(os.path.isdir(x) for x in srcs) and not c.get("links")

    def add_docs_to(self, f):
        """More documents in a book made of loose documents (they stay where they are)."""
        pattern = " ".join("*" + e for e in sorted(SUPPORTED))
        paths = filedialog.askopenfilenames(title=f'Documents to add to "{f}" - they stay where they are',
                                            filetypes=[("Documents", pattern), ("All files", "*.*")])
        c = self.lib.col(f)
        if not paths or c is None:
            return
        have = {self.lib.norm(x) for x in c["sources"]}
        new = [os.path.abspath(p_) for p_ in paths if is_supported(p_) and self.lib.norm(p_) not in have]
        if not new:
            return
        c["sources"] += new
        c["exclude"] = [x for x in c.get("exclude", []) if self.lib.norm(x) not in {self.lib.norm(n) for n in new}]
        self.lib.save_meta()
        self._remember_position()
        self._close_book()
        self._scan_async(lambda: (self._fill_folders(), self.open_folder(f), self._schedule_index(),
                                  self.set_status(f"{len(new)} document(s) added to {f}.")))

    def _add_menu(self, widget=None, e=None):
        """The + button: a folder (a book with every file in it) or loose documents."""
        m = self._menu()
        m.add_command(label="Add a folder…   (a book with all its files)", command=self.import_folder)
        m.add_command(label="Add documents…   (each one becomes a book)", command=self.import_documents)
        m.add_command(label="Add documents as one book…", command=lambda: self.import_documents(one_book=True))
        m.add_separator()
        m.add_command(label="New empty book…", command=self.new_folder)
        if e is not None:
            self._popup(m, e)
        else:
            self._popup(m, x=widget.winfo_rootx() + widget.winfo_width(), y=widget.winfo_rooty())

    def link_folder_into(self, f):
        src = filedialog.askdirectory(title=f'Choose a folder to add to "{f}"')
        if src:
            self.add_files([src], folder=f)

    def _target_folder(self, ask=True):
        if self.folder is not None:
            return self.folder
        if self.lib.folders:
            return next(iter(self.lib.folders))
        if ask:
            name = self._ask_string("New book", "Name of the book for these files:", "My documents")
            return self.lib.add_collection(name, []) if name else None
        return None

    def add_files(self, paths=None, folder=None, prefix=None, mode=None):
        """Put files into the book's real folder on your computer (moved or copied - you choose)."""
        if paths is None:
            pattern = " ".join("*" + e for e in sorted(SUPPORTED))
            paths = filedialog.askopenfilenames(title="Add files to this book",
                                                filetypes=[("Documents", pattern), ("All files", "*.*")])
            if not paths:
                return
        folder = self._target_folder() if folder is None else folder
        if folder is None:
            return
        if prefix is None:
            prefix = self.prefix if folder == self.folder else ""
        col = self.lib.col(folder)
        target = self.lib.dir_for(folder, prefix)
        if target is None:
            home = os.path.join(os.path.expanduser("~"), "Desktop")
            d = filedialog.askdirectory(title=f'Choose the folder on your computer for "{folder}"',
                                        initialdir=home if os.path.isdir(home) else os.path.expanduser("~"))
            if not d:
                return
            col["sources"].insert(0, os.path.abspath(d))
            self.lib.save_meta()
            target = d
        try:
            os.makedirs(target, exist_ok=True)
        except Exception as ex:
            messagebox.showerror(APP_NAME, f"Could not use the folder:\n{target}\n\n{ex}")
            return
        nt = self.lib.norm(target)
        items, skipped, already = [], [], 0
        for p in paths:
            p = os.path.abspath(p)
            if os.path.isdir(p) or is_supported(p):
                np_ = self.lib.norm(p)
                if np_.startswith(nt + os.sep.lower()) or np_.startswith(nt + "/") or np_ == nt:
                    already += 1
                    col["exclude"] = [x for x in col.get("exclude", []) if self.lib.norm(x) != np_]
                else:
                    items.append(p)
            else:
                skipped.append(os.path.basename(p))
        mode = mode or self.lib.settings.get("add_mode", "ask")
        if items and mode not in ("move", "copy"):
            short = target if len(target) < 60 else "…" + target[-58:]
            c, always = self._choice("Add files", f"Put {len(items)} item(s) into the book's folder?\n\n{short}",
                                     ["Move them there", "Copy them there", "Cancel"],
                                     remember="Always do this (change it in Settings)")
            if c not in (0, 1):
                return
            mode = "move" if c == 0 else "copy"
            if always:
                self.lib.settings["add_mode"] = mode
        done, failed, first = 0, [], None
        if items:
            self._remember_position()
            if folder == self.folder:
                self.writer.wait(10)
            for p in items:
                dst = unique_path(target, os.path.basename(os.path.normpath(p)))
                try:
                    if mode == "move":
                        self._retry(lambda: shutil.move(p, dst))
                    elif os.path.isdir(p):
                        shutil.copytree(p, dst)
                    else:
                        shutil.copy2(p, dst)
                    note_change("Moved in" if mode == "move" else "Copied in (you chose Copy)", dst, p)
                    done += 1
                    first = first or dst
                except Exception as ex:
                    failed.append(f"{os.path.basename(p)}: {ex}")
        self.lib.save_meta()
        self.lib.scan()

        def there():
            if first and self.book:
                nf = self.lib.norm(first)
                for f in self.book.files:
                    if self.lib.norm(f["path"]) == nf or self.lib.norm(f["path"]).startswith(nf + os.sep.lower()):
                        if f["count"]:
                            self.goto_page(f["first"])
                        break
        self.open_folder(folder, prefix, then=there)
        self._schedule_index()
        verb = "Moved" if mode == "move" else "Copied"
        msg = f"{verb} {done} item(s) into {target}." if done else ""
        if already:
            msg += f"  {already} already in this book's folder."
        if skipped:
            msg += "  Not supported: " + ", ".join(skipped[:4])
        self.set_status(msg.strip())
        if failed:
            messagebox.showwarning(APP_NAME, "Some items could not be added:\n\n" + "\n".join(failed[:8]))

    def _on_drop(self, event):
        try:
            paths = list(self.root.tk.splitlist(event.data))
        except Exception:
            return
        dirs = [p for p in paths if os.path.isdir(p)]
        files = [p for p in paths if not os.path.isdir(p)]
        zips = [p for p in files if p.lower().endswith(".zip") and "bindlens" in os.path.basename(p).lower()]
        if zips and len(files) == 1 and not dirs:          # 4.0: the new BindLens zip dropped on the window
            self.update_from_zip(zips[0])
            return
        # dropped on a book (or sub-book) in the list: folders can become its sub-books
        target = None
        try:
            w = self.root.winfo_containing(int(event.x_root), int(event.y_root))
            if w in (self.rail_c, self.rail, self.rail_bot) or not self.lib.folders:
                # dropped on the icons: on a book = into it; anywhere else = new books (1.9.3)
                class _E:
                    y = int(event.y_root) - self.rail_c.winfo_rooty()
                f_on = self._rail_at(_E)[0] if w is self.rail_c else None
                if f_on is not None:
                    if files or dirs:
                        self.add_files(files + dirs, folder=f_on)
                    return
                for d in dirs:
                    self.import_folder(d)
                if files:
                    self.import_documents(files)
                return
            if w is self.folder_tree:
                row = w.identify_row(int(event.y_root) - w.winfo_rooty())
                if row:
                    target = self._tree_target(row)
        except Exception:
            target = None
        if target and target[0] is not None:
            f, sp = target
            for d in dirs:
                c = self._choice("Add folder", f'"{os.path.basename(os.path.normpath(d))}" - dropped on '
                                               f'"{(sp[:-1].split("/")[-1]) if sp else f}"',
                                 ["Show it as a sub-book (it stays where it is)", "Move or copy it into this book",
                                  "Make it a book of its own", "Cancel"])
                if c == 0:
                    self.link_subbook(f, sp, src=d)
                elif c == 1:
                    self.add_files([d], folder=f, prefix=sp)
                elif c == 2:
                    self.import_folder(d)
            if files:
                self.add_files(files, folder=f, prefix=sp)
            return
        for d in dirs:
            self.import_folder(d)
        if files:
            self.add_files(files)

    def _choice(self, title, message, options, remember=None):
        T = self.T
        d = self._dialog(title)
        tk.Label(d, text=message, bg=T["panel"], fg=T["text"], font=self.F(10), justify="left",
                 wraplength=420).pack(anchor="w", padx=22, pady=(18, 12))
        res = [None]
        var = tk.BooleanVar(value=False)

        def pick(i):
            res[0] = i
            d.destroy()
        for i, o in enumerate(options):
            PillButton(d, self, o, lambda i=i: pick(i), kind="accent" if i == 0 else "soft",
                       width=420).pack(padx=22, pady=3)
        if remember:
            ttk.Checkbutton(d, text=remember, variable=var).pack(anchor="w", padx=22, pady=(8, 0))
        tk.Frame(d, height=14, bg=T["panel"]).pack()
        d.bind("<Escape>", lambda e: d.destroy())
        self._center(d)
        d.grab_set()
        self.root.wait_window(d)
        return (res[0], var.get()) if remember else res[0]

    # ---- file list
    def _status(self, path):
        return self.lib.meta.setdefault("tags", {}).get(self.lib.norm(path), "")

    def set_status_tag(self, fi, tag):
        f = self.book.files[fi]
        tags = self.lib.meta.setdefault("tags", {})
        if tag:
            tags[self.lib.norm(f["path"])] = tag
        else:
            tags.pop(self.lib.norm(f["path"]), None)
        self.lib.save_meta()
        self._fill_files()

    def _fill_files(self):
        t = self.files_tree
        t.delete(*t.get_children())
        if not self.book:
            return
        for name, col in STATUSES:
            t.tag_configure("st_" + name, foreground=col)
        want = getattr(self, "_file_filter", "")
        for i, f in enumerate(self.book.files):
            tag = self._status(f["path"])
            if want and tag != want:
                continue
            sub = f["rel"][len(self.prefix):]
            parts = sub.split("/")
            parent = ""
            for k in range(len(parts) - 1):
                did = "d::" + self.prefix + "/".join(parts[:k + 1]) + "/"
                if not t.exists(did):
                    t.insert(parent, "end", iid=did, text="  " + parts[k], values=("",), open=True)
                parent = did
            label = ("  ! " if f["error"] else "  ") + parts[-1] + (f"   · {tag}" if tag else "")
            t.insert(parent, "end", iid=str(i), text=label, values=("" if f["error"] else f["count"],),
                     tags=("st_" + tag,) if tag else ())

    def _files_filter_menu(self, e=None):
        m = self._menu()
        v = tk.StringVar(value=getattr(self, "_file_filter", ""))
        self._ffv = v
        m.add_radiobutton(label="All files", value="", variable=v, command=lambda: self._set_file_filter(""))
        used = sorted({self._status(f["path"]) for f in (self.book.files if self.book else [])} - {""})
        for name in [n for n, _ in STATUSES] + [u for u in used if u not in dict(STATUSES)]:
            m.add_radiobutton(label=f"Only “{name}”", value=name, variable=v,
                              command=lambda n=name: self._set_file_filter(n))
        w = self.seg
        self._popup(m, x=w.winfo_rootx(), y=w.winfo_rooty() + w.winfo_height())

    def _set_file_filter(self, name):
        self._file_filter = name
        self.filter_lbl.configure(text=(f"Only “{name}”  ·  change" if name else "All files  ·  filter by status"),
                                  fg=self.accent if name else self.T["muted"])
        self.show_tab("Files")
        self._fill_files()
        self.set_status(f'Showing only files marked "{name}".' if name else "Showing all files.")

    def _on_file_click(self, _e=None):
        sel = self.files_tree.selection()
        if not sel or not self.book:
            return
        if sel[0].startswith("d::"):
            sp = sel[0][3:]
            for f in self.book.files:
                if f["rel"].startswith(sp) and f["count"]:
                    self.goto_page(f["first"])
                    break
            return
        f = self.book.files[int(sel[0])]
        if f["error"]:
            messagebox.showwarning(APP_NAME, f'Could not open "{f["rel"]}":\n\n{f["error"]}')
        elif f["count"]:
            self.goto_page(f["first"])

    def _on_file_right(self, e):
        row = self.files_tree.identify_row(e.y)
        if not row or not self.book:
            return
        self.files_tree.selection_set(row)
        if row.startswith("d::"):
            self._folder_menu(self.folder, e, row[3:])
            return
        fi = int(row)
        f = self.book.files[fi]
        m = self._menu()
        if not f["pdf"] and not f["error"]:
            m.add_command(label="Convert to PDF (to add marks)", command=lambda: self.convert_to_pdf(fi))
        stm = self._menu(m)
        cur = self._status(f["path"])
        for name, col in STATUSES:
            stm.add_command(label=("✓ " if cur == name else "    ") + name, foreground=col,
                            command=lambda n=name: self.set_status_tag(fi, n))
        stm.add_command(label="Your own…", command=lambda: (lambda t: t and self.set_status_tag(fi, t.strip()[:20]))(
            self._ask_string("Status", "Status of this file:", cur)))
        stm.add_separator()
        stm.add_command(label="No status", command=lambda: self.set_status_tag(fi, ""))
        m.add_cascade(label="Status", menu=stm)
        m.add_command(label="Rename file…   F2", command=lambda: self.rename_file(fi))
        if f["pdf"] and self._has_versions(f["path"]):             # (copies kept by 3.0, if any)
            m.add_command(label="Earlier versions…", command=lambda: self.versions_dialog(fi))
        m.add_command(label="Open with another program", command=lambda: open_in_os(f["path"]))
        m.add_command(label="Show in Explorer" if os.name == "nt" else "Show in folder",
                      command=lambda: open_in_os(os.path.dirname(f["path"])))
        m.add_separator()
        m.add_command(label="Print…", command=lambda: (self.goto_page(f["first"]), self.print_dialog(what="doc")))
        m.add_command(label="Send by email…", command=lambda: self.email_file(f["path"]))
        m.add_command(label="Read-only copy…", command=lambda: (self.goto_page(f["first"]), self.readonly_copy()))
        if f["pdf"]:
            m.add_command(label="Make scanned pages searchable (OCR)…", command=lambda: self.ocr_file(fi))
            m.add_command(label="Split into one PDF per page…", command=lambda: (self.goto_page(f["first"]),
                                                                                 self.split_file()))
        m.add_separator()
        m.add_command(label="Remove from this book", command=lambda: self.remove_file(fi))
        self._popup(m, e)

    def _with_book_closed(self, fn):
        """Run fn() with the book closed, then read the folders again and reopen it."""
        self._remember_position()
        cur = self.folder
        self._close_book()
        try:
            fn()
        finally:
            self.lib.scan()
            self._fill_folders()
            if cur in self.lib.folders:
                self.open_folder(cur, self.prefix)
            self._schedule_index()

    def _rename_selected_file(self):
        sel = self.files_tree.selection()
        if sel and self.book and not sel[0].startswith("d::"):
            self.rename_file(int(sel[0]))
        elif sel and sel[0].startswith("d::"):
            self.rename_subbook(self.folder, sel[0][3:])

    def rename_file(self, fi):
        f = self.book.files[fi]
        base, ext = os.path.splitext(os.path.basename(f["path"]))
        new = clean_name(self._ask_string("Rename file", "New name (the file itself is renamed):", base))
        if not new or new == base:
            return
        src = f["path"]
        dst = os.path.join(os.path.dirname(src), new + ext)
        if os.path.exists(dst):
            messagebox.showerror(APP_NAME, "A file with that name already exists.")
            return
        col = self.lib.col(self.folder)

        def go():
            self._retry(lambda: os.rename(src, dst))
            note_change("Renamed", dst, src)
            # 3.0: its status, reminders, pages and search text go with it (nothing is read again)
            if not self.lib.relink(src, dst):
                col["sources"] = [dst if self.lib.norm(x) == self.lib.norm(src) else x for x in col["sources"]]
                self.lib.save_meta()
            self._move_caches(src, dst)
        try:
            self._with_book_closed(go)
        except Exception as ex:
            messagebox.showerror(APP_NAME, f"Could not rename (is it open in another program?)\n\n{ex}")

    def remove_file(self, fi):
        """Hide a file from this book. The file itself is not touched."""
        f = self.book.files[fi]
        col = self.lib.col(self.folder)
        n = self.lib.norm(f["path"])

        def go():
            before = len(col["sources"])
            col["sources"] = [x for x in col["sources"] if self.lib.norm(x) != n]
            if len(col["sources"]) == before:
                col.setdefault("exclude", []).append(f["path"])
            self.lib.save_meta()
        self._with_book_closed(go)
        self.set_status(f'"{f["rel"]}" removed from this book (the file is still in its folder).')

    def convert_to_pdf(self, fi):
        f = self.book.files[fi]
        if f["pdf"] or f["error"]:
            return
        if is_outside(f["path"]):
            open_in_os(f["path"])
            return
        if not messagebox.askyesno(APP_NAME, f'Make a PDF of "{f["rel"]}"?\n\nMarks can only be saved inside PDF '
                                             f'files. The PDF is saved next to the original, which is left as it '
                                             f'is (and hidden from this book).'):
            return
        try:
            data = self.book.doc(fi).convert_to_pdf()
        except Exception as ex:
            messagebox.showerror(APP_NAME, f"Could not convert:\n{ex}")
            return
        src = f["path"]
        dst = unique_path(os.path.dirname(src), os.path.splitext(os.path.basename(src))[0] + ".pdf")
        col = self.lib.col(self.folder)

        def go():
            with open(dst, "wb") as out:
                out.write(data)
            note_change("Made a PDF of", dst, src)
            n = self.lib.norm(src)
            if any(self.lib.norm(x) == n for x in col["sources"]):
                col["sources"] = [dst if self.lib.norm(x) == n else x for x in col["sources"]]
            else:
                col.setdefault("exclude", []).append(src)
            self.lib.save_meta()
        self._with_book_closed(go)
        self.set_status(f"Saved {os.path.basename(dst)} next to the original. You can now add marks to it.")

    # ============================================================ open folder
    def _poskey(self, folder=None, prefix=None):
        folder = self.folder if folder is None else folder
        prefix = self.prefix if prefix is None else prefix
        return folder + ("//" + prefix if prefix else "")

    def _uncached(self, folder, prefix):
        """Files of a book whose page sizes BindLens doesn't know yet (new or changed files)."""
        out = []
        self._stats = {}
        for rel in self.lib.folders.get(folder, []):
            if prefix and not rel.startswith(prefix):
                continue
            path = self.lib.file_path(folder, rel)
            key = self.lib.norm(path)
            try:
                st = os.stat(path)
            except Exception:
                continue
            self._stats[path] = st                      # the book uses these (each file is looked at once)
            c = self.page_sizes.get(key)
            if not (c and c.get("m") == st.st_mtime and c.get("s") == st.st_size) or c.get("retry"):
                out.append((key, path, st))
        return out

    def _size_entry(self, key, path, st, res):
        """Store what a helper found out about a file (its page sizes - or why it can't be opened)."""
        if res.get("cancelled"):
            return
        if "p" in res:
            e = {"m": res["m"], "s": res["s"], "p": res["p"]}
            if res.get("err"):
                e["err"] = res["err"]
            if res.get("form"):
                e["f"] = 1
            if res.get("o"):
                e["o"] = 1
        else:                                # too slow / the reader stopped: show it, try again next time
            e = {"m": st.st_mtime, "s": st.st_size, "p": [], "err": res.get("err") or "Could not be read",
                 "retry": 1}
        self.page_sizes[key] = e
        if "marks" in res:
            self._mcache[key] = (res["m"], res["s"], res["marks"], bool(res.get("form")))

    def _prescan(self, folder, prefix, todo, then=None):
        """A new (or changed) book: the helpers read its files while the window shows how far they got - the
        window never waits ("Not responding" never appears) - then the book opens.
        2.0: the count moves file by file; a file that Windows / OneDrive is slow to give (still downloading,
        locked) never keeps the book closed - after a few seconds the card says so and offers "Open now", and
        after 40 s the book opens by itself (those files are read in the background and appear when ready)."""
        token = object()
        self._prescan_token = token
        total = len(todo)
        c = self.canvas
        T = self.T
        state = {"i": 0, "shown": 0.0, "last": time.time(), "done": set()}

        def stalled():
            return time.time() - state["last"]

        def show():
            state["shown"] = time.time()
            c.delete("prescan")
            W, H = max(300, c.winfo_width()), max(200, c.winfo_height())
            x0, y0 = c.canvasx(W / 2), c.canvasy(H / 2)
            frac = state["i"] / max(1, total)
            slow = stalled() > 6
            hh = 88 if slow else 52
            round_rect(c, x0 - 210, y0 - 52, x0 + 210, y0 + hh, 14, fill=T["panel"], outline=T["border"],
                       tags="prescan")
            c.create_text(x0, y0 - 22, text=f"Opening “{self.lib.label(folder)}”", font=UI_FONT_B, fill=T["text"],
                          tags="prescan")
            c.create_rectangle(x0 - 150, y0 - 2, x0 + 150, y0 + 6, fill=T["chip"], outline="", tags="prescan")
            c.create_rectangle(x0 - 150, y0 - 2, x0 - 150 + 300 * max(frac, 0.015), y0 + 6, fill=self.accent,
                               outline="", tags="prescan")
            if not slow:
                c.create_text(x0, y0 + 26, text=f"Reading {state['i']} of {total} files - the first time only",
                              font=UI_FONT_S, fill=T["muted"], tags="prescan")
                return
            wait = next((os.path.basename(t[1]) for t in todo if t[0] not in state["done"]), "")
            c.create_text(x0, y0 + 22, text=f"{state['i']} of {total} read · waiting for “{self._short(wait, 34)}”",
                          font=UI_FONT_S, fill=T["muted"], tags="prescan")
            c.create_text(x0, y0 + 40, text="Windows or OneDrive is still giving it (downloading?)",
                          font=UI_FONT_S, fill=T["muted"], tags="prescan")
            b0 = round_rect(c, x0 - 52, y0 + 52, x0 + 52, y0 + 76, 12, fill=self.accent, outline="",
                            tags=("prescan", "prescan_go"))
            c.create_text(x0, y0 + 64, text="Open now", font=UI_FONT_S, fill="#FFFFFF", tags=("prescan", "prescan_go"))
            c.tag_bind("prescan_go", "<Button-1>", lambda e: open_now())
            c.tag_bind("prescan_go", "<Enter>", lambda e: c.configure(cursor="hand2"))
            c.tag_bind("prescan_go", "<Leave>", lambda e: c.configure(cursor=""))
            del b0

        def progress(key):
            if key in state["done"]:
                return False
            state["done"].add(key)
            state["i"] += 1
            state["last"] = time.time()
            return True

        def watch():
            if getattr(self, "_prescan_token", None) is not token:
                return
            if stalled() > 40:
                return open_now()
            if stalled() > 6:
                show()
            self.root.after(1000, watch)

        def open_now():
            """Open the book with what is read; the slow files come in the background."""
            if getattr(self, "_prescan_token", None) is not token:
                return
            left = [t for t in todo if t[0] not in state["done"]]
            for key, path, st in left:
                self.page_sizes[key] = {"m": st.st_mtime, "s": st.st_size, "p": [], "retry": 1,
                                        "err": "Still being read (Windows or OneDrive is slow to give it) - "
                                               "it appears in a moment"}
            finish()
            if left:
                self.set_status(f"{len(left)} file{'s' if len(left) != 1 else ''} still being read - "
                                f"{'they appear' if len(left) != 1 else 'it appears'} when ready.")
                self._late_read(folder, left)

        def step():
            if getattr(self, "_prescan_token", None) is not token:
                c.delete("prescan")
                return
            t0 = time.time()
            while state["i"] < total and time.time() - t0 < 0.06:
                key, path, st = todo[state["i"]]
                try:
                    ext = os.path.splitext(path)[1].lower()
                    if ext == ".pdf":
                        d = self.fitz.open(path)
                    else:
                        with open(path, "rb") as fh:
                            d = open_stream(self.fitz, _doc_read(fh, path), path)
                        if d.is_reflowable:
                            d.layout(width=500, height=700, fontsize=12)
                    dims = []
                    for i in range(d.page_count):
                        r = d.load_page(i).rect
                        dims.append((round(max(r.width, 1), 2), round(max(r.height, 1), 2)))
                    d.close()
                    self.page_sizes[key] = {"m": st.st_mtime, "s": st.st_size, "p": dims}
                    if office_pdf_ready(path):
                        self.page_sizes[key]["o"] = 1
                except Exception as ex:       # the book shows the error for this file
                    self.page_sizes[key] = {"m": st.st_mtime, "s": st.st_size, "p": [],
                                            "err": str(ex) or ex.__class__.__name__}
                progress(key)
            if state["i"] < total:
                show()
                self.set_status(f"Opening {self.lib.label(folder)}: {state['i']} of {total} files…")
                self._prescan_job = self.root.after(1, step)
            else:
                finish()

        def finish():
            self._prescan_token = None
            c.delete("prescan")
            c.configure(cursor="")
            self._save_sizes()
            self.open_folder(folder, prefix, _scanned=True, then=then)

        def got(key, path, st, res):
            if getattr(self, "_prescan_token", None) is not token:
                if not res.get("cancelled") and not res.get("fallback") and "p" in res:
                    self._size_entry(key, path, st, res)             # late, but not lost
                return
            if res.get("fallback"):            # no helper: this file is read here
                todo_local.append((key, path, st))
                if len(todo_local) == 1:
                    self._prescan_job = self.root.after(1, step_local)
                return
            self._size_entry(key, path, st, res)
            progress(key)
            if state["i"] >= total:
                finish()
            elif time.time() - state["shown"] > 0.12:
                show()
                self.set_status(f"Opening {self.lib.label(folder)}: {state['i']} of {total} files…")

        todo_local = []

        def step_local():
            # the old way, for files no helper could read: a few at a time in this process
            if getattr(self, "_prescan_token", None) is not token:
                return
            t0 = time.time()
            while todo_local and time.time() - t0 < 0.06:
                key, path, st = todo_local.pop(0)
                try:
                    d = self._open_any(path)
                    self.page_sizes[key] = {"m": st.st_mtime, "s": st.st_size, "p": page_dims(d)}
                    if office_pdf_ready(path):
                        self.page_sizes[key]["o"] = 1
                    d.close()
                except Exception as ex:
                    self.page_sizes[key] = {"m": st.st_mtime, "s": st.st_size, "p": [],
                                            "err": str(ex) or ex.__class__.__name__}
                progress(key)
            if state["i"] >= total:
                finish()
                return
            show()
            if todo_local:
                self._prescan_job = self.root.after(1, step_local)

        self.folder = folder
        self.prefix = prefix
        self._fill_folders()
        self.root.title(f"{self.lib.label(folder)} - {APP_NAME}")
        state["shown"] = time.time()                 # a few files: done before a card would even show
        self.root.after(200, lambda: show() if getattr(self, "_prescan_token", None) is token else None)
        self.root.after(1000, watch)
        if self.pool.disabled:
            self._prescan_job = self.root.after(10, step)
            return
        alive = lambda: getattr(self, "_prescan_token", None) is not token
        # small files go in small groups (read side by side, the count moves); big ones alone
        groups, cur, size = [], [], 0
        for t in sorted(todo, key=lambda t: t[2].st_size):
            if t[2].st_size > 4 * 1024 * 1024:          # bigger files: opened where needed only, one by one
                groups.append([t])
                continue
            if cur and (len(cur) >= 4 or size + t[2].st_size > 16 * 1024 * 1024):
                groups.append(cur)
                cur, size = [], 0
            cur.append(t)
            size += t[2].st_size
        if cur:
            groups.append(cur)

        def got_group(grp, res):
            items = res.get("items")
            if items is None or len(items) != len(grp):          # fallback / error: one by one
                for key, path, st in grp:
                    got(key, path, st, res if (res.get("fallback") or res.get("cancelled")) else
                        {"err": res.get("err") or "Could not be read"})
                return
            for (key, path, st), r in zip(grp, items):
                if "p" not in r:
                    r = {"m": st.st_mtime, "s": st.st_size, "p": [], "err": r.get("err") or "Could not be read"}
                got(key, path, st, r)
        for grp in groups:
            if len(grp) == 1:
                key, path, st = grp[0]
                self.pool.submit("info", prio=1, timeout=300, cancel=alive, path=path, marks=is_pdf(path),
                                 cb=lambda res, key=key, path=path, st=st: got(key, path, st, res))
            else:
                self.pool.submit("infos", prio=1, timeout=300, cancel=alive, paths=[t[1] for t in grp], marks=True,
                                 cb=lambda res, grp=grp: got_group(grp, res))

    def _late_read(self, folder, items):
        """2.0 - files that were slow to come (OneDrive downloading them…): read in the background; the book shows
        them as soon as they are there."""
        box = {"n": len(items)}
        late = self.__dict__.setdefault("_late_keys", set())
        late.update(k for k, _p, _s in items)

        def got(key, path, st, res):
            box["n"] -= 1
            late.discard(key)
            if "p" in res and not res.get("cancelled"):
                self._size_entry(key, path, st, res)
            if box["n"] <= 0:
                self._save_sizes()
                show(0)

        def show(tries):
            if self.folder != folder or self.book is None:
                return
            if getattr(self, "_prescan_token", None) is not None or getattr(self, "_ed", None) or self.drag:
                if tries < 40:                              # you are busy on the page: in a moment
                    self.root.after(1500, lambda: show(tries + 1))
                return
            self._reopen_keep_history()
        for key, path, st in items:
            if self.pool.disabled:
                continue
            self.pool.submit("info", prio=6, timeout=900, path=path, marks=is_pdf(path),
                             cb=lambda res, key=key, path=path, st=st: got(key, path, st, res))

    def open_folder(self, folder, prefix="", _scanned=False, then=None):
        """Open a book. It may open a moment later (new files are read first, by the helpers):
        'then' runs once it is open."""
        if self._book_locked(folder):              # 4.1: a book locked with the PIN asks for it first
            self._ask_book_pin(folder, lambda: self.open_folder(folder, prefix, _scanned, then))
            return
        if folder != self.folder and not _scanned:
            self._nav_push()                       # 3.0: Alt+← comes back here
        if getattr(self, "_pv", None) is not None:
            self.close_pages()
        self._prescan_token = None
        self._remember_position()
        self._close_book()
        self.folder = folder
        self.prefix = prefix if prefix and prefix in self.lib.subdirs.get(folder, []) else ""
        self.lib.meta["last_folder"] = folder
        self.lib.meta["last_prefix"] = self.prefix
        self.lib.save_meta()
        self._fresh_check(folder)
        if not _scanned:
            # (a file you just changed here is read here: its newest bytes are still on their way to the disk)
            late = getattr(self, "_late_keys", ())
            todo = [t for t in self._uncached(folder, self.prefix) if self.writer.get(t[1]) is None and
                    t[0] not in late]
            # one or two small files (a file you just changed, a new download): read here, no waiting card
            # (a file only in OneDrive - not on this computer yet - is never read here: it may take a while)
            if todo and (len(todo) > 2 or sum(t[2].st_size for t in todo) > 8 * 1024 * 1024 or
                         any(cloud_only(t[2]) for t in todo)):
                self._prescan(folder, self.prefix, todo, then)
                return
        stats, self._stats = (getattr(self, "_stats", None) if not _scanned else None), {}
        self.book = Book(self.fitz, self.lib, folder, self.prefix, self.writer, self.page_sizes, stats=stats)
        if self.book.sizes_changed:
            self._save_sizes()
        self._fill_folders()
        self._fill_files()
        sub = (" / " + self.prefix.rstrip("/").replace("/", " / ")) if self.prefix else ""
        self.root.title(f"{self.lib.label(folder)}{sub} - {APP_NAME}")
        st = self.lib.meta["positions"].get(self._poskey(), {})
        self.current_page = min(st.get("page", 0), max(0, self.book.total - 1))
        self.fit_mode = st.get("fit", "width")
        self.zoom = st.get("zoom", 1.0)
        if self.fit_mode:
            self.zoom = self._fit_zoom(self.fit_mode)
        if not st and self._is_picture_book() and self.lib.settings.get("gallery", True):
            self.fit_mode = None                            # 4.2: a folder of pictures opens as a gallery
            self.zoom = self._gallery_zoom()
        self._layout()
        target = min(st.get("page", 0), max(0, self.book.total - 1))
        self.goto_page(target, frac=st.get("frac", 0.0))
        self.collect_marks()
        errs = sum(1 for f in self.book.files if f["error"])
        msg = f"{len(self.book.files)} files · {self.book.total} pages"
        if errs:
            msg += f" · {errs} could not be opened"
        self.set_status(msg if self.book.total else
                        ("This book's folder can't be found - was it moved or renamed? BindLens looks for it." if
                         self.lib.missing.get(folder) else
                         'This folder is empty. Add files with "+ Add files" or drag them onto the window.'))
        if self.search_query:
            q, self.search_query = self.search_query, ""
            self.start_search(q)
        self.canvas.focus_set()
        if then:
            then()

    def _save_sizes(self):
        snap = dict(self.page_sizes)
        path = os.path.join(self.lib.meta_dir, "pages.json")
        threading.Thread(target=lambda: save_json(path, snap), daemon=True).start()

    def _close_book(self):
        if getattr(self, "_ed", None):
            try:
                self._close_box_editor(save=True)
            except Exception:
                self._ed = None
        self._close_float()
        self._cancel_search()
        self.hits, self.hits_by_g, self.hit_cur = [], {}, -1
        self.res_tree.delete(*self.res_tree.get_children())
        self.set_search_count("")
        self._flush_dirty(final=True)
        if self.book:
            self.book.close()
        self.book = None
        self.cache.clear()
        self._failed = {}
        self._rendering = {}
        self._queue = []
        self.words_cache.clear()
        self.sel = self.sel_annot = self.flash = None
        self.marks, self.marks_by_g = [], {}
        self.added_by_g = {}
        self._marks_fi, self._marks_pending = set(), 0
        self._rendering = {}
        self.page_tops, self.header_tops = [], {}
        self.undo_stack, self.redo_stack = [], []
        self.canvas.delete("all")
        self._sides_update()
        self.files_tree.delete(*self.files_tree.get_children())
        self.marks_tree.delete(*self.marks_tree.get_children())

    # ================================================================ layout
    def _total(self):
        return self.book.total if self.book else 0

    def _avail(self):
        return max(self.canvas.winfo_width(), 200), max(self.canvas.winfo_height(), 200)

    def _fit_zoom(self, mode):
        if not self.book or not self.book.total:
            return 1.0
        w, h = self._avail()
        mw, mh = self._typical_size()
        if mode == "width":
            z = (w - 2 * GAP) / mw
            z = min(z, 2.2)
        else:
            z = min((w - 2 * GAP) / mw, (h - 2 * GAP - HEADER_H - self._top_pad()) / mh)
        return max(0.1, min(z, 6.0))

    def _typical_size(self):
        """3.0: the size the pages are fitted to - the widest / tallest page, unless one odd page (a big photo, an
        A3 plan) is much bigger than nearly all the others: then the usual size (that page scrolls sideways)."""
        b = self.book
        mw, mh = b.max_width(), b.max_height()
        if len(b.pages) < 5:
            return mw, mh
        ws = sorted(p[2] for p in b.pages)
        hs = sorted(p[3] for p in b.pages)
        k = int(len(ws) * 0.9)
        pw, ph = ws[min(k, len(ws) - 1)], hs[min(k, len(hs) - 1)]
        return (pw if mw > pw * 1.5 else mw), (ph if mh > ph * 1.5 else mh)

    GRID_ZOOM = 0.35                       # 4.2: under 35% more pages appear beside each other, little by little
    GRID_CAP = 20                          # the line over a document's first page in the grid (its name)

    def _layout(self):
        self.page_tops, self.header_tops = [], {}
        self.page_lefts = None
        self.cols = 1
        if self.book and self.book.total and self.zoom < self.GRID_ZOOM - 1e-6 and \
                self.lib.settings.get("zoom_grid", True):
            if self._layout_grid():
                return
        y, last, maxw = GAP + self._top_pad(), None, 0
        if self.book:
            for g, (fi, pi, pw, ph) in enumerate(self.book.pages):
                if fi != last:
                    self.header_tops[fi] = y
                    y += HEADER_H
                    last = fi
                self.page_tops.append(y)
                y += ph * self.zoom + GAP
                maxw = max(maxw, pw * self.zoom)
        self.total_h = y
        self.content_w = maxw + 2 * GAP
        w, _ = self._avail()
        self.canvas.config(scrollregion=(0, 0, max(w, self.content_w), max(self.total_h, 1)))
        self._update_toolbar()
        self.draw_map()

    def _layout_grid(self):
        """4.2: the zoom is under 35%: the pages go side by side, as many as fit across the window - zoom out a
        little more and one more column appears. A document's first page carries its name."""
        z = self.zoom
        vw = max(self.canvas.winfo_width(), 200)
        mw, _mh = self._typical_size()
        tw = mw * z
        gap = max(14, GAP * 0.7)
        if self._is_picture_book() and self._gallery_style() != "none":
            gap = 46                                       # 4.3: room for each picture's frame (Polaroid, museum…)
        cols = int((vw - gap) // (tw + gap))
        cols = min(cols, 2 + int((self.GRID_ZOOM - z) / 0.035))   # one more column at a time, little by little
        if cols < 2:
            return False
        self.cols = cols
        cap = self.GRID_CAP
        x0 = (vw - (cols * (tw + gap) - gap)) / 2
        self._grid_span = (x0, x0 + cols * (tw + gap) - gap, tw)
        lefts = []
        y = GAP + self._top_pad()
        col, rowh = 0, 0.0
        for g, (fi, pi, pw, ph) in enumerate(self.book.pages):
            if self.book.files[fi]["first"] == g:
                self.header_tops[fi] = y
            lefts.append(x0 + col * (tw + gap) + max(0.0, (tw - pw * z) / 2))
            self.page_tops.append(y + cap)
            rowh = max(rowh, ph * z)
            col += 1
            if col >= cols:
                col = 0
                y += cap + rowh + gap
                rowh = 0.0
        if col:
            y += cap + rowh + gap
        self.page_lefts = lefts
        self.total_h = y + GAP
        self.content_w = vw
        self.canvas.config(scrollregion=(0, 0, vw, max(self.total_h, 1)))
        self.canvas.xview_moveto(0)
        self._update_toolbar()
        self.draw_map()
        return True

    PIC_EXTS = {".png", ".jpg", ".jpeg", ".bmp", ".gif", ".tif", ".tiff", ".webp", ".heic", ".heif"}

    def _is_picture_book(self):
        """4.2: a book (or sub-book) that holds only pictures - it opens as a gallery."""
        try:
            fs = self.book.files if self.book else []
            return len(fs) >= 2 and all(os.path.splitext(f["rel"])[1].lower() in self.PIC_EXTS or
                                        is_video(f["rel"]) for f in fs)
        except Exception:
            return False

    def _gallery_zoom(self):
        """The zoom that shows the pictures four (or so) across."""
        vw = max(self.canvas.winfo_width(), 400)
        mw, _mh = self._typical_size()
        z = (vw - 5 * 46) / (4.0 * max(1.0, mw))
        return max(0.06, min(z, self.GRID_ZOOM - 0.08))

    def _grid_open(self, g):
        """4.2: a page (or picture) chosen in the grid: shown whole, in the middle of the window.
        4.4.3: in a gallery (a folder of pictures) it opens the picture viewer - big, in its frame, with the film strip
        and the effects (← → the next one, Esc back to the gallery)."""
        if not self.book or g is None or g >= self.book.total:
            return
        if self._is_picture_book() and not getattr(self, "_reading", False) and \
                self._stage_conf().get("pic_stage", True):
            self.gallery_view(g)
            return
        self.fit_mode = "page"
        self.current_page = g
        self._apply_zoom(self._fit_zoom("page"))
        self.goto_page(g)
        self._center_x(g)
        if self._is_picture_book():
            self.set_status("Ctrl + wheel (or −) to see all the pictures again  ·  ← → the next one  ·  "
                            "Read (F6): a slideshow")

    def _pic_frame(self, c, x, y, w, h):
        """4.2: the frame's flowing colours round a picture while it is shown in reading mode (a slideshow)."""
        cyc = getattr(self, "_fr_cyc", None)
        if not cyc:
            try:
                cyc = frame_cycle(frame_palette(self._frame_conf(), self.accent), 900)
                self._fr_cyc = cyc
            except Exception:
                return
        th, pad = 9.0, 5.0
        mx0, my0 = x - pad - th / 2, y - pad - th / 2
        mx1, my1 = x + w + pad + th / 2, y + h + pad + th / 2
        cw, ch = mx1 - mx0, my1 - my0
        per = 2 * (cw + ch)
        corners = [(0.0, (mx0, my0)), (cw, (mx1, my0)), (cw + ch, (mx1, my1)), (2 * cw + ch, (mx0, my1)),
                   (per, (mx0, my0))]

        def pt(s_):
            s_ = s_ % per
            if s_ <= cw:
                return mx0 + s_, my0
            if s_ <= cw + ch:
                return mx1, my0 + (s_ - cw)
            if s_ <= 2 * cw + ch:
                return mx1 - (s_ - cw - ch), my1
            return mx0, my1 - (s_ - 2 * cw - ch)
        ph = getattr(self, "_fr_phase", 0.0)
        N = 72
        for i in range(N):
            s0, s1 = per * i / N, per * (i + 1) / N
            pts = [pt(s0)] + [p_ for sc, p_ in corners if s0 < sc < s1] + [pt(s1)]
            r_, g_, b_ = cyc[int(s0 / per * len(cyc) - ph) % len(cyc)]
            flat = [v for p_ in pts for v in p_]
            c.create_line(*flat, fill="#%02X%02X%02X" % (r_, g_, b_), width=th, capstyle="projecting",
                          joinstyle="miter")

    # ---- 4.3: pictures - a frame for each (gallery) and a stage to see them one at a time (reading) ---------------
    PIC_STYLES = OrderedDict([("polaroid", "Polaroid"), ("museum", "Museum"), ("gold", "Gold"),
                              ("colours", "The frame's colours"), ("none", "None")])

    # 4.4: how the next picture comes in on the stage
    PIC_FX = OrderedDict([("mix", "A different one each time"), ("slide", "Slide"), ("push", "Push"),
                          ("drop", "Drop"), ("wipe", "Wipe"), ("blinds", "Blinds"), ("flip", "Flip card"),
                          ("mosaic", "Mosaic")])

    def _gallery_style(self):
        return self.lib.settings.get("gallery_style", "polaroid")

    def _stage_conf(self):
        rc = self._read_conf()
        rc.setdefault("pic_stage", True)
        rc.setdefault("stage_style", "colours" if rc.get("pic_frame", True) else "none")
        rc.setdefault("stage_fx", "mix")
        return rc

    def _hand_font(self, size):
        """A handwriting font for the Polaroid captions (Windows has Segoe Print / Ink Free), else the app's."""
        fam = self.__dict__.get("_hand_fam")
        if fam is None:
            fam = ""
            try:
                from tkinter import font as tkfont
                have = set(tkfont.families(self.root))
                fam = next((f_ for f_ in ("Segoe Print", "Ink Free", "Comic Neue", "Bradley Hand") if f_ in have), "")
            except Exception:
                pass
            self._hand_fam = fam
        return (fam, size) if fam else self.F(size)

    def pic_deco_extra(self, style, w):
        """How much room a picture's frame takes: (left/right/top, bottom)."""
        if style == "polaroid":
            p = max(6, w * 0.045)
            return p, max(22, w * 0.17)
        if style == "museum":
            m = max(10, w * 0.075) + 5
            return m, m
        if style in ("gold", "colours"):
            return 12, 12
        return 0, 0

    def _pic_deco(self, c, x, y, w, h, style, caption=None, tag=None):
        """A frame round one picture: Polaroid (a white card with its name written below), museum (a white mount
        and a thin black frame), gold (like the logo), the frame's flowing colours, or none."""
        T = self.T
        kw = {"tags": tag} if tag else {}
        sh = mix(T["canvas"], "#000000", 0.22)
        if style == "polaroid":
            p, pb = self.pic_deco_extra("polaroid", w)
            for k_, t_ in ((7, 0.25), (4, 0.5), (2, 0.9)):
                c.create_rectangle(x - p + k_ / 2, y - p + k_, x + w + p + k_ / 2, y + h + pb + k_, outline="",
                                   fill=mix(T["canvas"], sh, t_), **kw)
            c.create_rectangle(x - p, y - p, x + w + p, y + h + pb, fill="#FBFAF7", outline="#E6E2DA", **kw)
            if caption and pb >= 20:
                fs = max(8, min(16, int(pb * 0.34)))
                c.create_text(x + w / 2, y + h + pb * 0.52, text=self._fit_text(caption, self._sfont(fs), w),
                              font=self._hand_font(fs), fill="#3A3A46", **kw)
        elif style == "museum":
            m = max(10, w * 0.075)
            for k_, t_ in ((8, 0.25), (5, 0.5), (2, 0.9)):
                c.create_rectangle(x - m - 5 + k_ / 2, y - m - 5 + k_, x + w + m + 5 + k_ / 2, y + h + m + 5 + k_,
                                   outline="", fill=mix(T["canvas"], sh, t_), **kw)
            c.create_rectangle(x - m - 5, y - m - 5, x + w + m + 5, y + h + m + 5, fill="#17171C", outline="", **kw)
            c.create_rectangle(x - m, y - m, x + w + m, y + h + m, fill="#F6F3EC", outline="", **kw)
            c.create_rectangle(x - 1, y - 1, x + w + 1, y + h + 1, outline="#D8D2C4", **kw)    # the mount's cut
        elif style == "gold":
            d = 0.0
            for col, wd in (("#5E4510", 1), ("#FFE6A0", 1), ("#E2B13C", 6), ("#F7D57A", 1), ("#8A6A1F", 2)):
                d += wd / 2
                c.create_rectangle(x - d, y - d, x + w + d, y + h + d, outline=col, width=wd, **kw)
                d += wd / 2
            c.create_rectangle(x - d + 3, y + h + d, x + w + d + 3, y + h + d + 4, outline="",
                               fill=mix(T["canvas"], sh, 0.6), **kw)
        elif style == "colours":
            self._pic_frame(c, x, y, w, h)

    # the stage: one picture at a time, big, in its frame, with a film strip below
    def _stage_wanted(self):
        try:
            return bool(getattr(self, "_reading", False) and self.book and self.book.total and
                        self._is_picture_book() and self._stage_conf().get("pic_stage", True) and
                        not self.fullscreen and getattr(self, "_lock", None) is None)
        except Exception:
            return False

    def _stage_sync(self):
        """Show / hide / follow the stage (called after the pages are drawn - cheap when nothing changed)."""
        want = self._stage_wanted()
        st = getattr(self, "_stage", None)
        if not want:
            if st is not None:
                self._stage = None
                try:
                    st.destroy()
                except Exception:
                    pass
            return
        if st is None:
            c = tk.Canvas(self.canvas.master, highlightthickness=0, bd=0, bg=self.T["canvas"])
            c.place(in_=self.canvas, x=0, y=0, relwidth=1, relheight=1)
            tk.Misc.tkraise(c)
            self._stage = c
            self._stage_g = None
            self._stage_hits = []
            self._stage_wheel_t = 0.0
            c.bind("<Configure>", lambda e: self._stage_draw())
            c.bind("<Button-1>", self._stage_click)
            c.bind("<Motion>", self._stage_motion)
            for seq, d in (("<Left>", -1), ("<Up>", -1), ("<Prior>", -1), ("<BackSpace>", -1), ("<Right>", 1),
                           ("<Down>", 1), ("<Next>", 1), ("<space>", 1)):
                c.bind(seq, lambda e, d=d: (self._stage_step(d), "break")[1])
            c.bind("<Home>", lambda e: (self._stage_go(0, -1), "break")[1])
            c.bind("<End>", lambda e: (self._stage_go(self.book.total - 1, 1), "break")[1])
            c.bind("<Escape>", lambda e: (self.reading_mode(False), "break")[1])
            c.bind("<MouseWheel>", lambda e: self._stage_wheel(-1 if e.delta > 0 else 1))
            c.bind("<Button-4>", lambda e: self._stage_wheel(-1))
            c.bind("<Button-5>", lambda e: self._stage_wheel(1))
            c.focus_set()
        sides = (getattr(self, "_sides_geo", {}).get("l"), getattr(self, "_sides_geo", {}).get("r"))
        if self._stage_g != self.current_page or sides != getattr(self, "_stage_sides", None):
            self._stage_g = self.current_page
            self._stage_sides = sides
            self._stage_off = 0.0
            self._stage_draw()

    def _stage_wheel(self, d):
        if time.time() - getattr(self, "_stage_wheel_t", 0) > 0.35:
            self._stage_wheel_t = time.time()
            self._stage_step(d)
        return "break"

    def _stage_step(self, d):
        if self.book and self.book.total:
            self._stage_go((self.current_page + d) % self.book.total, d)

    def _stage_go(self, g, d=1):
        """To picture g - it comes in with the chosen effect (4.4: slide, push, drop, wipe, blinds, flip card,
        mosaic - or a different one each time), from the right going forward, from the left going back."""
        if not self.book or g is None or not (0 <= g < self.book.total):
            return
        old = self.current_page if getattr(self, "_stage", None) is not None else None
        self._stage_g = g
        self.current_page = g
        try:
            self.goto_page(g)
        except Exception:
            pass
        if getattr(self, "_slide_on", False):
            self._slide_plan()                           # the next one waits its full time again
        job = getattr(self, "_stage_job", None)
        if job:
            try:
                self.root.after_cancel(job)
            except Exception:
                pass
        kind = self._stage_conf().get("stage_fx", "mix")
        if kind == "mix":                                # a different one each time
            pool = [k for k in self.PIC_FX if k not in ("mix", getattr(self, "_stage_fx_last", None))]
            kind = random.choice(pool)
        if kind not in self.PIC_FX or self._fast() or old is None or old == g:
            self._stage_fx = None
            self._stage_off = 0.0
            self._stage_draw()
            return
        self._stage_fx_last = kind
        n = {"drop": 16, "flip": 12, "mosaic": 10, "push": 13}.get(kind, 12)

        def frame(k=0):
            self._stage_job = None
            if getattr(self, "_stage", None) is None:
                self._stage_fx = None
                return
            self._stage_fx = [kind, k / float(n - 1), d, old] if k < n - 1 else None
            self._stage_off = 0.0
            self._stage_draw()
            if k + 1 < n:
                self._stage_job = self.root.after(26, lambda: frame(k + 1))
        frame()

    def gallery_view(self, g=None, slideshow=False):
        """4.4.3: a gallery's viewer - one picture at a time, big, with the effects (the reading mode of a folder of
        pictures). From a click: no slideshow until you press Play."""
        if not self.book or not self.book.total:
            return
        if g is not None:
            self.current_page = max(0, min(int(g), self.book.total - 1))
        self._gal_no_slide = not slideshow
        self.reading_mode(True)

    def gallery_menu(self, x=None, y=None):
        """4.4.3: Personalise the gallery - the frame round the pictures, the frame when one is big, how the next one
        comes in, the slideshow."""
        rc = self._stage_conf()
        m = self._menu()

        def setv(k, v):
            rc[k] = v
            self.lib.save_meta()
            if getattr(self, "_stage", None) is not None:
                self._stage_draw()

        def set_gal(v):
            self.lib.settings["gallery_style"] = v
            self.lib.save_meta()
            if self.book is not None and self._is_picture_book() and not getattr(self, "_reading", False):
                self._layout()
                self.redraw()
        m.add_command(label="See them big, one at a time   (click a picture)", command=lambda: self.gallery_view(
            self.current_page))
        m.add_command(label="Slideshow", command=lambda: self.gallery_view(self.current_page, slideshow=True))
        m.add_separator()
        v1 = tk.StringVar(value=self._gallery_style())
        m1 = self._menu(m)
        for k, lab in self.PIC_STYLES.items():
            m1.add_radiobutton(label=lab, variable=v1, value=k, command=lambda k=k: set_gal(k))
        m.add_cascade(label="The frame in the gallery", menu=m1)
        v2 = tk.StringVar(value=rc.get("stage_style", "colours"))
        m2 = self._menu(m)
        for k, lab in self.PIC_STYLES.items():
            m2.add_radiobutton(label=lab, variable=v2, value=k, command=lambda k=k: setv("stage_style", k))
        m.add_cascade(label="The frame when one is big", menu=m2)
        v3 = tk.StringVar(value=rc.get("stage_fx", "mix"))
        m3 = self._menu(m)
        for k, lab in self.PIC_FX.items():
            m3.add_radiobutton(label=lab, variable=v3, value=k, command=lambda k=k: setv("stage_fx", k))
        m.add_cascade(label="How the next one comes in", menu=m3)
        v4 = tk.IntVar(value=int(rc.get("slide_secs", 6)))
        m4 = self._menu(m)
        for k in (3, 6, 10, 15):
            m4.add_radiobutton(label=f"Every {k} seconds", variable=v4, value=k, command=lambda k=k: setv(
                "slide_secs", k))
        m.add_cascade(label="Slideshow - how fast", menu=m4)
        m.add_separator()
        m.add_command(label="More… (Personalise > Reading mode)", command=self.personalise_dialog)
        if x is None:
            x, y = self.root.winfo_pointerx(), self.root.winfo_pointery()
        self._popup(m, x=x, y=y)
        self._gal_menu_vars = (v1, v2, v3, v4)

    def _stage_fx_menu(self, x, y):
        """4.4: choose how the next picture comes in (shown at once on the next picture)."""
        rc = self._stage_conf()
        m = self._menu()
        var = tk.StringVar(value=rc.get("stage_fx", "mix"))

        def pick(k):
            rc["stage_fx"] = k
            self.lib.save_meta()
            if getattr(self, "_stage", None) is not None and self.book and self.book.total > 1:
                self._stage_step(1)                      # see it at once
        for k, lab in self.PIC_FX.items():
            m.add_radiobutton(label=lab, variable=var, value=k, command=lambda k=k: pick(k))
        st = getattr(self, "_stage", None)
        if st is not None:
            self._popup(m, x=st.winfo_rootx() + int(x), y=st.winfo_rooty() + int(y))

    def _stage_crop(self, img, x0, y0, w, h):
        """A part of a picture (for the wipe and the blinds) - copied by Tk, quick."""
        x0, y0 = max(0, int(x0)), max(0, int(y0))
        w = max(1, min(int(w), img.width() - x0))
        h = max(1, min(int(h), img.height() - y0))
        im = tk.PhotoImage(width=w, height=h)
        im.tk.call(im.name, "copy", img.name, "-from", x0, y0, x0 + w, y0 + h)
        self.__dict__.setdefault("_stage_crops", []).append(im)
        return im

    def _stage_img(self, g, z, thumb=False):
        """A picture at a zoom (made by a helper); None until it is ready."""
        key = ("t" if thumb else "s", g, round(z, 3))
        cache = self.__dict__.setdefault("_stage_cache", OrderedDict())
        if key in cache:
            cache.move_to_end(key)
            return cache[key]
        cache[key] = None
        while len(cache) > 60:
            cache.popitem(last=False)
        fi, pi, pw, ph = self.book.pages[g]
        path = self.book.files[fi]["path"]
        bk = self.book

        def got(res):
            img = None
            if "rgb" in res:
                try:
                    img = tk.PhotoImage(data=b"P6\n%d %d\n255\n" % (res["w"], res["h"]) + res["rgb"])
                except Exception:
                    img = None
            if self.book is bk:
                cache[key] = img
                if img is not None and getattr(self, "_stage", None) is not None:
                    self._stage_draw()
        if self.pool.disabled:
            try:
                doc = self._open_any(path)
                pix = doc.load_page(pi).get_pixmap(matrix=self.fitz.Matrix(z, z), alpha=False)
                cache[key] = tk.PhotoImage(data=pix.tobytes("ppm"))
                doc.close()
            except Exception:
                cache[key] = None
            return cache[key]
        self.pool.submit("render", prio=3 if thumb else 1, timeout=60, path=path, pi=pi, zoom=z, cb=got)
        return None

    def _stage_motion(self, e):
        h = next((x for x in reversed(getattr(self, "_stage_hits", [])) if x[0] <= e.x <= x[2] and
                  x[1] <= e.y <= x[3]), None)
        k = h[4] if h else None
        try:
            self._stage.configure(cursor="hand2" if h else "")
        except Exception:
            pass
        if k != getattr(self, "_stage_hov", None):
            self._stage_hov = k
            self._stage_draw()

    def _stage_click(self, e):
        self._stage.focus_set()
        h = next((x for x in reversed(getattr(self, "_stage_hits", [])) if x[0] <= e.x <= x[2] and
                  x[1] <= e.y <= x[3]), None)
        if h:
            h[5]()

    def _stage_draw(self):
        c = getattr(self, "_stage", None)
        if c is None or not c.winfo_exists() or not self.book or not self.book.total:
            return
        T, A = self.T, self.accent
        W, H = max(200, c.winfo_width()), max(200, c.winfo_height())
        c.delete("all")
        hits = self._stage_hits = []
        hov = getattr(self, "_stage_hov", None)
        # behind: the reading background, still
        conf = dict(self._bg_conf())
        bkey = (W, H, json.dumps(conf, sort_keys=True, default=str), T["canvas"])
        if getattr(self, "_stage_bgkey", None) != bkey:
            self._stage_bgkey = bkey
            self._stage_bg = None
            if conf.get("mode", "none") != "none":
                try:
                    if conf.get("motion") in ("drift", "flow"):
                        conf["motion"] = "flow"
                    self._stage_bg = tk.PhotoImage(data=self._bg_ppm(conf, W, H, 0.13))
                except Exception:
                    self._stage_bg = None
        if self._stage_bg is not None:
            c.create_image(0, 0, image=self._stage_bg, anchor="nw")
        else:
            c.configure(bg=T["canvas"])
        light = is_light(T["canvas"])
        ink = "#1E1E2A" if light else "#F2F2F6"
        sub = mix(ink, T["canvas"], 0.4)
        g = max(0, min(self.current_page, self.book.total - 1))
        fi, pi, pw, ph = self.book.pages[g]
        f = self.book.files[fi]
        style = self._stage_conf().get("stage_style", "colours")
        strip = 78 if H > 480 and self.book.total > 1 else 0
        cap_h = 46
        top, bot = 26, H - strip - cap_h
        lg, rg = getattr(self, "_sides_geo", {}).get("l"), getattr(self, "_sides_geo", {}).get("r")
        xa = lg[0] + lg[2] + 8 if lg else 0                 # between the cards beside it (contents, clock)
        xb = rg[0] - 8 if rg else W
        if xb - xa < W * 0.45:
            xa, xb = 0, W
        SW = xb - xa
        # the picture, as big as fits with its frame
        ex_s, ex_b = self.pic_deco_extra(style, min(W, H) * 0.6)
        z = min((SW - 130 - 2 * ex_s) / max(1.0, pw), (bot - top - ex_s - ex_b) / max(1.0, ph))
        z = max(0.02, z)
        w, h = pw * z, ph * z
        ex_s, ex_b = self.pic_deco_extra(style, w)
        x = xa + (SW - w) / 2
        y = top + (bot - top - h - ex_s - ex_b) / 2 + ex_s
        img = self._stage_img(g, z)
        name = os.path.splitext(os.path.basename(f["rel"]))[0]
        self._stage_crops = []

        def show(x_, y_, w_, h_, img_, nm, with_img=True):
            self._pic_deco(c, x_, y_, w_, h_, style, nm)
            if style == "none":
                for k_, t_ in ((8, 0.2), (5, 0.45), (2, 0.85)):
                    c.create_rectangle(x_ - k_ / 2 + 2, y_ + k_ / 2, x_ + w_ + k_ / 2 + 2, y_ + h_ + k_, outline="",
                                       fill=mix(T["canvas"], "#000000", 0.25 * t_))
            if not with_img:
                c.create_rectangle(x_, y_, x_ + w_, y_ + h_, fill=mix(T["canvas"], ink, 0.07), outline="")
            elif img_ is not None:
                c.create_image(x_, y_, image=img_, anchor="nw")
            else:
                c.create_rectangle(x_, y_, x_ + w_, y_ + h_, fill=mix(T["canvas"], ink, 0.08), outline="")
                c.create_text(x_ + w_ / 2, y_ + h_ / 2, text="…", font=self.F(20, "bold"), fill=sub)

        def old_one(og):
            if og is None or og == g or not (0 <= og < self.book.total):
                return None
            _f0, _p0, pw0, ph0 = self.book.pages[og]
            es0, eb0 = self.pic_deco_extra(style, min(W, H) * 0.6)
            z0 = max(0.02, min((SW - 130 - 2 * es0) / max(1.0, pw0), (bot - top - es0 - eb0) / max(1.0, ph0)))
            w0, h0 = pw0 * z0, ph0 * z0
            es0, eb0 = self.pic_deco_extra(style, w0)
            nm0 = os.path.splitext(os.path.basename(self.book.files[_f0]["rel"]))[0]
            return (xa + (SW - w0) / 2, top + (bot - top - h0 - es0 - eb0) / 2 + es0, w0, h0,
                    self._stage_img(og, z0), nm0)

        fxs = getattr(self, "_stage_fx", None)
        if not fxs:
            show(x, y, w, h, img, name)
        else:
            kind, p, d, og = fxs
            e = 1 - (1 - p) ** 3
            od = old_one(og)
            if kind == "slide":
                show(x + (1 - e) * d * W * 0.35, y, w, h, img, name)
            elif kind == "push":
                if od:
                    show(od[0] - d * e * (SW + 60), od[1], od[2], od[3], od[4], od[5])
                show(x + d * (1 - e) * (SW + 60), y, w, h, img, name)
            elif kind == "drop":                         # it falls in and bounces; the one before falls away
                if od and p < 0.45:
                    q = p / 0.45
                    show(od[0], od[1] + q * q * (H - od[1] + 40), od[2], od[3], od[4], od[5])
                if p < 1 / 2.75:
                    b_ = 7.5625 * p * p
                elif p < 2 / 2.75:
                    q = p - 1.5 / 2.75
                    b_ = 7.5625 * q * q + 0.75
                elif p < 2.5 / 2.75:
                    q = p - 2.25 / 2.75
                    b_ = 7.5625 * q * q + 0.9375
                else:
                    q = p - 2.625 / 2.75
                    b_ = 7.5625 * q * q + 0.984375
                show(x, y - (1 - b_) * (y + h + 80), w, h, img, name)
            elif kind == "wipe":                         # the picture appears from one side, a gold line ahead
                show(x, y, w, h, img, name, with_img=False)
                if img is not None:
                    cw = max(1, int(img.width() * e))
                    sx_ = 0 if d > 0 else img.width() - cw
                    c.create_image(x + sx_, y, image=self._stage_crop(img, sx_, 0, cw, img.height()), anchor="nw")
                    ex_ = x + (cw if d > 0 else img.width() - cw)
                    c.create_line(ex_, y, ex_, y + h, fill="#F2C45A", width=3)
            elif kind == "blinds":                       # in strips, like opening blinds
                show(x, y, w, h, img, name, with_img=False)
                if img is not None:
                    nb = 9
                    hs = img.height() / float(nb)
                    for i_ in range(nb):
                        y0_ = int(i_ * hs)
                        hh = int(min(hs + 1, (hs + 1) * min(1.0, e * 1.15 - i_ * 0.015)))
                        if hh >= 1:
                            c.create_image(x, y + y0_, image=self._stage_crop(img, 0, y0_, img.width(), hh),
                                           anchor="nw")
            elif kind == "flip":                         # a card turns over: the one before, then this one
                back = "#FBFAF7" if style == "polaroid" else ("#F6F3EC" if style == "museum" else
                                                              mix(T["canvas"], ink, 0.14))
                ref = od if (p < 0.5 and od) else (x, y, w, h, img, name)
                k_ = abs(1 - p * 2)
                cx_, cw_ = ref[0] + ref[2] / 2, max(2, ref[2] * k_)
                tilt = (1 - k_) * 10
                c.create_polygon(cx_ - cw_ / 2, ref[1] - tilt, cx_ + cw_ / 2, ref[1] + tilt,
                                 cx_ + cw_ / 2, ref[1] + ref[3] - tilt, cx_ - cw_ / 2, ref[1] + ref[3] + tilt,
                                 fill=back, outline=mix(back, "#000000", 0.18))
                c.create_line(cx_, ref[1] + 6, cx_, ref[1] + ref[3] - 6, fill=mix(back, "#000000", 0.08))
            elif kind == "mosaic":                       # the picture appears tile by tile
                show(x, y, w, h, img, name)
                cols_, rows_ = 12, 8
                cells = [(i_, j_) for i_ in range(cols_) for j_ in range(rows_)]
                random.Random(g * 7919 + 13).shuffle(cells)
                left = int(len(cells) * (1 - e))
                cw_, ch_ = w / cols_, h / rows_
                cover = mix(T["canvas"], ink, 0.07)
                for i_, j_ in cells[:left]:
                    c.create_rectangle(x + i_ * cw_, y + j_ * ch_, x + (i_ + 1) * cw_ + 1, y + (j_ + 1) * ch_ + 1,
                                       fill=cover, outline="")
            else:
                show(x, y, w, h, img, name)
            # 4.4.1: what moved outside the picture's place is covered again by the background (both sides)
            for mx0, mx1 in ((0, xa), (xb, W)):
                if mx1 - mx0 < 2:
                    continue
                if self._stage_bg is not None:
                    c.create_image(mx0, 0, image=self._stage_crop(self._stage_bg, mx0, 0, mx1 - mx0, bot + cap_h),
                                   anchor="nw")
                else:
                    c.create_rectangle(mx0, 0, mx1, bot + cap_h, fill=T["canvas"], outline="")
        if is_video(f["path"]) and not fxs:             # 4.4: a video - its play button, big
            on = hov == "playvid"
            pr = max(26, min(54, min(w, h) * 0.16))
            pcx, pcy = x + w / 2, y + h / 2 - h * 0.08
            c.create_oval(pcx - pr - 6, pcy - pr - 6, pcx + pr + 6, pcy + pr + 6, fill="", outline="#FFFFFF",
                          width=3 if on else 1)
            hits.append((x, y, x + w, y + h, "playvid", lambda p_=f["path"]: self.play_video(p_)))
        else:
            hits.append((x, y, x + w / 2, y + h, "prevpic", lambda: self._stage_step(-1)))
            hits.append((x + w / 2, y, x + w, y + h, "nextpic", lambda: self._stage_step(1)))
        if g + 1 < self.book.total:                      # the next one is made while you look at this one
            fi2, pi2, pw2, ph2 = self.book.pages[g + 1]
            z2 = min((SW - 130 - 2 * ex_s) / max(1.0, pw2), (bot - top - ex_s - ex_b) / max(1.0, ph2))
            self._stage_img(g + 1, max(0.02, z2))
        # the caption: name · n of N · the day it was taken (the file's date)
        try:
            when = time.strftime("%d %B %Y", time.localtime(os.path.getmtime(f["path"]))).lstrip("0")
        except Exception:
            when = ""
        cy = bot + cap_h / 2 + (4 if style == "polaroid" else 0)
        c.create_text(xa + SW / 2, cy - 8, text=self._fit_text(name, self._sfont(11, "bold"), SW - 40),
                      font=self.F(11, "bold"), fill=ink)
        c.create_text(xa + SW / 2, cy + 11, text=f"{g + 1} of {self.book.total}" + (f"  ·  {when}" if when else ""),
                      font=self.F(9), fill=sub)
        # 4.4: the effect - a quiet chip at the top right; click it to choose another
        fx_lab = "Effect: " + ("Mix" if self._stage_conf().get("stage_fx", "mix") == "mix" else
                               self.PIC_FX.get(self._stage_conf().get("stage_fx"), "Slide"))
        on = hov == "fxchip"
        fw_ = self._measure(fx_lab, self._sfont(8)) + 22
        fx1, fy0 = xb - 12, 8
        if on:
            round_rect(c, fx1 - fw_, fy0, fx1, fy0 + 22, 11, fill=mix(T["canvas"], ink, 0.08),
                       outline=mix(T["canvas"], A, 0.5))
        c.create_text(fx1 - 11, fy0 + 11, text=fx_lab, anchor="e", font=self.F(8), fill=A if on else sub)
        hits.append((fx1 - fw_, fy0, fx1, fy0 + 22, "fxchip", lambda: self._stage_fx_menu(fx1 - fw_, fy0 + 24)))
        on = hov == "galchip"
        gw_ = self._measure("Personalise", self._sfont(8)) + 22
        gx1 = fx1 - fw_ - 6
        if on:
            round_rect(c, gx1 - gw_, fy0, gx1, fy0 + 22, 11, fill=mix(T["canvas"], ink, 0.08),
                       outline=mix(T["canvas"], A, 0.5))
        c.create_text(gx1 - 11, fy0 + 11, text="Personalise", anchor="e", font=self.F(8), fill=A if on else sub)
        hits.append((gx1 - gw_, fy0, gx1, fy0 + 22, "galchip", lambda: self.gallery_menu(
            self._stage.winfo_rootx() + int(gx1 - gw_), self._stage.winfo_rooty() + int(fy0 + 24))))
        # ‹ › at the sides: thin, quiet
        for key, xx, ic, d in (("prev", xa + 34, "left", -1), ("next", xb - 34, "right", 1)):
            on = hov == key
            yy = top + (bot - top) / 2
            c.create_oval(xx - 20, yy - 20, xx + 20, yy + 20, fill=mix(T["canvas"], ink, 0.08) if on else "",
                          outline=mix(T["canvas"], ink, 0.35 if on else 0.2))
            draw_icon(c, ic, xx, yy, A if on else ink, s=0.8, w=1.4)
            hits.append((xx - 22, yy - 22, xx + 22, yy + 22, key, lambda d=d: self._stage_step(d)))
        # the film strip
        if strip:
            th = strip - 26
            n = self.book.total
            k = max(1, min(n, int((W - 80) // (th * 1.4 + 10))))
            first = max(0, min(n - k, g - k // 2))
            items = []
            for gi in range(first, first + k):
                _f, _p, pw_, ph_ = self.book.pages[gi]
                items.append((gi, th / max(1.0, ph_) * pw_))
            tot = sum(wd + 10 for _gi, wd in items) - 10
            sx = (W - tot) / 2
            sy = H - strip + 8
            for gi, wd in items:
                zt = th / max(1.0, self.book.pages[gi][3])
                im = self._stage_img(gi, zt, thumb=True)
                cur = gi == g
                on = hov == f"th{gi}"
                if cur:
                    c.create_rectangle(sx - 4, sy - 4, sx + wd + 4, sy + th + 4, outline=A, width=2)
                if im is not None:
                    c.create_image(sx, sy, image=im, anchor="nw")
                else:
                    c.create_rectangle(sx, sy, sx + wd, sy + th, fill=mix(T["canvas"], ink, 0.1), outline="")
                if not cur and not on:                  # the others a little quieter
                    c.create_rectangle(sx, sy, sx + wd, sy + th, outline=mix(T["canvas"], ink, 0.15))
                if on and not cur:
                    c.create_rectangle(sx - 2, sy - 2, sx + wd + 2, sy + th + 2, outline=mix(A, ink, 0.3),
                                       width=1)
                hits.append((sx, sy, sx + wd, sy + th, f"th{gi}", lambda gi=gi: self._stage_go(gi, 1 if gi > g
                                                                                               else -1)))
                sx += wd + 10

    def _slide_toggle(self):
        self._slide_on = not getattr(self, "_slide_on", False)
        self._slide_plan()
        self._topband_draw()

    def _slide_plan(self):
        if getattr(self, "_slide_job", None):
            try:
                self.root.after_cancel(self._slide_job)
            except Exception:
                pass
            self._slide_job = None
        if getattr(self, "_slide_on", False) and getattr(self, "_reading", False) and self._is_picture_book():
            secs = max(2, int(self._read_conf().get("slide_secs", 6)))
            self._slide_job = self.root.after(secs * 1000, self._slide_tick)

    def _slide_tick(self):
        """4.2: the slideshow of a pictures folder in reading mode - the next picture every few seconds."""
        self._slide_job = None
        if not (getattr(self, "_slide_on", False) and getattr(self, "_reading", False) and self.book and
                self.book.total):
            return
        if self.root.state() != "iconic" and getattr(self, "_lock", None) is None:
            g = self.current_page + 1
            if g >= self.book.total:
                g = 0
            if getattr(self, "_stage", None) is not None:       # 4.3: on the stage it slides in
                self._stage_go(g, 1)
            else:
                self.current_page = g
                self.goto_page(g)
                self._center_x(g)
        self._slide_plan()

    def _page_at_y(self, y):
        tops = self.page_tops
        if not tops:
            return 0
        lo, hi = 0, len(tops) - 1
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if tops[mid] <= y:
                lo = mid
            else:
                hi = mid - 1
        while lo > 0 and tops[lo - 1] == tops[lo]:        # 4.2: in the grid, the first page of that row
            lo -= 1
        return lo

    def _grid_hit(self, cx, cy):
        """The page under a point of the grid (None between pages)."""
        g = self._page_at_y(cy)
        top = self.page_tops[g] if self.page_tops else 0
        while g < self._total() and self.page_tops[g] == top:
            x0 = self.page_lefts[g]
            if x0 <= cx <= x0 + self._page_w(g) and top <= cy <= top + self._page_h(g):
                return g
            g += 1
        return None

    def _page_h(self, g):
        return self.book.pages[g][3] * self.zoom

    def _page_w(self, g):
        return self.book.pages[g][2] * self.zoom

    def _page_xy(self, g):
        if self.page_lefts is not None:
            return self.page_lefts[g], self.page_tops[g]
        cw = max(self.canvas.winfo_width(), self.content_w)
        return max(GAP, (cw - self._page_w(g)) / 2), self.page_tops[g]

    def _event_to_page(self, e, clamp_g=None):
        if not self.book or not self.book.total:
            return None
        cx, cy = self.canvas.canvasx(e.x), self.canvas.canvasy(e.y)
        if clamp_g is None and self.page_lefts is not None:
            g = self._grid_hit(cx, cy)
            if g is None:
                return None
            x0, y0 = self._page_xy(g)
            return g, (cx - x0) / self.zoom, (cy - y0) / self.zoom
        g = self._page_at_y(cy) if clamp_g is None else clamp_g
        x0, y0 = self._page_xy(g)
        w, h = self._page_w(g), self._page_h(g)
        if clamp_g is None and not (x0 <= cx <= x0 + w and y0 <= cy <= y0 + h):
            return None
        return g, min(max(cx - x0, 0), w) / self.zoom, min(max(cy - y0, 0), h) / self.zoom

    def _to_canvas(self, g, r):
        x, y = self._page_xy(g)
        z = self.zoom
        return x + r[0] * z, y + r[1] * z, x + r[2] * z, y + r[3] * z

    # =============================================================== drawing
    def redraw(self):
        c = self.canvas
        fs = getattr(self, "_field_save", None)
        if fs and (c.canvasx(0), c.canvasy(0)) != fs[1]:
            self.root.after_idle(fs[0])              # a form field being typed in: the page moved - keep it
        if self.book and self.book.total and len(self.page_tops) != self.book.total:
            return
        c.delete("all")
        if getattr(self, "_bg_photo", None) is not None:
            c.create_image(c.canvasx(0), c.canvasy(0), image=self._bg_photo, anchor="nw", tags="appbg")
        if self._bg_conf().get("effect", "none") != "none":
            self._fx_draw()
        T = self.T
        if not self.book or not self.book.total:
            if getattr(self, "_prescan_token", None) is not None or getattr(self, "_scanning", False):
                return                        # a book is being opened: its progress card is on the screen
            msg = ("Add your first folder.\n\nClick  “+”  next to Library, or drag a folder onto this window.\n"
                   "Your files stay where they are - nothing is copied.")
            lost = self.folder is not None and bool(self.lib.missing.get(self.folder))
            if not self.lib.folders:
                pass
            elif lost and getattr(self, "_moved_busy", False):
                msg = ("This folder can't be found.\n\n" + "\n".join(self.lib.missing[self.folder][:3]) +
                       "\n\nIt was probably moved or renamed - BindLens is looking for it on your computer…")
            elif lost:
                msg = ("This folder can't be found.\n\n" + "\n".join(self.lib.missing[self.folder][:3]) +
                       "\n\nWas it moved or renamed? Show BindLens where it is now -\n"
                       "the book keeps its name, colour, marks and places.")
            else:
                msg = ("This book is empty.\n\nClick  “Add files”, or drag files here.\n"
                       "Files you save into its folder appear when you press F5.")
            tid = c.create_text(c.canvasx(max(c.winfo_width(), 400) / 2), c.canvasy(max(c.winfo_height(), 300) / 2),
                                text=msg, fill=T["muted"], justify="center", font=UI_FONT_L)
            if lost and not getattr(self, "_moved_busy", False):          # 1.9.9: Find it… / Look again
                bb = c.bbox(tid)
                bar = getattr(self, "_lost_bar", None)
                if bar is None or getattr(self, "_lost_bar_theme", None) != (T["canvas"], self.accent):
                    if bar is not None:
                        bar.destroy()
                    bar = tk.Frame(c, bg=T["canvas"])
                    PillButton(bar, self, "Find it…", lambda: self.find_book_folder(), kind="accent",
                               bg_key="canvas").pack(side="left")

                    def again():
                        def said(res):
                            if self.folder is not None and self.lib.missing.get(self.folder):
                                self.set_status("Not found - if you renamed it or moved it far, click “Find it…”.")
                        self._follow_moved(force=True, then=said)
                    PillButton(bar, self, "Look for it again", again, kind="soft", bg_key="canvas").pack(
                        side="left", padx=(10, 0))
                    self._lost_bar, self._lost_bar_theme = bar, (T["canvas"], self.accent)
                if bb:
                    c.create_window((bb[0] + bb[2]) / 2, bb[3] + 22, window=bar, anchor="n")
            self.current_page = 0
            c.delete("ui")
            self._sides_update()
            self.where_lbl.config(text="")
            self._update_toolbar()
            self.map_canvas.delete("marks")
            return
        top = c.canvasy(0)
        bottom = top + c.winfo_height()
        z = self.zoom
        g = self._page_at_y(top - 400)
        needed = []
        cur_hit = self.hits[self.hit_cur] if 0 <= self.hit_cur < len(self.hits) else None
        A = self.accent
        self._wanted, self._visible = set(), set()
        pic_frames = bool(getattr(self, "_reading", False) and self._read_conf().get("pic_frame", True) and
                          self._is_picture_book() and self._bands_on())
        pic_grid = (self._gallery_style() if (self.page_lefts is not None and self._is_picture_book()) else None)
        while g < self._total() and self.page_tops[g] < bottom + 400:
            fi, pi, pw, ph = self.book.pages[g]
            x, y = self._page_xy(g)
            w, h = pw * z, ph * z
            self._wanted.add(g)
            if y < bottom and y + h > top:
                self._visible.add(g)
            f = self.book.files[fi]
            if f["first"] == g and self.page_lefts is not None and pic_grid == "polaroid":
                pass                                   # 4.3: the name is written under the picture, on its card
            elif f["first"] == g and self.page_lefts is not None:
                # 4.2: the grid - the document's name over its first page, cut to fit
                gw = self._grid_span[2] if getattr(self, "_grid_span", None) else w
                nm_ = os.path.splitext(os.path.basename(f["rel"]))[0]
                c.create_text(x, y - self.GRID_CAP / 2 - 1, anchor="w", fill=T["header"], font=UI_FONT_S,
                              text=self._fit_text(nm_ + (f"  ·  {f['count']}" if f["count"] > 1 else ""),
                                                  self._sfont(9), max(30, gw)))
            elif f["first"] == g and pic_frames:
                pass                                   # 4.2: a slideshow - the picture's name is in the top band
            elif f["first"] == g:
                hy = self.header_tops[fi]
                c.create_text(x, hy + HEADER_H / 2, anchor="w", fill=T["header"], font=UI_FONT_B,
                              text=f"{f['rel']}")
                ptxt = f"pages {g + 1}–{g + f['count']}"
                c.create_text(x + w, hy + HEADER_H / 2, anchor="e", fill=T["muted"], font=UI_FONT_S, text=ptxt)
                if os.path.splitext(f["path"])[1].lower() in OFFICE_EXACT and not office_pdf_ready(f["path"]):
                    # 4.0: say it when an Office file is not shown as it looks (yet) - and why
                    why = office_failed_note(f["path"])
                    prog = {"word": "Word", "excel": "Excel", "ppt": "PowerPoint"}.get(office_kind(f["path"]),
                                                                                        "Office")
                    note = (f"Simplified view - {prog} could not show it ({why[:48]}) · click to try again"
                            if why else f"Simplified view - getting it ready as it looks in {prog}…")
                    nx = x + w - self._measure(ptxt, self._sfont(9)) - 18
                    c.create_text(nx, hy + HEADER_H / 2, anchor="e", font=UI_FONT_S,
                                  fill="#B3261E" if why else A, text=self._fit_text(note, self._sfont(9), w * 0.62),
                                  tags=("offnote", f"offfi{fi}"))
                    if not getattr(self, "_offnote_bound", False):
                        self._offnote_bound = True
                        c.tag_bind("offnote", "<Button-1>", self._offnote_click)
                        c.tag_bind("offnote", "<Enter>", lambda e: c.configure(cursor="hand2"))
                        c.tag_bind("offnote", "<Leave>", lambda e: self._set_cursor())
            if pic_grid and pic_grid != "none":           # 4.3: a gallery - each picture in its frame
                self._pic_deco(c, x, y, w, h, pic_grid, os.path.splitext(os.path.basename(f["rel"]))[0])
            else:
                for k, t in ((6, 0.25), (4, 0.5), (2, 0.85)):
                    c.create_rectangle(x - k / 2 + 1, y + k / 2, x + w + k / 2 + 1, y + h + k, outline="",
                                       fill=mix(T["canvas"], T["page_shadow"], t))
            key = (g, round(z, 4))
            img = self.cache.get(key)
            failed = self.__dict__.get("_failed", {}).get(g)
            if img is not None:
                self.cache.move_to_end(key)
                c.create_image(x, y, anchor="nw", image=img)
                if pic_frames and g == self.current_page:
                    self._pic_frame(c, x, y, w, h)
            elif failed is not None:
                self._draw_failed_page(c, g, x, y, w, h, failed)
            else:
                c.create_rectangle(x, y, x + w, y + h, fill="white", outline="")
                if g in self._visible:                    # 1.9.2: a calm page shape while it is drawn
                    sk = "#EEF0F4"
                    m_ = max(18, w * 0.09)
                    yy = y + max(24, h * 0.07)
                    k_ = 0
                    while yy < y + h - m_ and k_ < 26:
                        ww = (w - 2 * m_) * (0.55 if k_ % 7 == 0 else (0.72 if k_ % 5 == 3 else 0.94))
                        c.create_rectangle(x + m_, yy, x + m_ + ww, yy + max(3, h * 0.008), fill=sk, outline="")
                        yy += max(12, h * 0.035) * (1.8 if k_ % 7 == 6 else 1)
                        k_ += 1
                    c.create_text(x + w / 2, y + h / 2, text="…", font=self.F(18, "bold"), fill="#C9CDD6")
                needed.append(g)
            if self.sel and self.sel["g"] == g:
                for r in self.sel["rects"]:
                    kw = dict(fill="#64B5F6", outline="", stipple="gray50")
                    if sys.platform == "darwin":
                        kw = dict(outline="#64B5F6", width=2)
                    c.create_rectangle(*self._to_canvas(g, r), **kw)
            if cur_hit and cur_hit[0] == g:
                a, b, cc, d = self._to_canvas(g, cur_hit[1])
                c.create_rectangle(a - 3, b - 3, cc + 3, d + 3, outline=A, width=2)
            if self.sel_annot and self.sel_annot[0] == g:
                m = self._mark(*self.sel_annot)
                if m:
                    a, b, cc, d = self._to_canvas(g, m["bbox"])
                    c.create_rectangle(a - 4, b - 4, cc + 4, d + 4, outline=A, width=2, dash=(4, 3))
                    if m["kind"] in self.RESIZABLE:
                        c.create_rectangle(cc, d, cc + 9, d + 9, fill=A, outline="white")
                    if m.get("card") and m["card"].get("kind") != "watermark":
                        hx, hy = (a + cc) / 2, b - 26
                        c.create_line(hx, b - 4, hx, hy + 7, fill=A, width=1.5)
                        c.create_oval(hx - 7, hy - 7, hx + 7, hy + 7, fill="white", outline=A, width=2)
                        c.create_arc(hx - 4, hy - 4, hx + 4, hy + 4, start=40, extent=260, style="arc",
                                     outline=A, width=1.5)
            if self.flash and self.flash[0] == g:
                a, b, cc, d = self._to_canvas(g, self.flash[1])
                c.create_rectangle(a - 5, b - 5, cc + 5, d + 5, outline=A, width=3)
            g += 1
        needed.sort(key=lambda p: (not (self.page_tops[p] < bottom and self.page_tops[p] + self._page_h(p) > top), p))
        self._queue = needed
        if needed and self.render_job is None:
            self.render_job = self.root.after(1, self._render_next)
        self._update_current()
        self._draw_overlay()
        self._sides_update()
        if getattr(self, "_ed", None):
            self._place_box_editor()
        try:
            self._stage_sync()                          # 4.3: pictures one at a time while reading
        except Exception as ex:
            _log(f"stage: {ex}")

    def _render_page(self, g):
        fi, pi, pw, ph = self.book.pages[g]
        z = self.zoom
        page = self.book.doc(fi).load_page(pi)
        pix = page.get_pixmap(matrix=self.fitz.Matrix(z, z), alpha=False)
        if pix.n != 3:
            pix = self.fitz.Pixmap(self.fitz.csRGB, pix)
        tone = self._page_tone()
        if tone == "warm":
            pix.tint_with(0x2A2118, 0xF7EFDD)
        elif tone:
            pix.invert_irect(pix.irect)
        hits = self.hits_by_g.get(g)
        if not hits:
            return tk.PhotoImage(data=pix.tobytes("ppm"))
        w, h, stride = pix.width, pix.height, pix.stride
        buf = bytearray(pix.samples)
        rgb = (255, 225, 140) if not self.lib.settings.get("night_pages") else (120, 90, 20)
        for r in hits:
            blend_rect(buf, stride, w, h, r[0] * z, (r[1] - 0.5) * z, r[2] * z, (r[3] + 0.5) * z, rgb)
        if stride != w * 3:
            buf = b"".join(bytes(buf[i * stride:i * stride + w * 3]) for i in range(h))
        return tk.PhotoImage(data=b"P6\n%d %d\n255\n" % (w, h) + bytes(buf))

    def _page_photo(self, g, w, h, rgb):
        """A page picture from raw RGB (from a helper), with this book's search hits painted on it."""
        hits = self.hits_by_g.get(g)
        if hits:
            z = self.zoom
            buf = bytearray(rgb)
            col = (255, 225, 140) if not self.lib.settings.get("night_pages") else (120, 90, 20)
            for r in hits:
                blend_rect(buf, w * 3, w, h, r[0] * z, (r[1] - 0.5) * z, r[2] * z, (r[3] + 0.5) * z, col)
            rgb = bytes(buf)
        return tk.PhotoImage(data=b"P6\n%d %d\n255\n" % (w, h) + rgb)

    def _rendered(self, book, key, fi, ver, res):
        if self.book is not book or self._rendering.get(key) is None:
            return
        self._rendering.pop(key, None)
        f = book.files[fi]
        if f.get("ver", 0) != ver or res.get("cancelled"):
            if not getattr(self, "_redraw_soon", None):    # the page changed meanwhile: ask again
                self._redraw_soon = self.root.after(8, self._redraw_after_render)
            return
        if res.get("fallback"):
            f["no_helper"] = True                 # this file is drawn here from now on
            self._queue.insert(0, key[0])
            if self.render_job is None:
                self.render_job = self.root.after(1, self._render_next)
            return
        g = key[0]
        img, err = None, res.get("err")
        if "rgb" in res:
            try:
                img = self._page_photo(g, res["w"], res["h"], res["rgb"])
            except Exception as ex:
                err = str(ex) or ex.__class__.__name__
        if img is None:
            # 4.2: never an empty (see-through = dark) picture: the page is tried once more here, in the window;
            # if that fails too it shows white, with why and how to open it (it was the 'black page')
            if not f.get("no_helper"):
                f["no_helper"] = True
                _log(f"page via helper failed, trying here: {f['rel']} p.{book.pages[g][1] + 1}: {err}")
                self._queue.insert(0, g)
                if self.render_job is None:
                    self.render_job = self.root.after(1, self._render_next)
                return
            self._page_failed(g, err)
            return
        self.cache[key] = img
        while len(self.cache) > CACHE_MAX:
            self.cache.popitem(last=False)
        if not getattr(self, "_redraw_soon", None):        # several pages arrive together: draw once
            self._redraw_soon = self.root.after(8, self._redraw_after_render)
        if g in getattr(self, "_visible", ()) and f["doc"] is None and "rgb" in res:
            book.prefetch(fi)                     # you may click on it: have its bytes ready

    def _preview_dir(self):
        d = getattr(self, "_prev_dir", None)
        if d is None:
            d = os.path.join(self.lib.meta_dir, "previews")
            try:
                os.makedirs(d, exist_ok=True)
            except Exception:
                return None
            self._prev_dir = d
            threading.Thread(target=self._preview_trim, daemon=True).start()
        return d

    def _preview_trim(self, keep=260):
        """Only the newest pictures are kept (about 40 MB at most)."""
        try:
            d = self._prev_dir
            fs = [os.path.join(d, n) for n in os.listdir(d) if n.endswith(".png")]
            if len(fs) > keep:
                fs.sort(key=lambda p_: os.path.getmtime(p_))
                for p_ in fs[:len(fs) - keep]:
                    os.remove(p_)
        except Exception:
            pass

    def _preview_path(self, f, pi, z, night):
        """Where the picture of a page (at this zoom) is kept - it changes when the file changes."""
        d = self._preview_dir()
        if not d:
            return None
        try:
            st_ = os.stat(f["path"])
        except OSError:
            return None
        import hashlib
        tone = night if isinstance(night, str) else int(bool(night))
        k = f"{self.lib.norm(f['path'])}|{st_.st_mtime_ns}|{st_.st_size}|{pi}|{z:.4f}|{tone}"
        return os.path.join(d, hashlib.sha1(k.encode("utf-8")).hexdigest()[:20] + ".png")

    def _redraw_after_render(self):
        self._redraw_soon = None
        if self.book:
            self.redraw()

    def _render_next(self):
        self.render_job = None
        if not self.book:
            return
        book = self.book
        z = round(self.zoom, 4)
        night = self._page_tone()
        while self._queue:
            g = self._queue.pop(0)
            key = (g, z)
            if key in self.cache or key in self._rendering:
                continue
            fi, pi = book.pages[g][0], book.pages[g][1]
            f = book.files[fi]
            vis = g in getattr(self, "_visible", ())
            prev = self._preview_path(f, pi, z, night) if vis and not self.hits_by_g.get(g) and \
                fi not in book.keep and self.writer.get(f["path"]) is None else None
            if prev and os.path.exists(prev):
                try:                              # 1.9.2: drawn before - it shows at once
                    img = tk.PhotoImage(file=prev)
                    _, _, pw, ph = book.pages[g]
                    if abs(img.width() - pw * z) <= 2 and abs(img.height() - ph * z) <= 2:
                        self.cache[key] = img
                        while len(self.cache) > CACHE_MAX:
                            self.cache.popitem(last=False)
                        if not getattr(self, "_redraw_soon", None):
                            self._redraw_soon = self.root.after(4, self._redraw_after_render)
                        continue
                except Exception:
                    pass
            if not self.pool.disabled and not f.get("no_helper") and fi not in book.keep and \
                    self.writer.get(f["path"]) is None:
                # drawn by a helper: the window never waits for a big page
                ver = f.get("ver", 0)
                self._rendering[key] = self.pool.submit(
                    "render", prio=0 if vis else 1, timeout=120, path=f["path"],
                    pi=pi, zoom=z, night=night, save=prev,
                    cancel=lambda key=key: (self.book is not book or self._rendering.get(key) is None or
                                            key[0] not in self._wanted or key[1] != round(self.zoom, 4)),
                    cb=lambda res, key=key, fi=fi, ver=ver: self._rendered(book, key, fi, ver, res))
                if vis:                           # 4.2: a slow file says so (it looked like an empty page)
                    self.root.after(1800, lambda key=key, f=f: self._slow_note(key, f))
                continue
            if g in self.__dict__.setdefault("_failed", {}):
                continue
            t0_ = time.time()
            try:
                img = self._render_page(g)
            except Exception as ex:
                self._page_failed(g, str(ex) or ex.__class__.__name__)
                continue
            if time.time() - t0_ > 2.5:
                _log(f"slow page ({time.time() - t0_:.1f} s): {f['rel']} p.{pi + 1}")
            self.cache[key] = img
            while len(self.cache) > CACHE_MAX:
                self.cache.popitem(last=False)
            self.redraw()
            return

    def _slow_note(self, key, f):
        if self._rendering.get(key) is not None and key[1] == round(self.zoom, 4):
            ext = os.path.splitext(f["path"])[1].lower()
            why = (" - Office files are read slowly until their exact copy is ready" if ext in OFFICE_EXACT
                   else " - a big page, one moment")
            self.set_status(f"Reading {os.path.basename(f['path'])}…{why}")

    def _page_failed(self, g, err):
        """4.2: a page that could not be drawn: written down (with why) and shown as a white page that says so."""
        fl = self.__dict__.setdefault("_failed", {})
        if g in fl:
            return
        fl[g] = str(err or "it could not be drawn")[:160]
        try:
            fi, pi = self.book.pages[g][0], self.book.pages[g][1]
            _log(f"page not shown: {self.book.files[fi]['rel']} p.{pi + 1}: {fl[g]}")
        except Exception:
            pass
        if not getattr(self, "_redraw_soon", None):
            self._redraw_soon = self.root.after(8, self._redraw_after_render)

    def _draw_failed_page(self, c, g, x, y, w, h, why):
        """A white page with a calm card: this page can't be shown here - why - open it in its own program /
        try again. Never a black or empty page."""
        c.create_rectangle(x, y, x + w, y + h, fill="white", outline="")
        cx, cy = x + w / 2, y + min(h / 2, 220)
        bw = min(w - 30, 420)
        if bw < 120:
            c.create_text(cx, cy, text="!", font=self.F(16, "bold"), fill="#B3261E")
            return
        round_rect(c, cx - bw / 2, cy - 64, cx + bw / 2, cy + 70, 14, fill="#F6F5FA", outline="#E2E0EA")
        c.create_text(cx, cy - 38, text="This page can't be shown here", font=self.F(11, "bold"), fill="#1E1E28")
        c.create_text(cx, cy - 14, text=self._fit_text(why, self._sfont(9), bw - 30), font=self.F(9),
                      fill="#5E5E6B")
        tag = f"failopen{g}"
        c.create_text(cx - 70, cy + 22, text="Open in its own program", font=self.F(9, "bold"),
                      fill=self.accent, tags=(tag, "failbtn"))
        tag2 = f"failretry{g}"
        c.create_text(cx + 90, cy + 22, text="Try again", font=self.F(9, "bold"), fill=self.accent,
                      tags=(tag2, "failbtn"))
        c.create_text(cx, cy + 50, text="Written down in the error log (Help > What BindLens is doing)",
                      font=self.F(8), fill="#8A8798")
        fi = self.book.pages[g][0]
        c.tag_bind(tag, "<Button-1>", lambda e, fi=fi: self._open_outside(self.book.files[fi]["path"]))
        c.tag_bind(tag2, "<Button-1>", lambda e, g=g: self._failed_retry(g))
        c.tag_bind("failbtn", "<Enter>", lambda e: c.configure(cursor="hand2"))
        c.tag_bind("failbtn", "<Leave>", lambda e: self._set_cursor())

    def _failed_retry(self, g):
        fl = self.__dict__.setdefault("_failed", {})
        if self.book and g < self.book.total:
            fi = self.book.pages[g][0]
            f = self.book.files[fi]
            for g_ in range(f["first"], f["first"] + f["count"]):
                fl.pop(g_, None)
            f.pop("no_helper", None)
            self.book.reopen(fi)
        self.redraw()

    def _open_outside(self, path):
        try:
            if os.name == "nt":
                os.startfile(path)
            elif sys.platform == "darwin":
                subprocess.Popen(["open", path])
            else:
                subprocess.Popen(["xdg-open", path])
        except Exception as ex:
            messagebox.showerror(APP_NAME, f"Could not open it:\n{ex}")

    def _invalidate_file(self, fi):
        f = self.book.files[fi]
        f["ver"] = f.get("ver", 0) + 1             # pictures still being drawn for it are thrown away
        self.__dict__.setdefault("_failed", {})
        for g_ in range(f["first"], f["first"] + f["count"]):
            self._failed.pop(g_, None)
        pages = set(range(f["first"], f["first"] + f["count"]))
        for k in [k for k in self.cache if k[0] in pages]:
            del self.cache[k]
        for k in [k for k in self._rendering if k[0] in pages]:
            del self._rendering[k]
        for g in pages:
            self.words_cache.pop(g, None)

    def _invalidate(self, g):
        if self.book and g < self.book.total:
            f = self.book.files[self.book.pages[g][0]]
            f["ver"] = f.get("ver", 0) + 1
        for k in [k for k in self.cache if k[0] == g]:
            del self.cache[k]
        for k in [k for k in self._rendering if k[0] == g]:
            del self._rendering[k]

    # ============================================================ navigation
    # ---- 3.0: Back / Forward (Alt+← / Alt+→) after a jump - from the map, a search result, a report, Ctrl+K…
    def _nav_push(self):
        if getattr(self, "_nav_quiet", False) or self.folder is None or not self.book or not self.book.total:
            return
        st = (self.folder, self.prefix or "", self.current_page)
        b = self.__dict__.setdefault("_nav_back", [])
        if b and b[-1] == st:
            return
        b.append(st)
        del b[:-50]
        self._nav_fwd = []
        if not getattr(self, "_nav_told", False):
            self._nav_told = True
            self.root.after(400, lambda: self.set_status("Alt+←  takes you back to where you were  ·  Alt+→  "
                                                         "forward again"))

    def nav_back(self, fwd=False):
        src = self.__dict__.setdefault("_nav_fwd" if fwd else "_nav_back", [])
        dst = self.__dict__.setdefault("_nav_back" if fwd else "_nav_fwd", [])
        while src and src[-1][0] not in self.lib.folders:
            src.pop()
        if not src:
            self.set_status("Nothing to go forward to." if fwd else "Nothing to go back to.")
            return
        if self.folder is not None and self.book and self.book.total:
            dst.append((self.folder, self.prefix or "", self.current_page))
        f, p, g = src.pop()
        self._nav_quiet = True

        def there():
            self.goto_page(g)
            self._nav_quiet = False
        self.root.after(4000, lambda: setattr(self, "_nav_quiet", False))
        if f != self.folder or p != (self.prefix or "") or self.book is None:
            self.open_folder(f, p, then=there)
        else:
            there()
        self.set_status(("Forward" if fwd else "Back") + f" - {self.lib.label(f)}, page {g + 1}.")

    def goto_page(self, g, frac=0.0):
        if not self.book or not self.book.total:
            return
        g = max(0, min(self._total() - 1, int(g)))
        if abs(g - self.current_page) > 1:
            self._nav_push()
        y = self.page_tops[g] - GAP / 2 + frac * self._page_h(g)
        fi = self.book.pages[g][0]
        if self.book.files[fi]["first"] == g and frac == 0:
            y = self.header_tops[fi] - GAP / 2
        self._scroll_to_y(y - self._top_pad())             # (reading mode: below its bar)
        self.current_page = g
        self.redraw()

    def _show_spot(self, g, rect):
        y = self.page_tops[g] + rect[1] * self.zoom - self.canvas.winfo_height() * 0.33
        self._scroll_to_y(y)
        self.redraw()

    def _scroll_to_y(self, y):
        self.canvas.yview_moveto(max(0.0, y) / max(self.total_h, 1))

    def _update_current(self):
        if not self.book or not self.book.total:
            self.where_lbl.config(text="")
            self._update_toolbar()
            return
        top = self.canvas.canvasy(0)
        g = self._page_at_y(top + self.canvas.winfo_height() * 0.35)
        self.current_page = g
        self._update_toolbar()
        fi = self.book.pages[g][0]
        f = self.book.files[fi]
        if fi != getattr(self, "_last_fi_x", fi) and len(self.page_tops) == self.book.total:
            self.root.after_idle(lambda g=g: self._center_x(g))     # 4.1: a new document: its page in the middle
        self._last_fi_x = fi
        if getattr(self, "_title_fi", None) != (id(self.book), fi):
            self._title_fi = (id(self.book), fi)               # 4.1: the title bar says the document you are in
            try:
                self.root.title(f"{os.path.basename(f['rel'])}  ·  {self.lib.label(self.folder)} - {APP_NAME}")
                self._tb_info = f"{os.path.splitext(os.path.basename(f['rel']))[0]}  ·  {self.lib.label(self.folder)}"
                self._topband_draw()                       # 4.1: the document, in the frame's top row too
            except Exception:
                pass
        sel = self.files_tree.selection()
        if not sel or sel[0] != str(fi):
            if self.files_tree.exists(str(fi)):
                self.files_tree.selection_set(str(fi))
                self.files_tree.see(str(fi))
        self.where_lbl.config(text=f"{f['rel']}  ·  page {g - f['first'] + 1} of {f['count']}")
        if self.fullscreen:
            self.fs_label.config(text=f"{g + 1} / {self._total()}")
        self._track_recent(f, g - f["first"])
        self._schedule_save()

    def _track_recent(self, f, pi):
        """3.0: the documents you read lately (for Home: 'Continue' and 'Recent documents')."""
        if self.folder is None:
            return
        rec = self.lib.settings.setdefault("recent_docs", [])
        key = (self.folder, f["rel"])
        if rec and (rec[0].get("f"), rec[0].get("rel")) == key:
            rec[0]["p"], rec[0]["t"] = pi, time.time()
            return
        rec[:] = [{"f": self.folder, "rel": f["rel"], "p": pi, "t": time.time(), "n": f.get("count", 0)}] + \
            [x for x in rec if (x.get("f"), x.get("rel")) != key][:11]

    def _update_toolbar(self):
        pass

    # ---- 3.0: Pages - every page of the book as a little picture (find a page by its look, jump there) ------------
    THUMB_SIZES = {"S": 110, "M": 160, "L": 230}

    def pages_overview(self, _e=None, size=None):
        """F4 (or the grid button on the page bar): all the pages of the book in a grid - documents one after
        another, the page you are on marked, pages with your marks and pages you added shown - click to go."""
        if getattr(self, "_pv", None) is not None:
            return self.close_pages()
        if getattr(self, "_home", None) is not None:
            self.close_home()
        if not self.book or not self.book.total:
            self.set_status("Open a book first - then F4 shows all its pages.")
            return
        T, A = self.T, self.accent
        ov = tk.Frame(self.view, bg=T["canvas"])
        ov.place(x=0, y=0, relwidth=1, relheight=1)
        tk.Misc.tkraise(ov)
        head = tk.Frame(ov, bg=T["canvas"])
        head.pack(fill="x", padx=22, pady=(14, 6))
        tk.Label(head, text="Pages", font=self.F(15, "bold"), bg=T["canvas"], fg=T["text"]).pack(side="left")
        tk.Label(head, text=f"{self.lib.label(self.folder)}  ·  {len(self.book.files)} document"
                            f"{'s' if len(self.book.files) != 1 else ''}  ·  {self.book.total} pages",
                 font=self.F(9), bg=T["canvas"], fg=T["muted"]).pack(side="left", padx=(12, 0), pady=(5, 0))
        PillButton(head, self, "Close  (Esc)", self.close_pages, kind="ghost", bg_key="canvas").pack(side="right")
        size = size or self.lib.settings.get("thumb_size", "M")
        seg = tk.Frame(head, bg=T["canvas"])
        seg.pack(side="right", padx=12)
        for k_, lab in (("S", "Small"), ("M", "Medium"), ("L", "Large")):
            on = k_ == size
            lb = tk.Label(seg, text=lab, font=self.F(9), padx=10, pady=3, cursor="hand2",
                          bg=mix(T["canvas"], A, 0.2) if on else T["chip"], fg=A if on else T["text"])
            lb.pack(side="left", padx=1)
            lb.bind("<Button-1>", lambda e, k_=k_: self._pages_size(k_))
        body = tk.Frame(ov, bg=T["canvas"])
        body.pack(fill="both", expand=True, padx=(16, 6), pady=(0, 10))
        if len(self.book.files) > 1:
            self._pages_jumplist(body)                      # 4.1: go straight to a document or a sub-folder
        cv = tk.Canvas(body, bg=T["canvas"], highlightthickness=0, bd=0, yscrollincrement=1, takefocus=1)
        cv.pack(side="left", fill="both", expand=True)
        ScrollRail(body, self, cv, bg=T["canvas"]).pack(side="left", fill="y", padx=(4, 0))
        self._pv = {"ov": ov, "cv": cv, "size": size, "cells": [], "hover": None, "sel": self.current_page,
                    "w": 0, "job": None}
        self._thumbs = getattr(self, "_thumbs", None) or OrderedDict()
        cv.bind("<Configure>", lambda e: self._pages_layout() if abs(e.width - self._pv["w"]) > 8 else None)
        cv.bind("<Motion>", self._pages_motion)
        cv.bind("<Leave>", lambda e: self._pages_hover(None))
        cv.bind("<Button-1>", self._pages_click)
        cv.bind("<Double-Button-1>", self._pages_click)

        def wheel(e):
            if e.state & 0x0004:                            # 4.1: Ctrl + wheel - smaller / bigger, then the page
                up = getattr(e, "delta", 0) > 0 or getattr(e, "num", 0) == 4
                now = time.time()
                if now - self.__dict__.get("_pv_zoom_t", 0) > 0.35:
                    self._pv_zoom_t = now
                    self.change_zoom(1.2 if up else 1 / 1.2)
                return "break"
            d = -e.delta / 120.0 * 150 if getattr(e, "num", 0) not in (4, 5) else (-150 if e.num == 4 else 150)
            cv.yview_scroll(int(d), "units")
            self._pages_visible()
        for seq in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            cv.bind(seq, wheel)
        for k_, fn in (("<Escape>", lambda e: self.close_pages()), ("<Return>", lambda e: self._pages_go()),
                       ("<Left>", lambda e: self._pages_move(-1)), ("<Right>", lambda e: self._pages_move(1)),
                       ("<Up>", lambda e: self._pages_move(-self._pv.get("cols", 1))),
                       ("<Down>", lambda e: self._pages_move(self._pv.get("cols", 1))),
                       ("<F4>", lambda e: self.close_pages())):
            cv.bind(k_, fn)
        cv.focus_set()
        self.root.after(30, self._pages_layout)
        self.root.after(300, self._pages_tick)

    def _pages_tick(self):
        """While the pages are shown: when they were scrolled (bar, keys), the new pictures are asked for."""
        pv = self._pv
        if pv is None:
            return
        try:
            y = pv["cv"].canvasy(0)
            if y != pv.get("last_y"):
                pv["last_y"] = y
                self._pages_visible()
        except Exception:
            return
        self.root.after(250, self._pages_tick)

    def close_pages(self, _e=None):
        pv = getattr(self, "_pv", None)
        if pv is None:
            return
        self._pv = None
        try:
            pv["ov"].destroy()
        except Exception:
            pass
        try:
            self.canvas.focus_set()
        except Exception:
            pass

    def _pages_size(self, k_):
        self.lib.settings["thumb_size"] = k_
        self.lib.save_meta()
        sel = self._pv["sel"] if self._pv else self.current_page
        self.close_pages()
        self.pages_overview(size=k_)
        if self._pv:
            self._pv["sel"] = sel

    _COPY_RE = re.compile(r"^(.*?)(?:\s*-\s*(?:copia|copy|kopie|copie)(?:\s*\(\d+\))?|\s*\(\d+\)|\s+copy\s*\d*)$",
                          re.I)

    def _pages_jumplist(self, body):
        """4.1: the documents of the book, by sub-folder, beside the grid - click one to go to its pages.
        4.2: one clear line per document (cut with … - never written over the next one), a coloured dot for its
        kind, its pages in a small pill, copies marked, folders that fold, and a box to find a document."""
        T, A = self.T, self.accent
        box = tk.Frame(body, bg=T["canvas"], width=262)
        box.pack(side="left", fill="y", padx=(0, 12))
        box.pack_propagate(False)
        tk.Label(box, text="GO TO", font=self.F(8, "bold"), bg=T["canvas"], fg=T["muted"]).pack(anchor="w",
                                                                                               pady=(4, 4))
        q = tk.StringVar()
        ent = tk.Entry(box, textvariable=q, font=self.F(9), relief="flat", bd=0, bg=T["chip"], fg=T["text"],
                       insertbackground=T["text"], highlightthickness=1, highlightbackground=T["border"],
                       highlightcolor=A)
        ent.pack(fill="x", pady=(0, 8), ipady=4)
        hint = "Find a document…"
        ent.insert(0, hint)
        ent.configure(fg=T["muted"])

        def ent_in(_e=None):
            if ent.get() == hint:
                ent.delete(0, "end")
                ent.configure(fg=T["text"])

        def ent_out(_e=None):
            if not ent.get():
                ent.insert(0, hint)
                ent.configure(fg=T["muted"])
        ent.bind("<FocusIn>", ent_in)
        ent.bind("<FocusOut>", ent_out)
        lc = tk.Canvas(box, bg=T["canvas"], highlightthickness=0, bd=0, cursor="hand2")
        bar = SlimBar(box, self, lc, width=10)
        bar.pack(side="right", fill="y")
        lc.pack(side="left", fill="both", expand=True)
        lc.configure(yscrollcommand=bar.set)
        fnt, fntb, fnts = self._sfont(9), self._sfont(9, "bold"), self._sfont(8)
        rh = max(22, fnt.metrics("linespace") + 9)            # from the real font: rows never overlap
        names = {}
        for fi, f in enumerate(self.book.files):
            names[fi] = os.path.splitext(os.path.basename(f["rel"]))[0]
        bases = {n.lower() for n in names.values()}
        kinds = {".pdf": "#E5484D", ".doc": "#2F6FEB", ".docx": "#2F6FEB", ".odt": "#2F6FEB", ".rtf": "#2F6FEB",
                 ".xls": "#1E9E5A", ".xlsx": "#1E9E5A", ".csv": "#1E9E5A", ".ods": "#1E9E5A",
                 ".ppt": "#E8772E", ".pptx": "#E8772E", ".jpg": "#8E5CE6", ".jpeg": "#8E5CE6", ".png": "#8E5CE6",
                 ".heic": "#8E5CE6", ".webp": "#8E5CE6", ".gif": "#8E5CE6", ".tif": "#8E5CE6", ".tiff": "#8E5CE6"}
        folded = self.__dict__.setdefault("_jl_folded", set())
        st = {"rows": [], "cur": None}

        def cur_fi():
            try:
                pv = self._pv
                g = pv.get("sel") if pv else None
                g = self.current_page if g is None else g
                return self.book.pages[g][0]
            except Exception:
                return None

        def fill():
            lc.delete("all")
            rows, y, last_dir = [], 2, None
            want = q.get().strip().lower()
            if want == hint.lower():
                want = ""
            W = max(160, lc.winfo_width() or 236)
            cfi = cur_fi()
            for fi, f in enumerate(self.book.files):
                d_ = os.path.dirname(f["rel"]).replace("\\", "/")
                nm = names[fi]
                if want and want not in nm.lower() and want not in d_.lower():
                    continue
                if d_ != last_dir and (d_ or last_dir is not None):
                    last_dir = d_
                    lab = d_.split("/")[-1] if d_ else self.lib.label(self.folder)
                    shut = d_ in folded and not want
                    lc.create_text(4, y + rh / 2, text=("▸ " if shut else "▾ ") +
                                   self._fit_text(lab, fntb, W - 24), anchor="w", font=fntb, fill=T["text"])
                    rows.append((y, y + rh, "dir", d_))
                    y += rh + 2
                if d_ in folded and not want:
                    continue
                if fi == cfi:
                    lc.create_rectangle(0, y, W, y + rh, fill=mix(T["canvas"], A, 0.18), outline="")
                    lc.create_rectangle(0, y + 3, 3, y + rh - 3, fill=A, outline="")
                ext = os.path.splitext(f["rel"])[1].lower()
                cx = 14
                lc.create_oval(cx - 3.5, y + rh / 2 - 3.5, cx + 3.5, y + rh / 2 + 3.5,
                               fill=kinds.get(ext, "#8A8798"), outline="")
                cnt = str(f["count"])
                pill_w = fnts.measure(cnt) + 12
                m_ = self._COPY_RE.match(nm)
                is_copy = bool(m_ and m_.group(1).strip().lower() in bases)
                badge_w = (fnts.measure("copy") + 12) if is_copy else 0
                tw = W - 26 - pill_w - 8 - (badge_w + 4 if is_copy else 0)
                lc.create_text(24, y + rh / 2, text=self._fit_text(nm, fnt, tw), anchor="w", font=fnt,
                               fill=T["text"] if fi == cfi else T["muted"])
                px1 = W - 4
                round_rect(lc, px1 - pill_w, y + rh / 2 - 8, px1, y + rh / 2 + 8, 8, fill=T["chip"], outline="")
                lc.create_text(px1 - pill_w / 2, y + rh / 2, text=cnt, font=fnts, fill=T["muted"])
                if is_copy:
                    bx1 = px1 - pill_w - 4
                    round_rect(lc, bx1 - badge_w, y + rh / 2 - 8, bx1, y + rh / 2 + 8, 8,
                               fill=mix(T["canvas"], "#E8772E", 0.22), outline="")
                    lc.create_text(bx1 - badge_w / 2, y + rh / 2, text="copy", font=fnts, fill="#B45309")
                rows.append((y, y + rh, "doc", fi))
                y += rh + 1
            if not rows:
                lc.create_text(6, 14, text="No document with that name", anchor="w", font=fnt, fill=T["muted"])
            lc.configure(scrollregion=(0, 0, W, y + 4))
            st["rows"] = rows
        fill()
        lc.bind("<Configure>", lambda e: fill(), add="+")
        q.trace_add("write", lambda *a: fill())

        def at(e):
            yy = lc.canvasy(e.y)
            return next((r for r in st["rows"] if r[0] <= yy <= r[1]), None)

        def motion(e):
            r = at(e)
            lc.delete("hov")
            if r:
                lc.create_rectangle(0, r[0], lc.winfo_width(), r[1], fill=mix(T["canvas"], A, 0.1), outline="",
                                    tags="hov")
                lc.tag_lower("hov")
                if r[2] == "doc":
                    f = self.book.files[r[3]]
                    self.set_status(f"{f['rel']}  ·  {f['count']} page{'s' if f['count'] != 1 else ''}  ·  "
                                    f"click to go there")
        def click(e):
            r = at(e)
            pv = self._pv
            if not r or pv is None:
                return
            if r[2] == "dir":
                if r[3] in folded:
                    folded.discard(r[3])
                else:
                    folded.add(r[3])
                fill()
                return
            g = self.book.files[r[3]]["first"]
            pv["sel"] = g
            cell = next((c_ for c_ in pv["cells"] if c_[1] == g), None)
            if cell:
                pv["cv"].yview_moveto(max(0, cell[3] - 12) / max(1.0, pv.get("height", 1)))
                self._pages_draw()
                self._pages_visible()
            fill()
        lc.bind("<Motion>", motion)
        lc.bind("<Leave>", lambda e: lc.delete("hov"))
        lc.bind("<Button-1>", click)
        for seq in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            lc.bind(seq, lambda e: lc.yview_scroll(-2 if (getattr(e, "delta", 0) > 0 or getattr(e, "num", 0) == 4)
                                                   else 2, "units"))

    def _pages_layout(self):
        """Where each page goes: one grid, left to right; the first page of each document carries its name."""
        pv = self._pv
        if pv is None or not self.book:
            return
        cv = pv["cv"]
        W = max(300, cv.winfo_width())
        pv["w"] = W
        TW = self.THUMB_SIZES.get(pv["size"], 160)
        gap, lab = 20, 36
        cols = max(1, int((W - gap) // (TW + gap)))
        pv["cols"] = cols
        x0 = (W - (cols * (TW + gap) - gap)) / 2
        cells, y, col, rowh = [], 10, 0, 0
        for g in range(self.book.total):
            fi, pi, pw, ph = self.book.pages[g]
            th = min(TW * ph / max(1.0, pw), TW * 1.6)
            cells.append(("page", g, x0 + col * (TW + gap), y, TW, th))
            rowh = max(rowh, th)
            col += 1
            if col >= cols:
                col = 0
                y += rowh + lab + gap
                rowh = 0
        if col:
            y += rowh + lab + gap
        pv["cells"] = cells
        pv["height"] = y + 20
        cv.configure(scrollregion=(0, 0, W, y + 20))
        self._pages_draw()
        # the page you are on: in view
        cell = next((c_ for c_ in cells if c_[1] == pv["sel"]), None)
        if cell:
            top = max(0, cell[3] - cv.winfo_height() / 3)
            cv.yview_moveto(top / max(1.0, y + 20))
        self._pages_visible()

    def _pages_draw(self):
        pv = self._pv
        if pv is None:
            return
        T, A = self.T, self.accent
        cv = pv["cv"]
        cv.delete("all")
        marks = self.marks_by_g or {}
        added = getattr(self, "added_by_g", {}) or {}
        f9b, f9 = self._sfont(9, "bold"), self._sfont(9)
        for _k, g, x, y, tw, th in pv["cells"]:
            fi, pi, _pw, _ph = self.book.pages[g]
            f = self.book.files[fi]
            cur = g == self.current_page
            sel = g == pv["sel"]
            hov = g == pv["hover"]
            if cur or sel or hov:
                round_rect(cv, x - 6, y - 6, x + tw + 6, y + th + 34, 9,
                           fill=mix(T["canvas"], A, 0.2 if (cur or sel) else 0.09), outline="")
            first = pi == 0
            if first and len(self.book.files) > 1:      # a new document starts: a little coloured tab on it
                cv.create_rectangle(x, y - 4, x + min(tw, 40), y - 1, fill=A, outline="")
            cv.create_rectangle(x + 2, y + 3, x + tw + 2, y + th + 3, fill=mix(T["canvas"], "#000000", 0.12),
                                outline="")
            cv.create_rectangle(x, y, x + tw, y + th, fill="#FFFFFF",
                                outline=A if cur else mix(T["canvas"], T["border"], 0.9), width=2 if cur else 1,
                                tags=f"p{g}")
            im = self._thumb_img(g, tw)
            if im is not None:
                cv.create_image(x, y, image=im, anchor="nw", tags=f"i{g}")
            if g in added:
                cv.create_rectangle(x, y, x + 5, y + th, fill="#22B573", outline="")
            if marks.get(g):
                n = len(marks[g])
                cv.create_oval(x + tw - 20, y + 4, x + tw - 4, y + 20, fill=A, outline="#FFFFFF")
                cv.create_text(x + tw - 12, y + 12, text=str(min(n, 9)), font=self.F(7, "bold"), fill="#FFFFFF")
            num = str(g + 1)
            cv.create_text(x + tw, y + th + 11, text=num, anchor="e", font=self.F(9, "bold" if cur else "normal"),
                           fill=A if cur else T["muted"])
            room = tw - self._measure(num, f9) - 8
            if first:
                name = self._fit_text(os.path.splitext(os.path.basename(f["rel"]))[0], f9b, room)
                cv.create_text(x, y + th + 11, text=name, anchor="w", font=self.F(9, "bold"), fill=T["text"])
                if f["count"] > 1:
                    cv.create_text(x, y + th + 26, text=f"{f['count']} pages", anchor="w", font=self.F(8),
                                   fill=T["muted"])
            else:
                cv.create_text(x, y + th + 11, text=f"p.{pi + 1}", anchor="w", font=self.F(9), fill=T["muted"])
        _ = f9

    def _thumb_img(self, g, tw):
        fi, pi, pw, ph = self.book.pages[g]
        f = self.book.files[fi]
        key = (f["path"], f.get("count"), pi, tw)
        th_ = self._thumbs
        if key in th_:
            th_.move_to_end(key)
            return th_[key]
        return None

    def _pages_visible(self):
        """Ask the helpers for the little pictures that are on the screen (the rest when you scroll to them)."""
        pv = self._pv
        if pv is None or not self.book:
            return
        cv = pv["cv"]
        top, bot = cv.canvasy(0) - 200, cv.canvasy(cv.winfo_height()) + 400
        want = [c_ for c_ in pv["cells"] if c_[0] == "page" and c_[3] + c_[5] > top and c_[3] < bot]
        pend = pv.setdefault("pend", set())
        for _k, g, x, y, tw, th in want:
            fi, pi, pw, ph = self.book.pages[g]
            f = self.book.files[fi]
            key = (f["path"], f.get("count"), pi, tw)
            if key in self._thumbs or key in pend:
                continue
            pend.add(key)
            z = tw / max(1.0, pw)

            def got(res, key=key, g=g):
                pend.discard(key)
                if self._pv is not pv or "rgb" not in res:
                    return
                try:
                    img = tk.PhotoImage(data=b"P6\n%d %d\n255\n" % (res["w"], res["h"]) + res["rgb"])
                except Exception:
                    return
                self._thumbs[key] = img
                while len(self._thumbs) > 500:
                    self._thumbs.popitem(last=False)
                c_ = next((c for c in pv["cells"] if c[0] == "page" and c[1] == g), None)
                if c_:
                    cv.delete(f"i{g}")
                    cv.create_image(c_[2], c_[3], image=img, anchor="nw", tags=f"i{g}")
                    cv.tag_raise(f"i{g}", f"p{g}")
            if self.pool.disabled:
                try:
                    pg = self.book.doc(fi).load_page(pi)
                    pix = pg.get_pixmap(matrix=self.fitz.Matrix(z, z), alpha=False)
                    got({"w": pix.width, "h": pix.height, "rgb": pix.samples if pix.n == 3 and
                         pix.stride == pix.width * 3 else self.fitz.Pixmap(self.fitz.csRGB, pix).samples})
                except Exception:
                    pend.discard(key)
                continue
            self.pool.submit("render", prio=2, timeout=60, path=f["path"], pi=pi, zoom=z, cb=got)

    def _pages_at(self, e):
        pv = self._pv
        if pv is None:
            return None
        cv = pv["cv"]
        x, y = cv.canvasx(e.x), cv.canvasy(e.y)
        for c_ in pv["cells"]:
            if c_[0] == "page" and c_[2] - 6 <= x <= c_[2] + c_[4] + 6 and c_[3] - 6 <= y <= c_[3] + c_[5] + 20:
                return c_[1]
        return None

    def _pages_hover(self, g):
        pv = self._pv
        if pv is None or pv["hover"] == g:
            return
        pv["hover"] = g
        pv["cv"].configure(cursor="hand2" if g is not None else "")
        self._pages_draw()
        if g is not None:
            fi, pi, _w, _h = self.book.pages[g]
            self.set_status(f"Page {g + 1}  ·  {os.path.basename(self.book.files[fi]['rel'])} p.{pi + 1}  ·  "
                            f"click to go there")

    def _pages_motion(self, e):
        self._pages_hover(self._pages_at(e))

    def _pages_click(self, e):
        g = self._pages_at(e)
        if g is None:
            return
        self._pv["sel"] = g
        self._pages_go()

    def _pages_move(self, d):
        pv = self._pv
        if pv is None or not self.book:
            return "break"
        pv["sel"] = max(0, min(self.book.total - 1, pv["sel"] + d))
        self._pages_draw()
        c_ = next((c for c in pv["cells"] if c[0] == "page" and c[1] == pv["sel"]), None)
        if c_:
            cv = pv["cv"]
            top, h = cv.canvasy(0), cv.winfo_height()
            if c_[3] < top + 10 or c_[3] + c_[5] > top + h - 30:
                cv.yview_moveto(max(0, c_[3] - h / 3) / max(1.0, pv.get("height", 1)))
                self._pages_visible()
        return "break"

    def _pages_go(self):
        pv = self._pv
        if pv is None:
            return
        g = pv["sel"]
        self.close_pages()
        self.goto_page(g)

    # ========================================================= scroll / zoom
    def _on_yscroll(self, a, b):
        self.vsb.set(a, b)
        self._draw_map_view(float(a), float(b))

    def _on_xscroll(self, a, b):
        self.hsb.set(a, b)
        need = not (float(a) <= 0.0 and float(b) >= 1.0)
        if need and not self.hsb.winfo_ismapped():
            self.hsb.pack(side="bottom", fill="x", before=self.canvas)
        elif not need and self.hsb.winfo_ismapped():
            self.hsb.pack_forget()

    def _scroll_to_frac(self, f):
        self.canvas.yview_moveto(max(0.0, min(1.0, f)))
        self._close_float()
        if not getattr(self, "_scroll_redraw", None):
            self._scroll_redraw = self.root.after(16, self._scroll_redraw_now)

    def _scroll_redraw_now(self):
        self._scroll_redraw = None
        self.redraw()

    def _yview(self, *args):
        self.canvas.yview(*args)
        self._close_float()
        self.redraw()

    def _xview(self, *args):
        self.canvas.xview(*args)
        self.redraw()

    def _on_wheel(self, e):
        self._scroll_quiet = time.time() + 0.35          # 4.0: the frame rests while you scroll
        if e.state & 0x0004:
            self.change_zoom(1.1 if e.delta > 0 else 1 / 1.1, at_y=e.y, at_x=e.x)    # zoom where the mouse is
            return
        notch = self._notch_px()
        if sys.platform == "darwin":
            px = -e.delta * notch / 3.0
        else:
            px = -e.delta / 120.0 * notch                  # a touchpad sends small steps: small, smooth moves
        self._scroll_px(px)

    def _notch_px(self):
        """3.0: one wheel notch = about an eighth of the window (calm, like other readers)."""
        return max(60.0, min(170.0, self.canvas.winfo_height() * 0.13))

    def _scroll_px(self, px):
        self._hide_tip()
        self._close_float()
        acc = getattr(self, "_wheel_acc", 0.0) + px
        n = int(acc)
        self._wheel_acc = acc - n
        if n:
            self.canvas.yview_scroll(n, "units")
            if getattr(self, "_wheel_job", None) is None:      # many wheel steps at once: one redraw
                self._wheel_job = self.root.after_idle(self._wheel_redraw)

    def _wheel_redraw(self):
        self._wheel_job = None
        self.redraw()

    def _wheel_units(self, units, e=None):
        if e is not None and e.state & 0x0004:
            self.change_zoom(1.1 if units < 0 else 1 / 1.1, at_y=getattr(e, "y", None), at_x=getattr(e, "x", None))
            return
        self._scroll_px(units / 3.0 * self._notch_px())

    def _center_x(self, g, draw=True):
        """4.1: put the page in the middle of the window, left to right (when it is wider than the window).
        4.2: also after every zoom - the page you read never drifts to one side."""
        try:
            c = self.canvas
            if self.page_lefts is not None:
                c.xview_moveto(0)
                return
            sr = [float(v) for v in str(c.cget("scrollregion")).split()]
            if len(sr) != 4:
                return
            total = sr[2] - sr[0]
            cw = c.winfo_width()
            if total <= cw + 2:
                c.xview_moveto(0)
                return
            x0 = self._page_xy(g)[0]
            want = x0 + self._page_w(g) / 2 - cw / 2 - sr[0]
            c.xview_moveto(max(0.0, min(1.0, want / total)))
            if draw:
                self.redraw()
        except Exception:
            pass

    def _xscroll(self, units):
        self.canvas.xview_scroll(int(units * 40), "units")
        self.redraw()

    def _scroll_screen(self, d):
        self.canvas.yview_scroll(d, "pages")
        self.redraw()

    def _position(self):
        if not self.book or not self.book.total or len(self.page_tops) != self.book.total:
            return 0, 0.0
        top = self.canvas.canvasy(0)
        g = self._page_at_y(top)
        return g, max(0.0, min((top - self.page_tops[g]) / max(self._page_h(g), 1), 1.0))

    def _apply_zoom(self, z, at_y=None, at_x=None):
        if at_y is not None and self.book and self.book.total and len(self.page_tops) == self.book.total:
            yy = self.canvas.canvasy(at_y)
            g = None
            if self.page_lefts is not None and at_x is not None:
                g = self._grid_hit(self.canvas.canvasx(at_x), yy)     # 4.2: the page under the mouse
            if g is None:
                g = self._page_at_y(yy)
            frac = (yy - self.page_tops[g]) / max(self._page_h(g), 1)
        else:
            g, frac = self._position()
            at_y = 0
        frac = max(0.0, min(1.0, frac))
        self.zoom = max(0.06, min(z, 6.0))
        self.cache.clear()
        self._failed = {}
        self._rendering = {}
        self._layout()
        if self.page_tops:
            self._scroll_to_y(self.page_tops[g] + frac * self._page_h(g) - at_y)
            self.current_page = g
            self._center_x(g, draw=False)        # 4.2: the page stays in the middle - never off to one side
        if getattr(self, "_ed", None):
            self._ed["rt"].set_zoom(self.zoom)
            self._ed["h"] = None
        self.redraw()

    def change_zoom(self, factor, at_y=None, at_x=None):
        if getattr(self, "_pv", None) is not None:          # 4.1: in the grid of pages, zoom moves through sizes
            if factor > 1:
                self._pages_zoom_in()
            else:
                self._pages_zoom_out()
            return
        if self.book:
            # 4.2: no jump to another screen any more - the page gets smaller little by little; under 35% more
            # pages appear beside it, a column at a time (see _layout_grid)
            z = self.zoom * factor
            if self.zoom >= self.GRID_ZOOM > z:
                z = self.GRID_ZOOM * 0.97                     # the first step into the grid is a gentle one
            self.fit_mode = None
            self._apply_zoom(z, at_y=at_y, at_x=at_x)

    def _pages_zoom_out(self):
        pv = self._pv
        order = ["S", "M", "L"]
        i = order.index(pv["size"]) if pv["size"] in order else 1
        if i > 0:
            self._pages_size(order[i - 1])

    def _pages_zoom_in(self):
        """Bigger pictures - and from the biggest, back to the page you were reading, a whole page in view."""
        pv = self._pv
        order = ["S", "M", "L"]
        i = order.index(pv["size"]) if pv["size"] in order else 1
        if i < 2:
            self._pages_size(order[i + 1])
            return
        g = pv["sel"]
        self.close_pages()
        self.fit_mode = "page"
        self._apply_zoom(self._fit_zoom("page"))
        self.root.after(30, lambda: self.goto_page(g))

    def set_fit(self, mode):
        if self.book:
            self.fit_mode = mode
            self._apply_zoom(self._fit_zoom(mode))

    def _toggle_fit(self):
        self.set_fit("page" if self.fit_mode == "width" else "width")
        self.set_status("Fit page" if self.fit_mode == "page" else "Fit width")

    # ---- background behind the pages: gradient (still, flowing or lava lamp), picture + calm effects -------
    BG_EFFECTS = OrderedDict([("none", "None"), ("bubbles", "Bubbles"), ("clouds", "Clouds"), ("waves", "Waves"),
                              ("stars", "Stars"), ("bokeh", "Soft lights"), ("snow", "Snow"), ("petals", "Petals"),
                              ("leaves", "Autumn leaves"), ("butterflies", "Butterflies"),
                              ("dandelion", "Dandelion seeds"), ("fireflies", "Fireflies"), ("rain", "Rain on glass"),
                              ("aurora", "Aurora"), ("seasons", "The season (changes by itself)")])

    def _fx_effect(self, conf=None):
        """The effect to show ('seasons': snow in winter, petals in spring, fireflies in summer, leaves in autumn)."""
        eff = (conf or self._bg_conf()).get("effect", "none")
        if eff == "seasons":
            m = int(time.strftime("%m"))
            eff = {12: "snow", 1: "snow", 2: "snow", 3: "petals", 4: "petals", 5: "dandelion", 6: "butterflies",
                   7: "butterflies", 8: "fireflies"}.get(m, "leaves")
        return eff
    BG_MOTIONS = OrderedDict([("still", "Still"), ("drift", "Flowing colours"), ("flow", "Lava lamp")])

    def _big_tex(self, name, W, H):
        """A big texture: its picture is made once (a moment, in the background) and kept; until it is ready a
        quick smaller one shows."""
        folder = os.path.join(self.lib.meta_dir, "backgrounds")
        path = os.path.join(folder, f"{name}-v{TEX_VERSION}.png")
        dark = None if is_light(self.T["canvas"]) else self.T["canvas"]
        if os.path.exists(path):
            return big_texture_ppm(self.fitz, path, W, H, dark_canvas=dark)
        making = self.__dict__.setdefault("_tex_making", set())
        if name not in making:
            making.add(name)

            def work():
                try:
                    big_texture_base(self.fitz, name, folder)
                except Exception as ex:
                    _log(f"texture {name}: {ex}")
                self.root.after(0, lambda: (making.discard(name), self.apply_background()))
            threading.Thread(target=work, daemon=True).start()
        quick = os.path.join(folder, f"{name}-quick.png")
        try:
            if not os.path.exists(quick):
                os.makedirs(folder, exist_ok=True)
                qw, qh = (400, 250) if BIG_TEXTURES[name]["kind"] == "wood" else (240, 150)
                self.fitz.Pixmap(self.fitz.csRGB, qw, qh, make_texture(name, qw, qh), False).save(quick)
            return big_texture_ppm(self.fitz, quick, W, H, dark_canvas=dark)
        except Exception:
            return texture_ppm("Paper", W, H, self.T["canvas"])

    def _read_bg_colors(self):
        """4.1: the reading background - soft colours made from the app's colours of the moment."""
        T, A = self.T, self.accent
        base = T["canvas"]
        light = is_light(base)
        k = 0.30 if light else 0.38
        return [mix(base, A, k), mix(base, hue_shift(A, 42), k * 0.8), mix(base, "#FFFFFF" if light else "#000000",
                                                                            0.18),
                mix(base, hue_shift(A, -36), k * 0.85)]

    def _read_conf(self):
        """4.2: Personalise > Reading mode - how reading looks, apart from the normal view."""
        c = self.lib.settings.setdefault("reading", {})
        if "bg" not in c:
            c["bg"] = "colours" if self.lib.settings.get("read_bg", "colours") == "colours" else "same"
        c.setdefault("colors", [])
        c.setdefault("motion", "slow")          # still | veryslow | slow
        c.setdefault("page", "same")            # same | normal | warm | night
        c.setdefault("toc", True)
        c.setdefault("clock", True)
        c.setdefault("frame", True)
        c.setdefault("slide_secs", 6)           # pictures: the slideshow
        c.setdefault("pic_frame", True)         # pictures: the frame's colours round each one
        return c

    def _bg_conf(self):
        if getattr(self, "_reading", False):
            rc = self._read_conf()
            bg = rc.get("bg", "colours")
            sp = {"still": 0.0, "veryslow": 0.22, "slow": 0.45}.get(rc.get("motion"), 0.45)
            if bg in ("colours", "own"):
                cols = self._read_bg_colors()
                if bg == "own" and rc.get("colors"):
                    base = self.T["canvas"]
                    cols = [mix(base, c_, 0.55) for c_ in rc["colors"][:4]]
                return {"mode": "gradient", "name": "reading", "colors": cols, "motion": "flow" if sp else "still",
                        "speed": sp or 0.45, "effect": "none", "reading": True}
            if bg == "dark":
                return {"mode": "gradient", "name": "reading-dark", "colors": ["#0E0F16", "#161A2B", "#10131F"],
                        "motion": "flow" if sp else "still", "speed": sp or 0.45, "effect": "none", "reading": True}
        conf = dict(self.lib.settings.get("background", {"mode": "none"}))
        if "motion" not in conf:
            conf["motion"] = "drift" if conf.get("animate") else "still"
        if conf.get("mode") == "texture" and conf.get("name") in OLD_TEXTURES:
            conf["name"] = OLD_TEXTURES[conf["name"]]
        return conf

    def _bg_base_colors(self):
        conf = self._bg_conf()
        if conf.get("mode") == "gradient":
            return conf.get("colors") or GRADIENTS["Aurora"]
        if conf.get("mode") == "picture":
            return conf.get("tones") or [self.T["canvas"], self.accent]
        if conf.get("mode") == "texture":
            if conf.get("name") in BIG_TEXTURES:
                sp = BIG_TEXTURES[conf["name"]]
                return ["#%02X%02X%02X" % sp["a"], "#%02X%02X%02X" % sp["b"]]
            return list(TEXTURES.get(conf.get("name"), TEXTURES["Paper"])["tones"])
        return [self.T["canvas"], mix(self.T["canvas"], self.accent, 0.25)]

    def _bg_rebuild(self, _e=None, reuse=None):
        conf = self._bg_conf()
        c = self.canvas
        W, H = max(50, c.winfo_width()), max(50, c.winfo_height())
        if conf.get("mode", "none") == "none":
            self._bg_photo = None
            return
        try:
            moving = conf.get("mode") == "gradient" and conf.get("motion") in ("drift", "flow")
            if moving:                                     # third size, enlarged by Tk: smooth and cheap
                k = 3
                w3, h3 = (W + k - 1) // k, (H + k - 1) // k
                data = self._bg_ppm(conf, w3, h3, getattr(self, "_bg_phase", 0.0))
                small = getattr(self, "_bg_small", None)
                if reuse is not None and small is not None and (small.width(), small.height()) == (w3, h3) and \
                        (reuse.width(), reuse.height()) == (w3 * k, h3 * k):
                    small.configure(data=data)                  # the same pictures, new colours: no new memory
                    reuse.tk.call(reuse.name, "copy", small.name, "-zoom", k, k)
                    self._bg_photo = reuse
                else:
                    self._bg_small = tk.PhotoImage(data=data)
                    self._bg_photo = self._bg_small.zoom(k, k)
            else:
                key = (conf.get("mode"), conf.get("picture"), tuple(conf.get("colors") or ()), conf.get("soften"), W, H,
                       self.T["canvas"], conf.get("name"))
                if getattr(self, "_bg_key", None) == key and getattr(self, "_bg_photo", None) is not None:
                    return
                self._bg_photo = tk.PhotoImage(data=self._bg_ppm(conf, W, H, 0.0))
                self._bg_key = key
        except Exception:
            self._bg_photo = None

    def _bg_ppm(self, conf, W, H, phase=0.0):
        import math
        fitz = self.fitz
        if conf.get("mode") == "texture":
            name = conf.get("name") or "Paper"
            if name in BIG_TEXTURES:                    # 4.0: big real woods, marble, cork…
                return self._big_tex(name, W, H)
            return texture_ppm(name, W, H, self.T["canvas"])
        if conf.get("mode") == "picture":
            path = conf.get("picture")
            doc = fitz.open()
            pg = doc.new_page(width=W, height=H)
            try:
                pix0 = fitz.Pixmap(path)
                k = max(W / pix0.width, H / pix0.height)
                w, h = pix0.width * k, pix0.height * k
                pg.insert_image(fitz.Rect((W - w) / 2, (H - h) / 2, (W + w) / 2, (H + h) / 2), filename=path)
            except Exception:
                pass
            dim = float(conf.get("soften", 0.35))
            if dim > 0:
                sh = pg.new_shape()
                sh.draw_rect(pg.rect)
                sh.finish(color=None, fill=hex_to_rgb01(self.T["canvas"]), fill_opacity=dim)
                sh.commit()
            return pg.get_pixmap(alpha=False).tobytes("ppm")
        cols = conf.get("colors") or GRADIENTS["Aurora"]
        rgb = [hex_to_rgb01(x) for x in cols]
        sw, shh = 48, 28
        buf = bytearray()
        motion = conf.get("motion", "still")
        if motion == "flow":
            # lava lamp: soft blobs of each colour drifting slowly around each other
            n = len(rgb)
            centres = []
            for i in range(max(3, n)):
                a = phase * 2 * math.pi * (1 + 0.37 * i) + i * 2.1
                centres.append((0.5 + 0.38 * math.cos(a + i), 0.5 + 0.36 * math.sin(a * 1.3 + i * 0.7),
                                rgb[i % n]))
            for y in range(shh):
                v = y / (shh - 1)
                for x in range(sw):
                    u = x / (sw - 1)
                    tw, acc = 0.0, [0.0, 0.0, 0.0]
                    for cx, cy, col in centres:
                        d2 = (u - cx) ** 2 * 1.4 + (v - cy) ** 2
                        wgt = 1.0 / (0.02 + d2) ** 1.6
                        tw += wgt
                        acc[0] += col[0] * wgt
                        acc[1] += col[1] * wgt
                        acc[2] += col[2] * wgt
                    buf += bytes(min(255, int(255 * acc[k] / tw)) for k in range(3))
        else:
            loop = rgb + [rgb[0]]
            n = len(loop) - 1
            for y in range(shh):
                for x in range(sw):
                    u = ((x / sw) * 0.65 + (y / shh) * 0.35) * 0.999
                    if motion == "drift":
                        u = (u * 0.75 + phase) % 1.0
                    else:
                        u = u * (len(cols) - 1) / n
                    pos = u * n
                    i = min(n - 1, int(pos))
                    t = pos - i
                    a, b = loop[i], loop[i + 1]
                    buf += bytes(int(255 * (a[k] + (b[k] - a[k]) * t)) for k in range(3))
        small = fitz.Pixmap(fitz.csRGB, sw, shh, bytes(buf), False)
        big = fitz.Pixmap(small, W, H, None)
        return big.tobytes("ppm")

    def _touch_input(self, _e=None):
        self._last_input = time.time()
        if getattr(self, "_idle_win", None) is not None:
            self._idle_stop()

    def _fast(self):
        """4.0: Fast mode - nothing moves and nothing is done in the background unless you ask (by hand, or by
        itself on a laptop's battery)."""
        st = self.lib.settings
        if st.get("fast_mode"):
            return True
        if st.get("fast_on_battery", True):
            t = time.time()
            if t - getattr(self, "_batt_t", 0) > 60:
                self._batt_t, self._batt = t, on_battery()
            return bool(getattr(self, "_batt", False))
        return False

    def _quiet(self, secs):
        """4.0: nobody has used BindLens - nor the computer (Windows) - for secs seconds: background work may run."""
        try:
            if self.drag or getattr(self, "_ed", None) or self.root.grab_current() is not None:
                return False
            last = max(getattr(self, "_last_input", 0.0), getattr(self, "_last_motion", 0.0))
            if time.time() - last < secs:
                return False
            si = system_idle_seconds()
            return si is None or si >= secs
        except Exception:
            return False

    def set_fast(self, how):
        """'on' (Fast mode), 'battery' (fast only on a laptop's battery) or 'off'."""
        st = self.lib.settings
        st["fast_mode"] = how == "on"
        st["fast_on_battery"] = how in ("on", "battery")
        self._batt_t = 0
        self.lib.save_meta()
        self._toast({"on": "Fast mode on - nothing moves, no work in the background.",
                     "battery": "Fast mode when the laptop is on its battery.",
                     "off": "Everything on."}[how])
        try:
            self.apply_background()
        except Exception:
            pass

    def _quiet_t(self, secs):
        """_quiet for a background thread (no window calls)."""
        last = max(getattr(self, "_last_input", 0.0), getattr(self, "_last_motion", 0.0))
        if time.time() - last < secs or self.drag:
            return False
        si = system_idle_seconds()
        return si is None or si >= secs

    def _bg_paused(self):
        return time.time() < float(getattr(self, "_bg_pause_until", 0) or 0)

    def _anim_ok(self, quiet=2.0):
        """Moving things only move while you are not doing anything: never while you scroll, type, drag or use
        a window - and not when BindLens is in the background or minimised."""
        if self._fast():
            return False
        try:
            if self.root.state() == "iconic" or self.drag or getattr(self, "_ed", None):
                return False
            if time.time() - getattr(self, "_last_input", 0.0) < quiet:
                return False
            if self.root.grab_current() is not None or self.root.focus_displayof() is None:
                return False
            if getattr(self, "_rep_job", None) or getattr(self, "_idle_win", None) is not None:
                return False
            if getattr(self, "render_job", None) is not None or getattr(self, "_queue", None):
                return False                      # pages still being drawn: they come first
        except Exception:
            return False
        return True

    def _bg_tick(self):
        self._bg_job = None
        conf = self._bg_conf()
        if conf.get("mode") != "gradient" or conf.get("motion") not in ("drift", "flow"):
            return
        if self._anim_ok() and not (conf.get("reading") and self._fast()):
            speed = float(conf.get("speed", 1.0))
            self._bg_phase = (getattr(self, "_bg_phase", 0.0) + (0.006 if conf.get("motion") == "drift" else 0.004)
                              * speed) % 1.0
            old = getattr(self, "_bg_photo", None)
            self._bg_rebuild(reuse=old)
            if self._bg_photo is not None:
                c = self.canvas
                if not c.find_withtag("appbg"):
                    self.redraw()
                elif self._bg_photo is not old:
                    c.itemconfigure("appbg", image=self._bg_photo)
            self._bg_job = self.root.after(900 if conf.get("reading") else 420, self._bg_tick)
        else:
            self._bg_job = self.root.after(500, self._bg_tick)

    def apply_background(self):
        self._bg_key = None
        self._bg_rebuild()
        conf = self._bg_conf()
        if getattr(self, "_bg_job", None) is None and conf.get("mode") == "gradient" and \
                conf.get("motion") in ("drift", "flow"):
            self._bg_job = self.root.after(160, self._bg_tick)
        self._fx_items = []
        self._fx_parts = None
        if getattr(self, "_fx_job", None) is None and conf.get("effect", "none") != "none":
            self._fx_job = self.root.after(60, self._fx_tick)
        self.redraw()

    # ---- calm moving things: bubbles, clouds, waves, stars, lights, snow, petals, leaves, fireflies ------
    def _fx_make(self, W, H):
        import random
        conf = self._bg_conf()
        eff = self._fx_effect(conf)
        amt = float(conf.get("amount", 1.0))
        rnd = random.Random()
        cols = self._bg_base_colors()
        base = cols[0]
        parts = []
        if eff == "bubbles":
            for _ in range(int(16 * amt)):
                r = rnd.uniform(5, 24)
                parts.append({"x": rnd.uniform(0, W), "y": rnd.uniform(0, H), "r": r, "v": rnd.uniform(0.25, 0.8) * (
                    1.2 - r / 40), "ph": rnd.uniform(0, 6.3), "col": mix(rnd.choice(cols), "#FFFFFF", 0.62)})
        elif eff == "clouds":
            for _ in range(max(2, int(5 * amt))):
                s = rnd.uniform(0.6, 1.4)
                blobs = [(rnd.uniform(-40, 40) * s, rnd.uniform(-10, 10) * s, rnd.uniform(26, 44) * s) for _ in range(5)]
                parts.append({"x": rnd.uniform(-100, W), "y": rnd.uniform(H * 0.05, H * 0.7), "v": rnd.uniform(0.12, 0.35),
                              "b": blobs, "col": mix(base, "#FFFFFF", rnd.uniform(0.78, 0.92))})
        elif eff == "waves":
            deep = mix(cols[-1], "#0B3D91", 0.35)
            for k in range(3):
                parts.append({"k": k, "ph": rnd.uniform(0, 6.3), "amp": 9 + k * 4, "len": rnd.uniform(220, 380),
                              "v": 0.018 + k * 0.008, "col": mix(mix(base, deep, 0.25 + k * 0.2), "#FFFFFF", 0.25 - k * 0.07)})
        elif eff == "stars":
            for _ in range(int(70 * amt)):
                parts.append({"x": rnd.uniform(0, W), "y": rnd.uniform(0, H), "r": rnd.choice((0.8, 1, 1.2, 1.6, 2.2)),
                              "ph": rnd.uniform(0, 6.3), "v": rnd.uniform(0.02, 0.07)})
        elif eff == "bokeh":
            for _ in range(int(12 * amt)):
                r = rnd.uniform(26, 80)
                parts.append({"x": rnd.uniform(0, W), "y": rnd.uniform(0, H), "r": r, "vx": rnd.uniform(-0.18, 0.18),
                              "vy": rnd.uniform(-0.12, 0.12), "col": mix(base, rnd.choice(cols + ["#FFFFFF"]),
                                                                          rnd.uniform(0.22, 0.4))})
        elif eff == "snow":
            # 1.9.9: soft flakes - and real snow crystals that turn slowly as they fall
            for _ in range(int(60 * amt)):
                parts.append({"x": rnd.uniform(0, W), "y": rnd.uniform(-H, H), "r": rnd.uniform(1.8, 4.6),
                              "v": rnd.uniform(0.4, 1.1), "ph": rnd.uniform(0, 6.3), "col": "#FFFFFF"})
            for _ in range(int(14 * amt)):
                sz = rnd.choice((22, 28, 36))
                parts.append({"spr": "crystal", "var": None, "col": None, "size": sz, "r": sz / 2,
                              "x": rnd.uniform(0, W), "y": rnd.uniform(-H, H), "v": rnd.uniform(0.35, 0.8),
                              "ph": rnd.uniform(0, 6.3), "a": rnd.uniform(0, 360), "spin": rnd.uniform(-0.8, 0.8)})
        elif eff in ("petals", "leaves"):
            # 1.9.9: real shapes - maple, oak and birch leaves in autumn colours; cherry petals - bigger, turning
            # (a few kinds of leaf - each kind is drawn once per angle and kept, so it stays light for the computer)
            kinds = []
            if eff == "leaves":
                for v_ in ("maple", "maple", "oak", "birch", "ginkgo", "maple", "oak", "birch", "ginkgo"):
                    kinds.append((v_, rnd.choice(("#E9B03B", "#F0C24A", "#D9A530")) if v_ == "ginkgo" else
                                  rnd.choice(FX_LEAF_COLS), rnd.choice((42, 50, 58, 66))))
            for i_ in range(int((24 if eff == "petals" else 26) * amt)):
                if eff == "leaves" and i_ % 6 == 5:            # now and then a maple seed, spinning as it falls
                    sz = rnd.choice((36, 44))
                    pr = {"spr": "samara", "var": None, "col": rnd.choice(("#C9A15A", "#B88A4A", "#D4B06A")),
                          "v": rnd.uniform(0.35, 0.6)}
                    pr.update(size=sz, r=sz / 2, x=rnd.uniform(0, W), y=rnd.uniform(-H, H), ph=rnd.uniform(0, 6.3),
                              a=rnd.uniform(0, 360), spin=rnd.choice((-1, 1)) * rnd.uniform(7, 10), fl=0.0)
                    parts.append(pr)
                    continue
                if eff == "leaves":
                    v_, c_, sz = rnd.choice(kinds)
                    pr = {"spr": "leaf", "var": v_, "col": c_, "v": rnd.uniform(0.45, 1.0) * (0.85 + sz / 260)}
                else:
                    sz = rnd.choice((26, 32, 38))
                    pr = {"spr": "petal", "var": None, "col": rnd.choice(("#F8C8D8", "#F5B5C8", "#FBD9E3", "#F29BB6")),
                          "v": rnd.uniform(0.35, 0.8)}
                pr.update(size=sz, r=sz / 2, x=rnd.uniform(0, W), y=rnd.uniform(-H, H), ph=rnd.uniform(0, 6.3),
                          a=rnd.uniform(0, 360), spin=rnd.choice((-1, 1)) * rnd.uniform(0.5, 1.8),
                          fl=rnd.uniform(0.02, 0.05))
                parts.append(pr)
        elif eff == "butterflies":
            for _ in range(max(3, int(7 * amt))):
                sz = rnd.choice((40, 48, 54))
                parts.append({"spr": "butterfly", "var": None, "col": rnd.choice(FX_BUTTERFLY), "size": sz, "r": sz / 2,
                              "x": rnd.uniform(0, W), "y": rnd.uniform(0, H), "vx": rnd.uniform(-0.8, 0.8),
                              "vy": rnd.uniform(-0.6, 0.6), "ph": rnd.uniform(0, 6.3), "a": 0.0, "k": rnd.randint(0, 5),
                              "glide": 0})
        elif eff == "dandelion":
            for _ in range(int(16 * amt)):
                sz = rnd.choice((32, 40, 46))
                parts.append({"spr": "seed", "var": None, "col": None, "size": sz, "r": sz / 2, "x": rnd.uniform(-W * 0.2, W),
                              "y": rnd.uniform(0, H), "vx": rnd.uniform(0.3, 0.7), "ph": rnd.uniform(0, 6.3), "a": 0.0})
        elif eff == "fireflies":
            for _ in range(int(22 * amt)):
                parts.append({"x": rnd.uniform(0, W), "y": rnd.uniform(0, H), "ph": rnd.uniform(0, 6.3),
                              "vx": rnd.uniform(-0.4, 0.4), "vy": rnd.uniform(-0.3, 0.3)})
        elif eff == "rain":
            # drops on the glass (resting, then sliding down) and fine rain far behind them
            for _ in range(int(46 * amt)):
                r = rnd.uniform(1.6, 4.4)
                parts.append({"k": "drop", "x": rnd.uniform(0, W), "y": rnd.uniform(0, H), "r": r, "v": 0.0,
                              "rest": rnd.uniform(0, 400), "col": mix(base, "#FFFFFF", rnd.uniform(0.45, 0.7))})
            for _ in range(int(30 * amt)):
                parts.append({"k": "line", "x": rnd.uniform(0, W), "y": rnd.uniform(0, H), "len": rnd.uniform(10, 26),
                              "v": rnd.uniform(5, 9), "col": mix(base, "#FFFFFF", rnd.uniform(0.25, 0.45))})
        elif eff == "aurora":
            for k, c_ in enumerate(("#3DDC97", "#2EC4B6", "#9D4EDD")):
                parts.append({"k": k, "ph": rnd.uniform(0, 6.3), "ph2": rnd.uniform(0, 6.3), "len": rnd.uniform(260, 420),
                              "len2": rnd.uniform(140, 240), "amp": rnd.uniform(14, 26), "th": rnd.uniform(40, 70),
                              "v": 0.012 + k * 0.004, "col": mix(base, c_, 0.42 - k * 0.06)})
        return {"eff": eff, "W": W, "H": H, "parts": parts, "t": 0.0}

    def _fx_draw(self):
        """Draw the effect (right behind the pages). Called by redraw."""
        conf = self._bg_conf()
        self._fx_items = []
        if conf.get("effect", "none") == "none":
            return
        c = self.canvas
        W, H = max(50, c.winfo_width()), max(50, c.winfo_height())
        fx = getattr(self, "_fx_parts", None)
        if fx is None or fx["eff"] != self._fx_effect(conf) or abs(fx["W"] - W) > 40 or abs(fx["H"] - H) > 40:
            fx = self._fx_parts = self._fx_make(W, H)
        ox, oy = c.canvasx(0), c.canvasy(0)
        cover = []                                     # the pages on screen (window coordinates)
        try:
            if self.book and self.book.total and len(self.page_tops) == self.book.total:
                g = self._page_at_y(oy)
                while g < self._total() and self.page_tops[g] < oy + H:
                    x, y = self._page_xy(g)
                    _fi, _pi, pw, ph = self.book.pages[g]
                    cover.append((x - ox, y - oy, x - ox + pw * self.zoom, y - oy + ph * self.zoom))
                    g += 1
        except Exception:
            cover = []
        fx["cover"] = cover
        eff = fx["eff"]
        items = []
        for p in fx["parts"]:
            if eff == "bubbles":
                ids = (c.create_oval(0, 0, 1, 1, outline=p["col"], width=1.6, tags="appfx"),
                       c.create_arc(0, 0, 1, 1, start=95, extent=70, style="arc", outline="#FFFFFF", width=1.6,
                                    tags="appfx"))
            elif eff == "clouds":
                ids = tuple(c.create_oval(0, 0, 1, 1, fill=p["col"], outline="", tags="appfx") for _ in p["b"])
            elif eff == "waves":
                ids = (c.create_polygon(0, 0, 1, 1, 2, 2, fill=p["col"], outline="", smooth=True, tags="appfx"),)
            elif eff == "stars":
                ids = (c.create_oval(0, 0, 1, 1, fill="#FFFFFF", outline="", tags="appfx"),)
            elif eff == "bokeh":
                ids = (c.create_oval(0, 0, 1, 1, fill=p["col"], outline=mix(p["col"], "#FFFFFF", 0.25), tags="appfx"),)
            elif p.get("spr"):
                ids = (c.create_image(-300, -300, anchor="center", tags="appfx"),)
                p["_key"] = None
            elif eff in ("snow", "petals", "leaves"):
                ids = (c.create_oval(0, 0, 1, 1, fill=p["col"], outline="", tags="appfx"),)
            elif eff == "rain":
                if p["k"] == "drop":
                    ids = (c.create_oval(0, 0, 1, 1, fill=p["col"], outline=mix(p["col"], "#000000", 0.12),
                                         tags="appfx"),
                           c.create_oval(0, 0, 1, 1, fill="#FFFFFF", outline="", tags="appfx"))
                else:
                    ids = (c.create_line(0, 0, 1, 1, fill=p["col"], width=1, tags="appfx"),)
            elif eff == "aurora":
                ids = (c.create_polygon(0, 0, 1, 1, 2, 2, fill=p["col"], outline="", smooth=True, tags="appfx"),)
            else:
                ids = (c.create_oval(0, 0, 1, 1, fill="", outline="", tags="appfx"),
                       c.create_oval(0, 0, 1, 1, fill="#FFF59D", outline="", tags="appfx"))
            items.append(ids)
        self._fx_items = items
        self._fx_place(ox, oy)
        try:
            c.tag_raise("appfx", "appbg")
        except Exception:
            pass

    def _fx_place(self, ox, oy):
        import math
        fx = self._fx_parts
        if not fx:
            return
        c = self.canvas
        eff, W, H, t = fx["eff"], fx["W"], fx["H"], fx["t"]
        base0 = self._bg_base_colors()[0]
        cover = fx.get("cover") or []

        def hidden(ids, x, y, r):
            """Behind a page: nothing to draw (and nothing for the screen to repaint)."""
            inside = any(a + 2 <= x - r and x + r <= cc - 2 and b + 2 <= y - r and y + r <= d - 2
                         for a, b, cc, d in cover)
            was = p.get("_hid", False)
            if inside != was:
                p["_hid"] = inside
                for i in ids:
                    c.itemconfigure(i, state="hidden" if inside else "normal")
            return inside
        for p, ids in zip(fx["parts"], self._fx_items):
            if eff in ("bubbles", "stars", "bokeh", "snow", "petals", "leaves", "fireflies", "rain", "butterflies",
                       "dandelion") and cover:
                r_ = p.get("r", 8) + 24
                if hidden(ids, p.get("x", 0), p.get("y", 0), r_):
                    continue
            elif eff == "clouds" and cover:
                if hidden(ids, p["x"], p["y"], 110):
                    continue
            if eff == "bubbles":
                x = p["x"] + math.sin(t * 0.03 + p["ph"]) * 6
                r = p["r"]
                c.coords(ids[0], ox + x - r, oy + p["y"] - r, ox + x + r, oy + p["y"] + r)
                c.coords(ids[1], ox + x - r * 0.7, oy + p["y"] - r * 0.7, ox + x + r * 0.7, oy + p["y"] + r * 0.7)
            elif eff == "clouds":
                for (bx, by, br), i in zip(p["b"], ids):
                    c.coords(i, ox + p["x"] + bx - br, oy + p["y"] + by - br * 0.62, ox + p["x"] + bx + br,
                             oy + p["y"] + by + br * 0.62)
            elif eff == "waves":
                k = p["k"]
                base_y = H * (0.80 + 0.06 * k)
                pts = []
                step = 40
                x = -step
                while x <= W + step:
                    y = base_y + p["amp"] * math.sin(x / p["len"] * 2 * math.pi + p["ph"] + t * p["v"])
                    pts += [ox + x, oy + y]
                    x += step
                pts += [ox + W + step, oy + H + 10, ox - step, oy + H + 10]
                c.coords(ids[0], *pts)
            elif eff == "stars":
                b = 0.5 + 0.5 * math.sin(t * p["v"] + p["ph"])
                r = p["r"] * (0.7 + 0.5 * b)
                c.coords(ids[0], ox + p["x"] - r, oy + p["y"] - r, ox + p["x"] + r, oy + p["y"] + r)
                c.itemconfigure(ids[0], fill=mix("#FFFFFF", base0, max(0.0, 0.75 - 0.7 * b)))
            elif eff == "bokeh":
                r = p["r"]
                c.coords(ids[0], ox + p["x"] - r, oy + p["y"] - r, ox + p["x"] + r, oy + p["y"] + r)
            elif eff == "rain":
                if p["k"] == "drop":
                    r = p["r"]
                    sl = 1.0 + min(0.6, p["v"] * 0.25)                 # a sliding drop is a little longer
                    c.coords(ids[0], ox + p["x"] - r, oy + p["y"] - r * sl, ox + p["x"] + r, oy + p["y"] + r)
                    c.coords(ids[1], ox + p["x"] - r * 0.45, oy + p["y"] - r * 0.55, ox + p["x"] - r * 0.05,
                             oy + p["y"] - r * 0.15)
                else:
                    c.coords(ids[0], ox + p["x"], oy + p["y"], ox + p["x"] - p["len"] * 0.18, oy + p["y"] + p["len"])
            elif eff == "aurora":
                k = p["k"]
                top = H * (0.08 + 0.07 * k)
                step = 36
                up, down = [], []
                x = -step
                while x <= W + step:
                    y1 = top + p["amp"] * math.sin(x / p["len"] * 2 * math.pi + p["ph"] + t * p["v"])
                    th = p["th"] * (0.55 + 0.45 * math.sin(x / p["len2"] * 2 * math.pi + p["ph2"] + t * p["v"] * 1.7))
                    up += [ox + x, oy + y1]
                    down = [ox + x, oy + y1 + th] + down
                    x += step
                c.coords(ids[0], *(up + down))
            elif p.get("spr"):
                spr = p["spr"]
                if spr == "butterfly":
                    x, y = p["x"], p["y"]
                    flip = (1.0, 0.75, 0.45, 0.22, 0.45, 0.75)[p["k"] % 6] if not p["glide"] else 1.0
                    ang = round(p["a"] / 15) * 15
                elif spr == "seed":
                    x, y = p["x"], p["y"] + math.sin(t * 0.02 + p["ph"]) * 14
                    flip, ang = 1.0, round(12 * math.sin(t * 0.03 + p["ph"]) / 6) * 6
                else:
                    x = p["x"] + math.sin(t * 0.025 + p["ph"]) * (8 if spr in ("crystal", "samara") else 26)
                    y = p["y"]
                    ang = round(p["a"] / 20) * 20 % 360
                    flip = 1.0 if spr in ("crystal", "samara") else (1.0, 0.7, 0.4)[min(2, int(3 * (1 - abs(math.cos(
                        t * p.get("fl", 0.03) + p["ph"])))))]
                key = (spr, p["var"], str(p["col"]), p["size"], ang % 360, flip)
                if key != p.get("_key"):
                    im = self._fx_sprite(key)
                    if im is not None:
                        c.itemconfigure(ids[0], image=im)
                        p["_key"] = key
                c.coords(ids[0], ox + x, oy + y)
            elif eff in ("snow", "petals", "leaves"):
                x = p["x"] + math.sin(t * 0.025 + p["ph"]) * (10 if eff == "snow" else 22)
                r = p["r"]
                if eff == "snow":
                    c.coords(ids[0], ox + x - r, oy + p["y"] - r, ox + x + r, oy + p["y"] + r)
                else:
                    sq = abs(math.sin(t * 0.04 + p["ph"]))      # turning in the air
                    c.coords(ids[0], ox + x - r, oy + p["y"] - r * (0.3 + 0.5 * sq), ox + x + r,
                             oy + p["y"] + r * (0.3 + 0.5 * sq))
            else:
                b = 0.5 + 0.5 * math.sin(t * 0.06 + p["ph"])
                c.coords(ids[0], ox + p["x"] - 7, oy + p["y"] - 7, ox + p["x"] + 7, oy + p["y"] + 7)
                c.coords(ids[1], ox + p["x"] - 2, oy + p["y"] - 2, ox + p["x"] + 2, oy + p["y"] + 2)
                glow = mix(base0, "#FFF59D", 0.25 + 0.35 * b)
                c.itemconfigure(ids[0], fill=glow)
                c.itemconfigure(ids[1], fill=mix(base0, "#FFFDE7", 0.45 + 0.55 * b))

    def _fx_sprite(self, key):
        """A picture of one floating thing (made once, then reused)."""
        cache = self.__dict__.setdefault("_fx_sprites", {})
        im = cache.get(key)
        if im is None:
            evict_pictures(cache, 1600, pic=lambda v: v)
            spr, var, col, size, ang, flip = key
            colv = None
            if spr in ("leaf", "petal", "samara"):
                colv = col
            elif spr == "butterfly":
                colv = tuple(re.findall(r"#[0-9A-Fa-f]{6}", col))
            try:
                im = tk.PhotoImage(data=fx_sprite_png(self.fitz, spr, var, colv, size, ang, flip))
            except Exception:
                im = None
            cache[key] = im
        return im

    def _fx_tick(self):
        self._fx_job = None
        conf = self._bg_conf()
        if conf.get("effect", "none") == "none":
            self.canvas.delete("appfx")
            return
        fx = getattr(self, "_fx_parts", None)
        if fx and fx["eff"] != self._fx_effect(conf):          # a new season
            self._fx_parts = None
            self.redraw()
            fx = None
        ok = self._anim_ok()
        if fx and self._fx_items and ok:
            import random
            sp = float(conf.get("speed", 1.0)) * 1.75          # one step every 70 ms (was 40 ms): same speed
            fx["t"] += sp
            W, H, eff = fx["W"], fx["H"], fx["eff"]
            for p in fx["parts"]:
                if eff == "bubbles":
                    p["y"] -= p["v"] * sp
                    if p["y"] < -30:
                        p["y"], p["x"] = H + 30, random.uniform(0, W)
                elif eff == "clouds":
                    p["x"] += p["v"] * sp
                    if p["x"] > W + 120:
                        p["x"] = -140
                elif eff == "bokeh":
                    p["x"] += p["vx"] * sp
                    p["y"] += p["vy"] * sp
                    if not -100 < p["x"] < W + 100:
                        p["vx"] *= -1
                    if not -100 < p["y"] < H + 100:
                        p["vy"] *= -1
                elif p.get("spr") == "butterfly":
                    import math as _m
                    p["vx"] = max(-1.1, min(1.1, p["vx"] + random.uniform(-0.08, 0.08)))
                    p["vy"] = max(-0.8, min(0.8, p["vy"] + random.uniform(-0.08, 0.08)))
                    p["x"] = (p["x"] + p["vx"] * sp) % W
                    p["y"] = (p["y"] + p["vy"] * sp + _m.sin(fx["t"] * 0.2 + p["ph"]) * 0.6) % H
                    p["a"] = _m.degrees(_m.atan2(p["vx"], -p["vy"]))
                    if p["glide"] > 0:
                        p["glide"] -= 1
                    elif random.random() < 0.02:
                        p["glide"] = random.randint(8, 20)          # it glides a moment, wings open
                    p["k"] += 1
                elif p.get("spr") == "seed":
                    p["x"] += p["vx"] * sp
                    p["y"] -= 0.12 * sp
                    if p["x"] > W + 40 or p["y"] < -40:
                        p["x"], p["y"] = random.uniform(-80, -20), random.uniform(H * 0.2, H)
                elif eff in ("snow", "petals", "leaves"):
                    p["y"] += p["v"] * sp
                    if "spin" in p:
                        p["a"] = (p["a"] + p["spin"] * sp) % 360
                    if eff != "snow":
                        p["x"] += 0.25 * sp
                    if p["y"] > H + 20 + p.get("size", 0) / 2:
                        p["y"], p["x"] = -20 - p.get("size", 0) / 2, random.uniform(-40, W)
                    if p["x"] > W + 30:
                        p["x"] = -30
                elif eff == "rain":
                    if p["k"] == "line":
                        p["y"] += p["v"] * sp
                        p["x"] -= p["v"] * 0.18 * sp
                        if p["y"] > H + 30:
                            p["y"], p["x"] = -30, random.uniform(0, W + 60)
                    elif p["v"] <= 0:
                        p["rest"] -= sp
                        if p["rest"] <= 0 and p["r"] > 2.6:          # heavy enough: it starts to slide
                            p["v"] = random.uniform(0.6, 2.2)
                        elif p["rest"] <= 0:
                            p["rest"] = random.uniform(100, 400)
                            p["r"] += 0.4                               # it grows a little (more rain)
                    else:
                        p["y"] += p["v"] * sp
                        p["x"] += random.uniform(-0.35, 0.35)
                        if p["y"] > H + 10:
                            p.update(y=random.uniform(-10, H * 0.6), x=random.uniform(0, W), v=0.0,
                                     r=random.uniform(1.6, 3.0), rest=random.uniform(50, 400))
                elif eff == "fireflies":
                    p["vx"] = max(-0.6, min(0.6, p["vx"] + random.uniform(-0.05, 0.05)))
                    p["vy"] = max(-0.5, min(0.5, p["vy"] + random.uniform(-0.05, 0.05)))
                    p["x"] = (p["x"] + p["vx"] * sp) % W
                    p["y"] = (p["y"] + p["vy"] * sp) % H
            c = self.canvas
            try:
                self._fx_place(c.canvasx(0), c.canvasy(0))
            except Exception:
                pass
        self._fx_job = self.root.after(70 if ok else 300, self._fx_tick)

    def _on_resize(self, e):
        if getattr(self, "_bg_resize_job", None):
            self.root.after_cancel(self._bg_resize_job)
        if self._bg_conf().get("mode", "none") != "none":
            self._bg_resize_job = self.root.after(200, lambda: (self._bg_rebuild(), self.redraw()))
        if not self.book:
            self.redraw()
            return
        if self.fit_mode and (abs(e.width - self._last_w) > 2 or
                              (self.fit_mode == "page" and abs(e.height - getattr(self, "_last_h", e.height)) > 2)):
            # 3.0: while the window is being resized the pages are fitted once, when it stops (not at every step)
            self._last_w = e.width
            self._last_h = e.height
            if getattr(self, "_fit_job", None):
                self.root.after_cancel(self._fit_job)

            def fit():
                self._fit_job = None
                if self.book and self.fit_mode:
                    self._apply_zoom(self._fit_zoom(self.fit_mode))
            self._fit_job = self.root.after(140, fit)
            self._layout()
            self.redraw()
        else:
            self._last_h = e.height
            self._layout()
            self.redraw()

    # ---- 1.9: beside the page - a map of the whole book on the left, a real clock on the right ----------------
    SIDE_LEFT = OrderedDict([("map", "Map of the book"), ("off", "Nothing")])
    SIDE_RIGHT = OrderedDict([("analog", "Clock"), ("station", "Station clock"), ("ring", "Rings"),
                              ("digital", "Digital clock"), ("words", "Time in words"), ("flip", "Flip clock"),
                              ("off", "Nothing")])
    CLOCK_ROUND = ("analog", "station", "ring")
    CLOCK_SIZES = OrderedDict([("s", "Small"), ("m", "Medium"), ("l", "Large")])

    def _beside_conf(self):
        c = dict(self.lib.settings.get("beside") or {})
        c.setdefault("left", "map")
        c.setdefault("right", "analog")
        c.setdefault("date", True)
        c.setdefault("deadline", True)
        c.setdefault("anim", True)            # 2.0: the clocks' moving parts (seconds, flaps, the reading sky)
        c.setdefault("calendar", True)        # 3.2: a calendar under the clock
        c.setdefault("clock_left", False)     # 3.2: clock (and calendar) on the left, the map on the right
        c.setdefault("size", "m")
        return c

    def _sides_init(self):
        """Two small cards in the empty space beside the pages (only when there is room for them)."""
        self._side_l = tk.Canvas(self.view, highlightthickness=0, bd=0, cursor="hand2")
        self._side_r = tk.Canvas(self.view, highlightthickness=0, bd=0, cursor="hand2")
        self._sides_geo = {"l": None, "r": None}
        self._sides_sig = {"l": None, "r": None}
        self._map_off = 0
        self._map_hover = None
        L, R = self._side_l, self._side_r
        L.bind("<Motion>", self._map_motion)
        L.bind("<Leave>", lambda e: (setattr(self, "_map_hover", None), setattr(self, "_map_btn_hover", None),
                                     self._map_release(), self._map_draw()))
        L.bind("<Button-1>", self._map_click)
        L.bind("<ButtonRelease-1>", self._map_release)
        L.bind("<B1-Motion>", self._map_drag)                 # 3.2: drag the bar's pill
        L.bind("<Double-Button-1>", self._map_double)         # 3.2: double-click ▲ / ▼ = the start / the end
        L.bind("<Button-3>", lambda e: self._side_menu(e, "left"))
        R.bind("<ButtonPress-1>", self._clk_press)               # 4.2: drag the clock anywhere, click as before
        R.bind("<B1-Motion>", self._clk_drag)
        R.bind("<ButtonRelease-1>", self._clk_release)
        R.bind("<Double-Button-1>", self._clock_double)          # 4.1: double-click = another clock
        R.bind("<Button-3>", lambda e: self._side_menu(e, "right"))
        # 4.0: the calendar is a card of its own - drag it anywhere, it stays where you leave it
        C_ = self._side_c = tk.Canvas(self.view, highlightthickness=0, bd=0, cursor="hand2")
        self._sides_geo["c"], self._sides_sig["c"] = None, None
        C_.bind("<ButtonPress-1>", self._calc_press)
        C_.bind("<B1-Motion>", self._calc_drag)
        C_.bind("<ButtonRelease-1>", self._calc_release)
        C_.bind("<Motion>", self._cal_motion)
        C_.bind("<Button-3>", self._calc_menu)
        if sys.platform == "darwin":
            C_.bind("<Button-2>", self._calc_menu)
        for seq in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            C_.bind(seq, lambda e: self._wheel_units(-3 if (getattr(e, "delta", 0) > 0 or
                                                              getattr(e, "num", 0) == 4) else 3))
        self.root.after(20000, self._cal_hourly)              # 3.2: imported calendars, today's notes
        for w in (L, R):
            for seq in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
                w.bind(seq, lambda e, w=w: self._side_wheel(e, w))
        self.root.after(1000, self._clock_tick)

    def _side_menu(self, e, side):
        m = self._menu()
        conf = self._beside_conf()
        opts = self.SIDE_LEFT if side == "left" else self.SIDE_RIGHT
        for k, lab in opts.items():
            m.add_radiobutton(label=lab, command=lambda k=k: self._set_beside(side, k),
                              variable=tk.StringVar(value=conf[side]), value=k)
        if side == "right":
            m.add_separator()
            m.add_checkbutton(label="Date", command=lambda: self._set_beside("date", not conf["date"]),
                              variable=tk.BooleanVar(value=conf["date"]))
            m.add_checkbutton(label="Next deadline", command=lambda: self._set_beside("deadline",
                                                                                     not conf["deadline"]),
                              variable=tk.BooleanVar(value=conf["deadline"]))
            m.add_checkbutton(label="Animation (moving seconds, stars…)",
                              command=lambda: self._set_beside("anim", not conf["anim"]),
                              variable=tk.BooleanVar(value=conf["anim"]))
            zm = self._menu(m)
            for k, lab in self.CLOCK_SIZES.items():
                zm.add_radiobutton(label=lab, value=k, variable=tk.StringVar(value=conf.get("size", "m")),
                                   command=lambda k=k: self._set_beside("size", k))
            m.add_cascade(label="Size of the clock", menu=zm)
            m.add_separator()                        # 3.2: the calendar
            m.add_checkbutton(label="Calendar under the clock",
                              command=lambda: self._set_beside("calendar", not conf["calendar"]),
                              variable=tk.BooleanVar(value=conf["calendar"]))
            m.add_checkbutton(label="Clock and calendar on the left",
                              command=lambda: self._set_beside("clock_left", not conf["clock_left"]),
                              variable=tk.BooleanVar(value=conf["clock_left"]))
            import datetime
            m.add_command(label="Add a note for today…", command=lambda: self._cal_day_dialog(datetime.date.today()))
            m.add_command(label="Announcement…", command=self._cal_pin_dialog)
            m.add_command(label="Bring in a calendar (file or link)…", command=self.calendar_settings)
            m.add_command(label="Calendar settings…", command=self.calendar_settings)
        if side == "right" and (conf.get("clock_pos") or conf.get("read_clock_pos")):
            m.add_command(label="Put the clock back", command=lambda: (self._set_beside("clock_pos", None),
                                                                       self._set_beside("read_clock_pos", None)))
        m.add_separator()
        m.add_command(label="Personalise…", command=self.personalise_dialog)
        self._popup(m, e)

    def _set_beside(self, key, val):
        conf = self._beside_conf()
        conf[key] = val
        self.lib.settings["beside"] = conf
        self.lib.save_meta()
        self._sides_sig = {"l": None, "r": None}
        self._sides_update()

    def _side_wheel(self, e, w):
        up = getattr(e, "delta", 0) > 0 or getattr(e, "num", 0) == 4
        if w is self._side_l and self._map_scrollable():
            self._map_off = max(0, self._map_off + (-3 if up else 3))
            self._map_draw()
        else:
            self._wheel_units(-3 if up else 3)

    def _sides_update(self):
        """Place (or hide) the two cards: called after every redraw - cheap when nothing changed."""
        if not hasattr(self, "_side_l"):
            return
        conf = self._beside_conf()
        reading = bool(getattr(self, "_reading", False))
        if reading:
            rc = conf.get("read_clock", "sky")             # 4.1: double-click the clock to change it
            rdc = self._read_conf()                         # 4.2: contents / clock on or off while reading
            conf = dict(conf, left="toc" if rdc.get("toc", True) else "off",
                        right=("desk" if rc == "sky" else rc) if rdc.get("clock", True) else "off")
            sig_b = (self.folder, self.prefix, self.current_page, self.canvas.winfo_width(), self.T["canvas"],
                     self.accent, id(getattr(self, "_bg_photo", None)))
            if sig_b != getattr(self, "_read_bar_sig", None):
                self._read_bar_sig = sig_b
                self._read_bar_draw()
        c = self.canvas
        vw, vh = c.winfo_width(), c.winfo_height()
        L = R = None
        cg = cx_ = 0
        try:
            ok = bool(self.book and self.book.total and len(self.page_tops) == self.book.total) and vw > 300 \
                and getattr(self, "page_lefts", None) is None          # 4.2: the grid of pages fills the window
        except Exception:
            ok = False
        xl = pw = 0
        if ok:
            g = max(0, min(self.current_page, self.book.total - 1))
            x, _y = self._page_xy(g)
            xl = x - c.canvasx(0)
            pw = self._page_w(g)
            lg, rg = xl, vw - (xl + pw)
            swap = bool(conf.get("clock_left")) and not reading   # 3.2: the clock (and calendar) on the left
            mg, mx = (rg, xl + pw) if swap else (lg, 0)           # the map's space and where it starts
            cg, cx_ = (lg, 0) if swap else (rg, xl + pw)          # the clock's
            # 4.2: the page stays in the middle - when it grows, the cards beside it get narrower first, then hide
            if conf["left"] == "map" and mg >= 150:
                w = int(min(290, mg - (36 if mg >= 196 else 20)))
                h = int(min(vh - 44, self._map_need_h()))
                L = (int(mx + (mg - w) / 2), 22, w, max(120, h))
            elif conf["left"] == "toc" and lg >= 170:
                w = int(min(330, lg - (40 if lg >= 210 else 22)))
                h = int(min(vh - 70, 100 + self.SHELF_H + len(self._map_rows()) * 27 + 52))
                L = (int((lg - w) / 2), 60, w, max(160, h))
            if conf["right"] == "desk" and rg >= 150:
                w = int(min(250, rg - (40 if rg >= 180 else 20)))
                R = (int(xl + pw + (rg - w) / 2), 60, w, min(vh - 70, self._desk_h(w)))
            elif conf["right"] not in ("off", "desk") and cg >= 132:
                w = int(min(250, cg - (36 if cg >= 160 else 18)))
                y_ = 60 if reading else 22
                R = (int(cx_ + (cg - w) / 2), y_, w, int(min(vh - y_ - 8, self._clock_h(w, conf))))
            # 4.2: the clock where you dragged it (it keeps to that corner of the window)
            cpos = conf.get("read_clock_pos" if reading else "clock_pos")
            if cpos and conf["right"] != "off":
                w = 220 if R is None else R[2]
                h = int(min(vh - 8, self._desk_h(w) if (reading and conf["right"] == "desk") else
                            self._clock_h(w, conf)))
                cor = cpos.get("corner", "tr")
                x_ = cpos.get("x", 20) if cor in ("tl", "bl") else vw - w - cpos.get("x", 20)
                y_ = cpos.get("y", 20) if cor in ("tl", "tr") else vh - h - cpos.get("y", 20)
                R = (int(max(4, min(vw - w - 4, x_))), int(max(4, min(vh - h - 4, y_))), w, h)

        def over(geo):                     # 4.2: a card never lies on the page - it hides until there is room
            return geo is not None and geo[0] < xl + pw - 2 and geo[0] + geo[2] > xl + 2
        if over(R):
            R = None
        Cg = None
        if ok and conf.get("calendar") and not reading and hasattr(self, "_side_c"):
            Cg = self._calc_geo(vw, vh, R, max(cg, 0), cx_)
            if over(Cg):
                Cg = None
        self._calc_place(Cg)
        bgid = id(getattr(self, "_bg_photo", None))
        for key, w_, geo in (("l", self._side_l, L), ("r", self._side_r, R)):
            if geo is None:
                if self._sides_geo[key] is not None:
                    w_.place_forget()
                    self._sides_geo[key] = None
                continue
            if geo != self._sides_geo[key]:
                w_.configure(width=geo[2], height=geo[3])
                w_.place(in_=c, x=geo[0], y=geo[1])
                w_.tk.call("raise", w_._w)
                self._sides_geo[key] = geo
                self._sides_sig[key] = None
            base = (geo, bgid, self.T["canvas"], self.accent, conf[key == "l" and "left" or "right"])
            if key == "l":
                fi = self.book.pages[g][0]
                f = self.book.files[fi]
                pct = int(100 * (g - f["first"] + 1) / max(1, f["count"]))
                if getattr(self, "_map_last_fi", None) != (id(self.book), fi):
                    self._map_last_fi = (id(self.book), fi)
                    self._map_off = 0                     # a new document: the map follows you
                sig = base + (id(self.book), len(self.book.files), fi, pct // 2, self._map_off, self._map_hover,
                              g * 100 // max(1, self.book.total), self._part_at(fi, g - f["first"]),
                              len(self._map_rows()))
                if sig != self._sides_sig["l"]:
                    self._sides_sig["l"] = sig
                    self._map_draw()
            else:
                sig = base + (conf["date"], conf["deadline"], bool(getattr(self, "_attention", None)),
                              conf.get("calendar"), conf.get("size"), getattr(self, "_cal_ver", 0),
                              time.strftime("%Y-%m-%d"), id(getattr(self, "_attention", None)))
                if sig != self._sides_sig["r"]:
                    self._sides_sig["r"] = sig
                    self._clock_draw(full=True)

    def _side_bg(self, cv, key, fill=None):
        """The card's corners show what is behind the pages (picture, colours) - the card seems to float on it."""
        geo = self._sides_geo[key]
        cv.delete("all")
        cv.configure(bg=self.T["canvas"])
        ph = getattr(self, "_bg_photo", None)
        if ph is not None and geo:
            cv.create_image(-geo[0], -geo[1], image=ph, anchor="nw")
        w, h = geo[2], geo[3]
        T = self.T
        if getattr(self, "_reading", False):              # 4.1: reading - quiet cards, no shadow, no line
            card = fill or mix(T["panel"], T["canvas"], 0.35)
            round_rect(cv, 1, 1, w - 2, h - 2, 18, fill=card, outline="")
            return card
        card = fill or mix(T["panel"], T["canvas"], 0.12)
        round_rect(cv, 2, 3, w - 1, h, 16, fill=mix(T["canvas"], "#000000", 0.08), outline="")
        round_rect(cv, 1, 1, w - 2, h - 2, 16, fill=card, outline=mix(card, T["border"], 0.6))
        return card

    # ---- the map of the book
    def _map_rows(self):
        b = self.book
        key = (id(b), len(b.files), self.prefix, self.folder)
        if getattr(self, "_map_rows_c", (None,))[0] == key:
            return self._map_rows_parts(key, self._map_rows_c[1])
        rows = []
        pre = self.prefix or ""
        last = None
        for fi, f in enumerate(b.files):
            rel = f["rel"]
            sub = rel[len(pre):] if pre and rel.startswith(pre) else rel
            dn = os.path.dirname(sub)
            if dn != last:
                if dn or last is not None:
                    rows.append(("sec", dn.replace("/", "  ›  ") if dn else self.lib.label(self.folder), fi))
                last = dn
            rows.append(("doc", fi))
        self._map_rows_c = (key, rows)
        return self._map_rows_parts(key, rows)

    def _map_rows_parts(self, key, rows):
        """1.9.4: under the document you are reading, its parts (chapters, sections) - found in its bookmarks,
        its contents page or its headings."""
        b = self.book
        try:
            fi = b.pages[max(0, min(self.current_page, b.total - 1))][0]
        except Exception:
            return rows
        vis = self._sec_vis(fi)
        if not vis:
            return rows
        k2 = (key, fi, id(vis))
        c2 = getattr(self, "_map_rows_c2", (None,))
        if c2[0] == k2:
            return c2[1]
        i = next((j for j, r in enumerate(rows) if r[0] == "doc" and r[1] == fi), None)
        if i is None:
            return rows
        out = rows[:i + 1] + [("part", fi, k) for k in range(len(vis))] + rows[i + 1:]
        self._map_rows_c2 = (k2, out)
        return out

    # ---- 1.9.4: the parts of a document --------------------------------------------------------------------
    SEC_VERSION = 1

    def _sec_store(self):
        st = self.__dict__.get("_secs")
        if st is None:
            st = OrderedDict()
            try:
                with gzip.open(os.path.join(self.lib.meta_dir, "sections.json.gz"), "rt", encoding="utf-8") as fh:
                    d = json.load(fh)
                if d.get("v") == self.SEC_VERSION:
                    st.update(d.get("docs", {}))
            except Exception:
                pass
            self._secs, self._sec_pending, self._sec_viscache = st, set(), {}
        return st

    def _sec_save(self):
        st = self._sec_store()
        while len(st) > 600:
            st.popitem(last=False)
        snap = {"v": self.SEC_VERSION, "docs": dict(st)}
        path = os.path.join(self.lib.meta_dir, "sections.json.gz")

        def work():
            try:
                save_json_gz(path, snap)
            except Exception:
                pass
        threading.Thread(target=work, daemon=True).start()

    def _sections(self, fi):
        """The parts of document fi as [level, title, page, y] - None while BindLens is still finding them
        (a helper reads the document; the map shows them as soon as they are known)."""
        b = self.book
        f = b.files[fi]
        if f["error"] or f["count"] < 2 or is_outside(f["path"]):
            return []
        st = self._sec_store()
        e = st.get(f["key"])
        if e is not None and e.get("n") == f["count"]:
            return e.get("items") or []
        if f["key"] in self._sec_pending:
            return None
        key, path, count = f["key"], f["path"], f["count"]
        self._sec_pending.add(key)

        def got(res):
            self._sec_pending.discard(key)
            if res.get("fallback"):
                try:
                    d_ = open_light(self.fitz, path)
                    try:
                        res = doc_sections(self.fitz, d_)
                    finally:
                        d_.close()
                except Exception as ex:
                    res = {"err": str(ex)}
            if res.get("cancelled"):
                return
            st[key] = {"n": res.get("n", count) if "items" in res else count, "src": res.get("src"),
                       "items": res.get("items") or []}
            st.move_to_end(key)
            self._sec_viscache.pop(key, None)
            self._sec_save()
            self._map_rows_c2 = (None,)
            if hasattr(self, "_sides_sig"):
                self._sides_sig["l"] = None
                self._sides_update()
        self.pool.submit("sections", prio=6, timeout=240, path=path, cb=got)
        return None

    def _sec_vis(self, fi):
        """The parts shown in the map: the main levels only when there are many."""
        try:
            items = self._sections(fi)
        except Exception:
            return None
        f_ = self.book.files[fi]
        if items is not None and not items and f_["count"] >= 16 and not f_["error"]:
            # 3.2: a long document without chapters still gets a little index - by pages
            n_ = f_["count"]
            step = 10 if n_ <= 120 else -(-n_ // 12)
            key_ = ("pages", f_["key"], n_)
            c_ = self._sec_viscache.get(key_)
            if c_ is None:
                c_ = [[1, f"Pages {a + 1} - {min(n_, a + step)}", a, None] for a in range(0, n_, step)]
                self._sec_viscache[key_] = c_
            return c_
        if not items:
            return None
        key = self.book.files[fi]["key"]
        c = self._sec_viscache.get(key)
        if c is not None and c[0] is items:
            return c[1]
        vis = list(items)
        while len(vis) > 90 and max(i[0] for i in vis) > 1:
            top = max(i[0] for i in vis)
            vis = [i for i in vis if i[0] < top]
        if vis:
            lo = min(i[0] for i in vis)
            vis = [[i[0] - lo + 1] + list(i[1:]) for i in vis]
        self._sec_viscache[key] = (items, vis)
        return vis

    def _part_at(self, fi, pi):
        """Which part of document fi page pi is in (-1: before the first part / no parts)."""
        vis = self._sec_vis(fi) if self.book else None
        best, bp = -1, -1
        for k, it in enumerate(vis or ()):
            if bp <= it[2] <= pi:
                best, bp = k, it[2]
        return best

    def _map_need_h(self):
        try:
            n = len(self._map_rows())
        except Exception:
            n = 4
        return 86 + self.SHELF_H - 6 + n * 25 + 14

    def _map_scrollable(self):
        geo = self._sides_geo.get("l")
        if not geo or not self.book:
            return False
        return len(self._map_rows()) > getattr(self, "_map_fit", (geo[3] - 100) // 25)

    def _map_draw(self):
        if getattr(self, "_reading", False):
            return self._toc_draw()
        cv = self._side_l
        geo = self._sides_geo.get("l")
        if not geo or not self.book or not self.book.total:
            return
        T, A = self.T, self.accent
        card = self._side_bg(cv, "l")
        w, h = geo[2], geo[3]
        b = self.book
        g = max(0, min(self.current_page, b.total - 1))
        cur_fi = b.pages[g][0]
        f = b.files[cur_fi]
        pct = (g - f["first"] + 1) / max(1, f["count"])
        name = self.lib.label(self.folder) + (" / " + self.prefix.rstrip("/").split("/")[-1] if self.prefix else "")
        col = self.lib.color(self.folder)
        # the book: name, how far you are
        cv.create_oval(16, 15, 26, 25, fill=col, outline="")
        t_ = self._fit_text(name, self._sfont(10, "bold"), w - 50)
        cv.create_text(34, 20, text=t_, anchor="w", font=self.F(10, "bold"), fill=T["text"])
        allp = (g + 1) / b.total
        self._map_btns = []
        sy = self._shelf(cv, 16, 34, w - 16, card, T["text"], cur_fi, g)       # 1.9.9: a little bookshelf
        vis = self._sec_vis(cur_fi) or []
        cur_k = self._part_at(cur_fi, g - f["first"]) if vis else -1
        if vis and len(b.files) == 1:
            info = f"Part {max(1, cur_k + 1)} of {len(vis)}"
        elif vis:
            info = f"Document {cur_fi + 1} of {len(b.files)}  ·  part {max(1, cur_k + 1)} of {len(vis)}"
        else:
            info = f"Document {cur_fi + 1} of {len(b.files)}"
        cv.create_text(16, sy + 10, text=self._fit_text(info, self._sfont(8), w - 32), anchor="w", font=self.F(8),
                       fill=T["muted"])
        cv.create_line(14, sy + 26, w - 14, sy + 26, fill=mix(card, T["border"], 0.6))
        rows = self._map_rows()
        RH = 25
        y0 = sy + 36
        fit = max(1, (h - y0 - 10) // RH)
        self._map_fit = fit
        cur_row = next(i for i, r in enumerate(rows) if r[0] == "doc" and r[1] == cur_fi)
        if cur_k >= 0:
            cur_row = next((i for i, r in enumerate(rows) if r[0] == "part" and r[2] == cur_k), cur_row)
        base = max(0, min(len(rows) - fit, cur_row - fit // 3))
        if len(rows) <= fit:
            start = base = 0
        else:
            start = max(0, min(len(rows) - fit, base + self._map_off))
            self._map_off = start - base
        self._map_geom = (base, fit, len(rows))
        shown = rows[start:start + fit]
        self._map_hits = []
        x_line = 26
        pi_now = g - f["first"]
        ys = [y0 + i * RH + RH / 2 for i in range(len(shown))]
        if ys:
            top_y = ys[0] - (RH / 2 if start > 0 else 0)
            bot_y = ys[-1] + (RH / 2 if start + fit < len(rows) else 0)
            cv.create_line(x_line, top_y, x_line, bot_y, fill=mix(card, T["border"], 0.9), width=2)
        sbw = 0
        if len(rows) > fit:                 # 1.9.3: round ▲ ▼ buttons and a pill to go through a long list
            sbw = 24
            self._map_scroller(cv, w - 18, y0 + 1, y0 + fit * RH - 1, start, fit, len(rows), card)
        w = w - sbw
        # 3.2: the index of the long document you are in comes up softly under it, on a light see-through
        # panel - and goes away when you leave that document (the folder's index carries on)
        fade = 1.0
        if vis:
            if getattr(self, "_parts_for", None) != (cur_fi, f["key"]):
                self._parts_for, self._parts_t0 = (cur_fi, f["key"]), time.time()
            fade = min(1.0, (time.time() - self._parts_t0) / 0.45)
            if fade < 1.0:
                job = getattr(self, "_parts_job", None)
                if job:
                    self.root.after_cancel(job)
                self._parts_job = self.root.after(50, lambda: (setattr(self, "_parts_job", None), self._map_draw()))
            idx = [i for i, r in enumerate(shown) if r[0] == "part"]
            if idx:
                py0 = ys[idx[0]] - RH / 2 + 1
                py1 = ys[idx[-1]] + RH / 2 - 1
                round_rect(cv, x_line + 8, py0, w - 6, py1, 9, fill=mix(card, A, 0.07 * fade),
                           outline=mix(card, A, 0.22 * fade))
        else:
            self._parts_for = None
        fn = self._sfont(9)
        fbd = self._sfont(9, "bold")
        for i, r in enumerate(shown):
            yc = ys[i]
            if r[0] == "part":                 # a chapter / section of the document you are reading
                k = r[2]
                lvl, title, ppi = vis[k][0], vis[k][1], vis[k][2]
                hit = ("part", r[1], ppi, vis[k][3] if len(vis[k]) > 3 else None)
                on = k == cur_k
                ind = x_line + 14 + (min(lvl, 3) - 1) * 11
                if on:
                    round_rect(cv, ind - 6, yc - RH / 2 + 2, w - 10, yc + RH / 2 - 2, 7, fill=mix(card, A, 0.2),
                               outline="")
                elif self._map_hover == hit:
                    round_rect(cv, ind - 6, yc - RH / 2 + 2, w - 10, yc + RH / 2 - 2, 7, fill=mix(card, A, 0.09),
                               outline="")
                done = ppi < pi_now and not on
                rr_ = 3.2 if lvl == 1 else 2.4
                cv.create_line(x_line + 4, yc, ind - 8, yc, fill=mix(card, A, 0.45 if (on or done) else 0.2))
                cv.create_oval(x_line - rr_, yc - rr_, x_line + rr_, yc + rr_,
                               fill=A if on else (mix(card, A, 0.5) if done else card),
                               outline=A if on else (mix(card, A, 0.5) if done else T["muted"]), width=1)
                fnt = self._sfont(8, "bold") if (on or lvl == 1) else self._sfont(8)
                pg = f"p.{ppi + 1}"
                pw = self._measure(pg, self._sfont(7)) + 8
                tcol = A if on else (mix(T["text"], card, 0.35) if done else mix(T["text"], A, 0.18))
                cv.create_text(ind, yc, text=self._fit_text(title, fnt, w - ind - 18 - pw), anchor="w",
                               font=self.F(8, "bold") if (on or lvl == 1) else self.F(8),
                               fill=mix(card, tcol, fade))
                cv.create_text(w - 16, yc, text=pg, anchor="e", font=self.F(7), fill=A if on else T["muted"])
                self._map_hits.append((yc - RH / 2, yc + RH / 2, hit))
                continue
            if r[0] == "sec":
                cv.create_rectangle(x_line - 6, yc - 5, x_line + 6, yc + 5, fill=card, outline=col, width=1.5)
                cv.create_line(x_line - 6, yc - 2, x_line + 6, yc - 2, fill=col)
                cv.create_text(x_line + 16, yc, text=self._fit_text(r[1].upper(), fbd, w - x_line - 34), anchor="w",
                               font=self.F(8, "bold"), fill=col)
                self._map_hits.append((yc - RH / 2, yc + RH / 2, r[2]))
                continue
            fi = r[1]
            ff = b.files[fi]
            on = fi == cur_fi
            if self._map_hover == fi and not on:
                round_rect(cv, 10, yc - RH / 2 + 1, w - 10, yc + RH / 2 - 1, 8, fill=mix(card, A, 0.1), outline="")
            if on:
                round_rect(cv, 10, yc - RH / 2 + 1, w - 10, yc + RH / 2 - 1, 8, fill=mix(card, A, 0.16), outline="")
                cv.create_oval(x_line - 10, yc - 10, x_line + 10, yc + 10, fill=mix(card, A, 0.25), outline="")
                cv.create_arc(x_line - 9, yc - 9, x_line + 9, yc + 9, start=90, extent=-359.9 * min(1.0, pct),
                              style="arc", outline=A, width=2.5)
                cv.create_oval(x_line - 4.5, yc - 4.5, x_line + 4.5, yc + 4.5, fill=A, outline="")
            elif fi < cur_fi:
                cv.create_oval(x_line - 4, yc - 4, x_line + 4, yc + 4, fill=mix(card, A, 0.55), outline="")
            else:
                cv.create_oval(x_line - 4, yc - 4, x_line + 4, yc + 4, fill=card, outline=T["muted"], width=1.2)
            label = os.path.splitext(os.path.basename(ff["rel"]))[0]
            right = f"{int(pct * 100)}%" if on else str(ff["count"])
            rw = self._measure(right, fn) + 8
            cv.create_text(x_line + 16, yc, text=self._fit_text(label, fbd if on else fn, w - x_line - 34 - rw),
                           anchor="w", font=self.F(9, "bold") if on else self.F(9),
                           fill=A if on else (T["text"] if fi > cur_fi else mix(T["text"], card, 0.3)))
            cv.create_text(w - 16, yc, text=right, anchor="e", font=self.F(8), fill=A if on else T["muted"])
            self._map_hits.append((yc - RH / 2, yc + RH / 2, fi))

    def _sfont(self, size, weight="normal"):
        """A Tk font object, made once (measuring text with it is quick)."""
        cache = self.__dict__.setdefault("_sfonts", {})
        key = (size, weight, self.F(size, weight))
        if key not in cache:
            cache[key] = tkfont.Font(font=self.F(size, weight))
        return cache[key]

    def _measure(self, t, font):
        cache = self.__dict__.setdefault("_meas", {})
        key = (t, font.name)
        if key not in cache:
            if len(cache) > 6000:
                cache.clear()
            cache[key] = font.measure(t)
        return cache[key]

    def _fit_text(self, t, font, maxw):
        """t, cut with … to fit maxw pixels (a few measures, remembered)."""
        cache = self.__dict__.setdefault("_fits", {})
        key = (t, font.name, int(maxw))
        if key in cache:
            return cache[key]
        if len(cache) > 4000:
            cache.clear()
        if self._measure(t, font) <= maxw:
            out = t
        else:
            lo, hi = 0, len(t)
            while lo < hi:
                mid = (lo + hi + 1) // 2
                if self._measure(t[:mid].rstrip() + "…", font) <= maxw:
                    lo = mid
                else:
                    hi = mid - 1
            out = t[:lo].rstrip() + "…"
        cache[key] = out
        return out

    SHELF_H = 58

    def _shelf_units(self):
        """The books on the little shelf: one per document - or, when the book is a single document, one per
        part of it (its contents) or per page. Each unit: (name, first page in the book, pages)."""
        b = self.book
        if len(b.files) > 1:
            return [(f["rel"], f["first"], max(1, f["count"])) for f in b.files], "document"
        f = b.files[0]
        n = max(1, f["count"])
        vis = [v for v in (self._sec_vis(0) or []) if v[0] == 1]
        starts = sorted({max(0, min(n - 1, v[2])) for v in vis})
        if len(starts) >= 2:
            names = {}
            for v in vis:
                names.setdefault(max(0, min(n - 1, v[2])), v[1])
            if starts[0] > 0:
                starts.insert(0, 0)
                names[0] = "Before the contents"
            out = []
            for i, st in enumerate(starts):
                en = starts[i + 1] if i + 1 < len(starts) else n
                out.append((names.get(st, ""), f["first"] + st, max(1, en - st)))
            return out, "part"
        return [(f"Page {i + 1}", f["first"] + i, 1) for i in range(n)], "page"

    def _shelf(self, cv, x0, y0, x1, card, ink, cur_fi, g, serif=False):
        """1.9.9 - above the index: a little bookshelf of the book. A big number (how many documents), the pages and
        how far you have read - and each document as a book on the shelf, as tall as its pages: the ones you have
        read in your colour, the one you are in bright, the rest pale. A single long document shows its parts (or
        its pages) instead. Click a book on the shelf to go there. Returns the y under it."""
        import math
        T, A = self.T, self.accent
        b = self.book
        total = b.total
        allp = (g + 1) / max(1, total)
        units, kind = self._shelf_units()
        self._shelf_list = units
        if kind == "document":
            num, lab = len(units), ("document" if len(units) == 1 else "documents")
        elif kind == "part":
            num, lab = len(units), "parts"
        else:
            num, lab = total, ("page" if total == 1 else "pages")
        # the number
        big = self._text_img(str(num), 30, ink, style="serif" if serif else "sans_b")
        cv.create_image(x0 - 1, y0 + 2, image=big[0], anchor="nw")
        cv.create_text(x0, y0 + big[2] + 9, text=lab, anchor="w", font=self.F(7, "bold"), fill=T["muted"])
        nx = x0 + max(big[1], self._measure(lab, self._sfont(7, "bold"))) + 14
        cv.create_text(x1, y0 + 6, text=f"{int(allp * 100)}%", anchor="e", font=self.F(9, "bold"), fill=A)
        pw_ = self._measure(f"{int(allp * 100)}%", self._sfont(9, "bold"))
        if kind != "page":
            cv.create_text(x1 - pw_ - 6, y0 + 6, text=f"{total} page{'s' if total != 1 else ''}  ·", anchor="e",
                           font=self.F(8), fill=T["muted"])
        else:
            cv.create_text(x1 - pw_ - 6, y0 + 6, text="read  ·", anchor="e", font=self.F(8), fill=T["muted"])
        # the shelf: one book per unit (or per group of them when there are very many)
        n = len(units)
        sx0, sx1 = nx, x1
        base = y0 + self.SHELF_H - 14
        top = y0 + 18
        room = max(10.0, sx1 - sx0)
        per = max(1, math.ceil(n / max(1, int(room // 4))))
        groups = [list(range(i, min(n, i + per))) for i in range(0, n, per)]
        sw = min(12.0, room / max(1, len(groups)))
        gap = 1.5 if sw >= 5 else 0.8
        sizes = [sum(units[k][2] for k in grp) for grp in groups]
        mx = max(sizes + [1])
        mn = min(sizes + [mx])
        hover = getattr(self, "_map_btn_hover", None)
        x = sx0 + (room - sw * len(groups)) / 2 if sw >= 12 else sx0
        bookcol = self.lib.color(self.folder)
        cur_u = 0
        for k, u in enumerate(units):
            if u[1] <= g:
                cur_u = k
        for gi, grp in enumerate(groups):
            pages = sizes[gi]
            # as tall as its pages (flat when every book is the same size - then they are just a row of books)
            frac = math.sqrt(pages / mx) if mx > mn else 0.82
            hh = max(7.0, (base - top) * frac)
            cur = cur_u in grp
            done = grp[-1] < cur_u
            colr = A if cur else (mix(card, A, 0.55) if done else mix(card, mix(bookcol, ink, 0.25), 0.28))
            key = f"spine:{grp[0]}"
            if hover == key:
                colr = mix(colr, ink, 0.25)
            x2 = x + sw - gap
            if x2 - x >= 3:
                round_rect(cv, x, base - hh, x2, base, min(2.0, (x2 - x) / 2), fill=colr, outline="")
                if sw >= 7 and hh > 12:                       # a band on the spine, like a real book
                    cv.create_line(x + 1, base - hh * 0.78, x2 - 1, base - hh * 0.78,
                                   fill=mix(colr, "#FFFFFF", 0.35))
            else:
                cv.create_rectangle(x, base - hh, max(x + 0.8, x2), base, fill=colr, outline="")
            if cur:
                cv.create_polygon((x + x2) / 2 - 3, base - hh - 7, (x + x2) / 2 + 3, base - hh - 7, (x + x2) / 2,
                                  base - hh - 3, fill=A, outline="")
            self._map_btns.append((x, top - 4, x + sw, base + 2, key, grp[0]))
            x += sw
        cv.create_line(sx0 - 2, base + 0.5, sx1, base + 0.5, fill=mix(card, ink, 0.45), width=1.5)   # the shelf
        return y0 + self.SHELF_H

    def _map_scroller(self, cv, x, ytop, ybot, start, fit, total, card):
        """The map's and the contents' scroll control (1.9.3): a round ▲ at the top, a round ▼ at the bottom
        (click, or hold them down) and a small pill between them that shows where you are - click the track to
        jump there. The mouse wheel works too."""
        T, A = self.T, self.accent
        hov = getattr(self, "_map_btn_hover", None)
        r = 9
        uy, dy = ytop + r + 1, ybot - r - 1
        t0, t1 = uy + r + 6, dy - r - 6
        round_rect(cv, x - r - 2, ytop - 1, x + r + 2, ybot + 1, r + 2, fill=mix(card, T["border"], 0.22), outline="")
        if t1 - t0 > 16:
            cv.create_line(x, t0, x, t1, fill=mix(card, T["border"], 0.85), width=6, capstyle="round")
            size = max(18.0, (t1 - t0) * fit / max(1, total))
            ty = t0 + (t1 - t0 - size) * (start / max(1, total - fit))
            on = hov == "track" or bool(getattr(self, "_map_tdrag", None))
            cv.create_line(x, ty + 3, x, ty + size - 3, fill=A if on else mix(card, A, 0.7), width=9 if on else 7,
                           capstyle="round")
            self._map_btns.append((x - r - 2, t0 - 2, x + r + 2, t1 + 2, "track", (t0, t1)))
        for key, y, up, ok in (("up", uy, True, start > 0), ("down", dy, False, start + fit < total)):
            hv = ok and hov == key
            cv.create_oval(x - r, y - r, x + r, y + r, fill=A if hv else (mix(card, A, 0.18) if ok else card),
                           outline=mix(card, A, 0.5) if ok else mix(card, T["border"], 0.7))
            ink = "#FFFFFF" if hv else (A if ok else mix(card, T["muted"], 0.5))
            d_ = 3.8
            pts = (x - d_, y + 1.8, x, y - 2.2, x + d_, y + 1.8) if up else (x - d_, y - 1.8, x, y + 2.2, x + d_, y - 1.8)
            cv.create_line(*pts, fill=ink, width=2.2, capstyle="round", joinstyle="round")
            if ok:
                self._map_btns.append((x - r - 3, y - r - 3, x + r + 3, y + r + 3, key, None))

    def _map_btn_at(self, e):
        for x0, y0, x1, y1, key, extra in getattr(self, "_map_btns", []):
            if x0 <= e.x <= x1 and y0 <= e.y <= y1:
                return key, extra
        return None, None

    def _map_scroll(self, n):
        self._map_off += n
        self._map_draw()

    def _map_at(self, e):
        if self._map_btn_at(e)[0] is not None:
            return None
        for y0, y1, fi in getattr(self, "_map_hits", []):
            if y0 <= e.y < y1:
                return fi
        return None

    def _map_motion(self, e):
        key, extra = self._map_btn_at(e)
        if key != getattr(self, "_map_btn_hover", None):
            self._map_btn_hover = key
            self._map_hover = None
            self._map_draw()
            units = getattr(self, "_shelf_list", None) or []
            if key and key.startswith("spine:") and self.book and 0 <= extra < len(units):
                nm, st, pc = units[extra]
                self.set_status(f"{nm}  ·  page {st + 1}{'' if pc == 1 else f' - {st + pc}'}  ·  click to go")
            elif key:
                self.set_status({"up": "Show the documents above (double-click: the first one)",
                                 "down": "Show the documents below (double-click: the last one)",
                                 "track": "Click to jump there, or drag the bar"}.get(key, "") +
                                "  ·  or turn the mouse wheel here")
            return
        if key:
            return
        fi = self._map_at(e)
        if fi != self._map_hover:
            self._map_hover = fi
            self._map_draw()
            if isinstance(fi, tuple) and self.book:
                f = self.book.files[fi[1]]
                vis = self._sec_vis(fi[1]) or []
                title = next((v[1] for v in vis if v[2] == fi[2]), "")
                self.set_status(f"{title}  ·  page {fi[2] + 1} of {os.path.basename(f['rel'])}  ·  click to go")
            elif fi is not None and self.book:
                f = self.book.files[fi]
                self.set_status(f"{f['rel']}  ·  {f['count']} page{'s' if f['count'] != 1 else ''}  ·  click to go")

    def _map_release(self, _e=None):
        job = getattr(self, "_map_rep", None)
        if job:
            self.root.after_cancel(job)
        self._map_rep = None
        if getattr(self, "_map_tdrag", None):
            self._map_tdrag = None
            self._map_draw()

    def _map_track_to(self, y, extra):
        base, fit, total = getattr(self, "_map_geom", (0, 1, 1))
        t0, t1 = extra
        frac = min(1.0, max(0.0, (y - t0) / max(1.0, t1 - t0)))
        off = int(round(frac * max(0, total - fit))) - base
        if off != self._map_off:
            self._map_off = off
            self._map_draw()

    def _map_drag(self, e):
        """3.2: the pill of the index's bar follows the mouse."""
        tr = getattr(self, "_map_tdrag", None)
        if tr:
            self._map_track_to(e.y, tr)

    def _map_double(self, e):
        key, _x = self._map_btn_at(e)
        if key not in ("up", "down"):
            return
        self._map_release()
        base, fit, total = getattr(self, "_map_geom", (0, 1, 1))
        self._map_off = (-base) if key == "up" else (max(0, total - fit) - base)
        self._map_draw()

    def _map_click(self, e):
        key, extra = self._map_btn_at(e)
        units = getattr(self, "_shelf_list", None) or []
        if key and key.startswith("spine:") and self.book and 0 <= extra < len(units):
            self._map_off = 0
            self.goto_page(units[extra][1])
            return
        if key in ("up", "down"):
            step = max(1, getattr(self, "_map_fit", 6) // 2) * (-1 if key == "up" else 1)
            self._map_scroll(step)

            n_ = [0]

            def again():                                   # held down: keep going - faster after a moment
                n_[0] += 1
                self._map_scroll((-1 if key == "up" else 1) * (1 if n_[0] < 8 else 3))
                self._map_rep = self.root.after(80, again)
            self._map_release()
            self._map_rep = self.root.after(380, again)
            return
        if key == "track":                                 # click = jump there; keep the button down = drag
            self._map_tdrag = extra
            self._map_track_to(e.y, extra)
            return
        fi = self._map_at(e)
        if fi is None or not self.book:
            return
        self._map_off = 0
        if isinstance(fi, tuple):                # a part of the document: exactly its page (and its place)
            f = self.book.files[fi[1]]
            g = f["first"] + max(0, min(f["count"] - 1, fi[2]))
            y = fi[3] if len(fi) > 3 and fi[3] else 0.0
            self.goto_page(g, frac=y) if y else self.goto_page(g)
            return
        self.goto_page(self.book.files[fi]["first"])

    # ---- the clock
    def _clock_D(self, w, conf):
        """The size of a round clock (3.2: small / medium / large)."""
        return min(w - 40, 150 * {"s": 0.72, "m": 1.0, "l": 1.25}.get(conf.get("size", "m"), 1.0))

    def _clock_h(self, w, conf):
        st = conf["right"]
        if st in self.CLOCK_ROUND:
            body = self._clock_D(w, conf)
        elif st == "flip":
            body = 78
        elif st == "words":
            body = 70
        else:
            body = 62
        h = 20 + body + 14
        if conf["date"]:
            h += 42
        if conf["deadline"] and getattr(self, "_attention", None) and self._attention.get("items"):
            h += 46
        return int(h + 8)

    def _clock_click(self, e):
        conf = self._beside_conf()
        if getattr(self, "_reading", False):
            if e.y > self._sides_geo["r"][3] - 56 and getattr(self, "_attention", None) and \
                    self._attention.get("items") and conf["deadline"]:
                self.reading_mode(False)
                self.simple_reports(pick="expiry", run=True, scope="library")
            return
        dl = getattr(self, "_dl_hit", None)
        if dl and dl[0] <= e.y <= dl[1]:
            self.simple_reports(pick="expiry", run=True, scope="library")
            return
        if e.y > getattr(self, "_clock_body_y1", 10 ** 6):
            return
        order = ["analog", "station", "ring", "digital", "words", "flip"]
        cur = conf["right"] if conf["right"] in order else "analog"
        self._set_beside("right", order[(order.index(cur) + 1) % len(order)])

    def _clock_double(self, _e=None):
        """4.1: double-click the clock - the next style (in reading mode too: the sky, then the other clocks)."""
        if getattr(self, "_reading", False):
            order = ["sky", "analog", "station", "ring", "digital", "words", "flip"]
            c = dict(self.lib.settings.get("beside") or {})
            cur = c.get("read_clock", "sky")
            c["read_clock"] = order[(order.index(cur) + 1) % len(order)] if cur in order else "sky"
            self.lib.settings["beside"] = c
            self.lib.save_meta()
            self._sides_sig = {"l": None, "r": None, "c": None}
            self._sides_geo["r"] = None
            self._sides_update()
            self.set_status("Clock: " + {"sky": "the sky"}.get(c["read_clock"],
                                                               self.SIDE_RIGHT.get(c["read_clock"], "")))

    def _clock_draw(self, full=False):
        import math
        rc = self._beside_conf().get("read_clock", "sky")
        if getattr(self, "_reading", False) and rc == "sky":
            return self._desk_draw(full)
        cv = self._side_r
        geo = self._sides_geo.get("r")
        if not geo:
            return
        T, A = self.T, self.accent
        conf = self._beside_conf()
        if getattr(self, "_reading", False):
            conf["right"] = rc
        now = time.localtime()
        w, h = geo[2], geo[3]
        if full:
            self._clock_card = self._side_bg(cv, "r")
            self._clock_static(cv, w, conf, now)
        card = self._clock_card
        cv.delete("hands")
        st = conf["right"]
        if st == "station":                             # 3.2: a railway station clock - the red seconds hand
            D = self._clock_D(w, conf)
            cx, cy, r = w / 2, 20 + D / 2, D / 2
            hh, mm, ss = now.tm_hour % 12, now.tm_min, now.tm_sec
            ink = "#1A1A1A"
            for ang, ln, tail, wd in (((hh + mm / 60) * 30, r * 0.56, r * 0.14, max(4, r * 0.1)),
                                      ((mm + ss / 60) * 6, r * 0.86, r * 0.16, max(3, r * 0.07))):
                a = math.radians(ang - 90)
                cv.create_line(cx - tail * math.cos(a), cy - tail * math.sin(a), cx + ln * math.cos(a),
                               cy + ln * math.sin(a), fill=ink, width=wd, tags="hands")
            if conf.get("anim", True):
                a = math.radians(ss * 6 - 90)
                red = "#D52B1E"
                cv.create_line(cx - r * 0.3 * math.cos(a), cy - r * 0.3 * math.sin(a), cx + r * 0.6 * math.cos(a),
                               cy + r * 0.6 * math.sin(a), fill=red, width=max(1.5, r * 0.025), tags="hands")
                ex_, ey_ = cx + r * 0.6 * math.cos(a), cy + r * 0.6 * math.sin(a)
                rr_ = max(3, r * 0.09)
                cv.create_oval(ex_ - rr_, ey_ - rr_, ex_ + rr_, ey_ + rr_, fill=red, outline="", tags="hands")
            cv.create_oval(cx - 3, cy - 3, cx + 3, cy + 3, fill=ink, outline="", tags="hands")
        elif st == "ring":                              # 3.2: rings that fill up - minutes outside, hours inside
            D = self._clock_D(w, conf)
            cx, cy, r = w / 2, 20 + D / 2, D / 2 - 6
            hh, mm, ss = now.tm_hour, now.tm_min, now.tm_sec
            ri = r - 15
            cv.create_arc(cx - r, cy - r, cx + r, cy + r, start=90, extent=-max(0.5, 359.9 * (mm + ss / 60) / 60),
                          style="arc", outline=A, width=9, tags="hands")
            cv.create_arc(cx - ri, cy - ri, cx + ri, cy + ri, start=90,
                          extent=-max(0.5, 359.9 * ((hh % 12) + mm / 60) / 12), style="arc",
                          outline=mix(A, card, 0.45), width=9, tags="hands")
            if conf.get("anim", True):
                a = math.radians(ss * 6 - 90)
                px_, py_ = cx + r * math.cos(a), cy + r * math.sin(a)
                cv.create_oval(px_ - 6, py_ - 6, px_ + 6, py_ + 6, fill=card, outline=A, width=2, tags="hands")
            big = self._text_img(time.strftime("%H:%M", now), int(max(14, min(34, D * 0.2))), T["text"], True)
            cv.create_image(cx, cy, image=big[0], tags="hands")
        elif st == "words":                             # 3.2: the time in words
            ph = words_time(now.tm_hour, now.tm_min)
            cv.create_text(w / 2, 20 + 14, text="It's", font=self.F(9), fill=T["muted"], tags="hands")
            cv.create_text(w / 2, 20 + 44, text=ph, width=w - 28, justify="center", font=self.F(13, "bold"),
                           fill=T["text"], tags="hands")
        elif st == "analog":
            D = self._clock_D(w, conf)
            cx, cy, r = w / 2, 20 + D / 2, D / 2
            hh, mm, ss = now.tm_hour % 12, now.tm_min, now.tm_sec
            for ang, ln, wd, colr in (((hh + mm / 60) * 30, r * 0.5, max(3, r * 0.075), T["text"]),
                                      ((mm + ss / 60) * 6, r * 0.74, max(2, r * 0.05), T["text"])):
                a = math.radians(ang - 90)
                cv.create_line(cx, cy, cx + ln * math.cos(a), cy + ln * math.sin(a), fill=colr, width=wd,
                               capstyle="round", tags="hands")
            if conf.get("anim", True):
                a = math.radians(ss * 6 - 90)
                cv.create_line(cx - r * 0.16 * math.cos(a), cy - r * 0.16 * math.sin(a),
                               cx + r * 0.82 * math.cos(a), cy + r * 0.82 * math.sin(a), fill=A, width=1.6,
                               tags="hands")
            cv.create_oval(cx - 4, cy - 4, cx + 4, cy + 4, fill=A, outline=card, width=1.5, tags="hands")
        elif st == "digital":
            big = self._text_img(time.strftime("%H:%M", now), int(min(52, (w - 60) / 2.9)), T["text"], True)
            if conf.get("anim", True):
                sec = self._text_img(f"{now.tm_sec:02d}", 15, A, True)
                x0 = w / 2 - (big[1] + 4 + sec[1]) / 2
                cv.create_image(x0 + big[1] + 4, 20 + 31 + big[2] * 0.22, image=sec[0], anchor="w", tags="hands")
            else:
                x0 = w / 2 - big[1] / 2
            cv.create_image(x0, 20 + 31, image=big[0], anchor="w", tags="hands")
        else:
            self._flip_draw(cv, w, now)

    def _flip_draw(self, cv, w, now, phase=None):
        """Two flip cards (hours, minutes). phase 0..1 = the card of the minutes turning over."""
        T, A = self.T, self.accent
        fw = (w - 44) / 2
        y0, fh = 20, 78
        txt = time.strftime("%H %M", now).split()
        old = getattr(self, "_flip_last", txt)
        dark = mix(T["text"], "#000000", 0.3) if not is_light(T["canvas"]) else "#26262E"
        for i, x0 in enumerate((16, 28 + fw)):
            cv.create_rectangle(x0, y0, x0 + fw, y0 + fh, fill=dark, outline="", tags="hands")
            show = txt[i]
            if phase is not None and old[i] != txt[i] and phase < 0.5:
                show = old[i]
            im = self._text_img(show, int(min(46, fw * 0.5)), "#FFFFFF", True)
            cv.create_image(x0 + fw / 2, y0 + fh / 2, image=im[0], tags="hands")
            if phase is not None and old[i] != txt[i]:
                # the flap: from the top to the middle, then from the middle to the bottom
                if phase < 0.5:
                    yy = y0 + fh / 2 * (phase / 0.5)
                    cv.create_rectangle(x0, y0, x0 + fw, yy, fill=mix(dark, "#FFFFFF", 0.12), outline="",
                                        tags="hands")
                else:
                    yy = y0 + fh / 2 + fh / 2 * ((phase - 0.5) / 0.5)
                    cv.create_rectangle(x0, y0 + fh / 2, x0 + fw, yy, fill=mix(dark, "#000000", 0.25), outline="",
                                        tags="hands")
            cv.create_line(x0, y0 + fh / 2, x0 + fw, y0 + fh / 2, fill=mix(dark, "#000000", 0.5), width=2,
                           tags="hands")
        for yy in (y0 + fh * 0.36, y0 + fh * 0.64):
            cv.create_oval(w / 2 - 2.5, yy - 2.5, w / 2 + 2.5, yy + 2.5, fill=A, outline="", tags="hands")

    def _clock_static(self, cv, w, conf, now):
        import math
        T, A = self.T, self.accent
        card = self._clock_card
        st = conf["right"]
        y = 20
        if st == "station":
            D = self._clock_D(w, conf)
            cx, cy, r = w / 2, y + D / 2, D / 2
            cv.create_oval(cx - r, cy - r, cx + r, cy + r, fill="#FFFFFF", outline="#2A2A2A", width=max(2, r * 0.05))
            for i in range(60):
                a = math.radians(i * 6 - 90)
                big = i % 5 == 0
                r0 = r * (0.7 if big else 0.86)
                cv.create_line(cx + r0 * math.cos(a), cy + r0 * math.sin(a), cx + r * 0.9 * math.cos(a),
                               cy + r * 0.9 * math.sin(a), fill="#1A1A1A", width=max(3, r * 0.07) if big else 1.2)
            y += D + 14
        elif st == "ring":
            D = self._clock_D(w, conf)
            cx, cy, r = w / 2, y + D / 2, D / 2 - 6
            for rr_ in (r, r - 15):
                cv.create_oval(cx - rr_, cy - rr_, cx + rr_, cy + rr_, outline=mix(card, T["border"], 0.75), width=9)
            y += D + 14
        elif st == "words":
            y += 70 + 14
        elif st == "analog":
            D = self._clock_D(w, conf)
            cx, cy, r = w / 2, y + D / 2, D / 2
            cv.create_oval(cx - r, cy - r, cx + r, cy + r, fill=mix(card, "#FFFFFF", 0.5 if is_light(card) else 0.06),
                           outline=mix(card, A, 0.45), width=2)
            for i in range(60):
                a = math.radians(i * 6 - 90)
                big = i % 5 == 0
                r0 = r * (0.83 if big else 0.9)
                cv.create_line(cx + r0 * math.cos(a), cy + r0 * math.sin(a), cx + r * 0.95 * math.cos(a),
                               cy + r * 0.95 * math.sin(a), fill=T["text"] if big else mix(T["muted"], card, 0.3),
                               width=2.2 if big else 1)
            for n_, ang in ((12, 0), (3, 90), (6, 180), (9, 270)):
                a = math.radians(ang - 90)
                cv.create_text(cx + r * 0.66 * math.cos(a), cy + r * 0.66 * math.sin(a), text=str(n_),
                               font=self.F(9, "bold"), fill=T["muted"])
            y += D + 14
        elif st == "flip":
            y += 78 + 14
        else:
            y += 62 + 14
        self._clock_body_y1 = y
        self._dl_hit = None
        self._cal_hits = []
        if conf["date"]:
            cv.create_text(w / 2, y + 8, text=time.strftime("%A", now), font=self.F(9), fill=T["muted"])
            cv.create_text(w / 2, y + 27, text=time.strftime("%d %B %Y", now).lstrip("0"), font=self.F(11, "bold"),
                           fill=T["text"])
            y += 42
        att = getattr(self, "_attention", None)
        if conf["deadline"] and att and att.get("items"):
            items = att["items"]
            nxt = next((x for x in items if x.startswith(("In ", "Today", "Tomorrow"))), items[0])
            when, _, what = nxt.partition(": ")
            cv.create_line(16, y + 4, w - 16, y + 4, fill=mix(card, T["border"], 0.6))
            colr = "#D93025" if when.startswith("Expired") else "#E8772E"
            cv.create_oval(16, y + 15, 24, y + 23, fill=colr, outline="")
            cv.create_text(30, y + 19, text=("Next: " + when) if not when.startswith("Expired") else when, anchor="w",
                           font=self.F(8, "bold"), fill=colr)
            cv.create_text(16, y + 36, text=self._fit_text(what, self._sfont(8), w - 32), anchor="w", font=self.F(8),
                           fill=T["muted"])
            self._dl_hit = (y, y + 46)
            y += 46

    _TIMG_FONTS = {"sans": ("segoeui.ttf", "arial.ttf", "DejaVuSans.ttf", "LiberationSans-Regular.ttf"),
                   "sans_b": ("segoeuib.ttf", "arialbd.ttf", "DejaVuSans-Bold.ttf", "LiberationSans-Bold.ttf"),
                   "serif": ("georgia.ttf", "times.ttf", "DejaVuSerif.ttf", "LiberationSerif-Regular.ttf"),
                   "serif_i": ("georgiai.ttf", "timesi.ttf", "DejaVuSerif-Italic.ttf", "LiberationSerif-Italic.ttf"),
                   "serif_b": ("georgiab.ttf", "timesbd.ttf", "DejaVuSerif-Bold.ttf", "LiberationSerif-Bold.ttf")}

    def _text_img(self, text, px, color, bold=False, style=None):
        """Text as a picture (sharp at any size, the same on every computer): (image, width, height).
        style: sans, sans_b, serif, serif_i (italic), serif_b."""
        style = style or ("sans_b" if bold else "sans")
        cache = self.__dict__.setdefault("_timg", {})
        key = (text, px, color, style)
        if key in cache:
            return cache[key]
        evict_pictures(cache, 400)
        fz = self.fitz
        fnt = self.__dict__.get("_timg_font_" + style)
        if fnt is None:
            ffile = None
            names = self._TIMG_FONTS.get(style, self._TIMG_FONTS["sans"])
            for dd in _font_dirs():
                for nm in names:
                    if os.path.isfile(os.path.join(dd, nm)):
                        ffile = os.path.join(dd, nm)
                        break
                if ffile:
                    break
            fnt = fz.Font(fontfile=ffile) if ffile else fz.Font({"sans_b": "hebo", "serif": "tiro", "serif_i": "tiit",
                                                                   "serif_b": "tibo"}.get(style, "helv"))
            self.__dict__["_timg_font_" + style] = fnt
        d_ = fz.open()
        try:
            w_ = fnt.text_length(text, fontsize=px)
            pg_ = d_.new_page(width=w_ + 4, height=px * 1.18 + 4)
            tw_ = fz.TextWriter(pg_.rect)
            tw_.append((2, 2 + px * 0.92), text, font=fnt, fontsize=px)
            tw_.write_text(pg_, color=_rgb(color))
            img = tk.PhotoImage(data=pg_.get_pixmap(alpha=True).tobytes("png"))
        finally:
            d_.close()
        cache[key] = (img, w_ + 4, px * 1.18 + 4)
        return cache[key]

    def _clock_tick(self):
        try:
            geo = getattr(self, "_sides_geo", {}).get("r")
            if geo and self.root.state() != "iconic" and getattr(self, "_idle_win", None) is None:
                conf = self._beside_conf()
                now = time.localtime()
                rc = conf.get("read_clock", "sky")
                if getattr(self, "_reading", False) and rc != "sky":
                    conf["right"] = rc                  # 4.2: the clock you chose for reading (not always the sky)
                if getattr(self, "_reading", False) and rc == "sky":
                    self._desk_draw()
                elif conf["right"] == "flip":
                    txt = time.strftime("%H %M", now).split()
                    if getattr(self, "_flip_last", None) and self._flip_last != txt and conf.get("anim", True):
                        self._flip_anim(0, now)
                    elif getattr(self, "_flip_last", None) != txt or conf.get("anim", True):
                        self._flip_last = txt
                        self._clock_draw()
                elif conf["right"] in ("digital", "analog", "station", "ring", "words"):
                    if now.tm_hour == 0 and now.tm_min == 0 and now.tm_sec == 0:
                        self._clock_draw(full=True)              # a new day: the date
                    elif conf.get("anim", True) or now.tm_sec == 0:  # animation off: once a minute
                        self._clock_draw()
        except Exception:
            pass
        self.root.after(1000 - int((time.time() % 1) * 1000) + 5, self._clock_tick)

    # ================================================================ 4.0: the calendar card (apart from the clock)
    def _calc_geo(self, vw, vh, R, cg, cx_):
        """Where the calendar card goes: where you put it (it keeps to that corner), else at the bottom of the
        clock's side, a little under the clock - only when there is room for it there."""
        conf = self._cal_conf()
        w = self._cal_metrics()[0]
        h = int(self._cal_h())
        pos = conf.get("pos")
        if pos and vw > w + 20 and vh > 120:
            cor = pos.get("corner", "br")
            x = pos.get("x", 20) if cor in ("tl", "bl") else vw - w - pos.get("x", 20)
            y = pos.get("y", 20) if cor in ("tl", "tr") else vh - h - pos.get("y", 20)
            x = int(max(4, min(vw - w - 4, x)))
            y = int(max(4, min(vh - min(h, vh - 8) - 4, y)))
            return (x, y, w, min(h, vh - 8))
        w = int(min(w, cg - 36))                           # in the clock's space: as wide as it allows
        if w < 176:
            return None
        x = int(cx_ + (cg - w) / 2)
        y = int(vh - h - 22)
        if R is not None and y < R[1] + R[3] + 16:
            y = R[1] + R[3] + 16
            if y + h > vh - 6:
                return None
        return (x, y, w, h)

    def _calc_place(self, geo):
        cv = self._side_c if hasattr(self, "_side_c") else None
        if cv is None:
            return
        if geo is None:
            if self._sides_geo.get("c") is not None:
                cv.place_forget()
                self._sides_geo["c"] = None
            return
        if getattr(self, "_calc_dragging", False):
            return
        if geo != self._sides_geo.get("c"):
            cv.configure(width=geo[2], height=geo[3])
            cv.place(in_=self.canvas, x=geo[0], y=geo[1])
            cv.tk.call("raise", cv._w)
            self._sides_geo["c"] = geo
            self._sides_sig["c"] = None
        import datetime
        sig = (geo, id(getattr(self, "_bg_photo", None)), self.T["canvas"], self.accent, getattr(self, "_cal_ver", 0),
               datetime.date.today(), repr(sorted(self._cal_conf().items())), id(getattr(self, "_attention", None)),
               self._cal_month_now())
        if sig != self._sides_sig.get("c"):
            self._sides_sig["c"] = sig
            self._calc_draw()

    def _alpha_card(self, w, h, color, alpha, radius=14, line=None, line_alpha=0.0):
        """A rounded card that lets what is behind show through (a picture with see-through pixels)."""
        key = (w, h, color, round(alpha, 2), radius, line, round(line_alpha, 2))
        cache = self.__dict__.setdefault("_alpha_cards", {})
        if key in cache:
            return cache[key]
        if len(cache) > 12:
            cache.clear()
        d_ = self.fitz.open()
        pg = d_.new_page(width=w, height=h)
        rr = min(0.5, radius / max(1, min(w, h)))
        sh = pg.new_shape()
        sh.draw_rect(self.fitz.Rect(1, 1, w - 1, h - 1), radius=rr)
        sh.finish(color=_rgb(line) if line else None, width=1.2, fill=_rgb(color), fill_opacity=alpha,
                  stroke_opacity=line_alpha or alpha)
        sh.commit()
        img = tk.PhotoImage(data=pg.get_pixmap(alpha=True).tobytes("png"))
        d_.close()
        cache[key] = img
        return img

    def _bg_base(self):
        """Roughly the colour of what is behind the pages (to choose readable writing on a see-through card)."""
        conf = self._bg_conf()
        try:
            if conf.get("mode") == "gradient" and conf.get("colors"):
                cs = conf["colors"]
                return mix(cs[0], cs[-1], 0.5)
            if conf.get("mode") == "texture":
                return TEXTURES.get(conf.get("name"), {}).get("tones", [self.T["canvas"]])[0]
        except Exception:
            pass
        return self.T["canvas"]

    def _calc_draw(self):
        """The calendar card: minimal - no card, glass, a see-through colour or a solid card (your choice)."""
        cv = self._side_c
        geo = self._sides_geo.get("c")
        if not geo:
            return
        T = self.T
        conf = self._cal_conf()
        w, h = geo[2], geo[3]
        cv.delete("all")
        cv.configure(bg=T["canvas"])
        ph = getattr(self, "_bg_photo", None)
        if ph is not None:
            cv.create_image(-geo[0], -geo[1], image=ph, anchor="nw")
        base = self._bg_base()
        style = conf.get("bg", "glass")
        bgc = conf.get("bg_color") or ("#FFFFFF" if is_light(T["panel"]) else T["panel"])
        if style == "solid":
            card = bgc
            round_rect(cv, 2, 3, w - 1, h, 16, fill=mix(T["canvas"], "#000000", 0.08), outline="")
            round_rect(cv, 1, 1, w - 2, h - 2, 16, fill=card, outline=mix(card, T["border"], 0.5))
        elif style == "glass":
            card = mix(base, "#FFFFFF", 0.62) if is_light(base) else mix(base, "#FFFFFF", 0.22)
            self._calc_img = self._alpha_card(w, h, "#FFFFFF", 0.62 if is_light(base) else 0.22, line="#FFFFFF",
                                              line_alpha=0.9)
            cv.create_image(0, 0, image=self._calc_img, anchor="nw")
        elif style == "tint":
            card = mix(base, bgc, 0.78)
            self._calc_img = self._alpha_card(w, h, bgc, 0.78)
            cv.create_image(0, 0, image=self._calc_img, anchor="nw")
        else:                                              # no card: only the writing
            card = base
        light = is_light(card)
        ink = conf.get("ink") or (T["text"] if light == is_light(T["panel"]) else ("#1F1F24" if light else "#F4F4F6"))
        sub = mix(ink, card, 0.42)
        try:
            self._cal_draw(cv, w, 0, card, ink=ink, sub=sub)
        except Exception as ex:
            _log(f"calendar: {ex}")
        if style != "none":                                # a grip: you can move it
            for k in (-6, 0, 6):
                cv.create_oval(w / 2 + k - 1.4, 3, w / 2 + k + 1.4, 5.8, fill=mix(card, ink, 0.3), outline="")

    def _clk_press(self, e):
        self._clk_drag0 = (e.x_root, e.y_root, self._sides_geo.get("r"))
        self._clk_dragging = False

    def _clk_drag(self, e):
        d0 = getattr(self, "_clk_drag0", None)
        if not d0 or not d0[2]:
            return
        dx, dy = e.x_root - d0[0], e.y_root - d0[1]
        if not self._clk_dragging and abs(dx) + abs(dy) < 6:
            return
        self._clk_dragging = True
        x0, y0, w, h = d0[2]
        vw, vh = self.canvas.winfo_width(), self.canvas.winfo_height()
        x = int(max(4, min(vw - w - 4, x0 + dx)))
        y = int(max(4, min(vh - h - 4, y0 + dy)))
        self._side_r.place(in_=self.canvas, x=x, y=y)
        self._clk_now = (x, y, w, h)
        self._side_r.configure(cursor="fleur")

    def _clk_release(self, e):
        """4.2: the clock, like the calendar, stays where you leave it (right-click > Put the clock back)."""
        if not getattr(self, "_clk_dragging", False):
            self._clk_drag0 = None
            self._clock_click(e)
            return
        self._clk_dragging = False
        self._side_r.configure(cursor="hand2")
        x, y, w, h = getattr(self, "_clk_now", self._sides_geo.get("r"))
        vw, vh = self.canvas.winfo_width(), self.canvas.winfo_height()
        cor = ("t" if y + h / 2 < vh / 2 else "b") + ("l" if x + w / 2 < vw / 2 else "r")
        pos = {"corner": cor, "x": int(x if cor[1] == "l" else vw - w - x),
               "y": int(y if cor[0] == "t" else vh - h - y)}
        self._sides_geo["r"] = None
        self._set_beside("read_clock_pos" if getattr(self, "_reading", False) else "clock_pos", pos)
        self._toast("The clock stays there. Right-click it > Put the clock back.", ms=4000)

    def _calc_press(self, e):
        self._calc_drag0 = (e.x_root, e.y_root, self._sides_geo.get("c"))
        self._calc_dragging = False

    def _calc_drag(self, e):
        d0 = getattr(self, "_calc_drag0", None)
        if not d0 or not d0[2]:
            return
        dx, dy = e.x_root - d0[0], e.y_root - d0[1]
        if not self._calc_dragging and abs(dx) + abs(dy) < 6:
            return
        self._calc_dragging = True
        x0, y0, w, h = d0[2]
        vw, vh = self.canvas.winfo_width(), self.canvas.winfo_height()
        x = int(max(4, min(vw - w - 4, x0 + dx)))
        y = int(max(4, min(vh - h - 4, y0 + dy)))
        self._side_c.place(in_=self.canvas, x=x, y=y)
        self._calc_now = (x, y, w, h)
        self._side_c.configure(cursor="fleur")

    def _calc_release(self, e):
        if not getattr(self, "_calc_dragging", False):
            self._calc_drag0 = None
            self._cal_click(e)
            return
        self._calc_dragging = False
        self._side_c.configure(cursor="hand2")
        x, y, w, h = getattr(self, "_calc_now", self._sides_geo.get("c"))
        vw, vh = self.canvas.winfo_width(), self.canvas.winfo_height()
        cor = ("t" if y + h / 2 < vh / 2 else "b") + ("l" if x + w / 2 < vw / 2 else "r")
        pos = {"corner": cor, "x": int(x if cor[1] == "l" else vw - w - x),
               "y": int(y if cor[0] == "t" else vh - h - y)}
        self._cal_set(pos=pos)
        self._toast("The calendar stays there. Right-click it > Put it back under the clock.", ms=4000)

    def _calc_menu(self, e):
        import datetime
        m = self._menu()
        m.add_command(label="Add a note for today…", command=lambda: self._cal_day_dialog(datetime.date.today()))
        m.add_command(label="Announcement…", command=self._cal_pin_dialog)
        m.add_command(label="Bring in a calendar (file or link)…", command=self.calendar_settings)
        m.add_separator()
        bm = self._menu(m)
        cur = self._cal_conf().get("bg", "glass")
        for k, lab in (("none", "No card - only the writing"), ("glass", "Glass"), ("tint", "See-through colour"),
                       ("solid", "Solid card")):
            bm.add_radiobutton(label=lab, value=k, variable=tk.StringVar(value=cur),
                               command=lambda k=k: self._cal_set(bg=k))
        m.add_cascade(label="Background", menu=bm)
        zm = self._menu(m)
        for k, lab in (("s", "Small"), ("m", "Medium"), ("l", "Large")):
            zm.add_radiobutton(label=lab, value=k, variable=tk.StringVar(value=self._cal_conf().get("size", "m")),
                               command=lambda k=k: self._cal_set(size=k))
        m.add_cascade(label="Size", menu=zm)
        m.add_command(label="Calendar settings…", command=self.calendar_settings)
        m.add_separator()
        if self._cal_conf().get("pos"):
            m.add_command(label="Put it back under the clock", command=lambda: self._cal_set(pos=None))
        m.add_command(label="Hide the calendar", command=lambda: self._set_beside("calendar", False))
        self._popup(m, e)

    # ================================================================ 3.2: the calendar under the clock
    def _cal_conf(self):
        c = dict(self.lib.settings.get("calendar") or {})
        for k, v in (("week_start", 0), ("weeknums", True), ("holidays", True), ("dates", True), ("agenda", True),
                     ("look", "minimal"), ("color", ""), ("bg", "glass"), ("size", "m"), ("agenda_n", 4),
                     ("pinned", True), ("bg_color", ""), ("ink", "")):
            c.setdefault(k, v)
        return c

    def _cal_set(self, **kw):
        c = self._cal_conf()
        c.update(kw)
        self.lib.settings["calendar"] = c
        self.lib.save_meta()
        self._cal_changed()

    def _cal_data(self):
        d = self.lib.meta.setdefault("calendar", {})
        d.setdefault("notes", [])
        d.setdefault("feeds", [])
        return d

    def _cal_changed(self, save=False):
        self._cal_ver = getattr(self, "_cal_ver", 0) + 1
        self._cal_cache = {}
        if save:
            self.lib.save_meta()
        if hasattr(self, "_sides_sig"):
            self._sides_sig["r"] = None
            self._sides_sig["c"] = None
            self._sides_update()

    def _cal_color(self):
        return self._cal_conf().get("color") or self.accent

    def _cal_feed_events(self, fid):
        """The events of an imported calendar (kept in BindLens's folder, read once)."""
        import datetime
        mem = self.__dict__.setdefault("_cal_feed_mem", {})
        if fid in mem:
            return mem[fid]
        evs = []
        try:
            raw = load_json(os.path.join(self.lib.meta_dir, "calendars", f"{fid}.json"), {}).get("events", [])
            for e in raw:
                e = dict(e)
                e["start"] = datetime.date.fromisoformat(e["start"])
                e["last"] = datetime.date.fromisoformat(e.get("last") or e["start"].isoformat())
                e["exdates"] = [datetime.date.fromisoformat(x) for x in e.get("exdates") or []]
                evs.append(e)
        except Exception as ex:
            _log(f"calendar feed {fid}: {ex}")
        mem[fid] = evs
        return evs

    def _cal_collect(self, d0, d1):
        """Everything on the days d0…d1: {date: [{"t", "c", "k", "time", "icon", "id"}]} - your notes (with their
        repeats), imported calendars, the dates BindLens found (expiring papers), reminders and bank holidays."""
        import datetime
        td = datetime.timedelta
        key = (d0, d1, getattr(self, "_cal_ver", 0), id(getattr(self, "_attention", None)),
               len(self.lib.meta.get("reminders", [])))
        cache = self.__dict__.setdefault("_cal_cache", {})
        if key in cache:
            return cache[key]
        conf, data = self._cal_conf(), self._cal_data()
        out = {}

        def add(d, item):
            if d0 <= d <= d1:
                out.setdefault(d, []).append(item)
        if conf["holidays"]:
            for y in range(d0.year, d1.year + 1):
                for d, name in irish_holidays(y).items():
                    add(d, {"t": name, "c": "#1E8E3E", "k": "hol"})
        for n in data["notes"]:
            try:
                nd = datetime.date.fromisoformat(n["date"])
            except Exception:
                continue
            it = {"t": n.get("text", ""), "c": n.get("color") or CAL_COLORS[0], "k": "note", "id": n.get("id"),
                  "icon": n.get("icon", ""), "time": n.get("time") or None}
            rep = n.get("repeat", "")
            if not rep:
                add(nd, it)
            elif rep == "week":
                k0 = max(0, (d0 - nd).days // 7)
                d = nd + td(weeks=k0)
                while d <= d1:
                    if d >= nd:
                        add(d, it)
                    d += td(weeks=1)
            elif rep in ("month", "year"):
                for y in range(d0.year, d1.year + 1):
                    for m in (range(1, 13) if rep == "month" else (nd.month,)):
                        try:
                            d = nd.replace(year=y, month=m)
                        except ValueError:
                            continue
                        if d >= nd:
                            add(d, it)
        for fd in data["feeds"]:
            if not fd.get("on", True):
                continue
            for ev in self._cal_feed_events(fd["id"]):
                for d in ics_days(ev, d0, d1):
                    add(d, {"t": ev.get("title") or "(no title)", "c": fd.get("color") or CAL_COLORS[4], "k": "feed",
                            "time": ev.get("time"), "src": fd.get("name", "")})
        if conf["dates"]:
            for r in (getattr(self, "_attention", None) or {}).get("rows") or []:
                try:
                    d = datetime.date.fromisoformat(r["date"])
                except Exception:
                    continue
                add(d, {"t": f"Expires: {r.get('who') or r.get('what') or ''}".strip(), "c": "#D93025", "k": "due",
                        "row": r})
            for r in self.lib.meta.get("reminders", []):
                if r.get("done"):
                    continue
                try:
                    d = datetime.date.fromisoformat(r["date"])
                except Exception:
                    continue
                add(d, {"t": "Reminder: " + (r.get("note") or os.path.basename(r.get("path") or "")), "c": "#E8772E",
                        "k": "rem"})
        for d in out:
            out[d].sort(key=lambda it: ({"hol": 0, "note": 1, "due": 2, "rem": 3, "feed": 4}[it["k"]],
                                        it.get("time") or ""))
        if len(cache) > 12:
            cache.clear()
        cache[key] = out
        return out

    def _cal_month_now(self):
        import datetime
        t = datetime.date.today()
        ym = getattr(self, "_cal_ym", None)
        return ym or (t.year, t.month)

    def _cal_weeks(self, y, m):
        """The weeks shown for month (y, m): lists of 7 dates (from Monday or Sunday)."""
        import datetime
        td = datetime.timedelta
        ws = 6 if self._cal_conf()["week_start"] == 6 else 0
        first = datetime.date(y, m, 1)
        start = first - td(days=(first.weekday() - ws) % 7)
        weeks = []
        d = start
        while True:
            weeks.append([d + td(days=k) for k in range(7)])
            d += td(days=7)
            if d.month != m and (d.year, d.month) > (y, m):
                break
        return weeks

    def _cal_pinned(self):
        import datetime
        p = self._cal_data().get("pinned") or {}
        if not p.get("text"):
            return None
        if p.get("until"):
            try:
                if datetime.date.fromisoformat(p["until"]) < datetime.date.today():
                    return None
            except Exception:
                pass
        return p

    def _cal_agenda(self, n=4):
        """What comes next (the next 21 days): [(date, item)] - at most n."""
        import datetime
        t = datetime.date.today()
        ev = self._cal_collect(t, t + datetime.timedelta(days=21))
        out = []
        for d in sorted(ev):
            for it in ev[d]:
                out.append((d, it))
        return out[:max(0, int(n))]

    CAL_SIZES = {"s": (196, 18, 7), "m": (236, 22, 8), "l": (290, 27, 9)}     # width, row height, font size

    def _cal_metrics(self):
        return self.CAL_SIZES.get(self._cal_conf().get("size", "m"), self.CAL_SIZES["m"])

    def _cal_h(self, w=None):
        """4.0: the height of the calendar card (it has its own card now, apart from the clock)."""
        conf = self._cal_conf()
        _w, RH, fs = self._cal_metrics()
        y, m = self._cal_month_now()
        h = 10 + (fs * 3 + 6) + (fs * 2 + 4) + RH * len(self._cal_weeks(y, m)) + 6
        if conf.get("pinned", True) and self._cal_pinned():
            h += 52
        if conf["agenda"]:
            n = int(conf.get("agenda_n", 4))
            h += 22 + (fs * 2 + 2) * max(1, min(n, len(self._cal_agenda(n))))
        return h + 8

    def _cal_draw(self, cv, w, y, card, ink=None, sub=None):
        """The month: today, your notes and what is coming (click a day to add a note)."""
        import datetime
        T = self.T
        conf = self._cal_conf()
        C = self._cal_color()
        look = conf["look"]
        _w, RH, fs = self._cal_metrics()
        ink = ink or T["text"]
        sub = sub or T["muted"]
        hits = self._cal_hits = []
        today = datetime.date.today()
        y += 8
        pin = self._cal_pinned() if conf.get("pinned", True) else None
        if pin:                                           # the announcement, pinned at the top
            pc = pin.get("color") or "#E8772E"
            round_rect(cv, 10, y, w - 10, y + 44, 9, fill=mix(card, pc, 0.16), outline=mix(card, pc, 0.45))
            cv.create_rectangle(10, y + 6, 14, y + 38, fill=pc, outline="")
            cv.create_text(22, y + 4, text=pin["text"], anchor="nw", width=w - 42, font=self.F(fs, "bold"),
                           fill=mix(ink, pc, 0.25))
            hits.append((10, y, w - 10, y + 44, "pin", None))
            y += 52
        yy, mm = self._cal_month_now()
        title = datetime.date(yy, mm, 1).strftime("%B %Y")
        hh = fs * 3 + 6
        if look == "bold":
            round_rect(cv, 10, y, w - 10, y + hh - 4, 8, fill=C, outline="")
            hc, ac = "#FFFFFF", "#FFFFFF"
        else:
            hc, ac = ink, C
        cv.create_text(18, y + hh / 2 - 2, text=title, anchor="w", font=self.F(fs + 2, "bold"), fill=hc)
        bx = w - 20
        for key, glyph in (("add", "+"), ("next", "›"), ("prev", "‹")):
            cv.create_text(bx, y + hh / 2 - 3, text=glyph, font=self.F(fs + 4 if key != "add" else fs + 5, "bold"),
                           fill=ac)
            hits.append((bx - 10, y, bx + 10, y + hh, key, None))
            bx -= 19
        if (yy, mm) != (today.year, today.month):
            cv.create_text(bx + 4, y + hh / 2 - 2, text="Today", anchor="e", font=self.F(fs), fill=ac)
            hits.append((bx - 34, y, bx + 6, y + hh, "today", None))
        y += hh
        wk = (fs * 2 + 6) if conf["weeknums"] else 0
        x0 = 12 + wk
        cw = (w - 24 - wk) / 7.0
        names = ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]
        if conf["week_start"] == 6:
            names = names[6:] + names[:6]
        dh = fs * 2 + 4
        if wk:
            cv.create_text(12 + wk / 2, y + dh / 2, text="W", font=self.F(max(7, fs - 1)), fill=mix(sub, card, 0.3))
        for i, nm in enumerate(names):
            weekend = nm in ("Sa", "Su")
            cv.create_text(x0 + cw * i + cw / 2, y + dh / 2, text=nm, font=self.F(max(7, fs - 1), "bold"),
                           fill=mix(sub, C, 0.4) if weekend else sub)
        y += dh
        weeks = self._cal_weeks(yy, mm)
        ev = self._cal_collect(weeks[0][0], weeks[-1][-1])
        for row in weeks:
            if wk:
                iso = row[3].isocalendar()[1]
                cv.create_text(12 + wk / 2, y + RH / 2 - 1, text=str(iso), font=self.F(max(7, fs - 1)),
                               fill=mix(sub, card, 0.25))
            for i, d in enumerate(row):
                cx = x0 + cw * i + cw / 2
                cy = y + RH / 2 - 2
                inm = d.month == mm
                items = ev.get(d, [])
                hol = conf["holidays"] and any(it["k"] == "hol" for it in items)
                if look == "soft" and d.weekday() >= 5 and inm:
                    cv.create_rectangle(x0 + cw * i + 1, y + 1, x0 + cw * (i + 1) - 1, y + RH - 1,
                                        fill=mix(card, C, 0.06), outline="")
                if d == today:
                    r_ = min(cw, RH) / 2 - 1
                    if look == "minimal":
                        cv.create_oval(cx - r_, cy - r_, cx + r_, cy + r_, outline=C, width=1.6)
                    else:
                        cv.create_oval(cx - r_, cy - r_, cx + r_, cy + r_, fill=C, outline="")
                fc = ("#FFFFFF" if look != "minimal" else C) if d == today else (
                    mix(ink, card, 0.62) if not inm else ("#1E8E3E" if hol else ink))
                cv.create_text(cx, cy, text=str(d.day), font=self.F(fs, "bold" if (d == today or hol) else "normal"),
                               fill=fc)
                cols = []
                for it in items:
                    if it["k"] != "hol" and it["c"] not in cols:
                        cols.append(it["c"])
                for k, colr in enumerate(cols[:3]):
                    dx = (k - (min(3, len(cols)) - 1) / 2) * 5
                    cv.create_oval(cx + dx - 1.8, y + RH - 6, cx + dx + 1.8, y + RH - 2.4, fill=colr, outline="")
                hits.append((x0 + cw * i, y, x0 + cw * (i + 1), y + RH, "day", d))
            y += RH
        y += 6
        if conf["agenda"]:                                # what comes next
            n = int(conf.get("agenda_n", 4))
            cv.create_text(14, y + 9, text="COMING UP", anchor="w", font=self.F(max(7, fs - 1), "bold"), fill=sub)
            y += 22
            ag = self._cal_agenda(n)
            lh = fs * 2 + 2
            if not ag:
                cv.create_text(14, y + lh / 2, text="Nothing in the next 3 weeks", anchor="w", font=self.F(fs),
                               fill=mix(sub, card, 0.2))
                y += lh
            for d, it in ag:
                cv.create_oval(14, y + lh / 2 - 3, 20, y + lh / 2 + 3, fill=it["c"], outline="")
                when = "Today" if d == today else d.strftime("%a %d").replace(" 0", " ")
                cv.create_text(26, y + lh / 2, text=when, anchor="w", font=self.F(fs, "bold"), fill=ink)
                tx = ((it.get("icon") + " ") if it.get("icon") else "") + it["t"]
                tx0 = 26 + fs * 7
                cv.create_text(tx0, y + lh / 2, text=self._fit_text(tx, self._sfont(fs), w - tx0 - 12), anchor="w",
                               font=self.F(fs), fill=sub)
                hits.append((10, y, w - 10, y + lh, "day", d))
                y += lh
        return y

    def _cal_hit(self, e):
        for x0, y0, x1, y1, k, v in getattr(self, "_cal_hits", []):
            if x0 <= e.x <= x1 and y0 <= e.y <= y1:
                return k, v
        return None, None

    def _cal_click(self, e):
        """True when the click was for the calendar."""
        import datetime
        k, v = self._cal_hit(e)
        if not k:
            return False
        y, m = self._cal_month_now()
        if k in ("prev", "next"):
            m += -1 if k == "prev" else 1
            if m == 0:
                y, m = y - 1, 12
            elif m == 13:
                y, m = y + 1, 1
            t = datetime.date.today()
            self._cal_ym = None if (y, m) == (t.year, t.month) else (y, m)
            self._cal_changed()
        elif k == "today":
            self._cal_ym = None
            self._cal_changed()
        elif k == "add":
            self._cal_day_dialog(datetime.date.today())
        elif k == "day":
            self._cal_day_dialog(v)
        elif k == "pin":
            self._cal_pin_dialog()
        return True

    def _cal_motion(self, e):
        k, v = self._cal_hit(e)
        key = (k, v)
        if key == getattr(self, "_cal_hov", None):
            return
        self._cal_hov = key
        if k == "day":
            import datetime
            items = self._cal_collect(v, v).get(v, [])
            txt = "  ·  ".join(((it.get("time") + " ") if it.get("time") else "") + it["t"] for it in items[:4])
            self.set_status(v.strftime("%A %d %B").replace(" 0", " ") + (f":  {txt}" if txt else
                                                                          "  ·  click to add a note"))
            _ = datetime
        elif k in ("prev", "next", "today", "add", "pin"):
            self.set_status({"prev": "The month before", "next": "The month after", "today": "Back to this month",
                             "add": "Add a note for today", "pin": "Change or remove the announcement"}[k])

    def _cal_day_dialog(self, day):
        """A day: what is on it, and your notes - add one (text, colour, a sign, repeat), or delete one."""
        import datetime
        T = self.T
        data = self._cal_data()
        d = self._dialog("Calendar")
        tk.Label(d, text=day.strftime("%A %d %B %Y").replace(" 0", " "), font=self.F(14, "bold"), bg=T["panel"],
                 fg=T["text"]).pack(anchor="w", padx=20, pady=(16, 2))
        box = tk.Frame(d, bg=T["panel"])
        box.pack(fill="x", padx=20)

        def fill_list():
            for w_ in box.winfo_children():
                w_.destroy()
            self._cal_cache = {}
            items = self._cal_collect(day, day).get(day, [])
            if not items:
                tk.Label(box, text="Nothing on this day yet.", font=self.F(9), bg=T["panel"], fg=T["muted"]).pack(
                    anchor="w", pady=(4, 6))
            for it in items:
                row = tk.Frame(box, bg=T["panel"])
                row.pack(fill="x", pady=2)
                dot = tk.Canvas(row, width=12, height=12, bg=T["panel"], highlightthickness=0)
                dot.create_oval(2, 2, 10, 10, fill=it["c"], outline="")
                dot.pack(side="left", padx=(0, 6))
                kind = {"hol": "Bank holiday", "note": "", "due": "", "rem": "", "feed": it.get("src", "")}[it["k"]]
                txt = ((it.get("icon") + "  ") if it.get("icon") else "") + \
                    ((it.get("time") + "  ") if it.get("time") else "") + it["t"]
                tk.Label(row, text=txt, font=self.F(10), bg=T["panel"], fg=T["text"], wraplength=330,
                         justify="left").pack(side="left")
                if kind:
                    tk.Label(row, text=kind, font=self.F(8), bg=T["panel"], fg=T["muted"]).pack(side="left", padx=6)
                if it["k"] == "note":
                    lb = tk.Label(row, text="Delete", font=self.F(8), bg=T["panel"], fg="#B3261E", cursor="hand2")
                    lb.pack(side="right")
                    lb.bind("<Button-1>", lambda e, nid=it.get("id"): delete(nid))
                elif it["k"] == "due" and it.get("row"):
                    lb = tk.Label(row, text="Open", font=self.F(8), bg=T["panel"], fg=self.accent, cursor="hand2")
                    lb.pack(side="right")
                    lb.bind("<Button-1>", lambda e, r=it["row"]: (d.destroy(), self._open_attention_row(r)))

        def delete(nid):
            n = next((x for x in data["notes"] if x.get("id") == nid), None)
            if not n:
                return
            if n.get("repeat") and not messagebox.askyesno(APP_NAME, "This note repeats. Delete it on every day?",
                                                            parent=d):
                return
            data["notes"].remove(n)
            self._cal_changed(save=True)
            fill_list()
        fill_list()
        tk.Frame(d, height=1, bg=T["border"]).pack(fill="x", padx=20, pady=(10, 8))
        tk.Label(d, text="ADD A NOTE OR AN EVENT", font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(
            anchor="w", padx=20)
        f = tk.Frame(d, bg=T["panel"])
        f.pack(fill="x", padx=20, pady=(4, 0))
        tv = tk.StringVar()
        ent = ttk.Entry(f, textvariable=tv, width=40)
        ent.pack(side="left", fill="x", expand=True)
        tmv = tk.StringVar()
        tk.Label(f, text="  time", font=self.F(8), bg=T["panel"], fg=T["muted"]).pack(side="left")
        ttk.Entry(f, textvariable=tmv, width=6).pack(side="left", padx=(4, 0))
        st = {"color": CAL_COLORS[0], "icon": "", "repeat": ""}
        opt = tk.Frame(d, bg=T["panel"])
        opt.pack(fill="x", padx=20, pady=(8, 0))

        def paint_opts():
            for w_ in opt.winfo_children():
                w_.destroy()
            r1 = tk.Frame(opt, bg=T["panel"])
            r1.pack(anchor="w")
            for c in CAL_COLORS:
                cv = tk.Canvas(r1, width=24, height=24, bg=T["panel"], highlightthickness=0, cursor="hand2")
                cv.pack(side="left", padx=1)
                cv.create_oval(4, 4, 20, 20, fill=c, outline=T["text"] if st["color"] == c else "")
                cv.bind("<Button-1>", lambda e, c=c: (st.__setitem__("color", c), paint_opts()))
            r2 = tk.Frame(opt, bg=T["panel"])
            r2.pack(anchor="w", pady=(4, 0))
            for ic in CAL_ICONS:
                on = st["icon"] == ic
                lb = tk.Label(r2, text=ic or "No sign", font=self.F(10 if ic else 8), padx=7, pady=2, cursor="hand2",
                              bg=mix(T["panel"], self.accent, 0.22) if on else T["chip"],
                              fg=self.accent if on else T["text"])
                lb.pack(side="left", padx=1)
                lb.bind("<Button-1>", lambda e, ic=ic: (st.__setitem__("icon", ic), paint_opts()))
            r3 = tk.Frame(opt, bg=T["panel"])
