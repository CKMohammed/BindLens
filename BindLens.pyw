def initials(name):
    words = [w for w in re.split(r"[\s_\-]+", name or "") if w]
    if not words:
        return "?"
    if len(words) > 1 and words[1][0].isalpha():
        return (words[0][0] + words[1][0]).upper()
    w = re.sub(r"[^\w]", "", words[0]) or words[0]
    return (w[:2]).upper() if len(w) > 1 and not w[1].isdigit() else w[:1].upper()


