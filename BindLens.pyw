REPORT_GRAD = ("#7B61FF", "#0A84FF", "#00B894", "#F5A000", "#E8467C")


def grad_pill_png(w, h, cols, shine=None, dark=0.0):
    """A pill with a colour gradient, a soft gloss and (shine 0..1) a light passing over it - as a PNG with
    smooth (anti-aliased) edges."""
    fz = _FITZ
    rgb = [tuple(int(c[i:i + 2], 16) for i in (1, 3, 5)) for c in cols]
    n = len(rgb) - 1
    r = h / 2.0
    out = bytearray(w * h * 4)
    for y in range(h):
        cy = y + 0.5
        qy = max(r - cy, cy - (h - r), 0.0)
        gloss = 0.16 if cy < h * 0.48 else 0.0
        for x in range(w):
            cx = x + 0.5
            qx = max(r - cx, cx - (w - r), 0.0)
            dd = (qx * qx + qy * qy) ** 0.5 - r
            a = 0.5 - dd
            if a <= 0:
                continue
            t = min(0.999, max(0.0, cx / w * 0.88 + cy / h * 0.12))
            pos = t * n
            i = int(pos)
            f = pos - i
            c0, c1 = rgb[i], rgb[i + 1]
            col = [c0[k] + (c1[k] - c0[k]) * f for k in range(3)]
            if dark:
                col = [v * (1 - dark) for v in col]
            if gloss:
                col = [v + (255 - v) * gloss for v in col]
            if shine is not None:
                band = (cx + (h - cy) * 0.7) - (-12 + shine * (w + 30))
                s_ = max(0.0, 1.0 - abs(band) / 8.0)
                if s_:
                    col = [v + (255 - v) * 0.55 * s_ for v in col]
            j = (y * w + x) * 4
            out[j] = int(col[0])
            out[j + 1] = int(col[1])
            out[j + 2] = int(col[2])
            out[j + 3] = int(255 * min(1.0, a))
    pix = fz.Pixmap(fz.csRGB, w, h, bytes(out), True)
    return pix.tobytes("png")


class ReportsButton(tk.Canvas):
    """The Reports button (1.9.1): a deep pill in your accent colour with a little white page on it - its bars grow
    and a spark twinkles when the mouse is on it, a light passes over it now and then - and a badge with the number
    of things that need attention (expired or expiring soon)."""
    W, H = 118, 34

    def __init__(self, parent, app, command):
        super().__init__(parent, width=self.W + 12, height=self.H + 6, highlightthickness=0, bd=0, cursor="hand2")
        self.app, self.command = app, command
        self.hover = False
        self.count, self.tone, self.tip_text = 0, None, ""
        self.made = 0                         # 2.0: the reports you made lately (the last 8) - the number on it
        self.phase = 0.0
        self.shine = None
        self._job = None
        self._img = None
        self.bind("<Enter>", self._enter)
        self.bind("<Leave>", self._leave)
        self.bind("<ButtonRelease-1>", lambda e: released_in(self, e) and self.command())
        self.bind("<Button-3>", lambda e: self.app._reports_menu(e))
        self.redraw()
        self.after(9000, self._shine_later)

    def set_attention(self, count, tone, tip):
        self.count, self.tone, self.tip_text = count, tone, tip
        self.redraw()

    def set_made(self, n):
        self.made = max(0, min(8, int(n or 0)))
        self.redraw()

    def _enter(self, _e):
        self.hover = True
        tip = "Reports  (Ctrl+R) - emails, names, rows of tables, summaries, charts…"
        if self.made:
            tip = (f"{self.made} report{'s' if self.made != 1 else ''} made lately (the last 8) - click to see "
                   f"them again\n\n" + tip)
        if self.count:
            tip += "\n\n" + self.tip_text
        self.app.tooltip.schedule(self, tip)
        if self.shine is None:
            self.shine = 0.0
        if self._job is None:                  # 3.0: one animation at a time (they piled up on every hover)
            self._animate()

    def _leave(self, _e):
        self.hover = False
        self.app.tooltip.cancel()

    def _shine_later(self):
        """Now and then a light passes over the button (only while you are not doing anything)."""
        try:
            if not self.winfo_exists():
                return
            if self.shine is None and not self.hover and self.app._anim_ok(quiet=6):
                self.shine = 0.0
                self._animate()
        except Exception:
            pass
        self.after(26000, self._shine_later)

    def _animate(self):
        self._job = None
        if not self.winfo_exists():
            return
        busy = False
        if self.shine is not None:
            self.shine += 0.09
            if self.shine > 1.0:
                self.shine = None
            busy = True
        if self.hover or self.phase % 1.0 > 0.02:
            self.phase += 0.07
            if not self.hover and self.phase % 1.0 < 0.07:
                self.phase = 0.0
            busy = True
        self.redraw()
        if busy and self._job is None:
            self._job = self.after(45, self._animate)

    def _cols(self):
        A = self.app.accent
        return [mix(A, "#0C0A1C", 0.66), mix(A, "#0C0A1C", 0.5), mix(A, "#0C0A1C", 0.34)]

    def _pill(self, w, h):
        sh = None if self.shine is None else round(self.shine * 12) / 12
        cols = self._cols()
        key = ("rpill2", w, h, self.hover, sh, tuple(cols))
        if key not in _TILE_CACHE:
            _TILE_CACHE[key] = (tk.PhotoImage(data=grad_pill_png(w, h, cols, shine=sh,
                                                                 dark=0.0 if self.hover else 0.06)), 0)
        return _TILE_CACHE[key][0]

    def redraw(self):
        import math
        T, A = self.app.T, self.app.accent
        bg = T["bg"]
        self.configure(bg=bg)
        self.delete("all")
        w, h = self.W, self.H
        y0 = 4
        cols = self._cols()
        if _FITZ is not None:
            try:
                self._img = self._pill(w, h)
                self.create_image(0, y0, image=self._img, anchor="nw")
            except Exception:
                round_rect(self, 1, y0, w - 1, y0 + h, h / 2, fill=cols[1], outline="")
        else:
            round_rect(self, 1, y0, w - 1, y0 + h, h / 2, fill=cols[1], outline="")
        anim = self.hover or self.phase
        lift = 1.5 if self.hover else 0.0
        # a little white page with a folded corner…
        px0, py0, px1, py1 = 12, y0 + 6 - lift, 31, y0 + 28 - lift
        self.create_polygon(px0 + 1.5, py0 + 2.5, px1 - 4.5, py0 + 2.5, px1 + 1.5, py0 + 8, px1 + 1.5, py1 + 1.5,
                            px0 + 1.5, py1 + 1.5, fill=mix(cols[0], "#000000", 0.3), outline="")
        self.create_polygon(px0, py0, px1 - 6, py0, px1, py0 + 6, px1, py1, px0, py1, fill="#FFFFFF", outline="")
        self.create_polygon(px1 - 6, py0, px1 - 6, py0 + 6, px1, py0 + 6, fill=mix("#FFFFFF", A, 0.35), outline="")
        # …with a chart whose bars grow
        bar_cols = (A, mix(A, "#FFFFFF", 0.35), "#FFC83D")
        for k, b in enumerate((0.45, 0.95, 0.7)):
            grow = 0.5 + 0.5 * math.sin(self.phase * 2 * math.pi + k * 1.4) if anim else 1.0
            hh = 3 + 9 * b * (0.55 + 0.45 * grow)
            x = px0 + 3.5 + k * 4.4
            self.create_rectangle(x, py1 - 3 - hh, x + 3, py1 - 3, fill=bar_cols[k], outline="")
        self.create_line(px0 + 2.5, py1 - 2.6, px1 - 2.5, py1 - 2.6, fill=mix("#FFFFFF", "#000000", 0.35))
        # a spark
        tw = 0.6 + 0.4 * math.sin(self.phase * 2 * math.pi * 1.5) if anim else 0.75
        sx, sy, sr = px1 + 4.5, py0 + 2.5, 5.2 * tw
        self.create_polygon(sx, sy - sr, sx + sr * 0.3, sy - sr * 0.3, sx + sr, sy, sx + sr * 0.3, sy + sr * 0.3,
                            sx, sy + sr, sx - sr * 0.3, sy + sr * 0.3, sx - sr, sy, sx - sr * 0.3, sy - sr * 0.3,
                            fill="#FFE08A", outline="")
        self.create_text(76, y0 + h / 2, text="Reports", font=self.app.F(10, "bold"), fill="#FFFFFF")
        if self.made:                     # 2.0: how many reports you made lately - up to the last 8
            txt = str(self.made)
            r = 9
            cx, cy = w + 1, 10
            self.create_oval(cx - r - 2, cy - r - 2, cx + r + 2, cy + r + 2, fill=bg, outline="")
            self.create_oval(cx - r, cy - r, cx + r, cy + r, fill="#FFFFFF", outline=mix(A, "#FFFFFF", 0.35),
                             width=1.5)
            self.create_text(cx, cy, text=txt, font=self.app.F(8, "bold"), fill=mix(A, "#000000", 0.15))


class ReadButton(tk.Canvas):
    """Read: a quiet reading mode. An outlined pill with an open book whose page turns when the mouse is on it;
    filled while you are reading."""
    W, H = 86, 34

    def __init__(self, parent, app, command):
        super().__init__(parent, width=self.W + 2, height=self.H + 6, highlightthickness=0, bd=0, cursor="hand2")
        self.app, self.command = app, command
        self.hover = False
        self.turn = None
        self.bind("<Enter>", self._enter)
        self.bind("<Leave>", self._leave)
        self.bind("<ButtonRelease-1>", lambda e: released_in(self, e) and self.command())
        self.redraw()

    def _enter(self, _e):
        self.hover = True
        self.app.tooltip.schedule(self, "Reading mode - only your pages, a contents list and a clock  (F6)")
        if self.turn is None:
            self.turn = 0.0
            self._animate()
        else:
            self.redraw()

    def _leave(self, _e):
        self.hover = False
        self.app.tooltip.cancel()
        self.redraw()

    def _animate(self):
        if not self.winfo_exists() or self.turn is None:
            return
        self.turn += 0.1
        if self.turn > 1.0:
            self.turn = None
            self.redraw()
            return
        self.redraw()
        self.after(35, self._animate)

    def redraw(self):
        T, A = self.app.T, self.app.accent
        bg = T["bg"]
        on = bool(getattr(self.app, "_reading", False))
        self.configure(bg=bg)
        self.delete("all")
        w, h, y0 = self.W, self.H, 4
        if on:
            round_rect(self, 1, y0, w - 1, y0 + h, h / 2, fill=A, outline="")
            ink = "#FFFFFF"
        else:
            round_rect(self, 1, y0, w - 1, y0 + h, h / 2, fill=mix(bg, A, 0.16 if self.hover else 0.07),
                       outline=mix(bg, A, 0.75), width=1.4)
            ink = A
        cx, cy = 22, y0 + h / 2
        draw_icon(self, "openbook", cx, cy, ink, s=0.95, w=1.6)
        if self.turn is not None:                  # a page turning over, from right to left
            import math
            u = self.turn
            x = cx + 8 * math.cos(math.pi * u)
            lift = 4 * math.sin(math.pi * u)
            self.create_line(cx, cy - 3.8, (cx + x) / 2, cy - 6.5 - lift, x, cy - 6 - lift * 0.5, x, cy + 5,
                             cx, cy + 7, fill=ink, width=1.4, smooth=True)
        self.create_text(56, cy, text="Reading" if on else "Read", font=self.app.F(10, "bold"), fill=ink)


class PillButton(tk.Canvas):
    """Rounded text button. kind: 'accent' | 'soft' | 'ghost'."""

    def __init__(self, parent, app, text, command, kind="soft", bg_key="panel", width=None, height=34, icon=None):
        self.app, self.text, self.command, self.kind, self.bg_key, self.icon = app, text, command, kind, bg_key, icon
        f = tkfont.Font(font=app.F(10, "bold" if kind == "accent" else "normal"))
        w = width or (f.measure(text) + 32 + (22 if icon else 0))
        super().__init__(parent, width=w, height=height, highlightthickness=0, bd=0, cursor="hand2")
        self.w, self.h = w, height
        self.hover = False
        self.enabled = True
        self.bind("<Enter>", lambda e: self._set(True))
        self.bind("<Leave>", lambda e: self._set(False))
        self.bind("<ButtonRelease-1>", lambda e: self.enabled and self.command and released_in(self, e) and
                  self.command())
        self.bind("<Configure>", lambda e: self._resize(e.width))
        self.redraw()

    def _resize(self, w):
        if w > 10 and w != self.w:
            self.w = w
            self.redraw()

    def _set(self, h):
        self.hover = h
        self.redraw()

    def redraw(self):
        T, A = self.app.T, self.app.accent
        bg = T[self.bg_key]
        self.configure(bg=bg)
        self.delete("all")
        w, h = self.w, self.h
        if self.kind == "accent":
            fill, fg = (mix(A, "#000000", 0.12) if self.hover else A), "#FFFFFF"
        elif self.kind == "soft":
            fill, fg = (mix(T["chip"], "#000000", 0.05) if self.hover else T["chip"]), T["text"]
        else:
            fill, fg = (T["hover"] if self.hover else bg), T["text"]
        round_rect(self, 1, 1, w - 1, h - 1, h / 2, fill=fill, outline="")
        tx = w / 2
        if self.icon:
            draw_icon(self, self.icon, w / 2 - tkfont.Font(font=self.app.F(10)).measure(self.text) / 2 - 4, h / 2,
                      fg, s=0.75)
            tx += 9
        self.create_text(tx, h / 2, text=self.text, fill=fg,
                         font=self.app.F(10, "bold" if self.kind == "accent" else "normal"))


class PageScroller(tk.Canvas):
    """A wide, easy scroll bar for the pages: drag the handle, or click anywhere to jump there.
    While you drag it shows the page number."""

    def __init__(self, parent, app, width=14):
        super().__init__(parent, width=width, highlightthickness=0, bd=0, cursor="hand2")
        self.app, self.a, self.b, self.drag = app, 0.0, 1.0, None
        self.bind("<Configure>", lambda e: self.redraw())
        self.bind("<ButtonPress-1>", self._press)
        self.bind("<B1-Motion>", self._move)
        self.bind("<ButtonRelease-1>", self._release)
        self.bind("<Enter>", lambda e: self.redraw(hover=True))
        self.bind("<Leave>", lambda e: self.redraw())
        self._tip = None

    def set(self, a, b):
        self.a, self.b = float(a), float(b)
        self.redraw()

    def _thumb(self):
        h = max(1, self.winfo_height())
        size = max(44, (self.b - self.a) * h)
        top = self.a / max(1e-9, 1 - (self.b - self.a)) * (h - size) if self.b - self.a < 1 else 0
        return top, top + size, h, size

    def redraw(self, hover=False):
        T = self.app.T
        self.configure(bg=T["canvas"])
        self.delete("all")
        if self.b - self.a >= 0.999:
            return
        w = int(self["width"])
        t0, t1, h, size = self._thumb()
        col = self.app.accent if (hover or self.drag) else mix(T["muted"], T["canvas"], 0.35)
        round_rect(self, 3, t0 + 2, w - 3, t1 - 2, (w - 6) / 2, fill=col, outline="")

    def _frac_for(self, y, grab):
        t0, t1, h, size = self._thumb()
        span = max(1, h - size)
        top = min(max(0, y - grab), span)
        return top / span * (1 - (self.b - self.a))

    def _press(self, e):
        t0, t1, h, size = self._thumb()
        grab = e.y - t0 if t0 <= e.y <= t1 else size / 2
        self.drag = grab
        self.app._scroll_to_frac(self._frac_for(e.y, grab))
        self._show_tip(e)

    def _move(self, e):
        if self.drag is None:
            return
        self.app._scroll_to_frac(self._frac_for(e.y, self.drag))
        self._show_tip(e)

    def _release(self, e):
        self.drag = None
        if self._tip is not None:
            self._tip.place_forget()
        self.redraw()

    def _show_tip(self, e):
        app = self.app
        if not app.book or not app.book.total:
            return
        if self._tip is None:
            self._tip = tk.Label(app.view, font=app.F(10, "bold"), padx=10, pady=4)
        T = app.T
        self._tip.configure(text=f"Page {app.current_page + 1} / {app.book.total}", bg=T["tip_bg"], fg=T["tip_fg"])
        self._tip.place(in_=app.view, relx=1.0, x=-40, y=max(10, e.y - 12), anchor="ne")


def round_path(x0, y0, x1, y1, r, step=1.2):
    """Points about every 'step' px along a rounded rectangle, clockwise from the top left (for lights that run
    round the logo)."""
    import math
    pts = []
    segs = [((x0 + r, y0), (x1 - r, y0)), ("arc", x1 - r, y0 + r, -90), ((x1, y0 + r), (x1, y1 - r)),
            ("arc", x1 - r, y1 - r, 0), ((x1 - r, y1), (x0 + r, y1)), ("arc", x0 + r, y1 - r, 90),
            ((x0, y1 - r), (x0, y0 + r)), ("arc", x0 + r, y0 + r, 180)]
    for sg in segs:
        if sg[0] == "arc":
            _a, cx, cy, start = sg
            n = max(4, int(r * math.pi / 2 / step))
            for i in range(n):
                t = math.radians(start + 90 * i / n)
                pts.append((cx + r * math.cos(t), cy + r * math.sin(t)))
        else:
            (ax, ay), (bx, by) = sg
            n = max(2, int(math.hypot(bx - ax, by - ay) / step))
            for i in range(n):
                pts.append((ax + (bx - ax) * i / n, ay + (by - ay) * i / n))
    return pts


class LogoBadge(tk.Canvas):
    """1.9.3: the logo in the top bar - a little bigger than the books' icons, with a thin golden line around it
    and a golden light that keeps going round it, slowly. (configure(image=…) changes the logo picture, so the
    lens animations work as before.)"""
    LAP = 7.5                      # seconds for one round
    GOLD, GLOW = "#C9A227", "#FFE6A0"

    def __init__(self, parent, app, size):
        self.app, self.S, self.pad = app, size, 5
        W = size + 2 * self.pad
        super().__init__(parent, width=W, height=W, highlightthickness=0, bd=0)
        self._img = self.create_image(W / 2, W / 2)
        self._path = self._make_path()
        self._comet = []
        self.redraw()
        self.after(200, self._tick)

    def configure(self, cnf=None, **kw):
        if "image" in kw:
            self.itemconfigure(self._img, image=kw.pop("image"))
        if cnf or kw:
            return super().configure(cnf, **kw)
    config = configure

    def _make_path(self):
        """Points every ~1.2 px along a rounded square just outside the logo's own square."""
        k, o, gap = self.S / 256.0, self.pad, 2.6
        return round_path(o + 18 * k - gap, o + 18 * k - gap, o + 238 * k + gap, o + 238 * k + gap,
                          0.24 * 220 * k + gap, 1.2)

    def redraw(self):
        T = self.app.T
        bg = T["bg"]
        super().configure(bg=bg)
        self.delete("ring")
        flat = [v for p_ in self._path + self._path[:1] for v in p_]
        self.create_line(*flat, fill=mix(bg, self.GOLD, 0.55), width=1.3, tags="ring")
        self._comet = [self.create_line(0, 0, 0, 0, width=1, capstyle="round", joinstyle="round", tags="ring")
                       for _ in range(16)]
        self._cols = [mix(bg, self.GLOW if i < 4 else self.GOLD, max(0.15, (1 - i / 16) ** 1.2)) for i in range(16)]
        self.tag_raise("ring")
        self._draw_comet()

    def _draw_comet(self):
        pts = self._path
        n = len(pts)
        head = int((time.time() % self.LAP) / self.LAP * n)
        step = max(2, int(n * 0.32 / len(self._comet)))
        for i, it in enumerate(self._comet):
            a = head - i * step
            seg = [pts[(a - j) % n] for j in range(step + 1)]
            self.coords(it, *[v for p_ in seg for v in p_])
            self.itemconfigure(it, fill=self._cols[i], width=max(1.4, 3.8 * (1 - i / len(self._comet))))

    def _tick(self):
        try:
            if not self.winfo_exists():
                return
            root = self.app.root
            hidden = root.state() == "iconic" or getattr(self.app, "_idle_win", None) is not None or \
                not self.winfo_ismapped()
            busy = False
            try:                              # 3.0: still for a moment while you scroll or type (pages first)
                busy = time.time() - getattr(self.app, "_last_input", 0.0) < 0.4 or bool(self.app.drag)
            except Exception:
                pass
            if not hidden and not busy:
                self._draw_comet()
            # 3.0: slower while BindLens is in the background (lighter for the computer)
            back = not hidden and root.focus_displayof() is None
            self.after(400 if hidden else (160 if back else 50), self._tick)
        except Exception:
            pass


class ScrollRail(tk.Canvas):
    """1.9.3: a slim scroll control for lists - a round ▲ and ▼ (hold them to keep going) with a pill between
    them that you can drag; click above or below the pill to jump a page."""

    def __init__(self, parent, app, target, width=24, bg=None):
        self.app, self.t = app, target
        self.bgc = bg or app.T["panel"]
        super().__init__(parent, width=width, highlightthickness=0, bd=0, bg=self.bgc, cursor="hand2")
        self.first, self.last = 0.0, 1.0
        self.hov, self.rep, self.drag = None, None, None
        target.configure(yscrollcommand=self.set)
        self.bind("<Configure>", lambda e: self.draw())
        self.bind("<Motion>", self._motion)
        self.bind("<Leave>", lambda e: self._hover(None))
        self.bind("<ButtonPress-1>", self._press)
        self.bind("<B1-Motion>", self._drag)
        self.bind("<ButtonRelease-1>", self._release)
        for seq in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            self.bind(seq, self._wheel)

    def set(self, a, b):
        self.first, self.last = float(a), float(b)
        self.draw()

    def _geo(self):
        w, h = max(10, self.winfo_width()), max(40, self.winfo_height())
        r = w / 2 - 2
        return w, h, r, r + 2, h - r - 2, 2 * r + 9, h - 2 * r - 9

    def _thumb(self):
        w, h, r, uy, dy, t0, t1 = self._geo()
        span = max(1.0, t1 - t0)
        size = max(22.0, span * (self.last - self.first))
        frac = self.first / max(1e-6, 1 - (self.last - self.first)) if self.last - self.first < 1 else 0
        top = t0 + (span - size) * min(1.0, max(0.0, frac))
        return top, top + size

    def draw(self):
        T, A = self.app.T, self.app.accent
        bg = self.bgc
        self.delete("all")
        w, h, r, uy, dy, t0, t1 = self._geo()
        cx = w / 2
        scroll = self.last - self.first < 0.999
        round_rect(self, cx - 3, t0, cx + 3, t1, 3, fill=mix(bg, T["border"], 0.55), outline="")
        if scroll and t1 - t0 > 26:
            y0, y1 = self._thumb()
            on = self.hov == "thumb" or self.drag is not None
            round_rect(self, cx - 4.5, y0, cx + 4.5, y1, 4.5, fill=A if on else mix(bg, A, 0.55), outline="")
        for key, y, up, ok in (("up", uy, True, scroll and self.first > 0.0005),
                               ("down", dy, False, scroll and self.last < 0.9995)):
            hov = ok and self.hov == key
            self.create_oval(cx - r, y - r, cx + r, y + r, fill=A if hov else mix(bg, A, 0.16 if ok else 0.05),
                             outline=mix(bg, A, 0.45) if ok else mix(bg, T["border"], 0.6))
            ink = "#FFFFFF" if hov else (A if ok else mix(bg, T["muted"], 0.45))
            d_ = r * 0.42
            pts = (cx - d_, y + d_ * 0.45, cx, y - d_ * 0.55, cx + d_, y + d_ * 0.45) if up else \
                (cx - d_, y - d_ * 0.45, cx, y + d_ * 0.55, cx + d_, y - d_ * 0.45)
            self.create_line(*pts, fill=ink, width=2.2, capstyle="round", joinstyle="round")

    def _hit(self, y):
        w, h, r, uy, dy, t0, t1 = self._geo()
        if y <= uy + r + 2:
            return "up"
        if y >= dy - r - 2:
            return "down"
        y0, y1 = self._thumb()
        if y0 <= y <= y1:
            return "thumb"
        return "page_up" if y < y0 else "page_down"

    def _hover(self, k):
        if k != self.hov:
            self.hov = k
            self.draw()

    def _motion(self, e):
        self._hover(self._hit(e.y))

    def _step(self, k):
        if k == "up":
            self.t.yview_scroll(-1, "units")
        elif k == "down":
            self.t.yview_scroll(1, "units")
        elif k == "page_up":
            self.t.yview_scroll(-1, "pages")
        elif k == "page_down":
            self.t.yview_scroll(1, "pages")

    def _press(self, e):
        k = self._hit(e.y)
        if k == "thumb":
            self.drag = (e.y, self.first)
            self.draw()
            return
        self._step(k)

        def again(delay):
            self._step(k)
            self.rep = self.after(delay, lambda: again(70 if k in ("up", "down") else 160))
        self.rep = self.after(380, lambda: again(90))

    def _drag(self, e):
        if self.drag is None:
            return
        w, h, r, uy, dy, t0, t1 = self._geo()
        y0, y1 = self._thumb()
        span = max(1.0, (t1 - t0) - (y1 - y0))
        frac = self.drag[1] + (e.y - self.drag[0]) / span * (1 - (self.last - self.first))
        self.t.yview_moveto(max(0.0, min(1.0, frac)))

    def _release(self, e):
        if self.rep:
            self.after_cancel(self.rep)
            self.rep = None
        self.drag = None
        self.draw()

    def _wheel(self, e):
        up = getattr(e, "delta", 0) > 0 or getattr(e, "num", 0) == 4
        self.t.yview_scroll(-2 if up else 2, "units")


class RowList(tk.Canvas):
    """3.0: a list with real rows (the Ctrl+K results): a coloured kind, a title, a grey line under it and the
    keyboard shortcut on the right. Works like the small part of a Listbox the app uses."""
    KIND_COL = {"Do": "#6C63FF", "Recent": "#0A84FF", "Book": "#E08E00", "Document": "#00A884", "Text": "#E8467C"}
    RH = 44

    def __init__(self, parent, app):
        T = app.T
        super().__init__(parent, bg=T["panel"], highlightthickness=0, bd=0, yscrollincrement=1, takefocus=1)
        self.app, self.rows, self.sel, self.hov = app, [], None, None
        self._job = None
        self.bind("<Configure>", lambda e: self._draw())
        self.bind("<Motion>", self._motion)
        self.bind("<Leave>", lambda e: self._set_hov(None))
        self.bind("<Button-1>", self._click)
        for seq in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            self.bind(seq, self._wheel)
        self.bind("<Down>", lambda e: (self.move(1), "break")[1])
        self.bind("<Up>", lambda e: (self.move(-1), "break")[1])

    # the Listbox part the app uses
    def delete(self, a, b=None):
        if a == 0 and b == "end":
            self.rows, self.sel = [], None
            self._later()
            return
        super().delete(a, b) if b is not None else super().delete(a)

    def insert(self, _where, row):
        self.rows.append(row if isinstance(row, tuple) else ("", str(row), "", ""))
        self._later()

    def selection_set(self, i):
        if 0 <= i < len(self.rows):
            self.sel = i
            self._later()

    def curselection(self):
        return (self.sel,) if self.sel is not None else ()

    def size(self):
        return len(self.rows)

    def move(self, d):
        if not self.rows:
            return
        self.sel = 0 if self.sel is None else max(0, min(len(self.rows) - 1, self.sel + d))
        self._draw()
        self.see(self.sel)

    def see(self, i):
        h = self.winfo_height()
        top, y = self.canvasy(0), i * self.RH
        total = max(1, len(self.rows) * self.RH)
        if y < top:
            self.yview_moveto(y / total)
        elif y + self.RH > top + h:
            self.yview_moveto((y + self.RH - h) / total)

    # drawing
    def _later(self):
        if self._job is None:
            self._job = self.after_idle(self._draw)

    def _draw(self):
        self._job = None
        app, T, A = self.app, self.app.T, self.app.accent
        super().delete("all")
        W = max(200, self.winfo_width())
        RH = self.RH
        f9, f8b = app._sfont(10), app._sfont(8, "bold")
        for i, (kind, title, sub, key) in enumerate(self.rows):
            y = i * RH
            if i == self.sel or i == self.hov:
                round_rect(self, 4, y + 2, W - 4, y + RH - 2, 8,
                           fill=mix(T["panel"], A, 0.16 if i == self.sel else 0.07), outline="")
            x = 14
            if kind:
                col = self.KIND_COL.get(kind, A)
                kw = app._measure(kind, f8b) + 14
                round_rect(self, x, y + 12, x + kw, y + RH - 12, 9, fill=mix(T["panel"], col, 0.16), outline="")
                self.create_text(x + kw / 2, y + RH / 2, text=kind, font=app.F(8, "bold"), fill=col)
                x += max(kw, 70) + 10
            kx = W - 14
            if key:
                kw2 = app._measure(key, f8b) + 14
                round_rect(self, kx - kw2, y + 11, kx, y + RH - 11, 6, fill=T["chip"], outline=T["border"])
                self.create_text(kx - kw2 / 2, y + RH / 2, text=key, font=app.F(8, "bold"), fill=T["muted"])
                kx -= kw2 + 10
            room = max(40, kx - x)
            if sub:
                self.create_text(x, y + 14, text=app._fit_text(title, app._sfont(10, "bold"), room), anchor="w",
                                 font=app.F(10, "bold"), fill=T["text"])
                self.create_text(x, y + 30, text=app._fit_text(sub, app._sfont(9), room), anchor="w",
                                 font=app.F(9), fill=T["muted"])
            else:
                self.create_text(x, y + RH / 2, text=app._fit_text(title, f9, room), anchor="w", font=app.F(10),
                                 fill=T["text"])
        self.configure(scrollregion=(0, 0, W, max(len(self.rows) * RH, 1)))

    def _row_at(self, e):
        i = int(self.canvasy(e.y) // self.RH)
        return i if 0 <= i < len(self.rows) else None

    def _set_hov(self, i):
        if i != self.hov:
            self.hov = i
            self.configure(cursor="hand2" if i is not None else "")
            self._draw()

    def _motion(self, e):
        self._set_hov(self._row_at(e))

    def _click(self, e):
        i = self._row_at(e)
        if i is not None:
            self.sel = i
            self._draw()
            self.event_generate("<<RowChosen>>")

    def _wheel(self, e):
        d = -1 if (getattr(e, "delta", 0) > 0 or getattr(e, "num", 0) == 4) else 1
        self.yview_scroll(d * self.RH, "units")


class Segmented(tk.Frame):
    """Minimal tabs: words with an accent underline."""

    def __init__(self, parent, app, names, command):
        super().__init__(parent)
        self.app, self.command, self.names = app, command, names
        self.current = names[0]
        self.labels = {}
        for n in names:
            lb = tk.Label(self, text=n, cursor="hand2", padx=2, pady=6)
            lb.pack(side="left", padx=(0, 16))
            lb.bind("<Button-1>", lambda e, n=n: self.select(n, notify=True))
            self.labels[n] = lb
        self.bar = tk.Frame(self, height=2)
        self.redraw()

    def set_text(self, name, text):
        self.labels[name].configure(text=text)
        self.after_idle(self._place_bar)

    def select(self, name, notify=False):
        self.current = name
        self.redraw()
        if notify:
            self.command(name)

    def _place_bar(self):
        lb = self.labels[self.current]
        self.bar.place(x=lb.winfo_x(), y=lb.winfo_y() + lb.winfo_height() - 2, width=lb.winfo_width(), height=2)

    def redraw(self):
        T, A = self.app.T, self.app.accent
        self.configure(bg=T["panel"])
        for n, lb in self.labels.items():
            lb.configure(bg=T["panel"], fg=T["text"] if n == self.current else T["muted"],
                         font=self.app.F(10, "bold" if n == self.current else "normal"))
        self.bar.configure(bg=A)
        self.after_idle(self._place_bar)


def rounded_popup(app, x, y, build, radius=14):
    """Borderless popup with rounded corners (true transparency on Windows)."""
    T = app.T
    w = tk.Toplevel(app.root)
    w.wm_overrideredirect(True)
    key = "#010203"
    transparent = False
    if os.name == "nt":
        try:
            w.attributes("-transparentcolor", key)
            transparent = True
        except Exception:
            pass
    try:
        w.attributes("-topmost", True)
    except Exception:
        pass
    outer_bg = key if transparent else T["panel"]
    c = tk.Canvas(w, bg=outer_bg, highlightthickness=0, bd=0)
    c.pack()
    inner = tk.Frame(c, bg=T["panel"])
    build(inner)
    inner.update_idletasks()
    iw, ih = inner.winfo_reqwidth(), inner.winfo_reqheight()
    pad = 10
    W, H = iw + 2 * pad, ih + 2 * pad
    c.configure(width=W, height=H)
    if transparent:
        round_rect(c, 0, 0, W - 1, H - 1, radius, fill=T["border"], outline="")
        round_rect(c, 1, 1, W - 2, H - 2, radius - 1, fill=T["panel"], outline="")
    else:
        c.create_rectangle(0, 0, W - 1, H - 1, outline=T["border"], fill=T["panel"])
    c.create_window(pad, pad, window=inner, anchor="nw")
    w.geometry(f"+{max(0, int(x))}+{max(0, int(y))}")
    return w


