def is_shape(spec):
    return str(spec.get("look", "")).startswith("s_")


def shape_points(look, r):
    """The outline of a shape in the rect r (a list of points; None = draw it as rect / oval)."""
    import math
    x0, y0, x1, y1 = r.x0, r.y0, r.x1, r.y1
    w, h = r.width, r.height
    xm, ym = (x0 + x1) / 2, (y0 + y1) / 2
    if look == "s_diamond":
        return [(xm, y0), (x1, ym), (xm, y1), (x0, ym)]
    if look == "s_hex":
        k = min(w * 0.2, h * 0.5)
        return [(x0 + k, y0), (x1 - k, y0), (x1, ym), (x1 - k, y1), (x0 + k, y1), (x0, ym)]
    if look == "s_arrow":
        hl = min(w * 0.36, h * 0.8)
        t = h * 0.22
        return [(x0, y0 + t), (x1 - hl, y0 + t), (x1 - hl, y0), (x1, ym), (x1 - hl, y1), (x1 - hl, y1 - t),
                (x0, y1 - t)]
    if look == "s_star":
        pts = []
        for i in range(10):
            a = -math.pi / 2 + i * math.pi / 5
            k = 1.0 if i % 2 == 0 else 0.45
            pts.append((xm + w / 2 * k * math.cos(a), ym + h / 2 * k * math.sin(a) + h * 0.04))
        return pts
    if look == "s_banner":
        k = min(w * 0.12, h * 0.45)
        return [(x0, y0), (x1, y0), (x1 - k, ym), (x1, y1), (x0, y1)]
    return None


