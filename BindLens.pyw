        def draw_field(open_=False):
            field.delete("all")
            round_rect(field, 1, 1, LW - 1, 39, 9, fill=T["panel"], outline=A if open_ else T["border"], width=1.5)
            field.create_text(14, 20, text="Report", anchor="w", font=self.F(9), fill=T["muted"])
            x = 70
            if S["type"]:
                it, g_, col = items[S["type"]]
                self._rep_icon(field, S["type"], x - 2, 9, col, True, 22)
                tid = field.create_text(x + 28, 20, text=it[1], anchor="w", font=self.F(11, "bold"), fill=T["text"])
                field.create_text(field.bbox(tid)[2] + 12, 20, text=g_, anchor="w", font=self.F(9), fill=col)
            else:
                field.create_text(x, 20, text="Select", anchor="w", font=self.F(11), fill=T["muted"])
