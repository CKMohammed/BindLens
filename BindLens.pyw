        g = self.current_page if g is None else g
        fi, pi = self.book.pages[g][0], self.book.pages[g][1]
        f = self.book.files[fi]
        T = self.T
        d = self._dialog("Reminder")
        body = tk.Frame(d, bg=T["panel"])
        body.pack(fill="both", padx=20, pady=(16, 6))
        tk.Label(body, text=f'{os.path.basename(f["rel"])}  ·  page {pi + 1}', font=self.F(10, "bold"),
                 bg=T["panel"], fg=T["text"]).pack(anchor="w")
        tk.Label(body, text="REMIND ME ON", font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(
            anchor="w", pady=(12, 3))
        dv = tk.StringVar(value=time.strftime("%d/%m/%Y", time.localtime(time.time() + 86400)))
        row = tk.Frame(body, bg=T["panel"])
        row.pack(anchor="w")
        ttk.Entry(row, textvariable=dv, width=12, font=self.F(10)).pack(side="left")
