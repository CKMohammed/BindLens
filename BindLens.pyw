        tabf = OrderedDict((k, tk.Frame(ribbon, bg=RB)) for k in ("home", "insert", "page", "table", "pic"))
        tab_names = OrderedDict([("home", "Home"), ("insert", "Insert"), ("page", "Page"), ("table", "Table"),
                                 ("pic", "Picture")])
        tab_lbls = {}

        def show_tab(k):
            state["tab"] = k
            for kk, fr in tabf.items():
                fr.pack_forget()
            tabf[k].pack(fill="x", anchor="w")
            paint_tabs()

        def paint_tabs():
            kind = "table" if isinstance(state["embed"], RichTable) else (
                "pic" if isinstance(state["embed"], PicEmbed) else None)
            for k, lb in tab_lbls.items():
                if k in ("table", "pic"):
                    if k == kind:
                        lb.pack(side="left", padx=(0, 2))
                    else:
                        lb.pack_forget()
                on = state["tab"] == k
                ctx = k in ("table", "pic")
                lb.configure(bg=RB if on else T["panel"], fg=ACC if (on or ctx) else T["text"],
                             font=self.F(9, "bold") if on else self.F(9))
        for k, nm in tab_names.items():
            lb = tk.Label(head, text=("  " + nm.upper() + "  ") if k in ("table", "pic") else nm, font=self.F(9),
                          bg=T["panel"], fg=T["text"], padx=14, pady=6, cursor="hand2")
            lb.pack(side="left", padx=(0, 2))
            lb.bind("<Button-1>", lambda e, k=k: show_tab(k))
            tab_lbls[k] = lb

        def btn(parent, text, cmd, tip="", big=None, font=None, wdt=None, side="left"):
            """A ribbon button. big = a function that draws an icon: a big button (icon over the words)."""
            if big:
                fr = tk.Frame(parent, bg=RB, cursor="hand2")
                cv = tk.Canvas(fr, width=36, height=26, bg=RB, highlightthickness=0, cursor="hand2")
                cv.pack(pady=(2, 0))
                big(cv)
                lb = tk.Label(fr, text=text, font=self.F(8), bg=RB, fg=T["text"], cursor="hand2", padx=4)
                lb.pack(pady=(0, 2))
                parts = (fr, cv, lb)
            else:
                fr = tk.Label(parent, text=text, font=font or self.F(9), bg=RB, fg=T["text"], padx=7, pady=3,
                              cursor="hand2", width=wdt or 0)
                parts = (fr,)
            fr.pack(side=side, padx=1, pady=1)
            fr.on_bg = RB

            def enter(_e):
                for p_ in parts:
                    p_.configure(bg=T["hover"])
                if tip:
                    tips.schedule(fr, tip)

            def leave(_e):
                for p_ in parts:
                    p_.configure(bg=fr.on_bg)
                tips.cancel()

            def click(e):
                tips.cancel()
                cmd(e)
            for p_ in parts:
                p_.bind("<Enter>", enter)
                p_.bind("<Leave>", leave)
                p_.bind("<Button-1>", click)
            fr.parts = parts
            return fr

        def ibtn(parent, draw, cmd, tip="", side="left"):
            cv = tk.Canvas(parent, width=26, height=24, bg=RB, highlightthickness=0, cursor="hand2")
            cv.pack(side=side, padx=1, pady=1)
            draw(cv)
            cv.on_bg = RB
            cv.parts = (cv,)
            cv.bind("<Enter>", lambda e: (cv.configure(bg=T["hover"]), tips.schedule(cv, tip) if tip else None))
            cv.bind("<Leave>", lambda e: (cv.configure(bg=cv.on_bg), tips.cancel()))
            cv.bind("<Button-1>", lambda e: (tips.cancel(), cmd(e)))
            return cv

        def set_on(b, on):
            b.on_bg = mix(RB, ACC, 0.25) if on else RB
            for p_ in b.parts:
                p_.configure(bg=b.on_bg)

        def group(tab, title):
            g = tk.Frame(tabf[tab], bg=RB)
            g.pack(side="left", fill="y", padx=(8, 6), pady=(5, 2))
            inner = tk.Frame(g, bg=RB)
            inner.pack(side="top", anchor="w", fill="x")
            tk.Label(g, text=title, font=self.F(7), bg=RB, fg=T["muted"]).pack(side="bottom", pady=(2, 0))
            tk.Frame(tabf[tab], width=1, bg=T["border"]).pack(side="left", fill="y", pady=8)
            return inner

        def two(inner):
            a_ = tk.Frame(inner, bg=RB)
            a_.pack(anchor="w")
            b_ = tk.Frame(inner, bg=RB)
            b_.pack(anchor="w", pady=(2, 0))
            return a_, b_

        def combo(parent, values, var, width, cmd, editable=False):
            cb = ttk.Combobox(parent, values=values, textvariable=var, width=width, font=self.F(9),
                              state="normal" if editable else "readonly")
            cb.pack(side="left", padx=2, pady=2)
            cb.bind("<<ComboboxSelected>>", lambda e: cmd())
            if editable:
                cb.bind("<Return>", lambda e: (cmd(), "break")[1])
            return cb
        INK = T["text"]

        def lines_icon(a):
            def draw(cv):
                for k, ln in enumerate((14, 9, 14, 7)):
                    y = 6 + k * 4
                    x0 = {"l": 6, "c": 13 - ln / 2, "r": 20 - ln, "j": 6}[a]
                    ln = 14 if a == "j" else ln
                    cv.create_line(x0, y, x0 + ln, y, fill=INK, width=1.6, capstyle="round")
            return draw

        def list_icon(numbered):
            def draw(cv):
                for k, y in enumerate((7, 12, 17)):
                    if numbered:
                        cv.create_text(7, y, text=str(k + 1), font=(self.F(7)[0], 7), fill=INK)
                    else:
                        cv.create_oval(5, y - 1.5, 8, y + 1.5, fill=INK, outline="")
                    cv.create_line(11, y, 21, y, fill=INK, width=1.6)
            return draw

        def big_table(cv):
            for k in range(4):
                cv.create_line(9, 4 + k * 6, 27, 4 + k * 6, fill=INK, width=1.3)
            for k in range(4):
                cv.create_line(9 + k * 6, 4, 9 + k * 6, 22, fill=INK, width=1.3)
            cv.create_rectangle(9, 4, 27, 10, fill=mix(ACC, "#FFFFFF", 0.55), outline=INK, width=1.3)

        def big_pic(cv):
            cv.create_rectangle(7, 4, 29, 22, outline=INK, width=1.4)
            cv.create_polygon(9, 20, 15, 12, 19, 17, 22, 14, 27, 20, fill=mix(ACC, "#FFFFFF", 0.3), outline="")
            cv.create_oval(21, 7, 25, 11, fill="#F2C94C", outline="")

        def big_line(cv):
            cv.create_line(6, 13, 30, 13, fill=INK, width=2)

        def big_break(cv):
            cv.create_rectangle(11, 2, 25, 9, outline=INK, width=1.2)
            cv.create_line(5, 13, 31, 13, fill=ACC, width=1.4, dash=(3, 2))
            cv.create_rectangle(11, 17, 25, 24, outline=INK, width=1.2)

        def big_text(t_, size=10):
            return lambda cv: cv.create_text(18, 13, text=t_, font=(self.F(9)[0], size, "bold"), fill=INK)

        def big_icon(name):
            return lambda cv: draw_icon(cv, name, 18, 13, INK, s=0.95)

        # ---- HOME ---------------------------------------------------------------------------------------
        styles = [("p", "Normal text"), ("h1", "Title"), ("h2", "Heading"), ("h3", "Subheading"), ("quote", "Quote"),
                  ("ul", "Bullet list"), ("ol", "Numbered list")]
        g = group("home", "Style")
        stv = tk.StringVar(value="Normal text")
        st_cb = combo(g, [x[1] for x in styles], stv, 14,
                      lambda: (rt.set_para(t=styles[st_cb.current()][0]), rt.t.focus_set()))
        g = group("home", "Font")
        ga, gb = two(g)
        fv = tk.StringVar(value=src.get("font", "Sans"))
        zv = tk.StringVar(value=f"{float(src.get('size_pt', 11)):g}")

        def set_font():
            rt.set_fmt(f=fv.get())
