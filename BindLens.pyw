            where = f'{os.path.basename(r["path"])} · p.{r["page"] + 1}' if r.get("path") else "Report"
            tk.Label(row, text=where + (f'  -  {r["note"]}' if r.get("note") else ""), font=self.F(9), bg=T["chip"],
                     fg=T["text"], anchor="w", wraplength=520, justify="left").pack(side="left", fill="x",
