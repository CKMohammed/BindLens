def fold(s):
    """3.0: text for matching - no accents, one kind of apostrophe, lower case: 'Sean' finds 'Seán', 'O'Brien'
    finds 'O’Brien'."""
    s = unicodedata.normalize("NFKD", s or "")
    s = "".join(ch for ch in s if not unicodedata.combining(ch))
    return s.replace("’", "'").replace("‘", "'").replace("`", "'").lower()


def fold_search(fitz, page, q, words=None):
    """Where q is on a page when the exact search finds nothing because of accents / apostrophes: the boxes of
    the words that match (folded). Returns [Rect]."""
    toks = fold(q).split()
    if not toks:
        return []
    if words is None:
        words = page.get_text("words")
    fw = [(fold(w[4]), w) for w in words]
    out = []
    n = len(toks)
    for i in range(len(fw) - n + 1):
        ok = True
        for k, t in enumerate(toks):
            w = fw[i + k][0]
            if n == 1:
                ok = t in w
            elif k == 0:
                ok = w.endswith(t)
            elif k == n - 1:
                ok = w.startswith(t)
            else:
                ok = w == t
            if not ok:
                break
        if ok:
            r = fitz.Rect(fw[i][1][:4])
            for k in range(1, n):
                r |= fitz.Rect(fw[i + k][1][:4])
            out.append(r)
    return out


_JSON_LOCKS = {}
_JSON_LOCKS_LOCK = threading.Lock()


def save_json_gz(path, data):
    """3.0: like save_json, packed (one save of a file at a time, a temporary file of its own)."""
    with _JSON_LOCKS_LOCK:
        lk = _JSON_LOCKS.setdefault(os.path.normcase(os.path.abspath(path)), threading.Lock())
    with lk:
        tmp = f"{path}.{os.getpid()}-{threading.get_ident()}.tmp"
        try:
            with gzip.open(tmp, "wt", encoding="utf-8", compresslevel=3) as fh:
                json.dump(data, fh, default=str)
            os.replace(tmp, path)
        finally:
            if os.path.exists(tmp):
                try:
                    os.remove(tmp)
                except OSError:
                    pass


def save_json(path, data):
    """3.0: safe saving - one save of a file at a time (two threads could mix their copies), dates and other
    odd values written as text (a date in a setting used to stop every save), and the bytes are really on the
    disk before the old file is replaced (a power cut can't leave half a file)."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with _JSON_LOCKS_LOCK:
        lk = _JSON_LOCKS.setdefault(os.path.normcase(os.path.abspath(path)), threading.Lock())
    with lk:
        tmp = f"{path}.{os.getpid()}-{threading.get_ident()}.tmp"
        try:
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=1, default=str)
                f.flush()
                try:
                    os.fsync(f.fileno())
                except OSError:
                    pass
            for k in range(6):
                try:
                    os.replace(tmp, path)
                    break
                except PermissionError:          # Windows: the file is being read this very moment
                    if k == 5:
                        raise
                    time.sleep(0.05 * (k + 1))
        finally:
            if os.path.exists(tmp):
                try:
                    os.remove(tmp)
                except OSError:
                    pass


def unique_path(folder, name):
    base, ext = os.path.splitext(name)
    if os.path.isdir(os.path.join(folder, name)):
        base, ext = name, ""
    cand = os.path.join(folder, name)
    i = 2
    while os.path.exists(cand):
        cand = os.path.join(folder, f"{base} ({i}){ext}")
        i += 1
    return cand


def safe_geometry(root, geo):
    """4.2.2: a saved window size and place that is really on the screen (with its title bar reachable) - a window
    off the screen, or bigger than it, comes back to the middle."""
    try:
        sw, sh = root.winfo_screenwidth(), root.winfo_screenheight()
    except Exception:
        return geo
    m = re.match(r"^(\d+)x(\d+)(?:([+-])(-?\d+)([+-])(-?\d+))?$", str(geo or "").strip())
    if not m:
        w, h, x, y = 1280, 820, None, None
    else:
        w, h = int(m.group(1)), int(m.group(2))
        x = y = None
        if m.group(3):
            x = int(m.group(4)) if m.group(3) == "+" else sw - w - int(m.group(4))
            y = int(m.group(6)) if m.group(5) == "+" else sh - h - int(m.group(6))
    w = max(820, min(w, sw - 40))
    h = max(520, min(h, sh - 90))
    if x is None or y is None or x < -8 or y < 0 or x + 160 > sw or y + 120 > sh:
        x, y = max(0, (sw - w) // 2), max(0, (sh - h) // 2 - 20)
    return f"{w}x{h}+{x}+{y}"


