def draw_tile(c, x, y, size, color, icon=None, text=None, font=None, selected=False, bg="#FFFFFF", tag=None,
              style="3d", badge=None):
    """A book tile: drawn smooth by PyMuPDF (3D, flat or light), or with Tk lines when that is not possible."""
    if _FITZ is not None:
        try:
            img, m = tile_photo(int(size), color, icon, text, style, badge, selected)
            return c.create_image(x - m, y - m, image=img, anchor="nw", **({"tags": tag} if tag else {}))
        except Exception:
            pass
    s = size
    r = s * 0.28
    kw = {"tags": tag} if tag else {}
    round_rect(c, x + 1, y + s * 0.07, x + s + 1, y + s + s * 0.07, r, fill=mix(color, bg, 0.55), outline="", **kw)
    round_rect(c, x, y, x + s, y + s, r, fill=mix(color, "#000000", 0.18), outline="", **kw)
    round_rect(c, x, y, x + s, y + s * 0.94, r, fill=color, outline="", **kw)
    round_rect(c, x + s * 0.08, y + s * 0.05, x + s * 0.92, y + s * 0.5, r * 0.8,
               fill=mix(color, "#FFFFFF", 0.22), outline="", **kw)
    round_rect(c, x + s * 0.08, y + s * 0.3, x + s * 0.92, y + s * 0.62, r * 0.6,
               fill=mix(color, "#FFFFFF", 0.1), outline="", **kw)
    ink = "#1F1F1F" if is_light(color) else "#FFFFFF"
    shade = mix(color, "#000000", 0.35)
    cx, cy = x + s / 2, y + s * 0.47
    if icon and "|" in icon:
        icon, text = icon.split("|", 1)
        icon = None
    if icon and icon != "letters":
        draw_icon(c, icon, cx + 0.8, cy + 1.2, shade, s=s / 46, w=1.9, tag=tag)
        draw_icon(c, icon, cx, cy, ink, s=s / 46, w=1.9, tag=tag)
    elif text:
        c.create_text(cx + 0.8, cy + 1.2, text=text, font=font, fill=shade, **kw)
        c.create_text(cx, cy, text=text, font=font, fill=ink, **kw)
    if selected:
        round_rect(c, x - 3, y - 3, x + s + 3, y + s + 3, r + 3, fill="", outline=color, width=2, **kw)


def draw_refresh(c, cx, cy, r, col, w=1.5, turn=0):
    """A small circular arrow (refresh) on a Tk canvas; turn = degrees (for a spinning one)."""
    import math
    c.create_arc(cx - r, cy - r, cx + r, cy + r, start=90 + turn, extent=280, style="arc", outline=col, width=w)
    a = math.radians(90 + turn)
    ex, ey = cx + r * math.cos(a), cy - r * math.sin(a)
    tx, ty = -math.sin(a), -math.cos(a)                    # the way the arrow points (anticlockwise end)
    tx, ty = -tx, -ty
    s_ = r * 0.75
    c.create_polygon(ex + tx * s_ * 0.2, ey + ty * s_ * 0.2, ex - tx * s_ + ty * s_ * 0.7,
                     ey - ty * s_ - tx * s_ * 0.7, ex - tx * s_ - ty * s_ * 0.7, ey - ty * s_ + tx * s_ * 0.7,
                     fill=col, outline=col)


def round_rect(c, x0, y0, x1, y1, r, **kw):
    """Rounded rectangle on a Tk canvas (smoothed polygon)."""
    r = max(0, min(r, (x1 - x0) / 2, (y1 - y0) / 2))
    pts = [x0 + r, y0, x1 - r, y0, x1, y0, x1, y0 + r, x1, y1 - r, x1, y1, x1 - r, y1, x0 + r, y1,
           x0, y1, x0, y1 - r, x0, y0 + r, x0, y0]
    return c.create_polygon(pts, smooth=True, splinesteps=24, **kw)


