    def _resolve_file(self, fname):
        """'Book / file' or 'file' -> (folder, rel, path) or None."""
        fname = str(fname).split("  (+")[0]
        target = None
        for f, files in self.lib.folders.items():
            for rel in files:
                if fname == f"{self.lib.label(f)} / {rel}":
                    return f, rel, self.lib.file_path(f, rel)
                if fname == rel and (target is None or f == self.folder):
                    target = (f, rel, self.lib.file_path(f, rel))
        return target

    def _remind_from_row(self, date, note, r, hdr):
        path, page, book = "", 0, None
        if "file" in hdr:
            res = self._resolve_file(r[hdr.index("file")])
            if res:
                book, _rel, path = res
            if "page" in hdr:
                try:
                    page = max(0, int(r[hdr.index("page")]) - 1)
                except Exception:
                    page = 0
        rem = self.lib.meta.setdefault("reminders", [])
        rem.append({"path": path, "page": page, "date": date.strftime("%Y-%m-%d"), "note": note, "done": False,
                    "book": book})
        self.lib.save_meta()
        self.set_status(f"Reminder saved for {date.strftime('%d %b %Y')}.")
        messagebox.showinfo(APP_NAME, f"BindLens will remind you on {date.strftime('%d %b %Y')}:\n\n{note}")

    def _status_from_row(self, r, hdr, status):
        res = self._resolve_file(r[hdr.index("file")])
        if not res:
            return
        folder, rel, path = res
        if self.book and folder == self.folder:
            for fi, f in enumerate(self.book.files):
                if f["rel"] == rel:
                    self.set_status_tag(fi, status)
                    return
        tags = self.lib.meta.setdefault("tags", {})
        if status:
            tags[self.lib.norm(path)] = status
        else:
            tags.pop(self.lib.norm(path), None)
        self.lib.save_meta()
        self.set_status(f"{os.path.basename(rel)}: {status or 'no status'}")

    def _jump_to_file(self, fname, page):
        """'Book / file' or 'file' (in the open book) + page number -> show it."""
        try:
            page = int(page)
        except Exception:
            page = 1
        target = None
        for f, files in self.lib.folders.items():
            for rel in files:
                if fname == f"{self.lib.label(f)} / {rel}":
                    target = (f, rel)
                elif fname == rel and (target is None or f == self.folder):
                    target = target or (f, rel)
                    if f == self.folder:
                        target = (f, rel)
        if not target:              # 3.0: only the document's own name (in this book first)
            for f, files in sorted(self.lib.folders.items(), key=lambda kv: kv[0] != self.folder):
                rel = next((r_ for r_ in files if os.path.basename(r_) == fname or
                            os.path.splitext(os.path.basename(r_))[0] == fname), None)
                if rel:
                    target = (f, rel)
                    break
        if not target:
            return False
        f, rel = target

        def there():
            for fi in (self.book.files if self.book else []):
                if fi["rel"] == rel and fi["count"]:
                    self.goto_page(fi["first"] + max(0, min(page, fi["count"]) - 1))
                    return
        if f != self.folder or self.book is None:
            self.open_folder(f, then=there)
        else:
            there()
        return True

    # ---- saved reports
    def _report_preset(self, st):
        st = json.loads(json.dumps({k: (sorted(v) if isinstance(v, set) else v) for k, v in st.items()},
                                   default=str))          # 3.0: only plain values (dates as text) in the settings
        return {"st": st,
                "terms": self._rep_terms_text, "cols": self._rep_cols.get(), "from": self._rep_from.get(),
                "to": self._rep_to.get(), "incol": self._rep_incol.get(), "excl": self._rep_excl.get(),
                "query": self._rep_query.get(), "fname": self._rep_fname.get() if hasattr(self, "_rep_fname") else ""}

    def _saved_menu(self, e, st, d):
        try:
            self._rep_terms_text = self._rep_terms.get("1.0", "end").strip()
        except Exception:
            pass
        saved = self.lib.settings.setdefault("saved_reports", [])
        m = self._menu()
        for p in saved:
            m.add_command(label=p["name"], command=lambda p=p: self._load_preset(p, st))
        if saved:
            m.add_separator()
        m.add_command(label="Save these settings…", command=lambda: self._save_preset(st, d))
        if saved:
            dm = self._menu(m)
            for p in saved:
                dm.add_command(label=p["name"], command=lambda p=p: (saved.remove(p), self.lib.save_meta()))
            m.add_cascade(label="Delete", menu=dm)
        self._popup(m, e)

    def _save_preset(self, st, d):
        what = next(x[2] for x in self.REPORT_TYPES if x[0] == st["type"])
        sug = what + (f" - {self._rep_terms_text.splitlines()[0][:30]}" if st["type"] == "rows" and
                      self._rep_terms_text else "")
        name = self._ask_string("Save report", "Name for these settings:", sug)
        if not name:
            return
        saved = self.lib.settings.setdefault("saved_reports", [])
        saved[:] = [p for p in saved if p["name"] != name]
        saved.append(dict(self._report_preset(st), name=name))
        self.lib.save_meta()
        self.set_status(f'Saved "{name}" - find it under "Saved" in Reports.')

    def _load_preset(self, p, st):
        for k, v in p.get("st", {}).items():
            st[k] = set(v) if k in ("inc", "colors", "kinds", "books", "mkinds") else v
        if st.get("type") not in self.REPORTS:
            st["type"] = "dashboard"
        self._rep_terms_text = p.get("terms", "")
        for var, k in ((self._rep_cols, "cols"), (self._rep_from, "from"), (self._rep_to, "to"),
                       (self._rep_incol, "incol"), (self._rep_excl, "excl"), (self._rep_query, "query"),
                       (getattr(self, "_rep_fname", None), "fname")):
            if var is not None:
                var.set(p.get(k, ""))
        self._rep_pick(st["type"])

    def _load_name_list(self, tx, parent):
        path = filedialog.askopenfilename(parent=parent, title="Load a list of names or values",
                                          filetypes=[("Lists", "*.txt *.csv *.xlsx"), ("All files", "*.*")])
        if not path:
            return
        try:
            vals = read_list_file(path)
        except Exception as ex:
            messagebox.showerror(APP_NAME, f"Could not read that file:\n{ex}", parent=parent)
            return
        if not vals:
            messagebox.showinfo(APP_NAME, "No names found in the first column.", parent=parent)
            return
        cur = tx.get("1.0", "end").strip()
        tx.delete("1.0", "end")
        tx.insert("1.0", (cur + "\n" if cur else "") + "\n".join(vals))
        self._rep_terms_text = tx.get("1.0", "end").strip()
        self.set_status(f"Loaded {len(vals)} names from {os.path.basename(path)} (first column).")

    def _save_report(self, rep, dst, fmt, parent=None, then=None):
        if fmt == "xlsx" and rep.get("preview_table") and not any(b[0] == "table" for b in rep["blocks"]):
            rep = dict(rep, blocks=[("table", rep["preview_table"])] + list(rep["blocks"]))
        rep = dict(rep, _logo=(self.lib.settings.get("icon") or "Black") + "|" + LOGO_STYLE)     # 1.9.6: the logo in your colours

        def done(err=None):
            try:
                if parent is not None:
                    parent.config(cursor="")
            except Exception:
                pass
            if err == "perm":
                messagebox.showerror(APP_NAME, "Could not save - is that file open in another program?",
                                     parent=parent)
                return
            if err:
                messagebox.showerror(APP_NAME, f"Could not save the report:\n{err}", parent=parent)
                return
            if then is not None:                     # (printing: no question, straight to the printer)
                then(dst)
                return
            self.set_status(f"Report saved: {dst}")
            if messagebox.askyesno(APP_NAME, "Report ready.\n\nOpen it now?", parent=parent):
                open_in_os(dst)

        def here():
            try:
                write_report_file(self.fitz, rep, dst, fmt, self.accent)
            except PermissionError:
                return done("perm")
            except Exception as ex:
                return done(str(ex))
            done()
        if self.pool.disabled:
            here()
            return
        # written by a helper: a long report never holds the window up
        self.set_status("Saving the report…")
        try:
            if parent is not None:
                parent.config(cursor="watch")
        except Exception:
            pass

        def got(res):
            if res.get("fallback"):
                here()
            elif res.get("ok"):
                done()
            else:
                done("perm" if res.get("perm") else (res.get("err") or "unknown problem"))
        self.pool.submit("write", prio=3, timeout=1800, rep=rep, dst=dst, fmt=fmt, accent=self.accent, cb=got)

    def _subtitle(self, scope, extra=""):
        where = {"file": "This file", "folder": "This book", "library": "All my books"}.get(scope, "Chosen books")
        return f"BindLens · {where} · {time.strftime('%d %B %Y')}" + (f" · {extra}" if extra else "")

    # ---- Find rows: names / values across every table and line --------------------------------
    def _rep_marks(self, st, scope, title):
        rows = st.get("_marks") if st.get("_marks") is not None else self._gather_marks(scope)
        kinds = set()
        for k in st.get("mkinds", self.MARK_TYPES):
            kinds |= self.MARK_TYPES[k]
        rows = [r for r in rows if r["kind"] in kinds]
        if st["colors"]:
            rows = [r for r in rows if r["color"] in st["colors"]]
        if st["when"] != "any":
            days = {"today": 0, "week": 7, "month": 30}[st["when"]]
            limit = time.strftime("%Y-%m-%d", time.localtime(time.time() - days * 86400))
            rows = [r for r in rows if r["date"] and r["date"] >= limit]
        if not rows:
            messagebox.showinfo(APP_NAME, "No marks match these filters." if (st["colors"] or st["when"] != "any") else
                                "There are no highlights or notes here yet.")
            return None
        headers = ["Colour", "Marked text", "Note", "Kind", "File", "Page"]
        widths = [10, 46, 26, 12, 22, 6]

        def tr(r):
            return [color_name(r["color"]), r["text"] or KIND_LABEL.get(r["kind"], r["kind"]), r["note"],
                    KIND_LABEL.get(r["kind"], r["kind"]),
                    r["file"] if scope != "library" else f'{self.lib.label(r["folder"])} / {r["file"]}', r["page"]]
        blocks = []
        if st["group"] == "color":
            groups = OrderedDict()
            for r in sorted(rows, key=lambda r: (color_name(r["color"]), r["folder"], natural_key(r["file"]),
                                                 r["page"], r["y"])):
                groups.setdefault(color_name(r["color"]), []).append(r)
            for name, items in groups.items():
                blocks.append(("h", f"{name}  ({len(items)})"))
                blocks.append(("table", {"name": name, "headers": headers, "widths": widths,
                                         "rows": [tr(r) for r in items], "colors": [r["color"] for r in items]}))
        else:
            groups = OrderedDict()
            for r in sorted(rows, key=lambda r: (r["folder"], natural_key(r["file"]), r["page"], r["y"])):
                head = r["file"] if scope != "library" else f'{self.lib.label(r["folder"])} / {r["file"]}'
                groups.setdefault(head, []).append(r)
            for head, items in groups.items():
                blocks.append(("h", head))
                blocks.append(("table", {"name": os.path.basename(head), "headers": headers[:4] + ["Page"],
                                         "widths": [10, 50, 28, 12, 6],
                                         "rows": [tr(r)[:4] + [r["page"]] for r in items],
                                         "colors": [r["color"] for r in items]}))
        return {"title": f"My marks - {title}", "subtitle": self._subtitle(scope, f"{len(rows)} marks"),
                "blocks": blocks}

    @staticmethod
    def _sentence(text, i, j):
        """The sentence around text[i:j] (a full stop inside 1,250.00 or 12.05.2026 is not an end)."""
        a = 0
        for m in re.finditer(r"[.!?](?=\s)|\n\s*\n", text[:i]):
            a = m.end()
        m = re.search(r"[.!?](?=\s|$)|\n\s*\n", text[j:])
        b = j + m.end() if m else len(text)
        if b - a > 320:
            a, b = max(a, i - 140), min(b, j + 160)
        return " ".join(text[a:b].split())

    STOP = set("""a an and are as at be been but by for from has have he her his i if in into is it its of on or our
    she so that the their them there these they this to was we were which who will with you your not can may also
    more than other such any all each per one two use used using within without about after before between both
    de la el en y a los las del un una que por con para es al lo se su sus o como mas más pero sin sobre entre
    este esta estos estas ese esa le les ha han ya muy también tambien donde cuando page""".split())

    def _rep_overview(self, st, scope, title):
        files = self._scope_files(scope)
        marks = self._gather_marks(scope)
        words = {}
        total_pages = total_words = 0
        per_file = []
        marked_files = {(m["folder"], m["file"]) for m in marks}
        for folder, rel, p in files:
            texts = self._page_texts(p)
            wc = 0
            for t in texts:
                toks = re.findall(r"[A-Za-zÀ-ÿ][A-Za-zÀ-ÿ'-]{2,}", t.lower())
                wc += len(toks)
                for w in toks:
                    if w not in self.STOP:
                        words[w] = words.get(w, 0) + 1
            total_pages += len(texts)
            total_words += wc
            nm = sum(1 for m in marks if m["folder"] == folder and m["file"] == rel)
            per_file.append([rel if scope != "library" else f"{self.lib.label(folder)} / {rel}", len(texts), wc, nm])
        by_color = OrderedDict()
        for m in marks:
            by_color.setdefault(color_name(m["color"]), [m["color"], 0])[1] += 1
        by_kind = OrderedDict()
        for m in marks:
            k = KIND_LABEL.get(m["kind"], m["kind"])
            by_kind[k] = by_kind.get(k, 0) + 1
        top = sorted(words.items(), key=lambda kv: -kv[1])[:20]
        unmarked = [r[0] for r in per_file if r[3] == 0]
        blocks = [("table", {"name": "Totals", "headers": ["", ""], "widths": [30, 20], "rows": [
            ["Files", len(files)], ["Pages", total_pages], ["Words", total_words], ["Marks", len(marks)],
            ["Reading time (approx.)", f"{max(1, round(total_words / 230))} min"]]})]
        if scope == "folder" and self.folder is not None and self.book and self.book.total:
            pos = self.lib.meta["positions"].get(self.folder, {})
            pg = pos.get("page", 0) + 1
            blocks.append(("p", f"Reading progress: page {pg} of {self.book.total} "
                                f"({round(100 * pg / max(1, self.book.total))}%)."))
        blocks.append(("h", "Files"))
        blocks.append(("table", {"name": "Files", "headers": ["File", "Pages", "Words", "Marks"],
                                 "widths": [50, 8, 10, 8], "rows": per_file}))
        if by_color:
            blocks.append(("h", "Marks per colour"))
            blocks.append(("table", {"name": "Colours", "headers": ["Colour", "Marks"], "widths": [20, 10],
                                     "rows": [[n, c[1]] for n, c in by_color.items()],
                                     "colors": [c[0] for c in by_color.values()]}))
            blocks.append(("h", "Marks per kind"))
            blocks.append(("table", {"name": "Kinds", "headers": ["Kind", "Marks"], "widths": [20, 10],
                                     "rows": [[k, v] for k, v in by_kind.items()]}))
        if top:
            blocks.append(("h", "Most frequent words"))
            blocks.append(("table", {"name": "Key words", "headers": ["Word", "Times"], "widths": [24, 10],
                                     "rows": [[w, n] for w, n in top]}))
        if unmarked:
            blocks.append(("h", f"Not marked yet  ({len(unmarked)})"))
            for u in unmarked:
                blocks.append(("li", u))
        return {"title": f"Overview - {title}", "subtitle": self._subtitle(scope), "blocks": blocks}

    # ================================================================ misc
    def _schedule_save(self):
        if self._save_job:
            self.root.after_cancel(self._save_job)
        self._save_job = self.root.after(1500, self._remember_position)

    def _remember_position(self):
        self._save_job = None
        if not self.book or not self.book.total or self.folder is None:
            return
        g, frac = self._position()
        st = {"page": g, "frac": round(frac, 4), "zoom": round(self.zoom, 4), "fit": self.fit_mode}
        if self.lib.meta["positions"].get(self._poskey()) != st:
            self.lib.meta["positions"][self._poskey()] = st
            self.lib.save_meta()

