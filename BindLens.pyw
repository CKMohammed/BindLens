    def _page_tone(self):
        """3.0: how pages look - normal (False), warm paper ('warm') or night (True: dark pages, light text).
        4.2: reading mode can have its own (Personalise > Reading mode)."""
        if getattr(self, "_reading", False):
            pg_ = self._read_conf().get("page", "same")
            if pg_ in ("normal", "warm", "night"):
                return {"normal": False, "warm": "warm", "night": True}[pg_]
        if self.lib.settings.get("night_pages"):
            return True
        return "warm" if self.lib.settings.get("warm_pages") else False

    def _set_setting(self, key, value):
        self.lib.settings[key] = value
        if key == "night_pages" and value:
            self.lib.settings["warm_pages"] = False
        if key == "warm_pages" and value:
            self.lib.settings["night_pages"] = False
        self.lib.save_meta()
        if key in ("theme", "accent", "night_pages", "warm_pages"):
            self.apply_theme()

    # ============================================================== search
    def focus_search(self):
        if self.fullscreen:
            self.toggle_fullscreen()
        self._search_placeholder(False)
        self.search_entry.focus_set()
        self.search_entry.select_range(0, "end")

    # ---- 1.9: the search box finds documents by their name too - not exact ('week 38', 'wk38', 'invoce') ----
    def _sugg_update(self, e=None):
        if e is not None and e.keysym in ("Down", "Up", "Return", "KP_Enter", "Escape", "Shift_L", "Shift_R",
                                          "Control_L", "Control_R", "Left", "Right", "Tab"):
            return
        if getattr(self, "_ph", False):
            return
        q = self.search_var.get().strip()
        if len(q) < 2:
            self._sugg_close()
            return
        if getattr(self, "_sugg_job", None):
            self.root.after_cancel(self._sugg_job)
        self._sugg_job = self.root.after(120, lambda: self._sugg_show(q))

    def _sugg_show(self, q):
        self._sugg_job = None
        if self.search_var.get().strip() != q or self.root.focus_get() is not self.search_entry:
            return
        T, A = self.T, self.accent
        docs = self._find_docs(q, limit=6)
        rows = [("doc", f, rel) for _sc, f, rel in docs]
        if self.book and self.book.total:
            rows.append(("in", None, None))
        rows.append(("all", None, None))
        self._sugg_rows = rows
        self._sugg_q = q
        self._sugg_i = 0
        w_ = getattr(self, "_sugg", None)
        if w_ is None or not w_.winfo_exists():
            w_ = tk.Canvas(self.root, highlightthickness=1, bd=0, cursor="hand2")
            w_.bind("<Motion>", lambda e: self._sugg_hover(e))
            w_.bind("<Button-1>", lambda e: (self._sugg_hover(e), self._sugg_go()))
            self._sugg = w_
        W = 430
        H = 12 + (22 if docs else 0) + 40 * len(docs) + 24 + 30 * (len(rows) - len(docs)) + 6
        sc = self.search_canvas
        x = sc.winfo_rootx() - self.root.winfo_rootx() + sc.winfo_width() - W
        y = sc.winfo_rooty() - self.root.winfo_rooty() + sc.winfo_height() + 4
        w_.configure(width=W, height=H, bg=T["panel"], highlightbackground=T["border"])
        w_.place(x=max(4, x), y=y)
        w_.tk.call("raise", w_._w)
        self._sugg_draw()

    def _sugg_draw(self):
        w_ = getattr(self, "_sugg", None)
        if w_ is None or not w_.winfo_exists():
            return
        T, A = self.T, self.accent
        w_.delete("all")
        W = int(w_.cget("width"))
        y = 8
        self._sugg_hits = []
        q = self._sugg_q
        nd = sum(1 for r in self._sugg_rows if r[0] == "doc")
        if nd:
            w_.create_text(14, y + 9, text="DOCUMENTS", anchor="w", font=self.F(8, "bold"), fill=T["muted"])
            y += 22
        for i, (kind, f, rel) in enumerate(self._sugg_rows):
            if kind != "doc" and (i == nd):
                w_.create_text(14, y + 11, text="SEARCH THE TEXT", anchor="w", font=self.F(8, "bold"),
                               fill=T["muted"])
                y += 24
            h = 40 if kind == "doc" else 30
            on = i == self._sugg_i
            if on:
                round_rect(w_, 6, y, W - 6, y + h, 8, fill=mix(T["panel"], A, 0.16), outline="")
            if kind == "doc":
                col = self.lib.color(f)
                x0, y0 = 16, y + 8
                w_.create_polygon(x0, y0, x0 + 13, y0, x0 + 18, y0 + 5, x0 + 18, y0 + 24, x0, y0 + 24,
                                  fill=mix(T["panel"], col, 0.25), outline=col)
                w_.create_line(x0 + 4, y0 + 11, x0 + 14, y0 + 11, fill=col)
                w_.create_line(x0 + 4, y0 + 16, x0 + 12, y0 + 16, fill=col)
                w_.create_text(44, y + 13, text=self._short(os.path.basename(rel), 44), anchor="w",
                               font=self.F(10, "bold"), fill=T["text"])
                where_ = self.lib.label(f) + ((" / " + os.path.dirname(rel)) if "/" in rel else "")
                w_.create_text(44, y + 29, text=self._short(where_, 56), anchor="w", font=self.F(8),
                               fill=T["muted"])
            else:
                draw_icon(w_, "search", 24, y + h / 2, A if on else T["muted"], s=0.6)
                qq = q if len(q) <= 32 else q[:31] + "…"
                txt = (f"In this book:  “{qq}”" if kind == "in" else f"In all my books:  “{qq}”")
                w_.create_text(44, y + h / 2, text=txt, anchor="w", font=self.F(10), fill=T["text"])
                w_.create_text(W - 16, y + h / 2, text="Enter" if kind == "in" and on else
                               ("Ctrl+K" if kind == "all" else ""), anchor="e", font=self.F(8), fill=T["muted"])
            if on and kind == "doc":
                w_.create_text(W - 16, y + 13, text="Enter", anchor="e", font=self.F(8), fill=T["muted"])
            self._sugg_hits.append((y, y + h, i))
            y += h

    def _sugg_hover(self, e):
        for y0, y1, i in getattr(self, "_sugg_hits", []):
            if y0 <= e.y < y1 and i != self._sugg_i:
                self._sugg_i = i
                self._sugg_draw()
                return

    def _sugg_move(self, step):
        w_ = getattr(self, "_sugg", None)
        if w_ is None or not w_.winfo_ismapped():
            return
        self._sugg_i = (self._sugg_i + step) % len(self._sugg_rows)
        self._sugg_draw()
        return "break"

    def _sugg_open(self):
        w_ = getattr(self, "_sugg", None)
        return w_ is not None and w_.winfo_exists() and w_.winfo_ismapped()

    def _sugg_close(self):
        w_ = getattr(self, "_sugg", None)
        if w_ is not None:
            try:
                w_.place_forget()
            except Exception:
                pass

    def _sugg_close_later(self):
        def chk():
            w_ = getattr(self, "_sugg", None)
            if w_ is None or not w_.winfo_ismapped():
                return
            px, py = self.root.winfo_pointerxy()
            if self._inside(w_, px, py) and self.root.focus_displayof() is not None:
                self.root.after(300, chk)
                return
            self._sugg_close()
        self.root.after(250, chk)

    def _sugg_go(self):
        if not self._sugg_open():
            return
        kind, f, rel = self._sugg_rows[self._sugg_i]
        q = self._sugg_q
        self._sugg_close()
        if kind == "doc":
            self._search_placeholder(False)
            self.search_var.set("")
            self.canvas.focus_set()
            self._go_doc(f, rel)
            self.set_status(f"Opened {os.path.basename(rel)}")
        elif kind == "in":
            self.start_search(q)
        else:
            self.quick_search(q)

    def _on_search_enter(self, direction):
        if self._sugg_open():
            self._sugg_go()
            return
        q = self.search_var.get().strip()
        if not q or getattr(self, "_ph", False):
            self.clear_search()
            return
        if q != self.search_query:
            self.start_search(q)
        else:
            self.search_step(direction)

    def _cancel_search(self):
        self._search_token = None              # answers still on their way from the helpers are ignored
        if self.search_job:
            self.root.after_cancel(self.search_job)
            self.search_job = None

    def clear_search(self):
        self._cancel_search()
        pages = set(self.hits_by_g)
        self.search_query = ""
        self.hits, self.hits_by_g, self.hit_cur = [], {}, -1
        self.res_tree.delete(*self.res_tree.get_children())
        self.set_search_count("")
        for g in pages:
            self._invalidate(g)
        self.redraw()

    def _tab_search_go(self):
        q = self.tab_search_var.get().strip()
        if not q:
            self.clear_search()
            return
        if not self.book or not self.book.total:
            self.set_status("Open a book first - or press Ctrl+K to search all your books.")
            return
        self.start_search(q)

    def start_search(self, q):
        self.clear_search()
        if not self.book or not self.book.total:
            return
        self.search_query = q
        self._search_placeholder(False)
        self.search_var.set(q)
        try:
            if self.tab_search_var.get() != q:
                self.tab_search_var.set(q)
        except Exception:
            pass
        self.search_next = 0
        self.set_search_count("…")
        self.show_tab("Search")
        if not self.pool.disabled:
            self._search_with_helpers(q)
            return
        self.search_job = self.root.after(1, self._search_batch)

    def _search_with_helpers(self, q):
        """Search this book in the helper processes (the window never opens a file for it). Files are
        skipped when their text (already read for Ctrl+K) does not have the word; results come in page order."""
        book, token = self.book, object()
        self._search_token = token
        n = len(book.files)
        got, state = {}, {"next": 0}
        qn = " ".join(fold(q).split())

        def candidates(f):
            sz = self.page_sizes.get(f["key"]) or {}
            e = self.indexer.get(f["key"])
            if not e or e.get("mtime") != sz.get("m") or not e.get("pages"):
                return None
            return [i for i, t in enumerate(e["pages"]) if qn in " ".join(fold(t).split())]

        def flush():
            if self.book is not book or self._search_token is not token:
                return
            while state["next"] in got:
                fi = state["next"]
                f = book.files[fi]
                for pi, hits in got.pop(fi):
                    if pi >= f["count"]:
                        continue
                    g = f["first"] + pi
                    self.hits_by_g[g] = [tuple(r) for r, _s in hits]
                    self._invalidate(g)
                    for r, snip in hits:
                        idx = len(self.hits)
                        self.hits.append((g, tuple(r)))
                        self.res_tree.insert("", "end", iid=str(idx), text="  " + snip, values=(g + 1,))
                state["next"] += 1
                self.search_next = f["first"] + f["count"]
            nh = len(self.hits)
            if self.hit_cur < 0 and nh:
                start = next((i for i, h in enumerate(self.hits) if h[0] >= self.current_page), None)
                if start is not None or state["next"] >= n:
                    self.hit_cur = start if start is not None else 0
                    self._goto_hit()
            if state["next"] < n:
                self.set_search_count(f"{nh}…")
                return
            self.search_next = self._total()
            self.set_search_count(f"{self.hit_cur + 1}/{nh}" if nh else "0")
            self.set_status(f'{nh} results for "{q}" in this folder.  Enter = next · Ctrl+K = search everywhere'
                            if nh else f'No results for "{q}" in this folder. Try Ctrl+K to search everywhere.')
            self.redraw()

        def local(fi):
            f = book.files[fi]
            out = []
            for pi in range(f["count"]):
                g = f["first"] + pi
                try:
                    page = book.page(g)
                    m = page.rotation_matrix
                    rects = [tuple(r * m) for r in (page.search_for(q) or fold_search(self.fitz, page, q))]
                except Exception:
                    rects = []
                if rects:
                    out.append((pi, [(r, self._snippet(g, r, q)) for r in rects]))
            return out

        for fi, f in enumerate(book.files):
            if f["error"] or not f["count"]:
                got[fi] = []
                continue
            if fi in book.keep or self.writer.get(f["path"]) is not None:
                got[fi] = local(fi)                         # changed here, not yet on the disk
                continue
            cand = candidates(f)
            if cand is not None and not cand:
                got[fi] = []
                continue

            def cb(res, fi=fi):
                if self._search_token is not token:
                    return
                got[fi] = local(fi) if res.get("fallback") else (res.get("pages") or [])
                flush()
            self.pool.submit("search", prio=2, timeout=600, path=f["path"], q=q, pages=cand, cb=cb,
                             cancel=lambda: self.book is not book or self._search_token is not token)
        flush()

    def _search_batch(self):
        self.search_job = None
        if not self.book:
            return
        q, t0, g = self.search_query, time.time(), self.search_next
        while g < self._total() and time.time() - t0 < 0.06:
            try:
                page = self.book.page(g)
                m = page.rotation_matrix
                rects = [tuple(r * m) for r in page.search_for(q)]
            except Exception:
                rects = []
            if rects:
                self.hits_by_g[g] = rects
                self._invalidate(g)
                for r in rects:
                    idx = len(self.hits)
                    self.hits.append((g, r))
                    self.res_tree.insert("", "end", iid=str(idx), text="  " + self._snippet(g, r, q),
                                         values=(g + 1,))
            g += 1
        self.search_next = g
        n = len(self.hits)
        if self.hit_cur < 0 and n:
            start = next((i for i, h in enumerate(self.hits) if h[0] >= self.current_page), None)
            if start is not None or g >= self._total():
                self.hit_cur = start if start is not None else 0
                self._goto_hit()
        if g < self._total():
            self.set_search_count(f"{n}…")
            self.search_job = self.root.after(1, self._search_batch)
        else:
            self.set_search_count(f"{self.hit_cur + 1}/{n}" if n else "0")
            self.set_status(f'{n} results for "{q}" in this folder.  Enter = next · Ctrl+K = search everywhere'
                            if n else f'No results for "{q}" in this folder. Try Ctrl+K to search everywhere.')
            self.redraw()

    def _snippet(self, g, r, q):
        words = self._words(g)
        for i, w in enumerate(words):
            if w[2] >= r[0] - 1 and w[0] <= r[2] + 1 and w[3] >= r[1] - 1 and w[1] <= r[3] + 1:
                return ("…" if i > 4 else "") + " ".join(x[4] for x in words[max(0, i - 4):i + 8]) + "…"
        return q

    def search_step(self, d):
        if not self.hits:
            return
        self.hit_cur = (self.hit_cur + d) % len(self.hits)
        self._goto_hit()

    def _goto_hit(self):
        g, r = self.hits[self.hit_cur]
        self._show_spot(g, r)
        iid = str(self.hit_cur)
        if self.res_tree.exists(iid):
            self.res_tree.selection_set(iid)
            self.res_tree.see(iid)
        self.set_search_count(f"{self.hit_cur + 1}/{len(self.hits)}")

    def _on_result_click(self, _e=None):
        sel = self.res_tree.selection()
        if sel:
            self.hit_cur = int(sel[0])
            self._goto_hit()

    # ---- library-wide search (Ctrl+K)
    def _schedule_index(self):
        """Ask the background reader to (re)read new or changed documents. Never blocks the window."""
        if self._index_job is not None:
            self.root.after_cancel(self._index_job)
        self._index_job = self.root.after(1500, self._send_index)

    def _send_index(self):
        self._index_job = None
        files = []
        for folder, rel in self.lib.all_files():
            p = self.lib.file_path(folder, rel)
            files.append((self.lib.norm(p), p))
        keys = {k for k, _ in files}

        def work():
            self.indexer.forget_except(keys)
            self.indexer.request(files)
        threading.Thread(target=work, daemon=True).start()

    @property
    def _index_queue(self):
        return self.indexer.pending

