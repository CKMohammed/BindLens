        txt = tk.Text(d, width=46, height=3, font=self.F(10), wrap="word", bd=1, relief="solid")
        txt.pack(padx=20, pady=(8, 4))
        txt.insert("1.0", p.get("text", ""))
        st = {"color": p.get("color") or "#E8772E"}
        cf = tk.Frame(d, bg=T["panel"])
        cf.pack(anchor="w", padx=20)

        def paint():
            for w_ in cf.winfo_children():
                w_.destroy()
            for c in CAL_COLORS:
                cv = tk.Canvas(cf, width=24, height=24, bg=T["panel"], highlightthickness=0, cursor="hand2")
                cv.pack(side="left", padx=1)
                cv.create_oval(4, 4, 20, 20, fill=c, outline=T["text"] if st["color"] == c else "")
                cv.bind("<Button-1>", lambda e, c=c: (st.__setitem__("color", c), paint()))
        paint()
        uf = tk.Frame(d, bg=T["panel"])
        uf.pack(anchor="w", padx=20, pady=(8, 0))
        tk.Label(uf, text="Show it until (dd/mm/yyyy - empty: always)", font=self.F(9), bg=T["panel"],
                 fg=T["text"]).pack(side="left")
        uv = tk.StringVar()
        if p.get("until"):
            try:
                import datetime
                uv.set(datetime.date.fromisoformat(p["until"]).strftime("%d/%m/%Y"))
            except Exception:
                pass
        ttk.Entry(uf, textvariable=uv, width=12).pack(side="left", padx=6)

        def save():
            t = txt.get("1.0", "end").strip()
            if not t:
                data.pop("pinned", None)
            else:
                u = parse_date_text(uv.get().strip()) if uv.get().strip() else None
