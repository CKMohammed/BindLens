            rt.set_fmt(z=z)
            rt.t.focus_set()
        f_cb = combo(ga, available_fonts(), fv, 12, set_font)
        z_cb = combo(ga, ["8", "9", "10", "10.5", "11", "12", "14", "16", "18", "20", "24", "28", "32", "36", "48",
                          "60", "72"], zv, 4, set_size, editable=True)
        btn(ga, "A+", lambda e: (rt.bump_size(1), sync_style()), "Bigger", font=self.F(9, "bold"))
        btn(ga, "A−", lambda e: (rt.bump_size(-1), sync_style()), "Smaller", font=self.F(8, "bold"))
        b_b = btn(gb, "B", lambda e: (rt.toggle("b"), sync_style()), "Bold  Ctrl+B", font=self.F(10, "bold"), wdt=2)
        b_i = btn(gb, "I", lambda e: (rt.toggle("i"), sync_style()), "Italic  Ctrl+I",
                  font=(self.F(10)[0], 10, "italic"), wdt=2)
        b_u = btn(gb, "U", lambda e: (rt.toggle("u"), sync_style()), "Underline  Ctrl+U",
                  font=(self.F(10)[0], 10, "underline"), wdt=2)
        b_s = btn(gb, "S", lambda e: (rt.toggle("s"), sync_style()), "Strike through",
                  font=(self.F(10)[0], 10, "overstrike"), wdt=2)

        def colour(kind, e):
            def done(c):
                rt.set_fmt(**({"c": c} if kind == "text" else {"bg": mix(c, "#FFFFFF", 0.45)}))
                rt.t.focus_set()
            self.palette_popup(None, done, e.x_root - 100, e.y_root + 16)
        ibtn(gb, lambda cv: (cv.create_text(13, 10, text="A", font=self.F(11, "bold"), fill=INK),
