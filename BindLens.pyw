            PillButton(row, self, "Delete for good", gone, kind="ghost", bg_key="chip").pack(side="right")
            PillButton(row, self, "Put it back", back, kind="soft", bg_key="chip").pack(side="right", padx=4)
        d._thumbs = thumbs
