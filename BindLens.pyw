        if p.get("text"):
            PillButton(bf, self, "Remove it", lambda: (data.pop("pinned", None), self._cal_changed(save=True),
                                                      d.destroy()), kind="soft").pack(side="left")
        d.bind("<Escape>", lambda e: d.destroy())
        self._center(d)
        txt.focus_set()

