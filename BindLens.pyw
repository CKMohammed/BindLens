    def check_reminders(self, show_all=False):
        rem = self.lib.meta.get("reminders", [])
        today = time.strftime("%Y-%m-%d")
        due = [r for r in rem if not r.get("done") and r["date"] <= today]
        w0 = getattr(self, "_rem_win", None)
        open_ = w0 is not None and w0.winfo_exists()
        shown = self.__dict__.setdefault("_rem_shown", set())
        new_ = [r for r in due if (r.get("path"), r.get("date"), r.get("note")) not in shown]
        # 3.0: one reminders window at a time, and the same reminders are not shown again every hour
        if due and not show_all and not open_ and new_:
            shown.update((r.get("path"), r.get("date"), r.get("note")) for r in due)
            self.reminders_dialog(only_due=True)
        self.root.after(3600 * 1000, self.check_reminders)

