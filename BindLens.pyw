class Speaker:
    """4.0: read aloud offline with the computer's own voices - Windows (System.Speech, word by word: the word read is
    shown on the page) or a Mac ('say', a page at a time). Nothing to install."""

    def __init__(self):
        self.proc = None
        self.kind = None
        self.q = queue.Queue()
        self.voices = []
        self.ready = False
        self.rate = 0
        self.voice = ""

    @staticmethod
    def available():
        return os.name == "nt" or sys.platform == "darwin"

    def start(self):
        if self.kind == "sapi" and self.proc is not None and self.proc.poll() is None:
            return True
        if os.name == "nt":
            try:
                enc = base64.b64encode(_PS_SPEAK.encode("utf-16-le")).decode()
                self.proc = subprocess.Popen(["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-STA",
                                              "-EncodedCommand", enc], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                             stderr=subprocess.DEVNULL, creationflags=0x08000000)
            except Exception as ex:
                _log(f"read aloud: {ex}")
                return False
            self.kind = "sapi"
            self.voices, self.ready = [], False
            threading.Thread(target=self._read, args=(self.proc,), daemon=True).start()
            return True
        if sys.platform == "darwin":
            self.kind = "say"
            if not self.voices:
                try:
                    out = subprocess.run(["say", "-v", "?"], capture_output=True, text=True, timeout=8).stdout
                    self.voices = [ln.split("  ")[0].strip() + "|" + (re.findall(r"\b[a-z]{2}_[A-Z]{2}\b", ln) or
                                                                       [""])[0] for ln in out.splitlines() if ln.strip()]
                except Exception:
                    self.voices = []
            self.ready = True
            return True
        return False

    def _read(self, proc):
        try:
            for raw in iter(proc.stdout.readline, b""):
                line = raw.decode("utf-8", "replace").strip()
                if line.startswith("voice "):
                    self.voices.append(line[6:])
                elif line == "ready":
                    self.ready = True
                elif line:
                    self.q.put(line)
        except Exception:
            pass
        self.q.put("gone")

    def _send(self, cmd):
        try:
            self.proc.stdin.write((cmd + "\n").encode("utf-8"))
            self.proc.stdin.flush()
            return True
        except Exception:
            return False

    def say(self, text):
        if self.kind == "sapi":
            if self.voice:
                self._send("voice " + self.voice)
            self._send(f"rate {int(self.rate)}")
            self._send("say " + base64.b64encode(text.encode("utf-8")).decode())
        elif self.kind == "say":
            self.stop()
            args = ["say", "-r", str(int(180 * (1.0 + self.rate / 10.0)))]
            if self.voice:
                args += ["-v", self.voice.split("|")[0]]
            try:
                self.proc = subprocess.Popen(args + [text])
            except Exception:
                return

            def wait(p=self.proc):
                rc = p.wait()
                self.q.put("done" if rc == 0 else "stopped")
            threading.Thread(target=wait, daemon=True).start()

    def pause(self):
        if self.kind == "sapi":
            self._send("pause")
        elif self.kind == "say" and self.proc is not None:
            try:
                import signal
                self.proc.send_signal(signal.SIGSTOP)
            except Exception:
                pass

    def resume(self):
        if self.kind == "sapi":
            self._send("resume")
        elif self.kind == "say" and self.proc is not None:
            try:
                import signal
                self.proc.send_signal(signal.SIGCONT)
            except Exception:
                pass

    def stop(self):
        if self.kind == "sapi":
            self._send("stop")
        elif self.kind == "say" and self.proc is not None and self.proc.poll() is None:
            try:
                self.resume()
                self.proc.terminate()
            except Exception:
                pass

    def close(self):
        try:
            if self.kind == "sapi" and self.proc is not None and self.proc.poll() is None:
                self._send("quit")
                self.proc.wait(timeout=1.5)
        except Exception:
            pass
        try:
            if self.proc is not None and self.proc.poll() is None:
                self.proc.kill()
        except Exception:
            pass


