def is_video(path):
    return os.path.splitext(path or "")[1].lower() in VIDEO_EXTS


def _doc_read(fh, path):
    """The bytes of a file, to show it. A video is never read (it can be gigabytes): only its card is shown."""
    if is_video(path):
        return b""
    return fh.read()

