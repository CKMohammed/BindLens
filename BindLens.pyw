        bf = tk.Frame(d, bg=T["panel"])
        bf.pack(fill="x", padx=20, pady=14)
        PillButton(bf, self, "Add", ok, kind="accent").pack(side="right")
        PillButton(bf, self, "Cancel", d.destroy, kind="ghost").pack(side="right", padx=6)
        self._center(d)
        e1.focus_set()

    def _cal_feed_refresh(self, fd, done=None, loud=False):
        """Read a calendar again: a link from the internet (in the background), a file when it changed."""
        if fd.get("file"):
            try:
                mt = os.path.getmtime(fd["file"])
                if loud or mt != fd.get("mtime"):
                    with open(fd["file"], "r", encoding="utf-8", errors="replace") as fh:
                        self._cal_store_feed(fd, fh.read())
                    fd["mtime"], fd["last"] = mt, time.strftime("%d %b %H:%M")
                    self.__dict__.setdefault("_cal_feed_mem", {}).pop(fd["id"], None)
                    self._cal_changed(save=True)
            except Exception as ex:
                if loud:
                    messagebox.showerror(APP_NAME, f"Could not read the calendar file:\n{ex}")
            if done:
                done()
            return
        url = fd.get("url")
        if not url:
            return

        def work():
            err, n = None, 0
            try:
                import urllib.request
                req = urllib.request.Request(url, headers={"User-Agent": f"BindLens/{APP_VERSION}"})
                with urllib.request.urlopen(req, timeout=25) as r:
                    raw = r.read(20 * 1024 * 1024)
                text = raw.decode("utf-8", errors="replace")
                if "BEGIN:VCALENDAR" not in text.upper():
                    raise ValueError("the link does not give a calendar (.ics)")
                n = self._cal_store_feed(fd, text)
            except Exception as ex:
                err = str(ex)

            def back():
                if err:
                    fd["error"] = err[:120]
                    if loud:
                        messagebox.showerror(APP_NAME, f"Could not read the calendar:\n{err}")
                else:
                    fd.pop("error", None)
                    fd["last"] = time.strftime("%d %b %H:%M")
                    self.__dict__.setdefault("_cal_feed_mem", {}).pop(fd["id"], None)
                    self._cal_changed(save=True)
                    if loud:
                        self._toast(f'Calendar "{fd.get("name", "")}" - {n} events.')
                if done:
                    try:
                        done()
                    except Exception:
                        pass
            self.root.after(0, back)
        threading.Thread(target=work, daemon=True).start()

    def _cal_hourly(self):
        """Imported calendars are read again every hour; today's notes are shown once a day."""
        try:
            for fd in self._cal_data()["feeds"]:
                if fd.get("on", True):
                    self._cal_feed_refresh(fd)
            self._cal_today_note()
        except Exception as ex:
            _log(f"calendar hourly: {ex}")
        self.root.after(3600 * 1000, self._cal_hourly)

    def _cal_today_note(self):
        import datetime
        t = datetime.date.today()
        if getattr(self, "_cal_noted", None) == t:
            return
        self._cal_noted = t
        items = [it for it in self._cal_collect(t, t).get(t, []) if it["k"] in ("note", "feed")]
        if items:
            txt = "  ·  ".join(((it.get("time") + " ") if it.get("time") else "") + it["t"] for it in items[:3])
            self._toast(f"Today: {txt}", ms=9000, action=("Calendar", lambda: self._cal_day_dialog(t)))

    def _cal_export(self):
        import datetime
        evs = []
        t = datetime.date.today()
        ev = self._cal_collect(t - datetime.timedelta(days=31), t + datetime.timedelta(days=366))
        for d in sorted(ev):
            for it in ev[d]:
                if it["k"] == "note":
                    evs.append((d, ((it.get("time") + " ") if it.get("time") else "") + it["t"], "From BindLens"))
        self.export_ics(evs, "BindLens calendar notes")

    def _flip_anim(self, i, now):
        geo = self._sides_geo.get("r")
        if not geo:
            return
        cv = self._side_r
        cv.delete("hands")
        if i > 10:
            self._flip_last = time.strftime("%H %M", now).split()
            self._clock_draw()
            return
        self._flip_draw(cv, geo[2], now, phase=i / 10)
        self.root.after(28, lambda: self._flip_anim(i + 1, now))

    # ---- 1.9.1: reading mode - only your pages, a contents list on the left, a calendar and clock on the right --
    def _top_pad(self):
        return 46 if getattr(self, "_reading", False) else 0

    def reading_mode(self, on=None):
        """Read button / F6. Starts at the page you are on (3.0) - or the first book of your library when none is
        open; choose anything else from the bar at the top. Esc (or Exit) brings everything back."""
        cur = bool(getattr(self, "_reading", False))
        on = (not cur) if on is None else bool(on)
        if on == cur:
            return
        if on:
            if not self.lib.folders:
                self.set_status("Add a folder first - then press Read.")
                return
            self.close_launcher()
            self._sugg_close()
            self._close_float()
            self._read_prev_fit = self.fit_mode
            # 4.4.4: from a gallery - Esc comes back to the gallery (all the pictures), not to one big picture
            self._read_prev_gal = bool(self.fit_mode is None and self.book is not None and self._is_picture_book()
                                       and getattr(self, "page_lefts", None) is not None)
            self._reading = True
            if not self.fullscreen:
                self.rail.pack_forget()
                self.rail_sep.pack_forget()
            self._frame_layout()                         # 4.1: the frame's bands go; thin lines instead
            self._place_side()
            self._read_bar_show()
            if self.folder in self.lib.folders and self.book is not None and self.book.total:
                # 3.0: reading starts where you are (the same page), not at the first book
                self._read_open(self.folder, self.prefix or "", None, keep_page=self.current_page)
            else:
                self._read_open(next(iter(self.lib.folders)), "", None)
            if getattr(self, "_desk_anim_job", None) is None:
                self._desk_anim_job = self.root.after(500, self._desk_anim)
            if self._read_conf().get("page", "same") != "same":       # 4.2: reading's own page colour
                self.cache.clear()
            self._slide_on = not getattr(self, "_gal_no_slide", False)   # 4.2: pictures: a slideshow
            self._gal_no_slide = False                                # (4.4.3: not when a picture was clicked)
            self.root.after(400, self._slide_plan)
        else:
            self._reading = False
            self._slide_on = False
            self._slide_plan()
            if self._read_conf().get("page", "same") != "same":
                self.cache.clear()
            self._read_bar_hide()
            for w in ("_read_pick",):
                d = getattr(self, w, None)
                if d is not None and d.winfo_exists():
                    d.destroy()
            self._frame_layout()
            if not self.fullscreen:
                self.rail.pack(side="left", fill="y", before=self.view)
                self.rail_sep.pack(side="left", fill="y", before=self.view)
            self._place_side()
            prev = getattr(self, "_read_prev_fit", None)
            if getattr(self, "_read_prev_gal", False) and self.book is not None and self._is_picture_book():
                def back_gal():                          # 4.4.4: back to the gallery, at the picture you saw
                    g_ = self.current_page
                    self.fit_mode = None
                    self._apply_zoom(self._gallery_zoom())
                    try:
                        self.goto_page(g_)
                    except Exception:
                        pass
                    self.current_page = g_
                    self.redraw()
                self.root.after(60, back_gal)
            else:
                self.root.after(60, lambda: self.set_fit(prev) if prev else (self._layout(), self.redraw()))
        try:
            self.btn_read.redraw()
        except Exception:
            pass
        self._sides_sig = {"l": None, "r": None}
        self.canvas.focus_set()
        if hasattr(self, "qbar"):
            self._qbar_place()                           # 4.0: no quick bar while reading
        self.root.after(80, self.apply_background)       # 4.1: reading = slow, soft colours of the app
        if on:
            self._read_peek(3.5)

    def _read_open(self, folder, prefix="", rel=None, keep_page=None):
        """Read a book (or one of its documents) from its first page (or the page you are on), fitted to the
        window."""
        def there():
            if not self.book or not self.book.total:
                return
            self.root.update_idletasks()
            g = min(keep_page, self.book.total - 1) if keep_page is not None else 0
            if rel is not None:
                fi = next((i for i, f in enumerate(self.book.files) if f["rel"] == rel), None)
                if fi is not None:
                    g = self.book.files[fi]["first"]
            self.fit_mode = "page"
            self._apply_zoom(self._fit_zoom("page"))
            self.goto_page(g)
            self._map_off = 0
            self._sides_sig = {"l": None, "r": None}
            self._read_bar_draw()
        if folder != self.folder or prefix != (self.prefix or "") or self.book is None:
            self.open_folder(folder, prefix, then=there)
        else:
            there()

    # the bar at the top while reading
    def _read_bar_show(self):
        b = getattr(self, "_read_bar", None)
        if b is None:
            b = tk.Canvas(self.view, height=36, highlightthickness=0, bd=0, cursor="hand2")
            b.bind("<Button-1>", self._read_bar_click)
            b.bind("<Motion>", self._read_bar_motion)
            b.bind("<Leave>", lambda e: (setattr(self, "_read_hov", None), self._read_bar_draw()))
            self._read_bar = b
        self._read_hov = None
        self._read_bar_draw()

    def _read_bar_hide(self):
        b = getattr(self, "_read_bar", None)
        if b is not None:
            b.place_forget()

    def _read_bar_draw(self):
        b = getattr(self, "_read_bar", None)
        if b is None or not getattr(self, "_reading", False):
            return
        if not self.fullscreen:
            self._topband_draw()
        T, A = self.T, self.accent
        doc = ""
        if self.book and self.book.total:
            g = max(0, min(self.current_page, self.book.total - 1))
            fi_ = self.book.pages[g][0]
            doc = os.path.splitext(os.path.basename(self.book.files[fi_]["rel"]))[0]
            k_ = self._part_at(fi_, g - self.book.files[fi_]["first"])          # 1.9.4: the chapter you are in
            if k_ >= 0:
                doc += "  ·  " + (self._sec_vis(fi_) or [[0, ""]])[k_][1]
        book = self.lib.label(self.folder) if self.folder is not None else ""
        f_b, f_n = self._sfont(10, "bold"), self._sfont(10)
        title = self._fit_text(f"{book}  ·  {doc}" if doc else book, f_n, 380)
        # 4.1: minimal - the book and the document, "Choose" and ×; it shows when the mouse comes to the top
        parts = [("t", title, f_n), ("choose", "Choose", f_n), ("exit", "×", f_b)]
        widths = [self._measure(t, f) for _k, t, f in parts]
        W = 18 + 18 + widths[0] + 14 + (widths[1] + 22) + 6 + 30 + 8
        H = 32
        b.configure(width=W, height=H, bg=T["canvas"])
        b.delete("all")
        ph = getattr(self, "_bg_photo", None)
        x0 = (self.canvas.winfo_width() - W) / 2
        if ph is not None:
            b.create_image(-x0, -8, image=ph, anchor="nw")
        round_rect(b, 0, 0, W - 2, H - 2, 15, fill=mix(T["pill"], T["canvas"], 0.25), outline="")
        x = 14
        draw_icon(b, "openbook", x + 8, H / 2 - 1, mix(T["muted"], A, 0.5), s=0.75, w=1.5)
        x += 22
        b.create_text(x, H / 2 - 1, text=title, anchor="w", font=self.F(10), fill=T["muted"])
        x += widths[0] + 14
        self._read_hits = []
        for key, txt, f in (("choose", "Choose", f_n), ("exit", "×", f_b)):
            w_ = (self._measure(txt, f) + 22) if key == "choose" else 26
            hov = getattr(self, "_read_hov", None) == key
            round_rect(b, x, 5, x + w_, H - 7, 11, fill=T["hover"] if hov else mix(T["pill"], T["canvas"], 0.25),
                       outline="")
            b.create_text(x + w_ / 2, H / 2 - 1 - (1 if key == "exit" else 0), text=txt,
                          font=self.F(13 if key == "exit" else 10), fill=A if hov else T["text"])
            self._read_hits.append((x, x + w_, key))
            x += w_ + 6
        if self.fullscreen and (time.time() < getattr(self, "_read_peek_until", 0) or
                                getattr(self, "_read_hov", None)):
            b.place(in_=self.canvas, relx=0.5, y=8, anchor="n")
            b.tk.call("raise", b._w)
        else:
            b.place_forget()                     # 4.2: what you read and Choose are in the top band, always

    def _read_peek(self, secs=2.5):
        """4.1: the reading bar shows for a moment (mouse at the top of the page, a new document), then goes."""
        self._read_peek_until = time.time() + secs
        self._read_bar_draw()
        if getattr(self, "_read_peek_job", None):
            try:
                self.root.after_cancel(self._read_peek_job)
            except Exception:
                pass
        self._read_peek_job = self.root.after(int(secs * 1000) + 60, self._read_bar_draw)

    def _read_bar_at(self, e):
        return next((k for x0, x1, k in getattr(self, "_read_hits", []) if x0 <= e.x <= x1), None)

    def _read_bar_motion(self, e):
        k = self._read_bar_at(e)
        if k != getattr(self, "_read_hov", None):
            self._read_hov = k
            self._read_bar_draw()

    def _read_bar_click(self, e):
        k = self._read_bar_at(e)
        if k == "exit":
            self.reading_mode(False)
        elif k == "choose":
            self._read_choose()

