def _esc(t):
    return html.escape(t or "", quote=False)


def other_to_html(data, path):
    """Text files and office files PyMuPDF can't read by itself (.csv, .rtf, .odt, .ods, .eml …), as a simple page
    BindLens shows, searches and puts in reports like any other document."""
    import io
    ext = os.path.splitext(path)[1].lower()
    title = os.path.basename(path)
    body = []
    if ext in (".csv", ".tsv"):
        import csv
        txt = _decode_text(data[:6_000_000])
        delim = "\t" if ext == ".tsv" else max(",;\t|", key=lambda d: txt[:4000].count(d))
        rows = []
        for k, r in enumerate(csv.reader(io.StringIO(txt), delimiter=delim)):
            if k >= 5000:
                rows.append(["… (only the first 5,000 rows are shown)"])
                break
            rows.append(r[:40])
        body.append("<table>")
        for k, r in enumerate(rows):
            tag = "th" if k == 0 else "td"
            body.append("<tr>" + "".join(f"<{tag}>{_esc(v)}</{tag}>" for v in r) + "</tr>")
        body.append("</table>")
    elif ext == ".json":
        txt = _decode_text(data[:3_000_000])
        try:
            txt = json.dumps(json.loads(txt), indent=2, ensure_ascii=False)
        except Exception:
            pass
        body.append(f"<pre>{_esc(txt)}</pre>")
    elif ext == ".rtf":
        txt = rtf_to_text(_decode_text(data[:20_000_000]))
        body += [f"<p>{_esc(p_)}</p>" for p_ in re.split(r"\n", txt.strip())]
    elif ext in (".odt", ".ods", ".odp"):
        body += odf_html(data)
    elif ext == ".eml":
        import email
        from email import policy
        msg = email.message_from_bytes(data, policy=policy.default)
        title = str(msg.get("subject") or title)
        body.append('<table class="hd">')
        for k in ("From", "To", "Cc", "Date"):
            if msg.get(k):
                body.append(f'<tr><td class="k">{k}</td><td>{_esc(str(msg.get(k)))}</td></tr>')
        body.append("</table>")
        part = msg.get_body(preferencelist=("plain", "html"))
        if part is not None:
            try:
                content = part.get_content()
            except Exception:
                content = ""
            if part.get_content_type() == "text/html":
                content = re.sub(r"(?is)<(script|style|head)[^>]*>.*?</\1>", "", content)
                content = re.sub(r"(?i)<img[^>]*>", "", content)
                body.append(content)
            else:
                body.append(f"<pre class='mail'>{_esc(content.strip())}</pre>")
        att = [a.get_filename() for a in msg.iter_attachments() if a.get_filename()]
        if att:
            body.append("<h2>Attached</h2>" + "".join(f"<p>• {_esc(a)}</p>" for a in att))
    else:
        txt = _decode_text(data[:3_000_000])
        body.append(f"<pre>{_esc(txt)}</pre>")
    return (f"<html><head><meta charset='utf-8'><style>{_OTHER_CSS}</style></head><body>"
            f"<h1>{_esc(title)}</h1>" + "".join(body) + "</body></html>")


def odf_html(data):
    """The text and tables of an OpenDocument file (.odt, .ods, .odp - LibreOffice / OpenOffice)."""
    import io
    import xml.etree.ElementTree as ET
    with zipfile.ZipFile(io.BytesIO(data)) as z:
        root = ET.fromstring(z.read("content.xml"))
    T = "{urn:oasis:names:tc:opendocument:xmlns:text:1.0}"
    TB = "{urn:oasis:names:tc:opendocument:xmlns:table:1.0}"
    DR = "{urn:oasis:names:tc:opendocument:xmlns:drawing:1.0}"
    out = []

    def text_of(el):
        parts = [el.text or ""]
        for ch in el:
            if ch.tag == T + "s":
                parts.append(" " * min(50, int(ch.get(T + "c", "1") or 1)))
            elif ch.tag == T + "tab":
                parts.append("    ")
            elif ch.tag == T + "line-break":
                parts.append("\n")
            elif ch.tag in (T + "note", T + "annotation"):
                pass
            else:
                parts.append(text_of(ch))
            parts.append(ch.tail or "")
        return "".join(parts)

    def table(el):
        rows = []
        for r in el.iter(TB + "table-row"):
            cells = []
            for cl in r:
                if cl.tag not in (TB + "table-cell", TB + "covered-table-cell"):
                    continue
                v = "\n".join(text_of(p_) for p_ in cl if p_.tag in (T + "p", T + "h"))
                cells += [v] * min(int(cl.get(TB + "number-columns-repeated", "1") or 1), 60)
            while cells and not cells[-1].strip():
                cells.pop()
            rep = min(int(r.get(TB + "number-rows-repeated", "1") or 1), 50)
            rows += [cells[:60]] * (rep if cells else 1)
            if len(rows) > 5000:
                break
        while rows and not any(c.strip() for c in rows[-1]):
            rows.pop()
        if not rows:
            return
        if el.get(TB + "name"):
            out.append(f"<h2>{_esc(el.get(TB + 'name'))}</h2>")
        out.append("<table>" + "".join("<tr>" + "".join(f"<td>{_esc(c)}</td>" for c in r) + "</tr>"
                                       for r in rows) + "</table>")

    def walk(el):
        for ch in el:
            if ch.tag == T + "h":
                out.append(f"<h2>{_esc(text_of(ch))}</h2>")
            elif ch.tag == T + "p":
                out.append(f"<p>{_esc(text_of(ch))}</p>")
            elif ch.tag == TB + "table":
                table(ch)
            elif ch.tag == DR + "page":
                out.append(f"<h2>{_esc(ch.get(DR + 'name') or 'Slide')}</h2>")
                walk(ch)
            else:
                walk(ch)
    walk(root)
    return out


def video_card(fitz, path, size=None):
    """4.4: the page that stands for a video in a book - wide (16:9), dark like a cinema, a film strip, a big play
    button, the name, kind, size and date. Play it: click the play button (on the big picture), double-click the
    page, or right-click > Play the video."""
    ext = os.path.splitext(path)[1].lower()
    try:
        st = os.stat(path)
        size = st.st_size if not size else size
        when = time.strftime("%d %B %Y", time.localtime(st.st_mtime)).lstrip("0")
    except Exception:
        when = ""
    size = size or 0
    sz = (f"{size / 1073741824:.1f} GB" if size >= 1073741824 else f"{size / 1048576:.1f} MB" if size >= 1048576
          else f"{max(1, round(size / 1024))} KB")
    W, H = 960, 540
    d = fitz.open()
    pg = d.new_page(width=W, height=H)
    top, bot = hex_to_rgb01("#191536"), hex_to_rgb01("#2C1F66")
    n = 24
    for i in range(n):                                   # a deep violet, darker at the top
        t = i / float(n - 1)
        col = tuple(a + (b - a) * t for a, b in zip(top, bot))
        pg.draw_rect(fitz.Rect(0, H * i / n, W, H * (i + 1) / n + 1), color=None, fill=col)
    for y0 in (14, H - 34):                               # the film's holes
        pg.draw_rect(fitz.Rect(0, y0, W, y0 + 20), color=None, fill=(0.06, 0.05, 0.12))
        x = 12
        while x < W - 12:
            pg.draw_rect(fitz.Rect(x, y0 + 5, x + 16, y0 + 15), color=None, fill=(0.85, 0.83, 0.92), radius=0.3)
            x += 34
    cx, cy, r = W / 2, H / 2 - 44, 62
    pg.draw_circle((cx, cy), r + 10, color=None, fill=(0.36, 0.2, 0.5))
    pg.draw_circle((cx, cy), r, color=None, fill=hex_to_rgb01("#E8467C"))
    sh = pg.new_shape()
    sh.draw_polyline([(cx - 20, cy - 32), (cx + 34, cy), (cx - 20, cy + 32), (cx - 20, cy - 32)])
    sh.finish(color=None, fill=(1, 1, 1))
    sh.commit()
    css = ("*{font-family:sans-serif;text-align:center}.n{font-size:24px;font-weight:bold;color:#FFFFFF}"
           ".m{font-size:15px;color:#CFC8F2}.t{font-size:13px;color:#FFE6A0}")
    pg.insert_htmlbox(fitz.Rect(60, cy + r + 26, W - 60, cy + r + 66),
                      f"<div class='n'>{_esc(os.path.basename(path))}</div>", css=css)
    pg.insert_htmlbox(fitz.Rect(60, cy + r + 68, W - 60, cy + r + 92),
                      f"<div class='m'>{_esc(ext.upper().lstrip('.'))} video &middot; {sz}"
                      f"{(' &middot; ' + _esc(when)) if when else ''}</div>", css=css)
    pg.insert_htmlbox(fitz.Rect(60, cy + r + 98, W - 60, cy + r + 122),
                      "<div class='t'>Double-click to play it</div>", css=css)
    pix = pg.get_pixmap(dpi=96)
    d.close()
    out = fitz.open()
    p2 = out.new_page(width=W, height=H)
    p2.insert_image(p2.rect, stream=pix.tobytes("png"))
    data = out.tobytes()
    out.close()
    return data


def outside_card(fitz, path, size=None):
    """A page that stands for a file BindLens can't look inside (old Word/Excel/PowerPoint, Outlook…): its kind,
    name, size and date - double-click it to open the file in its own program. (A picture: no text to search.)"""
    ext = os.path.splitext(path)[1].lower()
    if ext in VIDEO_EXTS:
        return video_card(fitz, path, size)
    kind, prog, col, letter = OUTSIDE_KIND.get(ext, ("Document", "its program", "#5B5F73", "?"))
    try:
        st = os.stat(path)
        size = st.st_size if size is None else size
        when = time.strftime("%d %B %Y, %H:%M", time.localtime(st.st_mtime)).lstrip("0")
