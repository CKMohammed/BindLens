    # =================================================================================================================
    # 4.0: the quick bar on the right (+ its slide-out panels), the frame round the window, edit the PDF's own text,
    # scan and add, read aloud, study, what's new, PIN, update from a zip
    # =================================================================================================================
    def _qb_conf(self):
        c = self.lib.settings.setdefault("qbar", {})
        c.setdefault("on", True)
        items = [k for k in c.get("items", QB_DEFAULT) if k in QB_ITEMS]
        c["items"] = items
        return c

    def _qbar_build(self):
        """The quick bar: a very slim column of icons on the right edge of the window."""
        self.qbar = tk.Canvas(self.root, width=QB_W, highlightthickness=0, bd=0, cursor="hand2")
        self.qbar_sep = tk.Frame(self.root, width=1)
        q = self.qbar
        q.bind("<Configure>", lambda e: self._qbar_draw())
        q.bind("<Motion>", self._qbar_motion)
        q.bind("<Leave>", lambda e: (self.tooltip.cancel(), setattr(self, "_qb_hov", None), self._qbar_draw()))
        q.bind("<ButtonPress-1>", self._qbar_press)
        q.bind("<B1-Motion>", self._qbar_drag)
        q.bind("<ButtonRelease-1>", self._qbar_release)
        q.bind("<Button-3>", self._qbar_menu)
        if sys.platform == "darwin":
            q.bind("<Button-2>", self._qbar_menu)
        self._qb_hov = None
        self._qb_panel = None

    def _qbar_place(self):
        """Shown unless you hid it, you are reading, or the window is narrow; it covers nothing."""
        if hasattr(self, "qbar"):
            self._frame_layout()

    def _qbar_rows(self):
        items = self._qb_conf()["items"]
        out, y = [], 12
        for k in items:
            out.append((k, y, y + 36))
            y += 40
        return out

    def _qbar_draw(self):
        q = getattr(self, "qbar", None)
        if q is None:
            return
        T, A = self.T, self.accent
        q.delete("all")
        q.configure(bg=T["bg"])
        try:
            self.qbar_sep.configure(bg=T["border"])
        except Exception:
            pass
        band = self._band_bg(q, "qb")                     # 4.1: the frame's right side
        ink, _sub = self._band_ink()
        h = max(1, q.winfo_height())
        open_k = (self._qb_panel or {}).get("k")
        drag = getattr(self, "_qb_drag", None)
        for k, y0, y1 in self._qbar_rows():
            icon = QB_ITEMS[k][0]
            on = k == open_k or (k == "edittext" and self.tool == "edittext") or \
                (k == "fast" and self._fast()) or (k == "read" and getattr(self, "_tts", None) is not None)
            if drag and drag.get("moved") and drag.get("k") == k:
                y0 = y1 = None
            if y0 is None:
                continue
            if band:                                        # on the frame's colours
                if on:
                    round_rect(q, 5, y0, QB_W - 5, y1, 10, fill=ink, outline="")
                    col = mix(A, "#000000", 0.25) if ink == "#FFFFFF" else "#FFFFFF"
                else:
                    if self._qb_hov == k:
                        round_rect(q, 5, y0, QB_W - 5, y1, 10, fill="", outline=ink, width=1.2)
                    col = ink
            else:
                if on:
                    round_rect(q, 5, y0, QB_W - 5, y1, 10, fill=mix(T["bg"], A, 0.16), outline="")
                    q.create_rectangle(QB_W - 3, y0 + 9, QB_W - 1, y1 - 9, fill=A, outline="")
                elif self._qb_hov == k:
                    round_rect(q, 5, y0, QB_W - 5, y1, 10, fill=T["hover"], outline="")
                col = A if on else (T["text"] if self._qb_hov == k else T["icon"])
            draw_icon(q, icon, QB_W / 2, (y0 + y1) / 2, col, s=0.86)
            if k == "study":
                due = self._cards_due_n()
                if due:
                    q.create_oval(QB_W - 16, y0 + 3, QB_W - 6, y0 + 13, fill="#E8772E",
                                  outline=ink if band else T["bg"], width=1.5)
        if drag and drag.get("moved"):
            yy = drag.get("y", 0)
            round_rect(q, 4, yy - 18, QB_W - 4, yy + 18, 10, fill=mix(T["bg"], A, 0.22), outline=A)
            draw_icon(q, QB_ITEMS[drag["k"]][0], QB_W / 2, yy, A, s=0.86)
        # bottom: + (choose what the bar shows)
        yb = h - 30
        hov = self._qb_hov == "+"
        if hov:
            if band:
                round_rect(q, 7, yb - 15, QB_W - 7, yb + 15, 9, fill="", outline=ink, width=1.2)
            else:
                round_rect(q, 7, yb - 15, QB_W - 7, yb + 15, 9, fill=T["hover"], outline="")
        draw_icon(q, "plus", QB_W / 2, yb, ink if band else (T["text"] if hov else T["muted"]), s=0.62)

    def _qbar_hit(self, y):
        h = self.qbar.winfo_height()
        if h - 46 <= y <= h - 14:
            return "+"
        for k, y0, y1 in self._qbar_rows():
            if y0 <= y <= y1:
                return k
        return None

    def _qbar_motion(self, e):
        k = self._qbar_hit(e.y)
        if k != self._qb_hov:
            self._qb_hov = k
            self._qbar_draw()
            self.tooltip.cancel()
            if k == "+":
                self.tooltip.schedule(self.qbar, "Choose what this bar shows")
            elif k:
                nm, sc = QB_ITEMS[k][1], QB_ITEMS[k][2]
                self.tooltip.schedule(self.qbar, nm + (f"  ({sc})" if sc else ""))

    def _qbar_press(self, e):
        self._qb_drag = {"k": self._qbar_hit(e.y), "y0": e.y, "y": e.y, "moved": False}

    def _qbar_drag(self, e):
        d = getattr(self, "_qb_drag", None)
        if not d or d["k"] in (None, "+"):
            return
        if abs(e.y - d["y0"]) > 8:
            d["moved"] = True
        d["y"] = e.y
        if d["moved"]:
            self._qbar_draw()

    def _qbar_release(self, e):
        d, self._qb_drag = getattr(self, "_qb_drag", None), None
        if not d:
            return
        if d.get("moved") and d["k"] not in (None, "+"):            # dragged: a new place in the bar
            items = self._qb_conf()["items"]
            items.remove(d["k"])
            pos = max(0, min(len(items), int((e.y - 12 + 20) // 40)))
            items.insert(pos, d["k"])
            self.lib.save_meta()
            self._qbar_draw()
            return
        k = self._qbar_hit(e.y)
        if k == "+":
            self._qbar_menu(e)
        elif k:
            self.quick_action(k)

    def _qbar_menu(self, e):
        c = self._qb_conf()
        m = self._menu()
        k = self._qbar_hit(e.y) if e.widget is self.qbar else None
        if k and k != "+":
            items = c["items"]
            i = items.index(k)
            m.add_command(label=f"Remove “{QB_ITEMS[k][1].split(' - ')[0]}” from the bar",
                          command=lambda: (items.remove(k), self.lib.save_meta(), self._qbar_draw()))
            if i > 0:
                m.add_command(label="Move up", command=lambda: (items.insert(i - 1, items.pop(i)),
                                                                self.lib.save_meta(), self._qbar_draw()))
            if i < len(items) - 1:
                m.add_command(label="Move down", command=lambda: (items.insert(i + 1, items.pop(i)),
                                                                  self.lib.save_meta(), self._qbar_draw()))
            m.add_separator()
        sub = tk.Menu(m, tearoff=0)
        for key, (_ic, nm, sc, _kind) in QB_ITEMS.items():
            var = tk.BooleanVar(value=key in c["items"])

            def tog(key=key):
                if key in c["items"]:
                    c["items"].remove(key)
                else:
                    c["items"].append(key)
                self.lib.save_meta()
                self._qbar_draw()
            sub.add_checkbutton(label=nm + (f"   {sc}" if sc else ""), variable=var, command=tog)
        m.add_cascade(label="Show in the bar", menu=sub)
        m.add_command(label="Back to the first choice", command=lambda: (c.__setitem__("items", list(QB_DEFAULT)),
                                                                        self.lib.save_meta(), self._qbar_draw()))
        m.add_separator()
        m.add_command(label="Hide the quick bar  (View > Quick bar brings it back)",
                      command=lambda: self.toggle_qbar(False))
        self._popup(m, e)

    def toggle_qbar(self, on=None):
        c = self._qb_conf()
        c["on"] = (not c.get("on", True)) if on is None else bool(on)
        self.lib.save_meta()
        self._qbar_place()

    def quick_action(self, k):
        """What each icon of the quick bar does."""
        kind = QB_ITEMS.get(k, ("", "", "", "act"))[3]
        if kind == "panel":
            if self._qb_panel and self._qb_panel.get("k") == k:
                self._qp_close()
            else:
                self._qp_open(k)
            return
        if k == "edittext":
            self.set_tool("select" if self.tool == "edittext" else "edittext")
        elif k == "scan":
            self.scan_dialog()
        elif k == "reminders":
            self.reminders_dialog()
        elif k == "pages":
            self.pages_overview()
        elif k == "deleted":
            self.deleted_pages_dialog()
        elif k == "fast":
            self.set_fast("off" if self._fast() else "on")
        elif k == "doing":
            self.doing_dialog()
        self._qbar_draw()

    # ---- the slide-out panel ---------------------------------------------------------------------------------------
    QP_W = 330

    def _qp_open(self, k):
        if self._qb_panel:
            self._qp_close(anim=False)
        T = self.T
        fr = tk.Frame(self.view, bg=T["panel"], highlightthickness=1, highlightbackground=T["border"])
        head = tk.Frame(fr, bg=T["panel"])
        head.pack(fill="x", padx=16, pady=(14, 4))
        title = {"study": "Study", "read": "Read aloud", "marks": "Highlights and notes", "calendar": "Calendar",
                 "frame": "The frame"}.get(k, QB_ITEMS[k][1])
        tk.Label(head, text=title, font=self.F(13, "bold"), bg=T["panel"], fg=T["text"]).pack(side="left")
        IconButton(head, self, "close", self._qp_close, "Close  (Esc)", size=28, bg_key="panel").pack(side="right")
        body = tk.Frame(fr, bg=T["panel"])
        body.pack(fill="both", expand=True, padx=16, pady=(4, 12))
        self._qb_panel = {"k": k, "fr": fr, "body": body, "x": self.QP_W}
        try:
            getattr(self, "_qp_fill_" + k)(body)
        except Exception as ex:
            _log(f"panel {k}: {ex}")
            tk.Label(body, text=f"Could not show it: {ex}", bg=T["panel"], fg=T["muted"], wraplength=280,
                     justify="left").pack(anchor="w")
        fr.place(in_=self.view, relx=1.0, x=self.QP_W, y=0, relheight=1.0, width=self.QP_W, anchor="ne")
        fr.lift()
        self._qp_slide(0)
        self._qbar_draw()

    def _qp_slide(self, target):
        p = self._qb_panel
        if not p:
            return
        x = p["x"]
        if abs(x - target) < 2:
            p["x"] = target
            try:
                p["fr"].place_configure(x=target)
            except Exception:
                pass
            if target >= self.QP_W:
                try:
                    p["fr"].destroy()
                except Exception:
                    pass
                self._qb_panel = None
                self._qbar_draw()
            return
        p["x"] = x + (target - x) * 0.42
        try:
            p["fr"].place_configure(x=int(p["x"]))
        except Exception:
            return
        self.root.after(14, lambda: self._qp_slide(target))

    def _qp_close(self, anim=True):
        p = self._qb_panel
        if not p:
            return
        if p.get("k") == "read" and getattr(self, "_tts", None) is None:
            pass
        if anim and not self._fast():
            self._qp_slide(self.QP_W)
        else:
            try:
                p["fr"].destroy()
            except Exception:
                pass
            self._qb_panel = None
            self._qbar_draw()

    def _qp_refresh(self):
        p = self._qb_panel
        if not p:
            return
        for w_ in p["body"].winfo_children():
            w_.destroy()
        try:
            getattr(self, "_qp_fill_" + p["k"])(p["body"])
        except Exception as ex:
            _log(f"panel {p['k']}: {ex}")

    def _qp_section(self, body, text):
        tk.Label(body, text=text.upper(), font=self.F(8, "bold"), bg=self.T["panel"], fg=self.T["muted"]).pack(
            anchor="w", pady=(12, 4))

    def _qp_chips(self, body, opts, cur, cmd):
        """A row of small choices (one is on)."""
        T, A = self.T, self.accent
        row = tk.Frame(body, bg=T["panel"])
        row.pack(fill="x", pady=(0, 2))
        for val, lab in opts:
            on = val == cur
            b = tk.Label(row, text=lab, font=self.F(9, "bold" if on else "normal"), padx=9, pady=4, cursor="hand2",
                         bg=mix(T["panel"], A, 0.16) if on else T["chip"], fg=A if on else T["text"])
            b.pack(side="left", padx=(0, 5), pady=2)
            b.bind("<Button-1>", lambda e, v=val: cmd(v))
        return row

    def _qp_list(self, body, items, on_click, empty="Nothing here yet."):
        """A slim list: [(colour, text, right text)] - click one."""
        T = self.T
        box = tk.Frame(body, bg=T["panel"])
        box.pack(fill="both", expand=True, pady=(4, 0))
        cv = tk.Canvas(box, bg=T["panel"], highlightthickness=0, bd=0, cursor="hand2")
        bar = SlimBar(box, self, cv, width=10)
        bar.pack(side="right", fill="y")
        cv.pack(side="left", fill="both", expand=True)
        cv.configure(yscrollcommand=bar.set)
        st = {"rows": []}

        def draw(_e=None):
            cv.delete("all")
            w = max(100, cv.winfo_width())
            if not items:
                cv.create_text(4, 10, text=empty, anchor="nw", font=self.F(9), fill=T["muted"], width=w - 10)
                return
            y = 2
            st["rows"] = []
            for i, (col, txt, right) in enumerate(items):
                tid = cv.create_text(20, y + 6, text=txt, anchor="nw", font=self.F(9), fill=T["text"], width=w - 64)
                bb = cv.bbox(tid)
                h = max(26, (bb[3] - bb[1]) + 12 if bb else 26)
                cv.create_oval(5, y + 9, 13, y + 17, fill=col or self.accent, outline="")
                if right:
                    cv.create_text(w - 6, y + 6, text=right, anchor="ne", font=self.F(8), fill=T["muted"])
                cv.create_line(20, y + h - 1, w - 4, y + h - 1, fill=mix(T["panel"], T["border"], 0.6))
                st["rows"].append((y, y + h, i))
                y += h
            cv.configure(scrollregion=(0, 0, w, y + 4))

        def click(e):
            yy = cv.canvasy(e.y)
            for y0, y1, i in st["rows"]:
                if y0 <= yy <= y1:
                    on_click(i)
                    return
        cv.bind("<Configure>", draw)
        cv.bind("<Button-1>", click)
        cv.bind("<MouseWheel>", lambda e: cv.yview_scroll(-1 if e.delta > 0 else 1, "units"))
        cv.bind("<Button-4>", lambda e: cv.yview_scroll(-1, "units"))
        cv.bind("<Button-5>", lambda e: cv.yview_scroll(1, "units"))
        return cv

    def _go_mark(self, m):
        try:
            self.sel_annot = (m["g"], m["xref"])
            self.flash = (m["g"], m["bbox"])
            self._show_spot(m["g"], m["bbox"])
            self.root.after(1200, self._end_flash)
        except Exception:
            pass

    def _marks_here(self, scope="file"):
        """The marks of the document you are on (or of the whole book)."""
        if not self.book or not self.book.total:
            return []
        if scope == "book":
            return list(self.marks)
        fi = self.book.pages[self.current_page][0]
        return [m for m in self.marks if self.book.pages[m["g"]][0] == fi]

    def _qp_fill_marks(self, body):
        T = self.T
        scope = getattr(self, "_qp_scope", "file")
        self._qp_chips(body, [("file", "This document"), ("book", "This book")], scope,
                       lambda v: (setattr(self, "_qp_scope", v), self._qp_refresh()))
        ms = sorted(self._marks_here(scope), key=lambda m: (m["g"], m["bbox"][1]))
        items = []
        for m in ms:
            body_t = m["text"] if m["kind"] in MARKUP else (m.get("note") or "")
            label = KIND_LABEL.get(m["kind"], m["kind"])
            t = (body_t or label).replace("\n", " ").strip()
            if m["kind"] in MARKUP and m.get("note"):
                t += f"  — {m['note']}"
            items.append((m.get("color") or self.accent, t[:220], f"p. {m['g'] + 1}"))
        tk.Label(body, text=f"{len(ms)} mark{'s' if len(ms) != 1 else ''} - click one to go there",
                 font=self.F(9), bg=T["panel"], fg=T["muted"]).pack(anchor="w", pady=(6, 0))
        self._qp_list(body, items, lambda i: self._go_mark(ms[i]),
                      empty="No highlights or notes here yet. Select text and pick a colour to highlight it.")

    def _qp_fill_calendar(self, body):
        T = self.T
        cv = tk.Canvas(body, bg=T["panel"], highlightthickness=0, bd=0, cursor="hand2", height=420)
        cv.pack(fill="both", expand=True)

        def draw(_e=None):
            cv.delete("all")
            w = max(200, cv.winfo_width())
            try:
                keep = list(getattr(self, "_cal_hits", []))
                self._cal_draw(cv, w, 0, T["panel"])
                self._qp_cal_hits = list(self._cal_hits)
                self._cal_hits = keep
            except Exception as ex:
                cv.create_text(4, 10, text=f"The calendar could not be drawn: {ex}", anchor="nw", fill=T["muted"])

        def click(e):
            keep = list(getattr(self, "_cal_hits", []))
            self._cal_hits = getattr(self, "_qp_cal_hits", [])
            try:
                self._cal_click(e)
            finally:
                self._cal_hits = keep
            self.root.after(120, draw)
        cv.bind("<Configure>", draw)
        cv.bind("<Button-1>", click)
        lk = tk.Label(body, text="Calendar settings…", font=self.F(9), bg=T["panel"], fg=self.accent, cursor="hand2")
        lk.pack(anchor="w", pady=(6, 0))
        lk.bind("<Button-1>", lambda e: self.calendar_settings())

    # ---- the frame round the window --------------------------------------------------------------------------------
    def _frame_conf(self):
        c = self.lib.settings.setdefault("frame", {})
        c.setdefault("mode", "moving")          # moving | still | off
        c.setdefault("palette", "accent")
        c.setdefault("speed", "normal")
        c.setdefault("width", 3)
        c.setdefault("glow", True)
        c.setdefault("busy", True)              # glows while BindLens works
        c.setdefault("pulse", True)             # pulses when something new arrives
        if c.get("v") != 41:                    # 4.1: a real frame - thicker, with a picture frame's edges
            c["v"] = 41
            c["width"] = max(6, int(c.get("width", 3)))
            c.setdefault("look", "bevel")
        c.setdefault("look", "bevel")
        c.setdefault("own_bar", True)           # 4.3: Windows - BindLens's own title bar (the frame from the very top)
        return c

    TB_H, ST_H, SIDE_W = 28, 26, 10

    def _frame_build(self):
        """4.1: the frame is the window's own edges - the menu row at the top (File … Help, and the document), the
        status row at the bottom, the tools on the right and a slim side on the left - all in the slowly flowing
        colours. Each is a picture made once (a little longer than its side) and only moved. In reading mode and
        full screen (no menu, no status) it is four thin lines instead."""
        if getattr(self, "_fr", None) is None:
            self._fr = {}
            for side in ("t", "r", "b", "l"):
                c = tk.Canvas(self.root, highlightthickness=0, bd=0)
                self._fr[side] = {"c": c, "item": None}
            self._fr_imgs = {}
            self._fr_job = None
            self._fr_pulse_until = 0.0
        self._frame_layout()

    def _frame_apply(self):
        self._frame_layout()

    def _side_w(self):
        """The slim sides of the frame: as wide as you chose (Personalise > The frame > Width) - 4.2: always a
        little wider than the moulding, so the left side looks like the frame, not a line."""
        return max(self._mould_w() + 6, min(20, int(self._frame_conf().get("width", 6)) + 8))

    def _bands_on(self):
        return self._frame_conf()["mode"] != "off"

    def _bands_hidden(self):
        return bool(self.fullscreen or getattr(self, "_reading", False))

    def _qbar_wanted(self):
        c = self._qb_conf()
        try:
            wide = self.root.winfo_width() >= 980 or self.root.winfo_width() <= 1
        except Exception:
            wide = True
        return bool(c.get("on", True) and wide and not getattr(self, "_reading", False))

    def _cap_on(self):
        """4.2: our own title bar is in use (Windows) - the top band carries minimise / maximise / close."""
        cap = getattr(self, "_cap", None)
        return bool(cap is not None and cap.ok and not self.fullscreen)

    def _ownbar_flag(self):
        return os.path.join(self.lib.meta_dir, "ownbar-starting")

    def _ownbar_wanted(self):
        """4.3: our own title bar on Windows - unless switched off (Personalise > The frame) or the last start
        with it did not get going (then the normal Windows bar comes back by itself, and says so).
        4.4.3: decided once per start (it is asked twice while the window is built)."""
        if "_ownbar_once" in self.__dict__:
            return self._ownbar_once
        self._ownbar_once = ok = self._ownbar_decide()
        return ok

    def _ownbar_decide(self):
        if os.name != "nt":
            return False
        conf = self._frame_conf()
        if not conf.get("own_bar", True) and conf.get("own_bar_auto_off") and \
                conf.get("own_bar_auto_off") != APP_VERSION:
            conf["own_bar"] = True                          # 4.4.3: switched off by itself before - a new version
            conf.pop("own_bar_auto_off", None)              # tries again
            self.lib.save_meta()
        if not conf.get("own_bar", True):
            self._ownbar_why = "switched off in Personalise > The frame" if not conf.get("own_bar_auto_off") else \
                "switched off by itself after starts that did not finish"
            return False
        try:
            fl_ = self._ownbar_flag()
            if os.path.exists(fl_):
                try:
                    n_ = int(open(fl_, encoding="utf-8").read().split("|")[-1] or 1)
                except Exception:
                    n_ = 1
                if n_ < 2:                                  # 4.4.3: one start that did not finish - try again
                    with open(fl_, "w", encoding="utf-8") as fh:
                        fh.write(time.strftime("%Y-%m-%d %H:%M:%S") + "|" + str(n_ + 1))
                    _log("own title bar: the last start did not finish - trying it once more")
                    return True
                os.remove(fl_)
                conf["own_bar"] = False
                conf["own_bar_auto_off"] = APP_VERSION
                self._ownbar_why = "switched off by itself after starts that did not finish"
                self.lib.save_meta()
                _log("own title bar: two starts with it did not finish - normal Windows title bar")
                self.root.after(4000, lambda: self._toast(
                    "BindLens went back to the normal Windows title bar after a problem. Personalise > The frame "
                    "turns its own bar on again."))
                return False
        except Exception:
            pass
        return True

    def _ownbar_h(self):
        try:
            s_ = max(1.0, min(2.0, self.root.winfo_fpixels("1i") / 96.0))
        except Exception:
            s_ = 1.0
        return int(round(34 * s_))

    def _caption_install(self):
        """4.3: the window's own title bar (OwnBar). The top band then has minimise / maximise / close, the empty
        band moves the window and the frame's edges resize it."""
        flag = self._ownbar_flag()
        try:
            n_ = 1
            if os.path.exists(flag):
                try:
                    n_ = int(open(flag, encoding="utf-8").read().split("|")[-1] or 1)
                except Exception:
                    n_ = 1
            with open(flag, "w", encoding="utf-8") as fh:
                fh.write(time.strftime("%Y-%m-%d %H:%M:%S") + "|" + str(n_))
        except Exception:
            pass
        try:
            self._cap = OwnBar(self.root, 820, 520)
        except Exception as ex:
            _log(f"own title bar: {ex}")
            self._cap = None
        if not self._cap_on():
            self._cap = None
            self._ownbar_why = "Windows did not let BindLens draw its own bar (see BindLens-error.log)"
            self.TB_H = 28                                  # the normal Windows title bar stays
        else:
            self.WIN_BTN_W = int(round(46 * self._cap.s))
            self._grip_install()
        try:
            self.topband.configure(height=self.TB_H)
        except Exception:
            pass
        self._frame_layout()

        def started():
            try:
                os.remove(flag)
            except Exception:
                pass
        self.root.after(9000, started)
        if getattr(self, "_lock", None) is not None:        # 4.4.1: the PIN screen goes under the own top band
            self.root.after(80, lambda: self._lock_layout() if getattr(self, "_lock", None) is not None else None)
            self.root.after(700, lambda: self._lock_layout() if getattr(self, "_lock", None) is not None else None)

    def ownbar_set(self, on):
        """Personalise > The frame: BindLens's own title bar on / off, at once."""
        self._frame_conf()["own_bar"] = bool(on)
        self._frame_conf().pop("own_bar_auto_off", None)    # 4.4.3: your choice from now on
        self.lib.save_meta()
        if os.name != "nt":
            return
        cap = getattr(self, "_cap", None)
        if on and cap is None:
            self.TB_H = self._ownbar_h()
            self._caption_install()
        elif not on and cap is not None:
            cap.give_back()
            self._cap = None
            self.TB_H = 28
            self.topband.configure(height=self.TB_H)
            self._frame_layout()
            self.root.after(200, self._frame_titlebar)

    def _grip_install(self):
        """The frame's outer edge resizes the window, the empty top band moves it (own title bar only). A bind tag
        put first on the bands, so a press on the edge never reaches the band's own buttons."""
        ws = [getattr(self, n, None) for n in ("topband", "status", "lband", "rband", "qbar")]
        ws += [d["c"] for d in (getattr(self, "_fr", None) or {}).values()]
        for w_ in ws:
            if w_ is not None and "BLGrip" not in w_.bindtags():
                w_.bindtags(("BLGrip",) + tuple(w_.bindtags()))
        r = self.root
        r.bind_class("BLGrip", "<Motion>", self._grip_motion)
        r.bind_class("BLGrip", "<ButtonPress-1>", self._grip_press)
        r.bind_class("BLGrip", "<B1-Motion>", self._grip_drag)
        r.bind_class("BLGrip", "<ButtonRelease-1>", self._grip_release)
        r.bind_class("BLGrip", "<Double-Button-1>", self._grip_double)
        r.bind("<Alt-F4>", lambda e: (None if getattr(self, "_closing", False) else self.on_close(), "break")[1])

    def _grip_motion(self, e):
        cap = getattr(self, "_cap", None)
        if not self._cap_on() or cap.drag_:
            return "break" if cap is not None and cap.drag_ else None
        z = cap.zone(e)
        w_ = e.widget
        saved = self.__dict__.setdefault("_grip_cur", {})
        try:
            if z:
                if str(w_) not in saved:
                    saved[str(w_)] = w_.cget("cursor")
                w_.configure(cursor=cap.CUR[z])
                return "break"
            if str(w_) in saved:
                w_.configure(cursor=saved.pop(str(w_)))
        except Exception:
            pass
        return None

    def _grip_press(self, e):
        if not self._cap_on():
            return None
        cap = self._cap
        z = cap.zone(e)
        if z:
            cap.start(e, "resize", z)
            return "break"
        if e.widget is self.topband and not self._tb_at(e):
            cap.start(e, "move")
            return "break"
        return None

    def _grip_drag(self, e):
        cap = getattr(self, "_cap", None)
        if cap is not None and cap.drag_:
            cap.motion(e)
            return "break"
        return None

    def _grip_release(self, e):
        cap = getattr(self, "_cap", None)
        if cap is not None and cap.drag_:
            cap.release(e)
            self.root.after(80, self._topband_draw)
            return "break"
        return None

    def _grip_double(self, e):
        if self._cap_on() and e.widget is self.topband and not self._tb_at(e) and not self._cap.zone(e):
            self._win_max()
            return "break"
        return None

    def _win_min(self):
        try:
            if self._cap_on():
                self._cap.minimise()
            else:
                self.root.iconify()
        except Exception:
            pass

    def _win_max(self):
        try:
            if self._cap_on():
                self._cap.toggle_max()
            else:
                self.root.state("normal" if self.root.state() == "zoomed" else "zoomed")
        except Exception:
            pass
        self.root.after(120, self._topband_draw)

    def _frame_layout(self):
        """Where everything sits round the pages: the frame's bands outside, the app's own bar and pages inside.
        4.2: the band at the top is always there (also while reading - with what you read and Choose), except in
        full screen; on Windows it is the window's own title bar."""
        if not hasattr(self, "topband"):
            return
        on = self._bands_on()
        reading, full = bool(getattr(self, "_reading", False)), bool(self.fullscreen)
        for w_ in (self.topband, self.status, self.qbar, self.qbar_sep, self.lband, self.rband, self.bar,
                   self.paned):
            w_.pack_forget()
        if not full:
            self.topband.configure(height=self.TB_H)
            self.topband.pack(side="top", fill="x")
        if not full and not reading:
            self.status.pack(side="bottom", fill="x")
            if self._qbar_wanted():
                self.qbar.pack(side="right", fill="y")
                if not on:
                    self.qbar_sep.pack(side="right", fill="y")
            elif on:
                self.rband.pack(side="right", fill="y")
            if on:
                self.lband.configure(width=self._side_w())
                self.rband.configure(width=self._side_w())
                self.lband.pack(side="left", fill="y")
            self.bar.pack(side="top", fill="x")
        if not self._qbar_wanted() and getattr(self, "_qb_panel", None):
            self._qp_close(anim=False)
        self.paned.pack(fill="both", expand=True)
        self._band_cache = {}
        self._band_items = {}
        # the thin lines: where the bands are not (reading: the sides and the bottom; full screen: all round)
        conf = self._frame_conf()
        wd = max(2, min(10, int(conf.get("width", 6))))
        y0 = 0 if full else self.TB_H
        self._fr_y0 = y0
        for side, d in (getattr(self, "_fr", None) or {}).items():
            c = d["c"]
            c.place_forget()
            c.delete("all")
            d["item"] = None
            if not on or not (full or reading) or (side == "t" and not full) or \
                    (reading and not full and not self._read_conf().get("frame", True)):
                continue
            c.configure(bg=self.T["bg"])
            if side == "t":
                c.place(x=0, y=0, relwidth=1.0, height=wd)
            elif side == "b":
                c.place(x=0, rely=1.0, y=-wd, relwidth=1.0, height=wd)
            elif side == "l":
                c.place(x=0, y=y0, width=wd, relheight=1.0, height=-y0)
            else:
                c.place(relx=1.0, x=-wd, y=y0, width=wd, relheight=1.0, height=-y0)
            tk.Misc.tkraise(c)
        self._fr_imgs = {}
        self._topband_draw()
        self._status_draw()
        self._sideband_draw()
        self._qbar_draw()
        if on and getattr(self, "_fr", None) is not None:
            self._frame_draw(force=True)
            if self._fr_job is None:
                self._fr_job = self.root.after(80, self._frame_tick)
        self._frame_titlebar()
        try:
            self._stage_sync()
        except Exception:
            pass

    # ---- the bands: their flowing background, and the ink written on them
    def _band_ink(self):
        """(writing, quieter writing) colours that read well on the frame's colours."""
        T = self.T
        if not self._bands_on():
            return T["text"], T["muted"]
        cols = self._frame_cols()
        lum = sum(_lum(c) for c in cols) / max(1, len(cols))
        if self._frame_level() == 0:
            lum = lum * 0.55 + _lum(T["bg"]) * 0.45
        if lum > 0.34:
            return "#15151B", "#2B2B35"
        return "#FFFFFF", "#ECECF3"

    BAND_SPEC = {"tb": (True, False, True), "st": (True, True, False), "qb": (False, False, False),
                 "rb": (False, False, False), "lb": (False, True, True)}   # horizontal, reverse, outer edge first

    def _ring_P(self):
        """4.2: one round of colours fits the window's edge a whole number of times - so where the ring closes (the
        top-left corner) there is no jump."""
        try:
            W, H = max(200, self.root.winfo_width()), max(200, self.root.winfo_height())
        except Exception:
            W, H = 1280, 800
        per = 2 * (W + H)
        k = max(1, int(round(per / 900.0)))
        return max(300, int(round(per / float(k))))

    def _ring_cyc(self):
        conf = self._frame_conf()
        P = self._ring_P()
        cols = self._frame_cols()
        ck = (conf.get("palette"), tuple(cols), self.accent, P)
        cyc = getattr(self, "_fr_cyc_c", None)
        if cyc is None or cyc[0] != ck:
            cyc = self._fr_cyc_c = (ck, frame_cycle(cols, P))
        self._fr_cyc = cyc[1]
        self._fr_P = P
        return cyc[1]

    def _ring_sides(self):
        """(left, right) widths of the frame where it meets the top and bottom bands: the left side and the tools
        (or the thin right side) - or the thin lines while reading."""
        reading = getattr(self, "_reading", False)
        if reading or self.fullscreen:
            wd = max(2, min(10, int(self._frame_conf().get("width", 6))))
            on = self._read_conf().get("frame", True) if reading else True
            return (wd, wd) if on else (0, 0)
        lw = self.lband.winfo_width() if self.lband.winfo_ismapped() else 0
        qw = (self.qbar.winfo_width() if self.qbar.winfo_ismapped() else
              (self.rband.winfo_width() if self.rband.winfo_ismapped() else 0))
        return lw, qw

    def _cyc_bytes(self, level):
        """The ring's colours as ready pixels, at this level (calm, normal, bright) - for the corners."""
        cyc = self._ring_cyc()
        key = (level, id(cyc), self.T["bg"])
        got = getattr(self, "_cyc_b", None)
        if got and got[0] == key:
            return got[1]
        bg = self.T["bg"]
        br, bgg, bb = [int(bg[i:i + 2], 16) for i in (1, 3, 5)]
        out = []
        for r, g_, b_ in cyc:
            if level == 0:
                r, g_, b_ = int(r + (br - r) * 0.45), int(g_ + (bgg - g_) * 0.45), int(b_ + (bb - b_) * 0.45)
            elif level == 2:
                r, g_, b_ = int(r + (255 - r) * 0.2), int(g_ + (255 - g_) * 0.2), int(b_ + (255 - b_) * 0.2)
            out.append(bytes((r, g_, b_)))
        self._cyc_b = (key, out)
        return out

    def _ring_corners(self, cv, side, level):
        """4.2: the corners of the ring: the colours turn the corner (they sweep round it) instead of meeting
        in a straight cut - so the frame reads as ONE ring. Small pictures, remade as the colours flow."""
        import math
        W, H = max(1, self.root.winfo_width()), max(1, self.root.winfo_height())
        per = 2 * (W + H)
        lw, qw = self._ring_sides()
        t, b_h = self.TB_H, self.ST_H
        items = self.__dict__.setdefault("_corner_items", {})
        for k in [k for k in items if k[0] == side]:
            items.pop(k, None)
        corners = []
        if side == "tb":
            if qw:      # top-right: from the top band (s = x) round to the right side (s = W + y)
                corners.append(("tr", W - qw, 0, qw, t, (W - qw, t), lambda vx, vy: (-vy, vx), W - qw, qw + t))
            if lw:      # top-left: from the left side (s = per - y) round to the top band (s = x)
                corners.append(("tl", 0, 0, lw, t, (lw, t), lambda vx, vy: (-vx, -vy), per - t, t + lw))
        else:
            if qw:      # bottom-right: from the right side round to the bottom band
                corners.append(("br", W - qw, 0, qw, b_h, (W - qw, 0), lambda vx, vy: (vx, vy), W + H - b_h,
                                b_h + qw))
            if lw:      # bottom-left: from the bottom band round to the left side
                corners.append(("bl", 0, 0, lw, b_h, (lw, 0), lambda vx, vy: (vy, -vx), 2 * W + H - lw, lw + b_h))
        cb = self._cyc_bytes(level)
        P = len(cb)
        ph = int(getattr(self, "_fr_phase", 0.0))
        for name, x0, y0, w, h, ci, orient, s0, span in corners:
            idx = []
            for yy in range(h):
                for xx in range(w):
                    vx, vy = (x0 + xx + 0.5) - ci[0], (y0 + yy + 0.5) - ci[1]
                    a_, b2 = orient(vx, vy)            # (towards where it comes from, towards where it goes)
                    th = math.atan2(max(0.0, b2), max(1e-6, a_)) if a_ > 0 or b2 > 0 else 0.0
                    idx.append(int(s0 + span * th / (math.pi / 2)))
            data = b"P6\n%d %d\n255\n" % (w, h) + b"".join(cb[(i - ph) % P] for i in idx)
            img = tk.PhotoImage(data=data)
            it = cv.create_image(x0, y0, image=img, anchor="nw", tags=("bandbg", "corner"))
            items[(side, name)] = {"cv": cv, "it": it, "img": img, "idx": idx, "w": w, "h": h, "lvl": level}

    def _corners_flow(self):
        cb_cache = {}
        ph = int(getattr(self, "_fr_phase", 0.0))
        for k, d in list(getattr(self, "_corner_items", {}).items()):
            lvl = d["lvl"]
            if lvl not in cb_cache:
                cb_cache[lvl] = self._cyc_bytes(lvl)
            cb = cb_cache[lvl]
            P = len(cb)
            try:
                d["img"].configure(data=b"P6\n%d %d\n255\n" % (d["w"], d["h"]) +
                                   b"".join(cb[(i - ph) % P] for i in d["idx"]))
            except Exception:
                pass

    def _mould_w(self):
        """The frame's moulding: the same width all round the window (Personalise > The frame > Width)."""
        return max(5, min(12, int(self._frame_conf().get("width", 6)) + 1))

    def _ring_overlay(self, side, w, h):
        """4.2: the frame's moulding laid over a band's flowing colours - a dark outer edge, a bright line, a soft
        light fading in and a shadow, the SAME width on every side and mitred at the corners, plus the thin shadow
        where the frame meets the page area. A see-through picture that never moves (only the colours flow)."""
        if w < 2 or h < 2:
            return None
        m = self._mould_w()
        lw, qw = self._ring_sides()
        key = (side, w, h, m, lw, qw)
        cache = self.__dict__.setdefault("_ring_ov", {})
        if key in cache:
            return cache[key]
        if len(cache) > 24:
            cache.clear()

        def px(d):                                   # premultiplied RGBA of the moulding at distance d
            if d == 0:
                a = 0.34
                return (0, 0, 0, int(a * 255))
            if d == 1:
                a = 0.50
                return (int(255 * a), int(255 * a), int(255 * a), int(255 * a))
            if d < m - 1:
                a = 0.30 * (1.0 - (d - 2) / max(1.0, m - 3.0))
                return (int(255 * a), int(255 * a), int(255 * a), int(255 * a))
            if d == m - 1:
                return (0, 0, 0, int(0.24 * 255))
            return (0, 0, 0, 0)
        P_ = [bytes(px(d)) for d in range(m + 1)]
        clear = P_[m]
        line = bytes((0, 0, 0, int(0.20 * 255)))

        def dpx(d):
            return P_[d] if d < m else clear
        rows = []
        if side in ("tb", "st"):
            for yy in range(h):
                dy = yy if side == "tb" else h - 1 - yy        # distance to the window's top / bottom edge
                inner = (side == "tb" and yy == h - 1) or (side == "st" and yy == 0)
                left = b"".join(dpx(min(dy, x)) for x in range(min(m, w)))
                right = b"".join(dpx(min(dy, w - 1 - x)) for x in range(max(m, w - m), w))
                mid_n = max(0, w - 2 * m)
                if inner and dy >= m:
                    a_ = max(0, min(mid_n, lw - m))
                    b_ = max(0, min(mid_n, (w - qw) - m) - a_)
                    mid = clear * a_ + line * b_ + clear * (mid_n - a_ - b_)
                else:
                    mid = dpx(dy) * mid_n
                rows.append(left + mid + right)
        else:
            row = []
            for x in range(w):
                d = (w - 1 - x) if side in ("qb", "rb") else x      # distance to the window's right / left edge
                inner = (side in ("qb", "rb") and x == 0) or (side == "lb" and x == w - 1)
                row.append(line if (inner and d >= m) else dpx(d))
            rows = [b"".join(row)] * h
        try:
            pix = self.fitz.Pixmap(self.fitz.csRGB, w, h, b"".join(rows), 1)
            img = tk.PhotoImage(data=pix.tobytes("png"))
        except Exception as ex:
            _log(f"frame moulding: {ex}")
            img = None
        cache[key] = img
        return img

    def _band_img(self, side, level):
        conf = self._frame_conf()
        cyc = self._ring_cyc()
        look = conf.get("look", "bevel")
        key = (side, level, conf.get("palette"), tuple(conf.get("colors") or ()), look, self.accent,
               self.T["bg"], self._fr_P)
        cache = self.__dict__.setdefault("_band_cache", {})
        if key in cache:
            return cache[key]
        horiz, rev, outer = self.BAND_SPEC[side]
        thick = {"tb": self.TB_H, "st": self.ST_H, "qb": QB_W, "rb": self._side_w(), "lb": self._side_w()}[side]
        ln = (max(800, self.root.winfo_screenwidth()) if horiz else max(600, self.root.winfo_screenheight())) + \
            self._fr_P
        # 4.2: the bands are one flowing colour (no shading of their own) - the moulding over them is shared
        img = tk.PhotoImage(data=frame_strip_ppm(cyc, ln, thick, horiz, rev, outer, self.T["bg"],
                                                 conf.get("glow", True), level,
                                                 "flat" if look == "bevel" else look))
        cache[key] = img
        return img

    def _band_offset(self, side):
        """4.2: ONE ring - the colours go round the window without a break: along the top, down the right, back
        along the bottom, up the left (each band starts where it really is in the window)."""
        W, H = max(1, self.root.winfo_width()), max(1, self.root.winfo_height())
        ph = getattr(self, "_fr_phase", 0.0)
        P = getattr(self, "_fr_P", 900)
        t = self.TB_H
        return {"tb": (-ph) % P, "st": (ph - 2 * W - H) % P, "qb": (W + t - ph) % P, "rb": (W + t - ph) % P,
                "lb": (ph - 2 * W - 2 * H + t) % P}[side]

    def _band_bg(self, cv, side):
        """The flowing colours behind a band's writing (the theme's plain colour when the frame is off)."""
        cv.delete("bandbg")
        hidden = self.fullscreen or (getattr(self, "_reading", False) and side != "tb")
        if not self._bands_on() or hidden:
            cv.configure(bg=self.T["bg"])
            self.__dict__.setdefault("_band_items", {}).pop(side, None)
            return False
        level = self._frame_level()
        img = self._band_img(side, level)
        o = self._band_offset(side)
        pos = (-o, 0) if self.BAND_SPEC[side][0] else (0, -o)
        it = cv.create_image(pos[0], pos[1], image=img, anchor="nw", tags="bandbg")
        cv.tag_lower(it)
        if side in ("tb", "st"):
            try:
                self._ring_corners(cv, side, level)
            except Exception as ex:
                _log(f"frame corners: {ex}")
        if self._frame_conf().get("look", "bevel") == "bevel":          # 4.2: the moulding, the same all round
            ov = self._ring_overlay(side, cv.winfo_width(), cv.winfo_height())
            if ov is not None:
                cv.create_image(0, 0, image=ov, anchor="nw", tags=("bandbg", "bandov"))
        self.__dict__.setdefault("_band_items", {})[side] = (cv, it, level)
        return True

    WIN_BTN_W = 46

    def _topband_draw(self):
        """The menu row: File · Edit · Pages · View · Help - and the document you are in, in the middle.
        4.2: while reading - the book, the document and its chapter, Choose and Exit reading (always there, not
        only when the mouse comes to the top); on Windows also minimise / maximise / close at the right."""
        tb = getattr(self, "topband", None)
        if tb is None:
            return
        tb.delete("all")
        on = self._band_bg(tb, "tb")
        ink, sub = self._band_ink()
        H = self.TB_H
        W = max(200, tb.winfo_width())
        x = 8
        hits = self._tb_hits = []
        hov = getattr(self, "_tb_hov", None)
        f = self.F(9)
        hov_fill = mix(self.T["bg"], self.accent, 0.16) if not on else ""
        right = W
        if self._cap_on():                                  # minimise · maximise / restore · close
            bw = self.WIN_BTN_W
            right = W - 3 * bw
            zoomed = self._cap.zoomed()
            for k, key in enumerate(("_min", "_max", "_close")):
                x0 = right + k * bw
                if hov == key:
                    tb.create_rectangle(x0, 0, x0 + bw, H, fill="#E81123" if key == "_close" else
                                        mix(self.T["bg"], ink, 0.22), outline="")
                col = "#FFFFFF" if (hov == key and key == "_close") else ink
                cx, cy = x0 + bw / 2, H / 2
                g_ = 5 * self._cap.s
                d_ = 2 * self._cap.s
                lw_ = max(1, round(self._cap.s))
                if key == "_min":
                    tb.create_line(cx - g_, cy, cx + g_, cy, fill=col, width=lw_)
                elif key == "_max":
                    if zoomed:
                        tb.create_rectangle(cx - g_, cy - g_ + d_, cx + g_ - d_, cy + g_, outline=col, width=lw_)
                        tb.create_line(cx - g_ + d_, cy - g_, cx + g_, cy - g_, cx + g_, cy + g_ - d_, fill=col,
                                       width=lw_)
                    else:
                        tb.create_rectangle(cx - g_, cy - g_, cx + g_, cy + g_, outline=col, width=lw_)
                else:
                    tb.create_line(cx - g_, cy - g_, cx + g_, cy + g_, fill=col, width=lw_ + 0.2)
                    tb.create_line(cx - g_, cy + g_, cx + g_, cy - g_, fill=col, width=lw_ + 0.2)
                hits.append((x0, x0 + bw, key))
        if getattr(self, "_lock", None) is not None:          # 4.4.1: the PIN first - nothing else up here
            tb.create_text(x + 6, H / 2, text="BindLens", anchor="w", font=self.F(9, "bold"), fill=ink)
            return
        if getattr(self, "_reading", False):
            title = self._read_title()
            draw_icon(tb, "openbook", x + 9, H / 2, ink, s=0.7, w=1.4)
            x += 24
            keys_ = [("_choose", "Choose what to read"), ("_exit", "Exit reading  (Esc)")]
            if self._is_picture_book():
                keys_.insert(1, ("_play", "Pause the slideshow" if getattr(self, "_slide_on", False) else
                                 "Play the slideshow"))
            keys_.insert(1, ("_print", "Print"))                 # 4.3: print while reading - the same Print
            pad_ = max(5, int(H * 0.17))
            for key, txt in keys_:
                ico_ = 18 if key == "_print" else 0
                w = self._measure(txt, self._sfont(9)) + 22 + ico_
                round_rect(tb, x, pad_, x + w, H - pad_, 9, fill=hov_fill if hov == key else "",
                           outline=ink if (on and hov == key) else (sub if on else self.T["border"]), width=1)
                if ico_:
                    draw_icon(tb, "printer", x + 17, H / 2, ink, s=0.55, w=1.5)
                tb.create_text(x + (w + ico_) / 2, H / 2, text=txt, font=f, fill=ink)
                hits.append((x, x + w, key))
                x += w + 6
            room = right - x - 24
            if room > 80:
                tb.create_text(x + 14, H / 2, text=self._fit_text(title, self._sfont(9, "bold"), room), anchor="w",
                               font=self.F(9, "bold"), fill=ink)
            return
        for name, _m in getattr(self, "_menu_defs", []):
            w = self._measure(name, self._sfont(9)) + 20
            if hov == name:
                round_rect(tb, x, 4, x + w, H - 4, 8, fill=hov_fill, outline=ink if on else "", width=1.2)
            tb.create_text(x + w / 2, H / 2, text=name, font=f, fill=ink)
            hits.append((x, x + w, name))
            x += w + 2
        info = getattr(self, "_tb_info", "")
        if info:
            room = min(W - 2 * (x + 24), 2 * (right - W / 2) - 24)
            if room > 120:
                tb.create_text(W / 2, H / 2, text=self._fit_text(info, self._sfont(9), room), font=f, fill=sub)

    def _read_title(self):
        """What is being read: book · document · chapter · page n of N."""
        if not self.book or not self.book.total:
            return self.lib.label(self.folder) if self.folder is not None else ""
        g = max(0, min(self.current_page, self.book.total - 1))
        fi_ = self.book.pages[g][0]
        f_ = self.book.files[fi_]
        doc = os.path.splitext(os.path.basename(f_["rel"]))[0]
        try:
            k_ = self._part_at(fi_, g - f_["first"])
            if k_ >= 0:
                doc += "  ·  " + (self._sec_vis(fi_) or [[0, ""]])[k_][1]
        except Exception:
            pass
        book = self.lib.label(self.folder) if self.folder is not None else ""
        return f"{book}  ·  {doc}  ·  page {g - f_['first'] + 1} of {f_['count']}"

    def _tb_at(self, e):
        return next((h for h in getattr(self, "_tb_hits", []) if h[0] <= e.x <= h[1]), None)

    def _tb_motion(self, e):
        h = self._tb_at(e)
        nm = h[2] if h else None
        if nm != getattr(self, "_tb_hov", None):
            self._tb_hov = nm
            self._topband_draw()

    def _tb_double(self, e):
        """Double-click the empty band: maximise / restore (our own title bar on Windows)."""
        if self._cap_on() and not self._tb_at(e):
            self._win_max()

    def _tb_click(self, e=None, name=None):
        if name is None:
            h = self._tb_at(e)
            if not h:
                return                                        # (own title bar: the empty band moves the window)
            name = h[2]
        if getattr(self, "_lock", None) is not None and name not in ("_min", "_max", "_close"):
            return                                            # 4.4.1: the PIN first
        act = {"_min": self._win_min, "_max": self._win_max, "_close": self.on_close,
               "_choose": lambda: self._read_choose(), "_exit": lambda: self.reading_mode(False),
               "_print": lambda: self.print_dialog(),
               "_play": self._slide_toggle}.get(name)
        if act is not None:
            self._tb_hov = None
            act()
            return
        h = next((x for x in getattr(self, "_tb_hits", []) if x[2] == name), None)
        menu = dict(self._menu_defs).get(name)
        if menu is None or getattr(self, "_reading", False):
            return
        x0 = h[0] if h else 8
        self._tb_hov = name
        self._topband_draw()
        try:
            menu.tk_popup(self.topband.winfo_rootx() + int(x0), self.topband.winfo_rooty() + self.TB_H)
        finally:
            try:
                menu.grab_release()
            except Exception:
                pass
            self._tb_hov = None
            self._topband_draw()

    def _status_draw(self):
        """The status row: what BindLens says (left) and where you are (right) - easy to read, never loud."""
        st = getattr(self, "status", None)
        if st is None or not hasattr(self, "status_lbl"):
            return
        st.delete("all")
        self._band_bg(st, "st")
        ink, sub = self._band_ink()
        W = max(200, st.winfo_width())
        f = self.F(9)
        wt = st.create_text(W - 14, self.ST_H / 2, text=self.where_lbl.text, anchor="e", font=f, fill=sub)
        bb = st.bbox(wt)
        room = (bb[0] if bb and self.where_lbl.text else W) - 40
        st.create_text(14, self.ST_H / 2, text=self._fit_text(self.status_lbl.text, self._sfont(9), max(60, room)),
                       anchor="w", font=f, fill=sub)

    def _sideband_draw(self):
        for side, cv in (("lb", getattr(self, "lband", None)), ("rb", getattr(self, "rband", None))):
            if cv is not None:
                cv.delete("all")
                self._band_bg(cv, side)

    def _frame_draw(self, force=False):
        conf = self._frame_conf()
        if conf["mode"] == "off" or getattr(self, "_fr", None) is None:
            return
        if getattr(self, "_fr_P", None) != self._ring_P():          # 4.2: the window changed size - the ring too
            force = True
            self._fr_imgs = {}
        level = self._frame_level()
        # the bands (menu row, status row, tools, sides): their pictures move, the writing stays
        for side, (cv, it, lvl) in list(getattr(self, "_band_items", {}).items()):
            if lvl != level or force:
                {"tb": self._topband_draw, "st": self._status_draw, "qb": self._qbar_draw,
                 "rb": self._sideband_draw, "lb": self._sideband_draw}[side]()
                continue
            o = self._band_offset(side)
            try:
                if self.BAND_SPEC[side][0]:
                    cv.coords(it, -o, 0)
                else:
                    cv.coords(it, 0, -o)
            except Exception:
                pass
        self._corners_flow()
        # the thin lines (reading mode, full screen)
        if self._bands_hidden() and getattr(self, "_fr", None):
            imgs = self._frame_images(level)
            W, H = max(1, self.root.winfo_width()), max(1, self.root.winfo_height())
            P = getattr(self, "_fr_P", 900)
            ph = self._fr_phase
            y0 = getattr(self, "_fr_y0", 0)
            offs = {"t": (-ph) % P, "r": (W + y0 - ph) % P, "b": (ph - 2 * W - H) % P,
                    "l": (ph - 2 * W - 2 * H + y0) % P}
            for side, d in self._fr.items():
                c = d["c"]
                if side == "t" and not self.fullscreen:
                    continue
                o = offs[side]
                pos = (-o, 0) if side in ("t", "b") else (0, -o)
                if d["item"] is None or force or d.get("lvl") != level or d.get("img") is not imgs[side]:
                    c.delete("all")
                    d["item"] = c.create_image(pos[0], pos[1], image=imgs[side], anchor="nw")
                    d["lvl"], d["img"] = level, imgs[side]
                else:
                    c.coords(d["item"], pos[0], pos[1])
        if os.name == "nt" and time.time() - getattr(self, "_fr_tb_t", 0) > 0.6:
            self._fr_tb_t = time.time()
            cyc = getattr(self, "_fr_cyc", None)
            if cyc:                                       # Windows 11: the window's own edge flows too
                r_, g_, b_ = cyc[int(-self._fr_phase) % len(cyc)]
                self._dwm_colors(border="#%02X%02X%02X" % (r_, g_, b_))

    def _frame_images(self, level):
        conf = self._frame_conf()
        key = (level, conf.get("palette"), tuple(conf.get("colors") or ()), conf.get("width"), conf.get("look"),
               self.accent, self.T["bg"], self._ring_P())
        if self._fr_imgs.get("key") != key:
            self._fr_imgs = {"key": key}
        got = self._fr_imgs.get(level)
        if got:
            return got
        wd = max(2, min(10, int(conf.get("width", 6))))
        cyc = self._ring_cyc()
        sw, sh = max(800, self.root.winfo_screenwidth()), max(600, self.root.winfo_screenheight())
        bg = self.T["bg"]
        glow = conf.get("glow", True)
        imgs = {}
        P_ = self._fr_P
        for side, horiz, rev, outer, ln in (("t", True, False, True, sw + P_), ("r", False, False, False, sh + P_),
                                            ("b", True, True, False, sw + P_), ("l", False, True, True, sh + P_)):
            imgs[side] = tk.PhotoImage(data=frame_strip_ppm(cyc, ln, wd, horiz, rev, outer, bg, glow, level,
                                                            conf.get("look", "bevel")))
        self._fr_imgs[level] = imgs
        return imgs

    def _frame_tick(self):
        self._fr_job = None
        conf = self._frame_conf()
        if conf["mode"] == "off":
            return
        delay = 70
        try:
            still = conf["mode"] == "still" or self._fast()
            paused = (self.root.state() == "iconic" or time.time() < getattr(self, "_scroll_quiet", 0) or
                      getattr(self, "_idle_win", None) is not None or getattr(self, "_lock", None) is not None)
            if not paused:
                lvl = self._frame_level()
                if not still or lvl == 2:
                    sp = FRAME_SPEEDS.get(conf.get("speed", "normal"), 1.1)
                    if lvl == 0:
                        sp *= 0.45
                    elif lvl == 2:
                        sp *= 2.2
                    self._fr_phase = (self._fr_phase + sp) % getattr(self, "_fr_P", 900)
                self._frame_draw()
            if still and time.time() >= getattr(self, "_fr_pulse_until", 0) and not self._busy_now():
                delay = 900
            elif paused:
                delay = 400
        except Exception as ex:
            _log(f"frame: {ex}")
            delay = 1000
        self._fr_job = self.root.after(delay, self._frame_tick)

    def _dwm_colors(self, border=None, caption=None, text=None):
        """4.1 - Windows 11: the colour of the window's edge and of its title bar, so the frame takes in the whole
        window. Older Windows simply ignores it."""
        if os.name != "nt":
            return
        try:
            import ctypes
            hwnd = ctypes.windll.user32.GetParent(self.root.winfo_id()) or self.root.winfo_id()
            for attr, col in ((34, border), (35, caption), (36, text)):
                if not col:
                    continue
                if col == "default":
                    val = ctypes.c_uint(0xFFFFFFFF)
                else:
                    val = ctypes.c_uint(int(col[1:3], 16) | (int(col[3:5], 16) << 8) | (int(col[5:7], 16) << 16))
                ctypes.windll.dwmapi.DwmSetWindowAttribute(hwnd, attr, ctypes.byref(val), 4)
        except Exception:
            pass

    def _frame_titlebar(self):
        conf = self._frame_conf()
        if conf["mode"] == "off" or not conf.get("titlebar", True):
            self._dwm_colors("default", "default", "default")
            return
        cols = self._frame_cols()
        T = self.T
        cap = mix(T["bg"], cols[0], 0.16)
        self._dwm_colors(border=cols[0], caption=cap, text=T["text"])

    def _frame_level(self):
        """0 calm (reading) · 1 normal · 2 bright (working, or something new)."""
        conf = self._frame_conf()
        now = time.time()
        if conf.get("pulse", True) and now < getattr(self, "_fr_pulse_until", 0):
            return 2 if int(now * 2.2) % 2 == 0 else 1
        if conf.get("busy", True) and self._busy_now():
            return 2
        if getattr(self, "_reading", False):
            return 0
        return 1

    def _busy_now(self):
        """Is BindLens working on something (a report, Office copies, saving, reading scans)?"""
        try:
            if getattr(self, "_rep_job", None) or getattr(self, "_office_busy", False):
                return True
            if getattr(self, "_scan_busy40", False):
                return True
            with self.writer.lock:
                if self.writer.latest:
                    return True
            return self.pool.busy > 0 and self.pool.pending() > 2
        except Exception:
            return False

    def frame_pulse(self, secs=3.0):
        """Something new: the frame pulses for a moment."""
        if self._frame_conf().get("pulse", True):
            self._fr_pulse_until = time.time() + secs

    def _qp_fill_frame(self, body, refresh=None):
        T = self.T
        conf = self._frame_conf()

        def setv(k, v):
            conf[k] = v
            self.lib.save_meta()
            self._frame_apply()
            (refresh or self._qp_refresh)()
        self._qp_section(body, "The frame")
        self._qp_chips(body, [("moving", "Flowing"), ("still", "Still"), ("off", "Off")], conf["mode"],
                       lambda v: setv("mode", v))
        self._qp_section(body, "Colours")
        row = tk.Frame(body, bg=T["panel"])
        row.pack(fill="x")
        for key, (nm, cols) in FRAME_PALETTES.items():
            cols = cols or frame_palette({"palette": "accent"}, self.accent)
            cv = tk.Canvas(row, width=44, height=44, bg=T["panel"], highlightthickness=0, cursor="hand2")
            cv.pack(side="left", padx=(0, 4))
            on = conf.get("palette") == key
            n = len(cols)
            for i, c in enumerate(cols):
                cv.create_arc(6, 6, 38, 38, start=90 + i * 360 / n, extent=360 / n, fill=c, outline=c)
            cv.create_oval(14, 14, 30, 30, fill=T["panel"], outline="")
            if on:
                cv.create_oval(2, 2, 42, 42, outline=self.accent, width=2)
            cv.bind("<Button-1>", lambda e, k=key: setv("palette", k))
            cv.bind("<Enter>", lambda e, cv=cv, nm=nm: self.tooltip.schedule(cv, nm))
            cv.bind("<Leave>", lambda e: self.tooltip.cancel())
        own = tk.Label(body, text="Your own colours…", font=self.F(9), bg=T["panel"], fg=self.accent, cursor="hand2")
        own.pack(anchor="w", pady=(6, 0))

        def pick_own(_e=None):
            cols = list(conf.get("colors") or [])[:4]
            for i in range(3):
                c = colorchooser.askcolor(color=(cols[i] if i < len(cols) else self.accent), parent=self.root,
                                          title=f"Colour {i + 1} of 3 (Cancel to stop)")
                if not c or not c[1]:
                    break
                if i < len(cols):
                    cols[i] = c[1]
                else:
                    cols.append(c[1])
            if cols:
                conf["colors"] = cols
                setv("palette", "custom")
        own.bind("<Button-1>", pick_own)
        self._qp_section(body, "Speed")
        self._qp_chips(body, [("slow", "Slow"), ("normal", "Normal"), ("fast", "Faster")], conf.get("speed"),
                       lambda v: setv("speed", v))
        self._qp_section(body, "Width of the sides")
        self._qp_chips(body, [(3, "Thin"), (6, "Frame"), (9, "Wide"), (12, "Bold")], int(conf.get("width", 6)),
                       lambda v: setv("width", v))
        self._qp_section(body, "Look")
        self._qp_chips(body, [("bevel", "Picture frame"), ("glow", "Soft glow"), ("flat", "Flat")],
                       conf.get("look", "bevel"), lambda v: setv("look", v))
        opts_ = [("busy", "Glow while BindLens works"), ("pulse", "Pulse when something new arrives"),
                 ("titlebar", "The window's edge in the frame's colours (Windows 11)")]
        for key, lab in opts_:
            var = tk.BooleanVar(value=bool(conf.get(key, True)))
            ttk.Checkbutton(body, text=lab, variable=var,
                            command=lambda k=key, v=var: setv(k, v.get())).pack(anchor="w", pady=(6, 0))
        if os.name == "nt":                                   # 4.3: the frame from the very top of the window
            var = tk.BooleanVar(value=bool(conf.get("own_bar", True)))
            ttk.Checkbutton(body, text="BindLens's own title bar - the frame starts at the very top", variable=var,
                            command=lambda v=var: (self.ownbar_set(v.get()), (refresh or self._qp_refresh)())
                            ).pack(anchor="w", pady=(6, 0))
        tk.Label(body, text="The frame is one ring of colours round the whole window: the top bar (menus, the "
                            "document, and on Windows minimise / maximise / close), the tools on the right, the status "
                            "row at the bottom and a slim side on the left. It rests while you scroll and when "
                            "BindLens is minimised, and is calm while you read.",
                 font=self.F(8), bg=T["panel"], fg=T["muted"], wraplength=290, justify="left").pack(anchor="w",
                                                                                                     pady=(12, 0))
        tst = tk.Label(body, text="Show me a pulse", font=self.F(9), bg=T["panel"], fg=self.accent, cursor="hand2")
        tst.pack(anchor="w", pady=(6, 0))
        tst.bind("<Button-1>", lambda e: self.frame_pulse(3.0))

    # ---- edit the PDF's own text -----------------------------------------------------------------------------------
    def _et_line_at(self, g, px, py):
        """The line of the PDF's own text under a point of the page -> (line dict, page)."""
        try:
            page = self.book.page(g)
        except Exception:
            return None, None
        pt = self.fitz.Point(px, py) * page.derotation_matrix
        best = None
        try:
            d = page.get_text("dict", flags=0)
        except Exception:
            return None, page
        for b in d.get("blocks", []):
            for ln in b.get("lines", []):
                if not any(s.get("text", "").strip() for s in ln.get("spans", [])):
                    continue
                r = self.fitz.Rect(ln["bbox"])
                rr = self.fitz.Rect(r.x0 - 2, r.y0 - 1.5, r.x1 + 2, r.y1 + 1.5)
                if rr.contains(pt):
                    if best is None or r.get_area() < self.fitz.Rect(best["bbox"]).get_area():
                        best = ln
        return best, page

    def _et_hover(self, e):
        c = self.canvas
        c.delete("et_hover")
        hit = self._event_to_page(e)
        if not hit:
            return
        ln, page = self._et_line_at(*hit)
        if not ln:
            return
        r = self.fitz.Rect(ln["bbox"]) * page.rotation_matrix
        x0, y0, x1, y1 = self._to_canvas(hit[0], (r.x0, r.y0, r.x1, r.y1))
        c.create_rectangle(x0 - 3, y0 - 2, x1 + 3, y1 + 2, outline=self.accent, width=1.4, dash=(4, 3),
                           tags="et_hover")

    def edit_text_at(self, g, px, py):
        """Click a line of the PDF's own text: it opens for typing, in place; Enter changes it in the file (the same
        font, size and colour), Esc leaves it as it was."""
        fi = self._require_pdf(g)
        if fi is None:
            return
        ln, page = self._et_line_at(g, px, py)
        if not ln:
            self.set_status("No text there - click a line of the document's own text (a scanned page has none).")
            return
        spans = [s for s in ln["spans"] if s.get("text", "").strip()]
        old = "".join(s["text"] for s in ln["spans"]).strip()
        s0 = spans[0]
        r = self.fitz.Rect(ln["bbox"]) * page.rotation_matrix
        x0, y0, x1, y1 = self._to_canvas(g, (r.x0, r.y0, r.x1, r.y1))
        c = self.canvas
        c.delete("et_hover")
        col = s0.get("color", 0)
        hexc = "#%06X" % int(col) if isinstance(col, int) else "#000000"
        fam = "Times New Roman" if re.search(r"times|serif|georgia|garamond|cambria", s0.get("font", ""), re.I) else \
            ("Courier New" if re.search(r"courier|mono|consol", s0.get("font", ""), re.I) else "Arial")
        bold = "bold" if (int(s0.get("flags", 0)) & 16 or re.search(r"bold|black", s0.get("font", ""), re.I)) else \
            "normal"
        size0 = float(s0.get("size", 11))
        ital0 = bool(int(s0.get("flags", 0)) & 2) or bool(re.search(r"italic|oblique", s0.get("font", ""), re.I))
        # 4.2: the original font, size and colour first - a small bar below lets you change them
        sty = {"family": None, "size": size0, "rgb": hexc, "bold": None, "italic": None}
        var = tk.StringVar(value=old)
        en = tk.Entry(c, textvariable=var, fg=hexc, bg="#FFFFFF", relief="flat", bd=0,
                      highlightthickness=2, highlightcolor=self.accent, highlightbackground=self.accent,
                      insertbackground=hexc)

        def look():
            b_ = sty["bold"] if sty["bold"] is not None else bold == "bold"
            i_ = sty["italic"] if sty["italic"] is not None else ital0
            en.configure(font=(sty["family"] or fam, -max(7, int(round(sty["size"] * self.zoom))),
                               ("bold " if b_ else "") + ("italic" if i_ else "") or "normal"),
                         fg=sty["rgb"], insertbackground=sty["rgb"])
        look()
        wid = c.create_window(x0 - 3, y0 - 3, window=en, anchor="nw", width=max(80, (x1 - x0) + 40),
                              height=(y1 - y0) + 8, tags="et_edit")
        en.focus_set()
        en.icursor("end")
        en.select_range(0, "end")
        self.set_status("Type the new text - same font, size and colour, or change them in the small bar.  Enter: "
                        "change it in the document.  Shift+Enter: as a mark you can take off later.  Esc: leave it.")
        T = self.T
        bar = tk.Frame(c, bg=T["pill"], padx=6, pady=3, highlightthickness=1, highlightbackground=T["border"])
        orig_name = (s0.get("font", "") or "").split("+", 1)[-1] or "original"
        fv = tk.StringVar(value=f"Original font ({self._short(orig_name, 18)})")
        mb = tk.Menubutton(bar, textvariable=fv, font=self.F(8), bg=T["chip"], fg=T["text"], relief="flat",
                           activebackground=T["hover"], padx=6, pady=1, cursor="hand2")
        mn = tk.Menu(mb, tearoff=0)

        def set_family(name):
            sty["family"] = name
            fv.set(f"Original font ({self._short(orig_name, 18)})" if name is None else name)
            look()
            en.focus_set()
        mn.add_command(label=f"Original font ({orig_name})", command=lambda: set_family(None))
        mn.add_separator()
        for nm_ in EDIT_FONTS:
            mn.add_command(label=nm_, command=lambda n=nm_: set_family(n))
        mb.configure(menu=mn)
        mb.pack(side="left", padx=(0, 6))
        szl = tk.Label(bar, text="", font=self.F(8), bg=T["pill"], fg=T["text"], width=6)

        def size_by(d_):
            sty["size"] = max(4.0, min(144.0, round(sty["size"] + d_, 1)))
            szl.configure(text=f"{sty['size']:g} pt")
            look()
            en.focus_set()
        for txt_, d_ in (("−", -0.5), (None, 0), ("+", 0.5)):
            if txt_ is None:
                szl.pack(side="left")
                continue
            b_ = tk.Label(bar, text=txt_, font=self.F(10, "bold"), bg=T["chip"], fg=T["text"], width=2,
                          cursor="hand2")
            b_.pack(side="left", padx=1)
            b_.bind("<Button-1>", lambda e, d_=d_: size_by(d_))
        szl.configure(text=f"{sty['size']:g} pt")
        sw_ = tk.Frame(bar, bg=T["pill"])
        sw_.pack(side="left", padx=(8, 4))

        def set_rgb(col_):
            sty["rgb"] = col_
            for w_, c_ in swatches:
                w_.configure(highlightbackground=self.accent if c_ == col_ else T["pill"])
            look()
            en.focus_set()
        swatches = []
        for col_ in [hexc] + [x for x in ("#000000", "#1F3A8A", "#B3261E", "#1E7B34", "#7B1FA2", "#5F6368")
                              if x.upper() != hexc.upper()]:
            w_ = tk.Frame(sw_, bg=col_, width=14, height=14, cursor="hand2", highlightthickness=2,
                          highlightbackground=self.accent if col_ == hexc else T["pill"])
            w_.pack(side="left", padx=1)
            w_.bind("<Button-1>", lambda e, c_=col_: set_rgb(c_))
            swatches.append((w_, col_))
        for key_, txt_, fnt_ in (("bold", "B", self.F(9, "bold")), ("italic", "I", (self.F(9)[0], 9, "italic"))):
            lb_ = tk.Label(bar, text=txt_, font=fnt_, bg=T["chip"], fg=T["text"], width=2, cursor="hand2")
            lb_.pack(side="left", padx=1)

            def tog(e, key_=key_, lb_=lb_):
                cur = sty[key_] if sty[key_] is not None else ((bold == "bold") if key_ == "bold" else ital0)
                sty[key_] = not cur
                lb_.configure(bg=mix(T["chip"], self.accent, 0.35) if sty[key_] else T["chip"])
                look()
                en.focus_set()
            lb_.bind("<Button-1>", tog)
            if (key_ == "bold" and bold == "bold") or (key_ == "italic" and ital0):
                lb_.configure(bg=mix(T["chip"], self.accent, 0.35))
        tk.Label(bar, text="  Enter: change it · Shift+Enter: as a mark · Esc", font=self.F(8), bg=T["pill"],
                 fg=T["muted"]).pack(side="left")
        tid = c.create_window(x0 - 3, y1 + 8, window=bar, anchor="nw", tags="et_edit")
        done = {"v": False}

        def inside(w_):
            while w_ is not None:
                if w_ is en or w_ is bar:
                    return True
                w_ = getattr(w_, "master", None)
            return False

        def changed_style():
            return sty["family"] is not None or abs(sty["size"] - size0) > 0.01 or \
                sty["rgb"].upper() != hexc.upper() or sty["bold"] is not None or sty["italic"] is not None

        def close(apply, as_mark=False):
            if done["v"]:
                return
            done["v"] = True
            new = var.get()
            try:
                c.delete(wid)
                c.delete(tid)
                en.destroy()
                bar.destroy()
            except Exception:
                pass
            self.canvas.focus_set()
            if apply and new.strip() and (new.strip() != old or changed_style()):
                style = dict(sty, rgb=hex_to_rgb01(sty["rgb"]))
                if as_mark:
                    self._et_mark(g, ln, s0, new, old, style)
                else:
                    self._et_apply(g, ln, s0, new, style)

        def focus_out(_e=None):
            def chk():
                try:
                    f_ = self.root.focus_get()
                except Exception:
                    f_ = None
                if f_ is None or inside(f_):
                    return                          # a menu of the bar is open, or the bar was clicked
                close(False)
            self.root.after(200, chk)
        en.bind("<Return>", lambda e: (close(True), "break")[1])
        en.bind("<Shift-Return>", lambda e: (close(True, True), "break")[1])
        en.bind("<KP_Enter>", lambda e: (close(True), "break")[1])
        en.bind("<Escape>", lambda e: (close(False), "break")[1])
        en.bind("<FocusOut>", focus_out)
        self._et_close = lambda: close(False)

    def _et_meta(self, s0, new, old, style=None):
        style = style or {}
        low = (style.get("family") or s0.get("font") or "").lower()
        flags = int(s0.get("flags", 0)) if not style.get("family") else 0
        fn = "Cour" if (flags & 8 or any(w in low for w in ("courier", "mono", "consol"))) else \
            ("TiRo" if (flags & 4 or any(w in low for w in ("times", "serif", "georgia", "garamond", "cambria",
                                                              "roman"))) and "sans" not in low else "Helv")
        col = int(s0.get("color", 0))
        rgb = [((col >> 16) & 255) / 255.0, ((col >> 8) & 255) / 255.0, (col & 255) / 255.0]
        if style.get("rgb") is not None:
            rgb = list(style["rgb"])
        size = float(style.get("size") or s0.get("size", 11))
        return {"cover": "edit", "text": new, "was": old, "fn": fn, "size": size, "rgb": rgb,
                "family": style.get("family"), "bold": style.get("bold"), "italic": style.get("italic")}

    def _et_freetext(self, page, r_disp, meta):
        """The changed words as a mark: white behind them (the old words hidden), the new ones on top - in the
        closest standard font, the same size and colour. It can be moved, removed, or made final."""
        fz = self.fitz
        r = fz.Rect(r_disp) * page.derotation_matrix
        r.normalize()
        rgb = tuple(meta.get("rgb") or (0, 0, 0))
        size = float(meta.get("size", 11))
        fn = meta.get("fn", "Helv")
        # (a mark keeps to the PDF's standard fonts - MuPDF draws every letter of them; bold / italic chosen in the
        # small bar are kept when the change is made for good)
        try:
            a = page.add_freetext_annot(r, meta["text"], fontsize=size, fontname=fn, text_color=rgb,
                                        fill_color=(1, 1, 1), align=0, rotate=page.rotation)
        except TypeError:
            a = page.add_freetext_annot(r, meta["text"], fontsize=size, fontname=fn, text_color=rgb,
                                        fill_color=(1, 1, 1))
        try:
            a.set_border(width=0)
            a.update(fontsize=size, fontname=fn, text_color=rgb, fill_color=(1, 1, 1))
        except Exception:
            pass
        lock_annot(fz, a, meta)
        try:
            a.set_info(content=meta["text"])           # a FreeText's words live in its Contents
        except Exception:
            pass
        return a

    def _et_mark(self, g, ln, s0, new, old, style=None):
        fi = self._require_pdf(g)
        if fi is None:
            return
        page = self.book.page(g)
        meta = self._et_meta(s0, new, old, style)
        r = self.fitz.Rect(ln["bbox"]) * page.rotation_matrix
        try:
            tw = self.fitz.get_text_length(new, fontname={"Helv": "helv", "TiRo": "tiro", "Cour": "cour"}[meta["fn"]],
                                           fontsize=meta["size"])
        except Exception:
            tw = r.width
        rd = self.fitz.Rect(r.x0 - 2, r.y0 - 1, max(r.x1, r.x0 + tw + 4) + 2, r.y1 + 1.5)
        self._begin_edit(fi)
        page = self.book.page(g)
        try:
            a = self._et_freetext(page, rd, meta)
            xref = a.xref
        except Exception as ex:
            if self.undo_stack:
                self.undo_stack.pop()
            messagebox.showerror(APP_NAME, f"Could not change the text:\n{ex}")
            return
        self._commit_edit(fi, g)
        self.sel_annot = (g, xref)
        self.set_status("Changed, as a mark: Delete brings the old words back · right-click > Make it final.")

    def _et_redo_mark(self, g, xref, text=None, rect=None):
        """Change an edit mark's words (text) or its place / size (rect, displayed page points)."""
        fi = self.book.pages[g][0]
        page, a = self._load_annot(g, xref)
        if a is None:
            return None
        meta = annot_meta(a)
        rd = self.fitz.Rect(rect) if rect is not None else self.fitz.Rect(a.rect) * page.rotation_matrix
        if text is not None:
            meta["text"] = text
        self._begin_edit(fi)
        page, a = self._load_annot(g, xref)
        page.delete_annot(a)
        a2 = self._et_freetext(page, rd, meta)
        nx = a2.xref
        self._commit_edit(fi, g)
        self.sel_annot = (g, nx)
        return nx

    def _et_reedit(self, g, xref):
        """Double-click a changed text: type it again."""
        page, a = self._load_annot(g, xref)
        if a is None:
            return
        meta = annot_meta(a)
        r = self.fitz.Rect(a.rect) * page.rotation_matrix
        x0, y0, x1, y1 = self._to_canvas(g, (r.x0, r.y0, r.x1, r.y1))
        c = self.canvas
        rgb = meta.get("rgb") or (0, 0, 0)
        hexc = "#%02X%02X%02X" % tuple(int(v * 255) for v in rgb)
        var = tk.StringVar(value=meta.get("text", ""))
        en = tk.Entry(c, textvariable=var, font=("Arial", -max(7, int(round(float(meta.get("size", 11)) * self.zoom)))),
                      fg=hexc, bg="#FFFFFF", relief="flat", bd=0, highlightthickness=2, highlightcolor=self.accent,
                      highlightbackground=self.accent)
        wid = c.create_window(x0, y0, window=en, anchor="nw", width=max(80, (x1 - x0) + 40), height=(y1 - y0) + 4)
        en.focus_set()
        en.select_range(0, "end")
        st = {"done": False}

        def close(ok):
            if st["done"]:
                return
            st["done"] = True
            t = var.get()
            c.delete(wid)
            en.destroy()
            self.canvas.focus_set()
            if ok and t.strip() and t != meta.get("text"):
                self._et_redo_mark(g, xref, text=t)
        en.bind("<Return>", lambda e: (close(True), "break")[1])
        en.bind("<Escape>", lambda e: (close(False), "break")[1])
        en.bind("<FocusOut>", lambda e: self.root.after(150, lambda: close(False)))

    def _et_make_final(self, g, xref):
        """An edit mark made final: the old words removed from the document and the new ones written in the
        document's own font (as Enter does)."""
        page, a = self._load_annot(g, xref)
        if a is None:
            return
        meta = annot_meta(a)
        new = meta.get("text", "")
        r_unrot = self.fitz.Rect(a.rect)
        fi = self.book.pages[g][0]
        # the line of the document under the mark (its font, size, colour, place)
        best = None
        try:
            for b in page.get_text("dict", flags=0).get("blocks", []):
                for ln in b.get("lines", []):
                    lr = self.fitz.Rect(ln["bbox"])
                    if lr.intersects(r_unrot) and any(sp_.get("text", "").strip() for sp_ in ln.get("spans", [])):
                        inter = lr & r_unrot
                        if best is None or inter.get_area() > best[0]:
                            best = (inter.get_area(), ln)
        except Exception:
            best = None
        self._begin_edit(fi)
        page, a = self._load_annot(g, xref)
        page.delete_annot(a)
        self._commit_edit(fi, g)
        if best is None:
            return
        ln = best[1]
        s0 = [sp_ for sp_ in ln["spans"] if sp_.get("text", "").strip()][0]
        style = {"family": meta.get("family"), "bold": meta.get("bold"), "italic": meta.get("italic"),
                 "size": meta.get("size"), "rgb": tuple(meta["rgb"]) if meta.get("rgb") else None}
        self._et_apply(g, ln, s0, new, style)

    def _et_apply(self, g, ln, s0, new, style=None):
        style = style or {}
        fi = self.book.pages[g][0]
        self._begin_edit(fi)
        self.__dict__.setdefault("_full_next", set()).add(self.book.files[fi]["path"])   # the old words really go
        page = self.book.page(g)
        fz = self.fitz
        try:
            # 4.2: the font is chosen BEFORE the old words go (its letters must all be there - else the same font
            # from the computer, else the standard font embedded whole: no dots or blanks for € “ ” – …)
            fname, ffile, fbuf = pdf_font_for(page.parent, page, s0, text=new, bold=style.get("bold"),
                                              italic=style.get("italic"), family=style.get("family"))
            r = fz.Rect(ln["bbox"])
            h = r.height
            cut = fz.Rect(r.x0 - 0.5, r.y0 + h * 0.18, r.x1 + 0.5, r.y1 - h * 0.18)
            try:
                page.add_redact_annot(cut, fill=False)
            except Exception:
                page.add_redact_annot(cut)
            try:
                page.apply_redactions(images=0, graphics=0, text=0)       # only the letters - pictures stay
            except TypeError:
                page.apply_redactions(images=0)
            if fbuf:
                page.insert_font(fontname=fname, fontbuffer=fbuf)
                ffile = None
            col = int(s0.get("color", 0))
            rgb = (((col >> 16) & 255) / 255.0, ((col >> 8) & 255) / 255.0, (col & 255) / 255.0)
            if style.get("rgb") is not None:
                rgb = tuple(style["rgb"])
            dx, dy = ln.get("dir", (1, 0))
            rot = {(1, 0): 0, (0, -1): 90, (-1, 0): 180, (0, 1): 270}.get((round(dx), round(dy)), 0)
            kw = dict(fontsize=float(style.get("size") or s0.get("size", 11)), fontname=fname, color=rgb,
                      rotate=rot)
            if ffile:
                kw["fontfile"] = ffile
            try:
                page.insert_text(fz.Point(s0["origin"]), new, **kw)
            except Exception:
                kw.pop("fontfile", None)
                kw["fontname"] = full_font(page, "helv", new)
                page.insert_text(fz.Point(s0["origin"]), new, **kw)
        except Exception as ex:
            if self.undo_stack:
                self.undo_stack.pop()
            self.book.reopen(fi)
            messagebox.showerror(APP_NAME, f"Could not change the text:\n{ex}")
            return
        self.words_cache.pop(g, None)
        self._commit_edit(fi, g)
        self.set_status("Text changed in the document.  Ctrl+Z undoes it.")

    # ---- scan and add ----------------------------------------------------------------------------------------------
    def scan_dialog(self):
        """Paper into a book: a scanner, the computer's camera, or photos (from the phone or the computer). Each page
        is cut out of what is round it, turned straight and cleaned; then put in the book you are in."""
        T, A = self.T, self.accent
        d = self._dialog("Scan and add")
        d.configure(padx=22, pady=18)
        tk.Label(d, text="Scan and add", font=self.F(15, "bold"), bg=T["panel"], fg=T["text"]).pack(anchor="w")
        tk.Label(d, text="Paper straight into a book: each page is cut out, turned straight, cleaned and read, so you "
                         "can search it.", font=self.F(9), bg=T["panel"], fg=T["muted"], wraplength=470,
                 justify="left").pack(anchor="w", pady=(2, 12))
        opts = self.lib.settings.setdefault("scan40", {"crop": True, "straight": True, "clean": True, "color": False,
                                                      "where": "new"})
        st = {"paths": [], "watch": None}
        cards = tk.Frame(d, bg=T["panel"])
        cards.pack(fill="x")
        info = tk.Label(d, text="", font=self.F(9), bg=T["panel"], fg=A, wraplength=470, justify="left")

        def card(icon, title, sub, cmd, col):
            f = tk.Frame(cards, bg=T["chip"], cursor="hand2", padx=12, pady=10)
            f.pack(side="left", padx=(0, 8), fill="both", expand=True)
            cv = tk.Canvas(f, width=34, height=34, bg=T["chip"], highlightthickness=0)
            cv.pack(anchor="w")
            round_rect(cv, 1, 1, 33, 33, 9, fill=mix(T["chip"], col, 0.2), outline="")
            draw_icon(cv, icon, 17, 17, col, s=0.8)
            tk.Label(f, text=title, font=self.F(10, "bold"), bg=T["chip"], fg=T["text"]).pack(anchor="w", pady=(6, 0))
            tk.Label(f, text=sub, font=self.F(8), bg=T["chip"], fg=T["muted"], wraplength=130,
                     justify="left").pack(anchor="w")
            for w_ in [f] + list(f.winfo_children()):
                w_.bind("<Button-1>", lambda e: cmd())

        def got(paths):
            st["paths"] += [p for p in paths if p not in st["paths"]]
            n = len(st["paths"])
            info.configure(text=f"{n} page{'s' if n != 1 else ''} ready:  " +
                                ", ".join(os.path.basename(p) for p in st["paths"][-4:]) + ("…" if n > 4 else ""))
            add_b.enabled = True
            add_b.redraw()

        def from_scanner():
            if os.name != "nt":
                messagebox.showinfo(APP_NAME, "The scanner is used through Windows. On this computer, scan to a "
                                              "file and use “Photos and files”.", parent=d)
                return
            info.configure(text="The scanner window is opening… (Windows asks which scanner and how)")
            out = os.path.join(data_dir(), "scans", time.strftime("scan %Y%m%d-%H%M%S") + ".jpg")
            os.makedirs(os.path.dirname(out), exist_ok=True)
            res = {}

            def run():
                try:
                    enc = base64.b64encode(_PS_WIA.encode("utf-16-le")).decode()
                    env = dict(os.environ, BL_OUT=out)
                    p = subprocess.run(["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-STA",
                                        "-EncodedCommand", enc], capture_output=True, text=True, env=env,
                                       timeout=900, creationflags=0x08000000)
                    res["out"] = (p.stdout or "").strip().splitlines()[-1:] or [""]
                except Exception as ex:
                    res["out"] = [f"ERR {ex}"]

            def wait():
                if "out" not in res:
                    d.after(300, wait)
                    return
                o = res["out"][0]
                if o == "OK" and os.path.isfile(out):
                    got([out])
                    if messagebox.askyesno(APP_NAME, "Scanned. Scan another page?", parent=d):
                        from_scanner()
                elif o == "CANCEL":
                    info.configure(text="Nothing scanned.")
                else:
                    msg = o[4:] if o.startswith("ERR") else o
                    info.configure(text="The scanner could not be used: " + (msg or "no answer") +
                                        "  (Is it on and connected? Windows Fax and Scan should see it.)")
            threading.Thread(target=run, daemon=True).start()
            wait()

        def from_camera():
            if os.name != "nt":
                messagebox.showinfo(APP_NAME, "Take the photo with your camera or phone, then use “Photos and "
                                              "files”.", parent=d)
                return
            roll = [os.path.join(os.path.expanduser("~"), "Pictures", "Camera Roll"),
                    os.path.join(os.path.expanduser("~"), "OneDrive", "Pictures", "Camera Roll"),
                    os.path.join(os.path.expanduser("~"), "OneDrive", "Pictures", "Álbum de cámara")]
            t0 = time.time()
            try:
                os.startfile("microsoft.windows.camera:")
            except Exception as ex:
                info.configure(text=f"The Camera app could not be opened: {ex}")
                return
            info.configure(text="The Camera app is open: take a photo of each page (they come here by themselves). "
                                "Then come back and press Add.")
            seen = set()

            def watch():
                if not d.winfo_exists() or time.time() - t0 > 900:
                    return
                new = []
                for folder in roll:
                    try:
                        for nm in os.listdir(folder):
                            p = os.path.join(folder, nm)
