        al_btns = {}
        for a_, tip_ in (("l", "Align left"), ("c", "Centre"), ("r", "Align right"), ("j", "Justify")):
            al_btns[a_] = ibtn(ga, lines_icon(a_), lambda e, a_=a_: (rt.set_para(al=a_), sync_style()), tip_)
        ibtn(gb, list_icon(False), lambda e: (rt.set_para(t="ul" if rt.para_type() != "ul" else "p"), sync_style()),
