def _fbm_rows(W, H, seed, octaves=4, base=4):
    """Smooth random ups and downs (value noise, several sizes on top of each other): a list of rows of floats
    0…1 - pure Python, made once and kept as a picture."""
    import random
    rnd = random.Random(seed)
    out = [[0.0] * W for _ in range(H)]
    tot = 0.0
    amp = 1.0
    for o in range(octaves):
        g = base * (2 ** o)
        gw, gh = g + 2, max(2, int(g * H / max(1, W))) + 2
        grid = [[rnd.random() for _ in range(gw)] for _ in range(gh)]
        sx = (gw - 2) / float(W)
        sy = (gh - 2) / float(H)
        xi = [int(x * sx) for x in range(W)]
        xf = [x * sx - int(x * sx) for x in range(W)]
        xf = [t * t * (3 - 2 * t) for t in xf]
        for y in range(H):
            fy = y * sy
            j = int(fy)
            t = fy - j
            t = t * t * (3 - 2 * t)
            r0, r1 = grid[j], grid[j + 1]
            row = out[y]
            for x in range(W):
                i = xi[x]
                a = r0[i] + (r0[i + 1] - r0[i]) * xf[x]
                b = r1[i] + (r1[i + 1] - r1[i]) * xf[x]
                row[x] += (a + (b - a) * t) * amp
        tot += amp
        amp *= 0.5
    for row in out:
        for x in range(W):
            row[x] /= tot
    return out


def make_texture(name, W, H, seed=11):
    """A big texture (W x H) as raw RGB bytes - woods with wide planks, real grain and knots; marble; stone…"""
    import math
    import random
    spec = BIG_TEXTURES[name]
    s = W / 1600.0
    rnd = random.Random(f"{name}-{seed}")
    A, B = spec["a"], spec["b"]
    kind = spec["kind"]
    if kind == "wood":
        N = 1024
        V = 9
        luts = []
        widths = [rnd.uniform(0.7, 1.3) for _ in range(4)]           # 4 rings of different widths, repeated
        tot = sum(widths)
        bounds, acc = [], 0.0
        for w_ in widths:
            bounds.append((acc / tot, (acc + w_) / tot, rnd.uniform(0.14, 0.3), rnd.uniform(0.7, 1.0)))
            acc += w_
        prof = []
        for i in range(N):
            t = i / float(N)
            b0, b1, lw, dk = next(b for b in bounds if b[0] <= t < b[1] + 1e-9)
            u = (t - b0) / (b1 - b0)
            if u > 1 - lw:                                          # the darker late wood of the ring
                g = ((u - (1 - lw)) / lw) ** 0.8
            else:
                g = 0.12 * u
            prof.append(min(1.0, g * dk))
        for v in range(V):
            f = 0.9 + v * 0.025
            luts.append([bytes(max(0, min(255, int((A[c] + (B[c] - A[c]) * 0.95 * g) * f))) for c in range(3))
                         for g in prof])
        ph = max(6, int(spec["ph"] * s))
        gap = spec.get("gap", 0.66)
        sq = math.sqrt
        rows = []
        y = 0
        p = 0
        while y < H:
            prs = random.Random(f"{name}-{seed}-{p}")
            # the boards of this row: each one its own piece of a tree
            cuts = [0]
            jx = prs.uniform(0.1, 0.7) * 1100 * s
            while jx < W:
                cuts.append(int(jx))
                jx += prs.uniform(520, 1250) * s
            cuts.append(W)
            segs = []
            for a_, b_ in zip(cuts, cuts[1:]):
                fr = prs.uniform(*spec["fr"]) / max(s, 0.05)              # rings per pixel
                cy = (prs.uniform(-2.6, -0.7) if prs.random() < 0.5 else prs.uniform(1.7, 3.6)) * ph
                d0 = prs.uniform(1.0, 2.3) * ph
                waves = [(prs.uniform(0.05, 0.28) * ph, prs.uniform(0.0012, 0.006) / max(s, 0.05), prs.uniform(0, 6.3))
                         for _ in range(2)]
                ramp = prs.uniform(-0.35, 0.35) * ph / max(1, b_ - a_)
                tone = prs.randrange(-2, 3)
                segs.append((a_, b_, fr, cy, d0, waves, ramp, tone))
            d2, kk_ = [], []
            for a_, b_, fr, cy, d0, waves, ramp, tone in segs:
                for x in range(a_, b_):
                    d = d0 + ramp * (x - a_) + sum(am * math.sin(x * f + ph_) for am, f, ph_ in waves)
                    d = max(d, 0.4 * ph)
                    d2.append(d * d)
                    kk_.append(fr * N / 4.0)
            cys = [seg[3] for seg in segs]
            seg_of = []
            for k, (a_, b_, *_r) in enumerate(segs):
                seg_of += [k] * (b_ - a_)
            knots = []
            nk = spec.get("knots", 0.5) * W / 1600.0 * 1.6
            while nk > 0 and W > 300:
                if prs.random() < nk:
                    knots.append((prs.uniform(0.05, 0.95) * W, prs.uniform(0.25, 0.75) * ph,
                                  prs.uniform(10, 26) * s, prs.uniform(4, 9) * s, prs.uniform(2.0, 4.0)))
                nk -= 1
            jit = [prs.choice((-1, 0, 0, 0, 0, 1)) for _ in range(97)]
            for yy in range(ph):
                if y >= H:
                    break
                vrow = []                                           # long pores and streaks along the grain
                for a_, b_, fr, cy, d0, waves, ramp, tone in segs:
                    x = a_
                    while x < b_:
                        ln = min(b_ - x, int(prs.uniform(25, 320) * max(s, 0.05)) + 1)
                        vrow += [max(1, min(V - 2, 4 + tone + prs.choice((-1, 0, 0, 0, 1))))] * ln
                        x += ln
                off = prs.randrange(0, 97)                          # fine grain: a little noise in every pixel
                vrow = [vrow[x] + jit[(x + off) % 97] for x in range(W)]
                dy2 = [(yy - c_) ** 2 for c_ in cys]
                idx = [int(sq(dy2[seg_of[x]] + d2[x]) * kk_[x]) for x in range(W)]
                for kx, ky, rx, ry, kk in knots:
                    if abs(yy - ky) >= ry * 3:
                        continue
                    e_ = ((yy - ky) / ry) ** 2
                    for x in range(max(0, int(kx - rx * 3)), min(W, int(kx + rx * 3))):
                        idx[x] += int(kk * N / 4 * math.exp(-(((x - kx) / rx) ** 2 + e_)))
                row = bytearray(b"".join(luts[vrow[x]][idx[x] & (N - 1)] for x in range(W)))
                if yy < max(1, int(2 * s)):                        # the line between two rows of boards
                    row = bytearray(int(v * gap) for v in row)
                for jx in cuts[1:-1]:                              # where two boards meet end to end
                    if 0 <= jx < W - 2:
                        row[jx * 3:jx * 3 + 6] = bytes(int(v * gap) for v in row[jx * 3:jx * 3 + 6])
                rows.append(bytes(row))
                y += 1
            p += 1
        return b"".join(rows[:H])
    # stone-like: smooth noise, then (with PyMuPDF) veins, grains, pits and streaks drawn on it
    n = _fbm_rows(W, H, seed + len(name), octaves=6 if kind == "marble" else 5, base=2 if kind == "marble" else 3)
    out = bytearray()
    if kind == "marble":
        for y in range(H):
            r1 = n[y]
            for x in range(W):
                t = (x * 0.9 + y * 1.7) / max(1, W) * 2.2 + r1[x] * 2.1
                v = abs(math.sin(t * math.pi))
                g = (1 - v ** 0.11) * 0.95 + (r1[x] - 0.5) * 0.12
                g = max(0.0, min(1.0, g))
                out += bytes(int(A[c] + (B[c] - A[c]) * g) for c in range(3))
    else:
        amp = 0.55 if kind == "stone" and not spec.get("fine") else 0.35
        for y in range(H):
            r1 = n[y]
            for x in range(W):
                g = max(0.0, min(1.0, 0.5 + (r1[x] - 0.5) * amp * 2))
                out += bytes(int(A[c] + (B[c] - A[c]) * g) for c in range(3))
    try:                                                         # the small things that make it real
        import pymupdf as _f
    except ImportError:
        import fitz as _f
    pix = _f.Pixmap(_f.csRGB, W, H, bytes(out), False)
    doc = _f.open()
    pg = doc.new_page(width=W, height=H)
    pg.insert_image(pg.rect, pixmap=pix)
    sh = pg.new_shape()
    if kind in ("cork",) or spec.get("fine"):                   # crumbs (cork) or little pits (concrete)
        cork = kind == "cork"
        n_ = int(W * H / (32 if cork else 90))
        for group in range(8):                                   # a few groups: one colour / strength each
            dark = group % 2 == 0
            for _ in range(n_ // 8):
                x, y = rnd.uniform(0, W), rnd.uniform(0, H)
                r = rnd.uniform(0.35, 1.6) if cork else rnd.uniform(0.3, 1.3)
                sh.draw_oval(_f.Rect(x - r, y - r * rnd.uniform(0.6, 1.0), x + r, y + r))
            if cork:
                sh.finish(color=None, fill=(0.28, 0.17, 0.08) if dark else (0.95, 0.83, 0.62),
                          fill_opacity=0.16 + 0.1 * (group // 2))
            else:
                sh.finish(color=None, fill=(0.25, 0.25, 0.25) if dark else (1, 1, 1),
                          fill_opacity=0.1 + 0.07 * (group // 2))
    elif kind == "stone":                                        # slate: thin layers, a soft sheen
        for _ in range(int(H / 3)):
            y = rnd.uniform(0, H)
            sh.draw_line(_f.Point(0, y), _f.Point(W, y + rnd.uniform(-H * 0.08, H * 0.08)))
            sh.finish(color=(1, 1, 1) if rnd.random() < 0.5 else (0, 0, 0), width=rnd.uniform(0.4, 1.4),
                      stroke_opacity=rnd.uniform(0.02, 0.06))
    sh.commit()
    data = pg.get_pixmap().samples
    doc.close()
    return bytes(data)


def big_texture_base(fitz, name, folder):
    """The texture's big picture (made once - a few seconds - then kept as a PNG)."""
    path = os.path.join(folder, f"{name}-v{TEX_VERSION}.png")
    if os.path.exists(path):
        return path
    os.makedirs(folder, exist_ok=True)
    kind = BIG_TEXTURES[name]["kind"]
    W, H = (1600, 1000) if kind == "wood" else (640, 400)
    data = make_texture(name, W, H)
    pix = fitz.Pixmap(fitz.csRGB, W, H, data, False)
    pix.save(path + ".part.png")
    os.replace(path + ".part.png", path)
    return path


def big_texture_ppm(fitz, path, W, H, dark_canvas=None, light=True):
    """The texture made to fill W x H (cut to fit, never stretched out of shape), a soft light in the middle,
    darker corners; on a dark theme, darker."""
    src = fitz.Pixmap(path)
    doc = fitz.open()
    pg = doc.new_page(width=W, height=H)
    k = max(W / src.width, H / src.height)
    w2, h2 = src.width * k, src.height * k
    pg.insert_image(fitz.Rect((W - w2) / 2, (H - h2) / 2, (W + w2) / 2, (H + h2) / 2), pixmap=src)
    sh = pg.new_shape()
    if dark_canvas:
        sh.draw_rect(pg.rect)
        sh.finish(color=None, fill=_rgb(dark_canvas), fill_opacity=0.5)
    if light:                                                   # a soft light: darker towards the corners
        for i in range(10):
            m = i / 10.0
            sh.draw_rect(fitz.Rect(-W * 0.2 + W * 0.2 * m, -H * 0.25 + H * 0.2 * m,
                                   W * 1.2 - W * 0.2 * m, H * 1.25 - H * 0.2 * m))
        sh.finish(color=None, fill=(0, 0, 0), fill_opacity=0.0)
        sh.draw_oval(fitz.Rect(-W * 0.35, -H * 0.5, W * 1.35, H * 1.5))
        sh.draw_rect(fitz.Rect(-10, -10, W + 10, H + 10))
        sh.finish(color=None, fill=(0, 0, 0), fill_opacity=0.10, even_odd=True)
    sh.commit()
    data = pg.get_pixmap().tobytes("ppm")
    doc.close()
    return data


def is_light(c):
    try:
        r, g, b = int(c[1:3], 16), int(c[3:5], 16), int(c[5:7], 16)
    except Exception:
        return False
    return 0.299 * r + 0.587 * g + 0.114 * b > 186


