        def dates_row(parent):
            label(parent, "Date range", "Leave empty for any date")
            df = tk.Frame(parent, bg=T["panel"])
            df.pack(anchor="w")
            ttk.Entry(df, textvariable=self._rep_from, width=12, font=self.F(10)).pack(side="left")
            tk.Label(df, text="  to  ", bg=T["panel"], fg=T["muted"], font=self.F(9)).pack(side="left")
            ttk.Entry(df, textvariable=self._rep_to, width=12, font=self.F(10)).pack(side="left")
            qf = tk.Frame(parent, bg=T["panel"])
            qf.pack(anchor="w", pady=(6, 0))
            import datetime as _dt

            def shift(days=0, months=0, clear=False):
                if clear:
                    self._rep_from.set("")
                    self._rep_to.set("")
                    return
                a = parse_date_text(self._rep_from.get())
                b = parse_date_text(self._rep_to.get())
                today = _dt.date.today()
                if not a or not b:
                    a = b = today

                    def mv(x, sign):
                        return x
                def add(x, dd, mm):
                    if mm:
                        m = x.month - 1 + mm
                        y = x.year + m // 12
                        m = m % 12 + 1
                        import calendar
                        return x.replace(year=y, month=m, day=min(x.day, calendar.monthrange(y, m)[1]))
                    return x + _dt.timedelta(days=dd)
                if self._rep_from.get().strip() and self._rep_to.get().strip():
                    a, b = add(a, days, months), add(b, days, months)
                else:
                    if days < 0 or months < 0:
                        a, b = add(today, days, months), today
                    else:
                        a, b = today, add(today, days, months)
                self._rep_from.set(a.strftime("%d/%m/%Y"))
                self._rep_to.set(b.strftime("%d/%m/%Y"))
            for lab, dd, mm, col in (("- 1 week", -7, 0, "#D9534F"), ("+ 1 week", 7, 0, "#5CB85C"),
                                     ("- 1 month", 0, -1, "#D9534F"), ("+ 1 month", 0, 1, "#5CB85C"),
                                     ("- 1 year", 0, -12, "#D9534F"), ("+ 1 year", 0, 12, "#5CB85C")):
                b_ = tk.Label(qf, text=lab, font=self.F(8), bg=col, fg="#FFFFFF", padx=6, pady=2, cursor="hand2")
                b_.pack(side="left", padx=(0, 4))
                b_.bind("<Button-1>", lambda e, dd=dd, mm=mm: shift(dd, mm))
            c_ = tk.Label(qf, text="Clear", font=self.F(8), bg="#F0AD4E", fg="#FFFFFF", padx=6, pady=2, cursor="hand2")
            c_.pack(side="left")
            c_.bind("<Button-1>", lambda e: shift(clear=True))

