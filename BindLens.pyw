function Get-App($k) {
  if (-not $apps.ContainsKey($k)) {
    if ($k -eq 'word') { $a = New-Object -ComObject Word.Application; $a.Visible = $false; $a.DisplayAlerts = 0
      try { $a.AutomationSecurity = 3 } catch {} }
    elseif ($k -eq 'excel') { $a = New-Object -ComObject Excel.Application; $a.Visible = $false
      $a.DisplayAlerts = $false; try { $a.AutomationSecurity = 3 } catch {} }
    else { $a = New-Object -ComObject PowerPoint.Application; try { $a.DisplayAlerts = 1 } catch {} }
    $apps[$k] = $a
    Lower-It @{word='WINWORD'; excel='EXCEL'; ppt='POWERPNT'}[$k]
  }
  return $apps[$k]
}
$i = 0
foreach ($j in $jobs) {
  if ($env:BL_STOP -and (Test-Path -LiteralPath $env:BL_STOP)) { break }
  try {
    $a = Get-App $j.kind
    if ($j.kind -eq 'word') {
      $d = $a.Documents.Open($j.src, $false, $true, $false, 'bindlens-no-password')
      try { $d.ExportAsFixedFormat($j.dst, 17) } finally { $d.Close($false) }
    } elseif ($j.kind -eq 'excel') {
      $b = $a.Workbooks.Open($j.src, 0, $true, 5, 'bindlens-no-password')
      try { $b.ExportAsFixedFormat(0, $j.dst) } finally { $b.Close($false) }
    } else {
      $p = $a.Presentations.Open($j.src, -1, 0, 0)
      try { $p.SaveAs($j.dst, 32) } finally { $p.Close() }
    }
    [Console]::Out.WriteLine("OK $i")
  } catch {
    $m = ($_.Exception.Message -replace "[`r`n]+", " ")
    [Console]::Out.WriteLine("ERR $i $m")
  }
  [Console]::Out.Flush()
  $i++
}
foreach ($k in @($apps.Keys)) {
  $a = $apps[$k]
  try {
    if ($k -eq 'word') { if ($a.Documents.Count -eq 0) { $a.Quit() } }
    elseif ($k -eq 'excel') { if ($a.Workbooks.Count -eq 0) { $a.Quit() } }
    else { if ($a.Presentations.Count -eq 0) { $a.Quit() } }
  } catch {}
  try { [void][Runtime.InteropServices.Marshal]::ReleaseComObject($a) } catch {}
}"""


def office_batch(jobs, work_dir, on_done, stop=None, wait_each=150, stop_file=None):
    """3.3: make the exact PDFs of several Office files with Microsoft Office - each program opened once, hidden,
    for all of them (much faster), and closed again only when you have no file of your own open in it.
    jobs: [(src, dst, kind)]; on_done(index, error or None) is called for each file as soon as it is made."""
    import base64
    os.makedirs(work_dir, exist_ok=True)
    jf = os.path.join(work_dir, "jobs.json")
    with open(jf, "w", encoding="utf-8") as fh:
        json.dump([{"src": a, "dst": b, "kind": k} for a, b, k in jobs], fh)
    enc = base64.b64encode(_PS_BATCH.encode("utf-16-le")).decode("ascii")
    errf = open(os.path.join(work_dir, "errors.txt"), "wb")      # (a file: a full pipe could stop PowerShell)
    env = dict(os.environ, BL_JOBS=jf)
    if stop_file:
        env["BL_STOP"] = stop_file
    p = subprocess.Popen(["powershell", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass",
                          "-EncodedCommand", enc], env=env, stdout=subprocess.PIPE,
                         stderr=errf, stdin=subprocess.DEVNULL, creationflags=0x08000000 | 0x00004000)
    last = [time.time()]
    seen = set()

    def watch():                                   # a file that takes far too long: stop (the rest next time)
        while p.poll() is None:
            if time.time() - last[0] > wait_each or (stop and stop()):
                try:
                    p.kill()
                except Exception:
                    pass
                return
            time.sleep(1)
    threading.Thread(target=watch, daemon=True).start()
    for raw in p.stdout:
        last[0] = time.time()
        line = raw.decode("utf-8", "replace").strip()
        m = re.match(r"(OK|ERR) (\d+) ?(.*)", line)
        if not m:
            continue
        i = int(m.group(2))
        seen.add(i)
        on_done(i, None if m.group(1) == "OK" else (m.group(3) or "Office could not open it"))
    p.wait()
    errf.close()
    try:
        with open(os.path.join(work_dir, "errors.txt"), "rb") as fh:
            err = fh.read().decode("utf-8", "replace")
    except OSError:
        err = ""
    for i in range(len(jobs)):
        if i not in seen:
            if stop_file and os.path.exists(stop_file):
                on_done(i, "later")                      # stopped on purpose (you came back): next time
                continue
            why = "Office took too long" if time.time() - last[0] >= wait_each else (
                err.strip().splitlines()[-1][:200] if err.strip() else "Office did not answer")
            on_done(i, why)
    return err


def office_programs():
    """4.0: which Microsoft Office programs Windows knows: {"word": bool, "excel": bool, "ppt": bool}."""
    out = {"word": False, "excel": False, "ppt": False}
    if os.name != "nt":
        return out
    try:
        import winreg
        for k, prog in (("word", "Word.Application"), ("excel", "Excel.Application"),
                        ("ppt", "PowerPoint.Application")):
            try:
                winreg.CloseKey(winreg.OpenKey(winreg.HKEY_CLASSES_ROOT, prog + "\\CLSID"))
                out[k] = True
            except OSError:
                pass
    except Exception:
        pass
    return out


def find_soffice():
    """The LibreOffice program, when it is on this computer."""
    cands = [r"C:\Program Files\LibreOffice\program\soffice.exe",
             r"C:\Program Files (x86)\LibreOffice\program\soffice.exe",
             "/Applications/LibreOffice.app/Contents/MacOS/soffice", shutil.which("soffice") or "",
             shutil.which("libreoffice") or ""]
    return next((c for c in cands if c and os.path.isfile(c)), None)


def office_kind(path):
    ext = os.path.splitext(path)[1].lower()
    return "word" if ext in OFFICE_WORD else "excel" if ext in OFFICE_EXCEL else "ppt" if ext in OFFICE_PPT else None


def office_convert(path, dst, timeout=150, lo_profile=None, use_office=True):
    """Make the exact PDF of a Word / Excel / PowerPoint file - with Microsoft Office (Windows, hidden) or the
    LibreOffice program. Returns (None, "") when it worked, else (why, "no-office" when Office is not there)."""
    import tempfile
    tmp = dst + ".part.pdf"
    errs, flag = [], ""
    kind = office_kind(path)
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    if os.name == "nt" and use_office and kind:
        script = {"word": _PS_WORD, "excel": _PS_EXCEL, "ppt": _PS_PPT}[kind]
        env = dict(os.environ, BL_SRC=os.path.abspath(path), BL_DST=os.path.abspath(tmp))
        try:
            import base64
            enc = base64.b64encode(script.encode("utf-16-le")).decode("ascii")
            r = subprocess.run(["powershell", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass",
                                "-EncodedCommand", enc], env=env, capture_output=True, timeout=timeout,
                               stdin=subprocess.DEVNULL, creationflags=0x08000000 | 0x00004000)
            if os.path.exists(tmp) and os.path.getsize(tmp) > 0:
                os.replace(tmp, dst)
                return None, ""
            err = (r.stderr or b"").decode("utf-8", "replace")
            if re.search(r"80040154|COM class factory|class not registered|Cannot create", err, re.I):
                flag = "no-office"
            errs.append(err.strip().splitlines()[-1][:200] if err.strip() else "Office did not make the PDF")
        except subprocess.TimeoutExpired:
            errs.append("Office took too long")
        except Exception as ex:
            errs.append(str(ex))
        finally:
            try:
                os.remove(tmp)
            except OSError:
                pass
    so = find_soffice()
    if so:
        outdir = tempfile.mkdtemp(prefix="bindlens-lo-")
        try:
            args = [so, "--headless", "--norestore", "--nologo", "--convert-to", "pdf", "--outdir", outdir,
                    os.path.abspath(path)]
            if lo_profile:
                import pathlib
                args.insert(1, "-env:UserInstallation=" + pathlib.Path(os.path.abspath(lo_profile)).as_uri())
            subprocess.run(args, capture_output=True, timeout=timeout,
                           creationflags=0x08000000 if os.name == "nt" else 0)
            out = os.path.join(outdir, os.path.splitext(os.path.basename(path))[0] + ".pdf")
            if os.path.exists(out) and os.path.getsize(out) > 0:
                shutil.move(out, dst)
                return None, ""
            errs.append("LibreOffice did not make the PDF")
        except subprocess.TimeoutExpired:
            errs.append("LibreOffice took too long")
        except Exception as ex:
            errs.append(str(ex))
        finally:
            shutil.rmtree(outdir, ignore_errors=True)
    elif flag == "no-office" or os.name != "nt":
        flag = "none"
    return ("; ".join(errs) or "no Office or LibreOffice on this computer"), flag


def open_stream(fitz, data, path):
    """Open a document from its bytes, whatever its kind (1.9.3: also .csv, .rtf, .odt, .eml … and a card for files
    BindLens can't look inside). Every place that reads a document goes through here."""
    ext = os.path.splitext(path)[1].lower()
    if ext in OFFICE_EXACT:                    # 3.2: the exact copy made by Office / LibreOffice, when there is one
        pp = office_pdf_ready(path)
        if pp:
            try:
                with open(pp, "rb") as fh:
                    return fitz.open(stream=fh.read(), filetype="pdf")
            except Exception:
                pass
    if ext in OUTSIDE:
        return fitz.open(stream=outside_card(fitz, path, len(data) if data else None), filetype="pdf")
    if ext in TEXT_LIKE or ext in CONVERTED:
        try:
            page = other_to_html(data, path)
        except Exception as ex:
            page = (f"<html><body><h1>{_esc(os.path.basename(path))}</h1><p>BindLens could not read this file "
                    f"({_esc(str(ex) or ex.__class__.__name__)}).</p></body></html>")
        return fitz.open(stream=page.encode("utf-8"), filetype="html")
    return fitz.open(stream=data, filetype=OOXML_ALIAS.get(ext) or ext.lstrip("."))


def open_light(fitz, path, data=None):
    """Open a file to look at it: a PDF is read only where needed (its page list, the pages you ask for) -
    a 300 MB scan is not read whole just to count its pages. Closed again right after use."""
    ext = os.path.splitext(path)[1].lower()
    if data is None and ext == ".pdf":
        return fitz.open(path)
    if data is None:
        with open(path, "rb") as fh:
            data = _doc_read(fh, path)
    doc = open_stream(fitz, data, path)
    if doc.is_reflowable:
        doc.layout(width=500, height=700, fontsize=12)
    return doc


# ---------------------------------------------------------------------------
# 1.9.4: the parts of a document (chapters, sections) - from its own bookmarks, from its printed contents page
# (any language: lines that end with a page number), or from its headings (bigger or bold lines).
# ---------------------------------------------------------------------------
_SEC_NUM = re.compile(r"^\s*(\d{1,3}(?:[.\-]\d{1,3}){0,4})[.)]?\s+(?=\S)")
_LEADER = re.compile(r"^[.·•…_\-–—~\s]+$")


def _sec_norm(t):
    """Words of a title for comparing (no accents, no punctuation, no numbering - works in any language)."""
    t = _SEC_NUM.sub("", t or "")
    t = unicodedata.normalize("NFKD", t)
    t = "".join(ch for ch in t if not unicodedata.combining(ch)).lower()
    t = re.sub(r"[\W_]+", " ", t)
    return " ".join(t.split())


def _sec_level_from_number(title):
    m = _SEC_NUM.match(title or "")
    return min(4, len(re.split(r"[.\-]", m.group(1)))) if m else None


def _page_lines(page):
    """The words of a page as visual lines (left to right): [(x0, y0, x1, y1, word), …] per line."""
    words = page.get_text("words")
    words.sort(key=lambda w: ((w[1] + w[3]) / 2, w[0]))
    lines = []
    for w in words:
        yc, h = (w[1] + w[3]) / 2, max(1.0, w[3] - w[1])
        if lines and abs(yc - lines[-1][0]) <= max(2.0, h * 0.45):
            lines[-1][1].append(w)
        else:
            lines.append([yc, [w]])
    return [sorted(ws, key=lambda w: w[0]) for _yc, ws in lines]


def _toc_line(ws, page_w, n_pages):
    """A line of a contents page: 'Title ........ 12' -> (title, 12, x of the title) - or None."""
    if len(ws) < 2:
        return None
    last = ws[-1][4]
    m = re.fullmatch(r"[.·…_]*(\d{1,4})", last)
    if not m:
        return None
    num = int(m.group(1))
    if num < 1 or num > n_pages * 2 + 60 or (1900 <= num <= 2100 and n_pages < 1900):
        return None
    title_ws = list(ws[:-1])
    lead = len(last) > len(m.group(1))
    while title_ws and _LEADER.match(title_ws[-1][4]):
        title_ws.pop()
        lead = True
    if not title_ws:
        return None
    title = " ".join(w[4] for w in title_ws)
    t2 = re.sub(r"[.·…_]{2,}\s*$", "", title).strip()
    lead = lead or t2 != title
    title = t2
    if sum(ch.isalpha() for ch in title) < 2 or len(title) > 160:
        return None
    gap = ws[-1][0] - title_ws[-1][2]
    if not (lead or gap > 14 or ws[-1][2] > page_w * 0.62):
        return None
    return title, num, title_ws[0][0]


def _printed_toc(doc, cancelled=None):
    """The contents page(s) printed in the document, any language, and where each part really starts."""
    n = doc.page_count
    if n < 6:
        return None
    pages = list(range(min(n, 40)))
    if n > 60:
        pages += list(range(max(40, n - 15), n))          # some books have their contents at the end
    found, run = [], []
    for pi in pages:
        if cancelled and cancelled():
            return None
        try:
            page = doc.load_page(pi)
            lines = _page_lines(page)
        except Exception:
            continue
        good = [e for e in (_toc_line(ws, page.rect.width, n) for ws in lines) if e]
        if len(good) >= 4 and len(good) >= 0.3 * max(1, len(lines)):
            nums = [g[1] for g in good]
            up = sum(1 for a, b in zip(nums, nums[1:]) if b >= a)
            if up >= 0.75 * (len(nums) - 1):            # page numbers go up: contents, not an alphabetical index
                minx = min(g[2] for g in good)
                run.append((pi, [(t, num, x - minx) for t, num, x in good]))
                continue
        if run:
            found.append(run)
            run = []
    if run:
        found.append(run)
    if not found:
        return None
    best = max(found, key=lambda r: sum(len(p[1]) for p in r))
    toc_end = best[-1][0]
    raw = [e for _pi, es in best for e in es]
    if len(raw) < 3:
        return None
    # levels: from the numbering (2.3.1) or else from how far the line is indented
    steps = sorted({round(x / 6) for _t, _n, x in raw})
    items = []
    for t, num, x in raw:
        lvl = _sec_level_from_number(t) or min(3, steps.index(round(x / 6)) + 1)
        items.append({"t": t, "num": num, "lvl": lvl, "key": _sec_norm(t)[:40]})
    # which page of the file is printed page 12? Find where the titles really are.
    cache = {}

    def text(pi):
        if pi not in cache:
            try:
                cache[pi] = _sec_norm(doc.load_page(pi).get_text())
            except Exception:
                cache[pi] = ""
        return cache[pi]

    def has(pi, e):
        return 0 <= pi < n and len(e["key"]) >= 4 and e["key"] in text(pi)
    offset = None
    try:
        if doc.get_page_labels():                          # the file knows its printed page numbers
            hits = 0
            for e in items[:6]:
                p_ = doc.get_page_numbers(str(e["num"]))
                if p_ and has(p_[0], e):
                    hits += 1
            if hits >= 2:
                offset = "labels"
    except Exception:
        pass
    if offset is None:
        probes = [e for e in items if len(e["key"]) >= 5][:4]
        cands = []
        for e in probes:
            for pi in range(toc_end + 1, min(n, toc_end + 1 + 140)):
                if cancelled and cancelled():
                    return None
                if has(pi, e):
                    cands.append(pi - (e["num"] - 1))
                    break
        if cands:
            sample = [e for e in items if len(e["key"]) >= 5]
            sample = sample[::max(1, len(sample) // 8)][:9]
            offset = max(set(cands), key=lambda o: (sum(1 for e in sample if has(e["num"] - 1 + o, e)),
                                                    cands.count(o)))
        else:
            offset = 0 if max(e["num"] for e in items) <= n else None
    if offset is None:
        return None
    out = []
    for k, e in enumerate(items):
        if offset == "labels":
            p_ = doc.get_page_numbers(str(e["num"]))
            pi = p_[0] if p_ else e["num"] - 1
        else:
            pi = e["num"] - 1 + offset
            if k < 300 and not has(pi, e):                  # a page or two off: look next to it
                for d_ in (1, -1, 2, -2):
                    if has(pi + d_, e):
                        pi += d_
                        break
        out.append([e["lvl"], e["t"], max(0, min(n - 1, pi)), None])
    return out


def _heading_sections(doc, cancelled=None):
    """No bookmarks and no contents page: the headings - lines clearly bigger than the text, or short bold lines
    that start a paragraph. Lines repeated on many pages (running heads) are left out."""
    n = doc.page_count
    if n < 3 or n > 600:
        return None
    sizes, lines = Counter(), []
    for pi in range(n):
        if cancelled and cancelled():
            return None
        try:
            page = doc.load_page(pi)
            H = page.rect.height or 1
            d = page.get_text("dict", flags=0)
        except Exception:
            continue
        for b in d.get("blocks", []):
            if b.get("type", 0) != 0:
                continue
            bl = b.get("lines", [])
            for li, l in enumerate(bl):
                spans = [sp for sp in l.get("spans", []) if sp["text"].strip()]
                if not spans:
                    continue
                txt = " ".join(sp["text"].strip() for sp in spans)
                for sp in spans:
                    sizes[round(sp["size"])] += len(sp["text"].strip())
                size = max(sp["size"] for sp in spans)
                bold = all((sp["flags"] & 16) or "bold" in sp["font"].lower() or "black" in sp["font"].lower()
                           for sp in spans)
                lines.append((pi, l["bbox"][1] / H, txt, size, bold, li == 0, len(bl)))
    if not sizes:
        return None
    body = sizes.most_common(1)[0][0]
    cands = []
    for pi, yr, txt, size, bold, first, nl in lines:
        t = txt.strip()
        if not (3 <= len(t) <= 90) or sum(ch.isalpha() for ch in t) < 3 or not (0.035 < yr < 0.94):
            continue
        if size >= body * 1.25 or (bold and size >= body * 1.02 and first and nl <= 3 and len(t) <= 70 and
                                   not t.endswith((".", ",", ";", ":"))):
            if cands and cands[-1][0] == pi and abs(cands[-1][3] - size) < 0.6 and 0 < yr - cands[-1][5] < 0.045 \
                    and len(cands[-1][2]) + len(t) < 110:
                cands[-1][2] += " " + t                    # a heading on two lines
                cands[-1][5] = yr
                continue
            cands.append([pi, yr, t, size, bold, yr])
    many = Counter(_sec_norm(c[2]) for c in cands)
    cands = [c for c in cands if many[_sec_norm(c[2])] <= max(2, n * 0.12) and _sec_norm(c[2])]
    if len(cands) < 2:
        return None
    big = sorted({round(c[3] * 2) / 2 for c in cands if c[3] >= body * 1.25}, reverse=True)
    out = []
    for pi, yr, t, size, bold, _y2 in cands:
        r = round(size * 2) / 2
        lvl = _sec_level_from_number(t) or ((big.index(r) + 1) if r in big else len(big) + 1)
        out.append([min(4, lvl), t, pi, max(0.0, yr - 0.02)])
    lv = sorted({o[0] for o in out})
    out = [[lv.index(o[0]) + 1] + o[1:] for o in out]
    while len(out) > max(40, n * 2) and max(o[0] for o in out) > 1:
        top = max(o[0] for o in out)
        out = [o for o in out if o[0] < top]
    return out if len(out) >= 2 else None


def doc_sections(fitz, doc, cancelled=None):
    """The parts of a document: {"src": "bookmarks" | "contents" | "headings", "items": [[level, title, page,
    y or None], …]} - pages count from 0. An empty list when the document has no clear parts."""
    n = doc.page_count
    items, src = None, None
    try:
        toc = doc.get_toc(simple=True)
    except Exception:
        toc = []
    if toc:
        items = [[max(1, int(lv)), str(t).strip(), int(p) - 1, None] for lv, t, p in toc
                 if str(t).strip() and 1 <= int(p) <= n]
        if len(items) >= 2 or (len(items) == 1 and n >= 20):
            src = "bookmarks"
        else:
            items = None
    if items is None and doc.is_pdf:
        items = _printed_toc(doc, cancelled)
        src = "contents" if items else None
    if items is None:
        items = _heading_sections(doc, cancelled)
        src = "headings" if items else None
    items = items or []
    # long lists: the main parts only
    while len(items) > 400 and max(i[0] for i in items) > 1:
        top = max(i[0] for i in items)
        items = [i for i in items if i[0] < top]
    return {"src": src, "items": items[:600], "n": n}


def _hop_sections(st, msg, cancelled=None, **_):
    doc = open_light(st.fitz, msg["path"])
    try:
        return doc_sections(st.fitz, doc, cancelled)
    finally:
        doc.close()


def page_dims(doc):
    return [(round(max(r.width, 1), 2), round(max(r.height, 1), 2)) for r in (doc.load_page(i).rect
                                                                            for i in range(doc.page_count))]


class _HelperIndex:
    """Inside a helper: the texts BindLens already read (index.json.gz), plus what this job reads."""

    def __init__(self, st, path):
        self.st, self.path, self.data, self.m, self.new = st, path, {}, None, {}

    def refresh(self):
        self.new = {}
        try:
            m = os.path.getmtime(self.path)
            if m != self.m:
                self.data = dict(index_entries(self.path))
                self.m = m
        except Exception:
            pass

    def get(self, key):
        return self.new.get(key) or self.data.get(key)

    def put(self, key, entry):
        self.new[key] = entry

    def read(self, path):
        return read_text_entry(self.st.fitz, path, opener=lambda p: open_light(self.st.fitz, p, data=_read_all(p)))


class _HelperLib:
    norm = staticmethod(lambda p: os.path.normcase(os.path.abspath(p)))


class _NoWriter:
    @staticmethod
    def get(_path):
        return None


class HelperCtx:
    """Stands in for the window inside a helper: the report jobs only need these few things -
    everything else is the window's own code (App methods), run here."""

    def __init__(self, st, index_path):
        self.fitz = st.fitz
        self.lib = _HelperLib()
        self.writer = _NoWriter()
        self.indexer = _HelperIndex(st, index_path)

    def __getattr__(self, name):
        import inspect
        import types
        a = inspect.getattr_static(App, name)
        if isinstance(a, staticmethod):
            return a.__func__
        if isinstance(a, classmethod):
            return types.MethodType(a.__func__, App)
        if callable(a) and not isinstance(a, type):
            return types.MethodType(a, self)
        return a


class _HJob(dict):
    """A report job's 'job' dict inside a helper: 'cancel' asks the window, 'progress' tells it."""

    def __init__(self, progress, cancelled):
        super().__init__(cancel=False, progress="", done=False)
        self._p, self._c, self._t = progress, cancelled, 0.0

    def __getitem__(self, k):
        return self._c() if k == "cancel" else super().__getitem__(k)

    def get(self, k, d=None):
        return self._c() if k == "cancel" else super().get(k, d)

    def __setitem__(self, k, v):
        super().__setitem__(k, v)
        if k == "progress" and time.time() - self._t > 0.25:
            self._t = time.time()
            self._p(v)


class _HelperState:
    def __init__(self, fitz):
        self.fitz = fitz
        self.docs = OrderedDict()           # path -> ((mtime, size), doc): the last few files, kept open
        self.ctx = None

    def open(self, path):
        s = os.stat(path)
        key = (s.st_mtime, s.st_size)
        hit = self.docs.get(path)
        if hit and hit[0] == key:
            self.docs.move_to_end(path)
            return hit[1]
        if hit:
            self._close(path)
        with open(path, "rb") as fh:
            data = _doc_read(fh, path)
        doc = open_stream(self.fitz, data, path)
        if doc.is_reflowable:
            try:
                doc.layout(width=500, height=700, fontsize=12)
            except Exception:
                pass
        self.docs[path] = (key, doc)
        while len(self.docs) > 4:
            self._close(next(iter(self.docs)))
        return doc

    def _close(self, path):
        _k, d = self.docs.pop(path)
        try:
            d.close()
        except Exception:
            pass


def _hop_info(st, msg, **_):
    """Page sizes of a file (and whether it has form fields)."""
    s = os.stat(msg["path"])
    try:
        doc = open_light(st.fitz, msg["path"])
        try:
            out = {"m": s.st_mtime, "s": s.st_size, "p": page_dims(doc), "form": bool(doc.is_pdf and doc.is_form_pdf)}
            if office_pdf_ready(msg["path"]):
                out["o"] = 1
            if msg.get("marks"):                # the marks too, while the file is open
                try:
                    out["marks"] = _marks_of(st.fitz, doc)
                except Exception:
                    pass
        finally:
            doc.close()
        return out
    except Exception as ex:
        return {"m": s.st_mtime, "s": s.st_size, "p": [], "err": str(ex) or ex.__class__.__name__}


def _hop_infos(st, msg, **_):
    """_hop_info for a group of small files: their bytes are read side by side (a slow disk, OneDrive or the
    antivirus make each file wait - not the next one), then each is opened."""
    from concurrent.futures import ThreadPoolExecutor
    fitz = st.fitz

    def rd(p):
        try:
            s = os.stat(p)
            with open(p, "rb") as fh:
                return s, _doc_read(fh, p), None
        except Exception as ex:
            return None, None, ex
    out = []
    with ThreadPoolExecutor(8) as ex:
        for p, (s, data, err) in zip(msg["paths"], ex.map(rd, msg["paths"])):
            if s is None:
                out.append({"err": str(err) or err.__class__.__name__})
                continue
            try:
                doc = open_stream(fitz, data, p)
                if doc.is_reflowable:
                    doc.layout(width=500, height=700, fontsize=12)
                r = {"m": s.st_mtime, "s": s.st_size, "p": page_dims(doc), "form": bool(doc.is_pdf and doc.is_form_pdf)}
                if office_pdf_ready(p):
                    r["o"] = 1
                if msg.get("marks") and doc.is_pdf:
                    try:
                        r["marks"] = _marks_of(fitz, doc)
                    except Exception:
                        pass
                doc.close()
            except Exception as e:
                r = {"m": s.st_mtime, "s": s.st_size, "p": [], "err": str(e) or e.__class__.__name__}
            out.append(r)
    return {"items": out}


def _marks_of(fitz, doc):
    out = added_pages(doc) if doc.is_pdf else []          # (pages BindLens added: shown in the page strip)
    if not doc.is_pdf or (hasattr(doc, "has_annots") and not doc.has_annots()):
        return out
    for pi in range(doc.page_count):
        try:
            if not doc.page_annot_xrefs(pi):
                continue
        except Exception:
            pass
        page = doc.load_page(pi)
        rm = page.rotation_matrix
        for a in page.annots() or []:
            if a.type[1] in SKIP_ANNOTS:
                continue
            try:
                m = mark_dict(fitz, page, a, rm)
            except Exception:
                continue
            m["pi"] = pi
            out.append(m)
    return out


def _hop_marks(st, msg, **_):
    """Every mark (highlight, note, text box, stamp…) in a PDF."""
    path = msg["path"]
    s = os.stat(path)
    doc = open_light(st.fitz, path)
    try:
        return {"m": s.st_mtime, "s": s.st_size, "marks": _marks_of(st.fitz, doc),
                "form": bool(doc.is_pdf and doc.is_form_pdf)}
    finally:
        doc.close()


def _read_all(path):
    # (the whole file in memory: a file read for a long time is not kept open - Windows could not save it)
    with open(path, "rb") as fh:
        return _doc_read(fh, path)


def _hop_text(st, msg, **_):
    return read_text_entry(st.fitz, msg["path"], opener=lambda p: open_light(st.fitz, p, data=_read_all(p)))


def _hop_texts(st, msg, **_):
    """The text of several small files (their bytes read side by side)."""
    from concurrent.futures import ThreadPoolExecutor
    fitz = st.fitz

    def rd(p):
        try:
            with open(p, "rb") as fh:
                return _doc_read(fh, p)
        except Exception:
            return None
    out = []
    with ThreadPoolExecutor(8) as ex:
        for p, data in zip(msg["paths"], ex.map(rd, msg["paths"])):
            if data is None:
                out.append({"mtime": 0, "size": 0, "pages": []})
                continue

            def opener(_p, data=data, p=p):
                d = open_stream(fitz, data, p)
                if d.is_reflowable:
                    d.layout(width=500, height=700, fontsize=12)
                return d
            out.append(read_text_entry(fitz, p, opener=opener))
    return {"items": out}


def search_snippet(words, r, q):
    """A few words around a search hit (words: (x0, y0, x1, y1, word, …) in the same coordinates as r)."""
    for i, w in enumerate(words):
        if w[2] >= r[0] - 1 and w[0] <= r[2] + 1 and w[3] >= r[1] - 1 and w[1] <= r[3] + 1:
            return ("…" if i > 4 else "") + " ".join(x[4] for x in words[max(0, i - 4):i + 8]) + "…"
    return q


def _hop_search(st, msg, **_):
    """Where a word is on the pages of a file (the pages to look at may be given), with a snippet for each."""
    fitz = st.fitz
    doc = open_light(fitz, msg["path"], data=_read_all(msg["path"]))
    q = msg["q"]
    out = []
    try:
        pages = msg.get("pages")
        for pi in (pages if pages is not None else range(doc.page_count)):
            if pi >= doc.page_count:
                continue
            page = doc.load_page(pi)
            m = page.rotation_matrix
            rs = page.search_for(q)
            if not rs:
                rs = fold_search(fitz, page, q)          # 3.0: Sean = Seán, O'Brien = O’Brien
            ocr = None
            if not rs:                                   # 3.2: a scanned page BindLens has read
                rs = []
                ocr = ocr_cached_words(msg["path"], page)
                if ocr:
                    toks = [fold(t_) for t_ in q.split() if t_.strip()]
                    for k_, w_ in enumerate(ocr):
                        if toks and fold(w_[4]).startswith(toks[0]) and all(
                                k_ + j < len(ocr) and fold(ocr[k_ + j][4]).startswith(t_)
                                for j, t_ in enumerate(toks[1:], 1)):
                            ws_ = ocr[k_:k_ + len(toks)]
                            rs.append(fitz.Rect(min(x[0] for x in ws_), min(x[1] for x in ws_),
                                                max(x[2] for x in ws_), max(x[3] for x in ws_)))
            if not rs:
                continue
            words = []
            for x0, y0, x1, y1, word, *_r in (ocr or page.get_text("words")):
                rr = fitz.Rect(x0, y0, x1, y1) * m
                words.append((rr.x0, rr.y0, rr.x1, rr.y1, word))
            hits = []
            for r in rs:
                rr = tuple(r * m)
                hits.append((rr, search_snippet(words, rr, q)))
            out.append((pi, hits))
    finally:
        doc.close()
    return {"pages": out}


def write_report_file(fitz, rep, dst, fmt, accent):
    set_report_theme(accent, rep.get("_logo"))
    if fmt == "pdf":
        write_report_pdf(fitz, rep, dst, accent)
    elif fmt == "docx":
        write_report_docx(rep, dst, accent, fitz=fitz)
    else:
        write_report_xlsx(rep, dst, fitz=fitz)


def _hop_write(st, msg, **_):
    """Write a report (PDF, Word, Excel) to a file."""
    try:
        write_report_file(st.fitz, msg["rep"], msg["dst"], msg["fmt"], msg["accent"])
    except PermissionError:
        return {"perm": True}
    return {"ok": True}


def _hop_render(st, msg, **_):
    """A page as a picture (raw RGB), for the window to show."""
    fitz = st.fitz
    doc = st.open(msg["path"])
    page = doc.load_page(msg["pi"])
    clip = None
    if msg.get("cover"):                    # the top of the first page, w x h (the launcher's cards)
        w, h = msg["cover"]
        z = w / max(1, page.rect.width)
        clip = fitz.Rect(0, 0, page.rect.width, min(page.rect.height, h / z))
    else:
        z = msg["zoom"]
    pix = page.get_pixmap(matrix=fitz.Matrix(z, z), alpha=False, clip=clip)
    if pix.n != 3:
        pix = fitz.Pixmap(fitz.csRGB, pix)
    if msg.get("night") == "warm":                # 3.0: warm paper - easy on the eyes, photos stay photos
        pix.tint_with(0x2A2118, 0xF7EFDD)
    elif msg.get("night"):
        pix.invert_irect(pix.irect)
    w, h = pix.width, pix.height
    if msg.get("save"):                     # 1.9.2: keep a picture of it, so it shows at once next time
        try:
            tmp = msg["save"] + ".tmp"
            pix.save(tmp, output="png")
            os.replace(tmp, msg["save"])
        except Exception:
            pass
    data = pix.samples
    if pix.stride != w * 3:
        data = b"".join(bytes(data[i * pix.stride:i * pix.stride + w * 3]) for i in range(h))
    return {"w": w, "h": h, "rgb": bytes(data)}


# ---------------------------------------------------------------------------
# 1.9.8: printing by BindLens itself. On Windows the pages go straight to the printer through Windows (GDI) -
# no PDF program, no browser. Each page is drawn sharp (up to 300 dpi) by PyMuPDF and placed on the paper with
# the size, copies, sides and colour chosen in BindLens's print window.
# ---------------------------------------------------------------------------
PRINT_DPI = 300
_WINPRINT = {}


def parse_pages(text, n):
    """'1-3, 7, 10-' -> [0, 1, 2, 6, 9, …] (pages counted from 1, in the order written, each once)."""
    out = []
    text = re.sub(r"\s*[-–—]\s*", "-", (text or "").strip())      # 3.0: "1 - 3" is 1-3 (it printed everything)
    for part in re.split(r"[,; ]+", text):
        m = re.fullmatch(r"(\d*)\s*-\s*(\d*)|(\d+)", part)
        if not m or part == "-":
            continue
        if m.group(3):
            a = b = int(m.group(3))
        else:
            a = int(m.group(1) or 1)
            b = int(m.group(2) or n)
        for k in (range(a, b + 1) if a <= b else range(a, b - 1, -1)):
            if 1 <= k <= n and k - 1 not in out:
                out.append(k - 1)
    return out


def print_bitmap(fitz, page, tw, th, rot=False, gray=False, marks=True):
    """A page as a picture for the printer: about tw x th pixels, turned a quarter if rot, as Windows wants it
    (blue-green-red rows, each row a multiple of 4 bytes)."""
    r = page.rect
    pw, ph = (r.height, r.width) if rot else (r.width, r.height)
    z = max(0.05, min(tw / max(1.0, pw), th / max(1.0, ph)))
    m = fitz.Matrix(z, z)
    if rot:
        m = m.prerotate(-90)
    pix = page.get_pixmap(matrix=m, colorspace=fitz.csGRAY if gray else fitz.csRGB, alpha=False, annots=marks)
    if pix.n != 3:
        pix = fitz.Pixmap(fitz.csRGB, pix)
    w, h, st = pix.width, pix.height, pix.stride
    src = pix.samples
    if st != w * 3:
        src = b"".join(bytes(src[i * st:i * st + w * 3]) for i in range(h))
    b = bytearray(src)
    b[0::3] = src[2::3]
    b[2::3] = src[0::3]
    pad = (-(w * 3)) % 4
    if pad:
        row, z_ = w * 3, b"\0" * pad
        b = b"".join(bytes(b[i * row:(i + 1) * row]) + z_ for i in range(h))
    return {"w": w, "h": h, "bgr": bytes(b)}


def _hop_printpage(st, msg, **_):
    """A page drawn for the printer (in a helper, so the window keeps answering)."""
    doc = st.open(msg["path"])
    return print_bitmap(st.fitz, doc.load_page(msg["pi"]), msg["tw"], msg["th"], msg.get("rot"), msg.get("gray"),
                        msg.get("marks", True))


def print_place(pw_pt, ph_pt, paper, scale="fit", pct=100, rot=False):
    """Where a page goes on the paper: (x, y, w, h) in printer pixels, from the corner of the printable area.
    scale: 'fit' (as big as the paper allows), 'actual' (100%) or 'pct' (pct %, centred on the sheet)."""
    wi, hi = ((ph_pt, pw_pt) if rot else (pw_pt, ph_pt))
    wi, hi = wi / 72.0, hi / 72.0
    dpx, dpy = paper["dpx"], paper["dpy"]
    if scale == "fit":
        k = min(paper["aw"] / max(1e-6, wi * dpx), paper["ah"] / max(1e-6, hi * dpy))
        w, h = wi * dpx * k, hi * dpy * k
        x, y = (paper["aw"] - w) / 2, (paper["ah"] - h) / 2
    else:
        k = (pct if scale == "pct" else 100) / 100.0
        w, h = wi * dpx * k, hi * dpy * k
        x, y = (paper["pw"] - w) / 2 - paper["ox"], (paper["ph"] - h) / 2 - paper["oy"]
    return int(round(x)), int(round(y)), max(1, int(round(w))), max(1, int(round(h)))


def print_sheets(items, copies=1, collate=True, duplex=False, by_printer=False):
    """The pages in the order they go to the printer (None = an empty back so the next copy starts on a new sheet)."""
    items = list(items)
    if by_printer or copies <= 1:
        return items
    if collate or duplex:
        one = items + ([None] if duplex and len(items) % 2 else [])
        return one * copies
    return [it for it in items for _ in range(copies)]


def default_paper(landscape=False):
    """A4 at 600 dpi with 4 mm margins - for the preview when the printer can't be asked."""
    pw, ph = 4961, 7016
    if landscape:
        pw, ph = ph, pw
    return {"pw": pw, "ph": ph, "ox": 94, "oy": 94, "aw": pw - 188, "ah": ph - 188, "dpx": 600, "dpy": 600}


def _win_api():
    if _WINPRINT:
        return _WINPRINT
    import ctypes
    from ctypes import wintypes as W
    ws = ctypes.WinDLL("winspool.drv", use_last_error=True)
    gdi = ctypes.WinDLL("gdi32", use_last_error=True)

    class PRINTER_INFO_2(ctypes.Structure):
        _fields_ = [("pServerName", W.LPWSTR), ("pPrinterName", W.LPWSTR), ("pShareName", W.LPWSTR),
                    ("pPortName", W.LPWSTR), ("pDriverName", W.LPWSTR), ("pComment", W.LPWSTR),
                    ("pLocation", W.LPWSTR), ("pDevMode", ctypes.c_void_p), ("pSepFile", W.LPWSTR),
                    ("pPrintProcessor", W.LPWSTR), ("pDatatype", W.LPWSTR), ("pParameters", W.LPWSTR),
                    ("pSecurityDescriptor", ctypes.c_void_p), ("Attributes", W.DWORD), ("Priority", W.DWORD),
                    ("DefaultPriority", W.DWORD), ("StartTime", W.DWORD), ("UntilTime", W.DWORD),
                    ("Status", W.DWORD), ("cJobs", W.DWORD), ("AveragePPM", W.DWORD)]

    class DOCINFOW(ctypes.Structure):
        _fields_ = [("cbSize", ctypes.c_int), ("lpszDocName", W.LPCWSTR), ("lpszOutput", W.LPCWSTR),
                    ("lpszDatatype", W.LPCWSTR), ("fwType", W.DWORD)]

    class BITMAPINFOHEADER(ctypes.Structure):
        _fields_ = [("biSize", W.DWORD), ("biWidth", W.LONG), ("biHeight", W.LONG), ("biPlanes", W.WORD),
                    ("biBitCount", W.WORD), ("biCompression", W.DWORD), ("biSizeImage", W.DWORD),
                    ("biXPelsPerMeter", W.LONG), ("biYPelsPerMeter", W.LONG), ("biClrUsed", W.DWORD),
                    ("biClrImportant", W.DWORD)]
    P = ctypes.POINTER
    ws.EnumPrintersW.argtypes = [W.DWORD, W.LPWSTR, W.DWORD, ctypes.c_void_p, W.DWORD, P(W.DWORD), P(W.DWORD)]
    ws.EnumPrintersW.restype = W.BOOL
    ws.GetDefaultPrinterW.argtypes = [W.LPWSTR, P(W.DWORD)]
    ws.GetDefaultPrinterW.restype = W.BOOL
    ws.OpenPrinterW.argtypes = [W.LPWSTR, P(W.HANDLE), ctypes.c_void_p]
    ws.OpenPrinterW.restype = W.BOOL
    ws.ClosePrinter.argtypes = [W.HANDLE]
    ws.ClosePrinter.restype = W.BOOL
    ws.DocumentPropertiesW.argtypes = [W.HWND, W.HANDLE, W.LPWSTR, ctypes.c_void_p, ctypes.c_void_p, W.DWORD]
    ws.DocumentPropertiesW.restype = W.LONG
    ws.DeviceCapabilitiesW.argtypes = [W.LPCWSTR, W.LPCWSTR, W.WORD, ctypes.c_void_p, ctypes.c_void_p]
    ws.DeviceCapabilitiesW.restype = ctypes.c_int
    gdi.CreateDCW.argtypes = [W.LPCWSTR, W.LPCWSTR, W.LPCWSTR, ctypes.c_void_p]
    gdi.CreateDCW.restype = W.HDC
    gdi.DeleteDC.argtypes = [W.HDC]
    gdi.DeleteDC.restype = W.BOOL
    gdi.GetDeviceCaps.argtypes = [W.HDC, ctypes.c_int]
    gdi.GetDeviceCaps.restype = ctypes.c_int
    gdi.StartDocW.argtypes = [W.HDC, P(DOCINFOW)]
    gdi.StartDocW.restype = ctypes.c_int
    for fn in ("StartPage", "EndPage", "EndDoc", "AbortDoc"):
        getattr(gdi, fn).argtypes = [W.HDC]
        getattr(gdi, fn).restype = ctypes.c_int
    gdi.SetStretchBltMode.argtypes = [W.HDC, ctypes.c_int]
    gdi.SetStretchBltMode.restype = ctypes.c_int
    gdi.SetBrushOrgEx.argtypes = [W.HDC, ctypes.c_int, ctypes.c_int, ctypes.c_void_p]
    gdi.SetBrushOrgEx.restype = W.BOOL
    gdi.StretchDIBits.argtypes = [W.HDC] + [ctypes.c_int] * 8 + [ctypes.c_void_p, ctypes.c_void_p, W.UINT, W.DWORD]
    gdi.StretchDIBits.restype = ctypes.c_int
    _WINPRINT.update(ct=ctypes, W=W, ws=ws, gdi=gdi, PI2=PRINTER_INFO_2, DOCINFOW=DOCINFOW, BIH=BITMAPINFOHEADER)
    return _WINPRINT


def win_printers():
    """[(printer name, port)] and the default printer's name."""
    api = _win_api()
    ct, W, ws = api["ct"], api["W"], api["ws"]
    need, ret = W.DWORD(0), W.DWORD(0)
    flags = 0x2 | 0x4                                   # this computer's printers + network printers
    ws.EnumPrintersW(flags, None, 2, None, 0, ct.byref(need), ct.byref(ret))
    out = []
    if need.value:
        buf = ct.create_string_buffer(need.value)
        if ws.EnumPrintersW(flags, None, 2, buf, need, ct.byref(need), ct.byref(ret)):
            arr = ct.cast(buf, ct.POINTER(api["PI2"]))
            out = [(arr[i].pPrinterName or "", arr[i].pPortName or "") for i in range(ret.value)]
    n = W.DWORD(0)
    ws.GetDefaultPrinterW(None, ct.byref(n))
    default = ""
    if n.value:
        b2 = ct.create_unicode_buffer(n.value)
        if ws.GetDefaultPrinterW(b2, ct.byref(n)):
            default = b2.value
    return [p for p in out if p[0]], default


def win_devmode(name, base=None, prompt_hwnd=None):
    """The printer's settings (DEVMODE bytes). prompt_hwnd: show the printer's own settings window first
    (None back = the person pressed Cancel)."""
    api = _win_api()
    ct, W, ws = api["ct"], api["W"], api["ws"]
    h = W.HANDLE()
    if not ws.OpenPrinterW(name, ct.byref(h), None):
        return None
    try:
        size = ws.DocumentPropertiesW(None, h, name, None, None, 0)
        if size <= 0:
            return None
        out = ct.create_string_buffer(size)
        mode, inp = 2, None                                  # DM_OUT_BUFFER
        if base is not None and len(base) == size:
            inp = ct.create_string_buffer(bytes(base), size)
            mode |= 8                                        # DM_IN_BUFFER
        if prompt_hwnd is not None:
            mode |= 4                                        # DM_IN_PROMPT
        r = ws.DocumentPropertiesW(prompt_hwnd or None, h, name, out, inp, mode)
        if r < 0 or (prompt_hwnd is not None and r != 1):
            return None
        return bytearray(out.raw)
    finally:
        ws.ClosePrinter(h)


def win_caps(name, port=""):
    api = _win_api()
    dc = lambda cap: api["ws"].DeviceCapabilitiesW(name, port or None, cap, None, None)
    try:
        return {"duplex": dc(7) == 1, "color": dc(32) == 1, "copies": max(1, dc(18)), "collate": dc(22) == 1}
    except Exception:
        return {"duplex": False, "color": True, "copies": 1, "collate": False}


def dm_get(dm, key):
    import struct
    off = {"orient": 76, "copies": 86, "color": 92, "duplex": 94, "collate": 100}[key]
    return struct.unpack_from("<h", dm, off)[0]


def dm_set(dm, orient=None, copies=None, color=None, duplex=None, collate=None):
    """Write choices into DEVMODE bytes (and say which ones are set)."""
    import struct
    if dm is None or len(dm) < 104:
        return dm
    fields = struct.unpack_from("<I", dm, 72)[0]
    for val, off, flag in ((orient, 76, 0x1), (copies, 86, 0x100), (color, 92, 0x800), (duplex, 94, 0x1000),
                           (None if collate is None else (1 if collate else 0), 100, 0x8000)):
        if val is not None:
            struct.pack_into("<h", dm, off, int(val))
            fields |= flag
    struct.pack_into("<I", dm, 72, fields)
    return dm


def win_paper(name, dm=None):
    """The paper as the printer sees it: sizes in printer pixels, the printable area and the dpi."""
    api = _win_api()
    ct, gdi = api["ct"], api["gdi"]
    buf = ct.create_string_buffer(bytes(dm), len(dm)) if dm else None
    hdc = gdi.CreateDCW("WINSPOOL", name, None, buf)
    if not hdc:
        return None
    try:
        g = lambda i: gdi.GetDeviceCaps(hdc, i)
        p = {"aw": g(8), "ah": g(10), "dpx": g(88), "dpy": g(90), "pw": g(110), "ph": g(111), "ox": g(112),
             "oy": g(113)}
        return p if p["aw"] > 0 and p["dpx"] > 0 else None
    finally:
        gdi.DeleteDC(hdc)


class WinPrintJob:
    """One print job on a Windows printer: start(), then page(bitmap, x, y, w, h) per sheet, then end()."""

    def __init__(self, name, dm, title):
        api = self.api = _win_api()
        ct, gdi = api["ct"], api["gdi"]
        self._dm = ct.create_string_buffer(bytes(dm), len(dm)) if dm else None
        self.hdc = gdi.CreateDCW("WINSPOOL", name, None, self._dm)
        if not self.hdc:
            raise OSError(f"The printer “{name}” could not be opened.")
        g = lambda i: gdi.GetDeviceCaps(self.hdc, i)
        self.paper = {"aw": g(8), "ah": g(10), "dpx": g(88), "dpy": g(90), "pw": g(110), "ph": g(111),
                      "ox": g(112), "oy": g(113)}
        di = api["DOCINFOW"](ct.sizeof(api["DOCINFOW"]), (title or "BindLens")[:120], None, None, 0)
        self._di = di
        if gdi.StartDocW(self.hdc, ct.byref(di)) <= 0:
            err = ct.get_last_error()
            gdi.DeleteDC(self.hdc)
            self.hdc = None
            if err == 1223:                                 # the person cancelled (e.g. "Save print output as")
                raise InterruptedError()
            raise OSError(f"The printer did not start the job (Windows error {err}).")
        gdi.SetStretchBltMode(self.hdc, 4)                   # HALFTONE: smooth when the picture is made smaller
        gdi.SetBrushOrgEx(self.hdc, 0, 0, None)

    def sheet(self, bmp=None, x=0, y=0, w=0, h=0):
        api = self.api
        ct, gdi = api["ct"], api["gdi"]
        if gdi.StartPage(self.hdc) <= 0:
            raise OSError("The printer stopped (could not start a page).")
        if bmp:
            bw, bh, data = bmp["w"], bmp["h"], bmp["bgr"]
            row = bw * 3 + ((-(bw * 3)) % 4)
            band = max(1, min(bh, (8 * 1024 * 1024) // max(1, row)))       # in strips: every driver copes
            bih = api["BIH"]()
            bih.biSize, bih.biWidth, bih.biPlanes, bih.biBitCount, bih.biCompression = ct.sizeof(bih), bw, 1, 24, 0
            r0 = 0
            while r0 < bh:
                r1 = min(bh, r0 + band)
                bih.biHeight = -(r1 - r0)                     # top-down rows
                part = data[r0 * row:r1 * row]
                chunk = (ct.c_ubyte * len(part)).from_buffer_copy(part)
                y0 = y + int(round(h * r0 / bh))
                y1 = y + int(round(h * r1 / bh))
                gdi.StretchDIBits(self.hdc, x, y0, w, max(1, y1 - y0), 0, 0, bw, r1 - r0, chunk, ct.byref(bih),
                                  0, 0x00CC0020)
                r0 = r1
        if gdi.EndPage(self.hdc) <= 0:
            raise OSError("The printer stopped (could not finish a page).")

    def end(self, abort=False):
        gdi = self.api["gdi"]
        if self.hdc:
            (gdi.AbortDoc if abort else gdi.EndDoc)(self.hdc)
            gdi.DeleteDC(self.hdc)
            self.hdc = None


def lp_printers():
    """Mac / Linux: [(printer, '')] and the default one (CUPS)."""
    out, default = [], ""
    try:
        r = subprocess.run(["lpstat", "-a"], capture_output=True, text=True, timeout=5)
        out = [(ln.split()[0], "") for ln in r.stdout.splitlines() if ln.strip()]
        r2 = subprocess.run(["lpstat", "-d"], capture_output=True, text=True, timeout=5)
        if ":" in r2.stdout:
            default = r2.stdout.split(":", 1)[1].strip()
    except Exception:
        pass
    return out, default


def _hop_call(st, msg, progress=None, cancelled=None):
    """Run one of the window's report jobs here (with the texts BindLens already read)."""
    if st.ctx is None:
        st.ctx = HelperCtx(st, msg["index"])
    st.ctx.indexer.path = msg["index"]
    st.ctx.indexer.refresh()
    job = _HJob(progress or (lambda t: None), cancelled or (lambda: False))
    args = [job if a == "__job__" else a for a in msg.get("args", [])]
    res = getattr(st.ctx, msg["fn"])(*args)
    return {"result": res, "texts": st.ctx.indexer.new, "progress": job.get("progress", "")}


HELPER_OPS = {"info": _hop_info, "infos": _hop_infos, "marks": _hop_marks, "text": _hop_text, "texts": _hop_texts,
              "search": _hop_search, "write": _hop_write, "render": _hop_render, "call": _hop_call,
              "sections": _hop_sections, "printpage": _hop_printpage,
              "ocr": lambda st, msg, **kw: _hop_ocr(st, msg, **kw),
              "ping": lambda st, msg, **_: {"pong": os.getpid()}}


def helper_main():
    """The helper process: read requests from the window, answer them, one at a time."""
    rd = os.fdopen(os.dup(0), "rb")
    wr = os.fdopen(os.dup(1), "wb")
    try:                                      # nothing else may write on the line to the window
        null = os.open(os.devnull, os.O_RDWR)
        os.dup2(null, 1)
        os.dup2(null, 2)
        sys.stdout = sys.stderr = open(os.devnull, "w")
    except Exception:
        pass
    import pymupdf as fitz
    agpl_producer(fitz)
    try:
        fitz.TOOLS.mupdf_display_errors(False)
        fitz.TOOLS.mupdf_display_warnings(False)
    except Exception:
        pass
    globals()["_FITZ"] = fitz
    st = _HelperState(fitz)
    jobs, cancels, wlock = queue.Queue(), set(), threading.Lock()

    def send(obj):
        with wlock:
            _hsend(wr, obj)

    def reader():
        while True:
            try:
                msg = _hrecv(rd)
            except Exception:
                msg = None
            if msg is None:                   # the window closed: stop at once
                os._exit(0)
            if msg.get("op") == "cancel":
                cancels.add(msg["id"])
            else:
                jobs.put(msg)
    threading.Thread(target=reader, daemon=True).start()
    send({"ready": os.getpid()})
    while True:
        msg = jobs.get()
        jid = msg.get("id")
        if jid in cancels:
            send({"id": jid, "cancelled": True})
            continue
        try:
            res = HELPER_OPS[msg["op"]](st, msg, progress=lambda t, jid=jid: send({"id": jid, "progress": t}),
                                        cancelled=lambda jid=jid: jid in cancels)
        except Exception as ex:
            res = {"err": str(ex) or ex.__class__.__name__}
        res["id"] = jid
        try:
            send(res)
        except Exception:
            os._exit(0)


class HelperJob:
    __slots__ = ("id", "op", "args", "prio", "cb", "ui", "cancel_fn", "timeout", "result", "event", "progress",
                 "cancelled_flag", "tries")

    def cancelled(self):
        if self.cancelled_flag:
            return True
        try:
            return bool(self.cancel_fn and self.cancel_fn())
        except Exception:
            return False

    def cancel(self):
        self.cancelled_flag = True


class HelperPool:
    """A few helper processes. The first one only does what you are waiting for (opening a book, showing
    pages); the others also read in the background (search index, reports, the Reports badge)."""
    INTERACTIVE = 5                      # priorities below this: you are waiting for it

    def __init__(self, n=None):
        import heapq
        import itertools
        self._heapq = heapq
        self._seq = itertools.count(1)
        cpu = os.cpu_count() or 2
        self.n = n or (4 if cpu >= 6 else 3 if cpu >= 4 else 2)
        self.cv = threading.Condition()
        self.fast, self.slow = [], []      # heaps of (prio, seq, job)
        self.ui_q = queue.Queue()
        self.disabled = os.environ.get("BINDLENS_NO_HELPER") == "1"
        self.fails = 0
        self.closed = False
        self.busy = 0
        self.started = False
        self.hold = None                   # set by the window: True while you are waiting for something

    def start(self):
        if self.started or self.disabled:
            return
        self.started = True
        for i in range(self.n):
            threading.Thread(target=self._run, args=(i,), daemon=True).start()

    # ---- the window's side -------------------------------------------------------------------------
    def submit(self, op, prio=5, cb=None, ui=True, cancel=None, timeout=300, **args):
        j = HelperJob()
        j.id, j.op, j.args, j.prio, j.cb, j.ui = next(self._seq), op, args, prio, cb, ui
        j.cancel_fn, j.timeout, j.result, j.event, j.progress = cancel, timeout, None, threading.Event(), ""
        j.cancelled_flag, j.tries = False, 0
        if self.disabled:
            self._finish(j, {"fallback": True})
            return j
        self.start()
        with self.cv:
            self._heapq.heappush(self.fast if prio < self.INTERACTIVE else self.slow, (prio, j.id, j))
            self.cv.notify_all()
        return j

    def call(self, op, prio=8, timeout=600, **args):
        """From a background thread: wait for the answer."""
        j = self.submit(op, prio=prio, ui=False, timeout=timeout, **args)
        j.event.wait()
        return j.result

    def pending(self):
        with self.cv:
            return len(self.fast) + len(self.slow) + self.busy

    def pump(self, budget=0.03):
        """In the window's thread: hand the answers to whoever asked (a few milliseconds at a time)."""
        t0 = time.time()
        n = 0
        while time.time() - t0 < budget:
            try:
                cb, res = self.ui_q.get_nowait()
            except queue.Empty:
                break
            n += 1
            try:
                cb(res)
            except Exception:
                import traceback
                _log("helper callback: " + traceback.format_exc()[-800:])
        return n

    # ---- the helpers' side --------------------------------------------------------------------------
    def _take(self, slot):
        with self.cv:
            while True:
                if self.closed:
                    return None
                if self.fast:
                    return self._heapq.heappop(self.fast)[2]
                if slot > 0 and self.slow and not self._held():
                    return self._heapq.heappop(self.slow)[2]
                self.cv.wait(0.5)

    def _held(self):
        """Background reading waits while a book is being opened (the disk is yours first)."""
        try:
            return bool(self.hold and self.hold())
        except Exception:
            return False

    def _finish(self, j, res):
        j.result = res
        j.event.set()
        if j.cb is not None:
            if j.ui:
                self.ui_q.put((j.cb, res))
            else:
                try:
                    j.cb(res)
                except Exception:
                    pass

    def _spawn(self, slot):
        if getattr(sys, "frozen", False):
            cmd = [sys.executable, HELPER_ARG]
        else:
            exe = sys.executable
            if os.name == "nt" and exe.lower().endswith("python.exe"):
                w = exe[:-10] + "pythonw.exe"
                if os.path.exists(w):
                    exe = w
            # loaded as a module, so Python keeps it ready-compiled (__pycache__): the helpers start in a blink
            boot = ("import sys,importlib.machinery as m,importlib.util as u;p=sys.argv[1];"
                    "ld=m.SourceFileLoader('bindlens_helper',p);sp=u.spec_from_loader('bindlens_helper',ld);"
                    "mod=u.module_from_spec(sp);sys.modules['bindlens_helper']=mod;ld.exec_module(mod);"
                    "mod.helper_main()")
            cmd = [exe, "-c", boot, os.path.abspath(__file__), HELPER_ARG]
        flags = 0
        if os.name == "nt":
            flags = 0x08000000 | (0x00004000 if slot > 0 else 0)     # no window; the background ones: lower priority
        p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             creationflags=flags, cwd=APP_DIR)
        if os.name != "nt" and slot > 0:
            try:
                os.setpriority(os.PRIO_PROCESS, p.pid, 10)
            except Exception:
                pass
        q = queue.Queue()

        def reader():
            while True:
                try:
                    m = _hrecv(p.stdout)
                except Exception:
                    m = None
                q.put(m)
                if m is None:
                    return
        threading.Thread(target=reader, daemon=True).start()
        try:
            m = q.get(timeout=90)
        except queue.Empty:
            m = None
        if not m or "ready" not in m:
            self._kill(p)
            raise RuntimeError("the helper did not start")
        p._q = q
        return p

    @staticmethod
    def _kill(p):
        try:
            p.kill()
        except Exception:
            pass

    def _run(self, slot):
        proc = None
        while True:
            j = self._take(slot)
            if j is None:
                return
            if j.cancelled():
                self._finish(j, {"cancelled": True})
                continue
            if self.disabled:
                self._finish(j, {"fallback": True})
                continue
            if proc is None or proc.poll() is not None:
                try:
                    proc = self._spawn(slot)
                    self.fails = 0
                except Exception as ex:
                    proc = None
                    self.fails += 1
                    _log(f"helper: could not start ({ex})")
                    if self.fails >= 3:
                        self.disabled = True       # read in the window's process, as before
                    self._finish(j, {"fallback": True})
                    continue
            with self.cv:
                self.busy += 1
            try:
                res, proc = self._do(proc, j)
            finally:
                with self.cv:
                    self.busy -= 1
            if res is None:                        # the helper stopped (a damaged file?): once more, in a new one
                j.tries += 1
                if j.tries < 2:
                    with self.cv:
                        self._heapq.heappush(self.fast if j.prio < self.INTERACTIVE else self.slow, (j.prio, j.id, j))
                        self.cv.notify_all()
                    continue
                res = {"err": "BindLens could not read this file (it may be damaged)."}
            self._finish(j, res)

    def _do(self, proc, j):
        msg = dict(j.args)
        msg["op"], msg["id"] = j.op, j.id
        try:
            _hsend(proc.stdin, msg)
        except Exception:
            self._kill(proc)
            return None, None
        deadline = time.time() + j.timeout
        cancel_at = None
        while True:
            try:
                m = proc._q.get(timeout=0.2)
            except queue.Empty:
                now = time.time()
                if cancel_at is None and j.cancelled():
                    try:
                        _hsend(proc.stdin, {"op": "cancel", "id": j.id})
                    except Exception:
                        pass
                    cancel_at = now
                if now > deadline or (cancel_at is not None and now - cancel_at > 8):
                    self._kill(proc)                # stuck: a new helper takes over
                    return ({"cancelled": True} if cancel_at is not None else
                            {"err": "This file takes too long to read."}), None
                continue
            if m is None:
                self._kill(proc)
                return None, None
            if m.get("id") != j.id:
                continue
            if "progress" in m and len(m) == 2:
                j.progress = m["progress"]
                continue
            return m, proc


class Book:
    """A book = the files of one folder (or part of it), read as one continuous document.
    Files are opened only when needed (and closed again), and page sizes are remembered,
    so even big folders open at once."""
    MAX_OPEN = 12

    def __init__(self, fitz, library, folder, prefix="", writer=None, sizes=None, stats=None):
        self.fitz = fitz
        self.lib = library
        self.folder = folder
        self.prefix = prefix
        self.writer = writer
        self.sizes = sizes if sizes is not None else {}
        self.keep = set()          # files that must stay open (unsaved changes)
        self.disk = {}             # 3.0: path -> (date, size) when the file was read from the disk
        self._open = OrderedDict()
        self.files = []   # dicts: rel, path, doc, first, count, error, pdf
        self.pages = []   # (file_idx, page_idx, width, height) display points
        for rel in library.folders.get(folder, []):
            if prefix and not rel.startswith(prefix):
                continue
            path = library.file_path(folder, rel)
            entry = {"rel": rel, "path": path, "doc": None, "first": len(self.pages), "count": 0,
                     "error": None, "pdf": is_pdf(path), "key": library.norm(path)}
            fi = len(self.files)
            self.files.append(entry)
            try:
                st = (stats or {}).get(path) or os.stat(path)
                c = self.sizes.get(entry["key"])
                exact = bool(office_pdf_ready(path)) if os.path.splitext(path)[1].lower() in OFFICE_EXACT else False
                if c and c.get("m") == st.st_mtime and c.get("s") == st.st_size and bool(c.get("o")) == exact:
                    if c.get("err"):
                        entry["error"] = c["err"]
                        continue
                    dims = c["p"]
                    entry["form"] = bool(c.get("f"))
                else:
                    doc = self.doc(fi)
                    dims = []
                    for i in range(doc.page_count):
                        r = doc.load_page(i).rect
                        dims.append((round(max(r.width, 1), 2), round(max(r.height, 1), 2)))
                    self.sizes[entry["key"]] = {"m": st.st_mtime, "s": st.st_size, "p": dims}
                    if exact:
                        self.sizes[entry["key"]]["o"] = 1
                    self.sizes_changed = True
                for i, (w, h) in enumerate(dims):
                    self.pages.append((fi, i, w, h))
                entry["count"] = len(dims)
            except Exception as e:
                entry["error"] = str(e) or e.__class__.__name__

    sizes_changed = False

    _pf_lock = threading.Lock()

    def prefetch(self, fi):
        """Read a file's bytes in the background (a thread: reading a disk doesn't hold the window up),
        so opening it here later - when you click on it - is instant."""
        f = self.files[fi]
        pf = self.__dict__.setdefault("_pf", OrderedDict())
        if f["doc"] is not None or f["path"] in pf:
            return
        pf[f["path"]] = None

        def work(path=f["path"]):
            try:
                st = os.stat(path)
                if st.st_size > 600 * 1024 * 1024 and not is_video(path):
                    raise ValueError("too big to keep in memory")
                with open(path, "rb") as fh:
                    data = _doc_read(fh, path)
                with self._pf_lock:
                    pf[path] = (st.st_mtime, st.st_size, data)
                    while len(pf) > 4 or sum(len(v[2]) for v in pf.values() if v) > 300 * 1024 * 1024:
                        pf.popitem(last=False)
            except Exception:
                with self._pf_lock:
                    pf.pop(path, None)
        threading.Thread(target=work, daemon=True).start()

    def _prefetched(self, path):
        pf = self.__dict__.get("_pf")
        if not pf:
            return None
        with self._pf_lock:
            hit = pf.pop(path, None)
        if not hit:
            return None
        try:
            st = os.stat(path)
            if (st.st_mtime, st.st_size) == hit[:2]:
                return hit[2]
        except Exception:
            pass
        return None

    def open_doc(self, path):
        # read into memory: the file is never kept open, so Windows/OneDrive can move, rename or sync it
        data = self.writer.get(path) if self.writer else None
        from_disk = data is None
        if data is None:
            try:
                st = os.stat(path)
                self.disk[path] = (st.st_mtime, st.st_size)       # 3.0: to notice changes made elsewhere
            except OSError:
                pass
            data = self._prefetched(path)
        if data is None:
            with open(path, "rb") as fh:
                data = _doc_read(fh, path)
        self._last_fp = None
        if path.lower().endswith(".pdf"):                      # 3.2: what the file starts with (quick saving)
            try:
                self._last_fp = _fp(data)
                if from_disk and self.writer and hasattr(self.writer, "note_disk"):
                    self.writer.note_disk(path, self._last_fp)
            except Exception:
                self._last_fp = None
        doc = open_stream(self.fitz, data, path)
        if doc.is_reflowable:
            try:
                doc.layout(width=500, height=700, fontsize=12)
            except Exception:
                pass
        return doc

    def doc(self, fi):
        f = self.files[fi]
        if f["doc"] is None:
            f["doc"] = self.open_doc(f["path"])
            f["base_fp"] = getattr(self, "_last_fp", None)
        self._open[fi] = True
        self._open.move_to_end(fi)
        while len(self._open) > self.MAX_OPEN:
            old = next((k for k in self._open if k != fi and k not in self.keep), None)
            if old is None:
                break
            del self._open[old]
            try:
                self.files[old]["doc"].close()
            except Exception:
                pass
            self.files[old]["doc"] = None
        return f["doc"]

    def reopen(self, fi, data=None):
        f = self.files[fi]
        try:
            if f["doc"]:
                f["doc"].close()
        except Exception:
            pass
        f["doc"] = None
        if data is not None:
            f["doc"] = self.fitz.open(stream=data, filetype="pdf")
            try:
                f["base_fp"] = _fp(data)
            except Exception:
                f["base_fp"] = None
            self._open[fi] = True
        else:
            self.doc(fi)
        self.update_size(fi)

    def update_size(self, fi):
        f = self.files[fi]
        try:
            st = os.stat(f["path"])
            c = self.sizes.get(f["key"])
            if c:
                c["m"], c["s"] = st.st_mtime, st.st_size
                self.sizes_changed = True
        except Exception:
            pass

    @property
    def total(self):
        return len(self.pages)

    def max_width(self):
        return max((p[2] for p in self.pages), default=595)

    def max_height(self):
        return max((p[3] for p in self.pages), default=842)

    def page(self, g):
        fi, pi, _, _ = self.pages[g]
        return self.doc(fi).load_page(pi)

    def close(self):
        for f in self.files:
            try:
                if f["doc"]:
                    f["doc"].close()
            except Exception:
                pass
            f["doc"] = None
        self._open.clear()


MARKUP = {"Highlight", "Underline", "StrikeOut", "Squiggly"}
SKIP_ANNOTS = {"Link", "Widget", "Popup"}
KIND_LABEL = {"Highlight": "Highlight", "Underline": "Underline", "StrikeOut": "Strikethrough",
              "Squiggly": "Squiggle", "Ink": "Drawing", "FreeText": "Text", "Text": "Note",
              "Line": "Line", "Square": "Box", "Circle": "Circle"}


def mark_label(kind, card=None):
    if card:
        return {"note": "Sticky note", "box": "Text", "stamp": "Stamp", "sign": "Signature", "image": "Picture",
                "watermark": "Watermark"}.get(card.get("kind"), "Stamp")
    return KIND_LABEL.get(kind, kind)


def annot_color(a):
    try:
        c = a.colors.get("stroke") or a.colors.get("fill")
        if a.type[1] == "FreeText":
            m = re.search(r"(#[0-9a-fA-F]{6})", a.info.get("subject", "") + " " + str(getattr(a, "rich_contents", "") or ""))
            if m:
                return m.group(1).upper()
        return rgb01_to_hex(c) if c else None
    except Exception:
        return None


def annot_rects(a):
    """Rectangles (page coordinates) that make up an annotation."""
    if a.type[1] in MARKUP:
        v = a.vertices or []
        rects = []
        for i in range(0, len(v) - 3, 4):
            pts = v[i:i + 4]
            xs = [p[0] for p in pts]
            ys = [p[1] for p in pts]
            rects.append((min(xs), min(ys), max(xs), max(ys)))
        if rects:
            return rects
    r = a.rect
    return [(r.x0, r.y0, r.x1, r.y1)]


def mark_dict(fitz, page, a, rm):
    """What the window needs to know about one mark (without its place in the book: g, fi)."""
    t = a.type[1]
    rects = [tuple(fitz.Rect(r) * rm) for r in annot_rects(a)]
    xs0 = min(r[0] for r in rects); ys0 = min(r[1] for r in rects)
    xs1 = max(r[2] for r in rects); ys1 = max(r[3] for r in rects)
    meta = annot_meta(a)
    card = meta.get("card") if t == "Stamp" else None
    note = meta_text(meta).strip()
    cover = meta.get("cover")
    return {"xref": a.xref, "kind": t, "color": (card or {}).get("color") or annot_color(a),
            "card": card, "label": {"box": "White box", "brush": "White brush", "edit": "Changed text"}.get(cover) or
            mark_label(t, card),
            "cover": cover,
            "rects": rects, "bbox": (xs0, ys0, xs1, ys1),
            "text": annot_text(page, a) if t in MARKUP else note, "note": note}


def annot_text(page, a):
    t = a.type[1]
    if t in MARKUP:
        parts = []
        for r in annot_rects(a):
            try:
                parts.append(page.get_textbox((r[0], r[1] + 1, r[2], r[3] - 1)).strip())
            except Exception:
                pass
        return " ".join(p for p in parts if p).replace("\n", " ")
    return meta_text(annot_meta(a)).strip()


