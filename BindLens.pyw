def _misc_destroy_safe(self):
    """Tk's own clean-up stops half-way when one of a widget's callbacks was already removed - the
    widget (a toolbar, a window) then stays on screen. Removing a callback twice is harmless here."""
    if self._tclCommands is not None:
        for name in self._tclCommands:
            try:
                self.tk.deletecommand(name)
            except tk.TclError:
                pass
        self._tclCommands = None


tk.Misc.destroy = _misc_destroy_safe

