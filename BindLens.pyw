    def wheel_route(self, top, callback):
        """The mouse wheel over a window scrolls that window (wherever the keyboard focus is)."""
        if not getattr(self, "_wheel_bound", False):
            for seq in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
                self.root.bind_all(seq, self._route_wheel, add="+")
            self._wheel_bound = True
        self.__dict__.setdefault("_wheel_targets", {})[str(top)] = callback

    def _route_wheel(self, e):
        try:
            w = self.root.winfo_containing(e.x_root, e.y_root)
        except Exception:
            return
        if w is None or isinstance(w, (tk.Text, tk.Listbox, ttk.Treeview)):
            return
        cb = getattr(self, "_wheel_targets", {}).get(str(w.winfo_toplevel()))
        if cb:
            try:
                if w.winfo_toplevel().winfo_exists():
                    cb(e)
            except Exception:
                pass

