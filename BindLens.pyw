        def chips(parent, options, key, multi=False, per_row=6, store=None):
            store = st if store is None else store
            fr = tk.Frame(parent, bg=T["panel"])
            fr.pack(anchor="w")
            widgets = {}

            def paint():
                for val, (cv, lab) in widgets.items():
                    on = (val in store[key]) if multi else (store[key] == val)
                    f = tkfont.Font(font=self.F(9))
                    w = f.measure(lab) + 26
                    cv.configure(width=w, bg=T["panel"])
                    cv.delete("all")
                    round_rect(cv, 1, 1, w - 1, 29, 14, fill=mix(T["panel"], self.accent, 0.18) if on else T["chip"],
                               outline=self.accent if on else T["chip"])
                    cv.create_text(w / 2, 15, text=lab, font=self.F(9), fill=T["text"])

            def toggle(val):
                if multi:
                    store[key].symmetric_difference_update({val})
                else:
                    store[key] = val
                paint()
                if key in ("scope", "pack", "pv_rows", "pv_cols", "pv_val"):
                    build()
            for k, (val, lab) in enumerate(options):
                cv = tk.Canvas(fr, height=30, highlightthickness=0, bd=0, cursor="hand2")
                cv.grid(row=k // per_row, column=k % per_row, padx=(0, 6), pady=2, sticky="w")
                cv.bind("<Button-1>", lambda e, v=val: toggle(v))
                widgets[val] = (cv, lab)
            paint()
            return fr

