                     font=self.F(8), bg=adj.cget("bg"), fg=T["muted"], justify="left").pack(anchor="w", pady=(5, 0))
            set_pic_label()

            drag_ = {"x": None, "y": None, "t": 0.0}

            def pv_press(e):
                drag_["x"], drag_["y"] = e.x, e.y

            def pv_move(e):
                if not spec.get("img") or drag_["x"] is None:
                    return
                geo = NOTE_PHOTO_GEOM.get(spec["img"])
                if not geo:
                    return
                f_ = pv_scale[0]
                dx, dy = (e.x - drag_["x"]) * f_, (e.y - drag_["y"]) * f_
                drag_["x"], drag_["y"] = e.x, e.y
                if geo["free_x"]:
                    spec["img_cx"] = max(0.0, min(1.0, float(spec.get("img_cx", 0.5)) - dx / max(1, geo["dw"])))
                if geo["free_y"]:
                    spec["img_cy"] = max(0.0, min(1.0, float(spec.get("img_cy", 0.5)) - dy / max(1, geo["dh"])))
                if time.time() - drag_["t"] > 0.05:
                    drag_["t"] = time.time()
                    draw()
            pv.bind("<ButtonPress-1>", pv_press)
            pv.bind("<B1-Motion>", pv_move)
            pv.bind("<ButtonRelease-1>", lambda e: (drag_.update(x=None), later()))
            pv.bind("<Enter>", lambda e: pv.configure(cursor="fleur" if spec.get("img") else ""))
        else:
            label(left, "Look")
            chip_row(left, list(STAMP_STYLES.items()), "style")
            label(left, "Colour")
            self._inline_palette(left, spec.get("color", "#1E8E3E"),
                                 lambda c: (spec.__setitem__("color", c), later())).pack(anchor="w")
        row = tk.Frame(left, bg=T["panel"])
        row.pack(anchor="w", fill="x")
        c1 = tk.Frame(row, bg=T["panel"])
        c1.pack(side="left", anchor="n")
        label(c1, "Font")
        chip_row(c1, [(k, k) for k in available_fonts()], "font", per_row=6)
        row2 = tk.Frame(left, bg=T["panel"])
        row2.pack(anchor="w", fill="x")
        c2 = tk.Frame(row2, bg=T["panel"])
        c2.pack(side="left", anchor="n")
        label(c2, "Size")
        sv = tk.IntVar(value=int(spec.get("size", 12)))
        sp = ttk.Spinbox(c2, from_=6, to=40, width=4, textvariable=sv, command=lambda: later())
        sp.pack(anchor="w")
        c3 = tk.Frame(row2, bg=T["panel"])
        c3.pack(side="left", anchor="n", padx=(18, 0))
        label(c3, "Tilt  (or drag the round handle on the page)")
        av = tk.DoubleVar(value=float(spec.get("angle", 0)))
        ttk.Scale(c3, from_=-45, to=45, variable=av, command=lambda v: later(), length=220).pack(anchor="w")
        save_v = tk.BooleanVar(value=save_option)
        if kind == "stamp":
            ttk.Checkbutton(left, text="Save it in My stamps (to use it again)", variable=save_v).pack(
                anchor="w", pady=(10, 0))
        job = [None]

        def collect():
            spec["text"] = get_text()
            try:
                spec["size"] = max(6, min(40, int(sv.get())))
            except Exception:
                pass
            spec["angle"] = round(float(av.get()), 1)
            if kind == "stamp":
                # 3.0: a stamp you change keeps ITS date (an approval stays dated the day it was given)
                spec["date_text"] = (spec.get("date_text") or time.strftime("%d %b %Y")) if spec.get("date") else ""
                if spec.get("style") != "circle":
                    spec["w"] = max(110, min(320, len(max(spec["text"].split("\n") or [""], key=len)) *
                                             spec["size"] * 0.75 + 46))
                    spec["h"] = (spec["size"] * 2.6 + (spec["size"] * 1.2 if spec.get("date") else 0)) + 10
            return spec

        def later():
            if job[0]:
                d.after_cancel(job[0])
            job[0] = d.after(120, draw)

        pv_scale = [1.0]

        def draw():
            job[0] = None
            sp_ = dict(collect())
            if not sp_["text"] and not sp_.get("img"):
                sp_["text"] = "Write here…"
            try:
                png, W, H = render_card(self.fitz, sp_, scale=1.0, images_dir=self.images_dir)
                k = min(1.0, 256 / W, 246 / H)
                img = tk.PhotoImage(data=png)
                pv_scale[0] = 1.0
                if k < 1.0:
                    f = max(1, int(1 / k + 0.999))
                    img = img.subsample(f, f)
                    pv_scale[0] = float(f)
                pv.delete("all")
                pv.create_image(135, 130, image=img)
                pv.img = img
            except Exception:
                pass
        draw()
        res = [None]

        def ok(_e=None):
            sp_ = collect()
            if sp_["text"] or sp_.get("img"):
                res[0] = dict(sp_)
                if kind == "stamp" and save_v.get():
                    self._my_stamp_save(sp_)
            d.destroy()
            return "break"
        bf = ttk.Frame(d, style="Panel.TFrame", padding=(18, 12))
        bf.pack(fill="x")
        PillButton(bf, self, "Done", ok, kind="accent").pack(side="right")
        PillButton(bf, self, "Cancel", d.destroy, kind="ghost").pack(side="right", padx=6)
        d.bind("<Control-Return>", ok)
        d.bind("<Escape>", lambda e: d.destroy())
        self._center(d)
        d.grab_set()
        self.root.wait_window(d)
        return res[0]

    def edit_card(self, g, xref):
        m = self._mark(g, xref)
        if not m or not m.get("card"):
            return
        spec = dict(m["card"])
        k = spec.get("kind")
        if k == "note":
            new = self._card_dialog(spec, "Sticky note")
        elif k == "stamp" and spec.get("style") == "symbol":   # 3.2: tick ⇄ cross, box → ☑ → ☒
            nxt = SYMBOL_CYCLE.get(spec.get("sym"))
            if not nxt:
                return
            own = SYMBOLS.get(spec.get("sym"), ("", "", ""))[2]
            col = SYMBOLS[nxt][2] if spec.get("color") in (own, None) else spec.get("color")
            new = dict(spec, sym=nxt, text=SYMBOLS[nxt][0], color=col)
        elif k == "stamp":
            new = self._card_dialog(spec, "Stamp")
        elif k == "sign":
            new = self.signature_dialog(spec, place=False)
        elif k == "box":
            self.edit_box_inline(g, xref)
            return
        elif k == "watermark":
            self.watermark_dialog()
            return
        else:
            return
        if new:
            self._replace_card(g, xref, new)

    def signature_dialog(self, spec=None, place=True):
        """Draw your signature with the mouse (or load a picture of it). Saved in My stamps."""
        T = self.T
        spec = dict(spec or {"kind": "sign", "color": "#1F2A5A", "w": 180, "h": 80, "date": False})
        d = self._dialog("Signature")
        tk.Label(d, text="Sign in the box with the mouse - or load a picture of your signature.", font=self.F(9),
                 bg=T["panel"], fg=T["muted"]).pack(anchor="w", padx=18, pady=(14, 6))
        cv = tk.Canvas(d, width=460, height=170, bg="white", highlightthickness=1,
                       highlightbackground=T["border"], cursor="pencil")
        cv.pack(padx=18)
        cv.create_line(30, 135, 430, 135, fill="#C8C8D0", dash=(3, 3))
        strokes, cur = [], []
        st = {"img": spec.get("img"), "ink": spec.get("color", "#1F2A5A")}
        if st["img"]:
            path = os.path.join(self.images_dir, st["img"] + ".png")
            if os.path.exists(path):
                try:
                    im = tk.PhotoImage(file=path)
                    f = max(1, int(max(im.width() / 440, im.height() / 150) + 0.999))
                    im = im.subsample(f, f)
                    cv.create_image(230, 85, image=im, tags="img")
                    cv.im = im
                except Exception:
                    pass

        def down(e):
            cur.clear()
            cur.append((e.x, e.y))

        def move(e):
            if cur:
                cv.create_line(cur[-1][0], cur[-1][1], e.x, e.y, fill=st["ink"], width=2.6, capstyle="round",
                               smooth=True, tags="ink")
                cur.append((e.x, e.y))

        def up(_e):
            if len(cur) > 1:
                strokes.append(list(cur))
                st["img"] = None
                cv.delete("img")
            cur.clear()
        cv.bind("<ButtonPress-1>", down)
        cv.bind("<B1-Motion>", move)
        cv.bind("<ButtonRelease-1>", up)
        row = tk.Frame(d, bg=T["panel"])
        row.pack(fill="x", padx=18, pady=8)

        def clear():
            strokes.clear()
            cv.delete("ink")
            cv.delete("img")
            st["img"] = None

        def load():
            path = filedialog.askopenfilename(parent=d, title="Picture of your signature",
                                              filetypes=[("Pictures", "*.png *.jpg *.jpeg *.bmp *.gif *.tif *.tiff"),
                                                         ("All files", "*.*")])
            if not path:
                return
            try:
                key, w, h = import_image(self.fitz, path, self.images_dir, remove_white=True)
            except Exception as ex:
                messagebox.showerror(APP_NAME, f"Could not read that picture:\n{ex}", parent=d)
                return
            clear()
            st["img"] = key
            spec["w"], spec["h"] = 180, max(40, 180 * h / max(1, w))
            im = tk.PhotoImage(file=os.path.join(self.images_dir, key + ".png"))
            f = max(1, int(max(im.width() / 440, im.height() / 150) + 0.999))
            im = im.subsample(f, f)
            cv.create_image(230, 85, image=im, tags="img")
            cv.im = im
        PillButton(row, self, "Clear", clear, kind="ghost").pack(side="left")
        PillButton(row, self, "Load a picture…", load, kind="soft").pack(side="left", padx=6)
        for c in ("#1F1F1F", "#1F2A5A", "#2F80ED"):
            b = tk.Canvas(row, width=24, height=24, bg=T["panel"], highlightthickness=0, cursor="hand2")
            b.pack(side="right", padx=2)
            b.create_oval(4, 4, 20, 20, fill=c, outline="")
            b.bind("<Button-1>", lambda e, c=c: (st.__setitem__("ink", c),
                                                   [cv.itemconfigure(i, fill=c) for i in cv.find_withtag("ink")]))
        tk.Label(row, text="Ink", font=self.F(9), bg=T["panel"], fg=T["muted"]).pack(side="right", padx=6)
        f2 = tk.Frame(d, bg=T["panel"])
        f2.pack(fill="x", padx=18)
        tk.Label(f2, text="Name under the line (optional)", font=self.F(9), bg=T["panel"], fg=T["muted"]).pack(
            anchor="w")
        nv = tk.StringVar(value=spec.get("name_text", ""))
        ttk.Entry(f2, textvariable=nv, width=36, font=self.F(10)).pack(anchor="w")
        dv = tk.BooleanVar(value=bool(spec.get("date")))
        ttk.Checkbutton(f2, text="Add today's date", variable=dv).pack(anchor="w", pady=(6, 0))
        res = [None]

        def ok(_e=None):
            if strokes:
                xs = [x for s_ in strokes for x, _ in s_]
                ys = [y for s_ in strokes for _, y in s_]
                x0, y0, x1, y1 = min(xs) - 6, min(ys) - 6, max(xs) + 6, max(ys) + 6
                doc = self.fitz.open()
                pg = doc.new_page(width=x1 - x0, height=y1 - y0)
                sh = pg.new_shape()
                for s_ in strokes:
                    sh.draw_polyline([(x - x0, y - y0) for x, y in s_])
                    sh.finish(color=hex_to_rgb01(st["ink"]), width=2.4, lineCap=1, lineJoin=1, closePath=False)
                sh.commit()
                pix = pg.get_pixmap(matrix=self.fitz.Matrix(3, 3), alpha=True)
                import hashlib
                data = pix.tobytes("png")
                key = hashlib.sha1(data).hexdigest()[:16]
                os.makedirs(self.images_dir, exist_ok=True)
                with open(os.path.join(self.images_dir, key + ".png"), "wb") as fh:
                    fh.write(data)
                st["img"] = key
                spec["w"] = 180
                spec["h"] = max(40, 180 * (y1 - y0) / max(1, x1 - x0))
                spec["h_base"] = spec["h"]
            if not st["img"]:
                messagebox.showinfo(APP_NAME, "Sign in the box first, or load a picture.", parent=d)
                return
            if "h_base" not in spec:          # (a signature from before 3.0: its lines were added to its height)
                spec["h_base"] = max(40, spec.get("h", 60) - 14 * (bool(spec.get("name_text")) +
                                                                  bool(spec.get("date_text"))))
            spec["img"] = st["img"]
            spec["color"] = st["ink"]
            spec["name_text"] = nv.get().strip()
            spec["date"] = dv.get()
            # 3.0: a signature you change keeps its date - and does not grow each time
            spec["date_text"] = (spec.get("date_text") or time.strftime("%d/%m/%Y")) if dv.get() else ""
            spec["h"] = spec["h_base"] + 14 * (bool(spec["name_text"]) + bool(spec["date_text"]))
            res[0] = dict(spec)
            d.destroy()
        bf = ttk.Frame(d, style="Panel.TFrame", padding=(18, 12))
        bf.pack(fill="x")
        PillButton(bf, self, "Use this signature" if place else "Save", ok, kind="accent").pack(side="right")
        PillButton(bf, self, "Cancel", d.destroy, kind="ghost").pack(side="right", padx=6)
        d.bind("<Escape>", lambda e: d.destroy())
        self._center(d)
        d.grab_set()
        self.root.wait_window(d)
        sp_ = res[0]
        if sp_ and place:
            if not any(x.get("img") == sp_["img"] for x in self.lib.settings.get("my_stamps", [])):
                self._my_stamp_save(sp_, name=("Signature " + sp_.get("name_text", "")).strip())
            self._use_card(sp_)
        return sp_

