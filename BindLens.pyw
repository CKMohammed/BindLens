class App:
    def __init__(self, root, fitz, dnd):
        global _FITZ
        _FITZ = fitz
        self.root = root
        root.report_callback_exception = self._tk_error      # 3.0: an error is written down and said - never silent
        if os.name == "nt":                                   # 3.0: every window's title bar follows the theme
            root.bind_class("Toplevel", "<Map>", lambda e: self._titlebar(e.widget) if
                            isinstance(e.widget, tk.Toplevel) and not e.widget.overrideredirect() else None, add="+")
        self.fitz = fitz
        self.dnd = dnd
        self.lib = Library(APP_DIR, scan=False)       # the folders are read once the window is up
        self.lib.on_missing = lambda: self.root.after(500, self._follow_moved)     # 1.9.9: moved folders
        s = self.lib.settings
        s.setdefault("theme", "Light")
        s.setdefault("accent", ACCENTS[0])
        s.setdefault("night_pages", False)
        s.setdefault("backups", False)
        if not s.get("_v31_nocopies"):       # 3.1: no copies of your documents - every change can be undone instead
            s["backups"] = False
            s["_v31_nocopies"] = True
        s.setdefault("color", PALETTE["Yellow"])
        s.setdefault("recent", [PALETTE["Yellow"], PALETTE["Light green"], PALETTE["Light blue"],
                                PALETTE["Pink"], PALETTE["Light purple"]])
        s.setdefault("font", "Sans")
        s.setdefault("font_size", 14)
        self.book = None
        self.folder = None
        self.prefix = ""
        self.zoom = 1.0
        self.fit_mode = "width"
        self.page_tops, self.header_tops = [], {}
        self.total_h = self.content_w = 0
        self.cache = OrderedDict()
        self._queue = []
        self.render_job = None
        self.current_page = 0
        self._save_job = None
        self._last_w = 0
        self.fullscreen = False
        self.sidebar_visible = True
        self._side_overlay = False
        self._side_job = None
        self._menu_open = False
        self._covers = {}
        self._launcher = None
        self._ed = None
        self.tool = "select"
        self.sel = None
        self.drag = None
        self.sel_annot = None        # (g, xref)
        self.flash = None
        self.marks = []              # [{g, xref, kind, color, text}]
        self.marks_by_g = {}
        self._marks_fi = set()       # files whose marks are in self.marks
        self._marks_pending = 0      # files whose marks a helper is still reading
        self._mcache = {}            # file -> (mtime, size, marks, has form fields): switching books is instant
        self.words_cache = OrderedDict()
        self.undo_stack, self.redo_stack = [], []
        self.dirty = set()           # kept for older code paths: always empty now (see Writer)
        self._dirty_job = None
        self.writer = Writer()
        self.writer.start()
        self.page_sizes = load_json(os.path.join(self.lib.meta_dir, "pages.json"), {})
        self._marks_job = None
        self._tip = None
        self._float = None
        self.search_query = ""
        self.hits, self.hits_by_g, self.hit_cur = [], {}, -1
        self.search_job = None
        self.pool = HelperPool()            # invisible readers: the window never waits for a file
        self.pool.hold = lambda: (getattr(self, "_prescan_token", None) is not None or
                                  getattr(self, "_scanning", False) or
                                  any(not j.event.is_set() for j in list(self._rendering.values())))
        self.pool.start()
        self._rendering = {}
        self._wanted, self._visible = set(), set()
        self.indexer = Indexer(fitz, self.lib.meta_dir, pool=self.pool)
