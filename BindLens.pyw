        def table_picker(e):
            pop = tk.Toplevel(w)
            pop.overrideredirect(True)
            pop.configure(bg=T["border"])
            inner = tk.Frame(pop, bg=T["panel"], padx=8, pady=8)
            inner.pack(padx=1, pady=1)
            lab = tk.Label(inner, text="Table", font=self.F(9), bg=T["panel"], fg=T["text"])
            lab.pack(anchor="w")
            cv = tk.Canvas(inner, width=8 * 20 + 2, height=8 * 20 + 2, bg=T["panel"], highlightthickness=0)
            cv.pack()
            cells = {}
            for r_ in range(8):
                for c_ in range(8):
                    cells[(r_, c_)] = cv.create_rectangle(1 + c_ * 20, 1 + r_ * 20, 19 + c_ * 20, 19 + r_ * 20,
                                                          outline=T["border"], fill="#FFFFFF")
            pick = {"rc": (0, 0)}

            def hover(ev):
                r_, c_ = min(7, max(0, ev.y // 20)), min(7, max(0, ev.x // 20))
                pick["rc"] = (r_ + 1, c_ + 1)
                for (rr, cc), it in cells.items():
                    cv.itemconfigure(it, fill=mix("#FFFFFF", ACC, 0.35) if rr <= r_ and cc <= c_ else "#FFFFFF")
                lab.configure(text=f"{c_ + 1} columns × {r_ + 1} rows")

            def choose(_ev=None):
                r_, c_ = pick["rc"]
                pop.destroy()
                if r_ and c_:
                    rt.insert_embed("table", {"rows": [[""] * c_ for _ in range(r_)], "head": 1,
                                              "style": self.lib.settings.get("table_style", "grid")})
            cv.bind("<Motion>", hover)
            cv.bind("<Button-1>", choose)
            more = tk.Label(inner, text="More rows or columns…", font=self.F(9), bg=T["panel"], fg=ACC,
                            cursor="hand2")
            more.pack(anchor="w", pady=(6, 0))

            def bigger(_ev=None):
                pop.destroy()
                res = self._ask_string("Table", "Columns × rows  (e.g. 3 x 12):", "3 x 12")
                if not res:
                    return
                nums = [int(x) for x in re.findall(r"\d+", res)][:2] or [3, 4]
                c_, r_ = (nums + [4])[:2]
                c_, r_ = max(1, min(14, c_)), max(1, min(120, r_))
                rt.insert_embed("table", {"rows": [[""] * c_ for _ in range(r_)], "head": 1,
                                          "style": self.lib.settings.get("table_style", "grid")})
            more.bind("<Button-1>", bigger)
            pop.bind("<Escape>", lambda ev: pop.destroy())
            pop.bind("<FocusOut>", lambda ev: pop.after(120, lambda: pop.winfo_exists() and pop.destroy()))
            pop.geometry(f"+{e.widget.winfo_rootx()}+{e.widget.winfo_rooty() + e.widget.winfo_height() + 2}")
            pop.focus_force()

        def ins_pic(_e=None):
