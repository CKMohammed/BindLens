# ---------------------------------------------------------------------------
# A small word processor on a Tk Text widget - used to type straight on the page (text boxes) and in the
# page editor (new pages, like a simple Word). Saves as BindLens rich text (see rich_html).
# ---------------------------------------------------------------------------
def _remap_cells(d, fn):
    """Move per-cell settings ({"row,col": value}) when rows / columns are added or deleted."""
    out = {}
    for k, v in (d or {}).items():
        try:
            i, j = (int(x) for x in k.split(","))
        except Exception:
            continue
        r = fn(i, j)
        if r is not None:
            out[f"{r[0]},{r[1]}"] = v
    return out


class RichTable(tk.Frame):
    """A table in the page editor. Type in the cells (Tab / Enter move on). Its look - style, colours, column
    widths (drag the small marks above it), alignment, merged cells, width and position - comes from the TABLE
    tab of the editor or a right-click on a cell. It looks like it will on the page."""
    KEYS = ("style", "fill", "line", "band", "lw", "widths", "cal", "cbg", "spans", "tw", "tal", "pad", "hcol",
            "head", "fs")

    def __init__(self, rt, data=None):
        super().__init__(rt.t, bg=rt.t.cget("bg"), bd=0, highlightthickness=0)
        self.rt = rt
        d = dict(data or {})
        self.rows = [[str(c) for c in r] for r in (d.get("rows") or [["", "", ""], ["", "", ""], ["", "", ""]])]
        self.o = {k: json.loads(json.dumps(d[k])) for k in self.KEYS if k in d}
        self.o.setdefault("head", 1)
        self.cur = (0, 0)
        self.cells = {}
        self.ruler = tk.Canvas(self, height=9, bg=self.cget("bg"), highlightthickness=0, cursor="sb_h_double_arrow")
        self.ruler.pack(fill="x")
        self.gridf = tk.Frame(self, bg=self.cget("bg"), bd=0)
        self.gridf.pack(anchor="w")
        self.ruler.bind("<ButtonPress-1>", self._rpress)
        self.ruler.bind("<B1-Motion>", self._rdrag)
        self.ruler.bind("<ButtonRelease-1>", self._rrelease)
        self._rd = None
        self.build()

    # ---- shape ---------------------------------------------------------------------------------------
    @property
    def ncol(self):
        return max(len(r) for r in self.rows) if self.rows else 1

    def _norm(self):
        n = self.ncol
        for r in self.rows:
            r += [""] * (n - len(r))
        ws = list(self.o.get("widths") or [])
        if len(ws) != n or not all(isinstance(x, (int, float)) and x > 0 for x in ws):
            self.o["widths"] = [1.0] * n
        cal = list(self.o.get("cal") or [])
        self.o["cal"] = (cal + ["l"] * n)[:n]

    def width_px(self):
        return max(120, int(self.rt.width_px() * 0.98 * max(20, min(100, int(self.o.get("tw", 100)))) / 100))

    def col_px(self):
        ws = self.o["widths"]
        tot = sum(ws)
        W = self.width_px()
        return [max(24, int(W * w / tot)) for w in ws]

    def covered(self):
        """Cells hidden under a merged cell."""
        cov = set()
        for k, v in (self.o.get("spans") or {}).items():
            i, j = (int(x) for x in k.split(","))
            for jj in range(j + 1, j + int(v)):
                cov.add((i, jj))
        return cov

    def build(self):
        self._norm()
        for w in self.gridf.winfo_children():
            w.destroy()
        self.cells = {}
        n, nr = self.ncol, len(self.rows)
        cpx = self.col_px()
        for j, px in enumerate(cpx):
            self.gridf.grid_columnconfigure(j, minsize=px, weight=0)
        pv = {"compact": 1, "normal": 3, "roomy": 6}.get(self.o.get("pad", "normal"), 3)
        cov = self.covered()
        spans = self.o.get("spans") or {}
        base_bg = self.rt.t.cget("bg")
        for i, row in enumerate(self.rows):
            for j in range(n):
                if (i, j) in cov:
                    continue
                span = max(1, min(n - j, int(spans.get(f"{i},{j}", 1))))
                bg, sides, bold = table_cell_look(self.o, i, j, n, nr)
                look = {k: v for k, v in sides.items()}
                if "l" in look and j > 0 and "r" in table_cell_look(self.o, i, j - 1, n, nr)[1]:
                    look.pop("l")
                if "t" in look and i > 0 and "b" in table_cell_look(self.o, i - 1, j, n, nr)[1]:
                    look.pop("t")
                lc = next(iter(look.values()))[1] if look else (bg or base_bg)
                wrap = tk.Frame(self.gridf, bg=lc, bd=0)
                wrap.grid(row=i, column=j, columnspan=span, sticky="nsew")
                cbg = bg or "#FFFFFF"
                if not bg and base_bg.upper() != "#FFFFFF":
                    cbg = base_bg
                fg = "#FFFFFF" if not is_light(cbg) else "#1F1F1F"
                al = self.o["cal"][j] if j < len(self.o["cal"]) else "l"
                e = tk.Entry(wrap, width=1, relief="flat", bd=0, font=self.rt.cell_font(bold=bold), bg=cbg, fg=fg,
                             insertbackground=fg, highlightthickness=1, highlightbackground=cbg,
                             highlightcolor="#5B6CF0", justify={"l": "left", "c": "center", "r": "right"}.get(al))
                px = lambda k: max(1, int(round(look[k][0] * 1.4))) if k in look else 0
                e.pack(fill="both", expand=True, padx=(px("l"), px("r")), pady=(px("t"), px("b")), ipady=pv,
                       ipadx=3)
                e.insert(0, row[j])
                e.bind("<KeyRelease>", lambda ev, i=i, j=j, e=e: self._set(i, j, e.get()))
                e.bind("<FocusIn>", lambda ev, i=i, j=j: self._focus(i, j))
                e.bind("<Button-3>", lambda ev, i=i, j=j: (self._focus(i, j), self.menu(ev)))
                e.bind("<Tab>", lambda ev, i=i, j=j: self._next(i, j, 1))
                e.bind("<Shift-Tab>", lambda ev, i=i, j=j: self._next(i, j, -1))
                e.bind("<ISO_Left_Tab>", lambda ev, i=i, j=j: self._next(i, j, -1))
                e.bind("<Return>", lambda ev, i=i, j=j: self._down(i, j, 1))
                e.bind("<Down>", lambda ev, i=i, j=j: self._down(i, j, 1, grow=False))
                e.bind("<Up>", lambda ev, i=i, j=j: self._down(i, j, -1, grow=False))
                self.cells[(i, j)] = e
        self.after_idle(self._draw_ruler)
        try:
            self.rt._align_embed(self, self.o.get("tal", "l"), quiet=True)
        except Exception:
            pass

    def _draw_ruler(self):
        c = self.ruler
        c.delete("all")
        try:
            c.configure(bg=self.rt.t.cget("bg"), width=sum(self.col_px()))
        except Exception:
            return
        x = 0
        cpx = self.col_px()
        c.create_line(0, 8, sum(cpx), 8, fill="#D5D8DE")
        for k, px in enumerate(cpx[:-1]):
            x += px
            c.create_polygon(x - 4, 1, x + 4, 1, x, 8, fill="#8C93A3", outline="", tags=("h", f"h{k}"))

    def _rpress(self, e):
        cpx = self.col_px()
        x, best = 0, None
        for k, px in enumerate(cpx[:-1]):
            x += px
            if abs(e.x - x) <= 7:
                best = k
        self._rd = (best, e.x, list(cpx)) if best is not None else None

    def _rdrag(self, e):
        if not self._rd:
            return
        k, x0, cpx = self._rd
        dx = e.x - x0
        a, b = cpx[k] + dx, cpx[k + 1] - dx
        if a < 28 or b < 28:
            return
        new = list(cpx)
        new[k], new[k + 1] = a, b
        self.o["widths"] = [round(p / sum(new), 4) for p in new]
        for j, px in enumerate(self.col_px()):
            self.gridf.grid_columnconfigure(j, minsize=px)
        self._draw_ruler()

    def _rrelease(self, _e=None):
        if self._rd:
            self._rd = None
            self.rt._changed()

    # ---- typing and moving around ---------------------------------------------------------------------
    def _set(self, i, j, v):
        if i < len(self.rows) and j < len(self.rows[i]):
            if self.rows[i][j] != v:
                self.rows[i][j] = v
                self.rt._changed()

    def _focus(self, i, j):
        self.cur = (i, j)
        try:
            self.rt.embed_focus(self)
        except Exception:
            pass

    def focus_cell(self, i=None, j=None):
        i = self.cur[0] if i is None else i
        j = self.cur[1] if j is None else j
        i = max(0, min(len(self.rows) - 1, i))
        j = max(0, min(self.ncol - 1, j))
        while (i, j) not in self.cells and j > 0:
            j -= 1
        e = self.cells.get((i, j))
        if e:
            e.focus_set()
            self.cur = (i, j)

    def _next(self, i, j, d):
        n = self.ncol
        k = i * n + j + d
        while 0 <= k < len(self.rows) * n and (k // n, k % n) not in self.cells:
            k += d
        if k >= len(self.rows) * n:
            self.rows.append([""] * n)
            self.build()
            k = (len(self.rows) - 1) * n
        k = max(0, k)
        self.focus_cell(k // n, k % n)
        return "break"

    def _down(self, i, j, d, grow=True):
        if i + d >= len(self.rows):
            if not grow:
                return "break"
            self.add_row(below=True, at=i)
            return "break"
        if i + d < 0:
            return "break"
        self.focus_cell(i + d, j)
        return "break"

    # ---- changes (TABLE tab and right-click) ------------------------------------------------------------
    def _changed(self, focus=True):
        self.build()
        self.rt._changed()
        if focus:
            self.after_idle(self.focus_cell)

    def add_row(self, below=True, at=None):
        i = self.cur[0] if at is None else at
        k = i + 1 if below else i
        self.rows.insert(k, [""] * self.ncol)
        f = lambda r, c: (r + 1 if r >= k else r, c)
        self.o["cbg"] = _remap_cells(self.o.get("cbg"), f)
        self.o["spans"] = _remap_cells(self.o.get("spans"), f)
        self.cur = (k, self.cur[1])
        self._changed()

    def del_row(self):
        if len(self.rows) <= 1:
            return
        k = self.cur[0]
        self.rows.pop(k)
        f = lambda r, c: None if r == k else (r - 1 if r > k else r, c)
        self.o["cbg"] = _remap_cells(self.o.get("cbg"), f)
        self.o["spans"] = _remap_cells(self.o.get("spans"), f)
        self.cur = (min(k, len(self.rows) - 1), self.cur[1])
        self._changed()

    def add_col(self, right=True):
        j = self.cur[1]
        k = j + 1 if right else j
        for r in self.rows:
            r.insert(k, "")
        ws = list(self.o.get("widths") or [1.0] * (self.ncol - 1))
        ws.insert(k, sum(ws) / max(1, len(ws)))
        self.o["widths"] = ws
        cal = list(self.o.get("cal") or [])
        cal.insert(min(k, len(cal)), "l")
        self.o["cal"] = cal
        f = lambda r, c: (r, c + 1 if c >= k else c)
        self.o["cbg"] = _remap_cells(self.o.get("cbg"), f)
        self.o["spans"] = {}
        self.cur = (self.cur[0], k)
        self._changed()

    def del_col(self):
        if self.ncol <= 1:
            return
        k = self.cur[1]
        for r in self.rows:
            if k < len(r):
                r.pop(k)
        for key in ("widths", "cal"):
            v = list(self.o.get(key) or [])
            if k < len(v):
                v.pop(k)
            self.o[key] = v
        f = lambda r, c: None if c == k else (r, c - 1 if c > k else c)
        self.o["cbg"] = _remap_cells(self.o.get("cbg"), f)
        self.o["spans"] = {}
        self.cur = (self.cur[0], min(k, self.ncol - 1))
        self._changed()

    def merge_right(self):
        i, j = self.cur
        sp = dict(self.o.get("spans") or {})
        n = int(sp.get(f"{i},{j}", 1))
        if j + n >= self.ncol:
            return
        nxt = j + n
        txt = self.rows[i][nxt].strip()
        if txt:
            self.rows[i][j] = (self.rows[i][j] + " " + txt).strip()
            self.rows[i][nxt] = ""
        sp[f"{i},{j}"] = n + int(sp.pop(f"{i},{nxt}", 1))
        self.o["spans"] = sp
        self._changed()

    def split(self):
        i, j = self.cur
        sp = dict(self.o.get("spans") or {})
        if sp.pop(f"{i},{j}", None) is not None:
            self.o["spans"] = sp
            self._changed()

    def set(self, key, value):
        if value is None:
            self.o.pop(key, None)
        else:
            self.o[key] = value
        self._changed()

    def set_cell_bg(self, color):
        cb = dict(self.o.get("cbg") or {})
        k = f"{self.cur[0]},{self.cur[1]}"
        if color:
            cb[k] = color
        else:
            cb.pop(k, None)
        self.o["cbg"] = cb
        self._changed()

    def set_align(self, al):
        cal = list(self.o.get("cal") or ["l"] * self.ncol)
        cal = (cal + ["l"] * self.ncol)[:self.ncol]
        cal[self.cur[1]] = al
        self.o["cal"] = cal
        self._changed()

    def equal_widths(self):
        self.o["widths"] = [1.0] * self.ncol
        self._changed()

    def menu(self, ev):
        m = tk.Menu(self, tearoff=0)
        m.add_command(label="Add a row above", command=lambda: self.add_row(below=False))
        m.add_command(label="Add a row below", command=lambda: self.add_row(below=True))
        m.add_command(label="Add a column left", command=lambda: self.add_col(right=False))
        m.add_command(label="Add a column right", command=lambda: self.add_col(right=True))
        m.add_separator()
        m.add_command(label="Delete this row", command=self.del_row)
        m.add_command(label="Delete this column", command=self.del_col)
        m.add_separator()
        m.add_command(label="Merge with the cell on the right", command=self.merge_right)
        m.add_command(label="Split the cell", command=self.split)
        m.add_separator()
        sm = tk.Menu(m, tearoff=0)
        for k, lab in TABLE_STYLES.items():
            sm.add_command(label=("●  " if self.o.get("style", "grid") == k else "     ") + lab,
                           command=lambda k=k: self.set("style", k))
        m.add_cascade(label="Style", menu=sm)
        m.add_command(label="First row is a header" + ("  ✓" if self.o.get("head", 1) else ""),
                      command=lambda: self.set("head", 0 if self.o.get("head", 1) else 1))

        def colour(attr):
            cur = self.o.get(attr) if attr != "cell" else (self.o.get("cbg") or {}).get(f"{self.cur[0]},{self.cur[1]}")
            res = colorchooser.askcolor(color=cur or "#EEF0F4", parent=self)
            if res and res[1]:
                if attr == "cell":
                    self.set_cell_bg(res[1].upper())
                else:
                    self.set(attr, res[1].upper())
        m.add_command(label="Header colour…", command=lambda: colour("fill"))
        m.add_command(label="Line colour…", command=lambda: colour("line"))
        m.add_command(label="Colour of this cell…", command=lambda: colour("cell"))
        m.add_separator()
        m.add_command(label="Delete the table", command=lambda: self.rt.remove_embed(self))
        m.tk_popup(ev.x_root, ev.y_root)

    def refit(self):
        self.build()

    def data(self):
        d = {"t": "table", "rows": [list(r) for r in self.rows]}
        d.update({k: v for k, v in self.o.items() if v not in (None, {}, [])})
        return d


class PicEmbed(tk.Frame):
    """A picture in the page editor: click it, then drag the corner to change its size; the PICTURE tab (or a
    right-click) sets position, text around it, crop, turn, border and caption."""

    def __init__(self, rt, data=None):
        bg = rt.t.cget("bg")
        super().__init__(rt.t, bg=bg, bd=0, highlightthickness=2, highlightbackground=bg, highlightcolor=bg,
                         cursor="hand2")
        self.rt = rt
        self.d = dict(data or {})
        self.d.pop("t", None)
        self.sel = False
        self.lbl = tk.Label(self, bd=0, bg=bg)
        self.lbl.pack()
        self.cap = tk.Label(self, bd=0, bg=bg, fg="#5F6368", font=(rt.cell_font()[0], 9, "italic"))
        self.badge = tk.Label(self, bd=0, bg="#5B6CF0", fg="#FFFFFF", font=(rt.cell_font()[0], 8), padx=4)
        self.handle = tk.Frame(self, width=12, height=12, bg="#5B6CF0", cursor="bottom_right_corner")
        for w in (self, self.lbl, self.cap):
            w.bind("<Button-1>", self._click)
            w.bind("<Button-3>", self._menu)
            w.bind("<Double-1>", lambda e: self.rt.embed_action(self, "crop"))
        self.bind("<Delete>", lambda e: self.rt.remove_embed(self))
        self.bind("<BackSpace>", lambda e: self.rt.remove_embed(self))
        self.handle.bind("<ButtonPress-1>", self._hpress)
        self.handle.bind("<B1-Motion>", self._hdrag)
        self.handle.bind("<ButtonRelease-1>", self._hrelease)
        self._h = None
        self.render()

    def _click(self, _e=None):
        self.select(True)
        self.focus_set()
        try:
            self.rt.embed_focus(self)
        except Exception:
            pass

    def select(self, on):
        self.sel = on
        col = "#5B6CF0" if on else self.rt.t.cget("bg")
        self.configure(highlightbackground=col, highlightcolor=col)
        if on:
            self.handle.place(relx=1.0, rely=1.0, x=-1, y=-1, anchor="se")
            self.handle.lift()
        else:
            self.handle.place_forget()

    def _hpress(self, e):
        img = getattr(self.lbl, "img", None)
        self._h = (e.x_root, img.width() if img is not None else max(30, self.lbl.winfo_width()))

    def _hdrag(self, e):
        if not self._h:
            return
        x0, w0 = self._h
        W = max(100, self.rt.width_px())
        pct = max(8, min(100, int(round((w0 + e.x_root - x0) * 100 / W))))
        if pct != int(self.d.get("w", 60)):
            self.d["w"] = pct
            self.render()

    def _hrelease(self, _e=None):
        if self._h:
            self._h = None
            self.rt._changed()
            try:
                self.rt.embed_focus(self)
            except Exception:
                pass

    def _menu(self, e):
        self._click()
        m = tk.Menu(self, tearoff=0)
        for p in (25, 40, 50, 60, 80, 100):
            m.add_command(label=f"Width {p}%", command=lambda p=p: self.set("w", p))
        m.add_separator()
        for al, lab in (("l", "Left"), ("c", "Centre"), ("r", "Right")):
            m.add_command(label=lab, command=lambda al=al: self.set_pos(al))
        m.add_separator()
        m.add_command(label="Text on its right", command=lambda: self.set("wrap", "left"))
        m.add_command(label="Text on its left", command=lambda: self.set("wrap", "right"))
        m.add_command(label="On its own line", command=lambda: self.set("wrap", None))
        m.add_separator()
        m.add_command(label="Crop…", command=lambda: self.rt.embed_action(self, "crop"))
        m.add_command(label="Turn  ↻", command=lambda: self.rt.embed_action(self, "turn"))
        m.add_command(label="Caption…", command=lambda: self.rt.embed_action(self, "caption"))
        m.add_separator()
        m.add_command(label="Delete the picture", command=lambda: self.rt.remove_embed(self))
        m.tk_popup(e.x_root, e.y_root)

    def set(self, key, value):
        if value is None:
            self.d.pop(key, None)
        else:
            self.d[key] = value
        if key == "wrap":
            self.set_pos({"left": "l", "right": "r"}.get(value, self.d.get("al", "c")), quiet=True)
        self.render()
        self.rt._changed()

    def set_pos(self, al, quiet=False):
        self.d["al"] = al
        try:
            self.rt._align_embed(self, al, quiet=True)
        except Exception:
            pass
        if not quiet:
            self.rt._changed()

    def render(self):
        W = max(100, self.rt.width_px())
        tw = max(30, int(W * float(self.d.get("w", 60)) / 100))
        path = os.path.join(self.rt.images_dir or "", f"{self.d.get('img', '')}.png")
        fz = getattr(self.rt, "fitz", None)
        try:
            if fz is not None:
                pix = _picture_pixmap(fz, path, self.d.get("crop"))
                th = max(10, int(pix.height * tw / max(1, pix.width)))
                pix = fz.Pixmap(pix, tw, th) if pix.width != tw else pix
                if pix.alpha:
                    pix = fz.Pixmap(pix, 0)
                img = tk.PhotoImage(data=pix.tobytes("ppm"))
            else:
                img = tk.PhotoImage(file=path)
                k = img.width() / tw
                if k > 1:
                    f = max(1, int(round(k)))
                    img = img.subsample(f, f)
            self.lbl.configure(image=img, text="")
            self.lbl.img = img
        except Exception:
            self.lbl.configure(image="", text="[picture]", fg="#888888")
        bd = self.d.get("border", "none")
        self.lbl.configure(bd=0 if bd == "none" else (1 if bd == "thin" else 4), relief="solid" if bd == "thin"
                           else "flat", bg="#FFFFFF" if bd in ("frame", "shadow") else self.rt.t.cget("bg"))
        cap = (self.d.get("cap") or "").strip()
        if cap:
            self.cap.configure(text=cap)
            self.cap.pack(pady=(2, 0))
        else:
            self.cap.pack_forget()
        wrap = self.d.get("wrap")
        if wrap in ("left", "right"):
            self.badge.configure(text="text on the right  →" if wrap == "left" else "←  text on the left")
            self.badge.place(relx=0.0 if wrap == "left" else 1.0, rely=0.0, x=4 if wrap == "left" else -4, y=4,
                             anchor="nw" if wrap == "left" else "ne")
        else:
            self.badge.place_forget()
        if self.sel:
            self.handle.lift()

    def refit(self):
        self.render()

    def data(self):
        return dict(self.d, t="img")


class PageBreak(tk.Frame):
    def __init__(self, rt, data=None):
        bg = rt.t.cget("bg")
        super().__init__(rt.t, bg=bg, bd=0)
        self.rt = rt
        self.cv = tk.Canvas(self, height=18, bg=bg, highlightthickness=0, width=max(80, rt.width_px() - 10))
        self.cv.pack()
        self.cv.bind("<Button-3>", self._menu)
        self.draw()

    def draw(self):
        c = self.cv
        c.delete("all")
        w = max(80, self.rt.width_px() - 10)
        c.configure(width=w)
        c.create_line(0, 9, w, 9, fill="#9AA0A6", dash=(4, 3))
        c.create_rectangle(w / 2 - 44, 2, w / 2 + 44, 16, fill=self.cget("bg"), outline="")
        c.create_text(w / 2, 9, text="page break", fill="#80868B", font=(self.rt.cell_font()[0], 8))

    def _menu(self, e):
        m = tk.Menu(self, tearoff=0)
        m.add_command(label="Delete the page break", command=lambda: self.rt.remove_embed(self))
        m.tk_popup(e.x_root, e.y_root)

    def refit(self):
        self.draw()

    def data(self):
        return {"t": "pb"}


class RichText:
    """Fonts, sizes, bold / italic / underline / strike, text and highlight colours, alignment, headings,
    lists, quotes - and (page editor) tables, pictures and lines."""
    PARA = ("p", "h1", "h2", "h3", "ul", "ol", "quote")

    def __init__(self, parent, base=None, zoom=1.0, images_dir=None, on_change=None, **kw):
        self.base = dict(RICH_BASE)
        self.base.update(base or {})
        self.zoom = zoom
        self.images_dir = images_dir
        self.on_change = on_change
        opts = dict(wrap="word", undo=True, maxundo=200, relief="flat", bd=0, highlightthickness=0,
                    padx=4, pady=2, spacing1=0, spacing3=1, insertwidth=2, exportselection=True)
        opts.update(kw)
        self.t = tk.Text(parent, **opts)
        self.embeds = {}
        self.pending = None
        self._fonts = set()
        self.fitz = None                 # set by the page editor: sharp pictures of any size
        self.on_embed = None             # called with the table / picture you are in (or None: the text)
        self.on_action = None            # picture actions that need a window (crop, caption, turn)
        t = self.t
        t.bind("<KeyPress>", self._key)
        t.bind("<Button-1>", lambda e: self.embed_focus(None), add="+")
        t.bind("<Return>", self._enter)
        t.bind("<BackSpace>", self._backspace)
        for k, a in (("b", "b"), ("i", "i"), ("u", "u")):
            t.bind(f"<Control-{k}>", lambda e, a=a: (self.toggle(a), "break")[1])
            t.bind(f"<Control-{k.upper()}>", lambda e, a=a: (self.toggle(a), "break")[1])
        t.bind("<<Paste>>", self._paste)
        t.bind("<ButtonRelease-1>", lambda e: (setattr(self, "pending", None), self._changed(False)))
        t.bind("<KeyRelease>", self._keyup)
        t.tag_configure("MK", foreground="#6B7280")
        self.set_zoom(zoom)

    # ---- sizes ---------------------------------------------------------------------------------
    def px(self, pt):
        return max(6, int(round(float(pt) * self.zoom)))

    def width_px(self):
        try:
            return max(100, self.t.winfo_width() - 12)
        except Exception:
            return 400

    def char_px(self):
        try:
            return tkfont.Font(font=self._tkfont(self.base["f"], self.base["z"], 0, 0)).measure("0")
        except Exception:
            return 8

    def cell_font(self, bold=False):
        return self._tkfont(self.base["f"], self.base["z"], 1 if bold else 0, 0)

    def _tkfont(self, f, z, b, i):
        face = font_face(f) or font_face("Sans")
        return (face["tk"], -self.px(z), "bold" if b else "normal", "italic" if i else "roman")

    def set_zoom(self, zoom):
        self.zoom = zoom
        for name in list(self._fonts):
            _, f, z, b, i = name.split("|")
            self.t.tag_configure(name, font=self._tkfont(f, float(z), int(b), int(i)))
        ind = self.px(self.base["z"] * 1.5)
        self.t.tag_configure("P|ul", lmargin1=4, lmargin2=4 + ind)
        self.t.tag_configure("P|ol", lmargin1=4, lmargin2=4 + ind)
        self.t.tag_configure("P|quote", lmargin1=ind, lmargin2=ind, foreground="#5B5F6A")
        for h, k in H_SIZES.items():
            self.t.tag_configure("P|" + h, spacing1=self.px(self.base["z"] * 0.3 * k), spacing3=self.px(2))
        self.t.tag_configure("A|c", justify="center")
        self.t.tag_configure("A|r", justify="right")
        self.t.tag_configure("A|l", justify="left")
        self.t.tag_configure("A|j", justify="left")
        self.t.configure(font=self._tkfont(self.base["f"], self.base["z"], 0, 0), fg=self.base.get("c", "#1F1F1F"))

    # ---- formats -------------------------------------------------------------------------------
    def default_fmt(self, ptype="p"):
        z = float(self.base["z"]) * H_SIZES.get(ptype, 1.0)
        return {"f": self.base["f"], "z": round(z, 1), "b": 1 if ptype in H_SIZES else 0, "i": 0, "u": 0, "s": 0,
                "c": None, "bg": None}

    def ftag(self, fmt):
        name = f"F|{fmt['f']}|{float(fmt['z']):g}|{int(bool(fmt['b']))}|{int(bool(fmt['i']))}"
        if name not in self._fonts:
            self._fonts.add(name)
            self.t.tag_configure(name, font=self._tkfont(fmt["f"], fmt["z"], fmt["b"], fmt["i"]))
            self.t.tag_lower(name)
        return name

    def char_tags(self, fmt):
        tags = [self.ftag(fmt)]
        if fmt.get("u"):
            tags.append("U")
            self.t.tag_configure("U", underline=1)
        if fmt.get("s"):
            tags.append("S")
            self.t.tag_configure("S", overstrike=1)
        if fmt.get("c"):
            n = "C|" + fmt["c"]
            self.t.tag_configure(n, foreground=fmt["c"])
            tags.append(n)
        if fmt.get("bg"):
            n = "H|" + fmt["bg"]
            self.t.tag_configure(n, background=fmt["bg"])
            tags.append(n)
        return tags

    def fmt_from_tags(self, tags, ptype="p"):
        fmt = self.default_fmt(ptype)
        for tg in tags:
            if tg.startswith("F|"):
                _, f, z, b, i = tg.split("|")
                fmt.update(f=f, z=float(z), b=int(b), i=int(i))
            elif tg == "U":
                fmt["u"] = 1
            elif tg == "S":
                fmt["s"] = 1
            elif tg.startswith("C|"):
                fmt["c"] = tg[2:]
            elif tg.startswith("H|"):
                fmt["bg"] = tg[2:]
        return fmt

    def para_type(self, index="insert"):
        for tg in self.t.tag_names(self.t.index(f"{index} lineend")):
            if tg.startswith("P|"):
                return tg[2:]
        for tg in self.t.tag_names(self.t.index(f"{index} linestart")):
            if tg.startswith("P|"):
                return tg[2:]
        return "p"

    def para_align(self, index="insert"):
        for tg in self.t.tag_names(self.t.index(f"{index} lineend")):
            if tg.startswith("A|"):
                return tg[2:]
        return self.base.get("al", "l")

    def para_tags(self, index="insert"):
        idx = self.t.index(f"{index} lineend")
        return [tg for tg in self.t.tag_names(idx) if tg[:2] in ("P|", "A|")] or \
            [tg for tg in self.t.tag_names(self.t.index(f"{index} linestart")) if tg[:2] in ("P|", "A|")]

    def cur_fmt(self):
        if self.pending:
            return dict(self.pending)
        t = self.t
        ins = t.index("insert")
        ptype = self.para_type(ins)
        if t.compare(ins, ">", f"{ins} linestart"):
            tags = [x for x in t.tag_names(f"{ins}-1c") if x != "MK"]
            if any(x.startswith("F|") for x in tags) and "MK" not in t.tag_names(f"{ins}-1c"):
                return self.fmt_from_tags(tags, ptype)
        tags = t.tag_names(ins)
        if any(x.startswith("F|") for x in tags) and "MK" not in tags and t.get(ins) != "\n":
            return self.fmt_from_tags(tags, ptype)
        return self.default_fmt(ptype)

    def _key(self, e):
        if e.state & 0x4 or (e.state & 0x20000) or not e.char or ord(e.char[0]) < 32 or e.keysym in ("Return",
                                                                                                     "KP_Enter"):
            return None
        if e.char == "\x7f":
            return None
        t = self.t
        fmt = self.cur_fmt()
        if t.tag_ranges("sel"):
            t.delete("sel.first", "sel.last")
        ptags = self.para_tags("insert")
        t.insert("insert", e.char, tuple(self.char_tags(fmt) + ptags))
        t.see("insert")
        self._changed()
        return "break"

    def _paste(self, _e=None):
        try:
            txt = self.t.clipboard_get()
        except Exception:
            return "break"
        self.insert_plain(txt)
        return "break"

    def insert_plain(self, txt):
        t = self.t
        if t.tag_ranges("sel"):
            t.delete("sel.first", "sel.last")
        fmt = self.cur_fmt()
        lines = txt.replace("\r\n", "\n").replace("\r", "\n").split("\n")
        for k, line in enumerate(lines):
            if k:
                self._newline()
            if line:
                t.insert("insert", line, tuple(self.char_tags(fmt) + self.para_tags("insert")))
        self._changed()

    def _newline(self):
        t = self.t
        ptype = self.para_type()
        al = [x for x in self.para_tags() if x.startswith("A|")]
        nxt = ptype if ptype in ("ul", "ol", "quote", "p") else "p"
        fmt = self.cur_fmt() if ptype == nxt else self.default_fmt(nxt)
        t.insert("insert", "\n", tuple(["P|" + ptype] + al))
        # the new line's own paragraph tags sit on its newline (or end)
        line_end = t.index("insert lineend")
        t.tag_remove("P|" + ptype, "insert", f"{line_end}+1c")
        self._tag_para("insert", nxt, "l" if nxt in ("ul", "ol") else (al[0][2:] if al else None))
        if nxt in ("ul", "ol"):
            t.insert("insert linestart", "• " if nxt == "ul" else "1. ", ("MK", self.ftag(self.default_fmt("p")),
                                                                         "P|" + nxt))
        self.pending = fmt if ptype == nxt else None
        if nxt == "ol":
            self.renumber()

    def _enter(self, _e=None):
        t = self.t
        if t.tag_ranges("sel"):
            t.delete("sel.first", "sel.last")
        ptype = self.para_type()
        if ptype in ("ul", "ol"):
            body = t.get("insert linestart", "insert lineend")
            body = re.sub(r"^(• |\d+\. )", "", body)
            if not body.strip():
                self.set_para(t="p")
                return "break"
        self._newline()
        t.see("insert")
        self._changed()
        return "break"

    def _backspace(self, _e=None):
        t = self.t
        if t.tag_ranges("sel"):
            return None
        ins = t.index("insert")
        if "MK" in t.tag_names(f"{ins}-1c"):
            self.set_para(t="p")
            return "break"
        prev = t.index(f"{ins}-1c")
        if t.compare(ins, "==", f"{ins} linestart") and t.window_names():
            pass
        return None

    def _keyup(self, e):
        if e.keysym in ("Left", "Right", "Up", "Down", "Home", "End", "Prior", "Next"):
            self.pending = None
        self._changed(False)

    def _changed(self, edited=True):
        # 3.0: a click or an arrow key is not an edit (it used to ask "Close without saving?" for nothing) -
        # the text widget itself says whether its text really changed
        try:
            if not edited and self.t.edit_modified():
                edited = True
            self.t.edit_modified(False)
        except Exception:
            pass
        self.last_edited = edited
        if self.on_change:
            try:
                self.on_change()
            except Exception:
                pass

    # ---- applying formats ------------------------------------------------------------------------
    def segments(self, a, b):
        """[(start, end, tags)] for the characters between a and b."""
        t = self.t
        cur = set(t.tag_names(a))
        out = []
        for key, val, idx in t.dump(a, b, tag=True, text=True):
            if key == "tagon":
                cur.add(val)
            elif key == "tagoff":
                cur.discard(val)
            elif key == "text":
                out.append((idx, t.index(f"{idx}+{len(val)}c"), set(cur)))
        return out

    def sel_range(self):
        r = self.t.tag_ranges("sel")
        return (str(r[0]), str(r[1])) if r else None

    def set_fmt(self, **kw):
        rng = self.sel_range()
        if not rng:
            f = self.cur_fmt()
            f.update(kw)
            self.pending = f
            self._changed(False)
            return
        t = self.t
        for a, b, tags in self.segments(*rng):
            if "MK" in tags:
                continue
            ptype = next((x[2:] for x in tags if x.startswith("P|")), "p")
            fmt = self.fmt_from_tags(tags, ptype)
            fmt.update(kw)
            for tg in tags:
                if tg[:2] in ("F|", "C|", "H|") or tg in ("U", "S"):
                    t.tag_remove(tg, a, b)
            for tg in self.char_tags(fmt):
                t.tag_add(tg, a, b)
        self._changed()

    def toggle(self, attr):
        rng = self.sel_range()
        if rng:
            segs = [s for s in self.segments(*rng) if "MK" not in s[2]]
            on = all(self.fmt_from_tags(s[2]).get(attr) for s in segs) if segs else False
        else:
            on = bool(self.cur_fmt().get(attr))
        self.set_fmt(**{attr: 0 if on else 1})

    def bump_size(self, d):
        rng = self.sel_range()
        if not rng:
            f = self.cur_fmt()
            self.set_fmt(z=max(6, min(96, float(f["z"]) + d)))
            return
        t = self.t
        for a, b, tags in self.segments(*rng):
            if "MK" in tags:
                continue
            fmt = self.fmt_from_tags(tags)
            new = dict(fmt, z=max(6, min(96, float(fmt["z"]) + d)))
            for tg in tags:
                if tg.startswith("F|"):
                    t.tag_remove(tg, a, b)
            t.tag_add(self.ftag(new), a, b)
        self._changed()

    def _lines(self):
        rng = self.sel_range()
        t = self.t
        if rng:
            a, b = rng
        else:
            a = b = t.index("insert")
        first = int(a.split(".")[0])
        last = int(t.index(f"{b}-1c").split(".")[0]) if rng and t.compare(b, ">", a) else int(b.split(".")[0])
        return range(first, max(first, last) + 1)

    def _tag_para(self, index, ptype=None, al=None):
        t = self.t
        a = t.index(f"{index} linestart")
        b = t.index(f"{index} lineend+1c")
        if ptype is not None:
            for tg in t.tag_names(a) + t.tag_names(t.index(f"{index} lineend")):
                if tg.startswith("P|"):
                    t.tag_remove(tg, a, b)
            t.tag_add("P|" + ptype, a, b)
        if al is not None:
            for tg in set(t.tag_names(a) + t.tag_names(t.index(f"{index} lineend"))):
                if tg.startswith("A|"):
                    t.tag_remove(tg, a, b)
            t.tag_add("A|" + al, a, b)

    def set_para(self, t=None, al=None):
        """Paragraph style (p, h1, h2, h3, ul, ol, quote) and/or alignment (l, c, r, j) of the lines."""
        tw = self.t
        for ln in self._lines():
            idx = f"{ln}.0"
            old = self.para_type(idx)
            if t is not None and t != old:
                # list markers
                if old in ("ul", "ol"):
                    first = tw.tag_nextrange("MK", idx, f"{idx} lineend")
                    if first:
                        tw.delete(first[0], first[1])
                if t in ("ul", "ol"):
                    tw.insert(idx, "• " if t == "ul" else "1. ", ("MK", self.ftag(self.default_fmt("p"))))
                # headings change the size of the words
                if t in H_SIZES or old in H_SIZES:
                    for a, b, tags in self.segments(idx, f"{idx} lineend"):
                        if "MK" in tags:
                            continue
                        fmt = self.fmt_from_tags(tags, old)
                        nz = float(self.base["z"]) * H_SIZES.get(t, 1.0)
                        new = dict(fmt, z=round(nz, 1), b=1 if t in H_SIZES else 0)
                        for tg in tags:
                            if tg.startswith("F|"):
                                tw.tag_remove(tg, a, b)
                        tw.tag_add(self.ftag(new), a, b)
            self._tag_para(idx, t if t is not None else None, "l" if t in ("ul", "ol") and al is None else al)
            if t is not None:
                mk = tw.tag_nextrange("MK", idx, f"{idx} lineend")
                if mk:
                    tw.tag_add("P|" + t, mk[0], mk[1])
        if t == "ol" or t is not None:
            self.renumber()
        self.pending = None
        self._changed()

    def renumber(self):
        tw = self.t
        n = 0
        last = int(tw.index("end-1c").split(".")[0])
        for ln in range(1, last + 1):
            idx = f"{ln}.0"
            if self.para_type(idx) == "ol":
                n += 1
                mk = tw.tag_nextrange("MK", idx, f"{idx} lineend")
                want = f"{n}. "
                if mk and tw.get(mk[0], mk[1]) != want:
                    tags = tw.tag_names(mk[0])
                    tw.delete(mk[0], mk[1])
                    tw.insert(idx, want, tags)
            else:
                n = 0

    # ---- tables, pictures, lines (page editor) -------------------------------------------------
    def _own_line(self):
        t = self.t
        if t.compare("insert", "!=", "insert linestart"):
            t.mark_set("insert", "insert lineend")
            self._newline()
        elif t.get("insert linestart", "insert lineend").strip():
            t.insert("insert", "\n")
            t.mark_set("insert", "insert-1c")

    def embed_focus(self, w):
        for e in list(self.embeds.values()):
            if e["kind"] == "img" and e["w"] is not w:
                try:
                    e["w"].select(False)
                except Exception:
                    pass
        if self.on_embed:
            try:
                self.on_embed(w)
            except Exception:
                pass

    def embed_action(self, w, action):
        if self.on_action:
            self.on_action(w, action)

    def insert_embed(self, kind, data=None):
        t = self.t
        self._own_line()
        if kind == "table":
            w = RichTable(self, data)
        elif kind == "hr":
            w = tk.Frame(t, height=2, width=max(60, self.width_px() - 10), bg="#9AA0A6")
            w.bind("<Button-3>", lambda e, w=w: self._simple_menu(e, w))
        elif kind == "pb":
            w = PageBreak(self, data)
        else:
            w = PicEmbed(self, data)
        t.window_create("insert", window=w, align="center", padx=0, pady=4)
        self.embeds[str(w)] = {"kind": kind, "w": w, "data": dict(data or {})}
        al = (data or {}).get("tal" if kind == "table" else "al") or ("c" if kind == "img" else "l")
        if kind == "img" and (data or {}).get("wrap") in ("left", "right"):
            al = {"left": "l", "right": "r"}[data["wrap"]]
        t.insert("insert", "\n", ("P|p", "A|" + al))
        self._tag_para(t.index("insert-1c"), "p", al)
        self._changed()
        return w

    def _simple_menu(self, e, w):
        m = tk.Menu(w, tearoff=0)
        m.add_command(label="Delete the line", command=lambda: self.remove_embed(w))
        m.tk_popup(e.x_root, e.y_root)

    def _align_embed(self, w, al, quiet=False):
        try:
            idx = self.t.index(w)
            self._tag_para(idx, None, al)
        except Exception:
            pass
        if not quiet:
            self._changed()

    def refit_embeds(self):
        """Tables and pictures follow the width of the page."""
        for e in list(self.embeds.values()):
            try:
                if hasattr(e["w"], "refit"):
                    e["w"].refit()
                elif e["kind"] == "hr":
                    e["w"].configure(width=max(60, self.width_px() - 10))
            except Exception:
                pass

    def remove_embed(self, w):
        t = self.t
        try:
            idx = t.index(w)
            t.delete(idx, f"{idx}+1c")
        except Exception:
            pass
        self.embeds.pop(str(w), None)
        try:
            w.destroy()
        except Exception:
            pass
        self.embed_focus(None)
        try:
            t.focus_set()
        except Exception:
            pass
        self._changed()

    # ---- saving and loading ------------------------------------------------------------------
    def get_doc(self):
        t = self.t
        blocks = []
        cur = {"runs": [], "tags": set(), "embed": None}

        def close(tags):
            ptype = next((x[2:] for x in tags if x.startswith("P|")), "p")
            al = next((x[2:] for x in tags if x.startswith("A|")), None)
            if cur["embed"] is not None:
                e = cur["embed"]
                blk = e["w"].data() if hasattr(e["w"], "data") else dict(e["data"], t=e["kind"])
                if al and e["kind"] not in ("table", "img"):
                    blk["al"] = al
                blocks.append(blk)
            else:
                blk = {"t": ptype, "runs": cur["runs"]}
                if al and al != self.base.get("al", "l"):
                    blk["al"] = al
                blocks.append(blk)
            cur["runs"], cur["embed"] = [], None

        def add_run(text, tags):
            ptype = next((x[2:] for x in tags if x.startswith("P|")), "p")
            fmt = self.fmt_from_tags(tags, ptype)
            dflt = self.default_fmt(ptype)
            run = {"x": text}
            for k in ("f", "z", "b", "i", "u", "s", "c", "bg"):
                v = fmt.get(k)
                if v and v != dflt.get(k):
                    run[k] = v
            if ptype in H_SIZES and not fmt.get("b"):
                run["nb"] = 1
            rs = cur["runs"]
            if rs and {k: v for k, v in rs[-1].items() if k != "x"} == {k: v for k, v in run.items() if k != "x"}:
                rs[-1]["x"] += text
            else:
                rs.append(run)
        active = set()
        last_tags = set()
        for key, val, idx in t.dump("1.0", "end-1c", tag=True, text=True, window=True):
            if key == "tagon":
                active.add(val)
            elif key == "tagoff":
                active.discard(val)
            elif key == "window":
                e = self.embeds.get(str(val)) or next((v for k, v in self.embeds.items() if k.endswith(str(val))),
                                                      None)
                if e:
                    cur["embed"] = e
            elif key == "text":
                parts = val.split("\n")
                for k, part in enumerate(parts):
                    if part and "MK" not in active:
                        add_run(part, active)
                    if k < len(parts) - 1:
                        close(active)
                last_tags = set(active)
        if cur["runs"] or cur["embed"] is not None or not blocks:
            close(last_tags or active)
        while len(blocks) > 1 and blocks[-1].get("t") == "p" and not blocks[-1].get("runs"):
            blocks.pop()
        return {"blocks": blocks, "base": dict(self.base)}

    def set_doc(self, doc):
        t = self.t
        t.delete("1.0", "end")
        for w in list(self.embeds.values()):
            try:
                w["w"].destroy()
            except Exception:
                pass
        self.embeds.clear()
        blocks = (doc or {}).get("blocks") or [{"t": "p", "runs": []}]
        n_ol = 0
        need_nl, prev, prev_al = False, "p", "l"
        for b in blocks:
            typ = b.get("t", "p")
            al = b.get("al") or self.base.get("al", "l")
            if typ in ("table", "hr", "img", "pb"):
                if need_nl:
                    t.insert("end-1c", "\n", ("P|" + prev, "A|" + prev_al))
                t.mark_set("insert", "end-1c")
                self.insert_embed(typ, b)
                need_nl, prev, n_ol = False, "p", 0
                continue
            if need_nl:
                t.insert("end-1c", "\n", ("P|" + prev, "A|" + prev_al))
            start = t.index("end-1c")
            n_ol = n_ol + 1 if typ == "ol" else 0
            if typ in ("ul", "ol"):
                t.insert("end-1c", "• " if typ == "ul" else f"{n_ol}. ", ("MK", self.ftag(self.default_fmt("p")),
                                                                         "P|" + typ))
            for r in b.get("runs", []):
                fmt = self.default_fmt(typ)
                for key in ("f", "z", "b", "i", "u", "s", "c", "bg"):
                    if key in r:
                        fmt[key] = r[key]
                if r.get("nb"):
                    fmt["b"] = 0
                t.insert("end-1c", r.get("x", ""), tuple(self.char_tags(fmt) + ["P|" + typ]))
            self._tag_para(start, typ, al)
            need_nl, prev, prev_al = True, typ, al
        t.edit_reset()
        t.mark_set("insert", "end-1c")

    def is_empty(self):
        return not self.t.get("1.0", "end").strip() and not self.embeds


