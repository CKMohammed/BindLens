_FONT_CACHE = {}


def font_face(name):
    """{'tk': family, 'css': css family, 'files': {'r','b','i','z': path}} - None if not on this computer."""
    if name in _FONT_CACHE:
        return _FONT_CACHE[name]
    v = FONT_FACES.get(name)
    res = None
    if isinstance(v, tuple):
        res = {"tk": v[0], "css": v[1], "files": {}}
    elif v:
        dirs = _font_dirs()
        for fam, *files in v:
            found = {}
            for key, fn in zip("rbiz", files):
                if not fn:
                    continue
                for d in dirs:
                    p = os.path.join(d, fn)
                    if os.path.exists(p):
                        found[key] = p
                        break
            if "r" in found:
                res = {"tk": fam, "css": "BL" + name, "files": found}
                break
    _FONT_CACHE[name] = res
    return res


def available_fonts():
    return [n for n in FONT_FACES if font_face(n)]


def font_css(names, fitz=None, arch=None):
    """@font-face rules for the fonts used (and add their folders to the archive)."""
    css, dirs = [], []
    for n in sorted(set(names)):
        f = font_face(n)
        if not f or not f["files"]:
            continue
        for key, path in f["files"].items():
            w = "bold" if key in "bz" else "normal"
            s = "italic" if key in "iz" else "normal"
            css.append(f'@font-face {{font-family: "{f["css"]}"; font-weight: {w}; font-style: {s}; '
                       f'src: url("{os.path.basename(path)}");}}')
            d = os.path.dirname(path)
            if d not in dirs:
                dirs.append(d)
    if arch is not None:
        for d in dirs:
            try:
                arch.add(d)
            except Exception:
                pass
    return "\n".join(css)


def css_family(name):
    f = font_face(name) or font_face("Sans")
    return f["css"] if not f["files"] else f'"{f["css"]}"'


