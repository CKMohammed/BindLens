    def _study_sheet_menu(self, scope):
        m = self._menu()
        m.add_command(label="Summary sheet as PDF…", command=lambda: self.study_sheet(scope, "pdf"))
        m.add_command(label="Summary sheet as Word…", command=lambda: self.study_sheet(scope, "docx"))
        self._popup(m, None, self.root.winfo_pointerx(), self.root.winfo_pointery())

    def study_sheet(self, scope="file", fmt="pdf"):
        """All the highlights and notes on one sheet: by document, by colour, with the page - PDF or Word."""
        import datetime
        items = self._study_items(scope)
        if not items:
            messagebox.showinfo(APP_NAME, "There are no highlights or notes here yet.")
            return
        name = (os.path.splitext(os.path.basename(items[0]["file"]))[0] if scope == "file"
                else self.lib.label(self.folder))
        blocks = [("kpis", [{"label": "Highlights", "value": str(sum(1 for i in items if i["kind"] in MARKUP))},
                            {"label": "Notes", "value": str(sum(1 for i in items if i["note"]))},
                            {"label": "Pages", "value": str(len({(i['file'], i['page']) for i in items}))}])]
        by_file = OrderedDict()
        for it in items:
            by_file.setdefault(it["file"], []).append(it)
        for f, its in by_file.items():
            if len(by_file) > 1:
                blocks.append(("h", os.path.basename(f)))
            groups = OrderedDict()
            for it in its:
                groups.setdefault(colour_name(it["color"]) if it["kind"] in MARKUP else "Notes", []).append(it)
            for gname, gits in groups.items():
                if len(groups) > 1:
                    blocks.append(("h3", gname))
                for it in gits:
                    t = it["text"] or it["note"]
                    line = f"p. {it['page']}  ·  {t}"
                    if it["text"] and it["note"]:
                        line += f"   — {it['note']}"
                    blocks.append(("li", line))
        rep = {"title": f"Summary - {name}", "subtitle": f"{datetime.date.today().strftime('%d %b %Y')} · "
                                                         f"{len(items)} highlights and notes", "blocks": blocks}
        ext = ".pdf" if fmt == "pdf" else ".docx"
        dst = filedialog.asksaveasfilename(title="Save the summary sheet", defaultextension=ext,
                                           initialfile=f"Summary - {name}{ext}",
                                           filetypes=[("PDF" if fmt == "pdf" else "Word", "*" + ext)])
        if not dst:
            return
        try:
            write_report_file(self.fitz, rep, dst, fmt, self.accent)
        except Exception as ex:
            messagebox.showerror(APP_NAME, f"The summary could not be saved:\n{ex}")
            return
        self._toast("Summary sheet saved.", action=("Open", lambda: open_in_os(dst)))

    def review_cards(self, scope="book"):
        """One card at a time: the question, then the answer - and how well you knew it decides when it comes back
        (again today, tomorrow, in 3 days, in a week…)."""
        import datetime
        cards = self._cards_due(scope)
        if not cards:
            nxt = sorted(v.get("due", "") for v in self._cards_state().values() if v.get("due"))
            messagebox.showinfo(APP_NAME, "No cards to review today." + (f"\nNext ones: {nxt[0]}." if nxt else
                                "\nHighlight text (and add a note as the question) to make cards."))
            return
        T, A = self.T, self.accent
        d = self._dialog("Review")
        d.configure(padx=24, pady=18)
        d.geometry("620x440")
        d.resizable(True, True)
        stt = self._cards_state()
        st = {"i": 0, "shown": False, "queue": list(cards), "done": 0}
        top = tk.Label(d, text="", font=self.F(9), bg=T["panel"], fg=T["muted"])
        top.pack(anchor="w")
        cardf = tk.Frame(d, bg=T["chip"], padx=20, pady=18)
        cardf.pack(fill="both", expand=True, pady=(8, 10))
        q = tk.Label(cardf, text="", font=self.F(14), bg=T["chip"], fg=T["text"], wraplength=520, justify="left")
        q.pack(anchor="w")
        a = tk.Label(cardf, text="", font=self.F(13, "bold"), bg=T["chip"], fg=A, wraplength=520, justify="left")
        a.pack(anchor="w", pady=(16, 0))
        src = tk.Label(cardf, text="", font=self.F(8), bg=T["chip"], fg=T["muted"], cursor="hand2")
        src.pack(anchor="w", side="bottom")
        bb = tk.Frame(d, bg=T["panel"])
        bb.pack(fill="x")

        def when(days):
            return "now" if days <= 0 else ("1 day" if days == 1 else f"{days} days")

        def show():
            for w_ in bb.winfo_children():
                w_.destroy()
            if not st["queue"]:
                top.configure(text="")
                q.configure(text=f"Done for today - {st['done']} card{'s' if st['done'] != 1 else ''} reviewed.")
                a.configure(text="")
                src.configure(text="")
                PillButton(bb, self, "Close", d.destroy, kind="accent", bg_key="panel").pack(side="right")
                self._cards_n_cache = None
                self._qbar_draw()
                return
            c = st["queue"][0]
            top.configure(text=f"{len(st['queue'])} to go · {st['done']} done      Keys: Space shows the answer, "
                               f"1 Again · 2 Hard · 3 Good · 4 Easy")
            q.configure(text=c["front"])
            a.configure(text=c["back"] if st["shown"] else "")
            it = c["it"]
            src.configure(text=f"{os.path.basename(it['file'])} · page {it['page']}  (click to go there)")
            src.bind("<Button-1>", lambda e, m=it["m"]: self._go_mark(m))
            if not st["shown"]:
                PillButton(bb, self, "Show the answer  (Space)", reveal, kind="accent", bg_key="panel").pack(
                    side="right")
            else:
                s0 = stt.get(c["id"], {})
                for k, lab in ((1, "Again"), (2, "Hard"), (3, "Good"), (4, "Easy")):
                    _ns, days = card_next(s0, k)
                    PillButton(bb, self, f"{lab} · {when(days)}", lambda k=k: answer(k),
                               kind="accent" if k == 3 else "soft", bg_key="panel").pack(side="left", padx=(0, 6))

        def reveal(_e=None):
            if st["queue"] and not st["shown"]:
                st["shown"] = True
                show()

        def answer(k):
            if not st["queue"] or not st["shown"]:
                return
            c = st["queue"].pop(0)
            ns, days = card_next(stt.get(c["id"], {}), k)
            stt[c["id"]] = ns
            if days <= 0:
                st["queue"].append(c)                     # again: later in this session
            else:
                st["done"] += 1
            st["shown"] = False
            self.lib.save_meta()
            show()
        d.bind("<space>", reveal)
        for k in (1, 2, 3, 4):
            d.bind(str(k), lambda e, k=k: answer(k))
        d.bind("<Escape>", lambda e: d.destroy())
        show()
        self._center(d)
        d.focus_set()
        _ = datetime

