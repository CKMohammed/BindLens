RICH_BASE = {"f": "Sans", "z": 12, "c": "#1F1F1F", "al": "l"}
H_SIZES = {"h1": 2.0, "h2": 1.5, "h3": 1.2}


def rich_from_plain(text, base=None, bold=False, italic=False):
    blocks = []
    for line in (text or "").split("\n"):
        run = {"x": line}
        if bold:
            run["b"] = 1
        if italic:
            run["i"] = 1
        blocks.append({"t": "p", "runs": [run] if line else []})
    return {"blocks": blocks, "base": dict(base or {})}


def rich_plain(doc):
    """The words of a rich text (for search and reports)."""
    out = []
    for b in (doc or {}).get("blocks", []):
        if b.get("t") == "table":
            out += [" | ".join(str(c) for c in row) for row in b.get("rows", [])]
        elif b.get("t") not in ("hr", "img", "pb"):
            out.append("".join(r.get("x", "") for r in b.get("runs", [])))
        elif b.get("t") == "img" and b.get("cap"):
            out.append(b["cap"])
    return "\n".join(out).strip()


def rich_fonts(doc, base=None):
    names = {(base or {}).get("f") or (doc or {}).get("base", {}).get("f") or "Sans"}
    for b in (doc or {}).get("blocks", []):
        for r in b.get("runs", []):
            if r.get("f"):
                names.add(r["f"])
    return names


def hex6(c, default="#1F1F1F"):
    c = (c or "").strip()
    if re.fullmatch(r"#[0-9a-fA-F]{3}", c):
        c = "#" + "".join(ch * 2 for ch in c[1:])
    return c.upper() if re.fullmatch(r"#[0-9a-fA-F]{6}", c) else default


TABLE_STYLES = OrderedDict([("grid", "Grid"), ("lines", "Lines"), ("banded", "Stripes"), ("minimal", "Minimal"),
                            ("boxed", "Box"), ("bold", "Bold header")])
TABLE_PADS = {"compact": (1.5, 3), "normal": (3, 5), "roomy": (6, 8)}


def table_cell_look(b, i, j, ncol, nrow):
    """(background, {side: (width, colour)}, bold) of a cell of a table block - used for the page AND the editor."""
    style = b.get("style", "grid")
    head = bool(b.get("head", 1)) and i == 0
    hcol = bool(b.get("hcol")) and j == 0 and not head
    fill = b.get("fill") or "#EEF0F4"
    line = b.get("line") or "#B8BCC6"
    lw = float(b.get("lw", 0.7))
    band = b.get("band") or mix(fill, "#FFFFFF", 0.55)
    bg = None
    sides = {}
    if style == "grid":
        sides = {k: (lw, line) for k in "tblr"}
        bg = fill if head else None
    elif style == "lines":
        sides = {"b": (lw, line)}
        if head:
            sides = {"b": (lw * 2, mix(line, "#000000", 0.35))}
    elif style == "banded":
        bg = fill if head else (band if (i % 2 == (0 if b.get("head", 1) else 1)) else None)
        sides = {"b": (lw * 0.6, mix(line, "#FFFFFF", 0.3))}
    elif style == "minimal":
        if head:
            sides = {"b": (lw * 1.6, mix(line, "#000000", 0.4))}
    elif style == "boxed":
        if i == 0:
            sides["t"] = (lw * 1.6, line)
        if i == nrow - 1:
            sides["b"] = (lw * 1.6, line)
        if j == 0:
            sides["l"] = (lw * 1.6, line)
        if j == ncol - 1:
            sides["r"] = (lw * 1.6, line)
        if head:
            sides["b"] = (lw, line)
            bg = fill
    elif style == "bold":
        sides = {k: (lw * 0.6, mix(line, "#FFFFFF", 0.2)) for k in "tblr"}
        bg = mix(fill, "#000000", 0.55) if head else None
    if hcol:
        bg = bg or mix(fill, "#FFFFFF", 0.35)
    cb = (b.get("cbg") or {}).get(f"{i},{j}")
    if cb:
        bg = cb
    return bg, sides, head or hcol


def table_html(b):
    """A table block -> HTML (styles, colours, column widths, alignment, merged cells, width and position)."""
    esc = html.escape
    rows = b.get("rows") or [[""]]
    ncol = max(len(r) for r in rows)
    nrow = len(rows)
    ws = list(b.get("widths") or [])
    if len(ws) != ncol or not all(isinstance(x, (int, float)) and x > 0 for x in ws):
        ws = [1.0] * ncol
    tot = sum(ws)
    pct = [100.0 * x / tot for x in ws]
    cal = list(b.get("cal") or [])
    spans = b.get("spans") or {}
    pv, ph = TABLE_PADS.get(b.get("pad", "normal"), TABLE_PADS["normal"])
    tw = max(20, min(100, int(b.get("tw", 100))))
    ml = {"l": 0, "c": (100 - tw) / 2, "r": 100 - tw}.get(b.get("tal", "l"), 0)
    fs = f"font-size:{float(b['fs']):g}pt;" if b.get("fs") else ""
    trs = []
    for i, row in enumerate(rows):
        cells, j = [], 0
        row = list(row) + [""] * (ncol - len(row))
        while j < ncol:
            span = max(1, min(ncol - j, int(spans.get(f"{i},{j}", 1))))
            bg, sides, bold = table_cell_look(b, i, j, ncol, nrow)
            st = f"padding:{pv}pt {ph}pt;width:{sum(pct[j:j + span]):.1f}%;"
            for k, nm in (("t", "top"), ("b", "bottom"), ("l", "left"), ("r", "right")):
                if k in sides:
                    st += f"border-{nm}:{sides[k][0]:.2f}pt solid {sides[k][1]};"
            if bg:
                st += f"background-color:{bg};"
                if not is_light(bg):
                    st += "color:#FFFFFF;"
            if bold:
                st += "font-weight:bold;"
            al = cal[j] if j < len(cal) and cal[j] else "l"
            st += "text-align:" + {"l": "left", "c": "center", "r": "right"}.get(al, "left") + ";"
            txt = esc(str(row[j])).replace("\n", "<br/>") or "&#160;"
            cs = f' colspan="{span}"' if span > 1 else ""
            cells.append(f'<td{cs} style="{st}">{txt}</td>')
            j += span
        trs.append(f"<tr>{''.join(cells)}</tr>")
    return (f'<table style="border-collapse:collapse;width:{tw}%;margin:2pt 0 6pt {ml:.1f}%;{fs}">' +
            "".join(trs) + "</table>")


def rich_html(doc, base=None, color=None):
    """Rich text -> (html body, css). 'color' overrides the base text colour."""
    esc = html.escape
    bs = dict(RICH_BASE)
    bs.update((doc or {}).get("base", {}))
    bs.update(base or {})
    if color:
        bs["c"] = color
    bs["c"] = hex6(bs.get("c"))
    size = float(bs.get("z", 12))
    parts, lst = [], None
    blocks = list((doc or {}).get("blocks", []))
    for b in blocks:
        t = b.get("t", "p")
        if lst and t != lst:
            parts.append(f"</{lst}>")
            lst = None
        al = {"l": "left", "c": "center", "r": "right", "j": "justify"}.get(b.get("al") or bs.get("al", "l"), "left")
        if t == "hr":
            parts.append('<hr/>')
            continue
        if t == "pb":
            continue
        if t == "img":
            w = max(10, min(100, int(b.get("w", 60))))
            parts.append(f'<p style="text-align:{al}"><img src="{esc(b.get("img", ""))}.png" '
                         f'style="width:{w}%"/></p>')
            continue
        if t == "table":
            parts.append(table_html(b))
            continue
        spans = []
        for r in b.get("runs", []):
            x = r.get("x", "")
            if not x:
                continue
            st = []
            if r.get("f"):
                st.append(f"font-family:{css_family(r['f'])}")
            if r.get("z"):
                st.append(f"font-size:{float(r['z']):g}pt")
            if r.get("c"):
                st.append(f"color:{r['c']}")
            if r.get("bg"):
                st.append(f"background-color:{r['bg']}")
            if r.get("b"):
                st.append("font-weight:bold")
            if r.get("i"):
                st.append("font-style:italic")
            dec = " ".join(d for d, k in (("underline", "u"), ("line-through", "s")) if r.get(k))
            if dec:
                st.append(f"text-decoration:{dec}")
            body = esc(x).replace("  ", " &#160;")
            spans.append(f'<span style="{";".join(st)}">{body}</span>' if st else body)
        inner = "".join(spans) or "&#160;"
        if t in ("ul", "ol"):
            if lst != t:
                parts.append(f"<{t}>")
                lst = t
            parts.append(f'<li style="text-align:{al}">{inner}</li>')
        elif t in H_SIZES:
            parts.append(f'<{t} style="text-align:{al}">{inner}</{t}>')
        elif t == "quote":
            parts.append(f'<blockquote style="text-align:{al}">{inner}</blockquote>')
        else:
            parts.append(f'<p style="text-align:{al}">{inner}</p>')
    if lst:
        parts.append(f"</{lst}>")
    css = (f"body {{font-family:{css_family(bs.get('f', 'Sans'))}; font-size:{size:g}pt; color:{bs['c']}; "
           f"line-height:1.28;}}\n"
           f"p {{margin:0 0 {size * 0.25:.1f}pt 0;}}\n"
           f"h1 {{font-size:{size * 2:.1f}pt; margin:0 0 {size * 0.4:.1f}pt 0;}}\n"
           f"h2 {{font-size:{size * 1.5:.1f}pt; margin:{size * 0.3:.1f}pt 0 {size * 0.3:.1f}pt 0;}}\n"
           f"h3 {{font-size:{size * 1.2:.1f}pt; margin:{size * 0.25:.1f}pt 0 {size * 0.2:.1f}pt 0;}}\n"
           f"ul, ol {{margin:0 0 {size * 0.3:.1f}pt 0; padding-left:{size * 1.4:.1f}pt;}}\n"
           f"li {{margin:0 0 {size * 0.12:.1f}pt 0;}}\n"
           f"blockquote {{margin:{size * 0.3:.1f}pt 0 {size * 0.4:.1f}pt {size:.1f}pt; font-style:italic; "
           f"color:{mix(bs['c'], '#FFFFFF', 0.25)};}}\n"
           f"hr {{border:0; border-top:0.8pt solid {mix(bs['c'], '#FFFFFF', 0.6)}; margin:{size * 0.4:.1f}pt 0;}}\n")
    css += font_css(rich_fonts(doc, bs))
    return "".join(parts), css


def rich_archive(fitz, doc, base=None, images_dir=None):
    arch = fitz.Archive()
    font_css(rich_fonts(doc, base), arch=arch)
    if images_dir and os.path.isdir(images_dir):
        try:
            arch.add(images_dir)
        except Exception:
            pass
    return arch


def html_into(fitz, page, rect, doc, base=None, color=None, images_dir=None, shrink=True):
    """Write rich text in a box. Returns the height it used."""
    body, css = rich_html(doc, base, color)
    arch = rich_archive(fitz, doc, base, images_dir)
    try:
        spare, scale = page.insert_htmlbox(rect, body, css=css, archive=arch, scale_low=0 if shrink else 1)
    except Exception:
        txt = rich_plain(doc)
        page.insert_textbox(rect, txt, fontsize=float((base or {}).get("z", 12)), color=_rgb(color or "#1F1F1F"),
                            fontname=full_font(page, "helv", txt))
        return rect.height
    if spare < 0:
        return rect.height
    return rect.height - spare


def html_height(fitz, doc, width, base=None, images_dir=None):
    """How tall a rich text is, written in a box of this width."""
    tmp = fitz.open()
    pg = tmp.new_page(width=width + 20, height=4000)
    h = html_into(fitz, pg, fitz.Rect(0, 0, width, 4000), doc, base, images_dir=images_dir, shrink=False)
    tmp.close()
    return h


# ---- the meta data BindLens keeps in its marks ---------------------------------------------------------
def annot_meta(a):
    """BindLens' own data of a mark: {'card': spec} / {'note': text}. Old files kept it in Subject/Contents."""
    try:
        doc = a.parent.parent
        typ, val = doc.xref_get_key(a.xref, BL_KEY)
        if typ == "string" and val:
            m = json.loads(val)
            if isinstance(m, dict):
                return m
    except Exception:
        pass
    try:
        info = a.info
    except Exception:
        return {}
    subj = info.get("subject") or ""
    content = (info.get("content") or "").strip()
    if subj.startswith("BindLens card|"):
        try:
            return {"card": json.loads(subj.split("|", 1)[1]), "legacy": 1}
        except Exception:
            pass
    if subj.startswith("BindLens box|") or subj.startswith("BindLens text|"):
        return {"box": subj, "text": content, "legacy": 1}
    return {"note": content} if content else {}


def card_plain_text(spec):
    k = (spec or {}).get("kind")
    if k == "sign":
        return ("Signature " + spec.get("name_text", "")).strip()
    if k == "image":
        return spec.get("text", "") or "Picture"
    if k in ("note", "box"):
        t = rich_plain(spec.get("doc")) if spec.get("doc") else spec.get("text", "")
        return t
    return " ".join(x for x in (spec.get("text", ""), spec.get("date_text", "")) if x)


def meta_text(meta):
    if meta.get("card"):
        return card_plain_text(meta["card"])
    return meta.get("note") or meta.get("text") or ""


def _is_cover(a):
    """A white box / white brush of BindLens (3.1) - by its data, or by how it looks (white, no line)."""
    try:
        if annot_meta(a).get("cover"):
            return True
        if a.type[1] in ("Square", "Ink"):
            c = a.colors or {}
            white = lambda v: v and all(x > 0.985 for x in v)
            return white(c.get("stroke")) and (a.type[1] == "Ink" or white(c.get("fill")))
    except Exception:
        pass
    return False


def erase_under_covers(fitz, doc):
    """3.2: in a copy that leaves BindLens (email, read-only copy, one PDF, saved pages) the PDF's own text under
    the white boxes and brushes is erased for good - so nobody can uncover it. Returns how many were made final."""
    n = 0
    for page in doc:
        try:
            covers = [a for a in page.annots() if _is_cover(a)]
        except Exception:
            covers = []
        if not covers:
            continue
        rects = []
        for a in covers:
            try:
                if a.type[1] == "Ink":
                    w_ = float((a.border or {}).get("width") or 16) / 2
                    for stroke in a.vertices or []:
                        for q in stroke:
                            rects.append(fitz.Rect(q[0] - w_, q[1] - w_, q[0] + w_, q[1] + w_))
                else:
                    rects.append(fitz.Rect(a.rect))
            except Exception:
                continue
        for a in covers:
            try:
                page.delete_annot(a)
            except Exception:
                pass
        for r in rects:
            page.add_redact_annot(r, fill=(1, 1, 1))
        try:
            page.apply_redactions(images=2, graphics=0)
        except TypeError:
            page.apply_redactions(images=0)
        except Exception:
            continue
        n += len(covers)
    return n


def lock_annot(fitz, a, meta):
    """Our marks in other PDF readers: shown and printed, but locked - nothing to edit, no comment bubble."""
    doc = a.parent.parent
    now = fitz.get_pdf_now()
    try:
        created = a.info.get("creationDate") or now
    except Exception:
        created = now
    a.set_info(title=APP_NAME, content="", subject="", creationDate=created, modDate=now)
    try:
        a.set_flags(fitz.PDF_ANNOT_IS_PRINT | fitz.PDF_ANNOT_IS_LOCKED | fitz.PDF_ANNOT_IS_LOCKED_CONTENTS |
                    fitz.PDF_ANNOT_IS_READ_ONLY)
    except Exception:
        pass
    a.update()
    for key in ("Contents", "Popup", "RC", "Subj"):
        try:
            if doc.xref_get_key(a.xref, key)[0] != "null":
                doc.xref_set_key(a.xref, key, "null")
        except Exception:
            pass
    doc.xref_set_key(a.xref, BL_KEY, "<" + json.dumps(meta, separators=(",", ":")).encode("utf-8").hex() + ">")


def _hand_font():
    f = font_face("Handwriting")
    return f["files"].get("r") if f and f["files"] else None


def _rgb(h):
    return hex_to_rgb01(h)


def _text_fit(page, rect, text, font, size, color, align, morph, bold=False):
    """Write plain text in a box, making it smaller until it fits (stamps, watermarks)."""
    fam = {"Sans": ("helv", "hebo"), "Serif": ("tiro", "tibo"), "Mono": ("cour", "cobo")}.get(font)
    kw = {}
    if fam is None:
        f = font_face(font)
        fp = (f or {}).get("files", {}).get("b" if bold else "r") or (f or {}).get("files", {}).get("r")
        kw = {"fontfile": fp, "fontname": "F" + re.sub(r"\W", "", font)} if fp else {"fontname": "hebo" if bold
                                                                                      else "helv"}
    else:
        kw = {"fontname": fam[1] if bold else fam[0]}
    if kw.get("fontname") and not kw.get("fontfile"):
        kw["fontname"] = full_font(page, kw["fontname"], text)      # 4.2: € “ ” – … never lost
    sz = size
    while sz >= 5:
        tw = page.new_shape()
        rc = tw.insert_textbox(rect, text, fontsize=sz, color=color, align=align, morph=morph, **kw)
        if rc >= 0:
            tw.commit()
            return sz
        sz -= 1
    tw = page.new_shape()
    tw.insert_textbox(rect, text, fontsize=5, color=color, align=align, morph=morph, **kw)
    tw.commit()
    return 5


def card_pad(spec):
    k = spec.get("kind", "note")
    if k == "note":
        return 18
    if k == "box" and is_shape(spec):
        if spec.get("glow"):
            return 15
        return 12 if spec.get("shadow") or spec.get("raised") else 6
    if k == "box":
        return 12 if spec.get("look") in ("card", "speech", "thought", "callout", "banner", "torn") or \
            spec.get("shadow") else 6
    return 6


def box_text_rect(fitz, spec, r):
    """Where the words go inside a text box of this look."""
    look = spec.get("look", "plain")
    if look in SHAPE_FRAC:
        fw, fh = SHAPE_FRAC[look]
        bw = float(spec.get("bw", 1.5))
        pad = 7 + bw
        cx = (r.x0 + r.x1) / 2 - (r.width * 0.07 if look == "s_arrow" else 0) - \
            (r.width * 0.04 if look == "s_banner" else 0)
        cy = (r.y0 + r.y1) / 2 + (r.height * 0.05 if look == "s_star" else 0)
        hw, hh = max(8.0, r.width * fw / 2 - pad), max(6.0, r.height * fh / 2 - pad * 0.7)
        return fitz.Rect(cx - hw, cy - hh, cx + hw, cy + hh)
    p = {"plain": (2, 2, 2, 2), "heading": (2, 2, 2, 8), "marker": (6, 4, 6, 4), "badge": (14, 5, 14, 5),
         "banner": (22, 7, 22, 7), "tag": (24, 7, 10, 7), "quote": (30, 8, 12, 8), "torn": (10, 14, 10, 10)}.get(
        look, (10, 8, 10, 8))
    if look in ("info", "warning", "tip", "check"):
        p = (36, 9, 10, 9)
    x0, y0, x1, y1 = r.x0 + p[0], r.y0 + p[1], r.x1 - p[2], r.y1 - p[3]
    if look == "thought":
        x0 += r.width * 0.11
        x1 -= r.width * 0.11
        y0 += 10
        y1 -= 8
    if look in ("speech", "callout", "thought"):
        tail = spec.get("tail", "bl")
        if tail in ("bl", "br"):
            y1 -= 16
        elif tail in ("tl", "tr"):
            y0 += 16
        elif tail == "l":
            x0 += 16
        else:
            x1 -= 16
    return fitz.Rect(x0, y0, max(x0 + 10, x1), max(y0 + 8, y1))


def box_extra(spec):
    """Extra height/width a look adds around the words (tails, icons, padding)."""
    look = spec.get("look", "plain")
    if look in SHAPE_FRAC:
        fw, fh = SHAPE_FRAC[look]
        w = float(spec.get("w", 160))
        bw = float(spec.get("bw", 1.5))
        return w - max(16.0, w * fw - 2 * (7 + bw)), 2 * (7 + bw)
    ph = {"plain": 4, "heading": 10, "marker": 8, "badge": 10, "banner": 14, "tag": 14, "quote": 16,
          "torn": 24}.get(look, 16)
    pw = {"plain": 4, "heading": 4, "marker": 12, "badge": 28, "banner": 44, "tag": 34, "quote": 42}.get(look, 20)
    if look in ("info", "warning", "tip", "check"):
        pw = 46
    if look == "thought":
        pw += float(spec.get("w", 220)) * 0.22
        ph += 18
    if look in ("speech", "callout", "thought"):
        if spec.get("tail", "bl") in ("l", "r"):
            pw += 16
        else:
            ph += 16
    return pw, ph


def _soft_shadow(page, fitz, r, radius=0.0, strength=1.0, dx=2, dy=4):
    sh = page.new_shape()
    for k, op in ((7, 0.035), (5, 0.05), (3, 0.07), (1.5, 0.09)):
        rr = fitz.Rect(r.x0 - k * 0.4 + dx, r.y0 - k * 0.2 + dy, r.x1 + k * 0.4 + dx, r.y1 + k * 0.6 + dy)
        sh.draw_rect(rr, radius=radius or None)
        sh.finish(color=None, fill=(0, 0, 0), fill_opacity=op * strength)
    sh.commit()


def _poly(page, pts, fill=None, color=None, width=1, fill_opacity=1, stroke_opacity=1, dashes=None, close=True):
    sh = page.new_shape()
    sh.draw_polyline(pts + ([pts[0]] if close else []))
    sh.finish(color=color, fill=fill, width=width, fill_opacity=fill_opacity, stroke_opacity=stroke_opacity,
              closePath=close, dashes=dashes, lineJoin=1, lineCap=1)
    sh.commit()


def _draw_note_flat(fitz, page, r, spec, images_dir):
    import math
    import random
    col = spec.get("color", "#FFE066")
    w, h = r.width, r.height
    # 1.5 notes had one 'style'; now looks combine: something holding it + paper effects
    style = spec.get("style")
    attach = spec.get("attach") or {"pinned": "pin", "taped": "tape"}.get(style, "none" if style else "pin")
    paper = set(spec.get("paper") or (["fold"] if style == "folded" else []))
    curl = "curl" in paper
    # shadow: lifted corners when curled
    sh = page.new_shape()
    for k, op in ((6, 0.04), (4, 0.06), (2, 0.08)):
        if curl:
            sh.draw_polyline([(r.x0 + 2, r.y0 + 4), (r.x1 + 2, r.y0 + 4), (r.x1 + k * 0.9, r.y1 + k * 1.3),
                              ((r.x0 + r.x1) / 2, r.y1 + k * 0.2), (r.x0 + 1 - k * 0.2, r.y1 + k * 1.3),
                              (r.x0 + 2, r.y0 + 4)])
            sh.finish(color=None, fill=(0, 0, 0), fill_opacity=op * 1.3, closePath=True)
        else:
            sh.draw_rect(fitz.Rect(r.x0 + 1 - k * 0.3, r.y0 + 3, r.x1 + 2 + k * 0.4, r.y1 + 3 + k * 0.6))
            sh.finish(color=None, fill=(0, 0, 0), fill_opacity=op * 1.4)
    sh.commit()
    f = min(26, w * 0.18)
    top = []
    if "torn" in paper:
        rnd = random.Random(int(w * 7 + h))
        x = r.x0
        while x < r.x1:
            top.append((x, r.y0 + rnd.uniform(0, 4)))
            x += rnd.uniform(4, 8)
        top.append((r.x1, r.y0 + 2))
    else:
        top = [(r.x0, r.y0), (r.x1, r.y0)]
    if "fold" in paper:
        outline = top + [(r.x1, r.y1 - f), (r.x1 - f, r.y1), (r.x0, r.y1)]
    else:
        outline = top + [(r.x1, r.y1), (r.x0, r.y1)]
    _poly(page, outline, fill=_rgb(col))
    # light at the top, a little darker at the bottom: paper, not plastic
    sh = page.new_shape()
    sh.draw_rect(fitz.Rect(r.x0, r.y0, r.x1, r.y0 + h * 0.25))
    sh.finish(color=None, fill=(1, 1, 1), fill_opacity=0.16)
    sh.draw_rect(fitz.Rect(r.x0, r.y1 - h * 0.18, r.x1 - (f if "fold" in paper else 0), r.y1))
    sh.finish(color=None, fill=(0, 0, 0), fill_opacity=0.035)
    sh.commit()
    if curl:
        k = min(22, w * 0.14)
        _poly(page, [(r.x1, r.y1 - k), (r.x1, r.y1), (r.x1 - k, r.y1)], fill=_rgb(mix(col, "#000000", 0.10)))
        _poly(page, [(r.x1, r.y1 - k), (r.x1 - k * 0.55, r.y1 - k * 0.55), (r.x1 - k, r.y1)],
              fill=_rgb(mix(col, "#FFFFFF", 0.35)))
    if "fold" in paper:
        _poly(page, [(r.x1, r.y1 - f), (r.x1 - f, r.y1 - f), (r.x1 - f, r.y1)], fill=_rgb(mix(col, "#000000", 0.18)))
        _poly(page, [(r.x1, r.y1 - f), (r.x1 - f, r.y1)], color=_rgb(mix(col, "#000000", 0.25)), width=0.5,
              close=False)
    head = 24 if attach in ("pin", "tape", "magnet") else (20 if attach == "clip" else 10)
    if "lines" in paper or "grid" in paper:
        sh = page.new_shape()
        lc = _rgb(mix(col, "#2F6FB0", 0.35))
        y = r.y0 + head + 14
        while y < r.y1 - 6:
            sh.draw_line((r.x0 + 6, y), (r.x1 - 6, y))
            y += 15
        if "grid" in paper:
            x = r.x0 + 10
            while x < r.x1 - 4:
                sh.draw_line((x, r.y0 + head), (x, r.y1 - 4))
                x += 15
        sh.finish(color=lc, width=0.45, stroke_opacity=0.55)
        if "lines" in paper and "grid" not in paper:
            sh.draw_line((r.x0 + 22, r.y0 + 6), (r.x0 + 22, r.y1 - 4))
            sh.finish(color=(0.86, 0.36, 0.36), width=0.6, stroke_opacity=0.6)
        sh.commit()
    # picture inside the note
    tr = fitz.Rect(r.x0 + 11, r.y0 + head, r.x1 - 10, r.y1 - 8)
    img = spec.get("img")
    ipath = os.path.join(images_dir or "", img + ".png") if img else None
    if ipath and os.path.exists(ipath):
        pos = spec.get("img_pos", "top")
        txt = (rich_plain(spec.get("doc")) if spec.get("doc") else spec.get("text", "")).strip()
        size = float(spec.get("img_size") or (0.45 if pos == "left" else 0.58))
        size = max(0.2, min(0.9, size))
        if pos == "full" or not txt:
            ir = fitz.Rect(tr.x0, tr.y0, tr.x1, tr.y1 - (0 if not txt else 0))
            tr = None if not txt else fitz.Rect(tr.x0, tr.y1 - 20, tr.x1, tr.y1)
            if tr is not None:
                ir.y1 -= 22
        elif pos == "left":
            ir = fitz.Rect(tr.x0, tr.y0, tr.x0 + tr.width * size, tr.y1)
            tr = fitz.Rect(ir.x1 + 8, tr.y0, tr.x1, tr.y1)
        else:
            ir = fitz.Rect(tr.x0, tr.y0, tr.x1, tr.y0 + tr.height * size)
            tr = fitz.Rect(tr.x0, ir.y1 + 6, tr.x1, tr.y1)
        try:
            pix = fitz.Pixmap(ipath)
            pw, ph = pix.width, pix.height
            fill = spec.get("img_fit") == "fill"
            zoom = max(1.0, min(5.0, float(spec.get("img_zoom", 1.0))))
            s_ = (max if fill else min)(ir.width / pw, ir.height / ph) * zoom
            dw, dh = pw * s_, ph * s_                 # the whole photo at this size
            bw, bh = min(dw, ir.width), min(dh, ir.height)
            box = fitz.Rect(ir.x0 + (ir.width - bw) / 2, ir.y0 + (ir.height - bh) / 2,
                            ir.x0 + (ir.width + bw) / 2, ir.y0 + (ir.height + bh) / 2)
            vw, vh = min(pw, bw / s_), min(ph, bh / s_)   # the part of the photo that shows
            cx = max(0.0, min(1.0, float(spec.get("img_cx", 0.5))))
            cy = max(0.0, min(1.0, float(spec.get("img_cy", 0.5))))
            sx0 = max(0.0, min(pw - vw, cx * pw - vw / 2))
            sy0 = max(0.0, min(ph - vh, cy * ph - vh / 2))
            NOTE_PHOTO_GEOM[img] = {"dw": dw, "dh": dh, "free_x": dw > bw + 0.5, "free_y": dh > bh + 0.5}
            if spec.get("img_frame", True):
                fr = box + (-3, -3, 3, 3)
                sh = page.new_shape()
                sh.draw_rect(fr + (1, 2, 1.5, 2.5))
                sh.finish(color=None, fill=(0, 0, 0), fill_opacity=0.12)
                sh.draw_rect(fr)
                sh.finish(color=None, fill=(1, 1, 1))
                sh.commit()
            clip = fitz.IRect(int(sx0), int(sy0), int(round(sx0 + vw)), int(round(sy0 + vh))) & \
                fitz.IRect(0, 0, pw, ph)
            if clip.width >= pw - 1 and clip.height >= ph - 1:
                page.insert_image(box, filename=ipath)
            else:                                      # a part of the photo (zoomed in / filling the space)
                part = fitz.Pixmap(pix.colorspace, clip, pix.alpha)
                part.copy(pix, clip)
                part.set_origin(0, 0)
                page.insert_image(box, pixmap=part)
        except Exception:
            pass
    if tr is not None:
        doc = spec.get("doc") or rich_from_plain(spec.get("text", ""), bold=spec.get("bold"),
                                                 italic=spec.get("italic"))
        base = {"f": spec.get("font", "Sans"), "z": spec.get("size", 12), "c": spec.get("tc") or "#222226",
                "al": {0: "l", 1: "c", 2: "r", 3: "j"}.get(spec.get("align", 0), "l")}
        html_into(fitz, page, tr, doc, base, images_dir=images_dir)
    # what holds the note
    cx = (r.x0 + r.x1) / 2
    if attach == "pin":
        pc = fitz.Point(cx, r.y0 + 10)
        pin = spec.get("pin", "#E53935")
        sh = page.new_shape()
        sh.draw_line(pc + (1, 1), pc + (5, 9))
        sh.finish(color=(0.35, 0.35, 0.38), width=1.2, stroke_opacity=0.6)
        sh.draw_circle(pc + (2.5, 3.5), 6.8)
        sh.finish(color=None, fill=(0, 0, 0), fill_opacity=0.22)
        sh.draw_circle(pc, 6.8)
        sh.finish(color=_rgb(mix(pin, "#000000", 0.3)), width=0.6, fill=_rgb(pin))
        sh.draw_circle(pc + (-2.2, -2.2), 2.4)
        sh.finish(color=None, fill=(1, 1, 1), fill_opacity=0.65)
        sh.commit()
    elif attach == "magnet":
        pc = fitz.Point(cx, r.y0 + 9)
        mc = spec.get("pin", "#2F80ED")
        sh = page.new_shape()
        sh.draw_circle(pc + (1.5, 2.5), 10)
        sh.finish(color=None, fill=(0, 0, 0), fill_opacity=0.2)
        sh.draw_circle(pc, 10)
        sh.finish(color=None, fill=_rgb(mix(mc, "#000000", 0.15)))
        sh.draw_circle(pc + (0, -1), 8.5)
        sh.finish(color=None, fill=_rgb(mc))
        sh.draw_oval(fitz.Rect(pc.x - 6, pc.y - 7.5, pc.x + 2, pc.y - 3))
        sh.finish(color=None, fill=(1, 1, 1), fill_opacity=0.45)
        sh.commit()
    elif attach == "tape":
        t = fitz.Rect(cx - w * 0.19, r.y0 - 8, cx + w * 0.19, r.y0 + 10)
        tmp_doc = fitz.open()
        tp = tmp_doc.new_page(width=t.width, height=t.height)
        rnd = random.Random(int(w))
        pts = [(0, 0)]
        y = 0
        while y < t.height:
            pts.append((rnd.uniform(0, 2.5), y))
            y += 3
        pts += [(0, t.height), (t.width, t.height)]
        y = t.height
        while y > 0:
            pts.append((t.width - rnd.uniform(0, 2.5), y))
            y -= 3
        pts.append((t.width, 0))
        _poly(tp, pts, fill=(0.97, 0.95, 0.86), fill_opacity=0.78)
        sh = tp.new_shape()
        sh.draw_rect(fitz.Rect(0, 0, t.width, t.height * 0.4))
        sh.finish(color=None, fill=(1, 1, 1), fill_opacity=0.25)
        sh.commit()
        page.show_pdf_page(fitz.Rect(t.x0 - 4, t.y0 - 6, t.x1 + 4, t.y1 + 6), tmp_doc, 0, rotate=3)
        tmp_doc.close()
    elif attach == "clip":
        x = r.x1 - max(20, w * 0.13)
        y0 = r.y0 - 12
        sh = page.new_shape()
        for dx, dy, col_, wd in ((1.4, 1.6, (0, 0, 0), 2.4), (0, 0, (0.62, 0.64, 0.68), 2.0),
                                 (-0.4, -0.4, (0.9, 0.91, 0.93), 0.7)):
            pts = [(x + 8 + dx, y0 + 26 + dy), (x + 8 + dx, y0 + 4 + dy)]
            sh.draw_polyline(pts)
            sh.draw_bezier((x + 8 + dx, y0 + 4 + dy), (x + 8 + dx, y0 - 2 + dy), (x + dx, y0 - 2 + dy),
                           (x + dx, y0 + 4 + dy))
            sh.draw_line((x + dx, y0 + 4 + dy), (x + dx, y0 + 30 + dy))
            sh.draw_bezier((x + dx, y0 + 30 + dy), (x + dx, y0 + 36 + dy), (x + 11 + dx, y0 + 36 + dy),
                           (x + 11 + dx, y0 + 30 + dy))
            sh.draw_line((x + 11 + dx, y0 + 30 + dy), (x + 11 + dx, y0 + 8 + dy))
            sh.finish(color=col_, width=wd, closePath=False, stroke_opacity=0.25 if col_ == (0, 0, 0) else 1,
                      lineCap=1)
        sh.commit()


def _box_icon(page, fitz, look, c, col):
    """Small round icon for info / warning / tip / done boxes."""
    sh = page.new_shape()
    sh.draw_circle(c, 9.5)
    sh.finish(color=None, fill=_rgb(col))
    sh.commit()
    sh = page.new_shape()
    if look == "info":
        sh.draw_line(c + (0, -1.5), c + (0, 5))
        sh.finish(color=(1, 1, 1), width=2.2, lineCap=1)
        sh.draw_circle(c + (0, -5), 1.4)
        sh.finish(color=None, fill=(1, 1, 1))
    elif look == "warning":
        sh.draw_line(c + (0, -5.5), c + (0, 1.5))
        sh.finish(color=(1, 1, 1), width=2.2, lineCap=1)
        sh.draw_circle(c + (0, 5), 1.4)
        sh.finish(color=None, fill=(1, 1, 1))
    elif look == "tip":
        sh.draw_circle(c + (0, -1.5), 4.2)
        sh.finish(color=(1, 1, 1), width=1.6)
        sh.draw_line(c + (-2, 4.8), c + (2, 4.8))
        sh.finish(color=(1, 1, 1), width=1.6, lineCap=1)
    else:
        sh.draw_polyline([c + (-4.5, 0.2), c + (-1.2, 3.6), c + (4.8, -3.6)])
        sh.finish(color=(1, 1, 1), width=2.2, lineCap=1, lineJoin=1, closePath=False)
    sh.commit()


SHAPE_GRADS = OrderedDict([("", "No gradient"), ("v", "Top to bottom"), ("h", "Left to right"),
                           ("d", "Corner to corner"), ("r", "From the middle")])
SHAPE_SEE = [(1.0, "Solid"), (0.85, "A little see-through"), (0.6, "Half see-through"), (0.35, "Very see-through")]


def shape_color2(spec):
    """The second colour of a gradient (yours, or a deeper shade of the fill)."""
    c2 = spec.get("color2")
    if c2:
        return c2
    fill = spec.get("color", "#FFFFFF")
    if fill in ("none", "") or fill.upper() == "#FFFFFF":
        return "#D5DAE3"
    rr, gg, bb = hex_to_rgb01(fill)
    if 0.3 * rr + 0.59 * gg + 0.11 * bb < 0.18:      # nearly black: go lighter instead
        return mix(fill, "#FFFFFF", 0.35)
    return mix(fill, "#000000", 0.32)


def shape_glow_color(spec):
    fill = spec.get("color", "#FFFFFF")
    if spec.get("glow_c"):
        return spec["glow_c"]
    if fill not in ("none", "") and not (is_light(fill) and max(hex_to_rgb01(fill)) - min(hex_to_rgb01(fill)) < 0.12):
        return fill
    bc = spec.get("bc", "#1F1F1F")
    return bc if float(spec.get("bw", 1.5)) > 0 else "#2F80ED"


def _shape_picture(fitz, page, rr, outline, op, colors=None, mode="v"):
    """Paint a gradient (or a glossy shine) cut exactly to the shape: a picture with the shape as its mask."""
    W, H = rr.width, rr.height
    if W < 2 or H < 2:
        return
    m = 2.0                                           # a dark margin, so no thin line shows at the picture's edge
    PW, PH = W + 2 * m, H + 2 * m
    S = max(1.0, min(4.0, 1800.0 / max(PW, PH)))
    big = fitz.Rect(-10, -10, PW + 10, PH + 10)
    local = fitz.Rect(m, m, m + W, m + H)
    tmp, tmp2 = fitz.open(), fitz.open()
    try:
        cp = tmp.new_page(width=PW, height=PH)        # the colours
        mp = tmp2.new_page(width=PW, height=PH)       # how much shows (white = all)
        sh = cp.new_shape()
        ms = mp.new_shape()
        ms.draw_rect(big)
        ms.finish(color=None, fill=(0, 0, 0))
        n = 64
        if mode == "gloss":
            sh.draw_rect(big)
            sh.finish(color=None, fill=(1, 1, 1))
            sh.commit()
            top = H * 0.50
            for i in range(n):
                y0 = m + top * i / n
                g = 0.62 - 0.50 * i / (n - 1)
                ms.draw_rect(fitz.Rect(0, y0, PW, y0 + top / n + 0.5))
                ms.finish(color=None, fill=(g, g, g))
            ms.draw_rect(big)                         # cut away everything outside the shape
            outline(ms, local)
            ms.finish(color=None, fill=(0, 0, 0), even_odd=True, closePath=True)
        else:
            c1, c2 = colors
            sh.draw_rect(big)
            sh.finish(color=None, fill=_rgb(c2 if mode != "r" else c2))
            for i in range(n):
                t = i / (n - 1)
                col = _rgb(mix(c1, c2, t))
                if mode == "h":
                    x0 = m + W * i / n
                    sh.draw_rect(fitz.Rect(x0 if i else -10, -10, x0 + W / n + 0.8, PH + 10))
                elif mode == "d":
                    a0, a1 = 2.0 * i / n, 2.0 * (i + 1) / n + 0.02
                    sh.draw_polyline([(m + a0 * W, m), (m + a1 * W, m), (m, m + a1 * H), (m, m + a0 * H),
                                      (m + a0 * W, m)])
                elif mode == "r":
                    k = 1.45 * (1 - i / n)
                    cx, cy = m + W / 2, m + H / 2
                    sh.draw_oval(fitz.Rect(cx - W / 2 * k, cy - H / 2 * k, cx + W / 2 * k, cy + H / 2 * k))
                    col = _rgb(mix(c2, c1, t))
                else:
                    y0 = m + H * i / n
                    sh.draw_rect(fitz.Rect(-10, y0 if i else -10, PW + 10, y0 + H / n + 0.8))
                sh.finish(color=None, fill=col, closePath=True)
            sh.commit()
            if mode == "d":                           # the first corner
                sh = cp.new_shape()
                sh.draw_polyline([(-10, -10), (m + 0.03 * W, -10), (-10, m + 0.03 * H)])
                sh.finish(color=None, fill=_rgb(c1), closePath=True)
                sh.commit()
            outline(ms, local)
            ms.finish(color=None, fill=(op, op, op), closePath=True)
        ms.commit()
        mat = fitz.Matrix(S, S)
        cpix = cp.get_pixmap(matrix=mat, alpha=False)
        mpix = mp.get_pixmap(matrix=mat, colorspace=fitz.csGRAY, alpha=False)
        page.insert_image(rr + (-m, -m, m, m), pixmap=fitz.Pixmap(cpix, mpix))
    finally:
        tmp.close()
        tmp2.close()


def _draw_shape_flat(fitz, page, r, spec, images_dir):
    """A shape filled with colour, with a border, and words in the middle."""
    look = spec.get("look", "s_rect")
    fill = spec.get("color", "#FFFFFF")
    bc = spec.get("bc", "#1F1F1F")
    bw = max(0.0, float(spec.get("bw", 1.5)))
    op = float(spec.get("op", 1.0))
    inner = fitz.Rect(r.x0 + bw / 2, r.y0 + bw / 2, r.x1 - bw / 2, r.y1 - bw / 2)
    filled = bool(fill) and fill != "none"
    rad_pt = float(spec.get("radius", 14) or 14)

    def outline(sh, rr):
        if look == "s_ellipse":
            sh.draw_oval(rr)
        elif look in ("s_rect", "s_round"):
            rad = min(0.5, rad_pt / max(1, min(rr.width, rr.height))) if look == "s_round" else None
            sh.draw_rect(rr, radius=rad)
        else:
            sh.draw_polyline(shape_points(look, rr) + [shape_points(look, rr)[0]])
    if spec.get("shadow"):
        sh = page.new_shape()
        for k, o in ((5, 0.05), (3, 0.07), (1.5, 0.09)):
            outline(sh, inner + (k * 0.2 + 1.5, k * 0.4 + 3, k * 0.4 + 1.5, k * 0.6 + 3))
            sh.finish(color=None, fill=(0, 0, 0), fill_opacity=o, closePath=True)
        sh.commit()
    if spec.get("glow"):                              # a soft halo of colour around the shape
        gc = _rgb(shape_glow_color(spec))
        sh = page.new_shape()
        for wd, o in [(w_, 0.035) for w_ in range(22, 1, -2)]:
            outline(sh, inner)
            sh.finish(color=gc, width=wd + bw, stroke_opacity=o, closePath=True, lineJoin=1)
        sh.commit()
    if spec.get("raised"):                            # 3D: the shape stands on a darker block
        dc = _rgb(mix(fill if filled else bc, "#000000", 0.38))
        sh = page.new_shape()
        for k in (5, 4, 3, 2, 1):
            outline(sh, inner + (k * 0.9, k * 0.9, k * 0.9, k * 0.9))
        sh.finish(color=dc if bw > 0 else None, width=bw or 0, fill=dc, fill_opacity=max(op, 0.35),
                  closePath=True, lineJoin=1)
        sh.commit()
    grad = spec.get("grad") or ""
    if filled and grad:                               # a gradient: drawn as a picture cut to the shape
        _shape_picture(fitz, page, inner, outline, op, colors=(fill, shape_color2(spec)), mode=grad)
    sh = page.new_shape()
    outline(sh, inner)
    kw = {}
    if filled and not grad:
        kw.update(fill=_rgb(fill), fill_opacity=op)
    dash = spec.get("dash") or ""
    if dash == "dash":
        kw.update(dashes="[%g %g] 0" % (max(4, bw * 3), max(3, bw * 2)))
    elif dash == "dot":
        kw.update(dashes="[0 %g] 0" % max(2.5, bw * 2), lineCap=1)
    if spec.get("gloss") and filled:
        if "fill" in kw:
            sh.finish(color=None, closePath=True, lineJoin=1, fill=kw["fill"], fill_opacity=kw["fill_opacity"])
            sh.commit()
        k = 1.2 + bw / 2
        _shape_picture(fitz, page, inner + (k, k, -k, -k), outline, 1.0, mode="gloss")
        sh = page.new_shape()
        kw.pop("fill", None)
        kw.pop("fill_opacity", None)
        if bw > 0:
            outline(sh, inner)
            sh.finish(color=_rgb(bc), width=bw, closePath=True, lineJoin=1, **kw)
    else:
        sh.finish(color=_rgb(bc) if bw > 0 else None, width=bw or 0, closePath=True, lineJoin=1, **kw)
    sh.commit()
    doc = spec.get("doc") or rich_from_plain(spec.get("text", ""))
    if not rich_plain(doc).strip():
        return
    tr = box_text_rect(fitz, spec, r)
    base = {"f": spec.get("font", "Sans"), "z": spec.get("size", 14), "c": box_text_color(spec),
            "al": spec.get("al", "c")}
    th = html_height(fitz, doc, tr.width, base, images_dir)
    if th < tr.height:                                 # the words in the middle
        tr = fitz.Rect(tr.x0, tr.y0 + (tr.height - th) / 2, tr.x1, tr.y0 + (tr.height + th) / 2 + 2)
    html_into(fitz, page, tr, doc, base, images_dir=images_dir)


def _draw_box_flat(fitz, page, r, spec, images_dir):
    import math
    import random
    look = spec.get("look", "plain")
    if look in SHAPE_LOOKS:
        return _draw_shape_flat(fitz, page, r, spec, images_dir)
    col = spec.get("color", "#2F80ED")
    op = float(spec.get("op", 1.0))
    rad = float(spec.get("radius", 8 if look not in ("plain", "heading", "marker", "banner", "tag", "torn") else 0))
    tc = spec.get("tc")
    light = mix(col, "#FFFFFF", 0.86)
    if look in ("card", "speech", "callout", "torn") or (spec.get("shadow") and look != "thought"):
        sr = fitz.Rect(r)
        if look in ("speech", "callout"):
            tail = spec.get("tail", "bl")
            if tail in ("bl", "br"):
                sr.y1 -= 16
            elif tail in ("tl", "tr"):
                sr.y0 += 16
            elif tail == "l":
                sr.x0 += 16
            else:
                sr.x1 -= 16
            rad = 12
        _soft_shadow(page, fitz, sr, radius=min(0.5, rad / max(1, min(sr.width, sr.height))) if rad else 0,
                     strength=0.9)
    sh = page.new_shape()
    rr = min(0.5, rad / max(1, min(r.width, r.height))) if rad else 0
    if look == "outline":
        sh.draw_rect(r, radius=rr or None)
        sh.finish(color=_rgb(col), width=1.4)
    elif look == "dashed":
        sh.draw_rect(r, radius=rr or None)
        sh.finish(color=_rgb(col), width=1.4, dashes="[4 3] 0")
    elif look == "double":
        sh.draw_rect(r, radius=rr or None)
        sh.finish(color=_rgb(col), width=1.6)
        sh.draw_rect(r + (3.5, 3.5, -3.5, -3.5), radius=rr or None)
        sh.finish(color=_rgb(col), width=0.7)
    elif look == "label":
        sh.draw_rect(r, radius=rr or None)
        sh.finish(color=_rgb(mix(col, "#FFFFFF", 0.4)), width=1, fill=_rgb(light), fill_opacity=op)
    elif look == "solid":
        sh.draw_rect(r, radius=rr or None)
        sh.finish(color=None, fill=_rgb(col), fill_opacity=op)
        tc = tc or ("#1F1F1F" if is_light(col) else "#FFFFFF")
    elif look == "badge":
        sh.draw_rect(r, radius=0.5)
        sh.finish(color=None, fill=_rgb(col), fill_opacity=op)
        tc = tc or ("#1F1F1F" if is_light(col) else "#FFFFFF")
    elif look == "gradient":
        n = 40
        c2 = spec.get("color2") or mix(col, "#FF8FB1", 0.55)
        sh.commit()
        clip_doc = fitz.open()
        cp = clip_doc.new_page(width=r.width, height=r.height)
        cs = cp.new_shape()
        for i in range(n):
            x0 = r.width * i / n
            cs.draw_rect(fitz.Rect(x0, 0, x0 + r.width / n + 0.6, r.height))
            cs.finish(color=None, fill=_rgb(mix(col, c2, i / (n - 1))))
        cs.commit()
        # rounded corners: cover them with the page's transparency via a mask-free trick (draw corners last)
        page.show_pdf_page(r, clip_doc, 0)
        clip_doc.close()
        sh = page.new_shape()
        tc = tc or "#FFFFFF"
    elif look == "marker":
        rnd = random.Random(int(r.width * 3 + r.height))
        pts = [(r.x0 + rnd.uniform(-3, 2), r.y0 + rnd.uniform(1, 4)), (r.x1 + rnd.uniform(-2, 4), r.y0 + rnd.uniform(-1, 3)),
               (r.x1 + rnd.uniform(-4, 2), r.y1 + rnd.uniform(-3, 1)), (r.x0 + rnd.uniform(-2, 3), r.y1 + rnd.uniform(-1, 2))]
        sh.draw_polyline(pts + [pts[0]])
        sh.finish(color=None, fill=_rgb(col), fill_opacity=0.42 * op, closePath=True)
        tc = tc or "#1F1F1F"
    elif look == "heading":
        sh.draw_rect(fitz.Rect(r.x0 + 2, r.y1 - 4.5, r.x0 + min(r.width - 2, 60), r.y1 - 1.5), radius=0.5)
        sh.finish(color=None, fill=_rgb(col))
        tc = tc or "#1F1F1F"
    elif look == "card":
        sh.draw_rect(r, radius=rr or None)
        sh.finish(color=_rgb("#E4E4E7"), width=0.5, fill=(1, 1, 1))
        sh.draw_rect(fitz.Rect(r.x0, r.y0, r.x0 + 5, r.y1), radius=None)
        sh.finish(color=None, fill=_rgb(col))
        tc = tc or "#1F1F1F"
    elif look == "quote":
        sh.draw_rect(fitz.Rect(r.x0, r.y0, r.x0 + 3.5, r.y1))
        sh.finish(color=None, fill=_rgb(col))
        sh.draw_rect(fitz.Rect(r.x0 + 3.5, r.y0, r.x1, r.y1))
        sh.finish(color=None, fill=_rgb(light), fill_opacity=0.6 * op)
        sh.commit()
        qc = _rgb(mix(col, "#FFFFFF", 0.25))
        for dx in (0, 9):
            sh = page.new_shape()
            cc = fitz.Point(r.x0 + 13 + dx, r.y0 + 15)
            sh.draw_circle(cc, 3.4)
            sh.finish(color=None, fill=qc)
            sh.draw_bezier(cc + (-3.2, 0.5), cc + (-3.5, -5), cc + (0, -8.5), cc + (3, -9))
            sh.finish(color=qc, width=1.6, closePath=False, lineCap=1)
            sh.commit()
        sh = page.new_shape()
    elif look in ("info", "warning", "tip", "check"):
        ic = _info_color(spec)
        sh.draw_rect(r, radius=rr or None)
        sh.finish(color=_rgb(mix(ic, "#FFFFFF", 0.55)), width=0.8, fill=_rgb(mix(ic, "#FFFFFF", 0.88)),
                  fill_opacity=op)
        sh.commit()
        _box_icon(page, fitz, look, fitz.Point(r.x0 + 18, r.y0 + 17), ic)
        sh = page.new_shape()
        tc = tc or mix(ic, "#000000", 0.55)
    elif look in ("speech", "callout"):
        tail = spec.get("tail", "bl")
        body = fitz.Rect(r)
        if tail in ("bl", "br"):
            body.y1 -= 16
        elif tail in ("tl", "tr"):
            body.y0 += 16
        elif tail == "l":
            body.x0 += 16
        else:
            body.x1 -= 16
        fill = (1, 1, 1) if look == "speech" else _rgb(light)
        line = _rgb(mix(col, "#000000", 0.05))
        sh.draw_rect(body, radius=min(0.5, 12 / max(1, min(body.width, body.height))))
        sh.finish(color=line, width=1.3, fill=fill, fill_opacity=op)
        sh.commit()
        if tail in ("bl", "br"):
            bx = body.x0 + body.width * (0.22 if tail == "bl" else 0.78)
            tip = (bx - 10 if tail == "bl" else bx + 10, r.y1)
            pts = [(bx - 8, body.y1 - 0.8), tip, (bx + 8, body.y1 - 0.8)] if look == "speech" else \
                [(bx - 6, body.y1 - 0.8), tip, (bx + 6, body.y1 - 0.8)]
        elif tail in ("tl", "tr"):
            bx = body.x0 + body.width * (0.22 if tail == "tl" else 0.78)
            tip = (bx - 10 if tail == "tl" else bx + 10, r.y0)
            pts = [(bx - 8, body.y0 + 0.8), tip, (bx + 8, body.y0 + 0.8)]
        elif tail == "l":
            by = body.y0 + body.height * 0.6
            pts = [(body.x0 + 0.8, by - 7), (r.x0, by + 4), (body.x0 + 0.8, by + 7)]
        else:
            by = body.y0 + body.height * 0.6
            pts = [(body.x1 - 0.8, by - 7), (r.x1, by + 4), (body.x1 - 0.8, by + 7)]
        sh = page.new_shape()
        sh.draw_polyline(pts)
        sh.finish(color=line, width=1.3, fill=fill, fill_opacity=op, closePath=False)
        sh.commit()
        sh = page.new_shape()                       # hide the border under the tail's mouth
        sh.draw_line(pts[0], pts[-1])
        sh.finish(color=fill, width=2.2)
        sh.commit()
        sh = page.new_shape()
        tc = tc or "#1F1F1F"
    elif look == "thought":
        tail = spec.get("tail", "bl")
        body = fitz.Rect(r)
        if tail in ("bl", "br"):
            body.y1 -= 16
        elif tail in ("tl", "tr"):
            body.y0 += 16
        elif tail == "l":
            body.x0 += 16
        else:
            body.x1 -= 16
        cx, cy = (body.x0 + body.x1) / 2, (body.y0 + body.y1) / 2
        rx, ry = body.width / 2, body.height / 2
        bumps = max(8, int((body.width + body.height) / 22))
        line = _rgb(mix(col, "#000000", 0.05))
        sh.draw_oval(body + (2, 3, 2, 3))
        sh.finish(color=None, fill=(0, 0, 0), fill_opacity=0.08)
        for i in range(bumps):
            a = 2 * math.pi * i / bumps
            px, py = cx + rx * 0.86 * math.cos(a), cy + ry * 0.82 * math.sin(a)
            br = min(rx, ry) * 0.42 + 4
            sh.draw_circle((px, py), br)
        sh.finish(color=line, width=1.2, fill=(1, 1, 1))
        sh.draw_oval(body + (6, 6, -6, -6))
        sh.finish(color=None, fill=(1, 1, 1))
        sh.commit()
        sx = body.x0 + body.width * (0.25 if tail in ("bl", "tl", "l") else 0.75)
        sy = body.y1 if tail in ("bl", "br", "l", "r") else body.y0
        d = 1 if tail in ("bl", "br", "l", "r") else -1
        sh = page.new_shape()
        for k, rad_ in ((5, 3.6), (11, 2.4)):
            sh.draw_circle((sx - k * 0.6 * (1 if tail in ("bl", "tl", "l") else -1), sy + d * k), rad_)
        sh.finish(color=line, width=1, fill=(1, 1, 1))
        sh.commit()
        sh = page.new_shape()
        tc = tc or "#1F1F1F"
    elif look == "banner":
        f = 10
        pts = [(r.x0, r.y0), (r.x1, r.y0), (r.x1 - f, (r.y0 + r.y1) / 2), (r.x1, r.y1), (r.x0, r.y1),
               (r.x0 + f, (r.y0 + r.y1) / 2)]
        sh.commit()
        _poly(page, [(p[0] + 1.5, p[1] + 2.5) for p in pts], fill=(0, 0, 0), fill_opacity=0.15)
        _poly(page, pts, fill=_rgb(col), fill_opacity=op)
        _poly(page, [(r.x0 + 6, r.y0 + 3), (r.x1 - 6, r.y0 + 3)], color=(1, 1, 1), width=0.6, stroke_opacity=0.5,
              close=False)
        _poly(page, [(r.x0 + 6, r.y1 - 3), (r.x1 - 6, r.y1 - 3)], color=(1, 1, 1), width=0.6, stroke_opacity=0.5,
              close=False)
        sh = page.new_shape()
        tc = tc or ("#1F1F1F" if is_light(col) else "#FFFFFF")
    elif look == "tag":
        k = min(14, r.height / 2)
        pts = [(r.x0 + k, r.y0), (r.x1, r.y0), (r.x1, r.y1), (r.x0 + k, r.y1), (r.x0, (r.y0 + r.y1) / 2)]
        sh.commit()
        _poly(page, [(p[0] + 1.2, p[1] + 2) for p in pts], fill=(0, 0, 0), fill_opacity=0.14)
        _poly(page, pts, fill=_rgb(col), fill_opacity=op)
        sh = page.new_shape()
        sh.draw_circle((r.x0 + k + 2, (r.y0 + r.y1) / 2), 2.6)
        sh.finish(color=None, fill=(1, 1, 1))
        tc = tc or ("#1F1F1F" if is_light(col) else "#FFFFFF")
    elif look == "torn":
        rnd = random.Random(int(r.width * 5 + r.height))
        pts = []
        x = r.x0
        while x < r.x1:
            pts.append((x, r.y0 + rnd.uniform(0, 5)))
            x += rnd.uniform(4, 9)
        pts.append((r.x1, r.y0 + 3))
        y = r.y0
        x = r.x1
        while x > r.x0:
            pts.append((x, r.y1 - rnd.uniform(0, 5)))
            x -= rnd.uniform(4, 9)
        pts.append((r.x0, r.y1 - 2))
        sh.commit()
        _poly(page, pts, fill=_rgb(mix(col, "#FFFFFF", 0.9)), color=_rgb(mix(col, "#FFFFFF", 0.55)), width=0.5)
        sh = page.new_shape()
        tc = tc or "#1F1F1F"
    sh.commit()
    tr = box_text_rect(fitz, spec, r)
    doc = spec.get("doc") or rich_from_plain(spec.get("text", ""))
    base = {"f": spec.get("font", "Sans"), "z": spec.get("size", 14), "c": box_text_color(spec),
            "al": spec.get("al", "l")}
    if look in ("banner", "badge") and "al" not in spec:
        base["al"] = "c"
    html_into(fitz, page, tr, doc, base, images_dir=images_dir)


def _info_color(spec):
    look = spec.get("look", "plain")
    if spec.get("color_set") or look not in ("info", "warning", "tip", "check"):
        return spec.get("color", "#2F80ED")
    return {"info": "#2F80ED", "warning": "#E8772E", "tip": "#8E5CE6", "check": "#1E8E3E"}[look]


def box_text_color(spec):
    """The colour of the words in a text box (unless you chose one)."""
    if spec.get("tc"):
        return spec["tc"]
    look = spec.get("look", "plain")
    col = spec.get("color", "#2F80ED")
    if look in SHAPE_LOOKS:
        return "#1F1F1F" if col == "none" or is_light(col) else "#FFFFFF"
    if look in ("solid", "badge", "banner", "tag"):
        return "#1F1F1F" if is_light(col) else "#FFFFFF"
    if look == "gradient":
        return "#FFFFFF"
    if look in ("info", "warning", "tip", "check"):
        return mix(_info_color(spec), "#000000", 0.55)
    if look in ("plain", "outline", "dashed", "double"):
        return col
    return "#1F1F1F"


def box_fill_color(spec):
    """Roughly the colour behind the words (for typing on the page)."""
    look = spec.get("look", "plain")
    col = spec.get("color", "#2F80ED")
    if look in SHAPE_LOOKS:
        return "#FFFFFF" if col == "none" else col
    if look in ("solid", "badge", "banner", "tag", "gradient"):
        return col
    if look in ("label", "quote", "callout"):
        return mix(col, "#FFFFFF", 0.86)
    if look in ("info", "warning", "tip", "check"):
        return mix(_info_color(spec), "#FFFFFF", 0.88)
    if look == "marker":
        return mix(col, "#FFFFFF", 0.58)
    if look == "torn":
        return mix(col, "#FFFFFF", 0.9)
    return "#FFFFFF"


def box_size(fitz, spec, images_dir=None):
    """(w, h) of a text box: its width, and the height its words need (unless it was made taller)."""
    w = float(spec.get("w", 220))
    pw, ph = box_extra(spec)
    doc = spec.get("doc") or rich_from_plain(spec.get("text", ""))
    base = {"f": spec.get("font", "Sans"), "z": spec.get("size", 14), "al": spec.get("al", "l")}
    if is_shape(spec):
        fw, fh = SHAPE_FRAC.get(spec.get("look"), (1.0, 1.0))
        th = html_height(fitz, doc, max(16, w - pw), base, images_dir) if rich_plain(doc).strip() else 0
        need = (th + ph) / fh + 2
        return w, max(need, float(spec.get("minh", 0)), 24.0)
    need = html_height(fitz, doc, max(20, w - pw), base, images_dir) + ph + 2
    h = max(need, float(spec.get("minh", 0)), float(spec.get("size", 14)) * 1.5 + ph)
    return w, h


def render_card(fitz, spec, scale=3.0, images_dir=None):
    """spec -> (png bytes, width, height) in PDF points. Drawn straight, then turned to its angle."""
    import math
    kind = spec.get("kind", "note")
    if kind == "box":
        w, h = box_size(fitz, spec, images_dir)
        spec["h"] = h
    else:
        w, h = float(spec.get("w", 180)), float(spec.get("h", 130))
    ang = float(spec.get("angle", 0))
    pad = card_pad(spec)
    if kind == "watermark":
        return _render_watermark(fitz, spec, w, h, pad, ang)
    W0, H0 = w + 2 * pad, h + 2 * pad
    flat = fitz.open()
    page = flat.new_page(width=W0, height=H0)
    r = fitz.Rect(pad, pad, pad + w, pad + h)
    if kind == "note":
        _draw_note_flat(fitz, page, r, spec, images_dir)
    elif kind == "box":
        _draw_box_flat(fitz, page, r, spec, images_dir)
    elif kind == "stamp":
        _draw_stamp_flat(fitz, page, r, spec)
    elif kind in ("sign", "image"):
        _draw_picture_flat(fitz, page, r, spec, images_dir)
    if abs(ang) > 0.01:
        a = math.radians(ang)
        W = abs(W0 * math.cos(a)) + abs(H0 * math.sin(a))
        H = abs(W0 * math.sin(a)) + abs(H0 * math.cos(a))
        out = fitz.open()
        op = out.new_page(width=W, height=H)
        op.show_pdf_page(op.rect, flat, 0, rotate=-ang)
        pix = op.get_pixmap(matrix=fitz.Matrix(scale, scale), alpha=True)
        out.close()
    else:
        W, H = W0, H0
        pix = page.get_pixmap(matrix=fitz.Matrix(scale, scale), alpha=True)
    flat.close()
    return pix.tobytes("png"), W, H


def _draw_symbol_flat(fitz, page, r, spec):
    """3.2: a tick, a cross, a box, a number… drawn with lines, sharp at any size."""
    import math
    sym = spec.get("sym", "tick")
    ink = _rgb(spec.get("color") or SYMBOLS.get(sym, ("", "", "#1E8E3E"))[2])
    s = min(r.width, r.height)
    cx, cy = (r.x0 + r.x1) / 2, (r.y0 + r.y1) / 2
    x0, y0 = cx - s / 2, cy - s / 2
    P = lambda u, v: fitz.Point(x0 + u * s, y0 + v * s)
    lw = max(1.2, s * 0.13)
    sh = page.new_shape()

    def tick(k=1.0, ox=0.0, oy=0.0):
        sh.draw_polyline([P(ox + 0.5 + (0.12 - 0.5) * k, oy + 0.5 + (0.55 - 0.5) * k),
                          P(ox + 0.5 + (0.40 - 0.5) * k, oy + 0.5 + (0.82 - 0.5) * k),
                          P(ox + 0.5 + (0.90 - 0.5) * k, oy + 0.5 + (0.18 - 0.5) * k)])
        sh.finish(color=ink, width=lw * k, closePath=False, lineCap=1, lineJoin=1)

    def cross(k=1.0):
        a, b = 0.5 - 0.36 * k, 0.5 + 0.36 * k
        sh.draw_line(P(a, a), P(b, b))
        sh.draw_line(P(b, a), P(a, b))
        sh.finish(color=ink, width=lw * k, lineCap=1)

    def frame():
        sh.draw_rect(fitz.Rect(P(0.08, 0.08), P(0.92, 0.92)), radius=0.12)
        sh.finish(color=ink, width=max(1.0, s * 0.08))
    if sym == "tick":
        tick()
    elif sym == "cross":
        cross()
    elif sym in ("box", "boxtick", "boxcross"):
        frame()
        if sym == "boxtick":
            tick(0.72)
        elif sym == "boxcross":
            cross(0.62)
    elif sym == "dot":
        sh.draw_circle(P(0.5, 0.5), s * 0.3)
        sh.finish(color=None, fill=ink)
    elif sym == "circle":
        sh.draw_oval(fitz.Rect(P(0.06, 0.12), P(0.94, 0.88)))
        sh.finish(color=ink, width=max(1.0, s * 0.08))
    elif sym == "star":
        pts = []
        for i in range(10):
            a = -math.pi / 2 + i * math.pi / 5
            k = 0.46 if i % 2 == 0 else 0.19
            pts.append(P(0.5 + k * math.cos(a), 0.53 + k * math.sin(a)))
        sh.draw_polyline(pts + [pts[0]])
        sh.finish(color=None, fill=ink, closePath=True)
    elif sym == "arrow":
        sh.draw_line(P(0.12, 0.5), P(0.82, 0.5))
        sh.finish(color=ink, width=lw, lineCap=1)
        sh.draw_polyline([P(0.55, 0.22), P(0.86, 0.5), P(0.55, 0.78)])
        sh.finish(color=ink, width=lw, closePath=False, lineCap=1, lineJoin=1)
    else:                                              # ?, ! and numbers: a round badge with the sign in it
        label = SYMBOLS.get(sym, ("", "?", ""))[1]
        if sym.startswith("n"):
            sh.draw_circle(P(0.5, 0.5), s * 0.46)
            sh.finish(color=None, fill=ink)
            sh.commit()
            _text_fit(page, fitz.Rect(P(0.08, 0.2), P(0.92, 0.86)), label, "Sans", s * 0.6, (1, 1, 1), 1, None,
                      bold=True)
            return
        sh.draw_circle(P(0.5, 0.5), s * 0.46)
        sh.finish(color=ink, width=max(1.0, s * 0.08))
        sh.commit()
        _text_fit(page, fitz.Rect(P(0.1, 0.18), P(0.9, 0.86)), label, "Sans", s * 0.62, ink, 1, None, bold=True)
        return
    sh.commit()


def _draw_stamp_flat(fitz, page, r, spec):
    import random
    if spec.get("style") == "symbol":
        return _draw_symbol_flat(fitz, page, r, spec)
    col = spec.get("color", "#1E8E3E")
    text = spec.get("text", "")
    w, h = r.width, r.height
    c = fitz.Point((r.x0 + r.x1) / 2, (r.y0 + r.y1) / 2)
    style = spec.get("style", "rubber")
    ink = _rgb(col)
    sh = page.new_shape()
    date = spec.get("date_text", "")
    words = text.upper() + ("\n" + date if date else "")
    if style == "circle":
        rad = min(w, h) / 2 - 2
        sh.draw_circle(c, rad)
        sh.finish(color=ink, width=2.6, stroke_opacity=0.9)
        sh.draw_circle(c, rad - 5)
        sh.finish(color=ink, width=1, stroke_opacity=0.9)
        sh.commit()
        inner = fitz.Rect(c.x - rad * 0.78, c.y - rad * 0.42, c.x + rad * 0.78, c.y + rad * 0.62)
        _text_fit(page, inner, words, spec.get("font", "Sans"), spec.get("size", 14), ink, 1, None, bold=True)
    elif style == "label":
        sh.draw_rect(r, radius=min(0.5, 10 / max(1, min(w, h))))
        sh.finish(color=None, fill=ink)
        sh.commit()
        _text_fit(page, r + (6, h * 0.18, -6, -2), words, spec.get("font", "Sans"), spec.get("size", 15), (1, 1, 1), 1,
                  None, bold=True)
    else:
        rr = min(0.3, 8 / max(1, min(w, h)))
        sh.draw_rect(r, radius=rr)
        sh.finish(color=ink, width=2.8 if style == "rubber" else 1.6, stroke_opacity=0.9)
        if style == "rubber":
            sh.draw_rect(r + (4.5, 4.5, -4.5, -4.5), radius=rr)
            sh.finish(color=ink, width=1, stroke_opacity=0.9)
        sh.commit()
        _text_fit(page, r + (8, h * 0.16, -8, -3), words, spec.get("font", "Sans"), spec.get("size", 16), ink, 1, None,
                  bold=True)
    if style == "rubber":                      # a little ink texture, like a real stamp
        rnd = random.Random(text)
        sh = page.new_shape()
        for _ in range(int(w * h / 60)):
            sh.draw_circle(fitz.Point(rnd.uniform(r.x0, r.x1), rnd.uniform(r.y0, r.y1)), rnd.uniform(0.3, 1.1))
        sh.finish(color=None, fill=(1, 1, 1), fill_opacity=0.55)
        sh.commit()


def _draw_picture_flat(fitz, page, r, spec, images_dir):
    kind = spec.get("kind")
    img = spec.get("img")
    path = os.path.join(images_dir or "", img + ".png") if img else None
    lines = [x for x in (spec.get("name_text", ""), spec.get("date_text", "")) if x]
    foot = 14 * len(lines) if kind == "sign" else 0
    if path and os.path.exists(path):
        page.insert_image(fitz.Rect(r.x0, r.y0, r.x1, r.y1 - foot), filename=path, keep_proportion=True)
    if kind == "sign" and lines:
        sh = page.new_shape()
        sh.draw_line((r.x0 + 4, r.y1 - foot - 1), (r.x1 - 4, r.y1 - foot - 1))
        sh.finish(color=(0.45, 0.45, 0.5), width=0.6)
        sh.commit()
        _text_fit(page, fitz.Rect(r.x0, r.y1 - foot + 1, r.x1, r.y1 + 4), "\n".join(lines), "Sans", 8.5,
                  (0.3, 0.3, 0.35), 1, None)


def _render_watermark(fitz, spec, w, h, pad, ang):
    import math
    a = math.radians(ang)
    W = abs(w * math.cos(a)) + abs(h * math.sin(a)) + 2 * pad
    H = abs(w * math.sin(a)) + abs(h * math.cos(a)) + 2 * pad
    doc = fitz.open()
    page = doc.new_page(width=W, height=H)
    c = fitz.Point(W / 2, H / 2)
    text = spec.get("text", "")
    op = float(spec.get("opacity", 0.15))
    size = float(spec.get("size", 60))
    tl = fitz.get_text_length(text, fontname="hebo", fontsize=size)
    spots = [c]
    if spec.get("layout") == "tile":
        spots = [fitz.Point(x, y) for y in range(int(size), int(H), int(size * 3.2))
                 for x in range(int(tl / 2.5), int(W + tl / 2), int(tl * 1.2 + 40))]
    for pt in spots:
        tw = fitz.TextWriter(page.rect, opacity=op, color=_rgb(spec.get("color", "#B3261E")))
        tw.append(pt - (tl / 2, -size / 3), text, fontsize=size, font=fitz.Font("hebo"))
        tw.write_text(page, morph=(pt, fitz.Matrix(-ang)))
    pix = page.get_pixmap(matrix=fitz.Matrix(1.6, 1.6), alpha=True)
    data = pix.tobytes("png")
    doc.close()
    return data, W, H


# ---------------------------------------------------------------------------
# Pages you write in BindLens (like a simple Word): paper, margins, header / footer, page numbers, columns,
# headings, lists, tables, pictures. The words become real PDF text (searchable, printable everywhere);
# the page also keeps its 'source' in a private key so BindLens can open it again for editing.
# ---------------------------------------------------------------------------
PAGE_KEY = "BindLensPage"
ADDED_KEY = "BindLensAdded"          # 1.9.2: pages BindLens added (empty pages, pages from another PDF)
PAGE_SIZES = OrderedDict([("same", "Same as this file"), ("a4", "A4"), ("letter", "Letter"), ("a5", "A5")])
MARGINS = OrderedDict([("narrow", ("Narrow", 36)), ("normal", ("Normal", 56)), ("wide", ("Wide", 80))])


def draw_paper(fitz, pg, style, color=None):
    """Notebook paper behind the words: blank, lined, squared, dotted, Cornell notes or a colour."""
    W, H = pg.rect.width, pg.rect.height
    sh = pg.new_shape()
    if color and color.upper() != "#FFFFFF":
        sh.draw_rect(pg.rect)
        sh.finish(color=None, fill=hex_to_rgb01(color))
    if style == "colour" and not color:
        sh.draw_rect(pg.rect)
        sh.finish(color=None, fill=hex_to_rgb01("#FFF6D6"))
    if style in ("lined", "cornell"):
        top = 72 if style == "lined" else 90
        y = top
        while y < H - 36:
            sh.draw_line((36, y), (W - 36, y))
            y += 22
        sh.finish(color=(0.62, 0.75, 0.9), width=0.6)
        if style == "lined":
            sh.draw_line((72, 36), (72, H - 36))
            sh.finish(color=(0.92, 0.45, 0.45), width=0.8)
        else:
            sh.draw_line((W * 0.3, top - 20), (W * 0.3, H * 0.78))
            sh.draw_line((36, H * 0.78), (W - 36, H * 0.78))
            sh.draw_line((36, top - 20), (W - 36, top - 20))
            sh.finish(color=(0.45, 0.45, 0.5), width=1)
    elif style == "squared":
        x = 0
        while x <= W:
            sh.draw_line((x, 0), (x, H))
            x += 14
        y = 0
        while y <= H:
            sh.draw_line((0, y), (W, y))
            y += 14
        sh.finish(color=(0.75, 0.83, 0.92), width=0.4)
    elif style == "dotted":
        for x in range(18, int(W), 18):
            for y in range(18, int(H), 18):
                sh.draw_circle((x, y), 0.6)
        sh.finish(color=None, fill=(0.6, 0.6, 0.65))
    sh.commit()
    if style == "cornell":
        pg.insert_text((40, 52), "Topic:", fontsize=10, color=(0.45, 0.45, 0.5))
        pg.insert_text((W * 0.55, 52), "Date:", fontsize=10, color=(0.45, 0.45, 0.5))
        pg.insert_text((40, H * 0.78 + 16), "Summary", fontsize=9, color=(0.45, 0.45, 0.5))


def page_size(fitz, src, ref=None):
    key = src.get("size", "same")
    if key == "same" and ref is not None:
        W, H = ref.width, ref.height
    else:
        r = fitz.paper_rect({"a4": "a4", "letter": "letter", "a5": "a5"}.get(key, "a4"))
        W, H = r.width, r.height
    if src.get("orient") == "landscape" and W < H or src.get("orient") == "portrait" and W > H:
        W, H = H, W
    return W, H


TEXT_BLOCKS = ("p", "h1", "h2", "h3", "ul", "ol", "quote")


def _page_segments(blocks):
    """Split a written page into what flows (text, tables, lines), pictures (with the text beside them) and
    page breaks."""
    segs, cur = [], []
    i = 0
    while i < len(blocks):
        b = blocks[i]
        t = b.get("t", "p")
        if t == "pb":
            if cur:
                segs.append(("flow", cur))
                cur = []
            segs.append(("break", None))
        elif t == "table":
            lead = []
            while cur and cur[-1].get("t") in H_SIZES:          # a heading stays with its table
                lead.insert(0, cur.pop())
            if cur:
                segs.append(("flow", cur))
                cur = []
            segs.append(("table", dict(b, _lead=lead) if lead else b))
        elif t == "img":
            if cur:
                segs.append(("flow", cur))
                cur = []
            side = []
            if b.get("wrap") in ("left", "right"):          # the text after it goes round the picture
                j = i + 1
                while j < len(blocks) and blocks[j].get("t", "p") in TEXT_BLOCKS:
                    side.append(blocks[j])
                    j += 1
                i = j - 1
            segs.append(("pic", (b, side)))
        else:
            cur.append(b)
        i += 1
    if cur:
        segs.append(("flow", cur))
    return segs


def _picture_pixmap(fitz, path, crop=None):
    pix = fitz.Pixmap(path)
    if crop and any(float(x) > 0.001 for x in crop):
        l, t, r, b = [max(0.0, min(0.45, float(x))) for x in crop]
        pw, ph = pix.width, pix.height
        clip = fitz.IRect(int(pw * l), int(ph * t), int(pw * (1 - r)), int(ph * (1 - b))) & fitz.IRect(0, 0, pw, ph)
        if clip.width > 4 and clip.height > 4:
            part = fitz.Pixmap(pix.colorspace, clip, pix.alpha)
            part.copy(pix, clip)
            part.set_origin(0, 0)
            pix = part
    return pix


def render_page_doc(fitz, src, W, H, images_dir=None):
    """Write a page source onto as many pages as its words need. Returns a new PDF (fitz document).
    Text, tables and lines flow; pictures are placed by BindLens (size, position, text beside them, crop, border,
    caption); page breaks start a new page."""
    import io
    m = float(src.get("margin", 56))
    top = m + (18 if src.get("header") else 0)
    bottom = m + (18 if src.get("footer") or src.get("numbers") else 0)
    left = max(m, 80) if src.get("paper") == "lined" else m
    doc = src.get("doc") or {"blocks": []}
    base = {"f": src.get("font", "Sans"), "z": float(src.get("size_pt", 11)), "c": src.get("tc", "#1F1F1F")}
    lh = float(src.get("lh", 1.28))
    cols = max(1, min(3, int(src.get("cols", 1))))
    gap = 18
    area = fitz.Rect(left, top, W - m, H - bottom)
    cw = (area.width - gap * (cols - 1)) / cols
    arch = rich_archive(fitz, doc, base, images_dir)

    def story_for(blocks):
        body, css = rich_html({"blocks": blocks, "base": doc.get("base", {})}, base)
        css += f"\nbody {{line-height:{lh:.2f};}}\n"
        return fitz.Story(html=body, user_css=css, archive=arch)
    buf = io.BytesIO()
    writer = fitz.DocumentWriter(buf)
    cur = {"dev": None, "pno": -1, "col": 0, "y": area.y0}
    post = []

    def new_page():
        if cur["dev"] is not None:
            writer.end_page()
        cur["dev"] = writer.begin_page(fitz.Rect(0, 0, W, H))
        cur["pno"] += 1
        cur["col"], cur["y"] = 0, area.y0

    def next_col():
        if cur["col"] < cols - 1:
            cur["col"] += 1
            cur["y"] = area.y0
        else:
            new_page()

    def col_x():
        return area.x0 + cur["col"] * (cw + gap)

    def flow(story, x0=None, x1=None, until=None):
        """Place a story from the cursor on. With x0 / x1 / until: first beside a picture (down to 'until'),
        then on at full width below it."""
        more, n, last = 1, 0, cur["y"]
        while more and n < 400:
            n += 1
            cx = col_x()
            beside = n == 1 and until is not None
            r = fitz.Rect(x0 if beside else cx, cur["y"], x1 if beside else cx + cw,
                          min(until, area.y1) if beside else area.y1)
            if r.height < 14:
                if beside:
                    cur["y"] = max(cur["y"], until)
                    continue
                next_col()
                continue
            more, filled = story.place(r)
            story.draw(cur["dev"])
            try:
                fr = fitz.Rect(filled)
                last = fr.y1 if not fr.is_empty else cur["y"]
            except Exception:
                last = cur["y"]
            if beside:
                cur["y"] = max(last, until) if more else last
                if not more:
                    cur["y"] = max(last, until) + 2
                elif cur["y"] >= area.y1 - 14:
                    next_col()
            elif more:
                next_col()
            else:
                cur["y"] = last + 2
        return last

    def table_h(b):
        if isinstance(b, list):
            if not b:
                return 0
            st = story_for(b)
            _m, filled = st.place(fitz.Rect(0, 0, cw, 20000))
            return fitz.Rect(filled).height
        st = story_for([b])
        _m, filled = st.place(fitz.Rect(0, 0, cw, 20000))
        return fitz.Rect(filled).height
    new_page()
    for kind, data in _page_segments(doc.get("blocks") or []):
        if kind == "break":
            new_page()
        elif kind == "flow":
            flow(story_for(data))
        elif kind == "table":
            # tables are never cut by the page writer: whole, or in parts that each repeat the header
            b = dict(data)
            lead = b.pop("_lead", [])
            rows = b.get("rows") or [[""]]
            head = 1 if b.get("head", 1) else 0
            todo = list(range(head, len(rows)))
            first = True
            while first or todo:
                room = area.y1 - cur["y"]
                full = area.y1 - area.y0
                take = len(todo)
                part = dict(b, rows=[rows[0]] * head + [rows[k] for k in todo[:take]])
                h = table_h(part) + (table_h(lead) if first and lead else 0)
                if h > room:
                    if room < full - 1 and h <= full:
                        next_col()
                        continue
                    lh_ = table_h(lead) if first and lead else 0
                    lo, hi = 1, max(1, take)                 # as many rows as fit here
                    while lo < hi:
                        mid = (lo + hi + 1) // 2
                        pt = dict(b, rows=[rows[0]] * head + [rows[k] for k in todo[:mid]])
                        if table_h(pt) + lh_ <= room:
                            lo = mid
                        else:
                            hi = mid - 1
                    take = lo
                    if take == 1 and table_h(dict(b, rows=[rows[0]] * head + [rows[todo[0]]])) > room and \
                            room < full - 1:
                        next_col()
                        continue
                sub = {f"{(0 if (head and int(k.split(',')[0]) == 0) else 0)},{k.split(',')[1]}": v
                       for k, v in (b.get("spans") or {}).items() if head and k.startswith("0,")}
                part = dict(b, rows=[rows[0]] * head + [rows[k] for k in todo[:take]])
                # cell colours / merged cells follow their rows into each part
                remap = {}
                for k_new, k_old in enumerate(([0] if head else []) + todo[:take]):
                    remap[k_old] = k_new
                part["cbg"] = {f"{remap[int(k.split(',')[0])]},{k.split(',')[1]}": v
                               for k, v in (b.get("cbg") or {}).items() if int(k.split(",")[0]) in remap}
                part["spans"] = {f"{remap[int(k.split(',')[0])]},{k.split(',')[1]}": v
                                 for k, v in (b.get("spans") or {}).items() if int(k.split(",")[0]) in remap}
                _ = sub
                flow(story_for((lead if first else []) + [part]))
                todo = todo[take:]
                first = False
                if todo:
                    next_col()
        else:
            b, side = data
            path = os.path.join(images_dir or "", f"{b.get('img', '')}.png")
            try:
                pix = _picture_pixmap(fitz, path, b.get("crop"))
                pw, ph = pix.width, pix.height
            except Exception:
                continue
            wrap = b.get("wrap") if side else None
            frac = max(0.08, min(1.0, float(b.get("w", 60)) / 100.0))
            if wrap:
                frac = min(frac, 0.7)
            dw = cw * frac
            dh = dw * ph / max(1, pw)
            cap = (b.get("cap") or "").strip()
            caph = 14 if cap else 0
            pad = 4 if b.get("border") in ("frame", "shadow") else 0
            if cur["y"] + dh + caph + 2 * pad > area.y1 and cur["y"] > area.y0 + 1:
                next_col()
            room = area.y1 - cur["y"] - caph - 2 * pad - 4
            if dh > room:                                     # taller than a page: smaller
                k = max(0.2, room / dh)
                dw, dh = dw * k, dh * k
            cx = col_x()
            if wrap == "left":
                x = cx + pad
            elif wrap == "right":
                x = cx + cw - dw - pad
            else:
                x = {"l": cx + pad, "c": cx + (cw - dw) / 2, "r": cx + cw - dw - pad}.get(b.get("al", "c"),
                                                                                       cx + (cw - dw) / 2)
            y = cur["y"] + pad + 2
            rect = fitz.Rect(x, y, x + dw, y + dh)
            post.append((cur["pno"], rect, b, pix, cap))
            img_bottom = rect.y1 + pad + caph + 6
            if wrap:
                tx0, tx1 = (rect.x1 + pad + 12, cx + cw) if wrap == "left" else (cx, rect.x0 - pad - 12)
                flow(story_for(side), x0=tx0, x1=tx1, until=img_bottom)
            else:
                cur["y"] = img_bottom
    writer.end_page()
    writer.close()
    content = fitz.open("pdf", buf.getvalue())
    out = fitz.open()
    total = content.page_count
    for i in range(total):
        pg = out.new_page(width=W, height=H)
        draw_paper(fitz, pg, src.get("paper", "blank"), src.get("pcolor"))
        pg.show_pdf_page(pg.rect, content, i)
        for pno, rect, b, pix, cap in post:
            if pno != i:
                continue
            try:
                bd = b.get("border", "none")
                sh = pg.new_shape()
                if bd == "shadow":
                    sh.draw_rect(rect + (2, 3, 4, 5))
                    sh.finish(color=None, fill=(0, 0, 0), fill_opacity=0.14)
                if bd in ("frame", "shadow"):
                    sh.draw_rect(rect + (-4, -4, 4, 4))
                    sh.finish(color=(0.82, 0.82, 0.85), width=0.5, fill=(1, 1, 1))
                sh.commit()
                pg.insert_image(rect, pixmap=pix)
                if bd == "thin":
                    sh = pg.new_shape()
                    sh.draw_rect(rect)
                    sh.finish(color=(0.25, 0.25, 0.28), width=0.8)
                    sh.commit()
                if cap:
                    cr = fitz.Rect(rect.x0 - 40, rect.y1 + (6 if bd in ("frame", "shadow") else 3), rect.x1 + 40,
                                   rect.y1 + 22)
                    pg.insert_htmlbox(cr, f'<p style="text-align:center;font-size:8.5pt;color:#5F6368;'
                                          f'font-style:italic;margin:0">{html.escape(cap)}</p>')
            except Exception:
                pass
        if src.get("header"):
            pg.insert_textbox(fitz.Rect(left, m - 26, W - m, m - 6), src["header"], fontsize=8.5,
                              color=(0.45, 0.45, 0.5), align=0, fontname=full_font(pg, "helv", src["header"]))
        if src.get("footer"):
            pg.insert_textbox(fitz.Rect(left, H - m + 6, W - m, H - m + 24), src["footer"], fontsize=8.5,
                              color=(0.45, 0.45, 0.5), align=0, fontname=full_font(pg, "helv", src["footer"]))
        if src.get("numbers"):
            pg.insert_textbox(fitz.Rect(left, H - m + 6, W - m, H - m + 24),
                              f"{i + 1} / {total}" if total > 1 else "1", fontsize=8.5, color=(0.45, 0.45, 0.5),
                              align=2)
    content.close()
    return out


def page_source(doc, page):
    """The BindLens source of a page written in BindLens (or None)."""
    try:
        t, v = doc.xref_get_key(page.xref, PAGE_KEY)
        if t == "string" and v:
            return json.loads(v)
    except Exception:
        pass
    return None


def set_page_source(doc, page, info):
    doc.xref_set_key(page.xref, PAGE_KEY, "<" + json.dumps(info, separators=(",", ":")).encode("utf-8").hex() + ">")


def mark_added(doc, pno, info):
    """Remember in the page itself that BindLens added it (when, what) - it stays with the page if it moves."""
    try:
        info = dict(info, d=info.get("d") or time.strftime("%Y-%m-%d"))
        doc.xref_set_key(doc.page_xref(pno), ADDED_KEY,
                         "<" + json.dumps(info, separators=(",", ":")).encode("utf-8").hex() + ">")
    except Exception:
        pass


def added_pages(doc):
    """The pages BindLens added to a PDF: [{"kind": "_added", "pi", "info"}] (written pages too)."""
    out = []
    if not getattr(doc, "is_pdf", False):
        return out
    for pi in range(doc.page_count):
        try:
            x = doc.page_xref(pi)
            info = None
            t, v = doc.xref_get_key(x, ADDED_KEY)
            if t == "string" and v:
                info = json.loads(v)
            else:
                t, v = doc.xref_get_key(x, PAGE_KEY)
                if t == "string" and v:
                    src = json.loads(v)
                    info = {"k": "written", "d": src.get("d", "")}
            if info:
                out.append({"kind": "_added", "pi": pi, "info": info})
        except Exception:
            continue
    return out


def wipe_page(doc, page):
    """Empty a page (its marks stay) so it can be written again."""
    for x in page.get_contents():
        doc.update_stream(x, b" ")
    doc.xref_set_key(page.xref, "Resources", "<<>>")


def ics_text(events, alarm_days=(14, 0)):
    """3.0 - dates for your calendar (Outlook, Google, Apple): an .ics file with one all-day event per date and
    reminders before it - your calendar reminds you even when BindLens is closed.
    events: [(datetime.date, title, description)]."""
    import datetime
    import hashlib

    def esc(t):
        return (str(t or "").replace("\\", "\\\\").replace(";", "\\;").replace(",", "\\,")
                .replace("\r", "").replace("\n", "\\n"))

    def fold(line):
        out, b = [], line.encode("utf-8")
        while len(b) > 74:
            cut = 74
            while cut > 1 and (b[cut] & 0xC0) == 0x80:      # never inside a letter
                cut -= 1
            out.append(b[:cut].decode("utf-8"))
            b = b" " + b[cut:]
        out.append(b.decode("utf-8"))
        return "\r\n".join(out)
    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    lines = ["BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//BindLens//EN", "CALSCALE:GREGORIAN", "METHOD:PUBLISH"]
    for d, title, desc in events:
        uid = hashlib.sha1(f"{d}|{title}|{desc}".encode("utf-8")).hexdigest()[:20] + "@bindlens"
        lines += ["BEGIN:VEVENT", f"UID:{uid}", f"DTSTAMP:{now}", f"DTSTART;VALUE=DATE:{d.strftime('%Y%m%d')}",
                  f"DTEND;VALUE=DATE:{(d + datetime.timedelta(days=1)).strftime('%Y%m%d')}",
                  f"SUMMARY:{esc(title)}", f"DESCRIPTION:{esc(desc)}", "TRANSP:TRANSPARENT"]
        for a in alarm_days:
            lines += ["BEGIN:VALARM", "ACTION:DISPLAY", f"DESCRIPTION:{esc(title)}",
                      f"TRIGGER:-P{int(a)}D" if a else "TRIGGER:PT9H", "END:VALARM"]
        lines.append("END:VEVENT")
    lines.append("END:VCALENDAR")
    return "\r\n".join(fold(x) for x in lines) + "\r\n"


