            i = lb_docs.curselection()
            if not i and docs:
                i = (0,)
            if i:
                f, rel = docs[i[0]]
                d.destroy()
                self._read_open(f, "", rel)
        lb_books.bind("<<ListboxSelect>>", lambda e: (qv.set(""), show_book(lb_books.curselection()[0])
                                                      if lb_books.curselection() else None))
        lb_books.bind("<Double-1>", read_book)
        lb_books.bind("<Return>", read_book)
        lb_docs.bind("<Double-1>", read_doc)
        lb_docs.bind("<Return>", read_doc)
        qe.bind("<Return>", read_doc)
        qe.bind("<Down>", lambda e: (lb_docs.focus_set(), lb_docs.selection_clear(0, "end"), lb_docs.selection_set(0)))
        qv.trace_add("write", search)
        bf = tk.Frame(d, bg=T["panel"])
        bf.pack(fill="x", padx=20, pady=14)
        PillButton(bf, self, "Read this document", read_doc, kind="accent").pack(side="right")
        PillButton(bf, self, "Read the whole book", read_book, kind="soft").pack(side="right", padx=8)
        PillButton(bf, self, "Cancel", d.destroy, kind="ghost").pack(side="left")
        cur = books.index(self.folder) if self.folder in books else 0
        lb_books.selection_set(cur)
        lb_books.see(cur)
