    def _logo_bg_picker(self, parent, refresh):
        """4.4: the logo's background colour - the logo itself (pages, pink ribbon, gold lens) is always the same.
        Small logos to click, and 'Your colour…' for any colour."""
        T = self.T
        s = self.lib.settings
        self._icon_thumbs = []
        grid = tk.Frame(parent, bg=T["panel"])
        grid.pack(anchor="w")
        names = [n for n in LOGO_COLORS if n != "Custom"] + (["Custom"] if "Custom" in LOGO_COLORS else [])
        for i, name in enumerate(names):
            try:
                img = tk.PhotoImage(data=logo_icon_data(name, 44))
            except Exception:
                continue
            self._icon_thumbs.append(img)
            on = (s.get("icon") or "Black") == name
            cell = tk.Frame(grid, bg=T["panel"], padx=3, pady=2)
            cell.grid(row=i // 6, column=i % 6, sticky="n")
            lb = tk.Label(cell, image=img, bg=self.accent if on else T["panel"], bd=0, padx=2, pady=2,
                          cursor="hand2")
            lb.pack()
            tk.Label(cell, text="Mine" if name == "Custom" else name, font=self.F(8, "bold" if on else "normal"),
                     bg=T["panel"], fg=self.accent if on else T["muted"]).pack()
            lb.bind("<Button-1>", lambda e, n=name: (self.set_icon(n), refresh()))

        def mine():
            cur = (LOGO_COLORS.get("Custom") or LOGO_COLORS["Black"])[0]
            got = colorchooser.askcolor(color=cur, parent=self.root, title="The logo's background colour")
            if got and got[1] and logo_custom(got[1]):
                s["icon_custom"] = LOGO_COLORS["Custom"][0]
                self.set_icon("Custom")
                refresh()
        row = tk.Frame(parent, bg=T["panel"])
        row.pack(anchor="w", pady=(4, 0))
        lk = tk.Label(row, text="Your colour…", font=self.F(9), bg=T["panel"], fg=self.accent, cursor="hand2")
        lk.pack(side="left")
        lk.bind("<Button-1>", lambda e: mine())
        tk.Label(row, text="   Only the background changes - the logo stays the same.", font=self.F(8),
                 bg=T["panel"], fg=T["muted"]).pack(side="left")

    def set_icon(self, name):
        """Change the app icon (window, header and the desktop shortcut's .ico file)."""
        self.lib.settings["icon"] = name
