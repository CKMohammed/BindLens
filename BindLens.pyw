        def to_cal():
            import datetime
            ev = []
            for r in sorted(items, key=lambda r: r["date"]):
                try:
                    dd = datetime.date.fromisoformat(r["date"])
                except Exception:
                    continue
                where = f'{os.path.basename(r["path"])} p.{r["page"] + 1}' if r.get("path") else ""
                ev.append((dd, r.get("note") or (f"Reminder: {where}" if where else "Reminder"),
