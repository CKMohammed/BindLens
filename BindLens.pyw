        if s.get("icon") == "Custom" and not logo_custom(s.get("icon_custom")):
            s["icon"] = "Black"
        self._load_icons()
        fam = self._pick_family()
        globals().update(UI_FONT=(fam, 10), UI_FONT_S=(fam, 9), UI_FONT_B=(fam, 10, "bold"),
                         UI_FONT_L=(fam, 13, "bold"))
