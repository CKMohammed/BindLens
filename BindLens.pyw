            lb.pack(side="left", padx=(0, 4))
            lb.bind("<Button-1>", lambda e, q=q: tv.set(q))
        label("Colour")
        self._inline_palette(body, spec["color"], lambda c: spec.__setitem__("color", c)).pack(anchor="w")
        label("Strength")
        ov = tk.DoubleVar(value=spec["opacity"])
        ttk.Scale(body, from_=0.05, to=0.5, variable=ov, length=260).pack(anchor="w")
        lay = tk.StringVar(value=spec["layout"])
        lf = tk.Frame(body, bg=T["panel"])
        lf.pack(anchor="w", pady=(10, 0))
        ttk.Radiobutton(lf, text="Once, across the page", value="centre", variable=lay).pack(side="left")
        ttk.Radiobutton(lf, text="Repeated", value="tile", variable=lay).pack(side="left", padx=12)
        label("Put it on")
        where = tk.StringVar(value="file")
        for val, txt in (("page", "This page"), ("file", "Every page of this file"),
                         ("book", "Every PDF in this book")):
            ttk.Radiobutton(body, text=txt, value=val, variable=where).pack(anchor="w")
        res = [None]

        def ok():
            spec.update(text=tv.get().strip() or "COPY", opacity=round(ov.get(), 2), layout=lay.get())
            spec["size"] = 64 if lay.get() == "centre" else 28
            st["watermark"] = {k: spec[k] for k in ("text", "color", "opacity", "layout")}
            res[0] = where.get()
            d.destroy()

        def remove():
            res[0] = "remove"
            d.destroy()
        bf = ttk.Frame(d, style="Panel.TFrame", padding=(18, 14))
        bf.pack(fill="x")
        PillButton(bf, self, "Add watermark", ok, kind="accent").pack(side="right")
        PillButton(bf, self, "Cancel", d.destroy, kind="ghost").pack(side="right", padx=6)
        PillButton(bf, self, "Remove watermarks from this file", remove, kind="soft").pack(side="left")
        d.bind("<Escape>", lambda e: d.destroy())
        self._center(d)
        d.grab_set()
        self.root.wait_window(d)
        if res[0] is None:
            return
        g = self.current_page
        fi0 = self.book.pages[g][0]
        if res[0] == "remove":
            self._remove_watermarks(fi0)
            return
        if res[0] == "page":
            targets = {fi0: [self.book.pages[g][1]]}
        elif res[0] == "file":
            targets = {fi0: None}
        else:
            targets = {fi: None for fi, f in enumerate(self.book.files) if f["pdf"] and not f["error"]}
        n = 0
        for fi, pages in targets.items():
            if not self.book.files[fi]["pdf"]:
                continue
            self._begin_edit(fi)
            doc = self.book.doc(fi)
            for pi in (pages if pages is not None else range(doc.page_count)):
                pg = doc.load_page(pi)
                sp = dict(spec, w=pg.rect.width, h=pg.rect.height)
                self._make_card(pg, sp)
                n += 1
            self._commit_edit(fi)
        self.set_status(f"Watermark added to {n} page(s).  Ctrl+Z to undo, or Watermark… > Remove.")

    def _remove_watermarks(self, fi):
        doc = self.book.doc(fi)
        self._begin_edit(fi)
        n = 0
        for pg in doc:
            for a in list(pg.annots() or []):
                sp = self._card_spec(a) if a.type[1] == "Stamp" else None
                if sp and sp.get("kind") == "watermark":
                    pg.delete_annot(a)
                    n += 1
        self._commit_edit(fi)
        self.set_status(f"Removed {n} watermark(s).")

    BG_TOPICS = ["Mixed collection", "Nature", "Sea", "Mountains", "Sky and clouds", "Forest", "Flowers", "Beach",
                 "Lake", "Waterfall", "Snow", "Autumn", "Sunset", "Night sky", "Garden", "Countryside", "City at night"]

    def _bg_dir(self):
        d = os.path.join(self.lib.meta_dir, "backgrounds")
        os.makedirs(d, exist_ok=True)
        return d

    def _remember_bg_picture(self, path, credit=""):
        lst = [p for p in self.lib.settings.get("bg_pictures", []) if p.get("path") != path and
               os.path.exists(p.get("path", ""))]
        lst.insert(0, {"path": path, "credit": credit})
        self.lib.settings["bg_pictures"] = lst[:40]

    def _use_bg_picture(self, path, credit=""):
        self._remember_bg_picture(path, credit)
        conf = dict(self._bg_conf())
        conf.update(mode="picture", picture=path, credit=credit)
        try:                                   # two calm tones of the picture, for bubbles, clouds…
            pix = self.fitz.Pixmap(path)
            small = self.fitz.Pixmap(pix, 4, 4, None) if pix.n >= 3 else None
            if small is not None:
                s = small.samples
                n = small.n
                tones = []
                for k in (0, 15):
                    tones.append("#%02X%02X%02X" % (s[k * n], s[k * n + 1], s[k * n + 2]))
                conf["tones"] = tones
        except Exception:
            pass
        self.lib.settings["background"] = conf
        self.lib.save_meta()
        self.apply_background()

    def picture_gallery(self, parent=None, on_done=None, use=None, title=None):
        """Pictures for behind the pages: beautiful photos from the internet (Wikimedia Commons) and your own.
        4.3: use = what to do with the chosen picture (Home's photo), title = the window's title."""
        T = self.T
        use_ = use or self._use_bg_picture
        w = tk.Toplevel(parent or self.root)
        w.title(title or "Pictures for behind the pages")
        w.configure(bg=T["panel"])
        w.transient(parent or self.root)
        sw, sh = self.root.winfo_screenwidth(), self.root.winfo_screenheight()
        w.geometry(f"{min(980, sw - 80)}x{min(720, sh - 100)}")
        top = tk.Frame(w, bg=T["panel"], padx=18, pady=12)
        top.pack(fill="x")
        tk.Label(top, text="Pictures", font=self.F(14, "bold"), bg=T["panel"], fg=T["text"]).pack(anchor="w")
        tk.Label(top, text="Choose a photo from the internet, or one of your own. Click a picture to use it.",
                 font=self.F(9), bg=T["panel"], fg=T["muted"]).pack(anchor="w")
        sr = tk.Frame(top, bg=T["panel"])
        sr.pack(fill="x", pady=(10, 4))
        qv = tk.StringVar()
        en = ttk.Entry(sr, textvariable=qv, width=34, font=self.F(10))
        en.pack(side="left")
        state = {"items": [], "imgs": [], "busy": False, "token": 0}
        status = tk.Label(sr, text="", font=self.F(9), bg=T["panel"], fg=T["muted"])

        def search(q):
            q = (q or "").strip()
            if not q:
                return
            qv.set(q)
            state["token"] += 1
            tok = state["token"]
            status.configure(text="Looking for pictures…")
            grid_clear()
            box = {"res": None, "err": None, "thumbs": {}}

            def work():
                try:
                    if q.startswith("Mixed collection"):
                        state["pp"] = state.get("pp", 0) + 1
                        box["res"] = picsum_list(state["pp"] + 1, 30)[:24]
                    else:
                        try:
                            box["res"] = commons_pictures(q, 24)
                        except Exception:
                            box["note"] = "Wikimedia is busy - here is a mixed collection instead."
                            box["res"] = picsum_list(2, 30)[:24]
                    for i, r in enumerate(box["res"]):
                        if state["token"] != tok:
                            return
                        try:
                            box["thumbs"][i] = web_get(r["thumb"])
                        except Exception:
                            box["thumbs"][i] = None
                except Exception as ex:
                    box["err"] = str(ex)
            threading.Thread(target=work, daemon=True).start()
            shown = set()

            def poll():
                if not w.winfo_exists() or state["token"] != tok:
                    return
                if box["err"]:
                    status.configure(text="Can't reach the internet right now - try again later, or use your own "
                                          "pictures.")
                    return
                if box["res"] is not None:
                    if not box["res"]:
                        status.configure(text="No pictures found - try another word.")
                        return
                    for i, r in enumerate(box["res"]):
                        if i in shown or i not in box["thumbs"]:
                            continue
                        shown.add(i)
                        add_tile(r, box["thumbs"][i])
                    status.configure(text=box.get("note") or
                                     f"{len(shown)} of {len(box['res'])} pictures · " +
                                     ("Lorem Picsum (Unsplash)" if box["res"] and box["res"][0].get("picsum")
                                      else "from Wikimedia Commons"))
                    if len(shown) >= len(box["res"]):
                        return
                w.after(150, poll)
            poll()
        PillButton(sr, self, "Search", lambda: search(qv.get()), kind="accent", height=30).pack(side="left", padx=6)
        en.bind("<Return>", lambda e: search(qv.get()))

        def surprise():
            status.configure(text="Getting a surprise photo…")
            box = {"path": None, "err": None}

            def work():
                try:
                    import hashlib
                    data = web_get(f"https://picsum.photos/2400/1350?random={int(time.time())}", timeout=20)
                    p = os.path.join(self._bg_dir(), hashlib.sha1(data).hexdigest()[:16] + ".jpg")
                    with open(p, "wb") as fh:
                        fh.write(data)
                    box["path"] = p
                except Exception as ex:
                    box["err"] = str(ex)
            threading.Thread(target=work, daemon=True).start()

            def poll():
                if not w.winfo_exists():
                    return
                if box["err"]:
                    status.configure(text="Can't reach the internet right now.")
                    return
                if box["path"]:
                    status.configure(text="Done.")
                    use_(box["path"], "Lorem Picsum (Unsplash)")
                    fill_mine()
                    return
                w.after(150, poll)
            poll()
        PillButton(sr, self, "Surprise me", surprise, kind="soft", height=30).pack(side="left")
        status.pack(side="left", padx=10)
        chips = tk.Frame(top, bg=T["panel"])
        chips.pack(fill="x", pady=(4, 0))
        for i, t in enumerate(self.BG_TOPICS):
            lb = tk.Label(chips, text=t, font=self.F(9), bg=T["chip"], fg=T["text"], padx=9, pady=3, cursor="hand2")
            lb.grid(row=i // 8, column=i % 8, padx=2, pady=2, sticky="w")
            lb.bind("<Button-1>", lambda e, t=t: search(t))
        # my pictures
        mine = tk.Frame(w, bg=T["panel"], padx=18)
        mine.pack(fill="x")
        tk.Label(mine, text="MY PICTURES", font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(anchor="w",
                                                                                                   pady=(6, 4))
        mine_row = tk.Frame(mine, bg=T["panel"])
        mine_row.pack(fill="x")

        def thumb_from(data_or_path, tw=180, th=104):
            pix = self.fitz.Pixmap(data_or_path)
            if pix.alpha:
                pix = self.fitz.Pixmap(pix, 0)
            if pix.colorspace and pix.colorspace.n != 3:
                pix = self.fitz.Pixmap(self.fitz.csRGB, pix)
            k = max(tw / pix.width, th / pix.height)
            pix = self.fitz.Pixmap(pix, max(1, int(pix.width * k)), max(1, int(pix.height * k)), None)
            img = tk.PhotoImage(data=pix.tobytes("ppm"))
            out = tk.PhotoImage(width=tw, height=th)
            x0, y0 = max(0, (img.width() - tw) // 2), max(0, (img.height() - th) // 2)
            out.tk.call(out.name, "copy", img.name, "-from", x0, y0, x0 + tw, y0 + th, "-to", 0, 0)
            return out

        def fill_mine():
            for c in mine_row.winfo_children():
                c.destroy()
            add = tk.Label(mine_row, text="+  Add a picture…", font=self.F(9), bg=T["chip"], fg=T["text"], width=18,
                           height=5, cursor="hand2")
            add.pack(side="left", padx=(0, 8))
            add.bind("<Button-1>", lambda e: add_own())
            cur = self._bg_conf().get("picture")
            for p in self.lib.settings.get("bg_pictures", [])[:6]:
                path = p.get("path", "")
                if not os.path.exists(path):
                    continue
                try:
                    img = thumb_from(path, 132, 78)
                except Exception:
                    continue
                state["imgs"].append(img)
                lb = tk.Label(mine_row, image=img, bd=0, cursor="hand2", highlightthickness=2,
                              highlightbackground=self.accent if path == cur else T["panel"])
                lb.pack(side="left", padx=3)
                lb.bind("<Button-1>", lambda e, p=p: (use_(p["path"], p.get("credit", "")),
                                                      fill_mine()))
                lb.bind("<Button-3>", lambda e, p=p: forget(p))

        def forget(p):
            lst = self.lib.settings.get("bg_pictures", [])
            self.lib.settings["bg_pictures"] = [x for x in lst if x.get("path") != p.get("path")]
            self.lib.save_meta()
            fill_mine()

        def add_own():
            path = filedialog.askopenfilename(parent=w, title="A picture for behind the pages",
                                              filetypes=[("Pictures", "*.png *.jpg *.jpeg *.bmp *.gif *.webp"),
                                                         ("All files", "*.*")])
            if not path:
                return
            try:
                key, _w, _h = import_image(self.fitz, path, self._bg_dir(), max_side=2600)
            except Exception as ex:
                messagebox.showerror(APP_NAME, f"Could not read that picture:\n{ex}", parent=w)
                return
            use_(os.path.join(self._bg_dir(), key + ".png"), "Your picture")
            fill_mine()
        fill_mine()
        # internet results
        tk.Label(w, text="FROM THE INTERNET", font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(
            anchor="w", padx=18, pady=(12, 4))
        wrap = tk.Frame(w, bg=T["panel"])
        wrap.pack(fill="both", expand=True, padx=18)
        cv = tk.Canvas(wrap, bg=T["panel"], highlightthickness=0)
        vs = ttk.Scrollbar(wrap, orient="vertical", command=cv.yview, style="Bold.Vertical.TScrollbar")
        cv.configure(yscrollcommand=vs.set)
        vs.pack(side="right", fill="y")
        cv.pack(side="left", fill="both", expand=True)
        inner = tk.Frame(cv, bg=T["panel"])
        cv.create_window(0, 0, window=inner, anchor="nw")
        inner.bind("<Configure>", lambda e: cv.configure(scrollregion=cv.bbox("all")))

        def wheel(e):
            cv.yview_scroll(-1 if (getattr(e, "delta", 0) > 0 or getattr(e, "num", 0) == 4) else 1, "units")
        for seq in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            cv.bind(seq, wheel)
            inner.bind(seq, wheel)

        def grid_clear():
            for c in inner.winfo_children():
                c.destroy()
            state["items"] = []

        def add_tile(r, data):
            i = len(state["items"])
            state["items"].append(r)
            fr = tk.Frame(inner, bg=T["panel"])
            fr.grid(row=i // 4, column=i % 4, padx=5, pady=5)
            try:
                img = thumb_from(data) if data else None
            except Exception:
                img = None
            if img is None:
                lb = tk.Label(fr, text="(picture)", width=24, height=6, bg=T["chip"], fg=T["muted"])
            else:
                state["imgs"].append(img)
                lb = tk.Label(fr, image=img, bd=0, cursor="hand2")
            lb.pack()
            title = re.sub(r"^File:|\.\w+$", "", r.get("title", ""))[:34]
            tk.Label(fr, text=title, font=self.F(8), bg=T["panel"], fg=T["muted"]).pack(anchor="w")
            lb.bind("<Button-1>", lambda e, r=r: choose(r))
            for wd in (fr, lb):
                for seq in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
                    wd.bind(seq, wheel)

        def choose(r):
            status.configure(text="Downloading the picture…")
            box = {"path": None, "err": None}

            def work():
                try:
                    import hashlib
                    url = r["url"] if r.get("picsum") else (commons_big(r["title"], 2400) or r["url"])
                    data = web_get(url, timeout=40)
                    ext = os.path.splitext(url.split("?")[0])[1].lower() or ".jpg"
                    p = os.path.join(self._bg_dir(), hashlib.sha1(data).hexdigest()[:16] + ext)
                    with open(p, "wb") as fh:
                        fh.write(data)
                    box["path"] = p
                except Exception as ex:
                    box["err"] = str(ex)
            threading.Thread(target=work, daemon=True).start()

            def poll():
                if not w.winfo_exists():
                    return
                if box["err"]:
                    status.configure(text="Could not download it - try another one.")
                    return
                if box["path"]:
                    status.configure(text="Done - it is used now." if use else "Done - it is behind your pages now.")
                    use_(box["path"], ("Lorem Picsum - " if r.get("picsum") else "Wikimedia Commons: ")
                                         + r.get("title", ""))
                    fill_mine()
                    return
                w.after(150, poll)
            poll()
        bt = tk.Frame(w, bg=T["panel"], padx=18, pady=10)
        bt.pack(fill="x")
        tk.Label(bt, text="Photos from Wikimedia Commons (free to use) and Lorem Picsum · right-click one of your "
                          "pictures to remove it from the list", font=self.F(8), bg=T["panel"],
                 fg=T["muted"]).pack(side="left")

        def close():
            w.destroy()
            if on_done:
                on_done()
        PillButton(bt, self, "Done", close, kind="accent").pack(side="right")
        w.protocol("WM_DELETE_WINDOW", close)
        w.bind("<Escape>", lambda e: close())
        w.after(200, lambda: search("Nature"))
        return w

