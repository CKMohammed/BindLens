def header_meaning(h):
    """(field, role) a column title points to: 'Parent/Guardian mobile' -> ('phone', 'parent'), 'Pupil' ->
    ('name', 'student'), 'Column 3' -> (None, None)."""
    if h in _HDR_CACHE:
        return _HDR_CACHE[h]
    t = fold_label(h)
    field = role = None
    if t and not re.fullmatch(r"column \d+", t):
        words = set(t.split())
        for r_, syn in ROLE_SYN.items():
            if any((s in t) if " " in s else (s in words) for s in syn):
                role = r_
                break
        for f_, syn in FIELD_SYN.items():
            if any(s == t or ((s in t) if " " in s else (s in words)) for s in syn):
                field = f_
                break
        if field in ("id", "date") and role and not re.search(r"\b(?:no|id|ref|number|date|dob)\b", t):
            field = "name"
        if field is None and role:
            field = "name"                   # 'Parent/Guardian', 'Emergency contact', 'Pupil'
        if field is None and len(t) >= 4:
            import difflib
            for f_, syn in FIELD_SYN.items():
                if any(difflib.SequenceMatcher(None, t, s).ratio() >= 0.85 for s in syn if len(s) >= 4):
                    field = f_
                    break
    if len(_HDR_CACHE) > 4000:
        _HDR_CACHE.clear()
    _HDR_CACHE[h] = (field, role)
    return field, role


def name_likeness(c):
    """0..1 how much a cell looks like a person's name ('Seán Ó Briain' 0.9, 'Ryan Plumbing Ltd' 0)."""
    t = (c or "").strip()
    if not t or re.search(r"\d|@|/|€|\$|£|%|#", t):
        return 0.0
    toks = t.replace(",", " ").split()
    if not toks or len(toks) > 5:
        return 0.0
    s = 0.0
    if all(re.match(r"^(?:[A-ZÀ-ÞĀ-Ž]|O['’]|Mc|Mac|Ní|Ó|Nic|Uí)", w) or w.lower() in NAME_PARTICLES for w in toks):
        s += 0.4
    if any(fold(w).strip(".,'’") in FIRST_NAMES for w in toks):
        s += 0.3
    if 2 <= len(toks) <= 3:
        s += 0.2
    if person_like(t):
        s += 0.15
    if NOT_NAME.search(t) or ORG_WORDS.search(t):
        s -= 0.6
    return max(0.0, min(1.0, s))


def cell_kind(c):
    """What one cell holds: email · phone · date · amount · eircode · time · number · name · first · word · text."""
    c = (c or "").strip()
    if not c:
        return ""
    if "@" in c and EXTRACT_PATTERNS["Emails"].search(c.replace(" ", "")):
        return "email"
    if re.fullmatch(r"\d{1,2}[/.-]\d{1,2}[/.-]\d{2,4}|\d{4}-\d{2}-\d{2}", c) or (
            len(c) <= 30 and EXTRACT_PATTERNS["Dates"].fullmatch(c)):
        return "date"
    d = re.sub(r"[\s().\-/]", "", c)
    if re.fullmatch(r"(?:\+|00)\d{8,14}|0\d{8,10}", d) or (re.fullmatch(r"[6789]\d{8}", d) and " " in c):
        return "phone"
    if re.search(r"[€$£]|\b(?:eur|euros?|usd|gbp)\b", c, re.I) and re.search(r"\d", c) and len(c) <= 24:
        return "amount"
    if re.fullmatch(r"-?\d{1,3}(?:[,.]\d{3})*[.,]\d{2}|-?\d+[.,]\d{2}", c):
        return "amount"
    if EXTRACT_PATTERNS["Eircodes / postcodes"].fullmatch(c.upper()):
        return "eircode"
    if re.fullmatch(r"(?:[01]?\d|2[0-3])[:.][0-5]\d(?:\s?(?:am|pm))?", c, re.I):
        return "time"
    if re.fullmatch(r"[-+]?[\d.,]+%?", c):
        return "number"
    if " " not in c and re.fullmatch(r"[A-ZÀ-ÞĀ-Ž][a-zß-ÿā-ž'’-]+", c):
        return "first" if fold(c) in FIRST_NAMES else "word"
    if name_likeness(c) >= 0.55:
        return "name"
    return "text"


_K_OF_FIELD = {"email": "email", "phone": "phone", "name": "name", "first": "name", "last": "name", "date": "date",
               "dob": "date", "amount": "amount", "eircode": "eircode"}
_K_NICE = {"email": "Email", "phone": "Phone", "name": "Name", "first": "First name", "last": "Surname",
           "date": "Date", "dob": "Date of birth", "amount": "Amount", "eircode": "Eircode", "time": "Time",
           "number": "Number", "contact": "Phone / email", "org": "Organisation", "address": "Address", "id": "ID",
           "text": "Text"}


def type_columns(rows):
    """Type every column of every table on a page from its values (and its title as a tie-breaker).
    Sets row["ct"] (field of each column), row["cr"] (role of each column: parent, emergency…) and row["cev"]
    (one line per column: how it was read)."""
    groups = OrderedDict()
    for r in rows:
        if r.get("table") and len(r.get("cells") or []) > 1:
            groups.setdefault((tuple(r.get("header") or ()), r.get("tbox"), len(r["cells"])), []).append(r)
    for (hdr, _tb, n), rs in groups.items():
        types, roles, ev = [], [], []
        for j in range(n):
            h = hdr[j] if j < len(hdr) else ""
            hf, hr = header_meaning(h)
            vals = [(r["cells"][j] or "").strip() for r in rs if j < len(r["cells"]) and (r["cells"][j] or "").strip()]
            if not vals:
                types.append(hf or "text")
                roles.append(hr)
                ev.append("")
                continue
            kinds = [cell_kind(v) for v in vals]
            cnt = Counter(kinds)
            nv = float(len(vals))
            share = {k: c / nv for k, c in cnt.items()}
            cand = {k: share.get(k, 0.0) for k in ("email", "phone", "date", "amount", "eircode", "time", "number")}
            cand["name"] = share.get("name", 0) + 0.8 * share.get("first", 0) + \
                (0.6 * share.get("word", 0) if hf in ("name", "first", "last") else 0.0)
            hk = _K_OF_FIELD.get(hf)
            if hk:
                cand[hk] = cand.get(hk, 0) + 0.25
            best = max(cand, key=lambda k: cand[k])
            ok = cand[best] >= 0.6 or (hk == best and cand[best] >= 0.4)
            if ok and best == "name":
                distinct = len({fold(v) for v in vals}) / nv
                mean_nl = sum(name_likeness(v) if k_ not in ("first", "word") else 0.6
                              for v, k_ in zip(vals, kinds)) / nv
                ok = mean_nl >= 0.42 and (distinct >= 0.6 or nv <= 3 or hk == "name")
            if not ok and share.get("phone", 0) + share.get("email", 0) >= 0.7:
                best, ok = "contact", True              # a mixed 'Contact' column: each cell is read on its own
            if ok:
                f = best
                if best == "name" and hf in ("first", "last"):
                    f = hf
                elif best == "name" and share.get("first", 0) >= 0.7 and hf not in ("name",):
                    f = "first"
                elif best == "name" and share.get("word", 0) >= 0.7 and hf not in ("name",):
                    f = "last"
                elif best == "date" and hf == "dob":
                    f = "dob"
            else:
                f = hf if hf in ("org", "address", "id") else "text"
            types.append(f)
            roles.append(hr)
            if f not in ("text",):
                agree = "" if not hf else (" (title agrees)" if _K_OF_FIELD.get(hf) == _K_OF_FIELD.get(f, f) or hf == f
                                           else " (the title says otherwise)")
                got = cnt.get(_K_OF_FIELD.get(f, f), 0) + (cnt.get("first", 0) + cnt.get("word", 0)
                                                           if f in ("name", "first", "last") else 0)
                if f == "contact":
                    got = cnt.get("phone", 0) + cnt.get("email", 0)
                ev.append(f'Column “{h or j + 1}” read as {_K_NICE.get(f, f)}: {min(got, int(nv))} of {int(nv)} '
                          f'values{agree}')
            else:
                ev.append("")
        # two one-word columns side by side: first name + surname
        for j in range(n - 1):
            if types[j] in ("first", "name") and types[j + 1] in ("last", "name") and roles[j] == roles[j + 1]:
                single = all(len((r["cells"][j] or "").split()) <= 1 and len((r["cells"][j + 1] or "").split()) <= 1
                             for r in rs if j + 1 < len(r["cells"]))
                if single and (types[j] == "first" or types[j + 1] == "last"):
                    types[j], types[j + 1] = "first", "last"
        for r in rs:
            r["ct"], r["cr"], r["cev"] = types, roles, ev
    return rows


def row_names(row):
    """[(column, name, role)] of the people in a typed table row (first name + surname joined)."""
    ct, cr, cells = row.get("ct") or [], row.get("cr") or [], row.get("cells") or []
    out, used = [], set()
    role = lambda j: cr[j] if j < len(cr) else None
    las = [k for k, t in enumerate(ct) if t == "last"]
    for j, t in enumerate(ct):
        if t != "first" or j >= len(cells):
            continue
        k = min((k for k in las if role(k) == role(j) and k not in used), key=lambda k: abs(k - j), default=None)
        f = (cells[j] or "").strip()
        l_ = (cells[k] or "").strip() if k is not None and k < len(cells) else ""
        nm = person_like(f"{f} {l_}") if f and l_ else ""
        if nm:
            out.append((min(j, k), nm, role(j)))
            used.update((j, k))
    for j, t in enumerate(ct):
        if t == "name" and j not in used and j < len(cells):
            c = (cells[j] or "").strip()
            nm = person_like(c) or (c if looks_like_name(c) else "")
            if nm:
                out.append((j, nm, role(j)))
    return sorted(out)


def _main_name(names):
    for j, nm, r in names:
        if r in (None, "student", "staff"):
            return nm
    return names[0][1] if names else ""


def row_person(row, j=None):
    """The person a value in column j of a typed row belongs to -> (name, how). A value in a 'Parent mobile' column
    goes to the parent's name; one with no role goes to the nearest name on its left."""
    names = row_names(row)
    if not names:
        return "", ""
    cr = row.get("cr") or []
    role = cr[j] if j is not None and j < len(cr) else None
    pick = None
    if role:
        same = [x for x in names if x[2] == role]
        if same:
            pick = min(same, key=lambda x: abs(x[0] - (j or 0)))
    if pick is None and j is not None:
        left = [x for x in names if x[0] < j]
        pick = max(left, key=lambda x: x[0]) if left else min(names, key=lambda x: abs(x[0] - j))
    if pick is None:
        pick = next((x for x in names if x[2] in (None, "student", "staff")), names[0])
    how = "same row"
    main = _main_name(names)
    if pick[2] and pick[2] not in ("student", "staff") and main and main != pick[1]:
        how = f"same row · {ROLE_NICE.get(pick[2], pick[2])} of {main}"
    return pick[1], how


def _cell_of(row, value):
    if not value or not row.get("table"):
        return None
    v = value.lower()
    for j, c in enumerate(row.get("cells") or []):
        if v in (c or "").lower():
            return j
    return None


def email_header_name(text, email):
    """'"Mary Ryan" <mary.ryan@x.ie>', 'From: Mary Ryan <…>', 'mary@x.ie (Mary Ryan)' -> 'Mary Ryan'."""
    if not text or not email:
        return ""
    e = re.escape(email)
    for rx in (r"([^<>\[\]()|;,\n]{3,60}?)\s*[<\[(]\s*(?:mailto:)?" + e + r"\s*[>\])]",
               e + r"\s*[(\[]\s*([^()\[\]|;\n]{3,48}?)\s*[)\]]"):
        m = re.search(rx, text, re.I)
        if m:
            cand = m.group(1).strip().strip("\"'“”")
            cand = re.sub(r"^.*?\b(?:from|to|cc|bcc|reply-to|sender|de|para|von|an)\s*:\s*", "", cand, flags=re.I)
            cand = cand.strip().strip("\"'“”")
            p = person_like(cand)
            if p:
                return p
    return ""


def email_match(name, email):
    """0..1 how well a name fits an email address ('Mary Ryan' ~ mryan@, mary.ryan@, ryanm@)."""
    if not name or not email or "@" not in email:
        return 0.0
    loc = re.sub(r"[^a-z]", "", fold(email.split("@")[0].split("+")[0]))
    toks = [re.sub(r"[^a-z]", "", fold(t)) for t in re.findall(r"[^\W\d_]+", name)]
    toks = [t for t in toks if len(t) > 1 and t not in NAME_PARTICLES and t not in TITLES]
    if not toks or len(loc) < 2:
        return 0.0
    first, last = toks[0], toks[-1]
    if len(toks) >= 2 and first in loc and last in loc:
        return 1.0
    if len(last) >= 3 and last in loc and (loc.startswith(first[0]) or loc.endswith(first[0])):
        return 0.9
    if len(last) >= 4 and last in loc:
        return 0.7
    if len(first) >= 4 and first in loc:
        return 0.55
    import difflib
    if difflib.SequenceMatcher(None, loc, first + last).ratio() >= 0.85:
        return 0.6
    return 0.0


def heading_person(title):
    """The person a heading is about: 'Emergency contacts for Seán Ó Briain' -> 'Seán Ó Briain'."""
    t = (title or "").strip()
    if not t or len(t) > 90:
        return ""
    m = re.search(r"\b(?:for|of|re:?|regarding|about|para|de)\s+(.{3,48})$", t, re.I) or \
        re.search(r"[-–:]\s*(.{3,48})$", t)
    if m:
        p = person_like(m.group(1).strip(" .:"))
        if p:
            return p
    return person_like(t)


def _row_label(text):
    m = re.match(r"^\s*([A-Za-zÀ-ÿ][\w ’'/()&.-]{0,30}?)\s*[:：]", text or "")
    return fold_label(m.group(1)) if m else None


LINK_SURE = [("email header", 97), ("form label", 92), ("same row", 95), ("label", 90), ("column", 88), ("heading", 85),
             ("matches the email", 85), ("nearby", 70), ("from email", 45), ("earlier in the file", 35)]


def link_sure(how):
    """How sure (0-100) a link is, from how it was made."""
    h = (how or "").lower()
    if not h:
        return 0
    for k, p in LINK_SURE:
        if k in h:
            return p
    return 60


def sure_text(how):
    p = link_sure(how)
    return f"{p}% · {how}" if how else ""


