        r.bind("<Configure>", lambda e: e.widget is r and self._qbar_size_later(), add="+")

    def _layout_tools(self):
        tc = self.tools_canvas
        T = self.T
        tc.delete("bg")
        tc.configure(bg=T["bg"])
        x = 6
        tc.delete("sep")

        def sep():
            nonlocal x
            tc.create_line(x + 4, 12, x + 4, 28, fill=T["border"], tags="sep")
            x += 10
        groups = [["select"], ["pen", "text", "note", "shapes", "stamp"], ["eraser"]]
        for gi, grp in enumerate(groups):
            for k in grp:
                tc.delete("w_" + k)
                tc.create_window(x, 3, window=self.tool_btns[k], anchor="nw", tags="w_" + k)
                x += 36
            if gi < len(groups) - 1:
                sep()
        x += 4
        tc.delete("w_color")
        tc.create_window(x, 3, window=self.color_btn, anchor="nw", tags="w_color")
        x += 36
        sep()
        tc.delete("w_undo")
        tc.create_window(x, 3, window=self.btn_undo, anchor="nw", tags="w_undo")
        x += 34
        tc.delete("w_redo")
        tc.create_window(x, 3, window=self.btn_redo, anchor="nw", tags="w_redo")
        x += 36
        sep()
        tc.delete("w_page")
        tc.create_window(x, 3, window=self.btn_page, anchor="nw", tags="w_page")
        x += 36 + 4
        tc.configure(width=x)
        round_rect(tc, 0, 0, x, 40, 20, fill=T["chip"], outline="", tags="bg")
        tc.tag_lower("bg")
        self._draw_color_btn()

    def _draw_color_btn(self):
        T = self.T
        c = self.color_btn
        c.delete("all")
        c.configure(bg=T["chip"])
        col = self.lib.settings.get("color", "#FFE14D")
        c.create_oval(8, 8, 26, 26, fill=col, outline=mix(col, "#000000", 0.25), width=1)
        c.create_oval(5, 5, 29, 29, outline=T["border"], width=1)

    def _draw_search(self):
        T, sc = self.T, self.search_canvas
        sc.delete("all")
        sc.configure(bg=T["bg"])
        focus = self.root.focus_get() == self.search_entry
        W = getattr(self, "_search_w", 260)
        round_rect(sc, 1, 1, W - 1, 35, 17, fill=T["chip"], outline=self.accent if focus else T["chip"], width=1)
        draw_icon(sc, "search", 20, 18, T["muted"], s=0.8)
        self.search_entry.configure(bg=T["chip"], fg=T["muted"] if getattr(self, "_ph", False) else T["text"],
                                    insertbackground=T["text"], disabledbackground=T["chip"])
        sc.create_window(36, 18, window=self.search_entry, anchor="w",
                         width=max(60, W - (90 if self.search_count else 55)))
        if self.search_count:
            sc.create_text(W - 12, 18, text=self.search_count, anchor="e", fill=T["muted"], font=self.F(9))

    def _fit_topbar(self, _e=None):
        """The tools in the middle never cover the search box or the Reports button: the search box gets
        narrower on small screens and the tools move aside."""
        try:
            W = self.bar.winfo_width()
            if W < 100:
                return
            left_w = self.logo_lbl.master.winfo_reqwidth() + 14
            tw = self.tools_frame.winfo_reqwidth()
            others = sum(b.winfo_reqwidth() for b in (self.btn_full, self.btn_settings, self.btn_report,
                                                      self.btn_guide, self.btn_read, self.btn_print)) + 50
            sw = 260
            need = left_w + tw + others + sw + 44
            if need > W:
                sw = max(140, sw - (need - W))
            if sw != getattr(self, "_search_w", 260):
                self._search_w = sw
                self.search_canvas.configure(width=sw)
                self._draw_search()
            right_w = others + sw + 22
            x = (W - tw) / 2
            x = min(x, W - right_w - tw - 6)
            x = max(x, left_w + 8)
            self.tools_frame.place(x=x, rely=0.5, anchor="w", relx=0)
        except Exception:
            pass

    def show_tab(self, name):
