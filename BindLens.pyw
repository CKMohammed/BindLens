    def show_launcher(self, _e=None):
        if self._launcher is not None:
            self.close_launcher()
            return
        T = self.T
        ov = tk.Frame(self.root, bg=T["bg"])
        ov.place(x=0, y=0, relwidth=1, relheight=1)
        ov.lift()
        self._launcher = ov
        head = tk.Frame(ov, bg=T["bg"])
        head.pack(fill="x", padx=40, pady=(28, 8))
        tk.Label(head, text=self.lib.title, font=self.F(20, "bold"), bg=T["bg"], fg=T["text"]).pack(side="left")
        n = len(self.lib.folders)
        tk.Label(head, text=f"   {n} book{'s' if n != 1 else ''}", font=self.F(10), bg=T["bg"],
                 fg=T["muted"]).pack(side="left", pady=(8, 0))
        IconButton(head, self, "close", self.close_launcher, "Close  (Esc)", size=34).pack(side="right")
        self._launch_q = tk.StringVar()                       # 4.0: find a book
        fe = tk.Entry(head, textvariable=self._launch_q, bd=0, relief="flat", font=self.F(10), width=24,
                      bg=T["panel"], fg=T["text"], insertbackground=T["text"], highlightthickness=1,
                      highlightbackground=T["border"], highlightcolor=self.accent)
        fe.pack(side="right", padx=(0, 14), ipady=6)
        tk.Label(head, text="Find", font=self.F(9), bg=T["bg"], fg=T["muted"]).pack(side="right", padx=(0, 6))
        self._launch_q.trace_add("write", lambda *a: self._draw_launcher())
        c = tk.Canvas(ov, bg=T["bg"], highlightthickness=0, bd=0)
        lb_ = SlimBar(ov, self, c, width=14)                  # 4.0: a clear bar to go up and down
        lb_.pack(side="right", fill="y", padx=(0, 10), pady=(0, 20))
        c.configure(yscrollcommand=lb_.set)
        c.pack(fill="both", expand=True, padx=28, pady=(0, 20))
        self._launch_c = c
        c.bind("<Configure>", lambda e: self._draw_launcher())
        c.bind("<Button-1>", self._launcher_click)
        c.bind("<Motion>", self._launcher_motion)
        c.bind("<Button-3>", lambda e: self._launcher_right(e))
        c.bind("<MouseWheel>", lambda e: c.yview_scroll(-1 if e.delta > 0 else 1, "units"))
        c.bind("<Button-4>", lambda e: c.yview_scroll(-1, "units"))
        c.bind("<Button-5>", lambda e: c.yview_scroll(1, "units"))
        ov.bind("<Escape>", lambda e: self.close_launcher())
        c.bind("<Escape>", lambda e: self.close_launcher())
        fe.focus_set()
        self._launch_hover = None

    def close_launcher(self):
        if self._launcher is not None:
            self._launcher.destroy()
            self._launcher = None
            self.canvas.focus_set()

    def _draw_launcher(self):
        c, T = self._launch_c, self.T
        c.delete("all")
        W = max(200, c.winfo_width())
        cw, ch, gap = 168, 206, 20
        cols = max(1, (W - 12) // (cw + gap))
        self._launch_cards = []
        q = fold((getattr(self, "_launch_q", None).get() if getattr(self, "_launch_q", None) else "").strip())
        items = [f for f in self.lib.folders if not q or q in fold(self.lib.label(f))] + ([None] if not q else [])
        for i, f in enumerate(items):
            x = 12 + (i % cols) * (cw + gap)
            y = 10 + (i // cols) * (ch + gap)
            hov = self._launch_hover == i
            on = f is not None and f == self.folder
            if f is None:
                round_rect(c, x, y, x + cw, y + ch, 14, fill=T["bg"], outline=self.accent if hov else T["border"],
                           dash=(4, 4))
                draw_icon(c, "plus", x + cw / 2, y + ch / 2 - 12, self.accent if hov else T["muted"], s=1.3)
                c.create_text(x + cw / 2, y + ch / 2 + 18, text="Add a folder\nor documents", font=self.F(10), fill=T["muted"],
                              justify="center")
            else:
                col = self.lib.color(f)
                lift = 3 if hov else 0                       # 4.0: the card under the mouse rises a little
                round_rect(c, x + 2, y + 5, x + cw + 2, y + ch + 5, 16, fill=mix(T["bg"], "#000000", 0.07 + 0.04 * hov),
                           outline="")
                y -= lift
                round_rect(c, x, y, x + cw, y + ch, 16, fill=T["panel"],
                           outline=self.accent if (hov or on) else mix(T["panel"], T["border"], 0.6),
                           width=2 if (hov or on) else 1)
                for k in range(12):                          # a soft wash of the book's colour
                    yy0 = y + 10 + k * 9
                    c.create_rectangle(x + 10, yy0, x + cw - 10, yy0 + 10,
                                       fill=mix(col, T["panel"], 0.7 + k * 0.022), outline="")
                if on:
                    round_rect(c, x + cw - 64, y + 16, x + cw - 16, y + 34, 9, fill=self.accent, outline="")
                    c.create_text(x + cw - 40, y + 25, text="open", font=self.F(8, "bold"), fill="#FFFFFF")
                img = self._cover(f)
                if img is not None:
                    c.create_image(x + cw / 2, y + 13, image=img, anchor="n")
                    c.create_rectangle(x + 12, y + 113, x + cw - 12, y + 118, fill=col, outline="")
                else:
                    draw_tile(c, x + cw / 2 - 32, y + 32, 64, col, icon=self.lib.icon(f),
                              text=initials(self.lib.label(f)), font=self.F(18, "bold"),
                              bg=mix(col, T["panel"], 0.82), style=self.lib.tstyle(f), badge=self.lib.badge(f))
                tx = x + 14
                draw_tile(c, tx, y + 131, 24, col, icon=self.lib.icon(f), text=initials(self.lib.label(f))[:2],
                          font=self.F(7, "bold"), bg=T["panel"], style=self.lib.tstyle(f), badge=self.lib.badge(f))
                name = self.lib.label(f)
                fnt = tkfont.Font(font=self.F(10, "bold"))
                while fnt.measure(name) > cw - 52 and len(name) > 3:
                    name = name[:-2] + "…" if not name.endswith("…") else name[:-2] + "…"
                c.create_text(tx + 30, y + 143, text=name, font=self.F(10, "bold"), fill=T["text"], anchor="w")
                nf = len(self.lib.folders[f])
                c.create_text(tx, y + 172, text=f"{nf} file{'s' if nf != 1 else ''}", font=self.F(9),
                              fill=T["muted"], anchor="w")
            self._launch_cards.append((x, y, x + cw, y + ch, f))
        rows = (len(items) + cols - 1) // cols
        c.configure(scrollregion=(0, 0, W, 20 + rows * (ch + gap)), yscrollincrement=40)

    def _launcher_at(self, e):
        c = self._launch_c
        xx, yy = c.canvasx(e.x), c.canvasy(e.y)
        for i, (x0, y0, x1, y1, f) in enumerate(getattr(self, "_launch_cards", [])):
            if x0 <= xx <= x1 and y0 <= yy <= y1:
                return i, f
        return None, None

    def _launcher_motion(self, e):
        i, _ = self._launcher_at(e)
        self._launch_c.configure(cursor="hand2" if i is not None else "")
        if i != self._launch_hover:
            self._launch_hover = i
            self._draw_launcher()

    def _launcher_click(self, e):
        i, f = self._launcher_at(e)
        if i is None:
            return
        self.close_launcher()
        if f is None:
            self._add_menu(e=e)
        elif f != self.folder or self.book is None:
            self.open_folder(f)

    def _launcher_right(self, e):
        i, f = self._launcher_at(e)
        if f is not None:
            self._folder_menu(f, e)

    # ============================================================ marks map
    def draw_map(self):
        mc = self.map_canvas
        mc.delete("marks")
        if not self.book or not self.total_h or len(self.page_tops) != self._total():
            return
        h = max(mc.winfo_height(), 1)
        for m in self.marks:
            y = (self.page_tops[m["g"]] + m["bbox"][1] * self.zoom) / self.total_h * h
            mc.create_rectangle(1, y - 1, 9, y + 2, fill=m["color"] or self.accent, outline="", tags="marks")
        # 1.9.2: pages you added (written, empty, from another PDF): a green band with a little "+"
        for g in getattr(self, "added_by_g", {}):
            if g >= len(self.page_tops):
                continue
            y0 = self.page_tops[g] / self.total_h * h
            y1 = max(y0 + 7, (self.page_tops[g] + self._page_h(g)) / self.total_h * h)
            mc.create_rectangle(0, y0, 10, y1, fill="#1BAF7A", outline="", tags="marks")
            yc = (y0 + y1) / 2
            mc.create_line(2, yc, 8, yc, fill="#FFFFFF", width=1.4, tags="marks")
            mc.create_line(5, yc - 3, 5, yc + 3, fill="#FFFFFF", width=1.4, tags="marks")
        mc.tag_raise("marks")

    def _draw_map_view(self, a, b):
        mc = self.map_canvas
        mc.delete("view")
        h = max(mc.winfo_height(), 1)
        mc.create_rectangle(0, a * h, 10, b * h, fill=self.T["border"], outline="", tags="view")
        mc.tag_lower("view")

    def _added_at(self, y):
        """The added page under y in the page strip (or None)."""
        if not self.book or not self.total_h or len(self.page_tops) != self._total():
            return None
        h = max(self.map_canvas.winfo_height(), 1)
        for g in getattr(self, "added_by_g", {}):
            if g >= len(self.page_tops):
                continue
            y0 = self.page_tops[g] / self.total_h * h
            y1 = max(y0 + 7, (self.page_tops[g] + self._page_h(g)) / self.total_h * h)
            if y0 - 2 <= y <= y1 + 2:
                return g
        return None

    def _map_strip_motion(self, e):
        g = self._added_at(e.y)
        if g == getattr(self, "_strip_tip_g", None):
            return
        self._map_strip_tip(None)
        if g is None:
            return
        info = self.added_by_g.get(g) or {}
        day = info.get("d", "")
        try:
            import datetime
            day = datetime.date.fromisoformat(day).strftime("%d %b %Y").lstrip("0") if day else ""
        except Exception:
            pass
        what = {"written": "Page written in BindLens", "empty": f"{info.get('what', 'Empty')} page added",
                "pdf": f"Page added from {info.get('what', 'another PDF')}"}.get(info.get("k"), "Page added")
        txt = f"Page {g + 1}  ·  {what}" + (f"  ·  {day}" if day else "") + "\nClick to go there"
        T = self.T
        w = tk.Toplevel(self.root)
        w.wm_overrideredirect(True)
        try:
            w.attributes("-topmost", True)
        except Exception:
            pass
        tk.Label(w, text=txt, bg=T["tip_bg"], fg=T["tip_fg"], font=self.F(9), padx=9, pady=4,
                 justify="left").pack()
        w.update_idletasks()
        w.geometry(f"+{self.map_canvas.winfo_rootx() - w.winfo_reqwidth() - 8}+{e.y_root - w.winfo_reqheight() // 2}")
        self._strip_tip, self._strip_tip_g = w, g

    def _map_strip_tip(self, _w):
        t = getattr(self, "_strip_tip", None)
        if t is not None:
            try:
                t.destroy()
            except Exception:
                pass
        self._strip_tip, self._strip_tip_g = None, None

    def _on_map_click(self, e):
        if not self.book:
            return
        g = self._added_at(e.y)
        if g is not None:
            self._map_strip_tip(None)
            self.goto_page(g)
            return
        h = max(self.map_canvas.winfo_height(), 1)
        frac = e.y / h
        vis = self.canvas.winfo_height() / max(self.total_h, 1)
        self.canvas.yview_moveto(max(0, frac - vis / 2))
        self.redraw()

    # =============================================================== tools
    def _tool_click(self, k):
        if k in ("shapes", "stamp", "eraser"):
            self.set_tool(k)
            self._tool_menu(k)
        else:
            self.set_tool(k)

    def _tool_menu(self, k):
        st = self.lib.settings
        b = self.tool_btns[k]
        m = self._menu()
        if k == "shapes":
            cur = st.get("shape", "rect")
            v = self._var("shape", cur)
            m.add_command(label="FILL WITH COLOUR AND WRITE INSIDE", state="disabled")
            for key, label in SHAPE_LOOKS.items():
                m.add_radiobutton(label="   " + label, value="w:" + key, variable=v,
                                  command=lambda key=key: self._set_variant("shape", "w:" + key))
            sc = st.setdefault("shape_card", {})
            cm = self._menu(m)

            def sc_changed():
                if not str(st.get("shape", "")).startswith("w:"):
                    self._set_variant("shape", "w:s_rect")
                self._preview_shape_card()
            self._shape_style_items(cm, sc, sc_changed, b.winfo_rootx(), b.winfo_rooty() + b.winfo_height())
            m.add_cascade(label="   Colours and effects…", menu=cm)
            m.add_separator()
            m.add_command(label="LINES AND OUTLINES", state="disabled")
            for key, label in SHAPES:
                m.add_radiobutton(label="   " + label, value=key, variable=v,
                                  command=lambda key=key: self._set_variant("shape", key))
            m.add_separator()
            m.add_command(label="White box  -  hide the PDF's own text", command=lambda: (
                st.__setitem__("erase", "cover"), self.set_tool("eraser")))
            m.add_separator()
            fv = tk.BooleanVar(value=st.get("shape_fill", False))
            self._keep_var = fv
            m.add_checkbutton(label="Fill boxes and circles", variable=fv,
                              command=lambda: st.__setitem__("shape_fill", fv.get()))
        elif k == "stamp":
            cur = st.get("stamp", "Approved")
            v = self._var("stamp", cur)
            for name, col in STAMPS:
                m.add_radiobutton(label=name, value=name, variable=v, foreground=col,
                                  command=lambda n=name: self._set_variant("stamp", n))
            mine = st.get("my_stamps", [])
            if mine:
                m.add_separator()
                for i, sp in enumerate(mine):
                    lab = {"sign": "✍ ", "image": "▣ "}.get(sp.get("kind"), "★ ") + sp.get("name", "My stamp")
                    m.add_radiobutton(label=lab, value=f"my:{i}", variable=v,
                                      command=lambda i=i: self._set_variant("stamp", f"my:{i}"))
            m.add_separator()                       # 3.2: ticks, crosses and quick marks
            m.add_command(label="TICKS, CROSSES AND QUICK MARKS", state="disabled")
            for key, (name, glyph, col) in SYMBOLS.items():
                m.add_radiobutton(label=f"   {glyph}   {name}", value=f"sym:{key}", variable=v, foreground=col,
                                  command=lambda key=key: self._set_variant("stamp", f"sym:{key}"))
            zm = self._menu(m)
            zv = self._var("sym_size", float(st.get("sym_size", 24)))
            for val, lab in ((16, "Small"), (24, "Medium"), (34, "Big"), (48, "Very big")):
                zm.add_radiobutton(label=lab, value=float(val), variable=zv,
                                   command=lambda val=val: st.__setitem__("sym_size", float(val)))
            zm.add_separator()
            cv_ = self._var("sym_color", st.get("sym_color", "own"))
            zm.add_radiobutton(label="Their own colours (green tick, red cross…)", value="own", variable=cv_,
                               command=lambda: st.__setitem__("sym_color", "own"))
            zm.add_radiobutton(label="The colour chosen at the top", value="mine", variable=cv_,
                               command=lambda: st.__setitem__("sym_color", "mine"))
            m.add_cascade(label="   Size and colour of the quick marks", menu=zm)
            m.add_separator()
            m.add_command(label="Create a stamp…", command=self._custom_stamp)
            m.add_command(label="Signature…", command=self.signature_dialog)
            m.add_command(label="Picture or logo…", command=self.picture_stamp)
            sm = self._menu(m)
            for key, label in STAMP_STYLES.items():
                sm.add_radiobutton(label=label, value=key, variable=self._var("stamp_style", st.get("stamp_style",
                                                                                                    "rubber")),
                                   command=lambda key=key: st.__setitem__("stamp_style", key))
            m.add_cascade(label="Look of the stamps above", menu=sm)
            dv = tk.BooleanVar(value=st.get("stamp_date", True))
            self._keep_var = dv
            m.add_checkbutton(label="Add today's date", variable=dv,
                              command=lambda: st.__setitem__("stamp_date", dv.get()))
            if mine:
                dm = self._menu(m)
                for i, sp in enumerate(mine):
                    dm.add_command(label=sp.get("name", "My stamp"), command=lambda i=i: self._my_stamp_delete(i))
                m.add_cascade(label="Delete one of my stamps", menu=dm)
        else:
            cur = st.get("erase", "marks")
            v = self._var("erase", cur)
            m.add_radiobutton(label="Erase marks  (text boxes, notes, highlights, drawings…)", value="marks",
                              variable=v, command=lambda: self._set_variant("erase", "marks"))
            m.add_separator()
            m.add_command(label="HIDE THE PDF'S OWN TEXT  (you can remove it later)", state="disabled")
            m.add_radiobutton(label="   White box  -  drag over the text", value="cover", variable=v,
                              command=lambda: self._set_variant("erase", "cover"))
            m.add_radiobutton(label="   White brush  -  paint over the text", value="brush", variable=v,
                              command=lambda: self._set_variant("erase", "brush"))
            bm = self._menu(m)
            for wd, lab in ((8, "Thin"), (16, "Medium"), (28, "Thick")):
                bm.add_radiobutton(label=lab, value=str(wd), variable=self._var("brush_w", str(st.get("brush_w", 16))),
                                   command=lambda wd=wd: (st.__setitem__("brush_w", wd),
                                                          self._set_variant("erase", "brush")))
            m.add_cascade(label="   Brush size", menu=bm)
            m.add_separator()
            m.add_radiobutton(label="Erase the text for good  (private data - it can't come back)", value="whiteout",
                              variable=v, command=lambda: self._set_variant("erase", "whiteout"))
        self._popup(m, x=b.winfo_rootx(), y=b.winfo_rooty() + b.winfo_height() + 4)

    def _var(self, key, cur):
        v = tk.StringVar(value=cur)
        setattr(self, "_v_" + key, v)
        return v

    def _preview_shape_card(self):
        sc = self.lib.settings.get("shape_card", {})
        fx = [lab for k_, lab in (("grad", "gradient"), ("gloss", "glossy"), ("glow", "glow"), ("raised", "3D"),
                                  ("shadow", "shadow"), ("dash", "dashed line")) if sc.get(k_)]
        if float(sc.get("op", 1.0)) < 0.99:
            fx.append("see-through")
        self._toast("New shapes: " + (", ".join(fx) if fx else "plain") + ".  Drag on the page to draw one.")

    def _shape_style_items(self, mm, spec, changed, px, py):
        """Colours, line and effects of a shape - used by the box bar and by the Shapes tool (new shapes)."""
        def put(**kw):
            for k_, v_ in kw.items():
                if v_ is None:
                    spec.pop(k_, None)
                else:
                    spec[k_] = v_
            changed()

        def pick(key):
            def done(c):
                put(**{key: c})
            self.after(30, lambda: self.palette_popup(None, done, px, py))

        def dot(on):
            return "●  " if on else "     "
        mm.add_command(label="READY STYLES", state="disabled")
        for name, fill, bc, tc in SHAPE_STYLES:
            mm.add_command(label="     " + name, command=lambda f=fill, b=bc, t_=tc: put(color=f, bc=b, tc=t_))
        mm.add_separator()
        mm.add_command(label="     Fill colour…", command=lambda: pick("color"))
        mm.add_command(label="     Line colour…", command=lambda: pick("bc"))
        lm = self._menu(mm)
        for wd in (0, 0.75, 1.5, 3, 5):
            lm.add_command(label=dot(float(spec.get("bw", 1.5)) == wd) + ("No line" if not wd else f"{wd:g} pt"),
                           command=lambda wd=wd: put(bw=wd))
        lm.add_separator()
        for k_, lab in (("", "Solid line"), ("dash", "Dashed line"), ("dot", "Dotted line")):
            lm.add_command(label=dot((spec.get("dash") or "") == k_) + lab, command=lambda k_=k_: put(dash=k_ or None))
        mm.add_cascade(label="     Line", menu=lm)
        sm = self._menu(mm)
        for v_, lab in SHAPE_SEE:
            sm.add_command(label=dot(abs(float(spec.get("op", 1.0)) - v_) < 0.01) + lab, command=lambda v_=v_: put(op=v_))
        mm.add_cascade(label="     See-through", menu=sm)
        gm = self._menu(mm)
        for k_, lab in SHAPE_GRADS.items():
            gm.add_command(label=dot((spec.get("grad") or "") == k_) + lab, command=lambda k_=k_: put(grad=k_ or None))
        gm.add_separator()
        gm.add_command(label="     Second colour…", command=lambda: (spec.setdefault("grad", "v"), pick("color2")))
        if spec.get("color2"):
            gm.add_command(label="     Second colour: automatic", command=lambda: put(color2=None))
        mm.add_cascade(label="     Gradient (two colours)", menu=gm)
        if spec.get("look") == "s_round":
            cm = self._menu(mm)
            for v_, lab in ((6, "Small corners"), (14, "Medium corners"), (26, "Big corners"), (200, "Round ends")):
                cm.add_command(label=dot(float(spec.get("radius", 14) or 14) == v_) + lab,
                               command=lambda v_=v_: put(radius=v_))
            mm.add_cascade(label="     Corners", menu=cm)
        mm.add_separator()
        mm.add_command(label="EFFECTS", state="disabled")
        for k_, lab in (("gloss", "Glossy shine"), ("glow", "Glow"), ("raised", "3D raised"), ("shadow", "Soft shadow")):
            mm.add_command(label=dot(spec.get(k_)) + lab, command=lambda k_=k_: put(**{k_: None if spec.get(k_) else 1}))
        mm.add_command(label="     Plain again (no effects)",
                       command=lambda: put(gloss=None, glow=None, raised=None, shadow=None, grad=None, dash=None, op=1.0))

    def _set_variant(self, key, val):
        self.lib.settings[key] = val
        if key == "stamp":
            self._pending_card = None
        self.set_tool({"shape": "shapes", "stamp": "stamp", "erase": "eraser"}[key])

    def _custom_stamp(self):
        spec = self._card_dialog(dict(self._stamp_spec(), text="Seen", angle=-6), "New stamp", save_option=True)
        if spec:
            self._use_card(spec)

    def _use_card(self, spec):
        """Next click on the page places this stamp / signature / picture."""
        self._pending_card = dict(spec)
        self.set_tool("stamp")
        self.set_status("Click on the page where you want it.")

    def _my_stamp_save(self, spec, name=None):
        mine = self.lib.settings.setdefault("my_stamps", [])
        spec = dict(spec)
        spec["name"] = (name or spec.get("text") or spec.get("name_text") or spec.get("kind", "stamp")).strip()[:40]
        spec.pop("date_text", None)
        mine.append(spec)
        self.lib.save_meta()
        self.lib.settings["stamp"] = f"my:{len(mine) - 1}"
        return len(mine) - 1

    def _my_stamp_delete(self, i):
        mine = self.lib.settings.get("my_stamps", [])
        if 0 <= i < len(mine) and messagebox.askyesno(APP_NAME, f'Delete "{mine[i].get("name", "stamp")}" from '
                                                               f'your stamps?'):
            del mine[i]
            if self.lib.settings.get("stamp", "").startswith("my:"):
                self.lib.settings["stamp"] = "Approved"
            self.lib.save_meta()

    def set_tool(self, t):
        if t == "line":
            self.lib.settings["shape"] = "separator"
            t = "shapes"
        self.tool = t
        self._close_float()
        self.sel = None
        self._refresh_tool_buttons()
        st = self.lib.settings
        shape = dict(SHAPES).get(st.get("shape", "rect")) or \
            (SHAPE_LOOKS.get(str(st.get("shape", ""))[2:], "Shape") + " to write in")
        stamp = st.get("stamp_custom", "Seen") if st.get("stamp") == "custom" else st.get("stamp", "Approved")
        if str(stamp).startswith("sym:"):
            stamp = SYMBOLS.get(str(stamp)[4:], ("Tick",))[0]
        hints = {"select": "Select text to highlight it. Click a mark to select it: drag to move, drag the corner "
                           "to resize, Delete removes it.",
                 "pen": "Pen: draw on the page. Esc to stop.",
                 "edittext": "Edit the text: click a line of the document's own text to change it (same font, size "
                             "and colour). Esc to stop.",
                 "text": "Text box: click where you want to write (or drag to draw the box).",
                 "note": "Sticky note: click where you want it. Drag its corner later to make it bigger or smaller.",
                 "shapes": f"{shape}: " + ("click between two paragraphs." if st.get("shape") == "separator"
                                           else "drag on the page.") + "  Click the button again to change shape.",
                 "stamp": f'Stamp "{stamp}": click where you want it.  Click the button again for other stamps.',
                 "eraser": {"whiteout": "Erase for good: drag over the PDF's text you want gone for ever (private "
                                        "data).",
                            "cover": "White box: drag over the text to hide it. It is a mark: click it later to move "
                                     "or delete it.",
                            "brush": "White brush: paint over the text to hide it. Click the paint later to delete "
                                     "it."}.get(st.get("erase"), "Eraser: click a mark to remove it, or drag over "
                                                                 "several.")}
        self.set_status(hints.get(t, ""))
        self._set_cursor()
        self.canvas.delete("et_hover")
        if hasattr(self, "qbar"):
            self._qbar_draw()
        self.redraw()

    def _set_cursor(self):
        """The page's mouse pointer for the tool in use."""
        st = self.lib.settings
        self.canvas.config(cursor={"pen": "pencil", "text": "xterm", "edittext": "xterm", "note": "plus", "shapes": "crosshair",
                                   "stamp": "plus", "eraser": {"whiteout": "crosshair", "cover": "crosshair",
                                                               "brush": "dotbox"}.get(st.get("erase"), "X_cursor")
                                   }.get(self.tool, ""))

    def _refresh_tool_buttons(self):
        for k, b in getattr(self, "tool_btns", {}).items():
            b.set_active(k == self.tool)

    def set_color(self, c):
        s = self.lib.settings
        s["color"] = c
        rec = [x for x in s.get("recent", []) if x.upper() != c.upper()]
        s["recent"] = ([c] + rec)[:6]
        self.lib.save_meta()
        self._draw_color_btn()

    def palette_popup(self, anchor, callback, x=None, y=None):
