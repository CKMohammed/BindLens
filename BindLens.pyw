        def wheel(e):
            w_ = d.winfo_containing(e.x_root, e.y_root)
            if w_ is not None and str(w_).startswith(str(nav)):
                d_ = getattr(e, "delta", 0)
                step = (-3 if e.num == 4 else 3) if getattr(e, "num", 0) in (4, 5) else \
                    (-int(d_ / 40) if abs(d_) >= 40 else (-1 if d_ > 0 else 1))
                ncv.yview_scroll(step, "units")
                return
            if opts.winfo_height() > sc.winfo_height():
                d_ = getattr(e, "delta", 0)
                if getattr(e, "num", 0) in (4, 5):
                    step = -3 if e.num == 4 else 3
                else:
                    step = -int(d_ / 40) if abs(d_) >= 40 else (-1 if d_ > 0 else 1)
                sc.yview_scroll(step, "units")
        self.wheel_route(d, wheel)
        d.bind("<Prior>", lambda e: sc.yview_scroll(-1, "pages"))
        d.bind("<Next>", lambda e: sc.yview_scroll(1, "pages"))

