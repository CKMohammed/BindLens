            lb = tk.Label(row, text=lab, font=self.F(8), bg=T["chip"], fg=T["text"], padx=6, pady=2, cursor="hand2")
            lb.pack(side="left", padx=(6, 0))
            lb.bind("<Button-1>", lambda e, k=days: dv.set(time.strftime("%d/%m/%Y",
                                                                         time.localtime(time.time() + 86400 * k))))
        tk.Label(body, text="NOTE", font=self.F(8, "bold"), bg=T["panel"], fg=T["muted"]).pack(anchor="w",
                                                                                              pady=(12, 3))
        nv = tk.StringVar()
        en = ttk.Entry(body, textvariable=nv, width=40, font=self.F(10))
        en.pack(anchor="w")
        en.focus_set()
        res = [False]
        err = tk.Label(body, text="", font=self.F(8), bg=T["panel"], fg="#D93025")
        err.pack(anchor="w", pady=(6, 0))

        def ok(_e=None):
            # 3.0: a date BindLens can't read is said here - the window stays open, your note is not lost
