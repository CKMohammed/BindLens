def easter_date(y):
    """Easter Sunday (Gregorian calendar)."""
    import datetime
    a, b, c = y % 19, y // 100, y % 100
    d, e = b // 4, b % 4
    f = (b + 8) // 25
    g = (b - f + 1) // 3
    h = (19 * a + b - d - g + 15) % 30
    i, k = c // 4, c % 4
    l_ = (32 + 2 * e + 2 * i - h - k) % 7
    m = (a + 11 * h + 22 * l_) // 451
    month = (h + l_ - 7 * m + 114) // 31
    day = (h + l_ - 7 * m + 114) % 31 + 1
    return datetime.date(y, month, day)


def irish_holidays(y):
    """The public holidays in Ireland in year y: {date: name}."""
    import datetime
    D, td = datetime.date, datetime.timedelta

    def first_mon(m):
        d = D(y, m, 1)
        return d + td(days=(7 - d.weekday()) % 7)

    def last_mon(m):
        d = D(y, m + 1, 1) - td(days=1)
        return d - td(days=d.weekday())
    out = {D(y, 1, 1): "New Year's Day", D(y, 3, 17): "St Patrick's Day", D(y, 12, 25): "Christmas Day",
           D(y, 12, 26): "St Stephen's Day", easter_date(y) + td(days=1): "Easter Monday",
           first_mon(5): "May bank holiday", first_mon(6): "June bank holiday",
           first_mon(8): "August bank holiday", last_mon(10): "October bank holiday"}
    if y >= 2023:
        b = D(y, 2, 1)
        out[b if b.weekday() == 4 else first_mon(2)] = "St Brigid's Day"
    return out


def parse_ics(text):
    """The events of a calendar file (.ics): [{title, start, last, time, rrule, exdates, where}]."""
    import datetime
    lines = []
    for ln in text.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if ln[:1] in (" ", "\t") and lines:
            lines[-1] += ln[1:]
        else:
            lines.append(ln)

    def unesc(v):
        return (v.replace("\\n", " ").replace("\\N", " ").replace("\\,", ",").replace("\\;", ";")
                .replace("\\\\", "\\").strip())

    def when(head, val):
        params, v = head.upper(), val.strip()
        try:
            if ("VALUE=DATE" in params and "VALUE=DATE-TIME" not in params) or len(v) == 8:
                return datetime.date(int(v[:4]), int(v[4:6]), int(v[6:8])), None
            dt = datetime.datetime(int(v[:4]), int(v[4:6]), int(v[6:8]), int(v[9:11]), int(v[11:13]))
            if v.endswith("Z"):
                dt = dt.replace(tzinfo=datetime.timezone.utc).astimezone().replace(tzinfo=None)
            return dt.date(), dt.strftime("%H:%M")
        except Exception:
            return None, None
    evs, cur = [], None
    for ln in lines:
        if ":" not in ln:
            continue
        head, _, val = ln.partition(":")
        name = head.split(";")[0].strip().upper()
        if name == "BEGIN" and val.strip().upper() == "VEVENT":
            cur = {"title": "", "exdates": []}
        elif name == "END" and val.strip().upper() == "VEVENT":
            if cur and cur.get("start"):
                evs.append(cur)
            cur = None
        elif cur is not None:
            if name == "SUMMARY":
                cur["title"] = unesc(val)
            elif name == "DTSTART":
                cur["start"], cur["time"] = when(head, val)
            elif name == "DTEND":
                cur["end"], cur["end_time"] = when(head, val)
            elif name == "RRULE":
                cur["rrule"] = {k.strip().upper(): v.strip() for k, _, v in
                                (p_.partition("=") for p_ in val.strip().split(";")) if k.strip()}
            elif name == "EXDATE":
                for v in val.split(","):
                    d, _t = when(head, v)
                    if d:
                        cur["exdates"].append(d)
            elif name == "LOCATION":
                cur["where"] = unesc(val)
    for e in evs:
        end = e.pop("end", None)
        if end and e.get("time") is None and end > e["start"]:
            end = end - datetime.timedelta(days=1)            # all-day events end the day before DTEND
        if not end or end < e["start"]:
            end = e["start"]
        e["last"] = end
    return evs


def ics_days(ev, d0, d1):
    """The days (d0…d1) an event is on - with its repeats (daily, weekly + week days, monthly, yearly)."""
    import datetime
    td = datetime.timedelta
    s = ev["start"]
    span = min(31, max(0, ((ev.get("last") or s) - s).days))
    rr = ev.get("rrule")
    starts = []
    if not rr:
        starts = [s]
    else:
        freq = rr.get("FREQ", "").upper()
        try:
            iv = max(1, int(rr.get("INTERVAL", "1")))
        except ValueError:
            iv = 1
        until = None
        if rr.get("UNTIL"):
            u = rr["UNTIL"]
            try:
                until = datetime.date(int(u[:4]), int(u[4:6]), int(u[6:8]))
            except ValueError:
                until = None
        try:
            count = int(rr["COUNT"]) if rr.get("COUNT") else None
        except ValueError:
            count = None
        wd_of = {"MO": 0, "TU": 1, "WE": 2, "TH": 3, "FR": 4, "SA": 5, "SU": 6}
        byday = sorted({wd_of[x.strip()[-2:].upper()] for x in rr.get("BYDAY", "").split(",")
                        if x.strip()[-2:].upper() in wd_of})
        end = min(d1, until) if until else d1
        i = 0
        if count is None:                                      # jump near the window (old repeating events)
            if freq == "DAILY":
                i = max(0, (d0 - s).days // iv - span - 1)
            elif freq == "WEEKLY":
                i = max(0, (d0 - s).days // (7 * iv) - 1)
            elif freq == "MONTHLY":
                i = max(0, ((d0.year - s.year) * 12 + d0.month - s.month) // iv - 2)
            elif freq == "YEARLY":
                i = max(0, (d0.year - s.year) // iv - 1)
        n = 0
        for _k in range(3000):
            if freq == "DAILY":
                cands = [s + td(days=i * iv)]
            elif freq == "WEEKLY":
                w0 = s - td(days=s.weekday()) + td(weeks=i * iv)
                cands = [w0 + td(days=wd) for wd in byday] if byday else [s + td(weeks=i * iv)]
            elif freq == "MONTHLY":
                mm = s.month - 1 + i * iv
                try:
                    cands = [s.replace(year=s.year + mm // 12, month=mm % 12 + 1)]
                except ValueError:
                    cands = []
            elif freq == "YEARLY":
                try:
                    cands = [s.replace(year=s.year + i * iv)]
                except ValueError:
                    cands = []
            else:
                cands = [s]
            i += 1
            stop = False
            for d in cands:
                if d < s:
                    continue
                if d > end:
                    stop = True
                    break
                n += 1
                if count is not None and n > count:
                    stop = True
                    break
                starts.append(d)
            if stop or freq not in ("DAILY", "WEEKLY", "MONTHLY", "YEARLY"):
                break
            if cands and min(cands) > end:
                break
    ex = set(ev.get("exdates") or [])
    out = []
    for d in starts:
        if d in ex or d + td(days=span) < d0 or d > d1:
            continue
        for k in range(span + 1):
            dd = d + td(days=k)
            if d0 <= dd <= d1:
                out.append(dd)
    return out


def words_time(h, m):
    """The time in words: 'quarter past ten'."""
    names = ["twelve", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven"]
    m5 = int(round(m / 5.0)) * 5
    if m5 == 60:
        m5, h = 0, h + 1
    hour, nxt = names[h % 12], names[(h + 1) % 12]
    return {0: f"{hour} o'clock", 5: f"five past {hour}", 10: f"ten past {hour}", 15: f"quarter past {hour}",
            20: f"twenty past {hour}", 25: f"twenty-five past {hour}", 30: f"half past {hour}",
            35: f"twenty-five to {nxt}", 40: f"twenty to {nxt}", 45: f"quarter to {nxt}", 50: f"ten to {nxt}",
            55: f"five to {nxt}"}[m5]


class SlimBar(tk.Canvas):
    """3.2: a slim scroll bar with ▲ and ▼ (click or hold them) and a pill you can drag - for the library list
    and the column of books. It hides itself when everything fits."""

    def __init__(self, parent, app, target, width=14, arrows=True):
        super().__init__(parent, width=width, highlightthickness=0, bd=0, cursor="hand2")
        self.app, self.target, self.W, self.arrows = app, target, width, arrows
        self.first, self.last = 0.0, 1.0
        self._job, self._drag, self._hov = None, None, None
        self.bind("<Configure>", lambda e: self.draw())
        self.bind("<ButtonPress-1>", self._press)
        self.bind("<B1-Motion>", self._motion)
        self.bind("<ButtonRelease-1>", self._release)
        self.bind("<Motion>", self._hover)
        self.bind("<Leave>", lambda e: (setattr(self, "_hov", None), self._release(), self.draw()))
        self.bind("<MouseWheel>", lambda e: self.target.yview_scroll(-1 if e.delta > 0 else 1, "units"))
        self.bind("<Button-4>", lambda e: self.target.yview_scroll(-1, "units"))
        self.bind("<Button-5>", lambda e: self.target.yview_scroll(1, "units"))

    def set(self, first, last):
        self.first, self.last = float(first), float(last)
        self.draw()

    def needed(self):
        return self.last - self.first < 0.999

    def redraw(self):
        self.draw()

    def _geo(self):
        h = max(1, self.winfo_height())
        a = self.W + 2 if self.arrows else 2
        return a, h - a

    def draw(self):
        self.delete("all")
        T, A = self.app.T, self.app.accent
        try:
            bg = self.master.cget("bg")
        except Exception:
            bg = T["panel"]
        self.configure(bg=bg)
        if not self.needed():
            return
        w, h = self.W, max(1, self.winfo_height())
        t0, t1 = self._geo()
        x = w / 2
        self.create_line(x, t0 + 2, x, t1 - 2, fill=mix(bg, T["border"], 1.0), width=6, capstyle="round")
        y0 = t0 + (t1 - t0) * self.first
        y1 = t0 + (t1 - t0) * self.last
        if y1 - y0 < 16:
            y0, y1 = max(t0, (y0 + y1) / 2 - 8), min(t1, (y0 + y1) / 2 + 8)
        on = self._hov == "pill" or self._drag is not None
        self.create_line(x, y0 + 3, x, y1 - 3, fill=A if on else mix(bg, A, 0.75), width=w - 4 if on else w - 6,
                         capstyle="round")
        if self.arrows:
            for key, yc, up in (("up", w / 2 + 1, True), ("down", h - w / 2 - 1, False)):
                ok = self.first > 0.001 if up else self.last < 0.999
                hv = ok and self._hov == key
                if hv:
                    self.create_oval(1, yc - w / 2 + 1, w - 1, yc + w / 2 - 1, fill=mix(bg, A, 0.25), outline="")
                ink = A if ok else mix(bg, T["muted"], 0.45)
                d = w * 0.28
                pts = (x - d, yc + d * 0.5, x, yc - d * 0.5, x + d, yc + d * 0.5) if up else \
                    (x - d, yc - d * 0.5, x, yc + d * 0.5, x + d, yc - d * 0.5)
                self.create_line(*pts, fill=ink, width=2, capstyle="round", joinstyle="round")

    def _part(self, y):
        t0, t1 = self._geo()
        if self.arrows and y < t0:
            return "up"
        if self.arrows and y > t1:
            return "down"
        y0 = t0 + (t1 - t0) * self.first
        y1 = t0 + (t1 - t0) * self.last
        return "pill" if y0 - 3 <= y <= y1 + 3 else "track"

    def _hover(self, e):
        p = self._part(e.y) if self.needed() else None
        if p != self._hov:
            self._hov = p
            self.draw()

    def _step(self, n):
        try:
            self.target.yview_scroll(n, "units")
        except Exception:
            pass

    def _press(self, e):
        if not self.needed():
            return
        p = self._part(e.y)
        if p in ("up", "down"):
            d = -1 if p == "up" else 1
            self._step(d)
            k = [0]

            def again():                                     # held down: keep going, faster after a moment
                k[0] += 1
                self._step(d * (1 if k[0] < 8 else 3))
                self._job = self.after(80, again)
            self._job = self.after(380, again)
        elif p == "pill":
            self._drag = (e.y, self.first)
        else:                                                # the track: jump there
            t0, t1 = self._geo()
            span = self.last - self.first
            frac = (e.y - t0) / max(1.0, t1 - t0) - span / 2
            self.target.yview_moveto(max(0.0, min(1.0 - span, frac)))
            self._drag = (e.y, max(0.0, min(1.0 - span, frac)))

    def _motion(self, e):
        if self._drag is None:
            return
        t0, t1 = self._geo()
        y_, f0 = self._drag
        span = self.last - self.first
        self.target.yview_moveto(max(0.0, min(1.0 - span, f0 + (e.y - y_) / max(1.0, t1 - t0))))

    def _release(self, _e=None):
        if self._job:
            self.after_cancel(self._job)
        self._job = None
        if self._drag is not None:
            self._drag = None
            self.draw()


class KeepMenu(tk.Menu):
    """3.0: a menu that keeps its tick variables alive - with plain menus they were thrown away at once, so a
    tick never showed which choice was on."""

    def add(self, itemType, cnf={}, **kw):
        v = (cnf or {}).get("variable") if isinstance(cnf, dict) else None
        v = v or kw.get("variable")
        if v is not None and not isinstance(v, str):
            self.__dict__.setdefault("_keep_vars", []).append(v)
        return super().add(itemType, cnf, **kw)


def released_in(w, e):
    """3.0: a button acts only when the mouse is let go ON it (drag away to change your mind)."""
    try:
        return 0 <= e.x < w.winfo_width() and 0 <= e.y < w.winfo_height()
    except Exception:
        return True


class Tooltip:
    def __init__(self, app):
        self.app = app
        self.win = None
        self.job = None

    def schedule(self, widget, text):
        self.cancel()
        # scheduled (and cancelled) on the main window - never on the widget, which may be destroyed
        self.job = self.app.root.after(450, lambda: self._fire(widget, text))

    def _fire(self, widget, text):
        self.job = None
        try:
            if widget.winfo_exists() and widget.winfo_ismapped():
                self.show(widget, text)
        except Exception:
            pass

    def show(self, widget, text):
        T = self.app.T
        self.hide()
        w = tk.Toplevel(widget)
        w.wm_overrideredirect(True)
        try:
            w.attributes("-topmost", True)
        except Exception:
            pass
        lb = tk.Label(w, text=text, bg=T["tip_bg"], fg=T["tip_fg"], font=self.app.F(9), padx=9, pady=4,
                      justify="left", wraplength=420)
        lb.pack()
        w.update_idletasks()
        tw, th = w.winfo_reqwidth(), w.winfo_reqheight()
        x = widget.winfo_rootx() + widget.winfo_width() // 2 - tw // 2
        y = widget.winfo_rooty() + widget.winfo_height() + 6
        # 3.0: always on the screen (the tips of the right-hand and bottom buttons went off it)
        sw, sh = widget.winfo_screenwidth(), widget.winfo_screenheight()
        x = max(4, min(x, sw - tw - 4))
        if y + th > sh - 40:
            y = widget.winfo_rooty() - th - 6
        w.geometry(f"+{x}+{max(0, y)}")
        self.win = w

    def cancel(self):
        if self.job:
            try:
                self.job and self.app.root.after_cancel(self.job)
            except Exception:
                pass
            self.job = None
        self.hide()

    def hide(self):
        if self.win is not None:
            try:
                self.win.destroy()
            except Exception:
                pass
            self.win = None


class IconButton(tk.Canvas):
    """Round-cornered icon button with hover, active state and tooltip."""

    def __init__(self, parent, app, icon, command, tip="", size=34, bg_key="bg"):
