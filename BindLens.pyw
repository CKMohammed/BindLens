HEIC_HELP = ("This is an iPhone photo (HEIC). To read it, install the free “HEIF Image Extensions” from the Microsoft "
             "Store - or on the iPhone: Settings > Camera > Formats > Most Compatible (then photos come as JPG).")


def heic_to_jpg(path):
    """4.1: an iPhone photo (.heic / .heif) as a JPG BindLens can read - with Windows' own picture reader (the free
    HEIF extension), a Mac's 'sips', or 'heif-convert'. Raises with what to do when it can't."""
    out_dir = os.path.join(data_dir(), "scans")
    os.makedirs(out_dir, exist_ok=True)
    out = unique_path(out_dir, os.path.splitext(os.path.basename(path))[0] + ".jpg")
    try:
        if os.name == "nt":
            enc = base64.b64encode(_PS_HEIC.encode("utf-16-le")).decode()
            p = subprocess.run(["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-STA", "-EncodedCommand",
                                enc], capture_output=True, text=True, timeout=120, creationflags=0x08000000,
                               env=dict(os.environ, BL_IN=path, BL_OUT=out))
            res = ((p.stdout or "").strip().splitlines() or [""])[-1]
            if res != "OK":
                raise RuntimeError(res[4:] if res.startswith("ERR") else "no answer")
        elif sys.platform == "darwin":
            subprocess.run(["sips", "-s", "format", "jpeg", path, "--out", out], capture_output=True, timeout=120)
        else:
            subprocess.run(["heif-convert", path, out], capture_output=True, timeout=120)
    except Exception as ex:
        raise RuntimeError(f"{HEIC_HELP}\n({os.path.basename(path)}: {ex})")
    if not os.path.isfile(out) or os.path.getsize(out) < 100:
        raise RuntimeError(f"{HEIC_HELP}\n({os.path.basename(path)})")
    return out


def _square_to_quad(q):
    """The projective map (u, v) in 0..1 -> the quadrilateral q = [top-left, top-right, bottom-right, bottom-left]."""
    (x0, y0), (x1, y1), (x2, y2), (x3, y3) = q
    dx1, dx2, dx3 = x1 - x2, x3 - x2, x0 - x1 + x2 - x3
    dy1, dy2, dy3 = y1 - y2, y3 - y2, y0 - y1 + y2 - y3
    if abs(dx3) < 1e-9 and abs(dy3) < 1e-9:
        g = h = 0.0
        a, b, c, d, e, f = x1 - x0, x3 - x0, x0, y1 - y0, y3 - y0, y0
    else:
        den = dx1 * dy2 - dx2 * dy1
        g = (dx3 * dy2 - dx2 * dy3) / den
        h = (dx1 * dy3 - dx3 * dy1) / den
        a, b, c = x1 - x0 + g * x1, x3 - x0 + h * x3, x0
        d, e, f = y1 - y0 + g * y1, y3 - y0 + h * y3, y0

    def m(u, v):
        w = g * u + h * v + 1.0
        return (a * u + b * v + c) / w, (d * u + e * v + f) / w
    return m


def _affine3(src, dst):
    """The affine map taking 3 points src to dst: (A00, A01, A02, A10, A11, A12)."""
    (sx0, sy0), (sx1, sy1), (sx2, sy2) = src
    (dx0, dy0), (dx1, dy1), (dx2, dy2) = dst
    det = (sx1 - sx0) * (sy2 - sy0) - (sx2 - sx0) * (sy1 - sy0)
    if abs(det) < 1e-12:
        return None
    a00 = ((dx1 - dx0) * (sy2 - sy0) - (dx2 - dx0) * (sy1 - sy0)) / det
    a01 = ((dx2 - dx0) * (sx1 - sx0) - (dx1 - dx0) * (sx2 - sx0)) / det
    a10 = ((dy1 - dy0) * (sy2 - sy0) - (dy2 - dy0) * (sy1 - sy0)) / det
    a11 = ((dy2 - dy0) * (sx1 - sx0) - (dy1 - dy0) * (sx2 - sx0)) / det
    return a00, a01, dx0 - a00 * sx0 - a01 * sy0, a10, a11, dy0 - a10 * sx0 - a11 * sy0


def flatten_quad(fitz, jpg, W, H, quad, ow, oh, n=6):
    """4.1: a page photographed at an angle, made flat: the four corners of the paper (quad, in the photo) are
    pulled out to a rectangle ow x oh. Drawn by MuPDF itself as many small triangles (each a simple stretch of
    the photo), so it takes a moment, not minutes."""
    proj = _square_to_quad(quad)
    doc = fitz.open()
    page = doc.new_page(width=ow, height=oh)
    page.insert_image(fitz.Rect(0, 0, 1, 1), stream=jpg)
    name = page.get_images(full=True)[0][7]
    out = []
    for i in range(n):
        for j in range(n):
            u0, u1, v0, v1 = i / n, (i + 1) / n, j / n, (j + 1) / n
            D = [(u0 * ow, v0 * oh), (u1 * ow, v0 * oh), (u1 * ow, v1 * oh), (u0 * ow, v1 * oh)]
            S = [proj(u0, v0), proj(u1, v0), proj(u1, v1), proj(u0, v1)]
            for tri in ((0, 1, 2), (0, 2, 3)):
                d3 = [D[t] for t in tri]
                A_ = _affine3([S[t] for t in tri], d3)
                if A_ is None:
                    continue
                a00, a01, a02, a10, a11, a12 = A_
                a, b = a00 * W, -a10 * W
                c, d = -a01 * H, a11 * H
                e, f = a01 * H + a02, oh - a11 * H - a12
                cx = sum(p[0] for p in d3) / 3
                cy = sum(p[1] for p in d3) / 3
                pts = [(cx + (p[0] - cx) * 1.04, cy + (p[1] - cy) * 1.04) for p in d3]   # a hair over: no seams
                clip = " ".join(f"{x:.2f} {oh - y:.2f} {op}" for (x, y), op in zip(pts, ("m", "l", "l")))
                out.append(f"q {clip} h W n {a:.4f} {b:.4f} {c:.4f} {d:.4f} {e:.3f} {f:.3f} cm /{name} Do Q")
    xrefs = page.get_contents()
    doc.update_stream(xrefs[0], ("\n".join(out)).encode())
    for x in xrefs[1:]:
        doc.update_stream(x, b"")
    pix = page.get_pixmap(alpha=False)
    try:
        res = pix.tobytes("jpg", jpg_quality=85)
    except TypeError:
        res = pix.tobytes("jpg")
    doc.close()
    return res


def paper_corners(sm, sw, sh, th, box):
    """The four corners of the paper (bright) in the small picture: top-left, top-right, bottom-right, bottom-left -
    or None. 4.1: the paper is followed from the middle of box as one bright piece (flood fill), so a corner that
    sticks out of box (a page photographed at an angle is wider at the bottom) is still found, and a light patch on
    the desk is not taken for paper."""
    x0, y0, x1, y1 = box
    cx, cy = (x0 + x1) // 2, (y0 + y1) // 2
    start = None
    for r in range(0, max(sw, sh) // 4):
        for x, y in ((cx + r, cy), (cx - r, cy), (cx, cy + r), (cx, cy - r)):
            if 0 <= x < sw and 0 <= y < sh and sm[y * sw + x] > th:
                start = (x, y)
                break
        if start:
            break
    if not start:
        return None
    seen = bytearray(sw * sh)
    seen[start[1] * sw + start[0]] = 1
    stack = [start]
    best = {"tl": None, "tr": None, "br": None, "bl": None}
    n = 0
    while stack:
        x, y = stack.pop()
        n += 1
        for k, val in (("tl", -(x + y)), ("br", x + y), ("tr", x - y), ("bl", y - x)):
            if best[k] is None or val > best[k][0]:
                best[k] = (val, x, y)
        for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
            if 0 <= nx < sw and 0 <= ny < sh:
                i = ny * sw + nx
                if not seen[i] and sm[i] > th:
                    seen[i] = 1
                    stack.append((nx, ny))
    if n < sw * sh * 0.1 or any(v is None for v in best.values()):
        return None
    return [(best[k][1], best[k][2]) for k in ("tl", "tr", "br", "bl")]


def scan_page_image(fitz, path, crop=True, straighten=True, clean=True, color=False, max_side=2200):
    """A photo or scan of a page made ready for a book: the paper found and cut out (when it lies on something
    darker), turned straight, white paper made white and the writing dark. Returns (jpeg bytes, w, h, angle) -
    the angle (degrees) still to turn it and the part to keep (the paper) - both used when it is put on the page."""
    import math
    src = fitz.open(path)                                   # an image opened as a document: turned the right way up
    try:
        pg = src[0]
        r = pg.rect
        z = min(4.0, max_side / max(1.0, max(r.width, r.height)))
        pix = pg.get_pixmap(matrix=fitz.Matrix(z, z), alpha=False)
    finally:
        src.close()
    if pix.n != 3:
        pix = fitz.Pixmap(fitz.csRGB, pix)
    W, H = pix.width, pix.height
    gray = fitz.Pixmap(fitz.csGRAY, pix)
    # a small copy to look at
    k = max(1, int(max(W, H) / 360))
    sw, sh = max(1, W // k), max(1, H // k)
    small = fitz.Pixmap(gray, sw, sh, None)
    sw, sh = small.width, small.height
    sm = small.samples
    hist = [0] * 256
    for v in sm:
        hist[v] += 1
    tot = float(len(sm)) or 1.0
    # Otsu: paper (bright) and the rest
    sum_all = sum(i * hist[i] for i in range(256))
    wb = sb = 0.0
    best, th = -1.0, 128
    for t in range(256):
        wb += hist[t]
        if wb == 0:
            continue
        wf = tot - wb
        if wf == 0:
            break
        sb += t * hist[t]
        mb, mf = sb / wb, (sum_all - sb) / wf
        between = wb * wf * (mb - mf) ** 2
        if between > best:
            best, th = between, t
    box = (0, 0, W, H)
    masks = []
    quad = None
    if crop:
        rows = [sum(1 for x in range(sw) if sm[y * sw + x] > th) / sw for y in range(sh)]
        cols = [sum(1 for y in range(sh) if sm[y * sw + x] > th) / sh for x in range(sw)]

        def run(fr):
            best_, cur = (0, len(fr)), None
            bl = -1
            # 4.1: relative to the widest part of the paper - a page photographed at an angle is narrower at the
            # top than at the bottom (it was cut in half when every row had to be 45% paper)
            lim = max(0.12, 0.45 * max(fr or [0]))
            for i_, f_ in enumerate(fr + [0]):
                if f_ > lim:
                    cur = i_ if cur is None else cur
                else:
                    if cur is not None and i_ - cur > bl:
                        best_, bl = (cur, i_), i_ - cur
                    cur = None
            return best_
        y0, y1 = run(rows)
        x0, x1 = run(cols)
        area = (x1 - x0) * (y1 - y0) / float(sw * sh)
        if 0.22 < area < 0.93 and (x1 - x0) > sw * 0.3 and (y1 - y0) > sh * 0.3:
            ix, iy = (x1 - x0) * 0.012, (y1 - y0) * 0.012
            box = (int((x0 + ix) * W / sw), int((y0 + iy) * H / sh), int((x1 - ix) * W / sw), int((y1 - iy) * H / sh))
            # 4.1: a page photographed at an angle (a trapezium, not a rectangle): its four corners, to flatten it
            cq = paper_corners(sm, sw, sh, th, (max(0, x0 - 3), max(0, y0 - 3), min(sw, x1 + 3), min(sh, y1 + 3)))
            if cq:
                def ang(p, q_, r_):
                    v1, v2 = (p[0] - q_[0], p[1] - q_[1]), (r_[0] - q_[0], r_[1] - q_[1])
                    n1, n2 = math.hypot(*v1), math.hypot(*v2)
                    if not n1 or not n2:
                        return 90.0
                    return math.degrees(math.acos(max(-1, min(1, (v1[0] * v2[0] + v1[1] * v2[1]) / (n1 * n2)))))
                angs = [ang(cq[(i_ - 1) % 4], cq[i_], cq[(i_ + 1) % 4]) for i_ in range(4)]
                L_ = [math.hypot(cq[(i_ + 1) % 4][0] - cq[i_][0], cq[(i_ + 1) % 4][1] - cq[i_][1]) for i_ in range(4)]
                skew = max(abs(a_ - 90) for a_ in angs)
                ratio = min(L_[0], L_[2]) / max(1e-6, max(L_[0], L_[2]))
                ratio2 = min(L_[1], L_[3]) / max(1e-6, max(L_[1], L_[3]))
                parallel = abs(math.degrees(math.atan2(cq[1][1] - cq[0][1], cq[1][0] - cq[0][0])) -
                               math.degrees(math.atan2(cq[2][1] - cq[3][1], cq[2][0] - cq[3][0])))
                if (skew > 3.0 or min(ratio, ratio2) < 0.96) and 20 < skew + 20 < 60 and min(ratio, ratio2) > 0.55 and \
                        parallel < 25:
                    quad = [(px_ * W / sw, py_ * H / sh) for px_, py_ in cq]
                    qx_, qy_ = sum(q_[0] for q_ in quad) / 4, sum(q_[1] for q_ in quad) / 4
                    quad = [(qx_ + (x_ - qx_) * 0.985, qy_ + (y_ - qy_) * 0.985) for x_, y_ in quad]   # no desk edge
            # what is not paper (the desk round a page that lies a little crooked) becomes white
            for y in range(max(0, y0 - 2), min(sh, y1 + 2)):
                o = y * sw
                xa = next((x for x in range(sw) if sm[o + x] > th), None)
                if xa is None:
                    masks.append((y * H / sh, (y + 1) * H / sh, 0, W))
                    continue
                xb = next(x for x in range(sw - 1, -1, -1) if sm[o + x] > th)
                if xa > 0:
                    masks.append((y * H / sh, (y + 1) * H / sh, 0, (xa + 1) * W / sw))
                if xb < sw - 1:
                    masks.append((y * H / sh, (y + 1) * H / sh, xb * W / sw, W))
    if box != (0, 0, W, H):
        # 4.1: the levels come from the paper only - with the desk in the count, light writing turned white
        bx0, by0, bx1, by1 = [int(v * sw / W) if i % 2 == 0 else int(v * sh / H) for i, v in enumerate(box)]
        hist2 = [0] * 256
        for y in range(max(0, by0), min(sh, by1)):
            o = y * sw
            for v in sm[o + max(0, bx0):o + min(sw, bx1)]:
                hist2[v] += 1
        if sum(hist2) > 200:
            hist, tot = hist2, float(sum(hist2))
    angle = 0.0
    if straighten and quad is None:
        bx0, by0, bx1, by1 = [int(v * sw / W) if i % 2 == 0 else int(v * sh / H) for i, v in enumerate(box)]
        pts = []
        # 4.1: 'dark' is measured on the paper itself - small print in a photo is only a little darker than the
        # paper in the small copy (a fixed level found nothing and the page stayed crooked); the desk is left out
        inbox = sorted(sm[y * sw + x] for y in range(max(0, by0), min(sh, by1), 3)
                       for x in range(max(0, bx0), min(sw, bx1), 3))
        if inbox:
            paper_v = inbox[len(inbox) // 2]
            p1 = inbox[len(inbox) // 100]
            dark = max(min(th, 150) - 25, paper_v - max(18, (paper_v - p1) * 0.4))
        else:
            dark = min(th, 150) - 25
        floor_ = th * 0.5 if box != (0, 0, W, H) else -1
        step = 1 if (bx1 - bx0) * (by1 - by0) < 90000 else 2
        for y in range(by0, by1, step):
            o = y * sw
            for x in range(bx0, bx1, step):
                if floor_ < sm[o + x] < dark:
                    pts.append((x, y))
        if len(pts) > 60:
            if len(pts) > 12000:
                pts = pts[::len(pts) // 12000 + 1]
            def score(deg):
                a = math.radians(deg)
                ca, sa = math.cos(a), math.sin(a)
                hb = {}
                for x, y in pts:
                    b_ = int(y * ca - x * sa)
                    hb[b_] = hb.get(b_, 0) + 1
                return sum(v * v for v in hb.values())
            sc = {a10 / 10.0: score(a10 / 10.0) for a10 in range(-60, 61, 5)}
            best_a = max(sc, key=sc.get)
            for a100 in range(int(best_a * 10) - 4, int(best_a * 10) + 5):     # 4.1: then to a tenth of a degree
                d_ = a100 / 10.0
                if d_ not in sc:
                    sc[d_] = score(d_)
            best_a = max(sc, key=sc.get)
            # turned only when it is clearly better than leaving it (a straight scan was turned half a degree)
            if abs(best_a) >= 0.3 and sc[best_a] > sc[0.0] * 1.04:
                angle = best_a
    out = pix if color or not clean else fitz.Pixmap(fitz.csGRAY, pix)
    if clean:
        # levels: the paper -> white, the writing -> dark (a table of 256 values, applied in one go)
        lo_n, hi_n, c_ = tot * 0.02, tot * 0.45, 0
        lo = hi = None
        for i in range(256):
            c_ += hist[i]
            if lo is None and c_ >= lo_n:
                lo = i
            if hi is None and c_ >= tot - hi_n:
                hi = i
        lo = lo or 0
        hi = max(hi or 255, lo + 40)
        hi = min(255, int(hi + (255 - hi) * 0.2))
        lut = bytes(max(0, min(255, int(255 * (((v - lo) / float(hi - lo)) ** 1.25) if v > lo else 0)))
                    for v in range(256))
        data = bytes(out.samples).translate(lut)
        out = fitz.Pixmap(out.colorspace, out.width, out.height, data, 0)
    try:
        jpg = out.tobytes("jpg", jpg_quality=82)
    except TypeError:
        jpg = out.tobytes("jpg")
    except Exception:
        jpg = out.tobytes("png")
    if quad is not None:
        try:
            (tl, tr, br, bl) = quad
            ow = (math.hypot(tr[0] - tl[0], tr[1] - tl[1]) + math.hypot(br[0] - bl[0], br[1] - bl[1])) / 2
            oh = (math.hypot(bl[0] - tl[0], bl[1] - tl[1]) + math.hypot(br[0] - tr[0], br[1] - tr[1])) / 2
            if abs(oh / max(1, ow) - 842 / 595.0) < 0.12:          # about A4: exactly A4
                oh = ow * 842 / 595.0
            k_ = min(1.0, 1800 / max(ow, oh))
            ow, oh = int(ow * k_), int(oh * k_)
            flat = flatten_quad(fitz, jpg, out.width, out.height, quad, ow, oh)
            return flat, ow, oh, 0.0, (0, 0, ow, oh), []
        except Exception as ex:
            _log(f"scan flatten: {ex}")
    return jpg, out.width, out.height, angle, box, masks


def scans_to_pdf(fitz, paths, out_path, crop=True, straighten=True, clean=True, color=False, progress=None):
    """Several photos / scans -> one PDF, a page each (A4 when it is about A4)."""
    import math
    doc = fitz.open()
    for i, p in enumerate(paths):
        if progress:
            progress(i, len(paths))
        if p.lower().endswith((".heic", ".heif")):          # 4.1: iPhone photos
            p = heic_to_jpg(p)
        jpg, w, h, angle, box, masks = scan_page_image(fitz, p, crop, straighten, clean, color)
        tmp = fitz.open()
        tp = tmp.new_page(width=w, height=h)
        tp.insert_image(tp.rect, stream=jpg)
        if masks:
            sh_ = tp.new_shape()
            for y0, y1, x0, x1 in masks:
                sh_.draw_rect(fitz.Rect(x0, y0 - 0.5, x1, y1 + 0.5))
            sh_.finish(color=None, fill=(1, 1, 1))
            sh_.commit()
        clip = fitz.Rect(*box)
        if angle and masks:
            # 4.1: a crooked photo: its straight page lies inside the box less the corners the turn brings in
            k_ = abs(math.sin(math.radians(angle))) * 0.55
            clip = fitz.Rect(clip.x0 + clip.height * k_, clip.y0 + clip.width * k_, clip.x1 - clip.height * k_,
                             clip.y1 - clip.width * k_)
        aspect = clip.height / float(max(1, clip.width))
        if abs(aspect - 842 / 595.0) < 0.12:
            pw, ph = 595, 842
        elif abs(aspect - 595 / 842.0) < 0.1:
            pw, ph = 842, 595
        else:
            pw, ph = 595, 595 * aspect
        page = doc.new_page(width=pw, height=ph)
        try:
            page.show_pdf_page(page.rect, tmp, 0, clip=clip, rotate=angle)
        except Exception:
            page.show_pdf_page(page.rect, tmp, 0, clip=clip)
        if angle or masks:
            # 4.1: a photo turned straight leaves thin slivers of the desk at its edges - a white margin hides them
            m_ = 0.012 * min(pw, ph)
            sh_ = page.new_shape()
            for r_ in (fitz.Rect(0, 0, pw, m_), fitz.Rect(0, ph - m_, pw, ph), fitz.Rect(0, 0, m_, ph),
                       fitz.Rect(pw - m_, 0, pw, ph)):
                sh_.draw_rect(r_)
            sh_.finish(color=None, fill=(1, 1, 1))
            sh_.commit()
        tmp.close()
    doc.save(out_path, garbage=3, deflate=True)
    n = doc.page_count
    doc.close()
    return n


# ---- study cards: shown again just before they would be forgotten ----------------------------------------------------
def card_next(state, answer, today=None):
    """state {ivl, ease, n} + answer 1 Again · 2 Hard · 3 Good · 4 Easy -> (new state, days until next time)."""
    import datetime
    today = today or datetime.date.today()
    ivl, ease, n = float(state.get("ivl", 0)), float(state.get("ease", 2.5)), int(state.get("n", 0))
    if answer == 1:
        ivl, ease, n = 0, max(1.3, ease - 0.2), 0
    elif answer == 2:
        ivl, ease = max(1.0, ivl * 1.2), max(1.3, ease - 0.15)
        n += 1
    elif answer == 3:
        ivl = 1 if n == 0 else (3 if n == 1 else ivl * ease)
        n += 1
    else:
        ivl = 4 if n == 0 else ivl * ease * 1.3
        ease += 0.15
        n += 1
    days = int(round(ivl))
    return {"ivl": round(ivl, 2), "ease": round(ease, 2), "n": n,
            "due": (today + datetime.timedelta(days=days)).isoformat()}, days


COLOUR_NAMES = [("Yellow", "#FFD400"), ("Green", "#4CAF50"), ("Blue", "#2F80ED"), ("Pink", "#E8467C"),
                ("Orange", "#F28C28"), ("Red", "#D93025"), ("Purple", "#8E5CE6"), ("Grey", "#9AA0A6")]


def colour_name(hexcol):
    try:
        r, g, b = [int(hexcol[i:i + 2], 16) for i in (1, 3, 5)]
    except Exception:
        return "Other"
    best, bd = "Other", 1e9
    for nm, c in COLOUR_NAMES:
        r2, g2, b2 = [int(c[i:i + 2], 16) for i in (1, 3, 5)]
        d = (r - r2) ** 2 * 0.3 + (g - g2) ** 2 * 0.59 + (b - b2) ** 2 * 0.11
        if d < bd:
            best, bd = nm, d
    return best


# ---- PIN --------------------------------------------------------------------------------------------------------------
def pin_file():
    return os.path.join(data_dir(), "pin.json")


def pin_hash(pin, salt_hex):
    import hashlib
    return hashlib.pbkdf2_hmac("sha256", str(pin).encode("utf-8"), bytes.fromhex(salt_hex), 200000).hex()


def pin_load():
    try:
        with open(pin_file(), encoding="utf-8") as fh:
            d = json.load(fh)
        return d if d.get("hash") and d.get("salt") else None
    except Exception:
        return None


def pin_save(d):
    p = pin_file()
    if d is None:
        try:
            os.remove(p)
        except OSError:
            pass
        return
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p + ".tmp", "w", encoding="utf-8") as fh:
        json.dump(d, fh)
    os.replace(p + ".tmp", p)


class OwnBar:
    """4.3 - Windows: BindLens's own title bar, so the frame starts at the very top of the window (the band at the
    top holds the menus, the document and minimise / maximise / close). The way it is done was first tried on the
    user's PC with a small test window ('BindLens title bar test', it worked): the window has no Windows caption
    (overrideredirect) but keeps its taskbar button and Alt+Tab (WS_EX_APPWINDOW, WS_SYSMENU, WS_MINIMIZEBOX);
    BindLens moves it (drag the top band), resizes it (the frame's edges and corners), maximises it to the screen's
    work area (the taskbar stays visible), snaps it (drag to the top or to a side) and minimises it (ShowWindow).
    Anything that fails gives the normal Windows title bar back. (The 4.2 way - OwnCaption, a WNDPROC - failed.)"""

    CUR = {"n": "size_ns", "s": "size_ns", "e": "size_we", "w": "size_we", "nw": "size_nw_se", "se": "size_nw_se",
           "ne": "size_ne_sw", "sw": "size_ne_sw"}

    def __init__(self, root, minw=820, minh=520):
        self.ok = False
        self.root = root
        self.hwnd = None
        self.maxed = False
        self.full = False
        self.normal = None                  # (w, h, x, y) to go back to from maximised / half screen
        self.drag_ = None                   # ("move" | "resize", data)
        self.minw, self.minh = minw, minh
        self.s = 1.0
        if os.name != "nt":
            return
        try:
            self.s = max(1.0, min(2.5, root.winfo_fpixels("1i") / 96.0))
        except Exception:
            pass
        try:
            self._api()
            was = False
            try:
                was = root.state() == "zoomed"
                if was:
                    root.state("normal")
            except Exception:
                pass
            root.update_idletasks()
            root.overrideredirect(True)
            root.update_idletasks()
            self.hwnd = self.u.GetParent(root.winfo_id())
            if not self.hwnd:
                raise RuntimeError("no window handle")
            self.apply()
            self.normal = self.geo()
            self.ok = True
            root.withdraw()
            root.after(10, self._reshow)
            if was:
                root.after(40, self.toggle_max)
            root.after(1500, self.watchdog)
        except Exception as ex:
            _log(f"own title bar: {ex}")
            self.give_back()

    def _api(self):
        import ctypes
        from ctypes import wintypes
        self.ct, self.wt = ctypes, wintypes
        u = self.u = ctypes.windll.user32
        u.GetParent.restype = wintypes.HWND
        u.GetParent.argtypes = [wintypes.HWND]
        u.ShowWindow.argtypes = [wintypes.HWND, ctypes.c_int]
        u.IsIconic.argtypes = [wintypes.HWND]
        u.MonitorFromWindow.restype = ctypes.c_void_p
        u.MonitorFromWindow.argtypes = [wintypes.HWND, wintypes.DWORD]
        u.MonitorFromPoint.restype = ctypes.c_void_p
        u.MonitorFromPoint.argtypes = [wintypes.POINT, wintypes.DWORD]
        if ctypes.sizeof(ctypes.c_void_p) == 8:
            self._gwl, self._swl, lp = u.GetWindowLongPtrW, u.SetWindowLongPtrW, ctypes.c_ssize_t
        else:
            self._gwl, self._swl, lp = u.GetWindowLongW, u.SetWindowLongW, ctypes.c_long
        self._gwl.restype = lp
        self._gwl.argtypes = [wintypes.HWND, ctypes.c_int]
        self._swl.restype = lp
        self._swl.argtypes = [wintypes.HWND, ctypes.c_int, lp]

        class MONITORINFO(ctypes.Structure):
            _fields_ = [("cbSize", wintypes.DWORD), ("rcMonitor", wintypes.RECT), ("rcWork", wintypes.RECT),
                        ("dwFlags", wintypes.DWORD)]
        self.MI = MONITORINFO
        u.GetMonitorInfoW.argtypes = [ctypes.c_void_p, ctypes.POINTER(MONITORINFO)]

    def apply(self):
        """Taskbar button + Alt+Tab, minimise from the taskbar, Windows 11 round corners (square when maximised)."""
        if not self.hwnd:
            return
        try:
            ex = self._gwl(self.hwnd, -20)
            self._swl(self.hwnd, -20, (ex & ~0x80) | 0x40000)        # - WS_EX_TOOLWINDOW, + WS_EX_APPWINDOW
            st = self._gwl(self.hwnd, -16)
            self._swl(self.hwnd, -16, st | 0x80000 | 0x20000)        # + WS_SYSMENU, + WS_MINIMIZEBOX
            self.corners()
        except Exception as ex:
            _log(f"own title bar (styles): {ex}")

    def corners(self):
        try:
            pref = self.ct.c_int(1 if (self.maxed or self.full) else 2)
            self.ct.windll.dwmapi.DwmSetWindowAttribute(self.hwnd, 33, self.ct.byref(pref), 4)
        except Exception:
            pass

    def _reshow(self):
        r = self.root
        try:
            r.deiconify()
            r.lift()
            r.attributes("-topmost", True)
            r.after(300, lambda: r.attributes("-topmost", False))
            r.focus_force()
        except Exception:
            pass

    def give_back(self):
        """The normal Windows title bar again."""
        self.ok = False
        try:
            if self.maxed and self.normal:
                self.maxed = False
                self.set_geo(*self.normal)
            self.root.overrideredirect(False)
            self.root.withdraw()                         # (Windows applies the change when it is shown again)
            self.root.after(30, self._reshow)
        except Exception:
            pass

    # ---- where things are
    def geo(self):
        r = self.root
        try:
            r.update_idletasks()
        except Exception:
            pass
        return r.winfo_width(), r.winfo_height(), r.winfo_rootx(), r.winfo_rooty()

    def set_geo(self, w, h, x, y):
        self.root.geometry("%dx%d+%d+%d" % (max(1, w), max(1, h), x, y))

    def work_area(self, point=None, whole=False):
        """The screen the window (or the point) is on, without the taskbar (whole=True: with it)."""
        try:
            if point is not None:
                mon = self.u.MonitorFromPoint(self.wt.POINT(int(point[0]), int(point[1])), 2)
            else:
                mon = self.u.MonitorFromWindow(self.hwnd, 2)
            mi = self.MI()
            mi.cbSize = self.ct.sizeof(self.MI)
            if self.u.GetMonitorInfoW(mon, self.ct.byref(mi)):
                rc = mi.rcMonitor if whole else mi.rcWork
                return rc.left, rc.top, rc.right, rc.bottom
        except Exception:
            pass
        r = self.root
        return 0, 0, r.winfo_screenwidth(), r.winfo_screenheight() - (0 if whole else 48)

    def zoomed(self):
        return bool(self.maxed)

    def iconic(self):
        try:
            return bool(self.u.IsIconic(self.hwnd))
        except Exception:
            return False

    # ---- what the buttons do
    def toggle_max(self):
        try:
            if self.maxed:
                self.maxed = False
                if self.normal:
                    self.set_geo(*self.normal)
            else:
                g = self.geo()
                if g[0] > 50:
                    self.normal = g
                l_, t_, r_, b_ = self.work_area()
                self.maxed = True
                self.set_geo(r_ - l_, b_ - t_, l_, t_)
            self.corners()
        except Exception as ex:
            _log(f"own title bar (maximise): {ex}")

    def minimise(self):
        try:
            self.u.ShowWindow(self.hwnd, 6)                          # SW_MINIMIZE
        except Exception as ex:
            _log(f"own title bar (minimise): {ex}")

    def fullscreen(self, on):
        try:
            if on:
                self._fs_prev = (self.geo(), self.maxed)
                self.full = True
                l_, t_, r_, b_ = self.work_area(whole=True)
                self.set_geo(r_ - l_, b_ - t_, l_, t_)
            else:
                self.full = False
                g, self.maxed = getattr(self, "_fs_prev", (self.normal, False))
                if g:
                    self.set_geo(*g)
            self.corners()
            self.root.lift()
        except Exception as ex:
            _log(f"own title bar (full screen): {ex}")

    def watchdog(self):
        """Never off the screen: if the window is not where it can be reached, back to the middle."""
        try:
            w, h, x, y = self.geo()
            l_, t_, r_, b_ = self.work_area()
            if x + w < l_ + 80 or x > r_ - 80 or y < t_ - 5 or y > b_ - 60:
                w, h = min(w, r_ - l_ - 40), min(h, b_ - t_ - 40)
                self.set_geo(w, h, l_ + (r_ - l_ - w) // 2, t_ + (b_ - t_ - h) // 2)
                _log("own title bar: the window was off the screen - put back in the middle")
        except Exception:
            pass

    # ---- the mouse: move (the top band), resize (the edges), snap
    def zone(self, e):
        """'n', 'se', … when the mouse is on the window's edge (a few pixels), '' elsewhere."""
        if not self.ok or self.maxed or self.full:
            return ""
        r = self.root
        w, h = r.winfo_width(), r.winfo_height()
        rx, ry = e.x_root - r.winfo_rootx(), e.y_root - r.winfo_rooty()
        g = int(round(6 * self.s))
        cr = int(round(16 * self.s))
        n, s_, wv, ev = ry < int(round(4 * self.s)), ry >= h - g, rx < g, rx >= w - g
        if n or s_:
            wv, ev = wv or rx < cr, ev or rx >= w - cr
        if wv or ev:
            n, s_ = n or ry < cr, s_ or ry >= h - cr
        return ("n" if n else "s" if s_ else "") + ("w" if wv else "e" if ev else "")

    def start(self, e, kind, z=""):
        w, h, x, y = self.geo()
        self.drag_ = (kind, [z, e.x_root, e.y_root, w, h, x, y, False])

    def motion(self, e):
        if not self.drag_:
            return False
        kind, d = self.drag_
        z, x0r, y0r, w0, h0, x0, y0, moved = d
        dx, dy = e.x_root - x0r, e.y_root - y0r
        if not moved and abs(dx) + abs(dy) < 4:
            return True
        d[7] = True
        if kind == "move":
            if self.maxed:                         # pull a maximised window down: it comes back under the mouse
                frac = (e.x_root - x0) / float(max(1, w0))
                nw, nh = (self.normal or (w0 * 2 // 3, h0 * 2 // 3, 0, 0))[:2]
                self.maxed = False
                self.corners()
                nx = int(e.x_root - frac * nw)
                self.set_geo(nw, nh, nx, y0)
                d[1], d[2], d[3], d[4], d[5] = e.x_root, e.y_root, nw, nh, nx
                return True
            self.root.geometry("+%d+%d" % (x0 + dx, y0 + dy))
            return True
        w, h, x, y = w0, h0, x0, y0
        if "e" in z:
            w = max(self.minw, w0 + dx)
        if "s" in z:
            h = max(self.minh, h0 + dy)
        if "w" in z:
            w = max(self.minw, w0 - dx)
            x = x0 + (w0 - w)
        if "n" in z:
            h = max(self.minh, h0 - dy)
            y = y0 + (h0 - h)
        self.set_geo(w, h, x, y)
        return True

    def release(self, e):
        if not self.drag_:
            return False
        kind, d = self.drag_
        self.drag_ = None
        if not d[7]:
            return True
        if kind == "resize":
            self.normal = self.geo()
            return True
        l_, t_, r_, b_ = self.work_area((e.x_root, e.y_root))
        if e.y_root <= t_ + 1:
            if not self.maxed:
                self.toggle_max()
        elif e.x_root <= l_ + 1 or e.x_root >= r_ - 2:
            self.normal = (d[3], d[4], d[5], d[6]) if d[3] > 50 else self.normal     # where it was before
            half = max(self.minw, (r_ - l_) // 2)
            self.set_geo(half, b_ - t_, l_ if e.x_root <= l_ + 1 else r_ - half, t_)
        else:
            self.normal = self.geo()
        return True


class MciVideo:
    """4.4 - Windows: a video played inside a BindLens window by Windows' own media engine (MCI with DirectShow -
    part of Windows, nothing to install). Each call says whether it worked; if the video can't be opened this way,
    BindLens hands it to your video player instead."""

    def __init__(self, path, hwnd):
        import ctypes
        self.ct = ctypes
        self.w = ctypes.windll.winmm
        self.w.mciSendStringW.argtypes = [ctypes.c_wchar_p, ctypes.c_wchar_p, ctypes.c_uint, ctypes.c_void_p]
        self.w.mciGetErrorStringW.argtypes = [ctypes.c_uint, ctypes.c_wchar_p, ctypes.c_uint]
        self.alias = "bindlensvideo%d" % (int(time.time() * 1000) % 1000000)
        self.opened = False
        self.send(f'open "{path}" type mpegvideo alias {self.alias} style child parent {int(hwnd)}')
        self.opened = True
        self.send(f"set {self.alias} time format milliseconds")
        self.length = int(self.send(f"status {self.alias} length") or 0)
        try:
            parts = (self.send(f"where {self.alias} source") or "").split()
            self.size = (int(parts[2]), int(parts[3])) if len(parts) >= 4 else (16, 9)
        except Exception:
            self.size = (16, 9)

    def send(self, cmd):
        buf = self.ct.create_unicode_buffer(256)
        err = self.w.mciSendStringW(cmd, buf, 255, None)
        if err:
            msg = self.ct.create_unicode_buffer(256)
            self.w.mciGetErrorStringW(err, msg, 255)
            raise RuntimeError(msg.value or f"MCI error {err}")
        return buf.value

    def put(self, x, y, w, h):
        self.send(f"put {self.alias} window at {int(x)} {int(y)} {max(1, int(w))} {max(1, int(h))}")

    def play(self):
        self.send(f"play {self.alias}")

    def pause(self):
        self.send(f"pause {self.alias}")

    def mode(self):
        try:
            return self.send(f"status {self.alias} mode")
        except Exception:
            return ""

    def position(self):
        try:
            return int(self.send(f"status {self.alias} position") or 0)
        except Exception:
            return 0

    def seek(self, ms, play=True):
        ms = max(0, min(int(ms), max(0, self.length - 1)))
        self.send(f"seek {self.alias} to {ms}")
        if play:
            self.play()

    def volume(self, v):
        try:
            self.send(f"setaudio {self.alias} volume to {max(0, min(1000, int(v)))}")
        except Exception:
            pass

    def close(self):
        if self.opened:
            self.opened = False
            try:
                self.send(f"close {self.alias}")
            except Exception:
                pass


