    def _fill_suggestions(self, frame, tx, scope):
        """Names found in your documents, to click instead of typing them (worked out in the background)."""
        T = self.T
        files = self._scope_files(scope)
        box = {"names": None}

        def work():
            cnt = {}
            for folder, rel, path in files[:400]:
                e = self.indexer.get(self.lib.norm(path))
                for t in (e or {}).get("pages", [])[:200]:
                    for m in NAME_IN_TEXT.finditer(t.replace("\n", "  |  ")):
                        n = m.group(0)
                        if looks_like_name(n) and len(n.split()) >= 2:
                            cnt[n] = cnt.get(n, 0) + 1
            box["names"] = [n for n, c in sorted(cnt.items(), key=lambda kv: -kv[1])[:14]]

        def show():
            if box["names"] is None:
                frame.after(200, show)
                return
            if not frame.winfo_exists() or not box["names"]:
                return
            tk.Label(frame, text="Suggestions:", font=self.F(8), bg=T["panel"], fg=T["muted"]).grid(row=0, column=0,
                                                                                                   sticky="w")
            for i, n in enumerate(box["names"]):
                lb = tk.Label(frame, text=n, font=self.F(8), bg=T["chip"], fg=T["text"], padx=6, pady=1,
                              cursor="hand2")
                lb.grid(row=(i + 1) // 6, column=(i + 1) % 6, padx=2, pady=2, sticky="w")

                def add(_e=None, n=n):
                    cur = tx.get("1.0", "end").strip()
                    tx.delete("1.0", "end")
                    tx.insert("1.0", (cur + "\n" if cur else "") + n)
                    self._rep_terms_text = tx.get("1.0", "end").strip()
                lb.bind("<Button-1>", add)
        threading.Thread(target=work, daemon=True).start()
        show()

    def _scope_files(self, scope):
        return [x for x in self._scope_files0(scope) if not self._book_locked(x[0])]

    def _scope_files0(self, scope):
        out = []
        if scope == "books":                         # books chosen in Reports' "Look in" (1.9.3: any book)
            chosen = getattr(self, "_rep_books", None) or set()
            return [(f, rel, self.lib.file_path(f, rel)) for f in self.lib.folders if f in chosen
                    for rel in self.lib.folders.get(f, [])]
        if scope == "file" and self.book and self.book.total:
            f = self.book.files[self.book.pages[self.current_page][0]]
            return [(self.folder, f["rel"], f["path"])]
        if scope == "folder" and self.folder is not None:
            return [(self.folder, rel, self.lib.file_path(self.folder, rel))
                    for rel in self.lib.folders.get(self.folder, []) if rel.startswith(self.prefix or "")]
        for folder in self.lib.folders:
            for rel in self.lib.folders.get(folder, []):
                out.append((folder, rel, self.lib.file_path(folder, rel)))
        return out

    def _scope_title(self, scope):
        if scope == "books":
            names = [self.lib.label(f) for f in self.lib.folders if f in (getattr(self, "_rep_books", None) or ())]
            return ", ".join(names[:3]) + (f" and {len(names) - 3} more" if len(names) > 3 else "") or self.lib.title
        if scope == "file" and self.book and self.book.total:
            return self.book.files[self.book.pages[self.current_page][0]]["rel"]
        if scope == "folder" and self.folder is not None:
            return self.lib.label(self.folder) + (" - " + self.prefix.rstrip("/").split("/")[-1] if self.prefix else "")
        return self.lib.title

    def _open_any(self, path):
        with open(path, "rb") as fh:
            data = _doc_read(fh, path)
        doc = open_stream(self.fitz, data, path)
        if doc.is_reflowable:
            try:
                doc.layout(width=500, height=700, fontsize=12)
            except Exception:
                pass
        return doc

    def _page_texts(self, path):
        key = self.lib.norm(path)
        entry = self.indexer.get(key)
        try:
            st = os.stat(path)
        except Exception:
            st = None
        if entry and st and entry.get("mtime") == st.st_mtime and entry.get("pages") is not None:
            return entry["pages"]
        entry = self.indexer.read(path)
        self.indexer.put(key, entry)
        return entry["pages"]

    def _colors_in_scope(self, scope):
        """Colours of your marks (from the open book: no file is opened while the form is drawn)."""
        seen = OrderedDict()
        for m in self.marks:
            seen.setdefault(m["color"], 0)
            seen[m["color"]] += 1
        return sorted(seen, key=lambda c: -seen[c])

    def _gather_marks(self, scope, files=None):
        rows = []
        for folder, rel, p in (files if files is not None else self._scope_files(scope)):
            if not is_pdf(p):
                continue
            try:
                doc = self._open_any(p)
            except Exception:
                continue
            try:
                for pi in range(doc.page_count):
                    page = doc.load_page(pi)
                    for a in page.annots() or []:
                        t = a.type[1]
                        if t in SKIP_ANNOTS or t == "Line":
                            continue
                        info = a.info
                        date = (info.get("modDate") or info.get("creationDate") or "")
                        m = re.search(r"(\d{4})(\d{2})(\d{2})", date)
                        rows.append({"folder": folder, "file": rel, "page": pi + 1, "kind": t,
                                     "color": annot_color(a) or "#9AA0A6", "text": annot_text(page, a),
                                     "note": (info.get("content") or "").strip() if t in MARKUP else "",
                                     "y": a.rect.y0, "date": "-".join(m.groups()) if m else ""})
            finally:
                doc.close()
        return rows

    # ---- building each report
    def _reports_menu(self, e):
        m = self._menu()
        m.add_command(label="Reports…            Ctrl+R", command=self.simple_reports)
        att = getattr(self, "_attention", None)
        if att and att.get("n"):
            m.add_command(label=f"What needs attention ({att['n']})",
                          command=lambda: self.simple_reports(pick="expiry", scope="library", run=True))
        self._popup(m, e)

    def _open_report(self, key, preset=None, scope=None, days=None):
        self.report_dialog()
        st = getattr(self, "_rep_st", None)
        if st is None:
            return
        if preset:
            self._load_preset(preset, st)
            return
        if scope:
            st["scope"] = scope
        if days:
            st["days"] = days
        self._rep_pick(key)

    def _attention_scan(self):
        """In the background: dates next to 'expiry', 'valid until', 'vetting'… that passed in the last year or
        come in the next 30 days - the number on the Reports button."""
        if getattr(self, "_att_busy", False):
            return
        self._att_busy = True
        files = [(f, rel, self.lib.file_path(f, rel)) for f, rel in self.lib.all_files()]
        labels = {f: self.lib.label(f) for f in self.lib.folders}
        holder = {}
        if not self.pool.disabled:          # a helper reads (the window never waits)
            def got(res):
                if res.get("fallback"):
                    threading.Thread(target=lambda: holder.__setitem__(
                        "res", self._attention_compute(files, labels, {"cancel": False, "progress": ""})),
                        daemon=True).start()
                    return
                for k, e in (res.get("texts") or {}).items():
                    self.indexer.put(k, e)
                holder["res"] = res.get("result") or {"n": 0, "expired": 0, "soon": 0, "items": []}
            self.pool.submit("call", prio=7, timeout=3600, fn="_attention_compute",
                             args=[files, labels, "__job__"], index=self.indexer.path, cb=got)
        else:
            threading.Thread(target=lambda: holder.__setitem__(
                "res", self._attention_compute(files, labels, {"cancel": False, "progress": ""})), daemon=True).start()

        def check():                       # back in the window's own thread
            res = holder.get("res")
            if res is None:
                self.root.after(400, check)
                return
            self._att_busy = False
            self._attention = res
            tip = ""
            if res["n"]:
                tip = f"{res['expired']} expired · {res['soon']} in the next 30 days\n" + "\n".join(res["items"])
            try:
                self.btn_report.set_attention(res["n"], "critical" if res["expired"] else "serious", tip)
            except Exception:
                pass
        self.root.after(400, check)

    def _attention_compute(self, files, labels, job):
        """Dates next to 'expiry', 'valid until'… that passed in the last year or come in the next 30 days.
        Runs in a helper process (or a thread when there is none)."""
        res = {"n": 0, "expired": 0, "soon": 0, "items": []}
        try:
            P = {"terms": [], "files": files, "adv": {"all_dates": False, "past": True}, "days": 30, "lib": True,
                 "labels": labels}
            seen, rows = set(), []
            for x in self._expiry_items(P, job):
                if not (-365 <= x["left"] <= 30) or x.get("status") == "Renewed":
                    continue
                k = (x["date"], x["who"], x["text"][:40])
                if k in seen:
                    continue
                seen.add(k)
                rows.append(x)
            rows.sort(key=lambda x: x["left"])
            exp = [x for x in rows if x["left"] < 0]
            soon = [x for x in rows if x["left"] >= 0]
            lines = [(f"Expired {x['date'].strftime('%d %b')}: " if x["left"] < 0 else
                      ("Today: " if x["left"] == 0 else "Tomorrow: " if x["left"] == 1 else
                       f"In {x['left']} days: ")) + (x["who"] or x["what"]) + f"  ({self._short(x['file'], 30)})"
                     for x in (exp[-3:][::-1] + soon[:3])]
            # 3.0: the list itself too, for the Home screen (what needs you, click to open the page)
            board = [{"date": x["date"].isoformat(), "left": x["left"], "who": x["who"], "what": x["what"],
                      "file": x["file"], "page": x["page"], "folder": x.get("folder"), "rel": x.get("rel")}
                     for x in (soon + exp[::-1])[:40]]
            res = {"n": len(rows), "expired": len(exp), "soon": len(soon), "items": lines, "rows": board}
        except Exception as ex:
            _log(f"attention scan: {ex}")
        return res

    def _made_badge(self):
        """The number on the Reports button: the reports made lately (the last 8)."""
        try:
            keys = {it[0] for _g, _c, its in self.REPORT_MENU for it in its}
            n = len([r_ for r_ in self.lib.settings.get("rep_runs", []) if r_.get("k") in keys][:8])
            self.btn_report.set_made(n)
        except Exception:
            pass

    def _attention_loop(self):
        if self.lib.settings.get("attention_badge", True):
            self._attention_scan()
        self.root.after(15 * 60 * 1000, self._attention_loop)

    def _rep_summary(self, st):
        """One sentence with what the report will be: which report, where, for what, and the file type."""
        t = st["type"]
        r = self.REPORTS[t]
        where = {"file": "this file", "folder": "this sub-book" if self.prefix else "this book",
                 "library": "all my books", "books": (f"“{next(iter(st['books']))}”" if len(st.get('books') or []) == 1
                                                     else f"{len(st.get('books') or [])} chosen books")}.get(st["scope"],
                                                                                                     "this book")
        if self.folder is not None and st["scope"] == "folder":
            where = f"“{self.lib.label(self.folder)}”"
        parts = [r["title"], "in " + where]
        try:
            terms = [x.strip() for x in re.split(r"[,\n;\t]+", (self._rep_terms.get("1.0", "end") if
                                                                 self._rep_terms is not None else "")) if x.strip()]
        except Exception:
            terms = []
        if terms and any(f.startswith(("people", "words")) for f in r["filters"]):
            parts.append("for " + ", ".join(terms[:3]) + (f" +{len(terms) - 3}" if len(terms) > 3 else ""))
        if "days" in r["filters"]:
            parts.append({3650: "any time"}.get(int(st.get("days", 90)), f"next {int(st.get('days', 90))} days"))
        if "dates" in r["filters"] and (self._rep_from.get().strip() or self._rep_to.get().strip()):
            parts.append(f"dates {self._rep_from.get().strip() or '…'} - {self._rep_to.get().strip() or '…'}")
        if "pack" in r["filters"]:
            parts.append(self.PACKS.get(st.get("pack"), ("",))[0])
        if getattr(self, "_rep_fname", None) is not None and self._rep_fname.get().strip() and st["scope"] != "file":
            parts.append(f"files named “{self._rep_fname.get().strip()}”")
        if "columns!" in r["filters"] and self._rep_cols.get().strip():
            parts.append("columns " + self._rep_cols.get().strip())
        parts.append("as " + {"pdf": "PDF", "docx": "Word", "xlsx": "Excel"}.get(st.get("fmt"), "PDF"))
        return "  ·  ".join(p_ for p_ in parts if p_)

    def _run_report(self, st, dialog):
        """Read the documents in the background (the window stays usable), then show a preview."""
        if getattr(self, "_rep_job", None):
            return
        try:                              # 3.0: kept as "made lately" only once the report is really made
            summ = self._rep_summary(st).split("  ·  ", 1)[-1]
            self._rep_pending_run = {"type": st["type"], "summary": summ, "preset": self._report_preset(st)}
        except Exception:
            self._rep_pending_run = None
        t, scope = st["type"], st["scope"]
        spec = self.REPORTS[t]
        try:
            self._rep_terms_text = self._rep_terms.get("1.0", "end").strip()
        except Exception:
            pass
        terms = [x.strip() for x in re.split(r"[,\n;\t]+", self._rep_terms_text or "") if x.strip()]
        if ("people!" in spec["filters"] or "words!" in spec["filters"]) and not terms:
            messagebox.showinfo(APP_NAME, "Type at least one name, word or value.", parent=dialog)
            return
        if terms and (self._rep_terms_text or "").strip():
            rec = [r for r in self.lib.settings.get("rep_recent", []) if r.strip() != self._rep_terms_text.strip()]
            self.lib.settings["rep_recent"] = ([self._rep_terms_text.strip()] + rec)[:4]
        if "columns!" in spec["filters"] and not self._rep_cols.get().strip():
            messagebox.showinfo(APP_NAME, "Type the name of at least one column, e.g. Phone or Hours.", parent=dialog)
            return
        if t == "extract" and not st["kinds"]:
            messagebox.showinfo(APP_NAME, "Choose at least one kind of data to find.", parent=dialog)
            return
        self._flush_dirty()
        if scope == "books":
            self._rep_books = set(st.get("books") or ())
        title = self._scope_title(scope)
        if t == "marks" and st.get("_marks") is None and not self.pool.disabled:
            # the marks of every file are read by a helper first (the window never waits)
            mjob = {"cancel": False, "done": False, "progress": "Reading the marks…", "result": None, "error": None}
            self._rep_job = mjob

            def got(res):
                if self._rep_job is mjob:
                    self._rep_job = None
                if mjob["cancel"] or res.get("cancelled"):
                    return
                rows = res.get("result")
                if rows is None:
                    rows = self._gather_marks(scope)
                st["_marks"] = rows
                try:
                    self._run_report(st, dialog)
                finally:
                    st.pop("_marks", None)
            self.pool.submit("call", prio=5, timeout=3600, fn="_gather_marks", args=[None, self._scope_files(scope)],
                             index=self.indexer.path, cb=got, cancel=lambda: mjob["cancel"])
            return
        if t in ("marks", "status"):
            dialog.config(cursor="watch")
            self.root.update()
            try:
                rep = getattr(self, "_rep_" + t)(st, scope, title)
            except Exception as ex:
                messagebox.showerror(APP_NAME, f"Could not create the report:\n{ex}", parent=dialog)
                return
            finally:
                dialog.config(cursor="")
            if rep:
                rep["_name"] = spec["title"] + " - " + title
                rep = self._enrich(t, rep)
                self.preview_report(rep, st["fmt"])
            return
        files = self._scope_files(scope)
        if scope == "books":
            files = [(f, rel, self.lib.file_path(f, rel)) for f in self.lib.folders if f in st.get("books", set())
                     for rel in self.lib.folders.get(f, [])]
        fq = [x.strip().lower() for x in re.split(r"[,;]+", getattr(self, "_rep_fname", None) and
                                                   self._rep_fname.get() or "") if x.strip()]
        if fq and scope != "file":
            files = [x for x in files if any(q in x[1].lower() for q in fq)]
            if not files:
                messagebox.showinfo(APP_NAME, "No file has that in its name here.", parent=dialog)
                return
        P = {"type": t, "scope": scope, "title": title, "terms": terms, "files": files,
             "lib": scope in ("library", "books"), "match": st["match"], "adv": dict(st["adv"].get(t, {})),
             "incol": self._rep_incol.get(), "excl": self._rep_excl.get(), "cols_txt": self._rep_cols.get(),
             "from": parse_date_text(self._rep_from.get()), "to": parse_date_text(self._rep_to.get()),
             "inc": set(st["inc"]), "kinds": [k for k, _ in self.EXTRACT_KINDS if k in st["kinds"]],
             "only": self._rep_only.get(), "labels": {f: self.lib.label(f) for f in self.lib.folders},
             "fileB": st.get("fileB"), "fileA": self._scope_files("file")[0] if self.book and self.book.total else None,
             "pack": st.get("pack", "childcare"), "days": int(st.get("days", 90)),
             "themes": self._parse_themes(self.lib.settings.get("themes_text") or
                                          "\n".join(f"{k}: {v}" for k, v in DEFAULT_THEMES.items())),
             "required": [x.strip() for x in (self.lib.settings.get("required_text") or
                                             "Registration form\nConsent form\nMedical / allergy form\n"
                                             "Emergency contact\nPhoto permission").splitlines() if x.strip()],
             "pv": (st.get("pv_rows", "person"), st.get("pv_cols", "none"), st.get("pv_val", "count")),
             "pv_cols": (self._rep_pv_rcol.get().strip(), self._rep_pv_ccol.get().strip(),
                         self._rep_pv_vcol.get().strip()),
             "marks": [], "gather_marks": self._scope_files(scope) if t in ("dashboard", "overview") or
             (t == "charts" and "marks" in ((st.get("extra") or {}).get("charts") or [])) else None,
             "status": {p: self._status(p) for _f, _r, p in self._scope_files(scope)} if t in ("dashboard",
                                                                                                "overview",
                                                                                                "invoices") or
             (t == "charts" and "status" in ((st.get("extra") or {}).get("charts") or [])) else {},
             "sig": self._report_sig(st, t)}
        for k, lab, dflt in spec.get("adv", []):
            P["adv"].setdefault(k, dflt)
        P.update(st.get("extra") or {})                  # (the Reports screen: question, kinds, compare files…)
        job = {"cancel": False, "done": False, "progress": "", "result": None, "error": None}
        self._rep_job = job
        self._rep_sig = P["sig"]

        def work():
            try:
                job["result"] = self._job_run(t, P, job)
            except Exception as ex:
                import traceback
                job["error"] = f"{ex}\n\n{traceback.format_exc()[-700:]}"
                _log(f"report {t}: {job['error']}")
            job["done"] = True

        if self.pool.disabled:
            threading.Thread(target=work, daemon=True).start()
        else:
            # a helper process makes the report: the window stays quick however big the books are
            self.writer.wait(3)                      # your latest marks are on the disk first

            def got(res):
                if res.get("fallback"):
                    threading.Thread(target=work, daemon=True).start()
                    return
                for k, e in (res.get("texts") or {}).items():
                    self.indexer.put(k, e)
                if res.get("cancelled"):
                    job["cancel"] = True
                elif "result" in res:
                    job["result"] = res["result"]
                elif not job.get("_retried"):
                    # 4.1: the helper could not make it - the window makes it itself (and the reason is kept)
                    job["_retried"] = True
                    _log(f"report {t} in a helper failed, made again here: {res.get('err')}")
                    threading.Thread(target=work, daemon=True).start()
                    return
                else:
                    job["error"] = res.get("err") or "The reader stopped."
                job["done"] = True
            job["_hj"] = self.pool.submit("call", prio=5, timeout=4 * 3600, fn="_job_run", args=[t, P, "__job__"],
                                          index=self.indexer.path, cb=got, cancel=lambda: job["cancel"])
        self._poll_report(dialog, st)

    def _job_run(self, t, P, job):
        """One report (in a helper process, or a thread when there is none)."""
        if P.get("gather_marks") is not None:
            P["marks"] = self._gather_marks(None, files=P["gather_marks"])
        return getattr(self, "_job_" + t)(P, job)

    def _cancel_report(self):
        if getattr(self, "_rep_job", None):
            self._rep_job["cancel"] = True

    def _poll_report(self, dialog, st):
        job = self._rep_job
        if job is None:
            return
        if job.get("_hj") is not None and job["_hj"].progress:
            job["progress"] = job["_hj"].progress
        try:
            self._rep_prog.configure(text=job["progress"])
        except Exception:
            pass
        if not job["done"]:
            self.root.after(120, lambda: self._poll_report(dialog, st))
            return
        self._rep_job = None
        try:
            self._rep_prog.configure(text="")
        except Exception:
            pass
        if job["cancel"]:
            return
        if hasattr(self, "frame_pulse"):
            self.frame_pulse(2.5)                        # 4.0: the report is ready - the frame says so
        if job["error"]:
            messagebox.showerror(APP_NAME, "Could not create the report:\n" + job["error"], parent=dialog)
            return
        rep = job["result"]
        if not rep:
            return
        if isinstance(rep, str):
            messagebox.showinfo(APP_NAME, rep, parent=dialog)
            return
        try:
            rep = self._enrich(st["type"], rep)
            if st["type"] not in ("snapshot", "rows", "charts"):
                rep = self._since_last(rep, getattr(self, "_rep_sig", None))
            self.lib.save_meta()
        except Exception as ex:
            _log(f"report extras: {ex}")
        self._rep_ok = True
        self._remember_run()
        self.preview_report(rep, st["fmt"])

    def _remember_run(self):
        """A report was made: it goes first in 'Made lately' (the number on the Reports button, the last 8)."""
        run = getattr(self, "_rep_pending_run", None)
        self._rep_pending_run = None
        if not run:
            return
        try:
            runs = self.lib.settings.setdefault("rep_runs", [])
            run = dict(run, when=time.strftime("%d %b %H:%M"))
            same = (lambda x: x.get("k") == run["k"]) if run.get("k") else \
                (lambda x: x.get("type") == run["type"] and x.get("summary") == run["summary"])
            runs[:] = [run] + [x for x in runs if not same(x)][:7]
            self.lib.save_meta()
            self._made_badge()
            cb = getattr(self, "_rep_made_cb", None)
            if cb:
                cb()
        except Exception as ex:
            _log(f"made lately: {ex}")

    # ---- report helpers (1.6): key numbers, findings, charts, 'since last time' ----------------------------
    @staticmethod
    def _parse_themes(text):
        out = OrderedDict()
        for line in (text or "").splitlines():
            if ":" not in line:
                continue
            name, words = line.split(":", 1)
            ws = [w.strip() for w in re.split(r"[,;]+", words) if w.strip()]
            if name.strip() and ws:
                out[name.strip()] = ws
        return out

    def _report_sig(self, st, t):
        # 3.0: what was asked counts too (Emails and Phones are both 'pick' reports - they shared one history)
        key = json.dumps([t, st.get("scope"), sorted(st.get("books", [])), self._rep_terms_text, self._rep_cols.get(),
                          st.get("pack"), st.get("pv_rows"), st.get("pv_cols"), st.get("pv_val"),
                          self.folder, self.prefix, st.get("extra")], default=str, sort_keys=True)
        import hashlib
        return hashlib.sha1(key.encode("utf-8")).hexdigest()[:16]

    def _since_last(self, rep, sig):
        """P4: compare with the last time this same report was made - what is new, what is gone."""
        if not sig or not isinstance(rep, dict):
            return rep
        import hashlib
        tables = [b[1] for b in rep["blocks"] if b[0] == "table" and b[1].get("rows")]
        main = rep.get("preview_table") or (max(tables, key=lambda t: len(t["rows"])) if tables else None)
        if not main:
            return rep
        # 3.0: columns that change by themselves every day ('Days left') do not make a row 'new'
        skip = {i for i, h in enumerate(main.get("headers") or [])
                if re.search(r"days? (?:left|since|ago|old)|^age$|^left$", str(h).strip().lower())}
        keys = []
        for r in main["rows"]:
            keys.append(hashlib.sha1("|".join(str(x) for i, x in enumerate(r) if i not in skip)
                                     .encode("utf-8")).hexdigest()[:12])
        # 3.0: kept in a file of its own (it made the list of books big and slow to save)
        hpath = os.path.join(self.lib.meta_dir, "report_history.json")
        hist = load_json(hpath, {}) if os.path.exists(hpath) else {}
        if not isinstance(hist, dict):
            hist = {}
        old_set = self.lib.settings.pop("rep_history", None)
        if isinstance(old_set, dict):
            for k_, v_ in old_set.items():
                hist.setdefault(k_, v_)
        old = hist.get(sig)
        # 4.1: the rows themselves too (the first 200, short) - so what is GONE can be shown, in grey
        hist[sig] = {"date": time.strftime("%d %b %Y %H:%M"), "t": time.time(), "keys": keys[:5000],
                     "rows": {k: [str(x)[:60] for x in r][:12] for k, r in list(zip(keys, main["rows"]))[:200]}}
        if len(hist) > 40:
            for k in sorted(hist, key=lambda k: hist[k].get("t", 0))[:len(hist) - 40]:
                hist.pop(k, None)
        try:
            save_json(hpath, hist)
        except Exception:
            pass
        if not old:
            return rep
        prev = set(old.get("keys", []))
        new_idx = [i for i, k in enumerate(keys) if k not in prev]
        gone = len(prev - set(keys))
        if not new_idx and not gone:
            rep["blocks"].insert(0, ("alert", {"tone": "info", "text": f"Nothing changed since the last time "
                                                                       f"({old.get('date')})."}))
            return rep
        cols = list(main.get("colors") or [None] * len(main["rows"]))
        cols += [None] * (len(main["rows"]) - len(cols))
        for i in new_idx:
            if not cols[i]:
                cols[i] = "#2A78D6"
        main["colors"] = cols
        txt = f"Since the last time ({old.get('date')}): {len(new_idx)} new row{'s' if len(new_idx) != 1 else ''}" + \
              (f", {gone} gone" if gone else "") + "." + (" New rows are marked in blue." if new_idx else "")
        old_rows = old.get("rows") or {}
        gone_rows = [old_rows[k] for k in old.get("keys", []) if k in old_rows and k not in set(keys)]
        if gone_rows:
            txt += " The ones that are gone are at the end, in grey."
            try:
                at = next(i for i, b_ in enumerate(rep["blocks"]) if b_[0] == "table" and b_[1] is main) + 1
            except StopIteration:
                at = len(rep["blocks"])
            n_h = len(main.get("headers") or [])
            gr = [(r + [""] * n_h)[:n_h] if n_h else r for r in gone_rows[:100]]
            rep["blocks"][at:at] = [("h", f"Gone since the last time  ·  {len(gone_rows)}"),
                                    ("table", {"name": "Gone since the last time", "headers": main.get("headers"),
                                               "rows": gr, "colors": ["#8C8C99"] * len(gr),
                                               "widths": main.get("widths")})]
        rep["blocks"].insert(0, ("alert", {"tone": "info", "text": txt}))
        return rep

    @staticmethod
    def _kp(label, value, tone=None):
        d = {"label": label, "value": value if isinstance(value, str) else _fmt_num(value)}
        if tone:
            d["tone"] = tone
        return d

    def _texts(self, P, job):
        """(name, folder, rel, path, [page texts]) for each file - from the search index (fast)."""
        files = P["files"]
        for k, (folder, rel, path) in enumerate(files):
            if job["cancel"]:
                return
            job["progress"] = f"Reading {k + 1} of {len(files)}  ·  Esc to stop"
            try:
                texts = self._page_texts(path)
            except Exception:
                continue
            name = f"{P['labels'].get(folder, folder)} / {rel}" if P["lib"] else rel
            yield name, folder, rel, path, texts

    @staticmethod
    def _short(name, n=34):
        b = os.path.basename(name)
        return b if len(b) <= n else b[:n - 1] + "…"

    # ---- Start here --------------------------------------------------------------------------------------
    def _job_pack(self, P, job):
        name, desc, parts = self.PACKS.get(P.get("pack"), self.PACKS["childcare"])
        blocks, kpis, alerts = [], [], []
        done = 0
        for typ, over in parts:
            if job["cancel"]:
                return None
            Q = dict(P)
            Q["type"] = typ
            Q["adv"] = {k: d for k, _l, d in self.REPORTS[typ]["adv"]}
            Q["adv"].update({k: v for k, v in over.items() if k not in ("required", "pv")})
            if over.get("required"):
                Q["required"] = [x for x in over["required"].splitlines() if x.strip()]
            if over.get("pv"):
                Q["pv"] = over["pv"]
                Q["pv_cols"] = ("", "", "")
            Q["terms"] = [] if "people!" not in self.REPORTS[typ]["filters"] else P["terms"]
            try:
                r = getattr(self, "_job_" + typ)(Q, job)
            except Exception as ex:
                r = f"Could not run: {ex}"
            title = self.REPORTS[typ]["title"]
            blocks.append(("h", title))
            if isinstance(r, str) or r is None:
                blocks.append(("p", r or "Stopped."))
                continue
            done += 1
            for b in r["blocks"]:
                if b[0] == "kpis":
                    if b[1]:
                        kpis.append(dict(b[1][0], label=f"{b[1][0]['label']}  ({title.lower()})"))
                    blocks.append(b)
                elif b[0] == "alert":
                    if b[1].get("tone") in ("critical", "serious", "warning"):
                        alerts.append(("alert", dict(b[1], text=f"{title}: {b[1].get('text', '')}")))
                    blocks.append(b)
                elif b[0] == "h":
                    blocks.append(("h3", b[1]))
                elif b[0] == "table":
                    t = dict(b[1])
                    t["name"] = (title.split()[0] + " - " + (t.get("name") or "Table"))[:28]
                    blocks.append(("table", t))
                else:
                    blocks.append(b)
        if job["cancel"]:
            return None
        head = [("kpis", kpis[:8])] if kpis else []
        if alerts:
            head.append(("h", "Needs your attention"))
            head += alerts[:12]
        else:
            head.append(("alert", {"tone": "good", "text": "Nothing urgent was found."}))
        return {"title": f"{name} checks", "subtitle": self._subtitle(P["scope"], desc), "blocks": head + blocks,
                "_name": f"{name} checks - {P['title']}"}

    def _job_dashboard(self, P, job):
        texts_all, per_file, types = {}, [], {}
        words_tot = pages_tot = 0
        scanned = 0
        for name, folder, rel, path, texts in self._texts(P, job):
            joined = "\n".join(texts)
            wc = len(re.findall(r"[A-Za-zÀ-ÿ]{2,}", joined))
            dt = doc_type(joined)
            types[dt] = types.get(dt, 0) + 1
            empty = sum(1 for t in texts if len(t.strip()) < 20)
            scanned += empty
            per_file.append([name, len(texts), wc, dt])
            words_tot += wc
            pages_tot += len(texts)
            texts_all[name] = joined[:60000]
        if job["cancel"]:
            return None
        if not per_file:
            return "No files here."
        marks = P.get("marks") or []
        status = P.get("status") or {}
        by_status = {}
        for p, tag in status.items():
            by_status[tag or "No status"] = by_status.get(tag or "No status", 0) + 1
        cnt = {}
        for t in texts_all.values():
            for w in words_of(t):
                cnt[w] = cnt.get(w, 0) + 1
        top = sorted(cnt.items(), key=lambda kv: -kv[1])[:45]
        blocks = [("kpis", [self._kp("Files", len(per_file)), self._kp("Pages", pages_tot),
                            self._kp("Words", words_tot), self._kp("Reading time",
                                                                   f"{max(1, round(words_tot / 230))} min"),
                            self._kp("Marks", len(marks)),
                            self._kp("Pages without text", scanned, "warning" if scanned else None)])]
        if scanned:
            blocks.append(("alert", {"tone": "warning", "text": f"{scanned} page(s) have no text (scanned?) - "
                                                                f"right-click their file > Make scanned pages "
                                                                f"searchable, so search and reports can read them."}))
        blocks.append(("chart", {"type": "donut", "title": "Kinds of documents", "labels": list(types),
                                 "series": [{"values": list(types.values())}], "center": "files",
                                 "link": {"table": "Files", "col": "Kind"}}))
        big = sorted(per_file, key=lambda r: -r[1])[:15]
        blocks.append(("chart", {"type": "bar", "title": "Pages per file", "labels": [self._short(r[0]) for r in big],
                                 "series": [{"name": "Pages", "values": [r[1] for r in big]}],
                                 "link": {"table": "Files", "col": "File"}}))
        if by_status:
            order = [s for s, _c in STATUSES if s in by_status] + [s for s in by_status if s not in dict(STATUSES)]
            blocks.append(("chart", {"type": "donut", "title": "Status of files", "labels": order,
                                     "series": [{"values": [by_status[s] for s in order]}],
                                     "colors": [dict(STATUSES).get(s, "#B9B8B2") for s in order], "center": "files"}))
        if marks:
            byc = {}
            for mk in marks:
                byc[color_name(mk["color"])] = byc.get(color_name(mk["color"]), 0) + 1
            blocks.append(("chart", {"type": "bar", "title": "Marks per colour", "labels": list(byc),
                                     "series": [{"name": "Marks", "values": list(byc.values())}]}))
        if top:
            blocks.append(("chart", {"type": "cloud", "title": "Key words", "words": top}))
        blocks.append(("h", "Files"))
        blocks.append(("table", {"name": "Files", "headers": ["File", "Pages", "Words", "Kind"], "rows": per_file,
                                 "widths": [50, 8, 10, 18]}))
        return {"title": f"Dashboard - {P['title']}", "subtitle": self._subtitle(P["scope"]), "blocks": blocks,
                "_name": "Dashboard - " + P["title"]}

    # ---- Ask your documents -> extract exact data -> analyse -> report ----------------------------------------
    def _ask_files(self, P, a, job):
        """The files worth reading for a question: of the kinds asked for, with the names / values in them."""
        lows = [t.lower() for t in a["terms"]]
        types = set(a["types"])
        keep = []
        for k, (folder, rel, path) in enumerate(P["files"]):
            if job["cancel"]:
                return []
            job["progress"] = f"Looking through {k + 1} of {len(P['files'])}  ·  Esc to stop"
            try:
                texts = self._page_texts(path)
            except Exception:
                continue
            joined = "\n".join(texts)
            if types and doc_type(joined) not in types:
                continue
            if lows and not any(t in joined.lower() for t in lows):
                continue
            keep.append((folder, rel, path))
        return keep

    @staticmethod
    def _ask_lookup(rows, label, kind, y=None, skip=None):
        """A value on a page: a 'Label: value' first, then (for amounts) the total, then the nearest one."""
        best = None
        if kind == "Amounts":
            tots = [r for r in rows if r is not skip and re.search(r"\btotal\b", r["text"], re.I) and
                    find_values("Amounts", r["text"])]
            if tots:
                return find_values("Amounts", tots[-1]["text"])[-1]
        for r in rows:
            if r is skip:
                continue
            v = ask_value(r, label, kind)
            if not v:
                continue
            d_ = abs((r.get("y") or 0) - (y or 0)) if y is not None else 0
            labelled = re.search(r"(?<!\w)" + re.escape(label.lower()) + r"\w*\s*[:=–-]", r["text"].lower())
            key = (0 if labelled else 1, d_)
            if best is None or key < best[0]:
                best = (key, v)
        return best[1] if best else ""

    def _job_ask(self, P, job):
        """Ask your documents: look for the names / values, take the exact data asked for from the same row (or the
        same page, or the top of the document), add it up if asked, and show it as a table and a chart."""
        import datetime
        a = P.get("ask") or parse_question(P.get("question", ""))
        terms, fields = a["terms"], a["fields"]
        if not terms and not fields and not a["types"] and not a["agg"]:
            return ("Write what you are looking for - e.g.  John Smith - date, amount, invoice number   or   "
                    "total amount per month.")
        pats = [(t, re.compile(r"(?<!\w)" + re.escape(t) + r"(?!\w)", re.I)) for t in terms]
        files = self._ask_files(P, a, job)
        if job["cancel"]:
            return None
        if not files:
            return "Nothing found. Check the spelling, or look in all your books."
        col_fields = [l for l, k in fields if k == "col"]
        per_doc = not terms and not col_fields
        Q = dict(P, files=files, titles=True)
        recs, first_rows, n_pages = [], {}, set()

        def first_page_rows(doc, name):
            if name not in first_rows:
                try:
                    first_rows[name] = page_rows(self.fitz, doc.load_page(0), {})
                except Exception:
                    first_rows[name] = []
            return first_rows[name]

        def record(row, rows, name, folder, page, doc, pi, found):
            vals, src = OrderedDict(), {}
            for label, kind in fields:
                v, s_ = (ask_value(row, label, kind), "row") if row is not None else ("", "")
                if not v:
                    v, s_ = self._ask_lookup(rows, label, kind, row.get("y") if row else None, row), "page"
                if not v and pi:
                    v, s_ = self._ask_lookup(first_page_rows(doc, name), label, kind), "document"
                vals[label] = v
                src[label] = s_ if v else ""
            when = None
            for label, kind in fields:
                if kind == "Dates" and vals.get(label):
                    ds = parse_dates(vals[label])
                    when = ds[0] if ds else None
                    break
            if when is None and row is not None:
                ds = parse_dates(row["text"])
                when = ds[0] if ds else None
            if a["from"] and (when is None or not (a["from"] <= when <= a["to"])):
                return
            org = (organisation(row) if row is not None else "") or ""
            if not org:
                pt = " ".join(r["text"] for r in rows[:40])
                m_ = self.ORG_RE.search(pt)
                org = " ".join(m_.group(1).split()) if m_ else ""
            recs.append({"found": found, "file": name, "folder": folder, "page": page, "vals": vals, "src": src,
                         "when": when, "line": row["text"] if row is not None else "",
                         "person": (found if terms else (person_name(row) if row is not None else "")),
                         "org": org, "row": row})
            n_pages.add((name, page))

        if per_doc:
            for k, (folder, rel, path) in enumerate(files):
                if job["cancel"]:
                    return None
                job["progress"] = f"Reading {k + 1} of {len(files)}  ·  Esc to stop"
                try:
                    doc = self._doc_bytes_open(path)
                except Exception:
                    continue
                name = f"{P['labels'].get(folder, folder)} / {rel}" if P["lib"] else rel
                try:
                    rows, ctx = [], {}
                    for pi in range(min(doc.page_count, 6)):
                        rows += page_rows(self.fitz, doc.load_page(pi), ctx)
                    record(None, rows, name, folder, 1, doc, 0, "")
                finally:
                    doc.close()
        else:
            pf = (lambda tx: any(p.search(tx) for _t, p in pats)) if pats else None
            for name, folder, rel, page, rows, doc, pi in self._walk_pages(Q, job, pf):
                for row in rows:
                    if pats:
                        hit = next((t for t, p in pats if p.search(row["text"])), None)
                        if not hit:
                            continue
                    else:                     # no name: the table rows that have the columns asked for
                        hdr = " ".join(h.lower() for h in (row.get("header") or []))
                        if not row.get("table") or not all(c.lower() in hdr for c in col_fields):
                            continue
                        if TOTAL_ROW.match((row["cells"][0] or "").strip()):
                            continue
                        hit = ""
                    record(row, rows, name, folder, page, doc, pi, hit)
        if job["cancel"]:
            return None
        if not recs:
            return "Nothing found with that. Try fewer words, or look in all your books."
        # analyse
        num_label = next((l for l, k in fields if k in ("Amounts", "col")), None)

        def number(rc):
            if not num_label:
                return None
            return parse_number(rc["vals"].get(num_label, ""))
        blocks = [("alert", {"tone": "info", "text": "You asked: " + (P.get("question") or "").strip() +
                             ("     ·  Understood:  " + a["say"] if a.get("say") else "")})]
        docs = {rc["file"] for rc in recs}
        kp = [self._kp("Documents", len(docs)), self._kp("Pages", len(n_pages)), self._kp("Results", len(recs))]
        nums = [n for n in (number(rc) for rc in recs) if n is not None]
        sym = next((c for c in "€$£" if any(c in (rc["vals"].get(num_label or "", "") or "") for rc in recs)), "")
        tot_name = (lambda l: "Total" if l.lower() in ("total", "totals", "importe total") else f"Total {l.lower()}")
        if nums and num_label:
            kp.append(self._kp(tot_name(num_label), f"{sym}{sum(nums):,.2f}" if sym else f"{round(sum(nums), 2):,}"))
        missing = sum(1 for rc in recs for l in rc["vals"] if not rc["vals"][l])
        if fields:
            kp.append(self._kp("Not found", missing, "warning" if missing else None))
        blocks.append(("kpis", kp))
        if a["agg"] and a["per"]:
            pk, pcol = a["per"]
            groups = OrderedDict()
            for rc in recs:
                if pk == "month":
                    g_ = rc["when"].strftime("%Y-%m") if rc["when"] else None
                elif pk == "year":
                    g_ = str(rc["when"].year) if rc["when"] else None
                elif pk == "person":
                    g_ = rc["person"] or rc["vals"].get("Name") or None
                elif pk == "file":
                    g_ = self._short(rc["file"], 40)
                elif pk == "book":
                    g_ = P["labels"].get(rc["folder"], rc["folder"])
                elif pk == "org":
                    g_ = rc["org"] or None
                else:
                    g_ = (ask_value(rc["row"], pcol, "col") if rc["row"] is not None else "") or None
                if g_ is None:
                    continue
                groups.setdefault(g_, []).append(rc)
            agg = a["agg"]
            rows_g = []
            for g_, rs in groups.items():
                ns = [n for n in (number(rc) for rc in rs) if n is not None]
                if agg == "count" or not num_label:
                    v = len(rs)
                elif not ns:
                    continue
                else:
                    v = {"sum": sum, "avg": lambda x: sum(x) / len(x), "max": max, "min": min}[agg](ns)
                rows_g.append([g_, round(v, 2), len(rs)])
            what = {"sum": tot_name(num_label) if num_label else "Total", "count": "Count", "avg": f"Average {num_label or ''}",
                    "max": f"Highest {num_label or ''}", "min": f"Lowest {num_label or ''}"}[agg].strip()
            gname = {"month": "Month", "year": "Year", "person": "Person", "file": "File", "book": "Book",
                     "org": "Organisation", "col": pcol or "Value"}[pk]
            if pk in ("month", "year"):
                rows_g.sort(key=lambda r: r[0])
                if pk == "month":
                    for r in rows_g:
                        r[0] = datetime.datetime.strptime(r[0], "%Y-%m").strftime("%b %Y")
            else:
                rows_g.sort(key=lambda r: -r[1])
            if rows_g:
                blocks.append(("chart", {"type": "col" if pk in ("month", "year") else "bar",
                                         "title": f"{what} per {gname.lower()}",
                                         "labels": [str(r[0])[:30] for r in rows_g[:24]],
                                         "series": [{"name": what, "values": [r[1] for r in rows_g[:24]]}],
                                         "link": {"table": "Summary", "col": gname}}))
                blocks.append(("h", f"{what} per {gname.lower()}"))
                blocks.append(("table", {"name": "Summary", "headers": [gname, what, "Results"], "rows": rows_g,
                                         "widths": [30, 14, 10]}))
        elif nums and any(k == "Dates" for _l, k in fields):
            per_m = OrderedDict()
            for rc in sorted(recs, key=lambda r: r["when"] or datetime.date.min):
                n = number(rc)
                if n is not None and rc["when"]:
                    k_ = rc["when"].strftime("%Y-%m")
                    per_m[k_] = per_m.get(k_, 0) + n
            if len(per_m) > 1:
                blocks.append(("chart", {"type": "col", "title": f"{num_label} per month",
                                         "labels": [datetime.datetime.strptime(k_, "%Y-%m").strftime("%b %Y")
                                                    for k_ in per_m],
                                         "series": [{"name": num_label, "values": [round(v, 2) for v in per_m.values()]}]}))
        # the exact data found
        far = any(s_ in ("page", "document") for rc in recs for s_ in rc["src"].values())
        headers = (["Found"] if len(terms) > 1 else []) + ["File", "Page"] + [l for l, _k in fields] + \
            (["Row / line"] if not per_doc else []) + (["Taken from"] if far else [])
        rows_t, colors = [], []
        for rc in recs:
            r = ([rc["found"]] if len(terms) > 1 else []) + [rc["file"], rc["page"]] + \
                [rc["vals"][l] for l, _k in fields] + ([rc["line"]] if not per_doc else [])
            if far:
                r.append(", ".join(sorted({f"{l}: the {s_}" for l, s_ in rc["src"].items() if s_ in ("page", "document")}))
                         or ("the row" if any(rc["vals"].values()) else ""))
            rows_t.append(r)
            colors.append(STATUS_COL["warning"] if any(not v for v in rc["vals"].values()) and fields else None)
        widths = ([12] if len(terms) > 1 else []) + [22, 5] + [14] * len(fields) + ([40] if not per_doc else []) + \
            ([18] if far else [])
        blocks.append(("h", "What was found"))
        blocks.append(("table", {"name": "Results", "headers": headers, "rows": rows_t, "colors": colors,
                                 "widths": widths}))
        if far:
            blocks.append(("p", "Values that are not on the same row were taken from the same page, or from the top of "
                                "the document (where an invoice number or a date usually is) - see 'Taken from'."))
        qtxt = " ".join((P.get("question") or "").split())
        title = ", ".join(terms[:3]) or ", ".join(t.split(" /")[0] + "s" for t in a["types"]) or ""
        full = (title + (" - " + ", ".join(l for l, _k in fields[:4]) if fields else "")) if title else \
            (qtxt[:1].upper() + qtxt[1:70] if qtxt else "Your question")
        return {"title": full,
                "subtitle": self._subtitle(P["scope"], f"{len(recs)} results"), "blocks": blocks,
                "_name": "Asked - " + (title or qtxt)[:40]}

    # ---- Document overview -----------------------------------------------------------------------------------
    def _job_overview(self, P, job):
        """How many documents, of which kinds, how many pages, from when, how big, by whom - with charts."""
        import datetime

        def human(n):
            for u in ("bytes", "KB", "MB", "GB"):
                if n < 1024 or u == "GB":
                    return f"{n:.0f} {u}" if u == "bytes" else f"{n:.1f} {u}"
                n /= 1024.0
        rows, kinds, exts, authors, months, folders = [], {}, {}, {}, {}, {}
        size_tot = pages_tot = 0
        dmin = dmax = None
        today = datetime.date.today()
        for k, (folder, rel, path) in enumerate(P["files"]):
            if job["cancel"]:
                return None
            job["progress"] = f"Reading {k + 1} of {len(P['files'])}  ·  Esc to stop"
            try:
                st = os.stat(path)
            except OSError:
                continue
            name = f"{P['labels'].get(folder, folder)} / {rel}" if P["lib"] else rel
            try:
                texts = self._page_texts(path)
            except Exception:
                texts = []
            kind = doc_type("\n".join(texts))
            ext = (os.path.splitext(path)[1].lower().lstrip(".") or "?").upper()
            author = created = ""
            if ext == "PDF":
                try:
                    d_ = open_light(self.fitz, path)
                    md = d_.metadata or {}
                    d_.close()
                    author = (md.get("author") or "").strip()
                    m_ = re.search(r"(\d{4})(\d{2})(\d{2})", md.get("creationDate") or "")
                    if m_:
                        created = datetime.date(int(m_.group(1)), int(m_.group(2)), int(m_.group(3)))
                except Exception:
                    pass
            mod = datetime.date.fromtimestamp(st.st_mtime)
            when = created or mod
            months[(when.year, when.month)] = months.get((when.year, when.month), 0) + 1
            for t in texts[:40]:
                for d2 in parse_dates(t):
                    if abs((d2 - today).days) <= 20 * 366:
                        dmin = d2 if dmin is None or d2 < dmin else dmin
                        dmax = d2 if dmax is None or d2 > dmax else dmax
            kinds[kind] = kinds.get(kind, 0) + 1
            exts[ext] = exts.get(ext, 0) + 1
            if author:
                authors[author] = authors.get(author, 0) + 1
            top = rel.split("/")[0] if "/" in rel else "(top of the book)"
            folders[top] = folders.get(top, 0) + 1
            size_tot += st.st_size
            pages_tot += len(texts)
            rows.append([name, ext, kind, len(texts), human(st.st_size),
                         created.strftime("%d/%m/%Y") if created else "", mod.strftime("%d/%m/%Y"), author, st.st_size])
        if not rows:
            return "No files here."
        blocks = [("kpis", [self._kp("Documents", len(rows)), self._kp("Pages", pages_tot),
                            self._kp("Size", human(size_tot)), self._kp("Kinds", len(kinds)),
                            self._kp("Authors", len(authors)),
                            self._kp("Dates inside", f"{dmin.strftime('%b %Y')} - {dmax.strftime('%b %Y')}"
                                     if dmin else "-")])]
        blocks.append(("chart", {"type": "donut", "title": "Kinds of documents", "labels": list(kinds),
                                 "series": [{"values": list(kinds.values())}], "center": "documents",
                                 "link": {"table": "Documents", "col": "Kind"}}))
        blocks.append(("chart", {"type": "bar", "title": "File types", "labels": list(exts),
                                 "series": [{"name": "Documents", "values": list(exts.values())}],
                                 "link": {"table": "Documents", "col": "Type"}}))
        keys = sorted(months)[-18:]
        if keys:
            blocks.append(("chart", {"type": "col", "title": "Documents per month (made or changed)",
                                     "labels": [datetime.date(y, m, 1).strftime("%b %y") for y, m in keys],
                                     "series": [{"name": "Documents", "values": [months[k_] for k_ in keys]}]}))
        if len(folders) > 1:
            fl = sorted(folders.items(), key=lambda kv: -kv[1])[:14]
            blocks.append(("chart", {"type": "bar", "title": "Documents per folder (category)",
                                     "labels": [f for f, _c in fl], "series": [{"name": "Documents",
                                                                               "values": [c for _f, c in fl]}]}))
        if authors:
            au = sorted(authors.items(), key=lambda kv: -kv[1])[:12]
            blocks.append(("chart", {"type": "bar", "title": "Authors", "labels": [x for x, _c in au],
                                     "series": [{"name": "Documents", "values": [c for _x, c in au]}],
                                     "link": {"table": "Documents", "col": "Author"}}))
        big = sorted(rows, key=lambda r: -r[8])[:10]
        blocks.append(("chart", {"type": "bar", "title": "Biggest documents (MB)",
                                 "labels": [self._short(r[0]) for r in big],
                                 "series": [{"name": "MB", "values": [round(r[8] / 1048576, 2) for r in big]}],
                                 "link": {"table": "Documents", "col": "File"}}))
        blocks.append(("h", "Documents"))
        blocks.append(("table", {"name": "Documents", "headers": ["File", "Type", "Kind", "Pages", "Size", "Created",
                                                                 "Changed", "Author"],
                                 "rows": [r[:8] for r in rows], "widths": [36, 6, 16, 6, 9, 10, 10, 14]}))
        return {"title": f"Document overview - {P['title']}", "subtitle": self._subtitle(P["scope"]),
                "blocks": blocks, "_name": "Overview - " + P["title"]}

    # ---- Extract data ----------------------------------------------------------------------------------------
    XKINDS = ["Names", "Dates", "Amounts", "Numbers", "IDs & codes", "Addresses", "Emails", "Phones"]

    def _job_extract2(self, P, job):
        """Names, dates, amounts, numbers, IDs and codes, addresses, emails, phones - from every document, each with
        its person, document, page and line."""
        want = [k for k in self.XKINDS if k in (P.get("xkinds") or self.XKINDS)]
        lab_num = re.compile(r"([A-Za-zÁÉÍÓÚáéíóúñ][\w /'’-]{1,28}?)\s*[:=]\s*(\d+(?:[.,]\d+)?)\b(?!\s*[/.-]\d)")
        res = OrderedDict((k, []) for k in want)
        seen = set()

        def add(kind, value, name, page, row, rows, i):
            key = (kind, value.lower(), name, page)
            if key in seen:
                return
            seen.add(key)
            who = "" if kind == "Names" else (link_value(rows, i, 0, None, value)[0] or "")
            res[kind].append([value, who, name, page, row["text"]])
        for name, folder, rel, page, rows, doc, pi in self._walk_pages(P, job, None):
            for i, row in enumerate(rows):
                text = row["text"]
                if "Names" in res:
                    for m_ in NAME_IN_TEXT.finditer(text):
                        p_ = person_like(m_.group(0))
                        if p_ and len(p_.split()) >= 2 and p_.split()[0].lower() not in (
                                "dear", "hi", "hello", "yours", "kind", "best", "thank", "thanks", "regards", "estimado",
                                "estimada", "hola"):
                            add("Names", p_, name, page, row, rows, i)
                for kind, pat in (("Dates", "Dates"), ("Amounts", "Amounts"), ("Addresses", "Addresses"),
                                  ("Emails", "Emails"), ("Phones", "Phone numbers")):
                    if kind in res:
                        for v in find_values(pat, text):
                            add(kind, v, name, page, row, rows, i)
                if "IDs & codes" in res:
                    for rx, lab in ((INVOICE_NO_RE, "Invoice "), (REF_NO_RE, "Ref ")):
                        for m_ in rx.finditer(text):
                            add("IDs & codes", lab + m_.group(1), name, page, row, rows, i)
                    for lab, key in (("PPS ", "PPS number"), ("IBAN ", "IBAN / bank account")):
                        for m_ in PII_PATTERNS[key].finditer(text):
                            add("IDs & codes", lab + m_.group(0), name, page, row, rows, i)
                    for v in find_values("Eircodes / postcodes", text):
                        add("IDs & codes", "Eircode " + v, name, page, row, rows, i)
                if "Numbers" in res:
                    if row.get("table") and row.get("header"):
                        for h, c in zip(row["header"], row["cells"]):
                            c = (c or "").strip()
                            if re.fullmatch(r"\d+(?:[.,]\d+)?", c) and h and not h.startswith("Column"):
                                add("Numbers", f"{h}: {c}", name, page, row, rows, i)
                    else:
                        for m_ in lab_num.finditer(text):
                            if re.match(r"\s?\d", text[m_.end():m_.end() + 2]) or re.search(
                                    r"phone|mobile|tel|pps|iban|date|eircode|account", m_.group(1), re.I):
                                continue                      # part of a phone, a date, an ID…
                            add("Numbers", f"{m_.group(1).strip()}: {m_.group(2)}", name, page, row, rows, i)
        if job["cancel"]:
            return None
        total = sum(len(v) for v in res.values())
        if not total:
            return "Nothing of that kind was found here."
        blocks = [("kpis", [self._kp(k, len(v)) for k, v in res.items()][:8]),
                  ("chart", {"type": "bar", "title": "What was found", "labels": [k for k, v in res.items() if v],
                             "series": [{"name": "Found", "values": [len(v) for v in res.values() if v]}]})]
        for k, items in res.items():
            if not items:
                continue
            hdr = [k[:-1] if k.endswith("s") and k != "IDs & codes" else "ID / code", "Person", "File", "Page",
                   "Row / line"]
            if k == "Names":
                hdr[1] = "With"
            rows_ = items
            tot = None
            if k == "Amounts":
                nums = [n for n in (parse_number(it[0]) for it in items) if n is not None]
                if nums:
                    sym = next((c for c in "€$£" if any(c in it[0] for it in items)), "")
                    tot = [f"Total {sym}{sum(nums):,.2f}", "", "", "", ""]
            blocks.append(("h", f"{k}  ·  {len(items)}"))
            blocks.append(("table", {"name": k[:28], "headers": hdr, "rows": rows_ + ([tot] if tot else []),
                                     "total_row": bool(tot), "widths": [24, 18, 22, 5, 40]}))
        return {"title": "Extracted data", "subtitle": self._subtitle(P["scope"], f"{total} values"),
                "blocks": blocks, "_name": "Data - " + P["title"]}

    # ---- 1.9: one kind of data, with only the columns you tick -------------------------------------------------
    PICK_KINDS = OrderedDict([
        ("Emails", ("Email", "Every email address")),
        ("Names", ("Name", "Every person named in your documents")),
        ("Phones", ("Phone", "Every phone and mobile number")),
        ("Addresses", ("Address", "Street addresses, Eircodes and postcodes")),
        ("Dates", ("Date", "Every date")),
        ("Amounts", ("Amount", "€, $, £ and other amounts")),
        ("IDs", ("ID / code", "Invoice, order and reference numbers, PPS, IBAN")),
        ("Companies", ("Organisation", "Companies, organisations, councils, banks…")),
        ("Links", ("Link", "Websites and links")),
        ("Times", ("Time", "Times like 9:30 or 2 pm")),
    ])
    PICK_SHOW = [("Person", "The person it belongs to"), ("How sure", "How the person was found, and how sure"),
                 ("Organisation", "The organisation"), ("Document", "The document"), ("Page", "The page"),
                 ("Line", "The whole line"), ("Times", "How many times")]
    PICK_QUICK = {"Emails": r"@", "Phones": r"\d{3}", "Dates": r"\d", "Amounts": r"[€$£]|eur|usd|gbp|euro",
                  "Links": r"https?://|www\.", "Times": r"\d[:.]\d\d|\d\s?[ap]m", "IDs": r"\d{3}",
                  "Addresses": r"\d|[A-Z]\d{2}"}
    _GREET = {"dear", "hi", "hello", "yours", "kind", "best", "thank", "thanks", "regards", "estimado", "estimada",
              "hola", "many", "warm"}

    def _pick_values(self, kind, text):
        """The values of one kind in a line or row of text."""
        if kind in ("Emails", "Dates", "Amounts", "Links", "Times", "Addresses"):
            return find_values(kind, text)
        if kind == "Phones":
            return find_values("Phone numbers", text)
        out = []
        if kind == "Names":
            for line in text.replace(" | ", "\n").split("\n"):
                lp = _label_person(line)
                if lp and lp not in out:
                    out.append(lp)
                for m_ in NAME_IN_TEXT.finditer(line):
                    p_ = person_like(m_.group(0))
                    if p_ and len(p_.split()) >= 2 and p_.split()[0].lower() not in self._GREET and p_ not in out:
                        out.append(p_)
        elif kind == "Companies":
            for m_ in self.ORG_RE.finditer(text):
                o = " ".join(m_.group(1).split())
                if len(o) > 3 and len(o.split()) >= 2 and o not in out:
                    out.append(o)
        elif kind == "IDs":
            for rx, lab in ((INVOICE_NO_RE, "Invoice "), (REF_NO_RE, "Ref ")):
                for m_ in rx.finditer(text):
                    v = lab + m_.group(1)
                    if v not in out:
                        out.append(v)
            for lab, key in (("PPS ", "PPS number"), ("IBAN ", "IBAN / bank account")):
                for m_ in PII_PATTERNS[key].finditer(text):
                    v = lab + " ".join(m_.group(0).split())
                    if v not in out:
                        out.append(v)
        return out

    def _job_pick(self, P, job):
        """Emails, names, phones… from every document: the value, and only the columns you ticked (the person it
        belongs to, the organisation, the document, the page, the whole line, how many times). 1.9.2: also from
        form boxes and fields (their labels say what they are), and from scanned pages (read by OCR)."""
        import datetime
        kind = P.get("pick") or "Emails"
        head = self.PICK_KINDS.get(kind, (kind, ""))[0]
        want = set(P.get("show") or [])
        if "Person" in want and kind in ("Emails", "Phones"):
            want.add("How sure")             # 4.0: a person always comes with how it was found
        show = [s for s, _l in self.PICK_SHOW if s in want and not (s in ("Person", "How sure") and kind == "Names")
                and not (s == "Organisation" and kind == "Companies") and not (s == "How sure" and "Person" not in want)]
        once = P.get("once", True)
        only = [x.strip().lower() for x in re.split(r"[,;]+", P.get("pick_only") or "") if x.strip()]
        need_person = bool(P.get("need_person")) and "Person" in show
        rx = re.compile(self.PICK_QUICK[kind], re.I) if kind in self.PICK_QUICK else None
        pf = (lambda tx: bool(rx.search(tx)) or bool(re.search(r"e-?mail|phone|mobile|tel|name", tx, re.I))) \
            if rx else None
        pk = {"Emails": "email", "Phones": "phone", "Names": "name", "Companies": "org"}.get(kind)
        found = []                   # [value, person, organisation, document, page, line, how]
        seen = set()
        n_pairs = 0

        def add(v, who, org, name, page, line, how=""):
            k_ = (v.lower(), name, page, line[:60])
            if k_ in seen:
                return
            seen.add(k_)
            found.append([v, who or "", org or "", name, page, line, sure_text(how) if who else ""])

        def take(name, page, rows, pg, words=None, tag=""):
            """The values of one page (its rows, and its form boxes / fields)."""
            nonlocal n_pairs
            pairs = []
            joined = " ".join(r["text"] for r in rows)
            if pg is not None and (re.search(r"e-?mail|phone|mobile|tel\b|name|:", joined, re.I) or words is not None):
                try:
                    pairs = form_pairs(self.fitz, pg, words)
                except Exception:
                    pairs = []
            names_here = [(p_[2].y0, " ".join(p_[1].split())) for p_ in pairs
                          if pair_kind(p_[0]) == "name" and pair_value_ok("name", p_[1])]
            orgs_here = [p_[1] for p_ in pairs if pair_kind(p_[0]) == "org" and p_[1].strip()]

            def who_near(y):
                best = ""
                for y0, nm in sorted(names_here):
                    if y0 <= (y or 0) + 4:
                        best = nm
                return best or (names_here[0][1] if names_here else "")
            got = set()
            for i, row in enumerate(rows):
                vals = self._pick_values(kind, row["text"])
                if not vals:
                    continue
                org = (organisation(row) or (orgs_here[0] if orgs_here else "")) if "Organisation" in show else ""
                line = " ".join(row["text"].split())[:300] + tag
                for v in vals:
                    who = how = ""
                    if "Person" in show:
                        j = next((jj for jj, c in enumerate(row["cells"]) if v in (c or "")), 0) \
                            if row.get("table") else 0
                        try:
                            who, how = link_value(rows, i, j, None, v)
                        except Exception:
                            who = how = ""
                        office = "@" in v and bool(GENERIC_MAILBOX.match(re.sub(r"[._-]|\d", "", v.split("@")[0])))
                        if not who and names_here and not office:
                            who, how = who_near(row.get("y")), "nearby (form)"
                    got.add(re.sub(r"\W", "", v.lower()))
                    add(v, who, org, name, page, line, how)
            # values in boxes / fields that the patterns missed (the label says what they are)
            if pk:
                for lab, val, rect in pairs:
                    if pair_kind(lab) != pk or not pair_value_ok(pk, val):
                        continue
                    v = " ".join(val.split())
                    if pk == "name":
                        v = person_like(v) or v
                    if re.sub(r"\W", "", v.lower()) in got:
                        continue
                    got.add(re.sub(r"\W", "", v.lower()))
                    n_pairs += 1
                    who = who_near(rect.y0) if "Person" in show and pk != "name" else ""
                    org = (orgs_here[0] if orgs_here else "") if "Organisation" in show else ""
                    add(v, who, org, name, page, f"{lab}: {v}{tag}", "form label")
        if any(s in show for s in ("Person", "Organisation", "Line")) or pk:
            # the rows of each page (table rows stay whole): the person and the organisation can be linked
            for name, folder, rel, page, rows, doc, pi in self._walk_pages(P, job, pf):
                try:
                    pg = doc.load_page(pi)
                except Exception:
                    pg = None
                take(name, page, rows, pg)
        else:
            # only the values (and where they are): straight from the search index - very quick
            for name, folder, rel, path, texts in self._texts(P, job):
                for pi, t in enumerate(texts):
                    if pf and not pf(t):
                        continue
                    for line in t.split("\n"):
                        for v in self._pick_values(kind, line):
                            add(v, "", "", name, pi + 1, " ".join(line.split())[:300])
        # scanned pages (pictures without text): read them by OCR when you asked for it
        scanned = []
        for k, (folder, rel, path) in enumerate(P["files"]):
            if job["cancel"]:
                return None
            try:
                texts = self._page_texts(path)
            except Exception:
                continue
            if not is_pdf(path) and not re.search(r"\.(png|jpe?g|tiff?|bmp)$", path, re.I):
                continue
            for pi, t in enumerate(texts):
                if len((t or "").strip()) < 25:
                    scanned.append((folder, rel, path, pi))
        n_ocr = 0
        td = P.get("ocr_td")
        if scanned and td:
            import hashlib
            last = None
            doc = None
            try:
                for k, (folder, rel, path, pi) in enumerate(scanned):
                    if job["cancel"]:
                        return None
                    job["progress"] = f"Reading scanned page {k + 1} of {len(scanned)}  ·  Esc to stop"
                    if path != last:
                        if doc is not None:
                            doc.close()
                        try:
                            doc = self._doc_bytes_open(path)
                        except Exception:
                            doc, last = None, path
                            continue
                        last = path
                    if doc is None:
                        continue
                    try:
                        pg = doc.load_page(pi)
                        # 3.2: the same memory as the scanned pages read in the background (one reading per page)
                        cache = os.path.join(ocr_dir(), scan_key(path, pg) + ".json.gz")
                        os.makedirs(ocr_dir(), exist_ok=True)
                        words = ocr_page_words(self.fitz, pg, td, cache)
                        rows = page_rows(self.fitz, pg, {}, words_in=words)
                    except Exception:
                        continue
                    n_ocr += 1
                    name = f"{P['labels'].get(folder, folder)} / {rel}" if P["lib"] else rel
                    take(name, pi + 1, rows, pg, words, tag="  (scanned)")
            finally:
                if doc is not None:
                    doc.close()
        if only:
            found = [r for r in found if any(o in " ".join(str(x) for x in r).lower() for o in only)]
        if need_person:
            found = [r for r in found if r[1]]
        if job["cancel"]:
            return None
        note = []
        if scanned and not td:
            note.append(("alert", {"tone": "warning", "text": f"{len(scanned)} scanned page"
                                   f"{'s' if len(scanned) != 1 else ''} (pictures without text) were not read - "
                                   "tick “Read scanned pages too” to include them."}))
        if n_ocr:
            note.append(("alert", {"tone": "info", "text": f"{n_ocr} scanned page{'s' if n_ocr != 1 else ''} read "
                                   "by OCR - check what came from them (marked “scanned”): handwriting is hard to read."}))
        if n_pairs:
            note.append(("alert", {"tone": "info", "text": f"{n_pairs} found in form boxes and fields by their label "
                                   "(Name, Email, Phone…)."}))
        if not found:
            return f"No {kind.lower()} were found here." + (
                f"  ({len(scanned)} scanned pages were not read - tick “Read scanned pages too”.)"
                if scanned and not td else "")
        n_all = len(found)
        docs = {r[3] for r in found}
        norm = (lambda v: re.sub(r"\D", "", v)) if kind == "Phones" else (lambda v: " ".join(v.lower().split()))
        if once:
            merged = OrderedDict()
            for r in found:
                m = merged.get(norm(r[0]))
                if m is None:
                    merged[norm(r[0])] = [list(r), 1, [r[3]]]
                    continue
                m[1] += 1
                if r[3] not in m[2]:
                    m[2].append(r[3])
                for j in (1, 2):
                    if not m[0][j] and r[j]:
                        m[0][j] = r[j]
                        if j == 1:
                            m[0][6] = r[6]
                if r[1] and m[0][1] and r[6] and m[0][6] and \
                        int(r[6].split("%")[0] or 0) > int(m[0][6].split("%")[0] or 0):
                    m[0][1], m[0][6] = r[1], r[6]           # the surer link wins
            items = []
            for r, cnt, dl in merged.values():
                if len(dl) > 1:
                    r[3] = f"{dl[0]}  (+{len(dl) - 1} more)"
                items.append((r, cnt))
        else:
            cnt_of = {}
            for r in found:
                cnt_of[norm(r[0])] = cnt_of.get(norm(r[0]), 0) + 1
            items = [(r, cnt_of[norm(r[0])]) for r in found]
        if kind == "Dates":
            def dkey(it):
                ds = parse_dates(it[0][0])
                return ds[0] if ds else datetime.date(9999, 1, 1)
            items.sort(key=dkey)
        elif kind in ("Names", "Emails", "Companies", "Links") and once:
            items.sort(key=lambda it: it[0][0].lower())
        headers = [head] + [s if s != "Times" else "Times" for s in show]
        pos = {"Person": 1, "Organisation": 2, "Document": 3, "Page": 4, "Line": 5, "How sure": 6}
        rows = []
        for r, cnt in items:
            rows.append([r[0]] + [(cnt if s == "Times" else r[pos[s]]) for s in show])
        widths = [26] + [{"Person": 20, "Organisation": 20, "Document": 26, "Page": 6, "Line": 46, "Times": 8,
                          "How sure": 22}[s] for s in show]
        blocks = [("kpis", [self._kp(kind if once else "Found", len(rows))] +
                   ([self._kp("Times found", n_all)] if once and n_all != len(rows) else []) +
                   [self._kp("Documents", len(docs))] +
                   ([self._kp("Scanned pages read", n_ocr)] if n_ocr else []))] + note
        tot = None
        if kind == "Amounts":
            # 3.0: every amount found counts (ten €50 invoices are €500, not €50 once), per document the lines
            # OR its total (never line items + subtotal + VAT + total together), one total per currency
            tot_line = re.compile(r"\b(?:sub-?total|total|vat|tax|balance|amount due|to pay)\b", re.I)
            per_doc = OrderedDict()
            for r in found:
                n_ = parse_number(r[0])
                if n_ is None:
                    continue
                sym = next((c for c in "€$£" if c in r[0]), "") or ("€" if re.search(r"eur", r[0], re.I) else "")
                line = str(r[5]) if len(r) > 5 else ""
                dd = per_doc.setdefault((r[3], sym), {"items": [], "totals": []})
                (dd["totals"] if tot_line.search(line) else dd["items"]).append(n_)
            by_sym = OrderedDict()
            for (_doc, sym), dd in per_doc.items():
                by_sym[sym] = by_sym.get(sym, 0.0) + (sum(dd["items"]) if dd["items"] else max(dd["totals"]))
            if by_sym:
                tot = ["Total " + "  +  ".join(f"{sym}{v:,.2f}" for sym, v in by_sym.items())] + [""] * len(show)
        if kind == "Dates":
            per_m = OrderedDict()
            today = datetime.date.today()
            for r, _c in items:
                for d in parse_dates(r[0])[:1]:
                    if abs((d - today).days) <= 5 * 366:
                        per_m[d.strftime("%b %y")] = per_m.get(d.strftime("%b %y"), 0) + 1
            if len(per_m) > 1:
                ks = list(per_m)[-18:]
                blocks.append(("chart", {"type": "col", "title": "Dates per month", "labels": ks,
                                         "series": [{"name": "Dates", "values": [per_m[k_] for k_ in ks]}]}))
        elif kind in ("Names", "Companies") and once and len(items) > 2:
            top = sorted(items, key=lambda it: -it[1])[:10]
            if top[0][1] > 1:
                blocks.append(("chart", {"type": "bar", "title": "Named most", "labels": [r[0] for r, _c in top],
                                         "series": [{"name": "Times", "values": [c for _r, c in top]}]}))
        blocks.append(("table", {"name": kind[:28], "headers": headers, "rows": rows + ([tot] if tot else []),
                                 "total_row": bool(tot), "widths": widths}))
        return {"title": kind, "subtitle": self._subtitle(P["scope"], f"{len(rows)} {kind.lower()}"),
                "blocks": blocks, "_name": f"{kind} - {P['title']}", "_view": "table"}

    # ---- 4.1: Invoices & money - one row per invoice or receipt, the real totals (never line + VAT + total) --------
    _INV_TOTAL = re.compile(r"\b(?:grand\s+total|total\s+(?:due|to\s+pay|amount|payable|incl\w*|eur|€)|amount\s+"
                            r"(?:due|payable|to\s+pay)|balance\s+(?:due|owing)|total|importe\s+total|a\s+pagar)\b",
                            re.I)
    _INV_SUB = re.compile(r"\b(?:sub-?\s?total|net|excl\w*|before\s+vat)\b", re.I)
    _INV_VAT = re.compile(r"\b(?:vat|tax|iva|gst)\b", re.I)
    _INV_DUE = re.compile(r"\b(?:due(?:\s+date)?|pay(?:ment)?\s+(?:by|due|before)|payable\s+by|vencimiento)\b", re.I)
    _INV_DATE = re.compile(r"\b(?:invoice\s+date|date\s+of\s+issue|issued?|tax\s+point|date|fecha)\b", re.I)
    _INV_FROM = re.compile(r"^\s*(?:from|supplier|seller|vendor|company|billed\s+by|proveedor)\s*[:\-]\s*(.{3,60})$",
                           re.I)

    def _invoice_of(self, text, name):
        """What one document says as an invoice: supplier, number, date, due date, total, VAT, currency (or None)."""
        import datetime
        t = text or ""
        low = t.lower()
        if not re.search(r"\b(invoice|receipt|bill|total|amount due|factura|recibo)\b", low):
            return None
        lines = [" ".join(ln.split()) for ln in t.split("\n") if ln.strip()]
        amts = []                                   # (value, line index, currency, line)
        for i, ln in enumerate(lines):
            for v in find_values("Amounts", ln):
                n_ = parse_number(v)
                if n_ is not None and 0 < n_ < 1e8:
                    sym = next((c for c in "€$£" if c in v), "") or ("€" if re.search(r"eur", v, re.I) else "")
                    amts.append((n_, i, sym, ln))
            if not any(a[1] == i for a in amts):    # amounts written without a currency sign on a total line
                if self._INV_TOTAL.search(ln) or self._INV_VAT.search(ln):
                    for m_ in re.finditer(r"(?<![\d.,])\d{1,3}(?:[,.]\d{3})*[.,]\d{2}(?![\d])", ln):
                        n_ = parse_number(m_.group(0))
                        if n_ is not None:
                            amts.append((n_, i, "", ln))
        if not amts:
            return None
        total = vat = None
        for n_, i, sym, ln in amts:                  # the last 'total' line wins (after subtotal and VAT)
            if self._INV_TOTAL.search(ln) and not self._INV_SUB.search(ln) and not self._INV_VAT.search(ln):
                total = (n_, sym)
            elif self._INV_VAT.search(ln) and not self._INV_TOTAL.search(ln):
                vat = n_
        if total is None:
            for i, ln in enumerate(lines):          # 'Total' on its own line, the amount on the next
                if re.fullmatch(r"(?i)(?:grand\s+)?total(?:\s+due)?\s*:?", ln):
                    nxt = [a for a in amts if a[1] in (i + 1, i + 2)]
                    if nxt:
                        total = (nxt[0][0], nxt[0][2])
        if total is None:
            big = max(amts, key=lambda a: a[0])
            total = (big[0], big[2])
        cur = total[1] or next((a[2] for a in amts if a[2]), "")
        num = ""
        m_ = INVOICE_NO_RE.search(t)
        if m_:
            num = m_.group(1)
        sup = ""
        for ln in lines[:40]:
            m2 = self._INV_FROM.match(ln)
            if m2:
                sup = m2.group(1).strip()
                break
        if not sup:
            for ln in lines[:25]:
                m3 = self.ORG_RE.search(ln)
                if m3 and not re.search(r"(?i)bill\s+to|deliver\s+to|ship\s+to|customer", ln):
                    sup = " ".join(m3.group(1).split())
                    break
        if not sup and lines:
            first = lines[0]
            if not re.search(r"(?i)^(invoice|receipt|tax invoice|bill)\b", first) and len(first) < 50:
                sup = first
        date = due = None
        for ln in lines[:60]:
            ds = [d_ for d_ in parse_dates(ln) if 1990 < d_.year < 2100]
            if not ds:
                continue
            if due is None and self._INV_DUE.search(ln):
                due = ds[-1]
            elif date is None and self._INV_DATE.search(ln):
                date = ds[0]
        if date is None:
            for ln in lines[:30]:
                ds = [d_ for d_ in parse_dates(ln) if 1990 < d_.year < 2100]
                if ds and not self._INV_DUE.search(ln):
                    date = ds[0]
                    break
        _ = datetime
        return {"supplier": sup, "number": num, "date": date, "due": due, "total": total[0], "vat": vat,
                "cur": cur, "file": name}

    def _job_invoices(self, P, job):
        """Invoices & money: one row per invoice / receipt - who it is from, its number, date, due date and total
        (the document's own total, never its lines and its total added together) - with totals per month and per
        supplier, and what is overdue first."""
        import datetime
        import calendar as _cal
        today = datetime.date.today()
        stat = P.get("status") or {}
        inv = []
        for name, folder, rel, path, texts in self._texts(P, job):
            joined = "\n".join(texts)
            it = self._invoice_of(joined, name)
            if it:
                it["path"] = path
                it["status"] = stat.get(path) or ""
                # a total in a document with several invoices: one per page that has its own total
                inv.append(it)
        if job["cancel"]:
            return None
        if not inv:
            return ("No invoices or receipts were found here (a document needs an amount and a word like "
                    "Invoice, Receipt or Total).")
        curs = Counter(i["cur"] for i in inv if i["cur"])
        unit = curs.most_common(1)[0][0] if curs else ""
        fm = lambda v: _fmt_money(v, unit) if v is not None else ""
        tot = sum(i["total"] for i in inv)
        overdue = [i for i in inv if i["due"] and i["due"] < today and "paid" not in i["status"].lower()]
        soon = [i for i in inv if i["due"] and 0 <= (i["due"] - today).days <= 14 and "paid" not in
                i["status"].lower()]
        this_m = sum(i["total"] for i in inv if i["date"] and (i["date"].year, i["date"].month) ==
                     (today.year, today.month))
        blocks = [("kpis", [self._kp("Invoices & receipts", len(inv)), self._kp("Total", fm(tot)),
                            self._kp("This month", fm(this_m)),
                            self._kp("Overdue", len(overdue), "critical" if overdue else None)])]
        if overdue or soon:
            blocks.append(("h", "Needs attention"))
            for i in sorted(overdue, key=lambda i: i["due"]):
                blocks.append(("li", f"{i['supplier'] or self._short(i['file'], 40)}"
                                     f"{(' · ' + i['number']) if i['number'] else ''}: {fm(i['total'])} was due "
                                     f"{i['due'].strftime('%d %b %Y')} - {(today - i['due']).days} days ago."))
            for i in sorted(soon, key=lambda i: i["due"]):
                blocks.append(("li", f"{i['supplier'] or self._short(i['file'], 40)}"
                                     f"{(' · ' + i['number']) if i['number'] else ''}: {fm(i['total'])} due "
                                     f"{i['due'].strftime('%d %b %Y')}."))
        if len(curs) > 1:
            blocks.append(("alert", {"tone": "info", "text": "Several currencies: " + ", ".join(
                f"{c} ({n} documents)" for c, n in curs.items()) + " - totals are not converted."}))
        last12 = []
        for k in range(11, -1, -1):
            y, m = divmod(today.month - 1 - k, 12)
            last12.append((today.year + y, m + 1))
        per = {k: 0.0 for k in last12}
        for i in inv:
            if i["date"] and (i["date"].year, i["date"].month) in per:
                per[(i["date"].year, i["date"].month)] += i["total"]
        if sum(1 for v in per.values() if v) >= 2:
            blocks.append(("chart", {"type": "col", "title": "Per month", "unit": unit, "partial_last": True,
                                     "labels": [f"{_cal.month_abbr[m]} {str(y)[2:]}" for y, m in last12],
                                     "series": [{"name": "Total", "values": [round(per[k], 2) for k in last12]}]}))
        sup = {}
        for i in inv:
            k_ = i["supplier"] or "Not named"
            sup[k_] = sup.get(k_, 0) + i["total"]
        if len(sup) >= 2:
            items = sorted(sup.items(), key=lambda kv: -kv[1])
            top3 = sum(v for _k, v in items[:3])
            blocks.append(("chart", {"type": "bar", "title": "Per supplier", "unit": unit,
                                     "labels": [k_ for k_, _v in items], "series": [{"name": "Total",
                                                                                   "values": [v for _k, v in items]}],
                                     "finding": f"{items[0][0]} is the largest: {fm(items[0][1])}" +
                                                (f" - the top 3 make {100 * top3 / (tot or 1):.0f}% of the total."
                                                 if len(items) > 3 else ".")}))
        rows = []
        for i in sorted(inv, key=lambda i: (i["date"] or datetime.date(1900, 1, 1)), reverse=True):
            st_ = i["status"] or ("Overdue" if i in overdue else "")
            rows.append([i["supplier"], i["number"], i["date"].strftime("%d/%m/%Y") if i["date"] else "",
                         i["due"].strftime("%d/%m/%Y") if i["due"] else "", fm(i["total"]),
                         fm(i["vat"]) if i["vat"] else "", st_, i["file"]])
        blocks.append(("h", "Every invoice and receipt"))
        blocks.append(("table", {"name": "Invoices", "headers": ["From", "Number", "Date", "Due", "Total", "VAT",
                                                                 "Status", "Document"],
                                 "rows": rows + [["Total", "", "", "", fm(tot), "", "", ""]], "total_row": True,
                                 "widths": [22, 12, 11, 11, 12, 10, 10, 30]}))
        blocks.append(("p", "How it was read: each document's own total (the line that says Total, Amount due, "
                            "Balance due…, after the subtotal and VAT) - or its largest amount when it says none. "
                            "Set a document's status to Paid (right-click it) and it no longer counts as overdue."))
        return {"title": "Invoices & money", "subtitle": self._subtitle(P["scope"], f"{len(inv)} documents"),
                "blocks": blocks, "_name": "Invoices - " + P["title"]}

    def _job_wordcount(self, P, job):
        """Words, pages, sentences and reading time of each document - and the words used most."""
        rows, cnt = [], {}
        tw = tp = ts = 0
        for name, folder, rel, path, texts in self._texts(P, job):
            joined = "\n".join(texts)
            wc = len(re.findall(r"[0-9A-Za-zÀ-ÿ][\w'’-]*", joined))
            sc = len(sentences_of(joined[:300000])) if wc else 0
            mins = wc / 200.0
            rows.append([name, len(texts), wc, sc, round(wc / sc, 1) if sc else "",
                         "under 1 min" if mins < 1 else (f"{mins:.0f} min" if mins < 90 else f"{mins / 60:.1f} h")])
            tw, tp, ts = tw + wc, tp + len(texts), ts + sc
            for w in words_of(joined[:300000]):
                cnt[w] = cnt.get(w, 0) + 1
        if job["cancel"]:
            return None
        if not rows:
            return "No files here."
        mins = tw / 200.0
        rt = "under 1 min" if mins < 1 else (f"{mins:.0f} min" if mins < 90 else f"{mins / 60:.1f} hours")
        blocks = [("kpis", [self._kp("Documents", len(rows)), self._kp("Pages", tp), self._kp("Words", tw),
                            self._kp("Reading time", rt)])]
        big = sorted(rows, key=lambda r: -r[2])
        if len(rows) > 1:
            b15 = big[:15]
            blocks.append(("chart", {"type": "bar", "title": "Words per document",
                                     "labels": [self._short(r[0], 34) for r in b15],
                                     "series": [{"name": "Words", "values": [r[2] for r in b15]}]}))
        top = sorted(cnt.items(), key=lambda kv: -kv[1])[:15]
        if top:
            blocks.append(("chart", {"type": "bar", "title": "Words used most", "labels": [w for w, _c in top],
                                     "series": [{"name": "Times", "values": [c for _w, c in top]}]}))
        blocks.append(("h", "Each document"))
        blocks.append(("table", {"name": "Documents", "headers": ["Document", "Pages", "Words", "Sentences",
                                                                  "Words per sentence", "Reading time"],
                                 "rows": big + [["Total", tp, tw, ts, round(tw / ts, 1) if ts else "", rt]],
                                 "total_row": True, "widths": [40, 8, 10, 10, 12, 12]}))
        blocks.append(("p", "Reading time at about 200 words a minute."))
        return {"title": "Word count & reading time", "subtitle": self._subtitle(P["scope"], f"{tw:,} words"),
                "blocks": blocks, "_name": "Word count - " + P["title"]}

    # ---- Same field in every document --------------------------------------------------------------------------
    def _job_fieldcmp(self, P, job):
        """The same data (e.g. Total, Phone, Date of birth) in each document, side by side: different values and
        missing ones stand out."""
        names = [x.strip() for x in re.split(r"[,;\n]+", P.get("cols_txt") or "") if x.strip()]
        if not names:
            return "Type the data to compare - e.g.  Total, Phone, Date of birth."
        fields = []
        for n_ in names:
            kind = next((kind for lab, (words, kind) in ASK_FIELDS.items()
                         if n_.lower() == lab.lower() or n_.lower() in words), "col")
            lab = next((lab for lab, (words, k2) in ASK_FIELDS.items() if n_.lower() == lab.lower()), None)
            fields.append((lab or n_[:1].upper() + n_[1:], kind))
        recs = []
        for k, (folder, rel, path) in enumerate(P["files"]):
            if job["cancel"]:
                return None
            job["progress"] = f"Reading {k + 1} of {len(P['files'])}  ·  Esc to stop"
            try:
                doc = self._doc_bytes_open(path)
            except Exception:
                continue
            name = f"{P['labels'].get(folder, folder)} / {rel}" if P["lib"] else rel
            try:
                rows, ctx = [], {}
                for pi in range(min(doc.page_count, 8)):
                    rows += page_rows(self.fitz, doc.load_page(pi), ctx)
            finally:
                doc.close()
            vals = [self._ask_lookup(rows, lab, kind) for lab, kind in fields]
            if any(vals):
                recs.append((name, vals))
        if job["cancel"]:
            return None
        if not recs:
            return "None of your documents has that data."
        common = []
        for j in range(len(fields)):
            cnt = {}
            for _n, vals in recs:
                v = " ".join(str(vals[j]).split()).lower()
                if v:
                    cnt[v] = cnt.get(v, 0) + 1
            common.append(max(cnt, key=cnt.get) if cnt and max(cnt.values()) > 1 else None)
        rows_t, colors, n_miss, n_diff = [], [], 0, 0
        alerts = []
        for name, vals in recs:
            out, bad = [name], False
            for j, v in enumerate(vals):
                if not v:
                    out.append("✗ missing")
                    n_miss += 1
                    bad = True
                elif common[j] and " ".join(str(v).split()).lower() != common[j]:
                    out.append(f"≠ {v}")
                    n_diff += 1
                    bad = True
                else:
                    out.append(v)
            rows_t.append(out)
            colors.append(STATUS_COL["warning"] if bad else None)
        for j, (lab, _k) in enumerate(fields):
            vs = {}
            for _n, vals in recs:
                if vals[j]:
                    vs[vals[j]] = vs.get(vals[j], 0) + 1
            if len(vs) > 1:
                alerts.append(("alert", {"tone": "serious", "text": f"{lab}: {len(vs)} different values - " +
                                         ", ".join(f"{v} ({c})" for v, c in sorted(vs.items(), key=lambda kv: -kv[1])[:4])}))
        blocks = [("kpis", [self._kp("Documents", len(recs)), self._kp("Data compared", len(fields)),
                            self._kp("Missing", n_miss, "warning" if n_miss else None),
                            self._kp("Different", n_diff, "serious" if n_diff else None)])]
        blocks += alerts[:8]
        miss_per = [sum(1 for _n, vals in recs if not vals[j]) for j in range(len(fields))]
        if any(miss_per):
            blocks.append(("chart", {"type": "bar", "title": "Documents without it",
                                     "labels": [l for l, _k in fields], "series": [{"name": "Missing",
                                                                                     "values": miss_per}]}))
        blocks.append(("h", "Side by side  (≠ different from most · ✗ missing)"))
        blocks.append(("table", {"name": "Compared", "headers": ["File"] + [l for l, _k in fields], "rows": rows_t,
                                 "colors": colors, "widths": [32] + [18] * len(fields)}))
        return {"title": "Same data in every document: " + ", ".join(l for l, _k in fields[:4]),
                "subtitle": self._subtitle(P["scope"], f"{len(recs)} documents"), "blocks": blocks,
                "_name": "Compare data - " + P["title"]}

    # ---- Trends & charts ---------------------------------------------------------------------------------------
    def _job_trends(self, P, job):
        """Simple charts of what is in your documents: amounts and dates per month, top amounts, people and
        organisations named most, kinds of documents."""
        import datetime
        today = datetime.date.today()
        amt_m, dates_m, kinds, people, orgs = {}, {}, {}, {}, {}
        top_amounts = []
        for name, folder, rel, path, texts in self._texts(P, job):
            dt_ = doc_type("\n".join(texts))
            kinds[dt_] = kinds.get(dt_, 0) + 1
            for t in texts:
                for p_ in self._people_on_page(t):
                    people[p_] = people.get(p_, 0) + 1
                for m_ in self.ORG_RE.finditer(t):
                    o = " ".join(m_.group(1).split())
                    orgs[o] = orgs.get(o, 0) + 1
                for line in t.split("\n"):
                    for d in parse_dates(line):
                        if abs((d - today).days) <= 5 * 366:
                            dates_m[(d.year, d.month)] = dates_m.get((d.year, d.month), 0) + 1
        # amounts with their date: row by row (a table row is one line here)
        both = lambda tx: bool(EXTRACT_PATTERNS["Amounts"].search(tx))
        for name, folder, rel, page, row in self._walk_rows(P, job, both):
            am = [n for n in (parse_number(v) for v in find_values("Amounts", row["text"])) if n is not None]
            if not am:
                continue
            top_amounts.append((max(am), " ".join(row["text"].split())[:80], name))
            if TOTAL_ROW.match((row["cells"][0] or "").strip()) or re.search(r"\btotal\b", row["text"], re.I):
                continue
            ds = [d for d in parse_dates(row["text"]) if abs((d - today).days) <= 5 * 366]
            if ds:
                k_ = (ds[0].year, ds[0].month)
                amt_m[k_] = amt_m.get(k_, 0) + sum(am)
        if job["cancel"]:
            return None
        if not kinds:
            return "No files here."
        blocks = [("kpis", [self._kp("Documents", sum(kinds.values())), self._kp("Dates", sum(dates_m.values())),
                            self._kp("Amounts", len(top_amounts)), self._kp("People", len(people)),
                            self._kp("Organisations", len(orgs))])]
        lab = lambda k_: datetime.date(k_[0], k_[1], 1).strftime("%b %y")
        if amt_m:
            ks = sorted(amt_m)[-18:]
            blocks.append(("chart", {"type": "col", "title": "Amounts per month (lines with a date)",
                                     "labels": [lab(k_) for k_ in ks],
                                     "series": [{"name": "Amount", "values": [round(amt_m[k_], 2) for k_ in ks]}]}))
        if dates_m:
            ks = sorted(dates_m)[-18:]
            blocks.append(("chart", {"type": "line", "title": "Dates per month", "labels": [lab(k_) for k_ in ks],
                                     "series": [{"name": "Dates", "values": [dates_m[k_] for k_ in ks]}]}))
        blocks.append(("chart", {"type": "donut", "title": "Kinds of documents", "labels": list(kinds),
                                 "series": [{"values": list(kinds.values())}], "center": "documents"}))
        if top_amounts:
            ta = sorted(top_amounts, key=lambda x: -x[0])[:10]
            blocks.append(("chart", {"type": "bar", "title": "Largest amounts",
                                     "labels": [x[1][:34] for x in ta], "series": [{"name": "Amount",
                                                                                     "values": [x[0] for x in ta]}],
                                     "link": {"table": "Amounts", "col": "Line"}}))
        tp = sorted(people.items(), key=lambda kv: -kv[1])[:12]
        if tp:
            blocks.append(("chart", {"type": "bar", "title": "People named most", "labels": [p_ for p_, _c in tp],
                                     "series": [{"name": "Pages", "values": [c for _p, c in tp]}]}))
        to = sorted(orgs.items(), key=lambda kv: -kv[1])[:10]
        if to:
            blocks.append(("chart", {"type": "bar", "title": "Organisations named most", "labels": [o for o, _c in to],
                                     "series": [{"name": "Times", "values": [c for _o, c in to]}]}))
        if amt_m or dates_m:
            ks = sorted(set(amt_m) | set(dates_m))
            blocks.append(("h", "Per month"))
            blocks.append(("table", {"name": "Per month", "headers": ["Month", "Dates", "Amounts (lines with a date)"],
                                     "rows": [[lab(k_), dates_m.get(k_, 0), round(amt_m.get(k_, 0), 2)] for k_ in ks],
                                     "widths": [12, 10, 20]}))
        if top_amounts:
            blocks.append(("h", "Largest amounts"))
            blocks.append(("table", {"name": "Amounts", "headers": ["Amount", "Line", "File"],
                                     "rows": [[f"{x[0]:,.2f}", x[1], x[2]] for x in sorted(top_amounts,
                                                                                            key=lambda x: -x[0])[:200]],
                                     "widths": [12, 50, 28]}))
        return {"title": f"Trends & charts - {P['title']}", "subtitle": self._subtitle(P["scope"]), "blocks": blocks,
                "_name": "Trends - " + P["title"]}

