def hue_shift(hexcol, deg):
    import colorsys
    r, g, b = [int(hexcol[i:i + 2], 16) / 255 for i in (1, 3, 5)]
    h, l_, s = colorsys.rgb_to_hls(r, g, b)
    r, g, b = colorsys.hls_to_rgb((h + deg / 360.0) % 1.0, l_, s)
    return "#%02X%02X%02X" % (int(r * 255), int(g * 255), int(b * 255))


def frame_palette(conf, accent):
    """The colours that flow round the window."""
    key = conf.get("palette", "accent")
    if key == "custom" and conf.get("colors"):
        return [c for c in conf["colors"] if re.fullmatch(r"#[0-9A-Fa-f]{6}", c or "")] or [accent]
    cols = (FRAME_PALETTES.get(key) or (None, None))[1]
    if not cols:
        cols = [accent, hue_shift(accent, 38), mix(accent, "#FFFFFF", 0.4), hue_shift(accent, -32)]
    return cols


def frame_cycle(colors, period=900):
    """One round of the flowing colours: period pixels, soft blends, the end joins the start."""
    cols = [tuple(int(c[i:i + 2], 16) for i in (1, 3, 5)) for c in colors] or [(108, 99, 255)]
    n = len(cols)
    out = []
    for i in range(period):
        t = i * n / float(period)
        k = int(t) % n
        f = t - int(t)
        f = f * f * (3 - 2 * f)
        a, b = cols[k], cols[(k + 1) % n]
        out.append((int(a[0] + (b[0] - a[0]) * f), int(a[1] + (b[1] - a[1]) * f), int(a[2] + (b[2] - a[2]) * f)))
    return out


def frame_strip_ppm(cyc, length, thick, horizontal, reverse, outer_first, bg, glow=True, level=1, look=None):
    """One side of the frame as a PPM picture, a little longer than the side (it is moved, never redrawn).
    level 0 = calm (reading), 1 = normal, 2 = bright (BindLens is working / something new).
    look: "bevel" = a picture frame (dark outer edge, the colour, a light line and a soft shadow on the inside; on
    a wide band - the menu row, the status row, the tools on the right - a gentle light across it), "glow" = the
    colour fading inwards, "flat" = one colour. Made from one round of colours repeated (quick)."""
    look = look or ("glow" if glow else "flat")
    P = len(cyc)
    br, bgg, bb = [int(bg[i:i + 2], 16) for i in (1, 3, 5)]
    per = [cyc[(-i) % P] if reverse else cyc[i] for i in range(P)]
    if level == 0:
        per = [(int(r + (br - r) * 0.45), int(g + (bgg - g) * 0.45), int(b + (bb - b) * 0.45)) for r, g, b in per]
    elif level == 2:
        per = [(int(r + (255 - r) * 0.2), int(g + (255 - g) * 0.2), int(b + (255 - b) * 0.2)) for r, g, b in per]

    def row(target, m):
        m = max(0.0, min(1.0, m))
        if target is None or m <= 0:
            return bytes(v for c in per for v in c)
        tr, tg, tb = target
        return bytes(v for r, g, b in per for v in (int(r + (tr - r) * m), int(g + (tg - g) * m),
                                                     int(b + (tb - b) * m)))
    cache = {}

    def row_c(target, m):
        k = (target, round(m, 3))
        if k not in cache:
            cache[k] = row(target, m)
        return cache[k]
    rows = []
    for k in range(thick):
        d = k if outer_first else thick - 1 - k             # 0 = the outer edge
        if look == "bevel" and thick >= 12:                 # a wide band
            if d == 0:
                rows.append(row_c((0, 0, 0), 0.28))
            elif d == thick - 1:
                rows.append(row_c((0, 0, 0), 0.30))
            elif d == thick - 2:
                rows.append(row_c((255, 255, 255), 0.22))
            else:
                t_ = d / float(thick - 1)
                rows.append(row_c((255, 255, 255), 0.10 * (1 - abs(t_ - 0.35) / 0.65)))
        elif look == "bevel" and thick >= 3:
            if d == 0:
                rows.append(row_c((0, 0, 0), 0.30))
            elif d == thick - 1:
                rows.append(row_c((0, 0, 0), 0.42) if thick >= 4 else row_c((br, bgg, bb), 0.45))
            elif d == thick - 2 and thick >= 5:
                rows.append(row_c((255, 255, 255), 0.38))
            else:
                rows.append(row_c((255, 255, 255), min(0.2, 0.05 * d)))
        elif look == "glow" and thick > 1:
            rows.append(row_c((br, bgg, bb), 0.62 * d / max(1, thick - 1)))
        else:
            rows.append(row_c(None, 0))
    reps = length // P + 2
    if horizontal:
        return b"P6\n%d %d\n255\n" % (length, thick) + b"".join((r_ * reps)[:length * 3] for r_ in rows)
    pre = [b"".join(r_[j * 3:j * 3 + 3] for r_ in rows) for j in range(P)]
    return b"P6\n%d %d\n255\n" % (thick, length) + b"".join(pre[i % P] for i in range(length))


