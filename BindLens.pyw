    def _rep_icon(self, cv, key, x, y, col, on, size=18, tags=None):
        """The report's little picture in a soft tile (solid when it is the one under the mouse or chosen)."""
        kw = {"tags": tags} if tags else {}
        bg = col if on else mix(self.T["panel"], col, 0.16)
        round_rect(cv, x, y, x + size, y + size, size * 0.3, fill=bg, outline="", **kw)
        try:
            draw_icon(cv, self.REPORT_ICON.get(key, "report"), x + size / 2, y + size / 2,
                      "#FFFFFF" if on else col, s=size / 32, w=2.0, tag=tags)
        except Exception:
            pass

