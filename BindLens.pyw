def web_get(url, timeout=15):
    import urllib.request
    import urllib.error
    req = urllib.request.Request(url, headers={"User-Agent": f"BindLens/{APP_VERSION} (desktop PDF reader)"})
    for attempt in range(3):
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return r.read()
        except urllib.error.HTTPError as ex:
            if ex.code in (429, 503) and attempt < 2:
                time.sleep(1.5 * (attempt + 1))
                continue
            raise


def commons_pictures(topic, limit=24):
    """Good wide photos for a topic: title matches first, then any featured picture, then any picture."""
    q = {"nature": "landscape", "sky and clouds": "clouds", "night sky": "milky way", "city at night": "skyline night",
         "countryside": "countryside landscape", "flowers": "flower field", "snow": "winter landscape",
         "sea": "seascape"}.get(topic.lower(), topic)
    first = q.split()[0] if len(q.split()) == 1 else q
    res, seen = [], set()
    for query, featured in ((f"intitle:{first}" if " " not in first else first, True), (q, True), (q, False)):
        if len(res) >= limit:
            break
        try:
            for r in commons_search(query, 30, featured):
                if r["title"] not in seen:
                    seen.add(r["title"])
                    res.append(r)
        except Exception:
            if not res:
                raise
    return res[:limit]


def commons_search(query, limit=24, featured=True):
    """Wide, good photos from Wikimedia Commons for a few words."""
    import urllib.parse
    q = f"{query} filetype:bitmap" + (" incategory:Featured_pictures_on_Wikimedia_Commons" if featured else "")
    params = {"action": "query", "format": "json", "generator": "search", "gsrnamespace": 6, "gsrsearch": q,
              "gsrlimit": limit, "prop": "imageinfo", "iiprop": "url|size", "iiurlwidth": 320}
    data = json.loads(web_get("https://commons.wikimedia.org/w/api.php?" + urllib.parse.urlencode(params)))
    out = []
    for p in ((data.get("query") or {}).get("pages") or {}).values():
        ii = (p.get("imageinfo") or [{}])[0]
        w, h = ii.get("width", 0), ii.get("height", 1)
        if w < 1200 or w < h * 1.15 or not ii.get("thumburl"):
            continue
        out.append({"title": p.get("title", ""), "thumb": ii.get("thumburl"), "url": ii.get("url"), "w": w, "h": h,
                    "index": p.get("index", 0)})
    out.sort(key=lambda x: x["index"])
    return out


def picsum_list(page=1, limit=24):
    """A mixed collection of beautiful free photos (Lorem Picsum / Unsplash)."""
    data = json.loads(web_get(f"https://picsum.photos/v2/list?page={int(page)}&limit={int(limit)}"))
    out = []
    for it in data:
        w, h = int(it.get("width", 0)), int(it.get("height", 1))
        if w < h * 1.15:
            continue
        out.append({"title": f"Photo by {it.get('author', '')}", "thumb": f"https://picsum.photos/id/{it['id']}/320/200",
                    "url": f"https://picsum.photos/id/{it['id']}/2400/{int(2400 * h / max(1, w))}", "picsum": True})
    return out


def commons_big(title, width=2400):
    import urllib.parse
    params = {"action": "query", "format": "json", "titles": title, "prop": "imageinfo", "iiprop": "url",
              "iiurlwidth": width}
    data = json.loads(web_get("https://commons.wikimedia.org/w/api.php?" + urllib.parse.urlencode(params)))
    for p in ((data.get("query") or {}).get("pages") or {}).values():
        ii = (p.get("imageinfo") or [{}])[0]
        return ii.get("thumburl") or ii.get("url")
    return None



NOTE_PHOTO_GEOM = {}          # picture key -> size of the whole photo in the last note drawn (photo adjusting)


def rotate_image(fitz, dst_dir, key, quarter=1):
    """Turn a stored picture by 90° (photos taken sideways) -> the new picture's key."""
    import hashlib
    path = os.path.join(dst_dir, key + ".png")
    pix = fitz.Pixmap(path)
    d = fitz.open()
    w, h = (pix.height, pix.width) if quarter % 2 else (pix.width, pix.height)
    pg = d.new_page(width=w, height=h)
    pg.insert_image(pg.rect, filename=path, rotate=(90 * quarter) % 360)
    out = pg.get_pixmap(matrix=fitz.Matrix(1, 1), alpha=False)
    d.close()
    data = out.tobytes("png")
    nk = hashlib.sha1(data).hexdigest()[:16]
    with open(os.path.join(dst_dir, nk + ".png"), "wb") as fh:
        fh.write(data)
    return nk


def import_image(fitz, src, dst_dir, remove_white=False, max_side=1100):
    """Copy a picture (PNG, JPG, …) into BindLens' picture store; optional transparent background."""
    import hashlib
    pix = fitz.Pixmap(src)
    if pix.alpha:
        pix = fitz.Pixmap(pix, 0)
    if pix.colorspace and pix.colorspace.n != 3:
        pix = fitz.Pixmap(fitz.csRGB, pix)
    if max(pix.width, pix.height) > max_side:
        k = max_side / max(pix.width, pix.height)
        pix = fitz.Pixmap(pix, int(pix.width * k), int(pix.height * k), None)
    if remove_white:
        sam = pix.samples
        alpha = bytearray(pix.width * pix.height)
        n = pix.n
        for i in range(pix.width * pix.height):
            r, g, b = sam[i * n], sam[i * n + 1], sam[i * n + 2]
            lum = (r * 299 + g * 587 + b * 114) // 1000
            alpha[i] = 0 if lum > 225 else (255 if lum < 160 else (225 - lum) * 255 // 65)
        pix = fitz.Pixmap(pix, 1)
        pix.set_alpha(bytes(alpha))
    data = pix.tobytes("png")
    key = hashlib.sha1(data).hexdigest()[:16]
    os.makedirs(dst_dir, exist_ok=True)
    with open(os.path.join(dst_dir, key + ".png"), "wb") as fh:
        fh.write(data)
    return key, pix.width, pix.height


class Indexer(threading.Thread):
    """Reads the text of every document in the background (search everywhere, reports).
    Runs in its own thread so the window never freezes; remembers its work in index.json.gz."""

    def __init__(self, fitz, folder, pool=None):
        super().__init__(daemon=True)
        self.fitz = fitz
        self.pool = pool                    # helper processes (they read; this thread only keeps the results)
        self.path = os.path.join(folder, "index.json.gz")
        self.data = {}
        self.lock = threading.Lock()
        self.todo = queue.Queue()
        self.pending = set()
        self.loaded = threading.Event()
        self.changed = False
        self.stop = False
        self.busy = None

    def run(self):
        try:
            for k, v in index_entries(self.path):
                with self.lock:
                    self.data.setdefault(k, v)
            with gzip.open(self.path, "rt", encoding="utf-8") as fh:
                if fh.readline().strip() != "BLIDX1":
                    self.changed = True                   # saved again in the new, line-by-line form
        except Exception:
            pass
        self.loaded.set()
        last_save = time.time()
        while not self.stop:
            try:
                key, path = self.todo.get(timeout=1.5)
            except queue.Empty:
                if self.changed and time.time() - last_save > 3:
                    self.save()
                    last_save = time.time()
                continue
            self.busy = path
            batch = [(key, path)]
            if self.pool is not None and not self.pool.disabled and self._small(path):
                while len(batch) < 12:              # small files: several at once (read side by side)
                    try:
                        k2, p2 = self.todo.get_nowait()
                    except queue.Empty:
                        break
                    if self._small(p2):
                        batch.append((k2, p2))
                    else:
                        self.todo.put((k2, p2))
                        break
            if len(batch) > 1:
                res = self.pool.call("texts", prio=8, timeout=900, paths=[p for _k, p in batch])
                items = (res or {}).get("items")
                if not items or len(items) != len(batch):
                    items = [self.read_any(p) for _k, p in batch]
            else:
                items = [self.read_any(path)]
            with self.lock:
                for (k2, _p), entry in zip(batch, items):
                    self.data[k2] = entry
                    self.pending.discard(k2)
            self.changed = True
            self.busy = None
            time.sleep(0.02)                    # the window first
            if time.time() - last_save > 120:   # saving a big index takes a moment: rarely while busy
                self.save()
                last_save = time.time()

    @staticmethod
    def _small(path):
        try:
            return os.path.getsize(path) < 4 * 1024 * 1024
        except OSError:
            return False

    def read_any(self, path):
        """Read a file in a helper process (the window never waits); in this process only if there is none."""
        if self.pool is not None and not self.pool.disabled:
            res = self.pool.call("text", prio=8, timeout=900, path=path)
            if res and "pages" in res:
                return {"mtime": res["mtime"], "size": res["size"], "pages": res["pages"]}
            if res and not res.get("fallback"):
                return {"mtime": 0, "size": 0, "pages": []}
        return self.read(path)

    def read(self, path):
        return read_text_entry(self.fitz, path, stop=lambda: self.stop)

    def request(self, files):
        """files: [(key, path)] - queue those that are new or changed."""
        self.loaded.wait(10)
        for key, path in files:
            try:
                st = os.stat(path)
            except Exception:
                continue
            with self.lock:
                e = self.data.get(key)
                fresh = e and e.get("mtime") == st.st_mtime and e.get("size", st.st_size) == st.st_size
                if fresh and e.get("cloud") and not cloud_only(st):
                    fresh = False                       # it is on this computer now: read it
                if fresh or key in self.pending:
                    continue
                if cloud_only(st):
                    # 3.0: a OneDrive file that is only online is not downloaded just for the search - it is read
                    # once it is on this computer (when you open it)
                    self.data[key] = {"mtime": st.st_mtime, "size": st.st_size, "pages": [], "cloud": 1}
                    self.changed = True
                    continue
                self.pending.add(key)
            self.todo.put((key, path))

    def refresh(self, key, path):
        """3.2: read this file again (its scanned pages were just read)."""
        with self.lock:
            e = self.data.get(key)
            if e:
                e["mtime"] = -1
        self.request([(key, path)])

    def forget_except(self, keys):
        with self.lock:
            for k in [k for k in self.data if k not in keys]:
                del self.data[k]
                self.changed = True

    def get(self, key):
        with self.lock:
            return self.data.get(key)

    def items(self):
        with self.lock:
            return list(self.data.items())

    def put(self, key, entry):
        with self.lock:
            self.data[key] = entry
            self.changed = True

    _save_lock = threading.Lock()

    def save(self):
        with self.lock:
            snap = dict(self.data)
            self.changed = False
        # 3.0: one save at a time (the window and this thread could write the same temporary file at closing),
        # really on the disk before it replaces the old one
        with self._save_lock:
            tmp = f"{self.path}.{os.getpid()}-{threading.get_ident()}.tmp"
            try:
                with open(tmp, "wb") as raw:
                    with gzip.open(raw, "wt", encoding="utf-8", compresslevel=3) as fh:
                        fh.write("BLIDX1\n")
                        for k, v in snap.items():           # one line per file: read back a little at a time
                            fh.write(json.dumps([k, v], ensure_ascii=False))
                            fh.write("\n")
                    raw.flush()
                    try:
                        os.fsync(raw.fileno())
                    except OSError:
                        pass
                os.replace(tmp, self.path)
            except Exception:
                try:
                    os.remove(tmp)
                except Exception:
                    pass


def index_entries(path):
    """(key, entry) of the saved texts - line by line, so reading a big index never holds the window up
    (the old one-piece format of 1.7 and before is read too)."""
    with gzip.open(path, "rt", encoding="utf-8") as fh:
        first = fh.readline()
        if first.strip() == "BLIDX1":
            for line in fh:
                if line.strip():
                    try:
                        k, v = json.loads(line)
                    except ValueError:
                        continue
                    yield k, v
        else:
            d = json.loads(first + fh.read())
            for k, v in d.items():
                yield k, v


def page_annot_text(page):
    """Text you added on a page (text boxes, notes, stamps) - so search and reports find it too."""
    out = []
    try:
        for a in page.annots() or []:
            if a.type[1] in ("Link", "Widget", "Popup"):
                continue
            c = meta_text(annot_meta(a)).strip()
            if c:
                out.append(c)
    except Exception:
        pass
    return "\n".join(out)


class FolderWatcher(threading.Thread):
    """1.9.4 (Windows): Windows itself tells BindLens the moment a file is added, removed or renamed in a book's
    folder (FindFirstChangeNotification) - no polling, no work while nothing happens. The window asks `take()`
    which books changed (once their folder has been quiet for a moment) and reads only those again."""

    def __init__(self):
        super().__init__(daemon=True, name="BindLens folder watcher")
        self.want = {}                 # folder -> (books, whole tree?)
        self.hits = {}                 # book -> time of its last change
        self.lock = threading.Lock()
        self.stop = False
        self.changed = True
        self.watching = 0

    def set_folders(self, mapping):
        with self.lock:
            if mapping != self.want:
                self.want = dict(mapping)
                self.changed = True

    def take(self, quiet=1.0):
        now = time.time()
        with self.lock:
            ready = {b for b, t in self.hits.items() if now - t >= quiet}
            for b in ready:
                self.hits.pop(b, None)
        return ready

    def run(self):
        import ctypes
        from ctypes import wintypes
        k32 = ctypes.WinDLL("kernel32", use_last_error=True)
        first = k32.FindFirstChangeNotificationW
        first.argtypes, first.restype = [wintypes.LPCWSTR, wintypes.BOOL, wintypes.DWORD], wintypes.HANDLE
        nxt = k32.FindNextChangeNotification
        nxt.argtypes, nxt.restype = [wintypes.HANDLE], wintypes.BOOL
        close = k32.FindCloseChangeNotification
        close.argtypes, close.restype = [wintypes.HANDLE], wintypes.BOOL
        wait = k32.WaitForMultipleObjects
        wait.argtypes = [wintypes.DWORD, ctypes.POINTER(wintypes.HANDLE), wintypes.BOOL, wintypes.DWORD]
        wait.restype = wintypes.DWORD
        bad = ctypes.c_void_p(-1).value
        flags = 0x1 | 0x2                         # a file or a folder added, removed or renamed
        handles = []
        while not self.stop:
            if self.changed:
                with self.lock:
                    want = dict(self.want)
                    self.changed = False
                for h, _b in handles:
                    close(h)
                handles = []
                for path, (books, tree) in list(want.items())[:250]:
                    try:
                        h = first(path, bool(tree), flags)
                    except Exception:
                        h = None
                    if h and h != bad:
                        handles.append((h, books))
                self.watching = len(handles)
            if not handles:
                time.sleep(1.0)
                continue
            for i in range(0, len(handles), 63):
                chunk = handles[i:i + 63]
                arr = (wintypes.HANDLE * len(chunk))(*[h for h, _b in chunk])
                r = wait(len(chunk), arr, False, 600 if len(handles) <= 63 else 150)
                if r < len(chunk):
                    h, books = chunk[r]
                    with self.lock:
                        for b in books:
                            self.hits[b] = time.time()
                    if not nxt(h):
                        self.changed = True
                elif r == 0xFFFFFFFF:                # something went wrong: open the folders again
                    time.sleep(1.0)
                    self.changed = True
                if self.stop or self.changed:
                    break
        for h, _b in handles:
            close(h)


def _fp(data, n=None):
    """3.2: a quick fingerprint of the first n bytes of data - its length, its start and its end."""
    import hashlib
    n = len(data) if n is None else n
    h = hashlib.sha1()
    h.update(data[:min(n, 65536)])
    h.update(data[max(0, n - 65536):n])
    return (n, h.hexdigest())


def pdf_incremental_bytes(fitz, doc):
    """3.2: the PDF as its original bytes + one short update with the changes (MuPDF's incremental save, made
    in memory) - nothing is packed again, so a mark on a 200 MB scan is saved at once."""
    m = fitz.mupdf
    pdf = fitz._as_pdf_document(doc)
    opts = m.PdfWriteOptions()
    opts.do_incremental = 1
    buf = m.fz_new_buffer(1 << 16)
    out = m.FzOutput(buf)
    m.pdf_write_document(pdf, out, opts)
    out.fz_close_output()
    return bytes(m.fz_buffer_extract(buf))


class Writer(threading.Thread):
    """Writes saved PDFs to disk in the background, so a slow disk, OneDrive or the antivirus
    never freezes the window. The newest bytes of a file are always served from memory first."""

    def __init__(self):
        super().__init__(daemon=True)
        self.q = queue.Queue()
        self.latest = {}          # path -> bytes not yet on disk
        self.failed = {}          # path -> error text (file open in another program…)
        self.lock = threading.Lock()
        self.expect = {}          # 3.0: path -> (date, size) of the file as BindLens read it
        self.ours = {}            # path -> (date, size) after BindLens's last save
        self.conflicts = []       # [(path, copy saved instead)] - another program changed the file meanwhile
        self.bases = {}           # 3.2: path -> (length, fingerprint) of the original the new bytes start with
        self.prefix = {}          # 3.2: path -> {(length, fingerprint)} the file on the disk starts with

    def note_disk(self, path, fp):
        """3.2: the file was just read from the disk - this is what it is now."""
        with self.lock:
            if path not in self.latest:
                self.prefix[path] = {fp}

    def put(self, path, data, expect=None, base=None):
        with self.lock:
            self.latest[path] = data
            self.bases[path] = base
            self.failed.pop(path, None)
            if expect is not None and expect != self.expect.get(path):
                self.expect[path] = expect            # the book read the file (again): that is the base now
                self.ours.pop(path, None)
        self.q.put(path)

    @staticmethod
    def _same(a, b):
        return a is not None and b is not None and a[1] == b[1] and abs(a[0] - b[0]) < 2.0

    def _changed_elsewhere(self, path):
        """3.0: was the file changed by another program since BindLens read it (or last saved it)?"""
        try:
            st = os.stat(path)
        except OSError:
            return False
        cur = (st.st_mtime, st.st_size)
        known = self.ours.get(path) or self.expect.get(path)
        return known is not None and not self._same(cur, known)

    def get(self, path):
        with self.lock:
            return self.latest.get(path)

    def run(self):
        while True:
            path = self.q.get()
            with self.lock:
                data = self.latest.get(path)
                base = self.bases.get(path)
            if data is not None:
                tmp = path + ".bindlens-tmp"
                try:
                    # 3.0: a file that is gone (moved or deleted) is never made again; a read-only file says so
                    if not os.path.exists(path):
                        with self.lock:
                            self.failed[path] = "gone"
                        self.q.task_done()
                        continue
                    if not os.access(path, os.W_OK) or (os.name == "nt" and getattr(
                            os.stat(path), "st_file_attributes", 0) & 0x1):
                        with self.lock:
                            self.failed[path] = "read-only"
                        self.q.task_done()
                        continue
                    if self._changed_elsewhere(path):
                        # another program saved this file after BindLens read it: never write over it -
                        # the marks go into a copy next to it, and the window says so
                        base, ext = os.path.splitext(path)
                        dst = base + " (with my marks)" + ext
                        k_ = 2
                        while os.path.exists(dst):
                            dst = f"{base} (with my marks {k_}){ext}"
                            k_ += 1
                        with open(dst, "wb") as fh:
                            fh.write(data)
                            fh.flush()
                            os.fsync(fh.fileno())
                        with self.lock:
                            if self.latest.get(path) is data:
                                del self.latest[path]
                            self.conflicts.append((path, dst))
                            self.expect.pop(path, None)
                            self.ours.pop(path, None)
                        self.q.task_done()
                        continue
                    appended = False
                    with self.lock:
                        known = set(self.prefix.get(path) or ())
                    if base and base in known and len(data) > base[0]:
                        # 3.2: the file on the disk starts with the same original - only the short update
                        # after it is written (a big scan is not written again whole)
                        try:
                            size0 = os.path.getsize(path)
                        except OSError:
                            size0 = -1
                        if size0 >= base[0]:
                            fh = open(path, "r+b")
                            try:
                                fh.seek(base[0])
                                fh.write(memoryview(data)[base[0]:])
                                fh.truncate()
                                fh.flush()
                                try:
                                    os.fsync(fh.fileno())
                                except OSError:
                                    pass
                                appended = True
                            except Exception:
                                try:                       # back to the original: a whole, readable PDF
                                    fh.truncate(base[0])
                                except Exception:
                                    pass
                                with self.lock:
                                    self.prefix[path] = {base}
                                raise
                            finally:
                                fh.close()
                    if not appended:
                        with open(tmp, "wb") as fh:
                            fh.write(data)
                            fh.flush()
                            try:
                                os.fsync(fh.fileno())          # 3.0: really on the disk before it replaces the file
                            except OSError:
                                pass
                        for k in range(10):
                            try:
                                os.replace(tmp, path)
                                break
                            except PermissionError:
                                if k == 9:
                                    raise
                                time.sleep(0.3)
                    with self.lock:
                        self.prefix[path] = {_fp(data)} | ({base} if base else set())
                    try:
                        st = os.stat(path)
                        with self.lock:
                            self.ours[path] = (st.st_mtime, st.st_size)
                    except OSError:
                        pass
                    with self.lock:
                        if self.latest.get(path) is data:
                            del self.latest[path]
                except Exception as ex:
                    with self.lock:
                        self.failed[path] = str(ex)
                    try:
                        os.remove(tmp)
                    except Exception:
                        pass
            self.q.task_done()

    def retry(self):
        with self.lock:
            paths = list(self.failed)
            self.failed.clear()
        for p in paths:
            self.q.put(p)

    def wait(self, timeout=15):
        end = time.time() + timeout
        while self.q.unfinished_tasks and time.time() < end:
            time.sleep(0.05)
        return not self.q.unfinished_tasks

    def rescue(self, folder):
        """3.0: changes that could not be saved (the file is open in another program at closing time) are put in
        a safe place; BindLens offers them again next time."""
        with self.lock:
            items = list(self.latest.items())
        saved = []
        if not items:
            return saved
        os.makedirs(folder, exist_ok=True)
        idx_path = os.path.join(folder, "rescued.json")
        idx = load_json(idx_path, [])
        for path, data in items:
            name = time.strftime("%Y%m%d-%H%M%S-") + clean_name(os.path.basename(path))
            dst = os.path.join(folder, name)
            try:
                with open(dst, "wb") as fh:
                    fh.write(data)
                with self.lock:
                    known = self.ours.get(path) or self.expect.get(path)
                idx.append({"path": path, "copy": dst, "when": time.strftime("%d %b %Y %H:%M"),
                            "known": list(known) if known else None})
                saved.append(path)
            except Exception:
                pass
        try:
            save_json(idx_path, idx)
        except Exception:
            pass
        return saved


# ---------------------------------------------------------------------------
# The reader: invisible helper processes that open and read your files.
# PyMuPDF keeps Python's lock while it works, so reading big files - even in a background thread of the
# window - kept the window from answering ("Not responding"). In their own process they can't touch it:
# the window only draws. If a helper can't start, BindLens reads the files itself as before.
# ---------------------------------------------------------------------------
HELPER_ARG = "--bindlens-helper"


def _hsend(fh, obj):
    import pickle
    data = pickle.dumps(obj, protocol=4)
    fh.write(struct.pack(">Q", len(data)) + data)
    fh.flush()


def _hrecv(fh):
    import pickle
    head = fh.read(8)
    if not head or len(head) < 8:
        return None
    n = struct.unpack(">Q", head)[0]
    buf = bytearray()
    while len(buf) < n:
        part = fh.read(n - len(buf))
        if not part:
            return None
        buf += part
    return pickle.loads(bytes(buf))


def read_text_entry(fitz, path, stop=None, opener=None, keep_open=False):
    """The text of every page of a file (plus the text of your notes on it) - for search and reports."""
    try:
        st = os.stat(path)
        if is_outside(path):                         # a card page: nothing inside to search
            return {"mtime": st.st_mtime, "size": st.st_size, "pages": [""]}
        if opener:
            doc = opener(path)
        else:
            with open(path, "rb") as fh:
                data = fh.read()
            doc = open_stream(fitz, data, path)
            if doc.is_reflowable:
                doc.layout(width=500, height=700, fontsize=12)
        pages = []
        try:
            for i in range(min(doc.page_count, 3000)):
                if stop and stop():
                    break
                pg = doc.load_page(i)
                t = pg.get_text("text")[:30000]
                if len(t.strip()) < 25:                 # 3.2: a scanned page BindLens has read
                    ws = ocr_cached_words(path, pg)
                    if ws:
                        t = " ".join(w[4] for w in ws)[:30000]
                extra = page_annot_text(pg)
                pages.append(t + ("\n" + extra if extra else ""))
                if not opener:
                    time.sleep(0.004)          # in the window's own process: give it time to breathe
        finally:
            if not keep_open:
                doc.close()
        return {"mtime": st.st_mtime, "size": st.st_size, "pages": pages}
    except Exception:
        return {"mtime": 0, "size": 0, "pages": []}


def is_outside(path):
    """A file BindLens shows as a card (it can't look inside it: old .doc/.xls/.ppt, Outlook .msg …) - 3.2: unless
    Office or LibreOffice made its exact copy."""
    return os.path.splitext(path or "")[1].lower() in OUTSIDE and not office_pdf_ready(path)


def _decode_text(data):
    for enc in ("utf-8-sig", "utf-16") if data[:2] in (b"\xff\xfe", b"\xfe\xff") else ("utf-8-sig",):
        try:
            return data.decode(enc)
        except Exception:
            pass
    return data.decode("cp1252", "replace")


