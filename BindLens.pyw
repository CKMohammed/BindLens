                      f"<div class='k'><b>{_esc(ext.upper().lstrip('.'))}</b> &middot; {_esc(kind)}</div>", css=css)
    pg.insert_htmlbox(fitz.Rect(100, y0 + h + 62, W - 100, y0 + h + 120),
                      f"<div class='n'>{_esc(os.path.basename(path))}</div>", css=css)
    pg.insert_htmlbox(fitz.Rect(100, y0 + h + 120, W - 100, y0 + h + 140),
                      f"<div class='m'>{sz}{(' &middot; changed ' + _esc(when)) if when else ''}</div>", css=css)
    pg.draw_line((150, y0 + h + 156), (W - 150, y0 + h + 156), color=(0.9, 0.9, 0.93), width=0.8)
    why = office_failed_note(path) if ext in OFFICE_EXACT else None
    if why:                                  # 3.3: Office / LibreOffice could not show it - say why
        pg.insert_htmlbox(fitz.Rect(100, y0 + h + 170, W - 100, y0 + h + 240),
                          f"<div class='t'>BindLens could not show it here: {_esc(why[:140])}<br/>"
                          f"<b>Double-click this page</b> to open it in {_esc(prog)}.</div>", css=css)
        pg.insert_htmlbox(fitz.Rect(110, y0 + h + 250, W - 110, y0 + h + 300),
                          "<div class='tip'>Right-click the page > Show it here as it looks, to try again.</div>",
                          css=css)
    elif ext in OFFICE_EXACT:                # 3.3: it is being made ready to show here, as it looks
        pg.insert_htmlbox(fitz.Rect(100, y0 + h + 170, W - 100, y0 + h + 240),
                          f"<div class='t'><b>Getting it ready to show here</b>, exactly as it looks in "
                          f"{_esc(prog)} - in a moment.<br/>(Double-click opens it in {_esc(prog)}.)</div>", css=css)
        pg.insert_htmlbox(fitz.Rect(110, y0 + h + 250, W - 110, y0 + h + 300),
