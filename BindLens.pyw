# ---- 1.9.2: forms - boxes and their labels (Name, Email, Phone…), form fields, scanned pages --------------------
PAIR_KINDS = [
    ("email", re.compile(r"\b(e-?mail|email address|correo)\b", re.I)),
    ("phone", re.compile(r"\b(phone|mobile|mob|tel(?:ephone)?|cell|contact (?:no|number)|tel[eé]fono|m[oó]vil)\b", re.I)),
    ("org", re.compile(r"\b(organi[sz]ation|company|employer|school|centre|center|business|empresa)\b", re.I)),
    ("name", re.compile(r"\b(full\s*name|name|child'?s|parent|guardian|contact person|surname|first\s*name|forename|"
                        r"signed by|nombre|apellidos?)\b", re.I)),
]


def pair_kind(label):
    """What a label asks for: 'name', 'email', 'phone', 'org' - or None."""
    lab = (label or "").strip()
    if not lab or len(lab) > 48:
        return None
    if re.search(r"signature|date|d\.o\.b|birth|address|relationship|allerg|doctor|gp\b", lab, re.I) and \
            not re.search(r"e-?mail|phone|mobile", lab, re.I):
        return None
    for k, rx in PAIR_KINDS:
        if rx.search(lab):
            return k
    return None


TICK_ON, TICK_OFF = "☑✓✔✅☒■", "☐□"
_TICK_ANY = re.compile(r"[☑✓✔✅☒■☐□]")
_TICK_LINE = re.compile(r"^\s*([☑✓✔✅☒■☐□])\s*([^☑✓✔✅☒■☐□:：]{2,70}?)\s*$")


def tick_answer(val):
    """4.1 - ticked boxes in forms: '☑' -> 'Ticked', '☐' -> 'Not ticked', '☐ Yes ☑ No' -> 'No' (the ticked
    option), several ticked -> 'A, B'. None when the value has no box in it."""
    v = (val or "").strip()
    if not _TICK_ANY.search(v):
        return None
    opts = re.findall(r"([☑✓✔✅☒■☐□])\s*([^☑✓✔✅☒■☐□]*)", v)
    named = [(g, t.strip(" ,;/")) for g, t in opts if t.strip(" ,;/")]
    if not named:
        return "Ticked" if any(g in TICK_ON for g, _t in opts) else "Not ticked"
    on = [t for g, t in named if g in TICK_ON]
    return ", ".join(on) if on else "None ticked"


def widget_answer(fitz, w):
    """A form field's answer as a person would say it: a tick box is Ticked / Not ticked, a choice its option."""
    v = w.field_value
    ft = w.field_type
    if ft == fitz.PDF_WIDGET_TYPE_CHECKBOX:
        on = v is True or (isinstance(v, str) and v.strip() not in ("", "Off", "No", "False", "0"))
        return "Ticked" if on else "Not ticked"
    if ft == fitz.PDF_WIDGET_TYPE_RADIOBUTTON:
        return "" if v in (None, False, "Off") else ("Chosen" if v is True else str(v))
    if isinstance(v, bool):
        return "Yes" if v else "No"
    return str(v or "")


def form_pairs(fitz, page, words=None):
    """(label, value, rect) of a form page: form fields, drawn boxes with their label (inside, on the left or
    just above), and 'Label: value' lines. Works on scanned pages too when words come from OCR."""
    pairs = []
    try:
        for w in page.widgets() or []:
            lab = (w.field_label or w.field_name or "").strip()
            val = w.field_value
            if isinstance(val, bool) or val in (None, "", "Off"):
                continue
            pairs.append((lab, " ".join(str(val).split()), fitz.Rect(w.rect)))
    except Exception:
        pass
    try:
        W = [(fitz.Rect(w[:4]), unicodedata.normalize("NFKC", w[4])) for w in
             (words if words is not None else page.get_text("words", sort=True))]
    except Exception:
        W = []
    if not W:
        return pairs
    boxes = []
    try:
        for d in page.get_drawings():
            for it in d.get("items", []):
                if it[0] == "re":
                    r = fitz.Rect(it[1])
                elif it[0] == "qu":
                    r = it[1].rect
                else:
                    continue
                if 28 <= r.width <= page.rect.width * 0.96 and 9 <= r.height <= 90:
                    if not any(abs(r.x0 - b.x0) < 2 and abs(r.y0 - b.y0) < 2 and abs(r.x1 - b.x1) < 2 for b in boxes):
                        boxes.append(r)
    except Exception:
        pass
    taken = set()
    for b in boxes:
        inside = [(r, t) for r, t in W if b.x0 - 1 <= (r.x0 + r.x1) / 2 <= b.x1 + 1 and
                  b.y0 - 1 <= (r.y0 + r.y1) / 2 <= b.y1 + 1]
        if not inside:
            continue
        inside.sort(key=lambda x: (round((x[0].y0 + x[0].y1) / 2 / 4), x[0].x0))
        text = " ".join(t for _r, t in inside)
        m = re.match(r"^\s*([A-Za-zÀ-ÿ][\w ’'/().&-]{1,40}?)\s*[:：]\s*(.+)$", text)
        if m:
            pairs.append((m.group(1).strip(), m.group(2).strip(), b))
            taken.update(id(x) for x in inside)
            continue
        left = [(r, t) for r, t in W if r.y1 > b.y0 + 2 and r.y0 < b.y1 - 2 and r.x1 <= b.x0 + 3 and
                b.x0 - r.x1 < 200]
        above = [(r, t) for r, t in W if r.y1 <= b.y0 + 3 and b.y0 - r.y1 < 16 and r.x0 < b.x1 and r.x1 > b.x0 - 4]
        lab = ""
        if left:
            left.sort(key=lambda x: x[0].x0)
            chunk = [left[-1]]
            for r, t in reversed(left[:-1]):                   # the words right before the box (one label)
                if chunk[0][0].x0 - r.x1 > 14:
                    break
                chunk.insert(0, (r, t))
            lab = " ".join(t for _r, t in chunk)
        elif above:
            above.sort(key=lambda x: (-x[0].y1, x[0].x0))
            yb = above[0][0].y1
            lab = " ".join(t for r, t in sorted(above, key=lambda x: x[0].x0) if abs(r.y1 - yb) < 4)
        lab = lab.strip().rstrip(":：").strip()
        if lab:
            pairs.append((lab, text, b))
    # lines: 'Label: value'  and  'Label        value' (a big gap)
    lines = {}
    for r, t in W:
        lines.setdefault(round((r.y0 + r.y1) / 2 / 5), []).append((r, t))
    for _k, ws in sorted(lines.items()):
        ws.sort(key=lambda x: x[0].x0)
        txt = " ".join(t for _r, t in ws)
        for m in re.finditer(r"([A-Za-zÀ-ÿ][\w ’'/().&-]{1,32}?)\s*[:：]\s*([^:]+?)(?=\s{2,}|\s+[A-Z][\w ’'/().&-]{1,32}?\s*[:：]|$)",
                             txt):
            lab, val = m.group(1).strip(), m.group(2).strip()
            if pair_kind(lab) and val:
                rr = fitz.Rect(ws[0][0])
                for r, _t in ws:
                    rr |= r
                pairs.append((lab, val, rr))
        if ":" not in txt and len(ws) >= 2:
            for k in range(1, len(ws)):
                if ws[k][0].x0 - ws[k - 1][0].x1 > 40:
                    lab = " ".join(t for _r, t in ws[:k])
                    val = " ".join(t for _r, t in ws[k:])
                    if pair_kind(lab) and val:
                        pairs.append((lab, val, ws[k][0]))
                    break
    # a small label on its own line, and the value just under it (boxes on scanned pages, cards…)
    order = [sorted(ws, key=lambda x: x[0].x0) for _k, ws in sorted(lines.items())]
    for a_, b_ in zip(order, order[1:]):
        lab = " ".join(t for _r, t in a_).strip().rstrip(":：")
        if len(a_) > 4 or not pair_kind(lab):
            continue
        ha = max(r.y1 - r.y0 for r, _t in a_)
        if b_[0][0].y0 - max(r.y1 for r, _t in a_) > ha * 1.8:
            continue
        x0, x1 = min(r.x0 for r, _t in a_) - 6, max(r.x1 for r, _t in a_) + 260
        val = " ".join(t for r, t in b_ if r.x0 >= x0 and r.x0 <= x1)
        if val and not pair_kind(val):
            rr = fitz.Rect(b_[0][0])
            pairs.append((lab, val, rr))
    return pairs


def pair_value_ok(kind, v):
    """Is v really an email / phone / name (labels can be wrong, boxes can be empty)?"""
    v = (v or "").strip()
    if kind == "email":
        return bool(EXTRACT_PATTERNS["Emails"].fullmatch(v.replace(" ", "")))
    if kind == "phone":
        return 7 <= len(re.sub(r"\D", "", v)) <= 15 and not re.search(r"[A-Za-z]{3,}", v)
    if kind == "name":
        return bool(person_like(v))
    return bool(v)


# ---- 3.2: scanned pages are read by themselves, in the background (a helper process), and remembered -------------
def ocr_dir():
    return os.path.join(data_dir(), "ocr")


def scan_key(path, page):
    """Which scanned page this is: its file and its pictures - the same after marks are added or pages moved."""
    import hashlib
    try:
        imgs = sorted((x[0], x[2], x[3]) for x in page.get_images())
    except Exception:
        imgs = []
    r = page.rect
    raw = f"{os.path.normcase(os.path.abspath(path))}|{imgs}|{round(r.width)}x{round(r.height)}"
    return "s" + hashlib.sha1(raw.encode("utf-8", "replace")).hexdigest()[:24]


def is_scanned_page(page):
    """A page that is a picture (a scan, a photo of a page): almost no text, and a picture on it."""
    try:
        if len(page.get_text("text").strip()) >= 25:
            return False
        return bool(page.get_images())
    except Exception:
        return False


def ocr_cached_words(path, page):
    """The words BindLens read on a scanned page before - None when it has not read it yet."""
    try:
        if len(page.get_text("text").strip()) >= 25 or not page.get_images():
            return None
        cache = os.path.join(ocr_dir(), scan_key(path, page) + ".json.gz")
        if not os.path.exists(cache):
            return None
        with gzip.open(cache, "rt", encoding="utf-8") as fh:
            return [tuple(w) for w in json.load(fh)]
    except Exception:
        return None


def _hop_ocr(st, msg, cancelled=None, **_):
    """Read up to n scanned pages of a file (the others next time). Returns how many were read and are left."""
    fitz = st.fitz
    path, td, n = msg["path"], msg["td"], int(msg.get("n", 2))
    doc = open_light(fitz, path)
    done = left = 0
    try:
        os.makedirs(ocr_dir(), exist_ok=True)
        for i in range(min(doc.page_count, 3000)):
            if cancelled and cancelled():
                break
            pg = doc.load_page(i)
            if not is_scanned_page(pg):
                continue
            cache = os.path.join(ocr_dir(), scan_key(path, pg) + ".json.gz")
            if os.path.exists(cache):
                continue
            if done >= n:
                left += 1
                continue
            try:
                ocr_page_words(fitz, pg, td, cache)
            except Exception:
                with gzip.open(cache, "wt", encoding="utf-8") as fh:     # unreadable: not tried again and again
                    json.dump([], fh)
            done += 1
    finally:
        doc.close()
    return {"done": done, "left": left}


def ocr_page_words(fitz, page, tessdata, cache=None):
    """The words of a scanned page, read by OCR (kept on the disk: the second time is instant)."""
    if cache and os.path.exists(cache):
        try:
            with gzip.open(cache, "rt", encoding="utf-8") as fh:
                return [tuple(w) for w in json.load(fh)]
        except Exception:
            pass
    tp = page.get_textpage_ocr(language="eng", dpi=220, full=True, tessdata=tessdata)
    words = [(w[0], w[1], w[2], w[3], w[4]) for w in page.get_text("words", textpage=tp, sort=True)]
    if cache:
        try:
            os.makedirs(os.path.dirname(cache), exist_ok=True)
            with gzip.open(cache + ".tmp", "wt", encoding="utf-8") as fh:
                json.dump(words, fh)
            os.replace(cache + ".tmp", cache)
        except Exception:
            pass
    return words


def person_name(row):
    """The person on a row: from a 'Name' column, else the first cell that looks like a name. 4.0: in a table, the
    columns that hold names (whatever their titles) - the main person, not the parent or emergency contact."""
    if row.get("ct"):
        nm = _main_name(row_names(row))
        if nm:
            return nm
    m = LABEL_NAME.search(row["text"])
    if m and looks_like_name(m.group(1)):
        return m.group(1)
    if row.get("header"):                      # 'First name' + 'Surname' in two columns
        fn = ln = ""
        for h, c in zip(row["header"], row["cells"]):
            h_ = (h or "").lower()
            if re.search(r"first\s*name|forename|given name|^nombre$", h_) and c.strip():
                fn = c.strip()
            elif re.search(r"surname|last\s*name|family name|apellido", h_) and c.strip():
                ln = c.strip()
        if fn and ln and looks_like_name(f"{fn} {ln}"):
            return f"{fn} {ln}"
        best = None
        for h, c in zip(row["header"], row["cells"]):
            if NAME_HDR.search(h or "") and looks_like_name(c) and not re.search(r"signature|sign|date|centre|center|"
                                                                                   r"support|address", h or "", re.I):
                rank = 0 if re.search(r"contact|parent|guardian|^name$|full name", h or "", re.I) else 1
                if best is None or rank < best[0]:
                    best = (rank, c)
        if best:
            return best[1]
    for c in row["cells"]:
        c = c.strip()
        if looks_like_name(c):
            return c
    for m in NAME_IN_TEXT.finditer(row["text"]):
        if looks_like_name(m.group(0)):
            return m.group(0)
    return ""


def organisation(row):
    if row.get("header"):
        for h, c in zip(row["header"], row["cells"]):
            if ORG_HDR.search(h or "") and c:
                return c
    return ""


_FZ_ABBR = {"wk": "week", "wks": "week", "weeks": "week", "jan": "january", "feb": "february", "mar": "march",
            "apr": "april", "jun": "june", "jul": "july", "aug": "august", "sep": "september", "sept": "september",
            "oct": "october", "nov": "november", "dec": "december", "inv": "invoice", "invoices": "invoice",
            "docs": "document", "documents": "document", "doc": "document", "yr": "year", "years": "year",
            "semana": "week", "sem": "week", "factura": "invoice", "facturas": "invoice"}
_FZ_EXT = re.compile(r"\.(pdf|docx?|xlsx?|pptx?|txt|md|epub|xps|oxps|cbz|fb2|mobi|svg|png|jpe?g|odt|rtf|html?|csv)$",
                     re.I)


def fuzzy_tokens(s):
    """'Week38_Plan.pdf' -> ['week', '38', 'plan'] (no accents, numbers apart, 'wk' = 'week'…).
    3.0: 'W38' -> ['week', '38'] too (a lone w just before a number)."""
    s = unicodedata.normalize("NFKD", s or "").encode("ascii", "ignore").decode().lower()
    s = _FZ_EXT.sub("", s.strip())
    s = re.sub(r"(?<![a-z])w(?=\s*\d)", "week ", s)
    return [_FZ_ABBR.get(t, t) for t in re.findall(r"[a-z]+|\d+", s)]


def fuzzy_score(qt, nt, joined=""):
    """How well the words qt fit a name nt (both from fuzzy_tokens); 0 = not at all. Numbers must be there
    exactly (38 is not 380); words may be the start of a word, inside it, or have a small typo."""
    if not qt or not nt:
        return 0.0
    import difflib
    score, used, missing = 0.0, set(), 0
    for q in qt:
        best, bj = 0.0, None
        for j, t in enumerate(nt):
            if j in used:
                continue
            if q.isdigit():
                s = (3.0 if int(q) == int(t) else (0.5 if len(q) >= 2 and t.startswith(q) else 0.0)) \
                    if t.isdigit() else 0.0
            elif t == q:
                s = 2.0
            elif t.startswith(q):
                s = 1.6 if len(q) >= 2 else 0.7
            elif len(q) >= 3 and q in t:
                s = 1.0
            elif len(q) >= 4 and len(t) >= 3 and t[0] == q[0] and \
                    difflib.SequenceMatcher(None, q, t).ratio() >= 0.75:
                s = 1.0
            else:
                s = 0.0
            if s > best:
                best, bj = s, j
        if bj is None:
            if q.isdigit():
                return 0.0
            missing += 1
        else:
            used.add(bj)
            score += best
    if missing > len(qt) // 3:
        return 0.0
    if joined and " ".join(qt) in joined:
        score += 1.5
    return max(0.01, score - missing * 0.8 - 0.03 * len(nt))


def find_values(kind, text):
    pat = EXTRACT_PATTERNS[kind]
    out = []
    text = text.replace(" | ", "\n")
    for m in pat.finditer(text):
        v = " ".join(m.group(0).split()).rstrip(".,;")
        if kind == "Phone numbers":
            digits = re.sub(r"\D", "", v)
            if not 9 <= len(digits) <= 15:
                continue
            if not re.search(r"[\s().+-]", v) and (len(digits) > 11 or not digits.startswith("0")):
                continue                                  # a long code / form number, not a phone
            before = text[max(0, m.start() - 18):m.start()].lower()
            if re.search(r"(form|id|ref|reference|no\.?|number|#|pps|iban|account|code|receipt|invoice)\W*$",
                         before) and not re.search(r"(phone|tel|mobile|mob|contact)", before):
                continue
        if kind == "Phone numbers" and re.fullmatch(r"\d{1,2}[/.-]\d{1,2}[/.-]\d{2,4}", v):
            continue
        if v and v not in out:
            out.append(v)
    return out


