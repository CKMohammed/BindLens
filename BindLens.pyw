def hex_to_rgb01(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


def rgb01_to_hex(c):
    if not c:
        return None
    if len(c) == 1:
        c = (c[0], c[0], c[0])
    if len(c) == 4:  # CMYK
        k = c[3]
        c = ((1 - c[0]) * (1 - k), (1 - c[1]) * (1 - k), (1 - c[2]) * (1 - k))
    return "#%02X%02X%02X" % tuple(max(0, min(255, int(round(v * 255)))) for v in c[:3])


def color_name(hexcol):
    if not hexcol:
        return "Other"
    r, g, b = [int(hexcol.lstrip("#")[i:i + 2], 16) for i in (0, 2, 4)]
    best, bd = "Other", 1e9
    for n, h in PALETTE.items():
        R, G, B = [int(h.lstrip("#")[i:i + 2], 16) for i in (0, 2, 4)]
        d = (r - R) ** 2 + (g - G) ** 2 + (b - B) ** 2
        if d < bd:
            best, bd = n, d
    return best


def mix(hex1, hex2, t):
    a = [int(hex1.lstrip("#")[i:i + 2], 16) for i in (0, 2, 4)]
    b = [int(hex2.lstrip("#")[i:i + 2], 16) for i in (0, 2, 4)]
    return "#%02X%02X%02X" % tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))


_BLEND_TABLES = {}


def blend_rect(buf, stride, w, h, x0, y0, x1, y1, rgb):
    """Multiply an RGB colour over a rectangle of a raw RGB buffer (search hits)."""
    x0 = max(0, int(x0)); y0 = max(0, int(y0))
    x1 = min(w, int(round(x1))); y1 = min(h, int(round(y1)))
    if x1 <= x0 or y1 <= y0:
        return
    tabs = _BLEND_TABLES.get(rgb)
    if tabs is None:
        tabs = [bytes((v * c) // 255 for v in range(256)) for c in rgb]
        _BLEND_TABLES[rgb] = tabs
    n = x1 - x0
    for y in range(y0, y1):
        a = y * stride + x0 * 3
        bb = a + n * 3
        for ch in range(3):
            buf[a + ch:bb:3] = buf[a + ch:bb:3].translate(tabs[ch])


