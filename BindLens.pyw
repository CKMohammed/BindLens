                                    os.path.getmtime(p) >= t0 - 2:
                                seen.add(p)
                                new.append(p)
                    except OSError:
                        pass
                if new:
                    d.after(800, lambda: got(new))          # let the camera finish writing the photo
                st["watch"] = d.after(1500, watch)
            watch()

        def from_files():
            ps = filedialog.askopenfilenames(parent=d, title="Choose photos or scans of the pages",
                                             filetypes=[("Pictures", "*.jpg *.jpeg *.png *.heic *.heif *.tif *.tiff "
                                                                     "*.bmp *.gif *.webp"), ("All files", "*.*")])
            if ps:
                got(list(ps))
        card("scan", "Scanner", "Windows asks which scanner", from_scanner, A)
        card("camera", "Camera", "The computer's camera - a photo of each page", from_camera, "#00A88A")
        card("image", "Photos and files", "From your phone (Phone Link, OneDrive, a cable) or the computer",
             from_files, "#E8772E")
        info.pack(anchor="w", pady=(12, 0))
        ob = tk.Frame(d, bg=T["panel"])
        ob.pack(fill="x", pady=(10, 0))
        vs = {}
        for key, lab in (("crop", "Cut out the page"), ("straight", "Turn it straight"), ("clean", "White paper, dark "
                                                                                                   "writing"),
                         ("color", "Keep the colours")):
            vs[key] = tk.BooleanVar(value=bool(opts.get(key, key != "color")))
            ttk.Checkbutton(ob, text=lab, variable=vs[key]).pack(side="left", padx=(0, 10))
        wf = tk.Frame(d, bg=T["panel"])
        wf.pack(fill="x", pady=(10, 0))
        tk.Label(wf, text="Put it:", font=self.F(9), bg=T["panel"], fg=T["muted"]).pack(side="left")
        where = tk.StringVar(value=opts.get("where", "new"))
        has_book = bool(self.book and self.book.total and self.folder is not None)
        ttk.Radiobutton(wf, text="as a new document in this book", value="new", variable=where).pack(side="left",
                                                                                                     padx=(8, 0))
        rb2 = ttk.Radiobutton(wf, text="after the page I am on", value="after", variable=where)
        rb2.pack(side="left", padx=(8, 0))
        if not has_book:
            where.set("new")
        bb = tk.Frame(d, bg=T["panel"])
        bb.pack(fill="x", pady=(16, 0))

        def add():
            if not st["paths"]:
                return
            for k_, v_ in vs.items():
                opts[k_] = v_.get()
            opts["where"] = where.get()
            self.lib.save_meta()
            if st["watch"]:
                try:
                    d.after_cancel(st["watch"])
                except Exception:
                    pass
            paths = list(st["paths"])
            d.destroy()
            self._scan_make(paths, dict(opts))
        add_b = PillButton(bb, self, "Add to the book", add, kind="accent", bg_key="panel")
        add_b.enabled = False
        add_b.pack(side="right")
        PillButton(bb, self, "Cancel", d.destroy, bg_key="panel").pack(side="right", padx=(0, 8))
        d.bind("<Escape>", lambda e: d.destroy())
        self._center(d)

    def _scan_make(self, paths, opts):
        """Turn the pictures into PDF pages (in the background), then put them in the book."""
        if not self.book or self.folder is None:
            messagebox.showinfo(APP_NAME, "Open a book first - the pages go into the book you are in.")
            return
        out_dir = os.path.join(data_dir(), "scans")
        os.makedirs(out_dir, exist_ok=True)
        name = time.strftime("Scan %d %b %Y %H.%M") + ".pdf"
        out = os.path.join(out_dir, name)
        res = {}
        self._scan_busy40 = True
        self.set_status(f"Getting {len(paths)} page(s) ready…")

        def run():
            try:
                res["n"] = scans_to_pdf(self.fitz, paths, out, crop=opts.get("crop", True),
                                        straighten=opts.get("straight", True), clean=opts.get("clean", True),
                                        color=opts.get("color", False),
                                        progress=lambda i, n: res.__setitem__("p", f"Page {i + 1} of {n}…"))
            except Exception as ex:
                res["err"] = str(ex)

        def wait():
            if "n" not in res and "err" not in res:
                if res.get("p"):
                    self.set_status("Scan and add: " + res["p"])
                self.root.after(200, wait)
                return
            self._scan_busy40 = False
            if res.get("err"):
                messagebox.showerror(APP_NAME, f"The pages could not be made:\n{res['err']}")
                return
            if opts.get("where") == "after" and self.book and self.book.total:
                self.insert_pdf_here(path=out)
            else:
                self.add_files([out], folder=self.folder, prefix=self.prefix, mode="move")
            self.frame_pulse()
            self._toast(f"{res['n']} scanned page{'s' if res['n'] != 1 else ''} added - BindLens reads their text "
                        "by itself, so you can search them.", ms=6000)
        threading.Thread(target=run, daemon=True).start()
        wait()

    # ---- read aloud ------------------------------------------------------------------------------------------------
    def _tts_conf(self):
        c = self.lib.settings.setdefault("tts", {})
        c.setdefault("rate", 0)
        c.setdefault("voice", "")
        c.setdefault("follow", True)
        c.setdefault("on", True)               # go on to the next page
        return c

    def _speaker40(self):
        sp = getattr(self, "_speaker", None)
        if sp is None:
            sp = self._speaker = Speaker()
        return sp

    def _tts_page_text(self, g, only=None):
        """The words of a page in reading order, as one text + where each word starts."""
        words = self._words(g)
        text, offs = [], []
        pos, last = 0, None
        for i, w in enumerate(words):
            if only is not None and i not in only:
                continue
            key = (w[5], w[6])
            sep = "" if last is None else ("\n" if key != last else " ")
            pos += len(sep)
            text.append(sep + w[4])
            offs.append((pos, pos + len(w[4]), i))
            pos += len(w[4])
            last = key
        return "".join(text), offs, words

    def read_aloud(self, g=None, selection=False, start=None):
        """Read the page (or the text you selected) aloud, word by word."""
        if not self.book or not self.book.total:
            self.set_status("Open a book first.")
            return
        sp = self._speaker40()
        if not sp.available():
            messagebox.showinfo(APP_NAME, "Reading aloud uses the computer's own voices: Windows or a Mac.")
            return
        if not sp.start():
            messagebox.showerror(APP_NAME, "The computer's voices could not be started.")
            return
        conf = self._tts_conf()
        sp.rate, sp.voice = conf.get("rate", 0), conf.get("voice", "")
        g = self.current_page if g is None else g
        only = None
        if selection and isinstance(self.sel, dict) and self.sel.get("text"):
            try:
                g = self.sel["g"]
                ws = self._words(g)
                rs = self.sel.get("rects") or []
                only = {i for i, w in enumerate(ws)
                        if any(r[0] - 1 <= (w[0] + w[2]) / 2 <= r[2] + 1 and r[1] - 1 <= (w[1] + w[3]) / 2 <= r[3] + 1
                               for r in rs)} or None
            except Exception:
                only = None
        if start is not None and only is None:
            only = set(range(int(start), len(self._words(g))))
        text, offs, words = self._tts_page_text(g, only)
        if not text.strip():
            if conf.get("on", True) and g + 1 < self.book.total and only is None:
                return self.read_aloud(g + 1)
            self.set_status("There is no text on this page to read (a scanned page is read once BindLens has read "
                            "it).")
            return
        self._tts_gen = getattr(self, "_tts_gen", 0) + 1
        gen = self._tts_gen
        self._tts = {"g": g, "offs": offs, "words": words, "state": "play", "sel": only is not None and start is None,
                     "starts": [o[0] for o in offs], "gen": gen}
        while not sp.q.empty():
            try:
                sp.q.get_nowait()
            except Exception:
                break
        if sp.kind == "sapi" and not sp.ready:
            t0 = time.time()

            def when_ready():
                if getattr(self, "_tts_gen", 0) != gen or getattr(self, "_tts", None) is None:
                    return                                   # stopped before the voice was ready
                if sp.ready or time.time() - t0 > 12:
                    sp.say(text)
                    self._tts_poll()
                else:
                    self.root.after(150, when_ready)
            self.set_status("Starting the voice…")
            when_ready()
        else:
            sp.say(text)
            self._tts_poll()
            if sp.kind == "say":
                self._tts_line_mark()
        self._qbar_draw()
        if self._qb_panel and self._qb_panel.get("k") == "read":
            self._qp_refresh()

    def _tts_line_mark(self):
        """A Mac reads a page at a time: the page is marked instead of each word."""
        t = getattr(self, "_tts", None)
        if not t:
            return
        self.set_status(f"Reading page {t['g'] + 1} aloud…")

    def _tts_poll(self):
        t = getattr(self, "_tts", None)
        if t is None:
            return
        sp = self._speaker40()
        last = None
        try:
            while True:
                msg = sp.q.get_nowait()
                if msg.startswith("w "):
                    last = msg
                elif msg in ("done", "stopped", "gone"):
                    if msg == "done" and not t.get("sel") and self._tts_conf().get("on", True) and \
                            t["g"] + 1 < self.book.total and getattr(self, "_tts", None) is t:
                        self.canvas.delete("tts")
                        nxt = t["g"] + 1
                        if self._tts_conf().get("follow", True):
                            self.goto_page(nxt)
                        gen = t.get("gen")
                        self.root.after(250, lambda: getattr(self, "_tts", None) is t and
                                        getattr(self, "_tts_gen", 0) == gen and self.read_aloud(nxt))
                        return
                    if msg != "stopped" or getattr(self, "_tts", None) is t:
                        self.tts_stop(quiet=True)
                    return
        except queue.Empty:
            pass
        if last:
            try:
                _w, pos, n = last.split()
                pos = int(pos)
                import bisect
                k = bisect.bisect_right(t["starts"], pos) - 1
                if 0 <= k < len(t["offs"]):
                    self._tts_show(t["g"], t["words"][t["offs"][k][2]])
            except Exception:
                pass
        self.root.after(45, self._tts_poll)

    def _tts_show(self, g, w):
        c = self.canvas
        c.delete("tts")
        try:
            x0, y0, x1, y1 = self._to_canvas(g, (w[0], w[1], w[2], w[3]))
        except Exception:
            return
        A = self.accent
        c.create_rectangle(x0 - 2, y0 - 1, x1 + 2, y1 + 1, outline=A, width=1.5, tags="tts")
        c.create_line(x0 - 1, y1 + 2, x1 + 1, y1 + 2, fill=A, width=3, capstyle="round", tags="tts")
        if self._tts_conf().get("follow", True):
            top, bot = c.canvasy(0), c.canvasy(c.winfo_height())
            if y1 > bot - 60 or y0 < top + 20:
                try:
                    self._show_spot(g, (w[0], w[1], w[2], w[3]))
                except Exception:
                    pass

    def tts_pause(self):
        t = getattr(self, "_tts", None)
        if not t:
            return
        sp = self._speaker40()
        if t["state"] == "play":
            sp.pause()
            t["state"] = "pause"
        else:
            sp.resume()
            t["state"] = "play"
        if self._qb_panel and self._qb_panel.get("k") == "read":
            self._qp_refresh()

    def tts_stop(self, quiet=False):
        if getattr(self, "_tts", None) is None and quiet:
            return
        self._tts = None
        self._tts_gen = getattr(self, "_tts_gen", 0) + 1
        sp = self._speaker40()
        try:
            sp.stop()
        except Exception:
            pass
        if not quiet:
            # 4.1: make sure it really stops - if the voice still says words a moment later, it is closed (it
            # starts again by itself next time)
            t_stop = time.time()

            def watch():
                if getattr(self, "_tts", None) is not None:
                    return
                still = False
                try:
                    while True:
                        m = sp.q.get_nowait()
                        if m.startswith("w ") and time.time() - t_stop > 0.35:
                            still = True
                except queue.Empty:
                    pass
                if still:
                    sp.close()
                    sp.kind, sp.proc = None, None
                    return
                if time.time() - t_stop < 2.0:
                    self.root.after(150, watch)
            self.root.after(150, watch)
        self.canvas.delete("tts")
        self._qbar_draw()
        if self._qb_panel and self._qb_panel.get("k") == "read":
            self._qp_refresh()

    def _qp_fill_read(self, body):
        T, A = self.T, self.accent
        conf = self._tts_conf()
        sp = self._speaker40()
        t = getattr(self, "_tts", None)
        row = tk.Frame(body, bg=T["panel"])
        row.pack(fill="x", pady=(8, 0))
        if t is None:
            PillButton(row, self, "Read this page", lambda: self.read_aloud(), kind="accent", bg_key="panel",
                       icon="speaker").pack(side="left")
            if self.sel:
                PillButton(row, self, "The selection", lambda: self.read_aloud(selection=True),
                           bg_key="panel").pack(side="left", padx=(6, 0))
        else:
            PillButton(row, self, "Pause" if t["state"] == "play" else "Go on", self.tts_pause, kind="accent",
                       bg_key="panel").pack(side="left")
            PillButton(row, self, "Stop", self.tts_stop, bg_key="panel").pack(side="left", padx=(6, 0))
            tk.Label(body, text=f"Reading page {t['g'] + 1}…", font=self.F(9), bg=T["panel"], fg=A).pack(
                anchor="w", pady=(8, 0))
        self._qp_section(body, "Speed")
        names = [(-4, "Slow"), (-2, "Calm"), (0, "Normal"), (2, "Quick"), (4, "Fast")]

        def set_rate(v):
            conf["rate"] = v
            sp.rate = v
            self.lib.save_meta()
            if sp.kind == "sapi":
                sp._send(f"rate {int(v)}")
            self._qp_refresh()
        self._qp_chips(body, names, int(conf.get("rate", 0)), set_rate)
        self._qp_section(body, "Voice")
        if not sp.available():
            tk.Label(body, text="Reading aloud uses the computer's own voices (Windows or a Mac).", font=self.F(9),
                     bg=T["panel"], fg=T["muted"], wraplength=290, justify="left").pack(anchor="w")
        else:
            if sp.kind is None:
                sp.start()
            vals = [v.split("|")[0] for v in sp.voices] or ["(the computer's voice)"]
            var = tk.StringVar(value=conf.get("voice") or vals[0])
            cb = ttk.Combobox(body, textvariable=var, values=vals, state="readonly", width=34)
            cb.pack(anchor="w")

            def set_voice(_e=None):
                v = var.get()
                if v.startswith("("):
                    return
                conf["voice"] = v
                sp.voice = v
                self.lib.save_meta()
                if sp.kind == "sapi":
                    sp._send("voice " + v)
            cb.bind("<<ComboboxSelected>>", set_voice)
            if not sp.voices:
                self.root.after(1500, lambda: self._qb_panel and self._qb_panel.get("k") == "read" and
                                not getattr(self, "_tts", None) and self._qp_refresh())
            tk.Label(body, text="More voices and languages: Windows Settings > Time & language > Speech.",
                     font=self.F(8), bg=T["panel"], fg=T["muted"], wraplength=290, justify="left").pack(
                anchor="w", pady=(4, 0))
        for key, lab in (("follow", "Follow the words on the page"), ("on", "Go on to the next page")):
            v = tk.BooleanVar(value=bool(conf.get(key, True)))
            ttk.Checkbutton(body, text=lab, variable=v,
                            command=lambda k=key, v=v: (conf.__setitem__(k, v.get()), self.lib.save_meta())).pack(
                anchor="w", pady=(8, 0))
        tk.Label(body, text="Ctrl+U starts or stops reading. Select text first to hear only that.", font=self.F(8),
                 bg=T["panel"], fg=T["muted"], wraplength=290, justify="left").pack(anchor="w", pady=(14, 0))

    def toggle_read_aloud(self):
        if getattr(self, "_tts", None) is not None:
            self.tts_stop()
        else:
            self.read_aloud(selection=bool(self.sel))
            if not (self._qb_panel and self._qb_panel.get("k") == "read"):
                self._qp_open("read")

    # ---- study: summary sheet + cards ------------------------------------------------------------------------------
    def _study_items(self, scope="file"):
        """Highlights and notes in reading order: [{"g", "file", "page", "kind", "text", "note", "color", "m"}]."""
        out = []
        for m in sorted(self._marks_here(scope), key=lambda m: (m["g"], m["bbox"][1])):
            if m["kind"] not in MARKUP and m["kind"] not in ("Text", "FreeText"):
                continue
            txt = (m.get("text") or "").strip() if m["kind"] in MARKUP else ""
            note = (m.get("note") or "").strip()
            if not txt and not note:
                continue
            fi, pi = self.book.pages[m["g"]][0], self.book.pages[m["g"]][1]
            out.append({"g": m["g"], "file": self.book.files[fi]["rel"], "page": pi + 1, "kind": m["kind"],
                        "text": txt, "note": note, "color": m.get("color") or "#FFD400", "m": m})
        return out

    def _card_id(self, it):
        import hashlib
        return hashlib.sha1(f"{self.folder}|{it['file']}|{it['page']}|{it['text']}|{it['note']}".encode(
            "utf-8", "replace")).hexdigest()[:16]

    def _cards_for(self, scope="book"):
        """Question-and-answer cards from your marks: a note on a highlight is the question, the highlight the
        answer; a highlight alone becomes 'fill the gap' (its line with the highlighted words hidden); a sticky
        note written 'Question? Answer' is a card too."""
        cards = []
        for it in self._study_items(scope):
            front = back = ""
            if it["kind"] in MARKUP and it["text"]:
                back = it["text"]
                if it["note"]:
                    front = it["note"]
                else:
                    ctx = self._card_context(it)
                    front = ctx or f"What did you highlight on page {it['page']} of {os.path.basename(it['file'])}?"
            elif it["note"] and "?" in it["note"]:
                q, _, a = it["note"].partition("?")
                if a.strip():
                    front, back = q.strip() + "?", a.strip()
            if front and back:
                cards.append({"id": self._card_id(it), "front": front, "back": back, "it": it})
        return cards

    def _card_context(self, it):
        """The line(s) round a highlight, with the highlighted words hidden: 'The capital of France is ____.'"""
        m = it["m"]
        try:
            words = self._words(m["g"])
        except Exception:
            return ""
        x0, y0, x1, y1 = m["bbox"]
        lines = {}
        hidden = set()
        for i, w in enumerate(words):
            cy = (w[1] + w[3]) / 2
            if y0 - 2 <= cy <= y1 + 2:
                lines.setdefault((w[5], w[6]), []).append(i)
                cx = (w[0] + w[2]) / 2
                if x0 - 1 <= cx <= x1 + 1:
                    hidden.add(i)
        if not hidden:
            return ""
        out, blank = [], False
        for key in sorted(lines):
            for i in lines[key]:
                if i in hidden:
                    if not blank:
                        out.append("_____")
                    blank = True
                else:
                    out.append(words[i][4])
                    blank = False
        s = " ".join(out)
        return s if len(s.replace("_____", "").strip()) >= 8 else ""

    def _cards_state(self):
        return self.lib.meta.setdefault("cards", {})

    def _cards_due(self, scope="book"):
        import datetime
        today = datetime.date.today().isoformat()
        stt = self._cards_state()
        return [c for c in self._cards_for(scope) if stt.get(c["id"], {}).get("due", today) <= today]

    def _cards_due_n(self):
        if not self.book or not self.book.total:
            return 0
        now = time.time()
        cache = getattr(self, "_cards_n_cache", None)
        if cache and cache[0] == (self.folder, len(self.marks)) and now - cache[1] < 60:
            return cache[2]
        try:
            n = len(self._cards_due("book"))
        except Exception:
            n = 0
        self._cards_n_cache = ((self.folder, len(self.marks)), now, n)
        return n

    def _qp_fill_study(self, body):
        T, A = self.T, self.accent
        scope = getattr(self, "_qp_scope", "file")
        self._qp_chips(body, [("file", "This document"), ("book", "This book")], scope,
                       lambda v: (setattr(self, "_qp_scope", v), self._qp_refresh()))
        items = self._study_items(scope)
        nh = sum(1 for it in items if it["kind"] in MARKUP)
        nn = sum(1 for it in items if it["note"])
        due = self._cards_due(scope)
        tk.Label(body, text=f"{nh} highlight{'s' if nh != 1 else ''} · {nn} note{'s' if nn != 1 else ''} · "
                            f"{len(due)} card{'s' if len(due) != 1 else ''} to review today",
                 font=self.F(9), bg=T["panel"], fg=T["muted"], wraplength=290, justify="left").pack(anchor="w",
                                                                                                     pady=(8, 0))
        row = tk.Frame(body, bg=T["panel"])
        row.pack(fill="x", pady=(8, 0))
        PillButton(row, self, f"Review ({len(due)})", lambda: self.review_cards(scope), kind="accent",
