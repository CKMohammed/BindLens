        self._center(d)

    def _bin_remove(self, x):
        lst = [y for y in self._bin_list() if y.get("pdf") != x.get("pdf")]
        save_json(os.path.join(self._bin_dir(), "pages.json"), lst)
        try:
            os.remove(x["pdf"])
        except Exception:
            pass

    def restore_page(self, x):
        """Put a deleted page back in its file, where it was (or at the end if the file is shorter now)."""
        n = self.lib.norm(x["file"])
        loc = self.lib.where.get(n)
        if not loc or not os.path.exists(x["file"]):
            messagebox.showinfo(APP_NAME, f"“{os.path.basename(x['file'])}” is not in your books any more - the "
                                          f"page can't go back into it.")
            return False
        folder, rel = loc

        def put():
            fi = next((k for k, f in enumerate(self.book.files) if self.lib.norm(f["path"]) == n), None) \
                if self.book else None
            if fi is None:
                return
            try:
                src = self.fitz.open(x["pdf"])
            except Exception as ex:
                messagebox.showerror(APP_NAME, f"Could not read the deleted page:\n{ex}")
                return
            self._begin_edit(fi)
            doc = self.book.doc(fi)
            at = max(0, min(int(x.get("page", 0)), doc.page_count))
            try:
                doc.insert_pdf(src, start_at=at)
            except Exception as ex:
                if self.undo_stack:
                    self.undo_stack.pop()
                self.book.reopen(fi)
                messagebox.showerror(APP_NAME, f"Could not put the page back:\n{ex}")
                return
            src.close()
            self._save_file(fi)
            self._bin_remove(x)
            self._structure_changed(fi, goto=self.book.files[fi]["first"] + at)
            self.set_status(f"Page {at + 1} of {os.path.basename(x['file'])} is back.  Ctrl+Z to undo.")
        if folder != self.folder or self.book is None:
            self.open_folder(folder, then=put)
        else:
            put()
        return True

    def move_page(self, d):
        fi, pi, g = self._here()
        n = self.book.files[fi]["count"]
        to = pi + d
        if to < 0 or to >= n:
            return

        def go(doc, pi):
            doc.move_page(pi, to + 1 if d > 0 else to)
        self._page_edit(go, "Page moved.", goto_delta=d)

    def insert_pdf_here(self, path=None):
        path = path or filedialog.askopenfilename(title="Insert the pages of another PDF after this page",
                                                  filetypes=[("PDF", "*.pdf")])
        if not path:
            return

        def go(doc, pi):
            src = self.fitz.open(path)
            n = src.page_count
            doc.insert_pdf(src, start_at=pi + 1)
            src.close()
            for k in range(n):
                mark_added(doc, pi + 1 + k, {"k": "pdf", "what": os.path.basename(path)})
        self._page_edit(go, f"Pages of {os.path.basename(path)} inserted.", goto_delta=1)

    def _ask_pages(self, n, title, initial=None):
        txt = self._ask_string(title, f"Pages (1-{n}), e.g.  1-3, 5, 8-10:", initial or f"1-{n}")
        if not txt:
            return None
        pages = []
        for part in re.split(r"[,; ]+", txt.strip()):
            m = re.fullmatch(r"(\d+)(?:-(\d+))?", part)
            if not m:
                continue
            a = int(m.group(1))
            b = int(m.group(2) or a)
            for k in range(min(a, b), max(a, b) + 1):
                if 1 <= k <= n and k - 1 not in pages:
                    pages.append(k - 1)
        return pages or None

    def extract_pages(self):
        if not self.book or not self.book.total:
            return
        fi, pi, g = self._here()
        f = self.book.files[fi]
        pages = self._ask_pages(f["count"], "Save pages as a new PDF", str(pi + 1))
        if not pages:
            return
        base = os.path.splitext(os.path.basename(f["path"]))[0]
        dst = filedialog.asksaveasfilename(title="Save the pages as", defaultextension=".pdf",
                                           initialdir=os.path.dirname(f["path"]),
                                           initialfile=f"{base} - pages.pdf", filetypes=[("PDF", "*.pdf")])
        if not dst:
            return
        src = self.book.doc(fi)
        out = self.fitz.open()
        for p in pages:
            out.insert_pdf(src, from_page=p, to_page=p)
        n = erase_under_covers(self.fitz, out)
        out.save(dst, garbage=3, deflate=True)
        out.close()
        self.set_status(f"Saved {len(pages)} page(s) as {os.path.basename(dst)}." +
                        (f"  The text under {n} white box(es) is erased for good in it." if n else ""))

    def split_file(self):
        fi, pi, g = self._here()
        f = self.book.files[fi]
        folder = filedialog.askdirectory(title="Save one PDF per page in…", initialdir=os.path.dirname(f["path"]))
        if not folder:
            return
        src = self.book.doc(fi)
        base = os.path.splitext(os.path.basename(f["path"]))[0]
        for p in range(src.page_count):
            out = self.fitz.open()
            out.insert_pdf(src, from_page=p, to_page=p)
            erase_under_covers(self.fitz, out)
            dst_ = unique_path(folder, f"{base} - page {p + 1}.pdf")
            out.save(dst_, garbage=3, deflate=True)
            note_change("Split into a new file", dst_, f["path"])
            out.close()
        self.set_status(f"Split into {src.page_count} files in {folder}.")
        self.lib.scan()
        self._fill_folders()

    def _book_pdf(self, files=None, bake=False):
        """All PDFs of this book (or the given files) in one new document."""
        out = self.fitz.open()
        for fi in (files if files is not None else range(len(self.book.files))):
            f = self.book.files[fi]
            if f["error"]:
                continue
            src = self.book.doc(fi)
            if f["pdf"]:
                out.insert_pdf(src)
            else:
                out.insert_pdf(self.fitz.open("pdf", src.convert_to_pdf()))
        try:                                   # 3.2: the text under white boxes can't be uncovered in the copy
            self._covers_erased = erase_under_covers(self.fitz, out)
        except Exception as ex:
            _log(f"covers: {ex}")
        if bake:
            try:
                out.bake()
            except Exception:
                pass
        return out

    def merge_book(self):
        if not self.book or not self.book.total:
            return
        dst = filedialog.asksaveasfilename(title="Save the whole book as one PDF", defaultextension=".pdf",
                                           initialfile=f"{clean_name(self.lib.label(self.folder))}.pdf",
                                           filetypes=[("PDF", "*.pdf")])
        if not dst:
            return
        self.root.config(cursor="watch")
        self.root.update()
        try:
            out = self._book_pdf()
            toc = []
            p = 1
            for f in self.book.files:
                if f["count"]:
                    toc.append([1, os.path.splitext(os.path.basename(f["rel"]))[0], p])
                    p += f["count"]
            try:
                out.set_toc(toc)
            except Exception:
                pass
            out.save(dst, garbage=3, deflate=True)
            out.close()
        finally:
            self.root.config(cursor="")
        n = getattr(self, "_covers_erased", 0)
        self.set_status(f"Book saved as one PDF: {dst}" +
                        (f"  ·  the text under {n} white box(es) is erased for good in it" if n else ""))

