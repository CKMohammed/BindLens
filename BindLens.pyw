    def _dot(self, color, size=12):
        key = (color, size)
        if key not in self._icons:
            img = tk.PhotoImage(width=size + 4, height=size)
            r = size / 2
            T = self.T
            rows = []
            for y in range(size):
                row = []
                for x in range(size + 4):
                    d = ((x - r + 0.5) ** 2 + (y - r + 0.5) ** 2) ** 0.5
                    row.append(color if d <= r - 1 else T["panel"])
                rows.append("{" + " ".join(row) + "}")
            img.put(" ".join(rows))
            self._icons[key] = img
        return self._icons[key]

    def _book_icon_small(self, f):
        """The book's own icon, small, for the book list (a coloured dot if it can't be drawn)."""
        try:
            img, _m = tile_photo(26, self.lib.color(f), self.lib.icon(f), initials(self.lib.label(f)),
                                 self.lib.tstyle(f) if self.lib.tstyle(f) != "3d" else "flat", self.lib.badge(f))
            return img
        except Exception:
            return self._dot(self.lib.color(f))

    def _link_icon(self, missing=False):
        """A small arrow (sub-book linked from another place on the computer) for the book list."""
        key = ("link", missing, self.T["panel"])
        if key not in self._icons:
            try:
                fz = self.fitz
                d = fz.open()
                pg = d.new_page(width=16, height=12)
                sh = pg.new_shape()
                sh.draw_rect(pg.rect)
                sh.finish(color=None, fill=hex_to_rgb01(self.T["panel"]))
                col = hex_to_rgb01("#D64545" if missing else "#5B6CF0")
                sh.draw_rect(fz.Rect(2.5, 3.5, 10.5, 10.5), radius=0.2)
                sh.finish(color=col, width=1.1)
                sh.draw_line((7, 7), (13.2, 0.9))
                sh.draw_polyline([(9.2, 0.9), (13.2, 0.9), (13.2, 4.9)])
                sh.finish(color=col, width=1.3, lineCap=1, lineJoin=1)
                sh.commit()
                png = pg.get_pixmap(matrix=fz.Matrix(1, 1), alpha=False).tobytes("png")
                d.close()
                self._icons[key] = tk.PhotoImage(data=png)
            except Exception:
                self._icons[key] = self._dot("#5B6CF0", 8)
        return self._icons[key]

