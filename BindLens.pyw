    @property
    def accent(self):
        """Your colour - 3.0: made readable on the theme (a black accent on a dark theme, a pale yellow with white
        writing on a light one could not be seen): it is stepped lighter or darker until it stands out."""
        a = self.lib.settings.get("accent", ACCENTS[0])
        T = self.T
        key = (a, T["panel"])
        c = self.__dict__.setdefault("_acc_cache", {})
        if key in c:
            return c[key]
        out = a
        try:
            bg = T["panel"]
            dark_bg = not is_light(bg)
            lb = _lum(bg)
            for _ in range(8):
                la = _lum(out)
                ratio = (max(la, lb) + 0.05) / (min(la, lb) + 0.05)
                # on a light theme the accent also carries white writing (buttons): it must not be too pale
                if ratio >= 3.0 and (dark_bg or la < 0.42):
                    break
                out = mix(out, "#FFFFFF" if dark_bg else "#000000", 0.18)
        except Exception:
            out = a
        c[key] = out
        return out

