    def export_ics(self, events, name="BindLens dates", parent=None):
        """3.0 - save dates as a calendar file (.ics): open it and Outlook / your calendar adds them, with a
        reminder 2 weeks before and on the day - even when BindLens is closed."""
        events = [e for e in events if e and e[0]]
        if not events:
            messagebox.showinfo(APP_NAME, "There are no dates to add to a calendar here.", parent=parent)
            return
        start = os.path.join(os.path.expanduser("~"), "Documents")
        dst = filedialog.asksaveasfilename(parent=parent, title="Save the dates for your calendar",
                                           initialdir=start if os.path.isdir(start) else os.path.expanduser("~"),
                                           initialfile=clean_name(name) + ".ics", defaultextension=".ics",
                                           filetypes=[("Calendar file", "*.ics")])
        if not dst:
            return
        try:
            with open(dst, "w", encoding="utf-8", newline="") as fh:
                fh.write(ics_text(events))
        except Exception as ex:
            messagebox.showerror(APP_NAME, f"Could not save the calendar file:\n{ex}", parent=parent)
            return
        n = len(events)
        if messagebox.askyesno(APP_NAME, f"{n} date{'s' if n != 1 else ''} saved in “{os.path.basename(dst)}”.\n\n"
                                         f"Open it now? Outlook (or your calendar) adds "
                                         f"{'them' if n != 1 else 'it'}, with a reminder 2 weeks before and on the day.",
                               parent=parent):
            open_in_os(dst)

    def _rows_to_events(self, headers, rows):
        """Dates of a report table as calendar events: the date column, and who / what / where for the title."""
        import datetime
        hl = [str(h).lower() for h in headers]
        di = next((i for i, h in enumerate(hl) if re.search(r"date|expir|due|deadline|until|when", h)), None)
        if di is None:
            return []
        pick = lambda *names: next((i for i, h in enumerate(hl) if any(n_ in h for n_ in names)), None)
        wi, ti = pick("person", "who", "name", "staff", "child"), pick("what", "kind", "item", "type")
        fi_, pg, li = pick("file", "document"), pick("page"), pick("line", "text")
        ev = []
        for r in rows:
            if di >= len(r):
                continue
            d = r[di] if isinstance(r[di], datetime.date) else parse_date_text(str(r[di]))
            if not d:
                continue
            who = str(r[wi]).strip() if wi is not None and wi < len(r) else ""
            what = str(r[ti]).strip() if ti is not None and ti < len(r) else ""
            title = " - ".join(x for x in (what.capitalize() if what else "", who) if x) or \
                (str(r[li])[:60] if li is not None and li < len(r) else "Date from BindLens")
            where = (f"{r[fi_]}" + (f" p.{r[pg]}" if pg is not None and pg < len(r) else "")) \
                if fi_ is not None and fi_ < len(r) else ""
            line = str(r[li])[:200] if li is not None and li < len(r) else ""
            ev.append((d, title, "\n".join(x for x in (line, where, "From BindLens") if x)))
        return ev

    def _open_path_page(self, path, page):
        n = self.lib.norm(path)
        loc = self.lib.where.get(n)
        if not loc:
            messagebox.showinfo(APP_NAME, "That file is not in your books any more.")
            return
        folder, rel = loc

        def there():
            for f in (self.book.files if self.book else []):
                if self.lib.norm(f["path"]) == n and f["count"]:
                    self.goto_page(f["first"] + min(page, f["count"] - 1))
                    return
        if folder != self.folder or self.book is None or self.prefix and not rel.startswith(self.prefix):
            self.open_folder(folder, then=there)
        else:
            there()

    # ===================================================================== pages
    PAPERS = [("blank", "Blank"), ("lined", "Lined (notebook)"), ("squared", "Squared"), ("dotted", "Dotted"),
              ("cornell", "Cornell notes"), ("colour", "Coloured")]

    def _here(self):
        """(file index, page index in file, global page) of the page you are looking at."""
        g = self.current_page
        fi, pi = self.book.pages[g][0], self.book.pages[g][1]
        return fi, pi, g

    def _structure_changed(self, fi, goto=None):
        """The pages of a file changed: lay the book out again, keep your place."""
        f = self.book.files[fi]
        self.page_sizes.pop(f["key"], None)
        g = goto if goto is not None else self.current_page
        folder, prefix = self.folder, self.prefix
        stacks = (self.undo_stack, self.redo_stack)

        def after():
            self.undo_stack, self.redo_stack = stacks              # same files: Ctrl+Z still works
            if self.book and self.book.total:
                self.goto_page(min(g, self.book.total - 1))
        self.open_folder(folder, prefix, then=after)

    def _close_book_keep_writes(self):
        self.lib.save_meta()

    def _page_edit(self, fn, msg, goto_delta=0, need_pdf=True):
        if not self.book or not self.book.total:
            return
        fi, pi, g = self._here()
        if need_pdf and not self.book.files[fi]["pdf"]:
            self._require_pdf(g)
            return
        self._begin_edit(fi)
        doc = self.book.doc(fi)
        try:
            fn(doc, pi)
        except Exception as ex:
            self.undo_stack.pop()
            messagebox.showerror(APP_NAME, f"Could not do that:\n{ex}")
            return
        self._save_file(fi)
        self._structure_changed(fi, goto=max(0, g + goto_delta))
        self.set_status(msg + "  Ctrl+Z to undo.")

    def insert_paper(self, style="blank", where="after"):
        col = mix(self.lib.settings.get("color", "#FFE066"), "#FFFFFF", 0.75) if style == "colour" else None

        name = dict(self.PAPERS).get(style, "Blank")

        def go(doc, pi):
            ref = doc.load_page(pi).rect
            at = pi + 1 if where == "after" else pi
            pg = doc.new_page(pno=at, width=ref.width, height=ref.height)
            draw_paper(self.fitz, pg, style, col)
            mark_added(doc, at, {"k": "empty", "what": name})
        self._page_edit(go, f"{name} page added.", goto_delta=1 if where == "after" else 0)

    # ---- writing pages in BindLens (a simple Word) -------------------------------------------------
    def _page_group(self, doc, pi):
        """(first page, count, source) of the written page group that page pi belongs to - or None."""
        info = page_source(doc, doc.load_page(pi))
        if not info:
            return None
        gid = info.get("id")
        first = pi - int(info.get("i", 0))
        first = max(0, first)
        src = None
        n = 0
        for k in range(first, doc.page_count):
            inf = page_source(doc, doc.load_page(k))
            if not inf or inf.get("id") != gid:
                break
            if inf.get("src"):
                src = inf["src"]
            n += 1
        return (first, n, src) if src else None

    def written_page(self, g):
        try:
            fi, pi = self.book.pages[g][0], self.book.pages[g][1]
            if not self.book.files[fi]["pdf"]:
                return None
            return self._page_group(self.book.doc(fi), pi)
        except Exception:
            return None

    def _page_menu(self, e):
        m = self._menu()
        m.add_command(label="Write a new page…", command=lambda: self.write_page())
        for key, (lab, _o, _b) in PAGE_TEMPLATES.items():
            m.add_command(label="   " + lab, command=lambda k=key: self.write_page(template=k))
        m.add_separator()
        for key, lab in self.PAPERS:
            m.add_command(label="Empty page: " + lab.lower(), command=lambda k=key: self.insert_paper(k))
        if self.book and self.book.total and self.written_page(self.current_page):
            m.add_separator()
            m.add_command(label="Edit this written page…", command=lambda: self.edit_written_page(self.current_page))
        self._popup(m, e)

    def write_page(self, where="after", template=None):
        """Write a new page after (or before) the one you are looking at - opens the page editor."""
        if not self.book or not self.book.total:
            messagebox.showinfo(APP_NAME, "Open a book and go to the page you want to add a page after.")
            return
        fi, pi, g = self._here()
        if not self.book.files[fi]["pdf"]:
            self._require_pdf(g)
            return
        self.page_editor(fi, pi, mode="new", where=where, template=template or "blank")

    def edit_written_page(self, g):
        grp = self.written_page(g)
        if not grp:
            return
        fi, pi = self.book.pages[g][0], self.book.pages[g][1]
        self.page_editor(fi, pi, mode="edit")

    def page_editor(self, fi, pi, mode="new", where="after", template="blank"):
        """Write a page like in a simple Word: tabs HOME · INSERT · PAGE, and TABLE / PICTURE when you are in a
        table or click a picture. Preview shows the real page; Save puts it in the PDF (and closes)."""
        T = self.T
        doc = self.book.doc(fi)
        ed_path = self.book.files[fi]["path"]           # 3.0: the file this page goes into (the book may change)
        ref = doc.load_page(pi).rect
        grp = self._page_group(doc, pi) if mode == "edit" else None
        if grp:
            src = dict(grp[2])
        else:
            name, opts, blocks = PAGE_TEMPLATES.get(template, PAGE_TEMPLATES["blank"])
            src = {"paper": "blank", "size": "same", "orient": "", "margin": 56, "cols": 1, "header": "", "footer": "",
                   "numbers": False, "pcolor": "#FFFFFF", "font": "Sans", "size_pt": 11, "lh": 1.28}
            src.update(opts)
            src["doc"] = {"blocks": json.loads(json.dumps(blocks))}
        src.setdefault("lh", 1.28)
        w = tk.Toplevel(self.root)
        w.title("Write a page" if mode == "new" else "Edit the page")
        w.configure(bg=T["panel"])
        w.transient(self.root)
        sw, sh = self.root.winfo_screenwidth(), self.root.winfo_screenheight()
        W_, H_ = min(1260, sw - 40), min(940, sh - 80)
        w.geometry(f"{W_}x{H_}+{max(0, (sw - W_) // 2)}+{max(0, (sh - H_) // 2 - 20)}")
        w.minsize(860, 560)
        state = {"dirty": False, "template": template, "tab": "home", "embed": None, "closed": False}
        RB = mix(T["panel"], T["chip"], 0.55)
        ACC = self.accent
        tips = self.tooltip

        # ---- frames -----------------------------------------------------------------------------------
        head = tk.Frame(w, bg=T["panel"])
        head.pack(fill="x", padx=14, pady=(8, 0))
        ribbon = tk.Frame(w, bg=RB, highlightthickness=1, highlightbackground=T["border"])
        ribbon.pack(fill="x", padx=14)
        foot = tk.Frame(w, bg=T["panel"])
        foot.pack(side="bottom", fill="x", padx=14, pady=8)
        body = tk.Frame(w, bg=mix(T["canvas"], "#000000", 0.04))
        body.pack(fill="both", expand=True, pady=(6, 0))
        side = None
        if mode == "new":
            side = tk.Frame(body, bg=T["panel"], width=176)
            side.pack(side="left", fill="y")
            side.pack_propagate(False)
        sheet_wrap = tk.Frame(body, bg=body["bg"])
        sheet_wrap.pack(side="left", fill="both", expand=True)
        sheet = tk.Frame(sheet_wrap, bg="#FFFFFF", highlightthickness=1, highlightbackground=T["border"])
        sheet.pack(fill="y", expand=True, pady=14)
        head_e = tk.Entry(sheet, relief="flat", bd=0, fg="#8A8F98", font=self.F(9), justify="left")
        rt_box = tk.Frame(sheet, bg="#FFFFFF")
        foot_e = tk.Entry(sheet, relief="flat", bd=0, fg="#8A8F98", font=self.F(9), justify="left")
        vs = ttk.Scrollbar(sheet_wrap, orient="vertical", style="Bold.Vertical.TScrollbar")
        rt = RichText(rt_box, base={"f": src.get("font", "Sans"), "z": float(src.get("size_pt", 11)),
                                    "c": src.get("tc", "#1F1F1F")}, zoom=1.0, images_dir=self.images_dir,
                      on_change=lambda: changed(), padx=0, pady=0, yscrollcommand=vs.set)
        rt.fitz = self.fitz
        vs.configure(command=rt.t.yview)
        rt.t.pack(fill="both", expand=True)

        def changed():
            if getattr(rt, "last_edited", True):
                state["dirty"] = True
            if state.get("wc_job"):
                try:
                    w.after_cancel(state["wc_job"])
                except Exception:
                    pass
            try:
                state["wc_job"] = w.after(400, count_words)
            except Exception:
                pass

        def page_wh():
            return page_size(self.fitz, src, ref)

        def layout(_e=None):
            Wp, Hp = page_wh()
            avail = max(300, sheet_wrap.winfo_width() - 60)
            scale = max(0.6, min(1.5, avail / Wp))
            m = float(src.get("margin", 56))
            left = max(m, 80) if src.get("paper") == "lined" else m
            sheet.configure(width=int(Wp * scale), bg=src.get("pcolor") or "#FFFFFF")
            sheet.pack_propagate(False)
            for wd in (head_e, foot_e, rt_box):
                wd.pack_forget()
            bgc = src.get("pcolor") or "#FFFFFF"
            head_e.configure(bg=bgc, insertbackground="#1F1F1F")
            foot_e.configure(bg=bgc, insertbackground="#1F1F1F")
            rt_box.configure(bg=bgc)
            rt.t.configure(bg=bgc, spacing2=int(max(0.0, float(src.get("lh", 1.28)) - 1.15) * 12 * scale))
            head_e.pack(fill="x", padx=(int(left * scale), int(m * scale)), pady=(int(m * scale * 0.45), 0))
            foot_e.pack(side="bottom", fill="x", padx=(int(left * scale), int(m * scale)),
                        pady=(0, int(m * scale * 0.45)))
            rt_box.pack(fill="both", expand=True, padx=(int(left * scale), int(m * scale)),
                        pady=(int(m * scale * 0.4), int(m * scale * 0.4)))
            if abs(rt.zoom - scale) > 0.01:
                rt.set_zoom(scale)
                w.after(30, rt.refit_embeds)
            vs.place(in_=sheet, relx=1.0, x=2, rely=0, relheight=1.0)
        sheet_wrap.bind("<Configure>", layout)

        def put_placeholder(e, text):
            if not e.get():
                e.insert(0, text)
                e.configure(fg="#B8BCC6")
